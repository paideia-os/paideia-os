// tests/kernel/cap/thermal_zone_synth.pdx — R31.M2-001 (#1094) /
//                                          R31.M2-002 (#1095)
//
// Boot witness for KIND_THERMAL_ZONE: the derivation gate over
// KIND_DEVICE, the one-zone-per-device rule, the trip-table install gate,
// the deci-Kelvin discipline, the plausibility bounds, the hysteresis
// ladder, and the two-agreeing-reads confirmation before a critical
// crossing latches.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arithmetic, refusals and state transitions. IT ASSERTS
// NOTHING ABOUT A FAN AND NOTHING ABOUT A SHUTDOWN, because no code in
// this tree turns a level into a cooling state and no code in this tree
// powers the machine off — `src/kernel/core/cap/kind_thermal_zone.pdx` §6
// says so at length. A fixture that emitted "THERMAL POLICY OK" here
// would be the kernel talking to itself dressed up as thermal management,
// which is what #1590 had to unwind for three already-closed issues.
//
// -----------------------------------------------------------------------------
// Two fingerprints, not one
// -----------------------------------------------------------------------------
//
//   R31 KIND_THERMAL_ZONE OK   — stage A: the capability. Gate halves,
//                                rights, uniqueness, revoke, dispatch.
//   R31 THERMAL SCALE OK       — stage B: the numbers. Units, bounds,
//                                trip ordering, ladder, hysteresis,
//                                confirmation.
//
// Split there because the two fail for unrelated reasons and the goldens
// assert an ordered subsequence: a unit error and a broken gate would
// otherwise present as the same missing line. The split is also the one
// that matters for review — stage A is the shape every derived kind in
// this tree has, and stage B is the part that is specific to temperature
// and therefore the part nobody has read before.
//
// -----------------------------------------------------------------------------
// Cap slots 212..223
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness in the tree (which use 0..8, 10..12,
// 14..19, 28..33, 46..63, 64..95, 110..117, 160..199, 200..211). Both
// exits revoke every zone, clear every slot and reset the row table, so a
// failure here cannot be mistaken for a fault in whatever runs next.
//
// -----------------------------------------------------------------------------
// The numbers, and why these numbers
// -----------------------------------------------------------------------------
//
// crt 3730 dK (99.85 °C), psv 3630 (89.85 °C), _AC0/_AC1/_AC2 3330 / 3430
// / 3530 (59.85 / 69.85 / 79.85 °C), hysteresis 50 dK (5.0 K). A
// plausible Raptor Lake laptop ladder, chosen so that every gap is larger
// than the hysteresis — otherwise a descent test could not distinguish
// "held by hysteresis" from "the level below was never crossed".
//
// 950 appears twice as a refused value, and it is the reason the unit
// discipline exists: 95 °C expressed in tenths of a degree Celsius, which
// is what a `_CRT` of 95 becomes when somebody forgets that ACPI reports
// Kelvin. As a deci-Kelvin quantity it is 95.0 K, i.e. −178 °C, and the
// plausibility bound refuses it. A zone minted with it would trip on
// every reading forever.

module ThermalZoneSynth = structure {

  pub let mut _tz_w_stage : u64 = 0

  pub let tz_w_ok_a   : [u8; 26] = "R31 KIND_THERMAL_ZONE OK\n\0"
  pub let tz_w_fail_a : [u8; 28] = "R31 KIND_THERMAL_ZONE FAIL\n\0"
  pub let tz_w_ok_b   : [u8; 22] = "R31 THERMAL SCALE OK\n\0"
  pub let tz_w_fail_b : [u8; 24] = "R31 THERMAL SCALE FAIL\n\0"

  // ==========================================================================
  // tz_w_clear() — return slots 212..223 to boot state.
  // ==========================================================================

  pub let tz_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): clear cap_table slots 212..223 through cap_mint_write, the only descriptor writer, so the owner column's unconditional clear (#1587) runs on every one of them. Called on both exits: a witness whose failure path leaked twelve descriptors would make every witness after it report a different fault than the one that actually happened. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed tz_wc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        mov rbx, 212;
      tz_wc_loop:
        cmp rbx, 224;
        jae tz_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp tz_wc_loop;
      tz_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tz_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-001 (#1094): reset the zone row table and the sensor counters. THE COUNTERS MATTER MOST FOR A LATER READER: they are deliberately outside the rows so they survive a revoke, which means a fixture that left them populated would hand the next reader of thermal_zone_stat a count of implausible readings this fixture invented -- and 'this zone keeps returning nonsense' is exactly the diagnosis those counters exist to support. One push (rbx, unused) leaves rsp%16 == 0 at the nested call. Labels prefixed tz_ws_ per reserved-label discipline.",
      block: {
        push rbx;
        call thermal_zone_table_reset;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // tz_w_device(slot, key, rights) — mint a synthetic KIND_DEVICE parent.
  // ==========================================================================

  pub let tz_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): write a synthetic KIND_DEVICE descriptor whose target_ptr is `key`, through cap_mint_write. A fixture-local parent rather than a real PCI device capability, because what the gate under test reads out of the parent is exactly two things -- kind == 10 and target_ptr -- and manufacturing a real bus enumeration to supply them would test the enumerator rather than the gate. The rights argument is a parameter so that the RIGHT_MINT half of the gate can be exercised in BOTH directions from the same helper; a fixture that could only build a well-formed parent would leave the refusal untested. Two pushes leave rsp%16 == 0 at the nested call. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        // rdx still holds `rights`; nothing above clobbered it, and it is
        // passed through unchanged.
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let thermal_zone_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R31.M2-001 (#1094) / R31.M2-002 (#1095): boot witness for KIND_THERMAL_ZONE. STAGE A drives the capability: both halves of the derivation gate in both directions, the rights subset test, the four mint refusals that keep a zone from existing without a plausible critical threshold and a non-zero hysteresis, the one-zone-per-device rule, the wrong-kind revoke refusal, the dispatch handler's per-op rights and its refusal of a non-zero reserved field on the one op that carries a value, and a re-mint after revoke which is what proves no ghost row was stranded. STAGE B drives the numbers, and it is the half that is specific to this kind: the unit conversion against a known value AND against the two wrong answers a sign error and a missing offset would give, the plausibility bounds at both edges and one place past each, the trip-install ordering gate including the _PSV/_AC2 crossing that makes the ladder well-ordered by construction, the ladder itself level by level, hysteresis on the way DOWN with a hold and a release either side of the band, and sec 3's two-agreeing-reads confirmation in all four of its paths -- armed, confirmed, disagreed-and-rearmed, and cleared by a reading below the threshold. THE ASSERTION TO NOTE IS B9: ONE READING ABOVE _CRT DOES NOT LATCH. A single unarbitrated embedded-controller read authorising a power-off is the wrong shape while #1580 is open, and B9 is the only place in the tree that says so mechanically. Each stage runs only if the previous passed, so a cascade from one cause is reported once at its origin. Both exits call tz_w_scrub and tz_w_clear. Five-push prologue (rbx, r12, r13, r14, r15) leaves rsp%16 == 0 at every nested call; the stage counter lives in module .bss so it survives every callee-save-clobber pattern in the primitives under test. Labels prefixed tz_w_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        call tz_w_clear;
        call tz_w_scrub;

        // 212 — a well-formed parent. 213 — no RIGHT_MINT. 214 —
        // RIGHT_MINT but a zero identity.
        mov rdi, 212;
        mov rsi, 0xAA01;
        mov rdx, 0x200;                  // RIGHT_MINT
        call tz_w_device;
        mov rdi, 213;
        mov rsi, 0xAA09;
        mov rdx, 0x001;                  // no RIGHT_MINT
        call tz_w_device;
        mov rdi, 214;
        xor rsi, rsi;                    // no identity
        mov rdx, 0x200;
        call tz_w_device;
        mov rdi, 217;
        mov rsi, 0xAA02;
        mov rdx, 0x200;
        call tz_w_device;
        mov rdi, 219;
        mov rsi, 0xAA03;
        mov rdx, 0x200;
        call tz_w_device;
        mov rdi, 221;
        mov rsi, 0xAA04;
        mov rdx, 0x200;
        call tz_w_device;

        // -- A1. The first half of the gate, in both directions. A slot
        //    holding nothing, and a KIND_DEVICE without RIGHT_MINT, are
        //    both MINT_BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 212;
        call thermal_zone_check_parent_device;
        cmp rax, 1;
        jne tz_w_fail_stage_a;

        mov rdi, 213;
        call thermal_zone_check_parent_device;
        cmp rax, 0;
        jne tz_w_fail_stage_a;

        mov rdi, 216;                    // empty slot
        call thermal_zone_check_parent_device;
        cmp rax, 0;
        jne tz_w_fail_stage_a;

        mov rdi, 215;
        mov rsi, 213;                    // parent without RIGHT_MINT
        mov rdx, 0x41B;
        mov rcx, 3730;
        mov r8, 50;
        call thermal_zone_cap_mint;
        mov r11, 0xFFFFFE3D;             // THERMAL_MINT_BAD_PARENT
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        // -- A2. Rights are a SUBSET test, and RIGHT_MINT is outside the
        //    mask. This kind is a leaf, so a mint bit no gate reads would
        //    be authority that later acquires a meaning nobody audited.
        mov rax, 3;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 0x001;                  // READ alone
        call thermal_zone_rights_valid;
        cmp rax, 1;
        jne tz_w_fail_stage_a;
        mov rdi, 0x41B;                  // R_THERMAL_ALL
        call thermal_zone_rights_valid;
        cmp rax, 1;
        jne tz_w_fail_stage_a;
        mov rdi, 0x200;                  // RIGHT_MINT
        call thermal_zone_rights_valid;
        cmp rax, 0;
        jne tz_w_fail_stage_a;

        mov rdi, 215;
        mov rsi, 212;
        mov rdx, 0x21B;                  // R_THERMAL_ALL | RIGHT_MINT
        mov rcx, 3730;
        mov r8, 50;
        call thermal_zone_cap_mint;
        mov r11, 0xFFFFFE3C;             // THERMAL_MINT_BAD_RIGHTS
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        // -- A3. A ZONE CANNOT EXIST WITHOUT A PLAUSIBLE _CRT. 950 is 95
        //    °C in tenths of a DEGREE CELSIUS, which is what a _CRT of 95
        //    becomes when somebody forgets that ACPI reports Kelvin, and
        //    it is refused. A zone minted with it would report CRITICAL
        //    on every reading forever.
        mov rax, 4;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 215;
        mov rsi, 212;
        mov rdx, 0x41B;
        mov rcx, 950;                    // Celsius mistaken for deci-Kelvin
        mov r8, 50;
        call thermal_zone_cap_mint;
        mov r11, 0xFFFFFE3B;             // THERMAL_MINT_BAD_CRT
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        mov rdi, 215;
        mov rsi, 212;
        mov rdx, 0x41B;
        xor rcx, rcx;                    // no critical threshold at all
        mov r8, 50;
        call thermal_zone_cap_mint;
        mov r11, 0xFFFFFE3B;
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        // -- A4. And not without a hysteresis. Zero flaps the cooling
        //    state on the trip point; there is no default the kernel
        //    could pick, and being made to decide is the point.
        mov rax, 5;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 215;
        mov rsi, 212;
        mov rdx, 0x41B;
        mov rcx, 3730;
        xor r8, r8;
        call thermal_zone_cap_mint;
        mov r11, 0xFFFFFE3A;             // THERMAL_MINT_BAD_HYST
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        mov rdi, 215;
        mov rsi, 212;
        mov rdx, 0x41B;
        mov rcx, 3730;
        mov r8, 201;                     // past THERMAL_HYST_MAX_DK
        call thermal_zone_cap_mint;
        mov r11, 0xFFFFFE3A;
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        // -- A5. The identity is INHERITED, so a parent naming no device
        //    cannot resolve to "device 0".
        mov rax, 6;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 214;
        call thermal_zone_parent_key;
        cmp rax, 0;
        jne tz_w_fail_stage_a;

        mov rdi, 215;
        mov rsi, 214;
        mov rdx, 0x41B;
        mov rcx, 3730;
        mov r8, 50;
        call thermal_zone_cap_mint;
        mov r11, 0xFFFFFE39;             // THERMAL_MINT_NO_DEVICE
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        // -- A6. The happy path, and the row reads back as minted. The
        //    critical threshold comes through the ARITY-ONE resolver,
        //    which is the only route from a capability to a threshold.
        mov rax, 7;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 215;
        mov rsi, 212;
        mov rdx, 0x41B;
        mov rcx, 3730;
        mov r8, 50;
        call thermal_zone_cap_mint;
        cmp rax, 0;                      // THERMAL_OK
        jne tz_w_fail_stage_a;

        mov rdi, 215;
        call thermal_zone_crt_of_slot;
        cmp rax, 3730;
        jne tz_w_fail_stage_a;

        mov rdi, 215;
        call thermal_zone_level_of_slot;
        cmp rax, 0;                      // THERMAL_LVL_NOMINAL
        jne tz_w_fail_stage_a;

        mov rdi, 215;
        call thermal_zone_crt_latched_of_slot;
        cmp rax, 0;
        jne tz_w_fail_stage_a;

        mov rdi, 215;
        call thermal_zone_row_of_slot;
        mov rbx, rax;                    // rbx = the zone's row, held on
        cmp rbx, 0xFF;                   // THERMAL_ROW_NONE
        je  tz_w_fail_stage_a;

        mov rdi, rbx;
        call thermal_zone_row_key;
        cmp rax, 0xAA01;                 // the INHERITED key, not an argument
        jne tz_w_fail_stage_a;

        mov rdi, rbx;
        call thermal_zone_row_parent;
        cmp rax, 212;
        jne tz_w_fail_stage_a;

        mov rdi, rbx;
        call thermal_zone_row_trips;
        cmp rax, 0;                      // the optional trips start EMPTY
        jne tz_w_fail_stage_a;

        // -- A7. ONE ZONE, ONE CAPABILITY. The second mint over the same
        //    device is REFUSED, not merged: two capabilities over one
        //    zone means two hysteresis states and two critical latches
        //    driving one control loop with neither able to see the other.
        mov rax, 8;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 216;
        mov rsi, 212;                    // the SAME device
        mov rdx, 0x41B;
        mov rcx, 3730;
        mov r8, 50;
        call thermal_zone_cap_mint;
        mov r11, 0xFFFFFE37;             // THERMAL_MINT_ZONE_IN_USE
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        mov rdi, 0xAA01;
        call thermal_zone_find_by_key;
        cmp rax, rbx;                    // and it is THIS row that holds it
        jne tz_w_fail_stage_a;

        // A DIFFERENT device is a different zone and is admitted.
        mov rdi, 218;
        mov rsi, 217;
        mov rdx, 0x41B;
        mov rcx, 3730;
        mov r8, 50;
        call thermal_zone_cap_mint;
        cmp rax, 0;
        jne tz_w_fail_stage_a;

        // -- A8. The revoke refusals. A zone revoke aimed at the DEVICE
        //    descriptor must not clear it, which is what makes it safe
        //    for the owner-column sweep to call this blindly.
        mov rax, 9;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 212;                    // a KIND_DEVICE
        call thermal_zone_cap_revoke;
        mov r11, 0xFFFFFE35;             // THERMAL_WRONG_KIND
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        mov rdi, 223;                    // an empty slot
        call thermal_zone_cap_revoke;
        mov r11, 0xFFFFFE34;             // THERMAL_REVOKE_ALREADY
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        // The device survived the refused revoke.
        mov rdi, 212;
        call thermal_zone_check_parent_device;
        cmp rax, 1;
        jne tz_w_fail_stage_a;

        // -- A9. The dispatch handler. Per-op rights, and the ops that do
        //    NOT exist.
        mov rax, 10;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        // target_ptr as cap_mint_write wrote it: row | (slot << 16).
        mov r12, rbx;
        mov r13, 215;
        shl r13, 16;
        or  r12, r13;                    // r12 = target_ptr for slot 215

        mov rdi, 0x001;                  // R_THERMAL_READ
        mov rsi, r12;
        xor rdx, rdx;                    // THERMAL_OP_QUERY_CRT
        call cap_handler_thermal_zone;
        cmp rax, 3730;
        jne tz_w_fail_stage_a;

        // QUERY_CRT is READ, not INVOKE: a threshold is a statement about
        // how hot this part may get, which is the reading's own class of
        // fact. A holder with INVOKE alone is DENIED.
        mov rdi, 0x008;                  // R_THERMAL_INVOKE alone
        mov rsi, r12;
        xor rdx, rdx;
        call cap_handler_thermal_zone;
        mov r11, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 1;                      // QUERY_HYST
        call cap_handler_thermal_zone;
        cmp rax, 50;
        jne tz_w_fail_stage_a;

        // NO OP CAN REACH A THRESHOLD SETTER, because there is none. Op 9
        // is where one would go.
        mov rdi, 0x41B;                  // every right
        mov rsi, r12;
        mov rdx, 9;
        call cap_handler_thermal_zone;
        mov r11, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        // ASSESS carries a reading in op_arg[31:16] and REFUSES a
        // non-zero op_arg[63:32] rather than masking it. Thirty-two free
        // bits on an invocation that reaches a _CRT comparison is where a
        // second temperature would be smuggled.
        mov rdi, 0x001;
        mov rsi, r12;
        mov r13, 1;
        shl r13, 32;
        or  r13, 8;                      // op 8 with the reserved field set
        mov rdx, r13;
        call cap_handler_thermal_zone;
        mov r11, 0xFFFFFE3E;             // THERMAL_TAIL_BAD_ARG
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        // -- A10. Revoke, and RE-MINT. The re-mint is the assertion: a
        //    stranded row would still hold this zone's uniqueness key, so
        //    a restarted policy server claiming the part it is meant to
        //    watch would be refused ZONE_IN_USE by a ghost belonging to a
        //    dead process.
        mov rax, 11;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 215;
        call thermal_zone_cap_revoke;
        cmp rax, 0;
        jne tz_w_fail_stage_a;

        mov rdi, rbx;
        call thermal_zone_tail_valid;
        cmp rax, 0;                      // the row went with it
        jne tz_w_fail_stage_a;

        mov rdi, 0xAA01;
        call thermal_zone_find_by_key;
        cmp rax, 0xFF;                   // THERMAL_ROW_NONE
        jne tz_w_fail_stage_a;

        mov rdi, 215;
        mov rsi, 212;
        mov rdx, 0x41B;
        mov rcx, 3730;
        mov r8, 50;
        call thermal_zone_cap_mint;
        cmp rax, 0;
        jne tz_w_fail_stage_a;

        // -- A11. A dead row answers THERMAL_DECODE_BAD and never a
        //    plausible zero. On this kind that matters for every field: a
        //    scrubbed row renders as a zone with no critical threshold
        //    sitting comfortably cool, which is the most misleading four
        //    values this module could emit.
        mov rax, 12;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 7;                      // a never-claimed row
        call thermal_zone_row_crt;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        mov rdi, 7;
        call thermal_zone_row_level;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        mov rdi, 7;
        call thermal_zone_row_latched;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        mov rdi, 223;                    // a slot holding nothing
        call thermal_zone_crt_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        mov rdi, 212;                    // a KIND_DEVICE, not a zone
        call thermal_zone_crt_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne tz_w_fail_stage_a;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tz_w_ok_a];
        call klog_s1;

        // ================================================================
        // STAGE B — THE NUMBERS.
        // ================================================================

        // -- B1. THE UNIT, END TO END, AGAINST A KNOWN VALUE AND AGAINST
        //    THE TWO WRONG ANSWERS. 3000 dK is 300.0 K is 26.85 °C, which
        //    on ACPI's tenth-of-a-Kelvin grid is 268 dC. Asserting the
        //    right answer alone would pass against a conversion that
        //    returned its argument unchanged only by coincidence, so the
        //    two wrong answers are asserted too: 3000 (no offset applied)
        //    and 5732 (the offset applied in the wrong direction).
        mov rax, 21;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 3000;
        call thermal_dk_to_dc;
        cmp rax, 268;
        jne tz_w_fail_stage_b;
        cmp rax, 3000;                   // the missing-offset answer
        je  tz_w_fail_stage_b;
        cmp rax, 5732;                   // the wrong-direction answer
        je  tz_w_fail_stage_b;

        mov rdi, 2732;                   // exactly 0 °C
        call thermal_dk_to_dc;
        cmp rax, 0;
        jne tz_w_fail_stage_b;

        // Below the offset there is no unsigned deci-Celsius answer, and
        // the printer says so rather than wrapping to an enormous
        // positive temperature -- which would be the one confusion this
        // function exists not to cause, arriving through this function.
        mov rdi, 2731;
        call thermal_dk_to_dc;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne tz_w_fail_stage_b;

        mov rdi, 3730;                   // the fixture's own _CRT
        call thermal_dk_to_dc;
        cmp rax, 998;                    // 99.8 °C
        jne tz_w_fail_stage_b;

        // -- B2. The plausibility window, at both edges and one place
        //    past each. And the two values that motivate it: a Celsius
        //    reading mistaken for deci-Kelvin, and a zero.
        mov rax, 22;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 2232;                   // THERMAL_DK_MIN, inclusive
        call thermal_dk_plausible;
        cmp rax, 1;
        jne tz_w_fail_stage_b;
        mov rdi, 4232;                   // THERMAL_DK_MAX, inclusive
        call thermal_dk_plausible;
        cmp rax, 1;
        jne tz_w_fail_stage_b;
        mov rdi, 2231;
        call thermal_dk_plausible;
        cmp rax, 0;
        jne tz_w_fail_stage_b;
        mov rdi, 4233;
        call thermal_dk_plausible;
        cmp rax, 0;
        jne tz_w_fail_stage_b;
        mov rdi, 950;                    // 95 °C read as deci-Kelvin
        call thermal_dk_plausible;
        cmp rax, 0;
        jne tz_w_fail_stage_b;
        xor rdi, rdi;
        call thermal_dk_plausible;
        cmp rax, 0;
        jne tz_w_fail_stage_b;

        // -- B3. The trip install. Once, and the count is the vacuity
        //    guard for every ladder assertion below it.
        mov rax, 23;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 215;
        call thermal_zone_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;
        je  tz_w_fail_stage_b;

        mov rdi, 215;
        mov rsi, 3630;                   // _PSV
        mov rdx, 0x0000000000000000;
        mov r13, 3530;
        shl r13, 32;
        mov r14, 3430;
        shl r14, 16;
        or  r13, r14;
        or  r13, 3330;
        mov rdx, r13;                    // _AC0 | _AC1<<16 | _AC2<<32
        call thermal_zone_trips_install;
        cmp rax, 0;
        jne tz_w_fail_stage_b;

        mov rdi, rbx;
        call thermal_zone_row_trips;
        cmp rax, 4;                      // _PSV + three _ACx
        jne tz_w_fail_stage_b;

        mov rdi, rbx;
        call thermal_zone_row_psv;
        cmp rax, 3630;
        jne tz_w_fail_stage_b;
        mov rdi, rbx;
        xor rsi, rsi;
        call thermal_zone_row_ac;
        cmp rax, 3330;
        jne tz_w_fail_stage_b;
        mov rdi, rbx;
        mov rsi, 2;
        call thermal_zone_row_ac;
        cmp rax, 3530;
        jne tz_w_fail_stage_b;

        // AND THE _CRT IS UNCHANGED BY AN INSTALL, because it is not part
        // of the installable set. There is no argument for it here and no
        // primitive anywhere that takes one.
        mov rdi, 215;
        call thermal_zone_crt_of_slot;
        cmp rax, 3730;
        jne tz_w_fail_stage_b;

        // -- B4. Installing twice is REFUSED, not merged. Every cooling
        //    decision is taken from these thresholds, so a zone whose
        //    _AC0 changed an hour into the boot stops requesting a fan at
        //    a temperature it used to request one at, with no symptom
        //    until the part is hot.
        mov rax, 24;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 215;
        mov rsi, 3630;
        mov rdx, r13;
        call thermal_zone_trips_install;
        mov r11, 0xFFFFFE33;             // THERMAL_TRIP_ALREADY
        cmp rax, r11;
        jne tz_w_fail_stage_b;

        // -- B5. The ordering gate, on the zone whose trips are still
        //    empty. Five refusals, each a different way the ladder would
        //    otherwise stop being well-ordered.
        mov rax, 25;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 222;
        mov rsi, 221;
        mov rdx, 0x41B;
        mov rcx, 3730;
        mov r8, 50;
        call thermal_zone_cap_mint;
        cmp rax, 0;
        jne tz_w_fail_stage_b;

        // _AC1 with no _AC0 — ACPI numbers active levels from 0, so a gap
        // means the parse lost one, and a lost level is a fan speed the
        // firmware asked for that nobody will ever request.
        mov rdi, 222;
        xor rsi, rsi;
        mov r14, 3430;
        shl r14, 16;
        mov rdx, r14;
        call thermal_zone_trips_install;
        mov r11, 0xFFFFFE31;             // THERMAL_TRIP_BAD_AC
        cmp rax, r11;
        jne tz_w_fail_stage_b;

        // _AC1 below _AC0 — descending is not a ladder.
        mov rdi, 222;
        xor rsi, rsi;
        mov r14, 3330;
        shl r14, 16;
        or  r14, 3430;
        mov rdx, r14;
        call thermal_zone_trips_install;
        mov r11, 0xFFFFFE31;
        cmp rax, r11;
        jne tz_w_fail_stage_b;

        // An active level at or above _CRT — a fan request that can only
        // fire once the part is already being shut down.
        mov rdi, 222;
        xor rsi, rsi;
        mov rdx, 3730;
        call thermal_zone_trips_install;
        mov r11, 0xFFFFFE31;
        cmp rax, r11;
        jne tz_w_fail_stage_b;

        // THE CROSSING. _PSV at or below the top _ACx is what would make
        // "the highest crossed trip" ill-defined: the ladder would report
        // PASSIVE while an active level the firmware wanted was never
        // requested. Refused once here rather than resolved at every
        // evaluation.
        mov rdi, 222;
        mov rsi, 3400;                   // _PSV below _AC1
        mov r14, 3430;
        shl r14, 16;
        or  r14, 3330;
        mov rdx, r14;
        call thermal_zone_trips_install;
        mov r11, 0xFFFFFE32;             // THERMAL_TRIP_BAD_PSV
        cmp rax, r11;
        jne tz_w_fail_stage_b;

        // _PSV at or above _CRT.
        mov rdi, 222;
        mov rsi, 3730;
        xor rdx, rdx;
        call thermal_zone_trips_install;
        mov r11, 0xFFFFFE32;
        cmp rax, r11;
        jne tz_w_fail_stage_b;

        // Reserved bits of the packed active levels.
        mov rdi, 222;
        xor rsi, rsi;
        mov r14, 1;
        shl r14, 48;
        mov rdx, r14;
        call thermal_zone_trips_install;
        mov r11, 0xFFFFFE31;
        cmp rax, r11;
        jne tz_w_fail_stage_b;

        // Nothing was stored by any of the seven refusals. NOTHING IS
        // CLAMPED anywhere in this path, because clamping a trip point
        // picks a temperature and picking one is not the kernel's to do.
        mov rdi, 222;
        call thermal_zone_row_of_slot;
        mov rdi, rax;
        call thermal_zone_row_trips;
        cmp rax, 0;
        jne tz_w_fail_stage_b;

        // -- B6. THE LADDER, level by level, on the zone from B3.
        mov rax, 26;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 215;
        mov rsi, 3000;
        call thermal_zone_assess;
        cmp rax, 0;                      // NOMINAL
        jne tz_w_fail_stage_b;
        mov rdi, 215;
        mov rsi, 3330;
        call thermal_zone_assess;
        cmp rax, 1;                      // ACTIVE1
        jne tz_w_fail_stage_b;
        mov rdi, 215;
        mov rsi, 3430;
        call thermal_zone_assess;
        cmp rax, 2;
        jne tz_w_fail_stage_b;
        mov rdi, 215;
        mov rsi, 3530;
        call thermal_zone_assess;
        cmp rax, 3;
        jne tz_w_fail_stage_b;
        mov rdi, 215;
        mov rsi, 3630;
        call thermal_zone_assess;
        cmp rax, 4;                      // PASSIVE
        jne tz_w_fail_stage_b;

        // Rising follows the temperature IMMEDIATELY. A part getting
        // hotter gets cooling now, and hysteresis has no business on the
        // way up.
        mov rdi, 215;
        call thermal_zone_level_of_slot;
        cmp rax, 4;
        jne tz_w_fail_stage_b;

        // -- B7. HYSTERESIS, ON THE WAY DOWN ONLY, either side of the
        //    band. At level 4 the entry threshold is 3630 and the
        //    hysteresis is 50, so 3600 HOLDS (3600 + 50 >= 3630) and 3579
        //    RELEASES (3579 + 50 < 3630). Without the band the zone would
        //    flap between two levels while sitting on the trip point.
        mov rax, 27;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 215;
        mov rsi, 3600;
        call thermal_zone_assess;
        cmp rax, 4;                      // held
        jne tz_w_fail_stage_b;

        mov rdi, 215;
        mov rsi, 3579;
        call thermal_zone_assess;
        cmp rax, 3;                      // released, to the raw level
        jne tz_w_fail_stage_b;

        mov rdi, 215;
        mov rsi, 3000;
        call thermal_zone_assess;
        cmp rax, 0;                      // and all the way down
        jne tz_w_fail_stage_b;

        // -- B8. AN IMPLAUSIBLE READING CHANGES NOTHING. Not the level,
        //    not the candidate, not the latch. While #1580 leaves the
        //    embedded-controller path unarbitrated against SMM, a read
        //    that races firmware can return a byte that is not a
        //    temperature, and the only defensible response to one is to
        //    do nothing and count it.
        mov rax, 28;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 215;
        mov rsi, 3530;
        call thermal_zone_assess;
        cmp rax, 3;
        jne tz_w_fail_stage_b;

        mov rdi, 1;                      // THERMAL_ST_IMPLAUSIBLE
        call thermal_zone_stat;
        mov r14, rax;                    // the count before

        mov rdi, 215;
        mov rsi, 5000;                   // not a temperature
        call thermal_zone_assess;
        mov r11, 0xFFFFFE30;             // THERMAL_IMPLAUSIBLE
        cmp rax, r11;
        jne tz_w_fail_stage_b;

        mov rdi, 215;
        call thermal_zone_level_of_slot;
        cmp rax, 3;                      // the level did not move
        jne tz_w_fail_stage_b;

        mov rdi, 1;
        call thermal_zone_stat;
        sub rax, r14;
        cmp rax, 1;                      // and it was counted
        jne tz_w_fail_stage_b;

        // -- B9. THE ASSERTION THIS MILESTONE'S SAFETY ARGUMENT RESTS ON.
        //    ONE READING ABOVE _CRT DOES NOT LATCH.
        //
        //    A single unarbitrated embedded-controller read authorising a
        //    power-off is the wrong shape. So the first reading above the
        //    critical threshold arms a candidate and returns the highest
        //    NON-critical verdict -- the fans go to maximum on the
        //    strength of one hot reading while the shutdown waits for a
        //    second -- and only a second reading that AGREES with it
        //    within 50 dK latches.
        mov rax, 29;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 215;
        mov rsi, 3800;                   // above _CRT (3730)
        call thermal_zone_assess;
        cmp rax, 4;                      // PASSIVE, and NOT CRITICAL
        jne tz_w_fail_stage_b;

        mov rdi, 215;
        call thermal_zone_crt_latched_of_slot;
        cmp rax, 0;                      // NOT LATCHED
        jne tz_w_fail_stage_b;

        mov rdi, rbx;
        call thermal_zone_row_cand;
        cmp rax, 3800;                   // but armed, and with THIS value
        jne tz_w_fail_stage_b;

        mov rdi, 215;
        mov rsi, 3810;                   // agrees within 50 dK
        call thermal_zone_assess;
        cmp rax, 5;                      // THERMAL_LVL_CRITICAL
        jne tz_w_fail_stage_b;

        mov rdi, 215;
        call thermal_zone_crt_latched_of_slot;
        cmp rax, 1;
        jne tz_w_fail_stage_b;

        // ONCE LATCHED, NEVER CLEARED. A part that went past its limit
        // did go past it, and a subsequent cool reading is evidence that
        // something started cooling it -- not evidence that it never
        // happened.
        mov rdi, 215;
        mov rsi, 3000;
        call thermal_zone_assess;
        cmp rax, 5;
        jne tz_w_fail_stage_b;

        mov rdi, 4;                      // THERMAL_ST_LATCHED
        call thermal_zone_stat;
        cmp rax, 1;
        jne tz_w_fail_stage_b;

        // -- B10. TWO READINGS THAT DISAGREE RE-ARM RATHER THAN LATCH.
        //    Readings 30 K apart are evidence of a sensor that is lying,
        //    not of a hot part, and a machine that powers off because of
        //    one is a machine an operator cannot keep running.
        mov rax, 30;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 218;                    // the second zone, untouched
        call thermal_zone_row_of_slot;
        mov r15, rax;
        cmp r15, 0xFF;
        je  tz_w_fail_stage_b;

        mov rdi, 218;
        mov rsi, 3800;
        call thermal_zone_assess;
        cmp rax, 0;                      // no trips installed: NOMINAL
        jne tz_w_fail_stage_b;

        mov rdi, 218;
        call thermal_zone_crt_latched_of_slot;
        cmp rax, 0;
        jne tz_w_fail_stage_b;

        mov rdi, 218;
        mov rsi, 4100;                   // 30 K away from the candidate
        call thermal_zone_assess;
        cmp rax, 0;                      // still not critical
        jne tz_w_fail_stage_b;

        mov rdi, 218;
        call thermal_zone_crt_latched_of_slot;
        cmp rax, 0;                      // STILL NOT LATCHED
        jne tz_w_fail_stage_b;

        mov rdi, r15;
        call thermal_zone_row_cand;
        cmp rax, 4100;                   // re-armed with the newer value
        jne tz_w_fail_stage_b;

        mov rdi, 3;                      // THERMAL_ST_DISAGREED
        call thermal_zone_stat;
        cmp rax, 1;
        jne tz_w_fail_stage_b;

        // The third reading agrees with the second, and now it latches.
        mov rdi, 218;
        mov rsi, 4110;
        call thermal_zone_assess;
        cmp rax, 5;
        jne tz_w_fail_stage_b;

        // -- B11. A READING BELOW _CRT CLEARS THE CANDIDATE, so a hot
        //    reading followed by a cool one followed by another hot one
        //    does NOT latch. Without the clear, two transients minutes
        //    apart would be treated as agreement.
        mov rax, 31;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, 220;
        mov rsi, 219;
        mov rdx, 0x41B;
        mov rcx, 3730;
        mov r8, 50;
        call thermal_zone_cap_mint;
        cmp rax, 0;
        jne tz_w_fail_stage_b;

        mov rdi, 220;
        call thermal_zone_row_of_slot;
        mov r15, rax;

        mov rdi, 220;
        mov rsi, 3800;
        call thermal_zone_assess;
        mov rdi, r15;
        call thermal_zone_row_cand;
        cmp rax, 3800;
        jne tz_w_fail_stage_b;

        mov rdi, 220;
        mov rsi, 3000;                   // below _CRT
        call thermal_zone_assess;
        mov rdi, r15;
        call thermal_zone_row_cand;
        cmp rax, 0;                      // the candidate is gone
        jne tz_w_fail_stage_b;

        mov rdi, 220;
        mov rsi, 3800;                   // hot again, but this is the FIRST
        call thermal_zone_assess;
        mov rdi, 220;
        call thermal_zone_crt_latched_of_slot;
        cmp rax, 0;                      // and one reading never latches
        jne tz_w_fail_stage_b;

        // -- B12. The printer refuses a dead row rather than rendering it
        //    as a plausible zone with no critical threshold sitting cool.
        mov rax, 32;
        lea rcx, [rip + _tz_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call thermal_zone_debug_print;
        cmp rax, 0;
        jne tz_w_fail_stage_b;

        mov rdi, 7;                      // never claimed
        call thermal_zone_debug_print;
        mov r11, 0xFFFFFE3E;             // THERMAL_TAIL_BAD_ARG
        cmp rax, r11;
        jne tz_w_fail_stage_b;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tz_w_ok_b];
        call klog_s1;

        call tz_w_scrub;
        call tz_w_clear;
        xor rax, rax;
        jmp tz_w_out;

      tz_w_fail_stage_a:
        lea rax, [rip + _tz_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tz_w_fail_a];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp tz_w_failed;

      tz_w_fail_stage_b:
        lea rax, [rip + _tz_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tz_w_fail_b];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      tz_w_failed:
        call tz_w_scrub;
        call tz_w_clear;
        mov rax, 1;

      tz_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
