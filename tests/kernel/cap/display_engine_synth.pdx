// tests/kernel/cap/display_engine_synth.pdx — R36.M1-004 (#1238)
//
// Boot witness for KIND_DISPLAY_ENGINE.
//
// Asserts derivation gate over KIND_DEVICE, bdf / gen / power_state /
// cdclk refusals, uniqueness on engine_key, device-key inheritance,
// mint / revoke round-trip.
//
// Fingerprint: R36 KIND_DISPLAY_ENGINE OK
//
// Cap slots 256..263 — a fresh range past every prior witness's
// set (previous max: 252..255 for consent_revoke_synth). Every
// exit path scrubs the range so nothing bleeds into later
// witnesses.

module DisplayEngineSynth = structure {

  pub let mut _dpew_stage : u64 = 0

  pub let dpew_ok   : [u8; 28] = "R36 KIND_DISPLAY_ENGINE OK\n\0"
  pub let dpew_fail : [u8; 30] = "R36 KIND_DISPLAY_ENGINE FAIL\n\0"

  pub let dpew_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M1-004 (#1238): clear cap_table slots 256..263.",
      block: {
        push rbx;
        mov rbx, 256;
      dpewc_loop:
        cmp rbx, 264;
        jae dpewc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp dpewc_loop;
      dpewc_done:
        pop rbx;
        ret
      }
    }

  pub let dpew_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-004 (#1238): reset DISPLAY ENGINE row table.",
      block: {
        push rbx;
        call display_engine_table_reset;
        pop rbx;
        ret
      }
    }

  // Synthesize a KIND_DEVICE cap at `slot` carrying `rights` with
  // target_ptr = device_key.
  pub let dpew_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (device_key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M1-004 (#1238): synthetic KIND_DEVICE for gate testing.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let display_engine_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R36.M1-004 (#1238): boot witness. Stages: (1) validators. (2) BAD_PARENT on non-device slot. (3) NO_DEVICE on device with target_ptr==0. (4) Happy path. (5) Query fields. (6) IN_USE on duplicate key. (7) BAD_GEN. (8) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dpew_stage];
        mov [rcx], rax;

        call dpew_clear;
        call dpew_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call display_engine_bdf_valid;
        cmp rax, 1;
        jne dpew_fail_stage;
        mov rdi, 0x10000;
        call display_engine_bdf_valid;
        cmp rax, 0;
        jne dpew_fail_stage;

        mov rdi, 1;
        call display_engine_gen_valid;
        cmp rax, 1;
        jne dpew_fail_stage;
        mov rdi, 3;
        call display_engine_gen_valid;
        cmp rax, 1;
        jne dpew_fail_stage;
        mov rdi, 0;
        call display_engine_gen_valid;
        cmp rax, 0;
        jne dpew_fail_stage;
        mov rdi, 4;
        call display_engine_gen_valid;
        cmp rax, 0;
        jne dpew_fail_stage;

        mov rdi, 0;
        call display_engine_power_valid;
        cmp rax, 1;
        jne dpew_fail_stage;
        mov rdi, 2;
        call display_engine_power_valid;
        cmp rax, 1;
        jne dpew_fail_stage;
        mov rdi, 3;
        call display_engine_power_valid;
        cmp rax, 0;
        jne dpew_fail_stage;

        mov rdi, 500000;                 // CDCLK valid mid-range
        call display_engine_cdclk_valid;
        cmp rax, 1;
        jne dpew_fail_stage;
        mov rdi, 50000;                  // below floor
        call display_engine_cdclk_valid;
        cmp rax, 0;
        jne dpew_fail_stage;

        mov rdi, 0x419;
        call display_engine_rights_valid;
        cmp rax, 1;
        jne dpew_fail_stage;
        mov rdi, 0x200;                  // RIGHT_MINT outside mask
        call display_engine_rights_valid;
        cmp rax, 0;
        jne dpew_fail_stage;

        // Setup: KIND_DEVICE at slot 257 with device_key 0xC0FFEE01.
        mov rdi, 257;
        mov rsi, 0x200;
        mov rdx, 0xC0FFEE01;
        call dpew_device;

        // packed_ident builder:
        //   [15:0]  pci_bdf     = 0x0100
        //   [23:16] gpu_gen     = 2 (Xe2)
        //   [31:24] power_state = 1 (ON)
        //   [63:32] cdclk_khz   = 540000
        //
        // Reused across stages, so hoist to a helper builder below.

        // -- 2. BAD_PARENT (parent slot 256 empty).
        mov rax, 2;
        lea rcx, [rip + _dpew_stage];
        mov [rcx], rax;

        mov r10, 0x0100;
        mov r11, 2;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 540000;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 259;
        mov rsi, 256;                    // parent = empty
        mov rdx, 0x419;
        mov rcx, 0xDEADFACE;
        mov r8, 0xC0FFEE01;
        mov r9, r10;
        call display_engine_cap_mint_inner;
        mov r11, 0xFFFFF7CD;             // BAD_PARENT
        cmp rax, r11;
        jne dpew_fail_stage;

        // -- 3. NO_DEVICE on device with target_ptr==0.
        mov rax, 3;
        lea rcx, [rip + _dpew_stage];
        mov [rcx], rax;

        mov rdi, 258;
        mov rsi, 0x200;
        mov rdx, 0;
        call dpew_device;

        mov r10, 0x0100;
        mov r11, 2;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 540000;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 259;
        mov rsi, 258;
        mov rdx, 0x419;
        mov rcx, 0xDEADFACE;
        mov r8, 0xC0FFEE01;
        mov r9, r10;
        call display_engine_cap_mint_inner;
        mov r11, 0xFFFFF7C7;             // NO_DEVICE
        cmp rax, r11;
        jne dpew_fail_stage;

        // -- 4. Happy path.
        mov rax, 4;
        lea rcx, [rip + _dpew_stage];
        mov [rcx], rax;

        mov r10, 0x0100;
        mov r11, 2;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 540000;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 259;
        mov rsi, 257;                    // parent w/ good key
        mov rdx, 0x419;
        mov rcx, 0xDEADFACE;
        mov r8, 0xC0FFEE01;
        mov r9, r10;
        call display_engine_cap_mint_inner;
        cmp rax, 0;
        jne dpew_fail_stage;

        // -- 5. Query fields.
        mov rax, 5;
        lea rcx, [rip + _dpew_stage];
        mov [rcx], rax;

        mov rdi, 259;
        call display_engine_key_of_slot;
        mov r11, 0xDEADFACE;
        cmp rax, r11;
        jne dpew_fail_stage;

        // -- 6. IN_USE on duplicate key.
        mov rax, 6;
        lea rcx, [rip + _dpew_stage];
        mov [rcx], rax;

        mov r10, 0x0200;
        mov r11, 2;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 652800;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 260;
        mov rsi, 257;
        mov rdx, 0x419;
        mov rcx, 0xDEADFACE;             // duplicate key
        mov r8, 0xC0FFEE01;
        mov r9, r10;
        call display_engine_cap_mint_inner;
        mov r11, 0xFFFFF7C4;             // IN_USE
        cmp rax, r11;
        jne dpew_fail_stage;

        // -- 7. BAD_GEN (gen = 0).
        mov rax, 7;
        lea rcx, [rip + _dpew_stage];
        mov [rcx], rax;

        mov r10, 0x0200;
        mov r11, 0;                      // gen = 0, reserved
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 540000;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 260;
        mov rsi, 257;
        mov rdx, 0x419;
        mov rcx, 0xDEADFACF;
        mov r8, 0xC0FFEE01;
        mov r9, r10;
        call display_engine_cap_mint_inner;
        mov r11, 0xFFFFF7CA;             // BAD_GEN
        cmp rax, r11;
        jne dpew_fail_stage;

        // -- 8. Revoke round-trip.
        mov rax, 8;
        lea rcx, [rip + _dpew_stage];
        mov [rcx], rax;

        mov rdi, 259;
        call display_engine_cap_revoke_inner;
        cmp rax, 0;
        jne dpew_fail_stage;

        mov r10, 0x0100;
        mov r11, 2;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 540000;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 259;
        mov rsi, 257;
        mov rdx, 0x419;
        mov rcx, 0xDEADFACE;             // key is free after revoke
        mov r8, 0xC0FFEE01;
        mov r9, r10;
        call display_engine_cap_mint_inner;
        cmp rax, 0;
        jne dpew_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpew_ok];
        call klog_s1;

        call dpew_scrub;
        call dpew_clear;
        xor rax, rax;
        jmp dpew_out;

      dpew_fail_stage:
        lea rax, [rip + _dpew_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpew_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dpew_scrub;
        call dpew_clear;
        mov rax, 1;

      dpew_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
