// tests/kernel/cap/kind_vrr_range_synth.pdx -- G1.M2-002 (#1433)
//
// Boot witness for KIND_VRR_RANGE. Exercises validators, tail
// alloc happy path, row accessors (including max_mhz reassembly
// from the split hi16/lo32 layout), and refusal edges.
//
// Fingerprint: G1 KIND_VRR_RANGE OK

module KindVrrRangeSynth = structure {

  pub let mut _vrrw_stage : u64 = 0

  pub let vrrw_ok   : [u8; 19] = "KIND_VRR_RANGE OK\0"
  pub let vrrw_fail : [u8; 21] = "KIND_VRR_RANGE FAIL\0"

  pub let kind_vrr_range_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G1.M2-002 (#1433): boot witness. Stages: (1) reset. (2) rights validator (R_VRR_ALL ok, R_MINT no). (3) range validator (0/x refused; x/y with x>y refused; > 480000 refused). (4) frametime validator (0 refused; 1 ok). (5) tail_alloc happy for (mode_slot=1, min=40000, max=144000). (6) row accessors: key, mode, min, max, min_frame. (7) find_by_key hits. (8) tail_free. (9) find_by_key returns ROW_NONE after free.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _vrrw_stage];
        mov [rcx], rax;
        call vrr_table_reset;
        call dpy_vrr_reset;

        // 2. rights_valid.
        mov rax, 2;
        lea rcx, [rip + _vrrw_stage];
        mov [rcx], rax;
        mov rdi, 0x419;
        call vrr_rights_valid;
        cmp rax, 1;
        jne vrrw_fail_stage;
        mov rdi, 0x200;
        call vrr_rights_valid;
        cmp rax, 0;
        jne vrrw_fail_stage;

        // 3. range_valid.
        mov rax, 3;
        lea rcx, [rip + _vrrw_stage];
        mov [rcx], rax;
        // 0, 100 -> refused (min zero).
        mov rdi, 0;
        mov rsi, 100;
        call vrr_range_valid;
        cmp rax, 0;
        jne vrrw_fail_stage;
        // 100, 50 -> refused (min > max).
        mov rdi, 100;
        mov rsi, 50;
        call vrr_range_valid;
        cmp rax, 0;
        jne vrrw_fail_stage;
        // 100, 500000 -> refused (> ceiling).
        mov rdi, 100;
        mov rsi, 500000;
        call vrr_range_valid;
        cmp rax, 0;
        jne vrrw_fail_stage;
        // 40000, 144000 -> ok.
        mov rdi, 40000;
        mov rsi, 144000;
        call vrr_range_valid;
        cmp rax, 1;
        jne vrrw_fail_stage;

        // 4. frametime_valid.
        mov rax, 4;
        lea rcx, [rip + _vrrw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vrr_frametime_valid;
        cmp rax, 0;
        jne vrrw_fail_stage;
        mov rdi, 6944444;                 // ~144 Hz min frametime in ns
        call vrr_frametime_valid;
        cmp rax, 1;
        jne vrrw_fail_stage;

        // 5. tail_alloc happy: build body1 + body2, alloc row 0.
        mov rax, 5;
        lea rcx, [rip + _vrrw_stage];
        mov [rcx], rax;
        mov rdi, 1;                      // mode_slot
        mov rsi, 40000;                  // min_mhz
        mov rdx, 144000;                 // max_mhz
        call vrr_body1_pack;
        mov r12, rax;                    // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  vrrw_fail_stage;
        mov rdi, 6944444;                 // min_ft_ns
        mov rsi, 144000;                 // max_mhz
        call vrr_body2_pack;
        mov r13, rax;                    // body2
        cmp r13, r10;
        je  vrrw_fail_stage;
        mov rdi, 0;
        mov rsi, 0x9999;                 // range_key
        mov rdx, r12;
        mov rcx, r13;
        call vrr_tail_alloc;
        cmp rax, 0;
        jne vrrw_fail_stage;

        // 6. row accessors.
        mov rax, 6;
        lea rcx, [rip + _vrrw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vrr_row_key;
        mov r10, 0x9999;
        cmp rax, r10;
        jne vrrw_fail_stage;
        mov rdi, 0;
        call vrr_row_mode;
        cmp rax, 1;
        jne vrrw_fail_stage;
        mov rdi, 0;
        call vrr_row_min_mhz;
        mov r10, 40000;
        cmp rax, r10;
        jne vrrw_fail_stage;
        mov rdi, 0;
        call vrr_row_max_mhz;
        mov r10, 144000;
        cmp rax, r10;
        jne vrrw_fail_stage;
        mov rdi, 0;
        call vrr_row_min_frame;
        mov r10, 6944444;
        cmp rax, r10;
        jne vrrw_fail_stage;

        // 7. find_by_key hits.
        mov rax, 7;
        lea rcx, [rip + _vrrw_stage];
        mov [rcx], rax;
        mov rdi, 0x9999;
        call vrr_find_by_key;
        cmp rax, 0;
        jne vrrw_fail_stage;

        // 8. tail_free.
        mov rax, 8;
        lea rcx, [rip + _vrrw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vrr_tail_free;
        mov rdi, 0;
        call vrr_tail_valid;
        cmp rax, 0;
        jne vrrw_fail_stage;

        // 9. find_by_key none after free.
        mov rax, 9;
        lea rcx, [rip + _vrrw_stage];
        mov [rcx], rax;
        mov rdi, 0x9999;
        call vrr_find_by_key;
        mov r10, 0xFF;
        cmp rax, r10;
        jne vrrw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrrw_ok];
        call klog_s1;

        call vrr_table_reset;
        call dpy_vrr_reset;
        xor rax, rax;
        jmp vrrw_out;

      vrrw_fail_stage:
        lea rax, [rip + _vrrw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrrw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vrr_table_reset;
        call dpy_vrr_reset;
        mov rax, 1;

      vrrw_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
