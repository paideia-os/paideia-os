// tests/kernel/cap/kind_vk_surface_synth.pdx -- G3.M1-001 (#1457)
//
// Boot witness for KIND_VK_SURFACE. Exercises table reset,
// validators, tail_alloc happy path, row accessors, unique-key
// find, and tail_free.
//
// Fingerprint: G3 KIND_VK_SURFACE OK

module KindVkSurfaceSynth = structure {

  pub let mut _vksw_stage : u64 = 0

  pub let vksw_ok   : [u8; 23] = "G3 KIND_VK_SURFACE OK\n\0"
  pub let vksw_fail : [u8; 25] = "G3 KIND_VK_SURFACE FAIL\n\0"

  pub let kind_vk_surface_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G3.M1-001 (#1457): boot witness. Stages: (1) reset. (2) rights_valid. (3) fmt_valid. (4) extent_valid. (5) scale_valid. (6) tail_alloc happy. (7) row accessors. (8) find_by_key. (9) tail_free. (10) find_by_key ROW_NONE.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _vksw_stage];
        mov [rcx], rax;
        call vks_table_reset;

        // 2. rights_valid: R_VKS_ALL (0x619) ok; 0x1000 no (out of mask).
        mov rax, 2;
        lea rcx, [rip + _vksw_stage];
        mov [rcx], rax;
        mov rdi, 0x619;
        call vks_rights_valid;
        cmp rax, 1;
        jne vksw_fail_stage;
        mov rdi, 0x1000;
        call vks_rights_valid;
        cmp rax, 0;
        jne vksw_fail_stage;

        // 3. fmt_valid: 1 ok, 4 ok, 0 no, 5 no.
        mov rax, 3;
        lea rcx, [rip + _vksw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call vks_fmt_valid;
        cmp rax, 1;
        jne vksw_fail_stage;
        mov rdi, 4;
        call vks_fmt_valid;
        cmp rax, 1;
        jne vksw_fail_stage;
        mov rdi, 0;
        call vks_fmt_valid;
        cmp rax, 0;
        jne vksw_fail_stage;
        mov rdi, 5;
        call vks_fmt_valid;
        cmp rax, 0;
        jne vksw_fail_stage;

        // 4. extent_valid: (1920, 1080) ok; (0, 1) no; (16385, 1) no.
        mov rax, 4;
        lea rcx, [rip + _vksw_stage];
        mov [rcx], rax;
        mov rdi, 1920;
        mov rsi, 1080;
        call vks_extent_valid;
        cmp rax, 1;
        jne vksw_fail_stage;
        mov rdi, 0;
        mov rsi, 1;
        call vks_extent_valid;
        cmp rax, 0;
        jne vksw_fail_stage;
        mov rdi, 16385;
        mov rsi, 1;
        call vks_extent_valid;
        cmp rax, 0;
        jne vksw_fail_stage;

        // 5. scale_valid: (3, 2) ok; (0, 1) no; (1, 0) no; (65536, 1) no.
        mov rax, 5;
        lea rcx, [rip + _vksw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 2;
        call vks_scale_valid;
        cmp rax, 1;
        jne vksw_fail_stage;
        mov rdi, 0;
        mov rsi, 1;
        call vks_scale_valid;
        cmp rax, 0;
        jne vksw_fail_stage;
        mov rdi, 65536;
        mov rsi, 1;
        call vks_scale_valid;
        cmp rax, 0;
        jne vksw_fail_stage;

        // 6. tail_alloc happy: body1 pack(eid=1, out=2, fmt=1, w=1920),
        //    body2 pack(h=1080, sn=1, sd=1, flags=0).
        mov rax, 6;
        lea rcx, [rip + _vksw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 2;
        mov rdx, 1;
        mov rcx, 1920;
        call vks_body1_pack;
        mov r12, rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  vksw_fail_stage;
        mov rdi, 1080;
        mov rsi, 1;
        mov rdx, 1;
        mov rcx, 0;
        call vks_body2_pack;
        mov r13, rax;
        cmp r13, r10;
        je  vksw_fail_stage;
        mov rdi, 0;
        mov rsi, 0xABCD;
        mov rdx, r12;
        mov rcx, r13;
        call vks_tail_alloc;
        cmp rax, 0;
        jne vksw_fail_stage;

        // 7. row accessors.
        mov rax, 7;
        lea rcx, [rip + _vksw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vks_row_key;
        mov r10, 0xABCD;
        cmp rax, r10;
        jne vksw_fail_stage;
        mov rdi, 0;
        call vks_row_output;
        cmp rax, 2;
        jne vksw_fail_stage;
        mov rdi, 0;
        call vks_row_fmt;
        cmp rax, 1;
        jne vksw_fail_stage;
        mov rdi, 0;
        call vks_row_extent_w;
        mov r10, 1920;
        cmp rax, r10;
        jne vksw_fail_stage;
        mov rdi, 0;
        call vks_row_extent_h;
        mov r10, 1080;
        cmp rax, r10;
        jne vksw_fail_stage;
        mov rdi, 0;
        call vks_row_scale_num;
        cmp rax, 1;
        jne vksw_fail_stage;
        mov rdi, 0;
        call vks_row_scale_den;
        cmp rax, 1;
        jne vksw_fail_stage;

        // 8. find_by_key.
        mov rax, 8;
        lea rcx, [rip + _vksw_stage];
        mov [rcx], rax;
        mov rdi, 0xABCD;
        call vks_find_by_key;
        cmp rax, 0;
        jne vksw_fail_stage;
        mov rdi, 0xDEAD;
        call vks_find_by_key;
        mov r10, 0xFF;
        cmp rax, r10;
        jne vksw_fail_stage;

        // 9. tail_free.
        mov rax, 9;
        lea rcx, [rip + _vksw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vks_tail_free;
        mov rdi, 0;
        call vks_tail_valid;
        cmp rax, 0;
        jne vksw_fail_stage;

        // 10. find_by_key ROW_NONE after free.
        mov rax, 10;
        lea rcx, [rip + _vksw_stage];
        mov [rcx], rax;
        mov rdi, 0xABCD;
        call vks_find_by_key;
        mov r10, 0xFF;
        cmp rax, r10;
        jne vksw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vksw_ok];
        call klog_s1;

        call vks_table_reset;
        xor rax, rax;
        jmp vksw_out;

      vksw_fail_stage:
        lea rax, [rip + _vksw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vksw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vks_table_reset;
        mov rax, 1;

      vksw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
