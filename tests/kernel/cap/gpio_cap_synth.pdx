// tests/kernel/cap/gpio_cap_synth.pdx — R30.M6-001 (#1075)
//
// Boot witness for KIND_GPIO_LINE (0x154).
//
// -----------------------------------------------------------------------------
// What this fixture is for
// -----------------------------------------------------------------------------
//
// A pad controller owns every pin on the package, and a pin has no
// acknowledgement, no arbitration and no error path. Acting on the wrong
// one is not a data-corruption bug — it is a device held in reset, a rail
// dropped, or a write-protect strap defeated, with the first symptom
// appearing in whatever hardware the pin controls rather than in the
// driver that got it wrong.
//
// The claim this milestone makes is that a capability naming pin P
// cannot reach pin Q, and that the claim is STRUCTURAL — not a check
// that could be forgotten, but a shape in which the wrong request cannot
// be phrased. There are two halves and this fixture tests both:
//
//   * THE CONFINEMENT. Sub-test J calls all five resolvers, and the
//     dispatch handler, with a NEIGHBOURING PIN's number, community and
//     pad index loaded into every register and every spare bit an added
//     parameter could plausibly arrive in, and asserts every answer is
//     still the capability's own. That is the runtime half of the mutant
//     argument; the compile-time half is the `gpio-pin-confine` step in
//     tools/build.sh, which pins the literal arity of all five so a
//     mutant that adds a pin parameter fails the build.
//
//   * THE MAPPING. Pin numbering is not pad indexing: the community-
//     relative pad index is `pin - community.pin_base`, which is the
//     IDENTITY for community 0 and the identity nowhere else. An
//     implementation that forgets the subtraction is correct on every
//     pin of community 0 and silently wrong on every pin of every other
//     community. Sub-test F therefore asserts the mapping OUTSIDE
//     community 0, against an INDEPENDENTLY COMPUTED register offset,
//     and reads the register back through the seam so that "we computed
//     the right number" and "we touched the right register" are both
//     checked — and it asserts explicitly against the two wrong answers
//     the two plausible bugs would produce.
//
// Everything here drives the SHIPPING functions, linked into the real
// kernel. The controller it builds comes from `lpss_gpio_record`, the
// same allocator the real probe uses, and its communities are described
// through the same validating API; the register seam is on its synthetic
// side and the capability checks in it are NOT bypassed.
//
// -----------------------------------------------------------------------------
// Sub-tests
// -----------------------------------------------------------------------------
//
//   A  Reset both tables and the seam; pre-clean cap slots 64..79.
//   B  Seed the base authorities, including two that must be REFUSED:
//      a wrong-kind parent, and a KIND_DEVICE for something that is not
//      a pad controller at all.
//   C  Build two controllers through the shipping path — probe row,
//      window capability, identification, community description. The
//      second controller's community 0 covers the SAME pin range as the
//      first's, which is the ordinary two-controller board and which a
//      globally-scoped overlap check would have refused.
//   D  THE DERIVATION GATE, refused six ways. The sixth is the one the
//      kind check cannot express: a KIND_DEVICE capability carrying
//      RIGHT_MINT for a device that is not a probed pad controller.
//   E  PIN VALIDITY, refused per reason with distinct codes and never
//      clamped: out of the representable range, and outside every
//      community of this controller.
//   F  THE HAPPY PATH AND THE COMMUNITY MAPPING. Two pins with the SAME
//      pad index in DIFFERENT communities, asserted through the
//      capability against independently computed register offsets, read
//      back through the seam, and asserted against the two wrong
//      answers an identity mapping and a community-0-only mapping would
//      give.
//   G  Boundary pins: the last pad of community 0 and the first of
//      community 1.
//   H  DUPLICATE PIN REFUSED, with nothing written and no row consumed.
//   I  THE SAME PIN ON A DIFFERENT CONTROLLER IS PERMITTED — the
//      assertion a global pin table would fail.
//   J  PIN CONFINEMENT AND THE MUTANT. See above.
//   K  Handler ops and rights, including the absence of any get, set or
//      configure op.
//   L  CONTROLLER RELEASE CASCADES, in both phases: four lines with
//      descriptors, one GHOST ROW whose descriptor was cleared by
//      another path, and one line on the OTHER controller that must
//      survive.
//   M  NO ROW LEAK — the freed pin is re-mintable, which is only true
//      if the cascade SCRUBBED the row rather than merely unlinking it.
//   N  Revoke edges: idempotent on an empty slot, and a line revoke will
//      not touch a device descriptor.
//   O  Clean up.
//
// Slots 64..79 are outside the set every other witness consumes (0..8,
// 10..12, 14..19, 28..33, 34..45, 46..55, 56..63), and both exits clear
// them after revoking the windows they may hold.
//
// On any failure the stage number in _gpl_w_stage identifies the
// assertion.

module GpioCapSynth = structure {

  pub let mut _gpl_w_stage : u64 = 0

  // ==========================================================================
  // gpl_w_seed(slot, kind, rights, target) -> ()
  // ==========================================================================

  pub let gpl_w_seed : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): write a capability descriptor directly into cap_table[slot] (stride 24: kind at +0, rights at +8, target_ptr at +16). The fixture needs BASE authorities no mint path in this kernel produces yet -- a KIND_MEMORY (4) with RIGHT_MINT for the window root, and KIND_DEVICE (10) descriptors carrying bdf keys, which is what the line mint INHERITS its controller identity from. Seeding them directly is what makes the derivation gate testable in BOTH directions rather than only in the refusing one. It is also how sub-test L manufactures a GHOST ROW: writing a zero descriptor over a live line capability's slot leaves its row allocated with nothing pointing at it, which is precisely the state phase 2 of the cascade exists to clean up and which no ordinary API call can produce. Leaf. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov [rax + 0],  rsi;
        mov [rax + 8],  rdx;
        mov [rax + 16], rcx;
        ret
      }
    }

  pub let gpl_w_kind : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): read cap_table[slot].kind. Every 'nothing was written' and 'the descriptor was cleared' assertion in this fixture goes through this one accessor, so a refusal that silently wrote a descriptor cannot pass by being asserted with a differently-shaped read somewhere else. Leaf, pure read. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 0];
        ret
      }
    }

  pub let gpl_w_row_of : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): the row id in cap_table[slot].target_ptr[15:0]. Needed because cap_handler_gpio_line is called with a target_ptr rather than a slot -- that is the dispatcher's calling convention, since only the kernel writes descriptors -- so a fixture that drives the handler directly has to read the same field the dispatcher would. Reading it here rather than exporting a resolver from the kind is deliberate: an exported slot-to-row function would be a fifth capability-form resolver to pin, and it would hand out a table index, which is a strictly more useful thing for a caller to have than any of the four facts the real resolvers return. Leaf, pure read. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 16];
        mov r10, 0xFFFF;
        and rax, r10;
        ret
      }
    }

  pub let gpl_w_clear_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): zero cap_table slots 64..79 (offset 64*24 = 1536, sixteen slots of 24 bytes = 48 qwords). Called at entry and at BOTH exits so this fixture leaves the capability table exactly as it found it, and so a failing run cannot poison a later witness with a half-built controller or a live line capability. The set is disjoint from every other witness's. Leaf. Labels prefixed gpl_wc_.",
      block: {
        mov rax, cap_table;
        add rax, 1536;
        xor rcx, rcx;
        xor r8, r8;
      gpl_wc_next:
        mov [rax + rcx * 8], r8;
        add rcx, 1;
        cmp rcx, 48;
        jb  gpl_wc_next;
        ret
      }
    } @no_frame

  // ==========================================================================
  // gpl_w_teardown() -> ()
  // ==========================================================================

  pub let gpl_w_teardown : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): the shared exit. Revoke slots 70 and 71 as op-regions FIRST -- opregion_cap_revoke is idempotent on an empty slot and refuses a wrong kind, so calling it unconditionally is safe whether or not the run got far enough to mint them, and whether or not lpss_gpio_release already took them -- and only then clear the descriptors. Order matters: clearing a descriptor without revoking would strand its _op_region_table row, and rows are scarcer than slots (OPREG_MAX = 32 across the whole boot). Then clear the slots, reset the line table and the controller table, and close the seam. Called from BOTH exits, which is why it is a function: a fixture whose teardown is inline in the success path leaves the failure path to remember it. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed gpl_wt_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, 70;
      gpl_wt_next:
        cmp r12, 72;
        jae gpl_wt_done;
        mov rdi, r12;
        call opregion_cap_revoke;
        add r12, 1;
        jmp gpl_wt_next;

      gpl_wt_done:
        call gpl_w_clear_slots;
        call gpio_line_table_reset;
        call lpss_gpio_table_reset;
        call gpio_io_unbind;
        call gpio_io_synth_disable;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_cap_witness() -> u64
  // ==========================================================================

  pub let gpio_cap_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-001 (#1075): boot witness for the KIND_GPIO_LINE derivation gate, controller-identity inheritance, the per-reason pin refusals, the DERIVED community mapping including the case outside community 0 where it is not the identity, the duplicate-pin refusal, same-pin-different-controller coexistence, PIN CONFINEMENT INCLUDING A RUNTIME MUTANT, the two-phase controller cascade and the absence of row leaks across a mint/revoke cycle. Drives the shipping functions linked into the real kernel and builds its controller through the same allocator and the same validating community API the real probe uses, so the fixture tests the shape the machine actually has rather than one it never will. Five pushes (rbx, r12, r13, r14, r15) leave rsp%16 == 0 at every nested call; cross-call state that is not in those registers lives in module .bss for the same reason the stage counter does. Both exits call gpl_w_teardown. Labels prefixed gpl_w_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // A. Reset.
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        call gpio_line_table_reset;
        call lpss_gpio_table_reset;
        call gpl_w_clear_slots;
        call gpio_io_unbind;
        call gpio_io_synth_enable;

        call gpio_line_rows_live;
        cmp rax, 0;
        jne gpl_w_fail;
        call lpss_gpio_ctrl_count;
        cmp rax, 0;
        jne gpl_w_fail;

        // ================================================================
        // B. Base authorities.
        //
        //   64  KIND_MEMORY, MINT              — the window root
        //   65  KIND_DEVICE, MINT, bdf 0x1F00  — pad controller A
        //   66  KIND_DEVICE, MINT, bdf 0x1F10  — pad controller B
        //   67  KIND_PAGE (4), MINT            — the wrong kind entirely
        //   68  KIND_DEVICE, INVOKE only       — right kind, no MINT
        //   69  KIND_DEVICE, MINT, bdf 0x2A00  — a device that is NOT a
        //                                        pad controller
        // ================================================================
        mov rax, 2;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        mov rdi, 64;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, 0x200;                  // RIGHT_MINT
        xor rcx, rcx;
        call gpl_w_seed;

        mov rdi, 65;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x200;
        mov rcx, 0x1F00;
        call gpl_w_seed;

        mov rdi, 66;
        mov rsi, 10;
        mov rdx, 0x200;
        mov rcx, 0x1F10;                 // a DIFFERENT controller
        call gpl_w_seed;

        mov rdi, 67;
        mov rsi, 4;                      // KIND_PAGE
        mov rdx, 0x200;
        mov rcx, 0x1F00;
        call gpl_w_seed;

        mov rdi, 68;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x008;                  // INVOKE only — no MINT
        mov rcx, 0x1F00;
        call gpl_w_seed;

        mov rdi, 69;
        mov rsi, 10;
        mov rdx, 0x200;
        mov rcx, 0x2A00;                 // not a pad controller
        call gpl_w_seed;

        // ================================================================
        // C. Build two pad controllers through the shipping path.
        // ================================================================
        mov rax, 3;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        mov rdi, 0x1F00;
        mov rsi, 1;
        mov rdx, 0xFD6E0000;
        mov rcx, 0x2000;
        call lpss_gpio_record;
        cmp rax, 0;
        jne gpl_w_fail;

        mov rdi, 0x1F10;
        mov rsi, 1;
        mov rdx, 0xFD6D0000;
        mov rcx, 0x2000;
        call lpss_gpio_record;
        cmp rax, 1;
        jne gpl_w_fail;

        xor rdi, rdi;
        mov rsi, 64;
        mov rdx, 70;
        mov rcx, 0x61B;                  // R_OPREG_ALL
        call lpss_gpio_bind_window;
        cmp rax, 0;
        jne gpl_w_fail;

        mov rdi, 1;
        mov rsi, 64;
        mov rdx, 71;
        mov rcx, 0x61B;
        call lpss_gpio_bind_window;
        cmp rax, 0;
        jne gpl_w_fail;

        mov rdi, 70;
        call gpio_io_bind;
        cmp rax, 0;
        jne gpl_w_fail;

        // Community 0's header: revision 0x94 -> four PADCFG registers
        // per pad -> stride 16; PADCFG region at 0x600 inside the
        // community window.
        xor rdi, rdi;
        mov rsi, 0x00940000;
        call gpio_io_synth_poke;
        mov rdi, 0x0C;
        mov rsi, 0x600;
        call gpio_io_synth_poke;

        xor rdi, rdi;
        call lpss_gpio_identify;
        cmp rax, 0;
        jne gpl_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_stride;
        cmp rax, 16;
        jne gpl_w_fail;

        // Community 1's header lives in a DIFFERENT window with a
        // DIFFERENT PADCFG offset. Both differences are load-bearing:
        // they are what make the mapping assertions in sub-test F able
        // to fail.
        mov rdi, 0x1000;
        mov rsi, 0x00940000;
        call gpio_io_synth_poke;
        mov rdi, 0x100C;
        mov rsi, 0x700;
        call gpio_io_synth_poke;

        xor rdi, rdi;
        xor rsi, rsi;
        xor rdx, rdx;
        mov rcx, 24;                     // community 0: pins 0..23
        call lpss_gpio_add_community;
        cmp rax, 0;
        jne gpl_w_fail;

        xor rdi, rdi;
        mov rsi, 0x1000;
        mov rdx, 24;
        mov rcx, 24;                     // community 1: pins 24..47
        call lpss_gpio_add_community;
        cmp rax, 1;
        jne gpl_w_fail;

        // Controller B, identified through its own window, with ONE
        // community covering THE SAME PIN RANGE as controller A's
        // community 0. That is the ordinary two-controller board, and a
        // globally-scoped overlap check would have refused it.
        mov rdi, 71;
        call gpio_io_bind;
        cmp rax, 0;
        jne gpl_w_fail;
        mov rdi, 1;
        call lpss_gpio_identify;
        cmp rax, 0;
        jne gpl_w_fail;
        mov rdi, 1;
        xor rsi, rsi;
        xor rdx, rdx;
        mov rcx, 24;
        call lpss_gpio_add_community;
        cmp rax, 0;
        jne gpl_w_fail;

        // Back to controller A's window for the register read-backs.
        mov rdi, 70;
        call gpio_io_bind;
        cmp rax, 0;
        jne gpl_w_fail;

        // ================================================================
        // D. THE DERIVATION GATE — refused six ways.
        // ================================================================
        mov rax, 4;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        // (1) parent is the wrong kind.
        mov rdi, 72;
        mov rsi, 67;
        mov rdx, 0x41F;
        mov rcx, 5;
        mov r8, 0xD1;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF1D;             // GPIO_LINE_MINT_BAD_PARENT
        cmp rax, r15;
        jne gpl_w_fail;

        // (2) parent is the right kind but carries no RIGHT_MINT.
        mov rdi, 72;
        mov rsi, 68;
        mov rdx, 0x41F;
        mov rcx, 5;
        mov r8, 0xD1;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF1D;
        cmp rax, r15;
        jne gpl_w_fail;

        // (3) rights outside R_GPIO_LINE_ALL. RIGHT_MINT (0x200) is not
        //     on this kind at all -- it is the bottom of the lattice.
        mov rdi, 72;
        mov rsi, 65;
        mov rdx, 0x200;
        mov rcx, 5;
        mov r8, 0xD1;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF1C;             // GPIO_LINE_MINT_BAD_RIGHTS
        cmp rax, r15;
        jne gpl_w_fail;

        // (4) a zero driver hint -- the "unclaimed" sentinel.
        mov rdi, 72;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 5;
        xor r8, r8;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF15;             // GPIO_LINE_MINT_BAD_HINT
        cmp rax, r15;
        jne gpl_w_fail;

        // (5) an out-of-range destination slot.
        mov rdi, 256;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 5;
        mov r8, 0xD1;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF1B;             // GPIO_LINE_MINT_BAD_ARG
        cmp rax, r15;
        jne gpl_w_fail;

        // (6) THE HALF THE KIND CHECK CANNOT EXPRESS. Slot 69 is a
        //     genuine KIND_DEVICE carrying RIGHT_MINT -- every PCI
        //     function in the machine is one -- but the identity it
        //     carries names no probed pad controller. Without this
        //     check, any device-capability holder could mint pins.
        mov rdi, 72;
        mov rsi, 69;
        mov rdx, 0x41F;
        mov rcx, 5;
        mov r8, 0xD1;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF16;             // GPIO_LINE_MINT_NO_CONTROLLER
        cmp rax, r15;
        jne gpl_w_fail;

        // Nothing was written and no row was consumed.
        mov rdi, 72;
        call gpl_w_kind;
        cmp rax, 0;
        jne gpl_w_fail;
        call gpio_line_rows_live;
        cmp rax, 0;
        jne gpl_w_fail;

        // ================================================================
        // E. PIN VALIDITY — refused per reason, never clamped.
        // ================================================================
        mov rax, 5;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        // Outside the representable pin space.
        mov rdi, 72;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 512;                    // GPIO_PIN_MAX
        mov r8, 0xD1;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF19;             // GPIO_LINE_MINT_PIN_RANGE
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 72;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 0xFFFF;
        mov r8, 0xD1;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF19;
        cmp rax, r15;
        jne gpl_w_fail;

        // Representable, but this controller routes no such pin. A
        // DIFFERENT code, because "cannot be represented" and "this part
        // does not have it" are different operator problems -- and
        // neither is clamped to the nearest legal pad, which on this
        // part would hand back a real pin nobody asked for.
        mov rdi, 72;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 48;                     // past both communities
        mov r8, 0xD1;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF18;             // GPIO_LINE_MINT_PIN_UNMAPPED
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 72;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 100;
        mov r8, 0xD1;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF18;
        cmp rax, r15;
        jne gpl_w_fail;

        // Controller B has only community 0, so pin 30 is unmapped
        // THERE while being perfectly valid on controller A.
        mov rdi, 72;
        mov rsi, 66;
        mov rdx, 0x41F;
        mov rcx, 30;
        mov r8, 0xD1;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF18;
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 72;
        call gpl_w_kind;
        cmp rax, 0;
        jne gpl_w_fail;
        call gpio_line_rows_live;
        cmp rax, 0;
        jne gpl_w_fail;

        // ================================================================
        // F. THE HAPPY PATH AND THE COMMUNITY MAPPING.
        //
        // Two pins with the SAME community-relative pad index in
        // DIFFERENT communities. Their register offsets differ by more
        // than a page, and the two plausible bugs -- an identity mapping
        // and a community-0-only mapping -- each produce a specific
        // wrong answer that is asserted against by name.
        // ================================================================
        mov rax, 6;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        // -- pin 5: community 0, pad 5. The mapping is the identity
        //    here, which is exactly why this case proves nothing on its
        //    own.
        mov rdi, 72;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 5;
        mov r8, 0xD1;
        call gpio_line_cap_mint;
        cmp rax, 0;
        jne gpl_w_fail;

        mov rdi, 72;
        call gpl_w_kind;
        mov r15, 0x154;                  // KIND_GPIO_LINE
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 72;
        call gpio_line_pin_of_slot;
        cmp rax, 5;
        jne gpl_w_fail;
        mov rdi, 72;
        call gpio_line_community_of_slot;
        cmp rax, 0;
        jne gpl_w_fail;
        mov rdi, 72;
        call gpio_line_pad_of_slot;
        cmp rax, 5;
        jne gpl_w_fail;
        mov rdi, 72;
        call gpio_line_ctrl_of_slot;
        mov r15, 0x1F00;
        cmp rax, r15;
        jne gpl_w_fail;

        // community 0 reg_off 0x0000 + padbar 0x600 + 5 * 16 = 0x650.
        mov rdi, 72;
        call gpio_line_pad_off_of_slot;
        mov r15, 0x650;
        cmp rax, r15;
        jne gpl_w_fail;
        mov r12, rax;                    // keep community 0's offset

        // -- pin 29: community 1, pad 5. OUTSIDE COMMUNITY 0.
        mov rdi, 73;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 29;
        mov r8, 0xD2;
        call gpio_line_cap_mint;
        cmp rax, 0;
        jne gpl_w_fail;

        mov rdi, 73;
        call gpio_line_pin_of_slot;
        cmp rax, 29;
        jne gpl_w_fail;
        mov rdi, 73;
        call gpio_line_community_of_slot;
        cmp rax, 1;                      // NOT community 0
        jne gpl_w_fail;
        mov rdi, 73;
        call gpio_line_pad_of_slot;
        cmp rax, 5;                      // NOT 29 -- pin - pin_base
        jne gpl_w_fail;

        // community 1 reg_off 0x1000 + padbar 0x700 + 5 * 16 = 0x1750.
        mov rdi, 73;
        call gpio_line_pad_off_of_slot;
        mov r15, 0x1750;
        cmp rax, r15;
        jne gpl_w_fail;
        mov r13, rax;

        // THE TWO WRONG ANSWERS, asserted against by name.
        //
        //   0x18D0 = 0x1000 + 0x700 + 29 * 16 — what an implementation
        //            that never subtracted pin_base would compute. It is
        //            a valid, in-window offset belonging to community
        //            1's pad 29, which does not exist; on a part with a
        //            larger community it would be a real, drivable,
        //            unrelated pin.
        //   0x650  = 0x0000 + 0x600 + 5 * 16 — what an implementation
        //            that always used community 0 would compute. It is
        //            community 0's pad 5, i.e. pin 5, which is a REAL
        //            PIN ALREADY OWNED BY ANOTHER CAPABILITY.
        mov r15, 0x18D0;
        cmp r13, r15;
        je gpl_w_fail;
        cmp r13, r12;
        je gpl_w_fail;

        // AND THE OFFSETS REALLY REACH DIFFERENT REGISTERS. Seed two
        // distinct values through the untraced back door and read them
        // back through the seam, so "we computed the right number" and
        // "we touched the right register" are both checked.
        mov rdi, r12;
        mov rsi, 0xC0DE1234;
        call gpio_io_synth_poke;
        mov rdi, r13;
        mov rsi, 0xBEEF5678;
        call gpio_io_synth_poke;

        mov rdi, 72;
        call gpio_line_pad_off_of_slot;
        mov rdi, rax;
        call gpio_io_read32;
        mov r15, 0xC0DE1234;
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 73;
        call gpio_line_pad_off_of_slot;
        mov rdi, rax;
        call gpio_io_read32;
        mov r15, 0xBEEF5678;
        cmp rax, r15;
        jne gpl_w_fail;

        // SAME PAD INDEX, DIFFERENT COMMUNITIES, BOTH LIVE.
        mov rdi, 72;
        call gpio_line_pad_of_slot;
        mov r14, rax;
        mov rdi, 73;
        call gpio_line_pad_of_slot;
        cmp rax, r14;
        jne gpl_w_fail;                  // both are pad 5
        mov rdi, 72;
        call gpio_line_community_of_slot;
        mov r14, rax;
        mov rdi, 73;
        call gpio_line_community_of_slot;
        cmp rax, r14;
        je gpl_w_fail;                   // in different communities

        call gpio_line_rows_live;
        cmp rax, 2;
        jne gpl_w_fail;

        // ================================================================
        // G. Boundary pins.
        // ================================================================
        mov rax, 7;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        // Pin 24 is community 1's pad 0, NOT community 0's pad 24.
        mov rdi, 74;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 24;
        mov r8, 0xD3;
        call gpio_line_cap_mint;
        cmp rax, 0;
        jne gpl_w_fail;
        mov rdi, 74;
        call gpio_line_community_of_slot;
        cmp rax, 1;
        jne gpl_w_fail;
        mov rdi, 74;
        call gpio_line_pad_of_slot;
        cmp rax, 0;
        jne gpl_w_fail;
        mov rdi, 74;
        call gpio_line_pad_off_of_slot;
        mov r15, 0x1700;                 // 0x1000 + 0x700 + 0
        cmp rax, r15;
        jne gpl_w_fail;

        // Pin 23 is community 0's last pad.
        mov rdi, 75;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 23;
        mov r8, 0xD4;
        call gpio_line_cap_mint;
        cmp rax, 0;
        jne gpl_w_fail;
        mov rdi, 75;
        call gpio_line_community_of_slot;
        cmp rax, 0;
        jne gpl_w_fail;
        mov rdi, 75;
        call gpio_line_pad_of_slot;
        cmp rax, 23;
        jne gpl_w_fail;
        mov rdi, 75;
        call gpio_line_pad_off_of_slot;
        mov r15, 0x770;                  // 0x600 + 23 * 16
        cmp rax, r15;
        jne gpl_w_fail;

        // ================================================================
        // H. DUPLICATE PIN REFUSED.
        //
        // A pin has ONE state. Two owners of it cannot detect each
        // other, there is no protocol on a pin to arbitrate them, and
        // the loser's failure surfaces in whatever hardware the pin
        // controls rather than in the loser's driver.
        // ================================================================
        mov rax, 8;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        mov rdi, 76;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 5;
        mov r8, 0xD5;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF17;             // GPIO_LINE_MINT_PIN_IN_USE
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 76;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 29;
        mov r8, 0xD5;
        call gpio_line_cap_mint;
        mov r15, 0xFFFFFF17;
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 76;
        call gpl_w_kind;
        cmp rax, 0;
        jne gpl_w_fail;
        call gpio_line_rows_live;
        cmp rax, 4;
        jne gpl_w_fail;

        // ================================================================
        // I. THE SAME PIN ON A DIFFERENT CONTROLLER IS PERMITTED.
        //
        // The assertion a global pin table would fail -- and failing it
        // would not be a conservative refusal, it would make an ordinary
        // two-controller board unbootable.
        // ================================================================
        mov rax, 9;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        mov rdi, 76;
        mov rsi, 66;                     // controller B
        mov rdx, 0x41F;
        mov rcx, 5;                      // the SAME pin number
        mov r8, 0xD5;
        call gpio_line_cap_mint;
        cmp rax, 0;
        jne gpl_w_fail;

        mov rdi, 76;
        call gpio_line_ctrl_of_slot;
        mov r15, 0x1F10;
        cmp rax, r15;
        jne gpl_w_fail;
        mov rdi, 76;
        call gpio_line_pin_of_slot;
        cmp rax, 5;
        jne gpl_w_fail;

        call gpio_line_rows_live;
        cmp rax, 5;
        jne gpl_w_fail;

        // ================================================================
        // J. PIN CONFINEMENT AND THE MUTANT.
        //
        // Every resolver is called with a NEIGHBOURING PIN's number, its
        // community, its pad index, its register offset and the OTHER
        // controller's identity loaded into every register an added
        // parameter could plausibly arrive in. The neighbour is pin 30:
        // community 1, pad 6, offset 0x1760 -- one pad away from slot
        // 73's, which is the distance a real mistake travels.
        //
        // The answers must not move. They cannot: there is nowhere to
        // put the extra value. tools/build.sh asserts the same property
        // at build time by pinning the literal arity of all five.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        mov rdi, 73;
        mov rsi, 30;
        mov rdx, 1;
        mov rcx, 6;
        mov r8, 0x1760;
        mov r9, 0x1F10;
        call gpio_line_pin_of_slot;
        cmp rax, 29;
        jne gpl_w_fail;

        mov rdi, 73;
        mov rsi, 30;
        mov rdx, 1;
        mov rcx, 6;
        mov r8, 0x1760;
        mov r9, 0x1F10;
        call gpio_line_community_of_slot;
        cmp rax, 1;
        jne gpl_w_fail;

        mov rdi, 73;
        mov rsi, 6;
        mov rdx, 6;
        mov rcx, 6;
        mov r8, 6;
        mov r9, 6;
        call gpio_line_pad_of_slot;
        cmp rax, 5;
        jne gpl_w_fail;

        mov rdi, 73;
        mov rsi, 0x1F10;
        mov rdx, 0x1F10;
        mov rcx, 0x1F10;
        mov r8, 0x1F10;
        mov r9, 0x1F10;
        call gpio_line_ctrl_of_slot;
        mov r15, 0x1F00;
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 73;
        mov rsi, 0x1760;
        mov rdx, 0x1760;
        mov rcx, 0x1760;
        mov r8, 0x1760;
        mov r9, 0x1760;
        call gpio_line_pad_off_of_slot;
        mov r15, 0x1750;
        cmp rax, r15;
        jne gpl_w_fail;

        // The dispatch handler's op_arg is masked to its low byte, so
        // the fifty-six bits above it are not a channel either. Pack the
        // neighbouring pin into them.
        mov rdi, 73;
        call gpl_w_row_of;
        mov r14, rax;                    // row id of the pin-29 capability

        mov rdi, 0x41F;
        mov rsi, r14;
        mov rdx, 0x1E00;                 // op 0, with pin 30 smuggled above
        call cap_handler_gpio_line;
        cmp rax, 29;
        jne gpl_w_fail;

        mov rdi, 0x41F;
        mov rsi, r14;
        mov rdx, 0xFFFFFFFFFFFFFF00;     // op 0, every high bit set
        call cap_handler_gpio_line;
        cmp rax, 29;
        jne gpl_w_fail;

        // ================================================================
        // K. Handler ops and rights.
        // ================================================================
        mov rax, 11;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        mov rdi, 0x41F;
        mov rsi, r14;
        mov rdx, 1;                      // QUERY_COMM
        call cap_handler_gpio_line;
        cmp rax, 1;
        jne gpl_w_fail;

        mov rdi, 0x41F;
        mov rsi, r14;
        mov rdx, 2;                      // QUERY_PAD
        call cap_handler_gpio_line;
        cmp rax, 5;
        jne gpl_w_fail;

        mov rdi, 0x41F;
        mov rsi, r14;
        mov rdx, 3;                      // QUERY_CTRL -> parent cap slot
        call cap_handler_gpio_line;
        cmp rax, 65;
        jne gpl_w_fail;

        mov rdi, 0x41F;
        mov rsi, r14;
        mov rdx, 4;                      // QUERY_HINT
        call cap_handler_gpio_line;
        mov r15, 0xD2;
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 0x400;                  // OBSERVE only
        mov rsi, r14;
        mov rdx, 5;                      // DEBUG_PRINT
        call cap_handler_gpio_line;
        cmp rax, 0;
        jne gpl_w_fail;

        // Rights are enforced per op: OBSERVE alone cannot query.
        mov rdi, 0x400;
        mov rsi, r14;
        xor rdx, rdx;
        call cap_handler_gpio_line;
        mov r15, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r15;
        jne gpl_w_fail;

        // ... and INVOKE alone cannot print.
        mov rdi, 0x008;
        mov rsi, r14;
        mov rdx, 5;
        call cap_handler_gpio_line;
        mov r15, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r15;
        jne gpl_w_fail;

        // THERE IS NO GET, SET OR CONFIGURE OP. Ops 6 and 7 are where
        // #1077 and #1078 will put them; today they are unsupported,
        // and a holder of every right in R_GPIO_LINE_ALL still cannot
        // reach a pad register through this capability.
        mov rdi, 0x41F;
        mov rsi, r14;
        mov rdx, 6;
        call cap_handler_gpio_line;
        mov r15, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 0x41F;
        mov rsi, r14;
        mov rdx, 7;
        call cap_handler_gpio_line;
        mov r15, 0xFFFFFFFFFFFFFFFC;
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 0x41F;
        mov rsi, r14;
        mov rdx, 200;
        call cap_handler_gpio_line;
        mov r15, 0xFFFFFFFFFFFFFFFC;
        cmp rax, r15;
        jne gpl_w_fail;

        // ================================================================
        // L. CONTROLLER RELEASE CASCADES — both phases.
        //
        // Slot 77 is minted and then has its DESCRIPTOR CLEARED by hand,
        // leaving a live row nothing points at. That is the state phase
        // 1 cannot see and phase 2 exists for, and no ordinary API call
        // can produce it. Without phase 2 that row would keep holding
        // pin 30 on a controller that no longer exists, and the next
        // legitimate mint of pin 30 would be refused by a ghost.
        // ================================================================
        mov rax, 12;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        mov rdi, 77;
        mov rsi, 65;
        mov rdx, 0x41F;
        mov rcx, 30;
        mov r8, 0xD7;
        call gpio_line_cap_mint;
        cmp rax, 0;
        jne gpl_w_fail;

        call gpio_line_rows_live;
        cmp rax, 6;
        jne gpl_w_fail;

        // Orphan it.
        mov rdi, 77;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call gpl_w_seed;

        call gpio_line_rows_live;
        cmp rax, 6;                      // the ROW is still there
        jne gpl_w_fail;

        xor rdi, rdi;
        call lpss_gpio_release;
        cmp rax, 0;
        jne gpl_w_fail;

        // Every line on controller A is gone, descriptor and row.
        mov rdi, 72;
        call gpl_w_kind;
        cmp rax, 0;
        jne gpl_w_fail;
        mov rdi, 73;
        call gpl_w_kind;
        cmp rax, 0;
        jne gpl_w_fail;
        mov rdi, 74;
        call gpl_w_kind;
        cmp rax, 0;
        jne gpl_w_fail;
        mov rdi, 75;
        call gpl_w_kind;
        cmp rax, 0;
        jne gpl_w_fail;

        // Controller B's line is untouched. A cascade that swept by PIN
        // rather than by controller would have taken it: slot 76 holds
        // pin 5, the same pin number slot 72 held.
        mov rdi, 76;
        call gpl_w_kind;
        mov r15, 0x154;
        cmp rax, r15;
        jne gpl_w_fail;

        // Five rows freed -- four through phase 1 and the ghost through
        // phase 2 -- leaving exactly controller B's.
        call gpio_line_rows_live;
        cmp rax, 1;
        jne gpl_w_fail;

        // ================================================================
        // M. NO ROW LEAK — the freed pin is re-mintable.
        //
        // Only true if the revoke SCRUBBED the row rather than merely
        // clearing its in_use flag: the uniqueness key is (controller,
        // pin), so a stale pin in a freed row would refuse the next
        // legitimate claim forever.
        // ================================================================
        mov rax, 13;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        mov rdi, 76;
        call gpio_line_cap_revoke;
        cmp rax, 0;
        jne gpl_w_fail;
        call gpio_line_rows_live;
        cmp rax, 0;
        jne gpl_w_fail;

        mov rdi, 76;
        mov rsi, 66;
        mov rdx, 0x41F;
        mov rcx, 5;                      // the pin we just gave back
        mov r8, 0xD5;
        call gpio_line_cap_mint;
        cmp rax, 0;
        jne gpl_w_fail;
        call gpio_line_rows_live;
        cmp rax, 1;
        jne gpl_w_fail;

        mov rdi, 1;
        call lpss_gpio_release;
        cmp rax, 0;
        jne gpl_w_fail;
        call gpio_line_rows_live;
        cmp rax, 0;
        jne gpl_w_fail;
        mov rdi, 76;
        call gpl_w_kind;
        cmp rax, 0;
        jne gpl_w_fail;

        // ================================================================
        // N. Revoke edges.
        // ================================================================
        mov rax, 14;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        mov rdi, 79;
        call gpio_line_cap_revoke;
        mov r15, 0xFFFFFF12;             // GPIO_LINE_REVOKE_ALREADY
        cmp rax, r15;
        jne gpl_w_fail;

        mov rdi, 65;
        call gpio_line_cap_revoke;
        mov r15, 0xFFFFFF13;             // GPIO_LINE_REVOKE_WRONG_KIND
        cmp rax, r15;
        jne gpl_w_fail;

        // The base authority survived it.
        mov rdi, 65;
        call gpl_w_kind;
        cmp rax, 10;
        jne gpl_w_fail;

        // ================================================================
        // O. Leave the table, both row tables and the seam as we found
        //    them.
        // ================================================================
        mov rax, 15;
        lea rcx, [rip + _gpl_w_stage];
        mov [rcx], rax;

        call gpl_w_teardown;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kind_gpio_ok_msg];
        call klog_s1;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpl_w_fail:
        call gpl_w_teardown;

        lea rax, [rip + _gpl_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kind_gpio_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
