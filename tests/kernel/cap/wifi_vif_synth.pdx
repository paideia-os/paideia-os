// tests/kernel/cap/wifi_vif_synth.pdx — R38.M3-002 (#1300)
//
// Boot witness for KIND_WIFI_VIF.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, PHY-slot gate,
// mac_valid rejection of multicast + zero, mode/state validators,
// uniqueness on vif_key, mint/revoke round-trip, transition FSM.
//
// Fingerprint: R38 KIND_WIFI_VIF OK
//
// Cap slots 176..187 (remapped from 440..451 to fit CAP_SLOT_MAX=256).

module WifiVifSynth = structure {

  pub let mut _wvifw_stage : u64 = 0

  pub let wvifw_ok   : [u8; 18] = "KIND_WIFI_VIF OK\0"
  pub let wvifw_fail : [u8; 20] = "KIND_WIFI_VIF FAIL\0"

  pub let wvifw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-002 (#1300): clear cap_table slots 176..187.",
      block: {
        push rbx;
        mov rbx, 176;
      wvifwc_loop:
        cmp rbx, 188;
        jae wvifwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp wvifwc_loop;
      wvifwc_done:
        pop rbx;
        ret
      }
    }

  pub let wvifw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): reset WIFI VIF row table AND KIND_WIFI_PHY row table (the vif references a phy).",
      block: {
        call wifi_vif_table_reset;
        call wifi_phy_table_reset;
        ret
      }
    }

  pub let wvifw_seed_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-002 (#1300): synthetic KIND_IPC_ENDPOINT at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let wvifw_seed_phy : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-002 (#1300): synthetic KIND_WIFI_PHY at slot (no rights, gate only reads kind).",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x178;                  // KIND_WIFI_PHY
        xor rdx, rdx;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let wifi_vif_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R38.M3-002 (#1300): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_PHY. (4) BAD_MAC (zero). (5) BAD_MAC (multicast). (6) BAD_MODE. (7) Happy path. (8) Query fields. (9) IN_USE. (10) Transition DOWN->UP.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wvifw_stage];
        mov [rcx], rax;

        call wvifw_clear;
        call wvifw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call wvif_mode_valid;
        cmp rax, 1;
        jne wvifw_fail_stage;
        mov rdi, 2;
        call wvif_mode_valid;
        cmp rax, 1;
        jne wvifw_fail_stage;
        mov rdi, 3;
        call wvif_mode_valid;
        cmp rax, 0;
        jne wvifw_fail_stage;
        mov rdi, 0;                      // mac == 0 refused
        call wvif_mac_valid;
        cmp rax, 0;
        jne wvifw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at 177 (R_MINT), KIND_WIFI_PHY at 178.
        mov rdi, 177;
        mov rsi, 0x200;
        mov rdx, 0x0055;
        call wvifw_seed_endpoint;

        mov rdi, 178;
        mov rsi, 0x0011;
        call wvifw_seed_phy;

        // Legitimate MAC: 0x02_A0_C9_11_22_33 (locally administered, unicast).
        // Packing low bit 0 (bit 40 in u48).  02 has multicast bit
        // (bit 0 of first octet -> bit 40) == 0, so this is unicast.
        // Actually 02 = 0b00000010 -> bit 40 == 0 => unicast, bit 41
        // == 1 => LAA.  Good.
        // As u48: 0x02A0C9112233
        mov r15, 0x02A0C9112233;

        // packed_v: phy_slot=178 (0xB2), mode=STA (0).
        mov rbp, 0x000000B2;

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _wvifw_stage];
        mov [rcx], rax;

        mov rdi, 179;
        mov rsi, 176;                    // empty parent
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE20;
        mov r8,  rbp;
        mov r9,  r15;
        call wifi_vif_cap_mint_inner;
        mov r11, 0xFFFFF46D;
        cmp rax, r11;
        jne wvifw_fail_stage;

        // -- 3. BAD_PHY (phy_slot=181 empty).
        mov rax, 3;
        lea rcx, [rip + _wvifw_stage];
        mov [rcx], rax;

        mov rdi, 179;
        mov rsi, 177;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE21;
        mov r8,  0x000000B5;             // phy_slot=181 (empty)
        mov r9,  r15;
        call wifi_vif_cap_mint_inner;
        mov r11, 0xFFFFF46B;
        cmp rax, r11;
        jne wvifw_fail_stage;

        // -- 4. BAD_MAC zero.
        mov rax, 4;
        lea rcx, [rip + _wvifw_stage];
        mov [rcx], rax;

        mov rdi, 179;
        mov rsi, 177;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE22;
        mov r8,  rbp;
        mov r9,  0;                      // MAC zero
        call wifi_vif_cap_mint_inner;
        mov r11, 0xFFFFF46A;
        cmp rax, r11;
        jne wvifw_fail_stage;

        // -- 5. BAD_MAC multicast (bit 40 == 1: e.g., 0x01_...).
        mov rax, 5;
        lea rcx, [rip + _wvifw_stage];
        mov [rcx], rax;

        mov rdi, 179;
        mov rsi, 177;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE23;
        mov r8,  rbp;
        mov r9,  0x01A0C9112233;         // multicast bit set
        call wifi_vif_cap_mint_inner;
        mov r11, 0xFFFFF46A;
        cmp rax, r11;
        jne wvifw_fail_stage;

        // -- 6. BAD_MODE (mode 3 out of enum).
        mov rax, 6;
        lea rcx, [rip + _wvifw_stage];
        mov [rcx], rax;

        mov rdi, 179;
        mov rsi, 177;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE24;
        // packed_v with mode = 3 (bad)
        mov r8,  0x000300B2;
        mov r9,  r15;
        call wifi_vif_cap_mint_inner;
        mov r11, 0xFFFFF469;
        cmp rax, r11;
        jne wvifw_fail_stage;

        // -- 7. Happy path.
        mov rax, 7;
        lea rcx, [rip + _wvifw_stage];
        mov [rcx], rax;

        mov rdi, 179;
        mov rsi, 177;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE25;
        mov r8,  rbp;
        mov r9,  r15;
        call wifi_vif_cap_mint_inner;
        cmp rax, 0;
        jne wvifw_fail_stage;

        // -- 8. Query fields.
        mov rax, 8;
        lea rcx, [rip + _wvifw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call wvif_row_key;
        mov r11, 0xC0FFEE25;
        cmp rax, r11;
        jne wvifw_fail_stage;

        mov rdi, 0;
        call wvif_row_endpoint;
        cmp rax, 177;
        jne wvifw_fail_stage;

        mov rdi, 0;
        call wvif_row_phy;
        cmp rax, 178;
        jne wvifw_fail_stage;

        mov rdi, 0;
        call wvif_row_mac;
        cmp rax, r15;                    // 0x02A0C9112233
        jne wvifw_fail_stage;

        mov rdi, 0;
        call wvif_row_mode;
        cmp rax, 0;                      // STA
        jne wvifw_fail_stage;

        mov rdi, 0;
        call wvif_row_state;
        cmp rax, 0;                      // DOWN
        jne wvifw_fail_stage;

        // -- 9. IN_USE.
        mov rax, 9;
        lea rcx, [rip + _wvifw_stage];
        mov [rcx], rax;

        mov rdi, 180;
        mov rsi, 177;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE25;             // duplicate
        mov r8,  rbp;
        mov r9,  r15;
        call wifi_vif_cap_mint_inner;
        mov r11, 0xFFFFF465;
        cmp rax, r11;
        jne wvifw_fail_stage;

        // -- 10. Transition DOWN -> UP.
        mov rax, 10;
        lea rcx, [rip + _wvifw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;                      // UP
        call wvif_row_transition;
        cmp rax, 0;
        jne wvifw_fail_stage;

        mov rdi, 0;
        call wvif_row_state;
        cmp rax, 1;
        jne wvifw_fail_stage;

        // Bad edge: UP -> DOWN by way of an illegal ordinal (say 5).
        mov rdi, 0;
        mov rsi, 5;                      // out of enum
        call wvif_row_transition;
        mov r11, 0xFFFFF461;
        cmp rax, r11;
        jne wvifw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wvifw_ok];
        call klog_s1;

        call wvifw_scrub;
        call wvifw_clear;
        xor rax, rax;
        jmp wvifw_out;

      wvifw_fail_stage:
        lea rax, [rip + _wvifw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wvifw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wvifw_scrub;
        call wvifw_clear;
        mov rax, 1;

      wvifw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
