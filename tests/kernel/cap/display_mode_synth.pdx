// tests/kernel/cap/display_mode_synth.pdx — R36.M3-004 (#1247)
//
// Boot witness for KIND_DISPLAY_MODE.
//
// Asserts derivation gate over KIND_MEMORY, pclk / dim / refresh /
// flags refusals, uniqueness on mode_key, and mint / revoke round-trip.
//
// Fingerprint: R36 KIND_DISPLAY_MODE OK
//
// Cap slots 40..55.

module DisplayModeSynth = structure {

  pub let mut _dpmw_stage : u64 = 0

  pub let dpmw_ok   : [u8; 22] = "KIND_DISPLAY_MODE OK\0"
  pub let dpmw_fail : [u8; 24] = "KIND_DISPLAY_MODE FAIL\0"

  pub let dpmw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-004 (#1247): clear cap_table slots 40..55.",
      block: {
        push rbx;
        mov rbx, 40;
      dpmwc_loop:
        cmp rbx, 56;
        jae dpmwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp dpmwc_loop;
      dpmwc_done:
        pop rbx;
        ret
      }
    }

  pub let dpmw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): reset DISPLAY_MODE row table.",
      block: {
        call display_mode_table_reset;
        ret
      }
    }

  pub let dpmw_memory : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (memory_key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-004 (#1247): synthetic KIND_MEMORY at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let display_mode_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R36.M3-004 (#1247): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_PCLK. (4) BAD_DIM (h=0). (5) Happy path. (6) Query fields. (7) IN_USE. (8) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dpmw_stage];
        mov [rcx], rax;

        call dpmw_clear;
        call dpmw_scrub;

        // -- 1. Validators.
        mov rdi, 148500;                 // 1080p60 pixel clock
        call dpm_pclk_valid;
        cmp rax, 1;
        jne dpmw_fail_stage;
        mov rdi, 5000;                   // too low
        call dpm_pclk_valid;
        cmp rax, 0;
        jne dpmw_fail_stage;

        mov rdi, 1920;
        call dpm_dim_valid;
        cmp rax, 1;
        jne dpmw_fail_stage;
        mov rdi, 0;
        call dpm_dim_valid;
        cmp rax, 0;
        jne dpmw_fail_stage;

        mov rdi, 60;
        call dpm_refresh_valid;
        cmp rax, 1;
        jne dpmw_fail_stage;
        // 300 > DPM_REFRESH_MAX (240).  The prior witness used 44 as
        // the "invalid" case, but the driver's design admits (0, 240]
        // -- 44 Hz is a valid low-refresh mode.
        mov rdi, 300;
        call dpm_refresh_valid;
        cmp rax, 0;
        jne dpmw_fail_stage;

        mov rdi, 0x03;
        call dpm_flags_valid;
        cmp rax, 1;
        jne dpmw_fail_stage;
        mov rdi, 0x08;
        call dpm_flags_valid;
        cmp rax, 0;
        jne dpmw_fail_stage;

        // Setup: KIND_MEMORY at 41.
        mov rdi, 41;
        mov rsi, 0x200;
        mov rdx, 0xB00F0001;
        call dpmw_memory;

        // packed_ident: pclk=148500 (0x24414) | h=1920 (0x780) | v=1080 (0x438)
        //   [31:0]  148500
        //   [47:32] 1920
        //   [63:48] 1080

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _dpmw_stage];
        mov [rcx], rax;

        mov r10, 148500;
        mov r11, 1920;
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 42;
        mov rsi, 40;                    // empty
        mov rdx, 0x419;
        mov rcx, 0xDEAF0001;
        mov r8, 41;
        mov r9, r10;
        call display_mode_cap_mint_inner;
        mov r11, 0xFFFFF72D;
        cmp rax, r11;
        jne dpmw_fail_stage;

        // -- 3. BAD_PCLK (pclk = 5000 — below min).
        mov rax, 3;
        lea rcx, [rip + _dpmw_stage];
        mov [rcx], rax;

        mov r10, 5000;
        mov r11, 1920;
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 42;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xDEAF0002;
        mov r8, 41;
        mov r9, r10;
        call display_mode_cap_mint_inner;
        mov r11, 0xFFFFF72B;
        cmp rax, r11;
        jne dpmw_fail_stage;

        // -- 4. BAD_DIM (h = 0).
        mov rax, 4;
        lea rcx, [rip + _dpmw_stage];
        mov [rcx], rax;

        mov r10, 148500;
        mov r11, 0;                      // h = 0
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 42;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xDEAF0003;
        mov r8, 41;
        mov r9, r10;
        call display_mode_cap_mint_inner;
        mov r11, 0xFFFFF72A;
        cmp rax, r11;
        jne dpmw_fail_stage;

        // -- 5. Happy path.
        mov rax, 5;
        lea rcx, [rip + _dpmw_stage];
        mov [rcx], rax;

        mov r10, 148500;
        mov r11, 1920;
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 42;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xDEAF0004;
        mov r8, 41;
        mov r9, r10;
        call display_mode_cap_mint_inner;
        cmp rax, 0;
        jne dpmw_fail_stage;

        // -- 6. Query fields.
        mov rax, 6;
        lea rcx, [rip + _dpmw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call dpm_row_pclk;
        mov r11, 148500;
        cmp rax, r11;
        jne dpmw_fail_stage;

        mov rdi, 0;
        call dpm_row_h;
        cmp rax, 1920;
        jne dpmw_fail_stage;

        mov rdi, 0;
        call dpm_row_v;
        cmp rax, 1080;
        jne dpmw_fail_stage;

        mov rdi, 0;
        call dpm_row_refresh;
        cmp rax, 60;                     // hardcoded default in mint
        jne dpmw_fail_stage;

        mov rdi, 0;
        call dpm_row_key;
        mov r11, 0xDEAF0004;
        cmp rax, r11;
        jne dpmw_fail_stage;

        // -- 7. IN_USE (duplicate key).
        mov rax, 7;
        lea rcx, [rip + _dpmw_stage];
        mov [rcx], rax;

        mov r10, 148500;
        mov r11, 1920;
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 43;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xDEAF0004;             // duplicate
        mov r8, 41;
        mov r9, r10;
        call display_mode_cap_mint_inner;
        mov r11, 0xFFFFF724;
        cmp rax, r11;
        jne dpmw_fail_stage;

        // -- 8. Revoke round-trip.
        mov rax, 8;
        lea rcx, [rip + _dpmw_stage];
        mov [rcx], rax;

        mov rdi, 42;
        call display_mode_cap_revoke_inner;
        cmp rax, 0;
        jne dpmw_fail_stage;

        mov r10, 148500;
        mov r11, 1920;
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 42;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xDEAF0004;             // key free again
        mov r8, 41;
        mov r9, r10;
        call display_mode_cap_mint_inner;
        cmp rax, 0;
        jne dpmw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpmw_ok];
        call klog_s1;

        call dpmw_scrub;
        call dpmw_clear;
        xor rax, rax;
        jmp dpmw_out;

      dpmw_fail_stage:
        lea rax, [rip + _dpmw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpmw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dpmw_scrub;
        call dpmw_clear;
        mov rax, 1;

      dpmw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
