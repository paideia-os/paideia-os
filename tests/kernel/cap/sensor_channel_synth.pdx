// tests/kernel/cap/sensor_channel_synth.pdx — R32.M5-001 (#1133)
//
// Boot witness for KIND_SENSOR_CHANNEL: the derivation gate over
// KIND_IPC_ENDPOINT, the type/rate/pid validators, the (endpoint,
// type) uniqueness rule, the revoke, and the dispatch handler.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arithmetic, refusals and state transitions. IT ASSERTS
// NOTHING ABOUT A ROUTED SAMPLE, because no code in this tree wires
// sensor_hub's fanout to this kind at row-lookup granularity --
// kind_sensor_channel.pdx §3 says so at length, and a future
// milestone is where that plumbing lands.
//
// -----------------------------------------------------------------------------
// Fingerprint: R32 KIND_SENSOR OK
// -----------------------------------------------------------------------------
//
// One marker per issue-map instruction. Stage failures print
// R32 KIND_SENSOR FAIL with the stage counter, so the ordered
// subsequence gate in tests/r17/shell-shutdown.golden localises to
// the first failing stage.
//
// -----------------------------------------------------------------------------
// Cap slots 132..139
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness (0..8, 10..12, 14..19, 28..33,
// 46..63, 64..95, 96..99, 100..103, 108..131, 160..251).

module SensorChannelSynth = structure {

  pub let mut _sench_w_stage : u64 = 0

  pub let sench_w_ok   : [u8; 17] = "KIND_SENSOR OK\n\0\0"
  pub let sench_w_fail : [u8; 19] = "KIND_SENSOR FAIL\n\0\0"

  // ==========================================================================
  // sench_w_clear() — return slots 132..139 to boot state.
  // ==========================================================================

  pub let sench_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): clear cap_table slots 132..139 through cap_mint_write. Called on both exits. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed sench_wc_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 132;
      sench_wc_loop:
        cmp rbx, 140;
        jae sench_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp sench_wc_loop;
      sench_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let sench_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-001 (#1133): reset the sensor channel row table and the counters. One push leaves rsp%16 == 0 at the nested call. Labels prefixed sench_ws_.",
      block: {
        push rbx;
        call sensor_channel_table_reset;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // sench_w_endpoint(slot, eid, rights) — mint a synthetic
  // KIND_IPC_ENDPOINT parent.
  // ==========================================================================

  pub let sench_w_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (eid: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): write a synthetic KIND_IPC_ENDPOINT descriptor whose target_ptr encodes endpoint id in bits [15:0]. Fixture-local parent rather than a real endpoint mint, for the same reason hid_event_synth uses one. Two pushes leave rsp%16 == 0 at the nested call.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let sensor_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R32.M5-001 (#1133): boot witness for KIND_SENSOR_CHANNEL. Drives both halves of the derivation gate in both directions, the rights subset test, the type / rate / pid refusals, the (endpoint, type) uniqueness rule (same endpoint DIFFERENT types is legal), the wrong-kind revoke refusal, and a re-mint after revoke which is what proves no ghost row was stranded. Also drives the enumeration boundaries (type = 0 refused, type = MAX admitted, type = MAX+1 refused; rate = 0 refused, rate = MAX admitted, rate = MAX+1 refused). Both exits call sench_w_scrub and sench_w_clear. Five-push prologue leaves rsp%16 == 0 at every nested call; the stage counter lives in module .bss. Labels prefixed sench_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        call sench_w_clear;
        call sench_w_scrub;

        // 132 — well-formed endpoint with RIGHT_MINT, id 0x51.
        // 133 — endpoint without RIGHT_MINT, id 0x53.
        // 134 — endpoint with RIGHT_MINT but id 0 (fabricated).
        // 135, 136, 137 — subject slots.
        mov rdi, 132;
        mov rsi, 0x51;
        mov rdx, 0x200;                  // RIGHT_MINT
        call sench_w_endpoint;
        mov rdi, 133;
        mov rsi, 0x53;
        mov rdx, 0x001;                  // no RIGHT_MINT
        call sench_w_endpoint;
        mov rdi, 134;
        xor rsi, rsi;                    // eid 0
        mov rdx, 0x200;
        call sench_w_endpoint;

        // -- 1. First half of the gate.
        mov rax, 2;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 132;
        call sensor_channel_check_parent_endpoint;
        cmp rax, 1;
        jne sench_w_fail_stage;

        mov rdi, 133;                    // no MINT
        call sensor_channel_check_parent_endpoint;
        cmp rax, 0;
        jne sench_w_fail_stage;

        mov rdi, 135;                    // empty slot
        call sensor_channel_check_parent_endpoint;
        cmp rax, 0;
        jne sench_w_fail_stage;

        // Try to mint from an endpoint without RIGHT_MINT.
        mov rdi, 135;
        mov rsi, 133;
        mov rdx, 0x41B;                  // R_SENSOR_ALL
        mov rcx, 1;                      // SENSOR_TYPE_ALS
        mov r8, 100;                     // rate_hz
        mov r9, 42;                      // pid
        call sensor_channel_cap_mint;
        mov r11, 0xFFFFFEAD;             // SENSOR_MINT_BAD_PARENT
        cmp rax, r11;
        jne sench_w_fail_stage;

        // -- 2. Rights subset. RIGHT_MINT outside the mask.
        mov rax, 3;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 0x001;
        call sensor_channel_rights_valid;
        cmp rax, 1;
        jne sench_w_fail_stage;
        mov rdi, 0x41B;
        call sensor_channel_rights_valid;
        cmp rax, 1;
        jne sench_w_fail_stage;
        mov rdi, 0x200;
        call sensor_channel_rights_valid;
        cmp rax, 0;
        jne sench_w_fail_stage;

        mov rdi, 135;
        mov rsi, 132;
        mov rdx, 0x21B;                  // R_SENSOR_ALL | RIGHT_MINT
        mov rcx, 1;
        mov r8, 100;
        mov r9, 42;
        call sensor_channel_cap_mint;
        mov r11, 0xFFFFFEAC;             // SENSOR_MINT_BAD_RIGHTS
        cmp rax, r11;
        jne sench_w_fail_stage;

        // -- 3. Type refusals.
        mov rax, 4;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call sensor_channel_type_valid;
        cmp rax, 0;
        jne sench_w_fail_stage;

        mov rdi, 1;
        call sensor_channel_type_valid;
        cmp rax, 1;
        jne sench_w_fail_stage;

        mov rdi, 3;                      // MAX
        call sensor_channel_type_valid;
        cmp rax, 1;
        jne sench_w_fail_stage;

        mov rdi, 4;                      // past MAX
        call sensor_channel_type_valid;
        cmp rax, 0;
        jne sench_w_fail_stage;

        // Mint with type = 0.
        mov rdi, 135;
        mov rsi, 132;
        mov rdx, 0x41B;
        xor rcx, rcx;
        mov r8, 100;
        mov r9, 42;
        call sensor_channel_cap_mint;
        mov r11, 0xFFFFFEAB;             // SENSOR_MINT_BAD_TYPE
        cmp rax, r11;
        jne sench_w_fail_stage;

        // -- 4. Rate refusals.
        mov rax, 5;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call sensor_channel_rate_valid;
        cmp rax, 0;
        jne sench_w_fail_stage;

        mov rdi, 1;
        call sensor_channel_rate_valid;
        cmp rax, 1;
        jne sench_w_fail_stage;

        mov rdi, 1000;
        call sensor_channel_rate_valid;
        cmp rax, 1;
        jne sench_w_fail_stage;

        mov rdi, 1001;
        call sensor_channel_rate_valid;
        cmp rax, 0;
        jne sench_w_fail_stage;

        // Mint with rate = 0.
        mov rdi, 135;
        mov rsi, 132;
        mov rdx, 0x41B;
        mov rcx, 1;
        xor r8, r8;
        mov r9, 42;
        call sensor_channel_cap_mint;
        mov r11, 0xFFFFFEAA;             // SENSOR_MINT_BAD_RATE
        cmp rax, r11;
        jne sench_w_fail_stage;

        // -- 5. Pid refusals.
        mov rax, 6;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 135;
        mov rsi, 132;
        mov rdx, 0x41B;
        mov rcx, 1;
        mov r8, 100;
        xor r9, r9;                      // pid = 0
        call sensor_channel_cap_mint;
        mov r11, 0xFFFFFEA9;             // SENSOR_MINT_BAD_PID
        cmp rax, r11;
        jne sench_w_fail_stage;

        mov rdi, 135;
        mov rsi, 132;
        mov rdx, 0x41B;
        mov rcx, 1;
        mov r8, 100;
        mov r9, 0x100000000;             // pid overflows u32
        call sensor_channel_cap_mint;
        mov r11, 0xFFFFFEA9;
        cmp rax, r11;
        jne sench_w_fail_stage;

        // -- 6. Fabricated endpoint (eid == 0) is refused.
        mov rax, 7;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 134;
        call sensor_channel_parent_eid;
        cmp rax, 0;
        jne sench_w_fail_stage;

        mov rdi, 135;
        mov rsi, 134;                    // endpoint with eid 0
        mov rdx, 0x41B;
        mov rcx, 1;
        mov r8, 100;
        mov r9, 42;
        call sensor_channel_cap_mint;
        mov r11, 0xFFFFFEA8;             // SENSOR_MINT_BAD_EID
        cmp rax, r11;
        jne sench_w_fail_stage;

        // -- 7. Happy path.
        mov rax, 8;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 135;
        mov rsi, 132;
        mov rdx, 0x41B;
        mov rcx, 1;                      // ALS
        mov r8, 100;                     // 100 Hz
        mov r9, 42;
        call sensor_channel_cap_mint;
        cmp rax, 0;
        jne sench_w_fail_stage;

        mov rdi, 135;
        call sensor_channel_channel_of_slot;
        cmp rax, 0x51;                   // INHERITED endpoint id
        jne sench_w_fail_stage;

        mov rdi, 135;
        call sensor_channel_type_of_slot;
        cmp rax, 1;
        jne sench_w_fail_stage;

        mov rdi, 135;
        call sensor_channel_rate_of_slot;
        cmp rax, 100;
        jne sench_w_fail_stage;

        mov rdi, 135;
        call sensor_channel_pid_of_slot;
        cmp rax, 42;
        jne sench_w_fail_stage;

        mov rdi, 135;
        call sensor_channel_row_of_slot;
        mov rbx, rax;                    // rbx = row across stage
        cmp rbx, 0xFF;
        je  sench_w_fail_stage;

        mov rdi, rbx;
        call sensor_channel_row_parent;
        cmp rax, 132;
        jne sench_w_fail_stage;

        // -- 8. UNIQUENESS: SAME (endpoint, type) is refused.
        mov rax, 9;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 136;                    // fresh subject
        mov rsi, 132;                    // SAME endpoint
        mov rdx, 0x41B;
        mov rcx, 1;                      // SAME type
        mov r8, 200;
        mov r9, 99;
        call sensor_channel_cap_mint;
        mov r11, 0xFFFFFEA6;             // SENSOR_MINT_IN_USE
        cmp rax, r11;
        jne sench_w_fail_stage;

        // -- 9. SAME endpoint, DIFFERENT type is LEGAL.
        mov rax, 10;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 136;
        mov rsi, 132;
        mov rdx, 0x41B;
        mov rcx, 2;                      // ACCEL
        mov r8, 200;
        mov r9, 42;
        call sensor_channel_cap_mint;
        cmp rax, 0;
        jne sench_w_fail_stage;

        mov rdi, 136;
        call sensor_channel_type_of_slot;
        cmp rax, 2;
        jne sench_w_fail_stage;

        // -- 10. sample_note bumps the counter.
        mov rax, 11;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 135;
        call sensor_channel_sample_note;
        cmp rax, 0;
        jne sench_w_fail_stage;

        mov rdi, 135;
        call sensor_channel_sample_note;
        cmp rax, 0;
        jne sench_w_fail_stage;

        mov rdi, rbx;
        call sensor_channel_row_samples;
        cmp rax, 2;
        jne sench_w_fail_stage;

        // sample_note on an empty slot is BAD_SLOT.
        mov rdi, 137;
        call sensor_channel_sample_note;
        mov r11, 0xFFFFFEA5;             // SENSOR_BAD_SLOT
        cmp rax, r11;
        jne sench_w_fail_stage;

        // -- 11. Revoke refusals.
        mov rax, 12;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 132;                    // KIND_IPC_ENDPOINT
        call sensor_channel_cap_revoke;
        mov r11, 0xFFFFFEA4;             // SENSOR_WRONG_KIND
        cmp rax, r11;
        jne sench_w_fail_stage;

        mov rdi, 137;                    // empty
        call sensor_channel_cap_revoke;
        mov r11, 0xFFFFFEA3;             // SENSOR_REVOKE_ALREADY
        cmp rax, r11;
        jne sench_w_fail_stage;

        // -- 12. Revoke and RE-MINT.
        mov rax, 13;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 135;
        call sensor_channel_cap_revoke;
        cmp rax, 0;
        jne sench_w_fail_stage;

        mov rdi, rbx;
        call sensor_channel_tail_valid;
        cmp rax, 0;                      // row scrubbed
        jne sench_w_fail_stage;

        // The (0x51, ALS) pair is re-mintable.
        mov rdi, 135;
        mov rsi, 132;
        mov rdx, 0x41B;
        mov rcx, 1;
        mov r8, 100;
        mov r9, 42;
        call sensor_channel_cap_mint;
        cmp rax, 0;
        jne sench_w_fail_stage;

        // -- 13. Dead-row / wrong-slot decoders.
        mov rax, 14;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 7;                      // never-claimed row
        call sensor_channel_row_channel;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne sench_w_fail_stage;

        mov rdi, 137;
        call sensor_channel_channel_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne sench_w_fail_stage;

        mov rdi, 132;                    // KIND_IPC_ENDPOINT, not SENSOR
        call sensor_channel_channel_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne sench_w_fail_stage;

        // -- 14. find_by_pair sentinel discipline.
        mov rax, 15;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 0x51;
        mov rsi, 1;
        call sensor_channel_find_by_pair;
        cmp rax, 0xFF;
        je  sench_w_fail_stage;          // must find one

        mov rdi, 0x51;
        mov rsi, 3;                      // GYRO — no such row
        call sensor_channel_find_by_pair;
        cmp rax, 0xFF;
        jne sench_w_fail_stage;

        xor rdi, rdi;                    // fabricated endpoint 0
        mov rsi, 1;
        call sensor_channel_find_by_pair;
        cmp rax, 0xFF;
        jne sench_w_fail_stage;

        // -- 15. debug_print refuses a dead row.
        mov rax, 16;
        lea rcx, [rip + _sench_w_stage];
        mov [rcx], rax;

        mov rdi, 7;                      // never claimed
        call sensor_channel_debug_print;
        mov r11, 0xFFFFFEAE;             // SENSOR_TAIL_BAD_ARG
        cmp rax, r11;
        jne sench_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sench_w_ok];
        call klog_s1;

        call sench_w_scrub;
        call sench_w_clear;
        xor rax, rax;
        jmp sench_w_out;

      sench_w_fail_stage:
        lea rax, [rip + _sench_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sench_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call sench_w_scrub;
        call sench_w_clear;
        mov rax, 1;

      sench_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
