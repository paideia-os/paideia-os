// tests/kernel/cap/wifi_scan_txn_synth.pdx — R38.M3-003 (#1303)
//
// Boot witness for KIND_WIFI_SCAN_TXN (LINEAR).
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, VIF-slot gate,
// R_MINT explicit LINEAR refuse (WSCN_MINT_REFUSED_MINT), rights
// subset refuse, uniqueness on scan_key, transition FSM,
// mint/revoke round-trip, linear_flag == 1 on the live row.
//
// LINEAR TRIPLE-CHECK exercised:
//   gate 1: R_WSCN_MINT (0x200) is absent from R_WSCN_ALL (0x41B)
//   gate 2: explicit refuse (WSCN_MINT_REFUSED_MINT) tested
//   gate 3: row's linear_flag reads back as 1
//
// Fingerprint: R38 KIND_WIFI_SCAN_TXN OK
//
// Cap slots 192..203 (remapped from 460..471 to fit CAP_SLOT_MAX=256).

module WifiScanTxnSynth = structure {

  pub let mut _wscnw_stage : u64 = 0

  pub let wscnw_ok   : [u8; 23] = "KIND_WIFI_SCAN_TXN OK\0"
  pub let wscnw_fail : [u8; 25] = "KIND_WIFI_SCAN_TXN FAIL\0"

  pub let wscnw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-003 (#1303): clear cap_table slots 192..203.",
      block: {
        push rbx;
        mov rbx, 192;
      wscnwc_loop:
        cmp rbx, 204;
        jae wscnwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp wscnwc_loop;
      wscnwc_done:
        pop rbx;
        ret
      }
    }

  pub let wscnw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): reset WIFI SCAN row table.",
      block: {
        call wifi_scan_table_reset;
        ret
      }
    }

  pub let wscnw_seed_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-003 (#1303): synthetic KIND_IPC_ENDPOINT at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let wscnw_seed_vif : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-003 (#1303): synthetic KIND_WIFI_VIF at slot (no rights, gate only reads kind).",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x179;                  // KIND_WIFI_VIF
        xor rdx, rdx;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let wifi_scan_txn_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R38.M3-003 (#1303): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_VIF. (4) BAD_RIGHTS (subset trip). (5) REFUSED_MINT (LINEAR explicit gate). (6) Happy path. (7) Query fields incl. linear_flag == 1. (8) IN_USE. (9) Transition PENDING -> RUNNING. (10) Bad transition (RUNNING -> PENDING). (11) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wscnw_stage];
        mov [rcx], rax;

        call wscnw_clear;
        call wscnw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call wscn_state_valid;
        cmp rax, 1;
        jne wscnw_fail_stage;
        mov rdi, 3;
        call wscn_state_valid;
        cmp rax, 1;
        jne wscnw_fail_stage;
        mov rdi, 4;
        call wscn_state_valid;
        cmp rax, 0;
        jne wscnw_fail_stage;
        // rights_valid: R_MINT bit outside mask
        mov rdi, 0x200;
        call wscn_rights_valid;
        cmp rax, 0;
        jne wscnw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at 193, KIND_WIFI_VIF at 194.
        mov rdi, 193;
        mov rsi, 0x200;                  // R_MINT so it can be a parent
        mov rdx, 0x0042;
        call wscnw_seed_endpoint;

        mov rdi, 194;
        mov rsi, 0x11;
        call wscnw_seed_vif;

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _wscnw_stage];
        mov [rcx], rax;

        mov rdi, 195;
        mov rsi, 192;                    // empty parent
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE30;
        mov r8,  194;
        call wifi_scan_cap_mint_inner;
        mov r11, 0xFFFFF45D;
        cmp rax, r11;
        jne wscnw_fail_stage;

        // -- 3. BAD_VIF (vif_slot=197 empty).
        mov rax, 3;
        lea rcx, [rip + _wscnw_stage];
        mov [rcx], rax;

        mov rdi, 195;
        mov rsi, 193;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE31;
        mov r8,  197;                    // empty vif
        call wifi_scan_cap_mint_inner;
        mov r11, 0xFFFFF45B;
        cmp rax, r11;
        jne wscnw_fail_stage;

        // -- 4. BAD_RIGHTS (bit outside R_WSCN_ALL but NOT R_MINT).
        mov rax, 4;
        lea rcx, [rip + _wscnw_stage];
        mov [rcx], rax;

        mov rdi, 195;
        mov rsi, 193;
        mov rdx, 0x81B;                  // 0x800 outside mask
        mov rcx, 0xC0FFEE32;
        mov r8,  194;
        call wifi_scan_cap_mint_inner;
        mov r11, 0xFFFFF45C;
        cmp rax, r11;
        jne wscnw_fail_stage;

        // -- 5. REFUSED_MINT (R_MINT set -- LINEAR explicit gate).
        mov rax, 5;
        lea rcx, [rip + _wscnw_stage];
        mov [rcx], rax;

        mov rdi, 195;
        mov rsi, 193;
        mov rdx, 0x21B;                  // R_MINT (0x200) tripped
        mov rcx, 0xC0FFEE33;
        mov r8,  194;
        call wifi_scan_cap_mint_inner;
        mov r11, 0xFFFFF450;             // LINEAR REFUSED_MINT
        cmp rax, r11;
        jne wscnw_fail_stage;

        // -- 6. Happy path.
        mov rax, 6;
        lea rcx, [rip + _wscnw_stage];
        mov [rcx], rax;

        mov rdi, 195;
        mov rsi, 193;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE34;
        mov r8,  194;
        call wifi_scan_cap_mint_inner;
        cmp rax, 0;
        jne wscnw_fail_stage;

        // -- 7. Query fields incl. linear_flag.
        mov rax, 7;
        lea rcx, [rip + _wscnw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call wscn_row_key;
        mov r11, 0xC0FFEE34;
        cmp rax, r11;
        jne wscnw_fail_stage;

        mov rdi, 0;
        call wscn_row_endpoint;
        cmp rax, 193;
        jne wscnw_fail_stage;

        mov rdi, 0;
        call wscn_row_vif;
        cmp rax, 194;
        jne wscnw_fail_stage;

        mov rdi, 0;
        call wscn_row_state;
        cmp rax, 0;                      // PENDING
        jne wscnw_fail_stage;

        mov rdi, 0;
        call wscn_row_results;
        cmp rax, 0;
        jne wscnw_fail_stage;

        // GATE 3: linear_flag frozen at 1.
        mov rdi, 0;
        call wscn_row_linear;
        cmp rax, 1;
        jne wscnw_fail_stage;

        // -- 8. IN_USE (duplicate scan_key).
        mov rax, 8;
        lea rcx, [rip + _wscnw_stage];
        mov [rcx], rax;

        mov rdi, 196;
        mov rsi, 193;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE34;
        mov r8,  194;
        call wifi_scan_cap_mint_inner;
        mov r11, 0xFFFFF456;
        cmp rax, r11;
        jne wscnw_fail_stage;

        // -- 9. Transition PENDING -> RUNNING.
        mov rax, 9;
        lea rcx, [rip + _wscnw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;                      // RUNNING
        call wscn_row_transition;
        cmp rax, 0;
        jne wscnw_fail_stage;

        mov rdi, 0;
        call wscn_row_state;
        cmp rax, 1;
        jne wscnw_fail_stage;

        // linear_flag survives transition.
        mov rdi, 0;
        call wscn_row_linear;
        cmp rax, 1;
        jne wscnw_fail_stage;

        // -- 10. Bad transition RUNNING -> PENDING.
        mov rax, 10;
        lea rcx, [rip + _wscnw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call wscn_row_transition;
        mov r11, 0xFFFFF452;
        cmp rax, r11;
        jne wscnw_fail_stage;

        // -- 11. Revoke round-trip.
        mov rax, 11;
        lea rcx, [rip + _wscnw_stage];
        mov [rcx], rax;

        mov rdi, 195;
        call wifi_scan_cap_revoke_inner;
        cmp rax, 0;
        jne wscnw_fail_stage;

        mov rdi, 195;
        mov rsi, 193;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE34;             // key free after revoke
        mov r8,  194;
        call wifi_scan_cap_mint_inner;
        cmp rax, 0;
        jne wscnw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wscnw_ok];
        call klog_s1;

        call wscnw_scrub;
        call wscnw_clear;
        xor rax, rax;
        jmp wscnw_out;

      wscnw_fail_stage:
        lea rax, [rip + _wscnw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wscnw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wscnw_scrub;
        call wscnw_clear;
        mov rax, 1;

      wscnw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
