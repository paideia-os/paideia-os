// tests/kernel/cap/hid_event_synth.pdx — R32.M3-002 (#1126)
//
// Boot witness for KIND_HID_EVENT: the derivation gate over
// KIND_IPC_ENDPOINT, the mask / pid validators, the (endpoint, mask)
// uniqueness rule, the revoke, and the dispatch handler.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arithmetic, refusals and state transitions. IT ASSERTS
// NOTHING ABOUT A ROUTED HID EVENT, because no code in this tree
// routes an event to a subscription -- kind_hid_event.pdx §3 says
// so at length, and R32.M4 is where that plumbing lands.
//
// -----------------------------------------------------------------------------
// Two fingerprints, not one
// -----------------------------------------------------------------------------
//
//   R32 KIND_HID_EVENT OK      — stage A: the capability. Gate halves,
//                                rights, uniqueness by (endpoint, mask),
//                                revoke, dispatch, static-identity
//                                refusals.
//   R32 HID_EVT_MASK scale OK  — stage B: the mask. Enumeration edges
//                                (zero refused, boundary admitted, bit
//                                outside MASK_ALL refused), separate
//                                rows for separate masks on the same
//                                endpoint, sentinel discipline.
//
// -----------------------------------------------------------------------------
// Cap slots 118..123
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness in the tree, including the
// KIND_HID_DEVICE witness's 108..113 above.

module HidEventSynth = structure {

  pub let mut _hide_w_stage : u64 = 0

  pub let hide_w_ok_a   : [u8; 21] = "KIND_HID_EVENT OK\n\0\0"
  pub let hide_w_fail_a : [u8; 23] = "KIND_HID_EVENT FAIL\n\0\0"
  pub let hide_w_ok_b   : [u8; 23] = "HID_EVT_MASK scale OK\n\0"
  pub let hide_w_fail_b : [u8; 25] = "HID_EVT_MASK scale FAIL\n\0"

  // ==========================================================================
  // hide_w_clear() — return slots 118..123 to boot state.
  // ==========================================================================

  pub let hide_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): clear cap_table slots 118..123 through cap_mint_write. Called on both exits. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed hide_wc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        mov rbx, 118;
      hide_wc_loop:
        cmp rbx, 124;
        jae hide_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp hide_wc_loop;
      hide_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let hide_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): reset the HID event row table and the counters. One push leaves rsp%16 == 0 at the nested call. Labels prefixed hide_ws_ per reserved-label discipline.",
      block: {
        push rbx;
        call hid_event_table_reset;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hide_w_endpoint(slot, eid, rights) — mint a synthetic
  // KIND_IPC_ENDPOINT parent.
  // ==========================================================================

  pub let hide_w_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (eid: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): write a synthetic KIND_IPC_ENDPOINT descriptor whose target_ptr encodes endpoint id in bits [15:0], through cap_mint_write. A fixture-local parent rather than a real endpoint mint, because what the gate under test reads out of the parent is exactly two things -- kind == 5 and target_ptr[15:0] -- and manufacturing a real endpoint allocation to supply them would test the endpoint substrate rather than the gate. Two pushes leave rsp%16 == 0 at the nested call. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let hid_event_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R32.M3-002 (#1126): boot witness for KIND_HID_EVENT. STAGE A drives the capability: both halves of the derivation gate in both directions, the rights subset test, the mask / pid refusals, the (endpoint, mask) uniqueness rule (same endpoint DIFFERENT masks is legal), the wrong-kind revoke refusal, the dispatch handler's per-op rights and its refusal of any non-zero op_arg[63:8] on ANY op (all are operand-less), and a re-mint after revoke which is what proves no ghost row was stranded. STAGE B drives the numbers: the mask enumeration boundaries (zero refused, MASK_ALL admitted, bit outside MASK_ALL refused), and the (endpoint, mask) pair versus endpoint-alone distinction. Each stage runs only if the previous passed. Both exits call hide_w_scrub and hide_w_clear. Five-push prologue leaves rsp%16 == 0 at every nested call; the stage counter lives in module .bss. Labels prefixed hide_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        call hide_w_clear;
        call hide_w_scrub;

        // 118 — well-formed endpoint with RIGHT_MINT, id 0x41.
        // 119 — endpoint without RIGHT_MINT, id 0x43.
        // 120 — endpoint with RIGHT_MINT but id 0 (fabricated sentinel).
        // 121, 122, 123 — subject slots.
        mov rdi, 118;
        mov rsi, 0x41;
        mov rdx, 0x200;                  // RIGHT_MINT
        call hide_w_endpoint;
        mov rdi, 119;
        mov rsi, 0x43;
        mov rdx, 0x001;                  // no RIGHT_MINT
        call hide_w_endpoint;
        mov rdi, 120;
        xor rsi, rsi;                    // eid 0
        mov rdx, 0x200;
        call hide_w_endpoint;

        // -- A1. First half of the gate, in both directions.
        mov rax, 2;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        mov rdi, 118;
        call hid_event_check_parent_endpoint;
        cmp rax, 1;
        jne hide_w_fail_stage_a;

        mov rdi, 119;
        call hid_event_check_parent_endpoint;
        cmp rax, 0;
        jne hide_w_fail_stage_a;

        mov rdi, 121;                    // empty slot
        call hid_event_check_parent_endpoint;
        cmp rax, 0;
        jne hide_w_fail_stage_a;

        // Try to mint from an endpoint without RIGHT_MINT.
        mov rdi, 121;
        mov rsi, 119;
        mov rdx, 0x41B;                  // R_HID_EVENT_ALL
        mov rcx, 0x01;                   // mask = HID_EVT_KEY
        mov r8, 42;                      // subscriber_pid
        call hid_event_cap_mint;
        mov r11, 0xFFFFFE9D;             // HID_EVT_MINT_BAD_PARENT
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // -- A2. Rights subset. RIGHT_MINT outside the mask.
        mov rax, 3;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        mov rdi, 0x001;
        call hid_event_rights_valid;
        cmp rax, 1;
        jne hide_w_fail_stage_a;
        mov rdi, 0x41B;
        call hid_event_rights_valid;
        cmp rax, 1;
        jne hide_w_fail_stage_a;
        mov rdi, 0x200;
        call hid_event_rights_valid;
        cmp rax, 0;
        jne hide_w_fail_stage_a;

        mov rdi, 121;
        mov rsi, 118;
        mov rdx, 0x21B;                  // R_HID_EVENT_ALL | RIGHT_MINT
        mov rcx, 0x01;
        mov r8, 42;
        call hid_event_cap_mint;
        mov r11, 0xFFFFFE9C;             // HID_EVT_MINT_BAD_RIGHTS
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // -- A3. Mask refusals.
        mov rax, 4;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        // zero mask
        mov rdi, 121;
        mov rsi, 118;
        mov rdx, 0x41B;
        xor rcx, rcx;                    // mask = 0
        mov r8, 42;
        call hid_event_cap_mint;
        mov r11, 0xFFFFFE9B;             // HID_EVT_MINT_BAD_MASK
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // bit outside MASK_ALL
        mov rdi, 121;
        mov rsi, 118;
        mov rdx, 0x41B;
        mov rcx, 0x10;                   // bit 4, past MASK_ALL 0x0F
        mov r8, 42;
        call hid_event_cap_mint;
        mov r11, 0xFFFFFE9B;
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // -- A4. Pid refusals.
        mov rax, 5;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        // pid 0
        mov rdi, 121;
        mov rsi, 118;
        mov rdx, 0x41B;
        mov rcx, 0x01;
        xor r8, r8;                      // pid = 0
        call hid_event_cap_mint;
        mov r11, 0xFFFFFE9A;             // HID_EVT_MINT_BAD_PID
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // pid that overflows u32
        mov rdi, 121;
        mov rsi, 118;
        mov rdx, 0x41B;
        mov rcx, 0x01;
        mov r8, 0x100000000;             // 2^32
        call hid_event_cap_mint;
        mov r11, 0xFFFFFE9A;
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // -- A5. Fabricated endpoint (eid == 0) is refused.
        mov rax, 6;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        mov rdi, 120;
        call hid_event_parent_eid;
        cmp rax, 0;
        jne hide_w_fail_stage_a;

        mov rdi, 121;
        mov rsi, 120;                    // endpoint with eid 0
        mov rdx, 0x41B;
        mov rcx, 0x01;
        mov r8, 42;
        call hid_event_cap_mint;
        mov r11, 0xFFFFFE99;             // HID_EVT_MINT_BAD_EID
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // -- A6. Happy path.
        mov rax, 7;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        mov rdi, 121;
        mov rsi, 118;
        mov rdx, 0x41B;
        mov rcx, 0x01;                   // HID_EVT_KEY
        mov r8, 42;
        call hid_event_cap_mint;
        cmp rax, 0;
        jne hide_w_fail_stage_a;

        mov rdi, 121;
        call hid_event_channel_of_slot;
        cmp rax, 0x41;                   // INHERITED endpoint id
        jne hide_w_fail_stage_a;

        mov rdi, 121;
        call hid_event_mask_of_slot;
        cmp rax, 0x01;
        jne hide_w_fail_stage_a;

        mov rdi, 121;
        call hid_event_pid_of_slot;
        cmp rax, 42;
        jne hide_w_fail_stage_a;

        mov rdi, 121;
        call hid_event_row_of_slot;
        mov rbx, rax;                    // rbx = row across stage
        cmp rbx, 0xFF;
        je  hide_w_fail_stage_a;

        mov rdi, rbx;
        call hid_event_row_parent;
        cmp rax, 118;
        jne hide_w_fail_stage_a;

        // -- A7. UNIQUENESS: SAME (endpoint, mask) is refused.
        mov rax, 8;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        mov rdi, 122;                    // fresh subject
        mov rsi, 118;                    // SAME endpoint
        mov rdx, 0x41B;
        mov rcx, 0x01;                   // SAME mask
        mov r8, 99;
        call hid_event_cap_mint;
        mov r11, 0xFFFFFE97;             // HID_EVT_MINT_IN_USE
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // -- A8. SAME endpoint, DIFFERENT mask is LEGAL.
        mov rax, 9;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        mov rdi, 122;
        mov rsi, 118;                    // SAME endpoint
        mov rdx, 0x41B;
        mov rcx, 0x02;                   // HID_EVT_POINTER (different)
        mov r8, 42;
        call hid_event_cap_mint;
        cmp rax, 0;
        jne hide_w_fail_stage_a;

        mov rdi, 122;
        call hid_event_mask_of_slot;
        cmp rax, 0x02;
        jne hide_w_fail_stage_a;

        // -- A9. Revoke refusals.
        mov rax, 10;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        mov rdi, 118;                    // KIND_IPC_ENDPOINT
        call hid_event_cap_revoke;
        mov r11, 0xFFFFFE95;             // HID_EVT_WRONG_KIND
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        mov rdi, 123;                    // empty slot
        call hid_event_cap_revoke;
        mov r11, 0xFFFFFE94;             // HID_EVT_REVOKE_ALREADY
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // -- A10. Dispatch handler.
        mov rax, 11;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        // target_ptr for slot 121: row | (slot << 16).
        mov r12, rbx;
        mov r13, 121;
        shl r13, 16;
        or  r12, r13;

        // QUERY_CHANNEL is INVOKE.
        mov rdi, 0x008;                  // R_HID_EVENT_INVOKE
        mov rsi, r12;
        mov rdx, 0;                      // QUERY_CHANNEL
        call cap_handler_hid_event;
        cmp rax, 0x41;
        jne hide_w_fail_stage_a;

        // QUERY_MASK with only READ is DENIED.
        mov rdi, 0x001;
        mov rsi, r12;
        mov rdx, 1;                      // QUERY_MASK
        call cap_handler_hid_event;
        mov r11, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // Unknown op.
        mov rdi, 0x41B;
        mov rsi, r12;
        mov rdx, 5;
        call cap_handler_hid_event;
        mov r11, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // Any operand bits are REFUSED (no op takes an operand).
        mov rdi, 0x008;
        mov rsi, r12;
        mov r13, 1;
        shl r13, 8;                      // reserved bits [63:8]
        or  r13, 1;                      // op = QUERY_MASK
        mov rdx, r13;
        call cap_handler_hid_event;
        mov r11, 0xFFFFFE9E;             // HID_EVT_TAIL_BAD_ARG
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        // -- A11. Revoke and RE-MINT.
        mov rax, 12;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        mov rdi, 121;
        call hid_event_cap_revoke;
        cmp rax, 0;
        jne hide_w_fail_stage_a;

        mov rdi, rbx;
        call hid_event_tail_valid;
        cmp rax, 0;                      // row scrubbed
        jne hide_w_fail_stage_a;

        // The (0x41, 0x01) pair is re-mintable.
        mov rdi, 121;
        mov rsi, 118;
        mov rdx, 0x41B;
        mov rcx, 0x01;
        mov r8, 42;
        call hid_event_cap_mint;
        cmp rax, 0;
        jne hide_w_fail_stage_a;

        // -- A12. Dead row answers HID_EVT_DECODE_BAD.
        mov rax, 13;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        mov rdi, 7;                      // never-claimed row
        call hid_event_row_channel;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        mov rdi, 123;                    // empty slot
        call hid_event_channel_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        mov rdi, 118;                    // KIND_IPC_ENDPOINT, not HID_EVENT
        call hid_event_channel_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hide_w_fail_stage_a;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hide_w_ok_a];
        call klog_s1;

        // ================================================================
        // STAGE B — MASK scale + pair uniqueness.
        // ================================================================

        // -- B1. Mask enumeration boundaries.
        mov rax, 21;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;                    // zero
        call hid_event_mask_valid;
        cmp rax, 0;
        jne hide_w_fail_stage_b;

        mov rdi, 0x01;                   // KEY only
        call hid_event_mask_valid;
        cmp rax, 1;
        jne hide_w_fail_stage_b;

        mov rdi, 0x0F;                   // MASK_ALL (boundary)
        call hid_event_mask_valid;
        cmp rax, 1;
        jne hide_w_fail_stage_b;

        mov rdi, 0x10;                   // bit past MASK_ALL
        call hid_event_mask_valid;
        cmp rax, 0;
        jne hide_w_fail_stage_b;

        mov rdi, 0x1F;                   // MASK_ALL with a spurious bit
        call hid_event_mask_valid;
        cmp rax, 0;
        jne hide_w_fail_stage_b;

        // -- B2. find_by_pair distinguishes (endpoint, mask) pairs.
        mov rax, 22;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        // Slot 121 holds (eid 0x41, mask 0x01) after A11.
        // Slot 122 holds (eid 0x41, mask 0x02) from A8.
        mov rdi, 0x41;
        mov rsi, 0x01;
        call hid_event_find_by_pair;
        cmp rax, 0xFF;
        je  hide_w_fail_stage_b;         // must find one
        mov r14, rax;                    // row for (0x41, 0x01)

        mov rdi, 0x41;
        mov rsi, 0x02;
        call hid_event_find_by_pair;
        cmp rax, 0xFF;
        je  hide_w_fail_stage_b;         // must find one
        cmp rax, r14;
        je  hide_w_fail_stage_b;         // and it must be DIFFERENT

        // A pair the fixture never minted returns HID_EVT_ROW_NONE.
        mov rdi, 0x41;
        mov rsi, 0x08;                   // SENSOR — no such row
        call hid_event_find_by_pair;
        cmp rax, 0xFF;
        jne hide_w_fail_stage_b;

        // A zero endpoint refuses to match anything.
        xor rdi, rdi;
        mov rsi, 0x01;
        call hid_event_find_by_pair;
        cmp rax, 0xFF;
        jne hide_w_fail_stage_b;

        // -- B3. Debug print refuses a dead row.
        mov rax, 23;
        lea rcx, [rip + _hide_w_stage];
        mov [rcx], rax;

        mov rdi, r14;                    // live
        call hid_event_debug_print;
        cmp rax, 0;
        jne hide_w_fail_stage_b;

        mov rdi, 7;                      // never claimed
        call hid_event_debug_print;
        mov r11, 0xFFFFFE9E;             // HID_EVT_TAIL_BAD_ARG
        cmp rax, r11;
        jne hide_w_fail_stage_b;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hide_w_ok_b];
        call klog_s1;

        call hide_w_scrub;
        call hide_w_clear;
        xor rax, rax;
        jmp hide_w_out;

      hide_w_fail_stage_a:
        lea rax, [rip + _hide_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hide_w_fail_a];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp hide_w_failed;

      hide_w_fail_stage_b:
        lea rax, [rip + _hide_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hide_w_fail_b];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      hide_w_failed:
        call hide_w_scrub;
        call hide_w_clear;
        mov rax, 1;

      hide_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
