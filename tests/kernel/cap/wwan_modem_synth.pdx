// tests/kernel/cap/wwan_modem_synth.pdx -- R40.M4-001 (#1360)
//
// Boot witness for KIND_WWAN_MODEM.
//
// Asserts derivation gate over KIND_DEVICE, device_slot gate,
// form / pwr refusals, rights subset refuse, NO_KEY, uniqueness on
// modem_key, mint/revoke round-trip.
//
// Fingerprint: R40 KIND_WWAN_MODEM OK
//
// Cap slots 40..47.

module WwanModemSynth = structure {

  pub let mut _wwmw_stage : u64 = 0

  pub let wwmw_ok   : [u8; 20] = "KIND_WWAN_MODEM OK\n\0"
  pub let wwmw_fail : [u8; 22] = "KIND_WWAN_MODEM FAIL\n\0"

  pub let wwmw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-001 (#1360): clear cap_table slots 40..47.",
      block: {
        push rbx;
        mov rbx, 40;
      wwmwc_loop:
        cmp rbx, 48;
        jae wwmwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp wwmwc_loop;
      wwmwc_done:
        pop rbx;
        ret
      }
    }

  pub let wwmw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): reset WWAN MODEM row table.",
      block: {
        call wwan_modem_table_reset;
        ret
      }
    }

  pub let wwmw_seed_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-001 (#1360): synthetic KIND_DEVICE at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let wwan_modem_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R40.M4-001 (#1360): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_DEVICE. (4) BAD_VENDOR. (5) BAD_PRODUCT. (6) BAD_FORM. (7) BAD_PWR. (8) BAD_RIGHTS. (9) NO_KEY. (10) Happy path. (11) Query fields. (12) IN_USE. (13) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        call wwmw_clear;
        call wwmw_scrub;

        // -- 1. Validators.
        mov rdi, 0x419;
        call wwm_rights_valid;
        cmp rax, 1;
        jne wwmw_fail_stage;
        mov rdi, 0x200;
        call wwm_rights_valid;
        cmp rax, 0;
        jne wwmw_fail_stage;

        mov rdi, 1;                      // M2
        call wwm_form_valid;
        cmp rax, 1;
        jne wwmw_fail_stage;
        mov rdi, 2;                      // USB
        call wwm_form_valid;
        cmp rax, 1;
        jne wwmw_fail_stage;
        mov rdi, 0;
        call wwm_form_valid;
        cmp rax, 0;
        jne wwmw_fail_stage;
        mov rdi, 3;
        call wwm_form_valid;
        cmp rax, 0;
        jne wwmw_fail_stage;

        mov rdi, 0;                      // D0
        call wwm_pwr_valid;
        cmp rax, 1;
        jne wwmw_fail_stage;
        mov rdi, 3;                      // D3
        call wwm_pwr_valid;
        cmp rax, 1;
        jne wwmw_fail_stage;
        mov rdi, 1;                      // D1 refused
        call wwm_pwr_valid;
        cmp rax, 0;
        jne wwmw_fail_stage;
        mov rdi, 2;                      // D2 refused
        call wwm_pwr_valid;
        cmp rax, 0;
        jne wwmw_fail_stage;

        // Setup: KIND_DEVICE at 41 (parent, R_MINT); KIND_DEVICE at 42
        // (device_slot).
        mov rdi, 41;
        mov rsi, 0x200;
        mov rdx, 0xD001;
        call wwmw_seed_device;

        mov rdi, 42;
        mov rsi, 0;
        mov rdx, 0xD002;
        call wwmw_seed_device;

        // packed_ids: device=42, vendor=0x8086 (Intel), product=0x7360
        // [15:0]=42, [31:16]=0x8086, [47:32]=0x7360.
        mov r15, 0x7360;
        shl r15, 16;
        or  r15, 0x8086;
        shl r15, 16;
        or  r15, 42;

        // packed_state: form=WWM_FORM_M2=1, pwr=WWM_PWR_D0=0.
        // [7:0]=1, [15:8]=0.
        mov r14, 0x1;

        // -- 2. BAD_PARENT (empty slot).
        mov rax, 2;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 43;
        mov rsi, 40;                     // empty parent
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE01;
        mov r8, r15;
        mov r9, r14;
        call wwan_modem_cap_mint_inner;
        mov r11, 0xFFFFF1CD;
        cmp rax, r11;
        jne wwmw_fail_stage;

        // -- 3. BAD_DEVICE (device_slot empty).
        mov rax, 3;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 43;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE02;
        // packed_ids with device=44 (empty)
        mov r8, 0x7360;
        shl r8, 16;
        or  r8, 0x8086;
        shl r8, 16;
        or  r8, 44;
        mov r9, r14;
        call wwan_modem_cap_mint_inner;
        mov r11, 0xFFFFF1CB;
        cmp rax, r11;
        jne wwmw_fail_stage;

        // -- 4. BAD_VENDOR (vendor=0).
        mov rax, 4;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 43;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE03;
        mov r8, 0x7360;
        shl r8, 16;
        or  r8, 0;                       // vendor=0
        shl r8, 16;
        or  r8, 42;
        mov r9, r14;
        call wwan_modem_cap_mint_inner;
        mov r11, 0xFFFFF1CA;
        cmp rax, r11;
        jne wwmw_fail_stage;

        // -- 5. BAD_PRODUCT (product=0).
        mov rax, 5;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 43;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE04;
        mov r8, 0;                       // product=0
        shl r8, 16;
        or  r8, 0x8086;
        shl r8, 16;
        or  r8, 42;
        mov r9, r14;
        call wwan_modem_cap_mint_inner;
        mov r11, 0xFFFFF1C9;
        cmp rax, r11;
        jne wwmw_fail_stage;

        // -- 6. BAD_FORM (form=3).
        mov rax, 6;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 43;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE05;
        mov r8, r15;
        mov r9, 3;                       // form=3 (invalid)
        call wwan_modem_cap_mint_inner;
        mov r11, 0xFFFFF1C8;
        cmp rax, r11;
        jne wwmw_fail_stage;

        // -- 7. BAD_PWR (pwr=1).
        mov rax, 7;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 43;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE06;
        mov r8, r15;
        // packed_state: form=1, pwr=1 (D1 refused)
        mov r9, 0x101;
        call wwan_modem_cap_mint_inner;
        mov r11, 0xFFFFF1C7;
        cmp rax, r11;
        jne wwmw_fail_stage;

        // -- 8. BAD_RIGHTS.
        mov rax, 8;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 43;
        mov rsi, 41;
        mov rdx, 0x800;                  // outside R_WWM_ALL
        mov rcx, 0xC0FFEE07;
        mov r8, r15;
        mov r9, r14;
        call wwan_modem_cap_mint_inner;
        mov r11, 0xFFFFF1CC;
        cmp rax, r11;
        jne wwmw_fail_stage;

        // -- 9. NO_KEY.
        mov rax, 9;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 43;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0;                      // modem_key=0
        mov r8, r15;
        mov r9, r14;
        call wwan_modem_cap_mint_inner;
        mov r11, 0xFFFFF1C6;
        cmp rax, r11;
        jne wwmw_fail_stage;

        // -- 10. Happy path.
        mov rax, 10;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 43;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE09;
        mov r8, r15;
        mov r9, r14;
        call wwan_modem_cap_mint_inner;
        cmp rax, 0;
        jne wwmw_fail_stage;

        // -- 11. Query fields.
        mov rax, 11;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call wwm_row_key;
        mov r11, 0xC0FFEE09;
        cmp rax, r11;
        jne wwmw_fail_stage;

        mov rdi, 0;
        call wwm_row_device;
        cmp rax, 42;
        jne wwmw_fail_stage;

        mov rdi, 0;
        call wwm_row_vendor;
        mov r11, 0x8086;
        cmp rax, r11;
        jne wwmw_fail_stage;

        mov rdi, 0;
        call wwm_row_product;
        mov r11, 0x7360;
        cmp rax, r11;
        jne wwmw_fail_stage;

        mov rdi, 0;
        call wwm_row_form;
        cmp rax, 1;
        jne wwmw_fail_stage;

        mov rdi, 0;
        call wwm_row_pwr;
        cmp rax, 0;
        jne wwmw_fail_stage;

        // -- 12. IN_USE (duplicate modem_key).
        mov rax, 12;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 45;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE09;             // duplicate
        mov r8, r15;
        mov r9, r14;
        call wwan_modem_cap_mint_inner;
        mov r11, 0xFFFFF1C5;
        cmp rax, r11;
        jne wwmw_fail_stage;

        // -- 13. Revoke round-trip.
        mov rax, 13;
        lea rcx, [rip + _wwmw_stage];
        mov [rcx], rax;

        mov rdi, 43;
        call wwan_modem_cap_revoke_inner;
        cmp rax, 0;
        jne wwmw_fail_stage;

        mov rdi, 43;
        mov rsi, 41;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE09;             // key free after revoke
        mov r8, r15;
        mov r9, r14;
        call wwan_modem_cap_mint_inner;
        cmp rax, 0;
        jne wwmw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wwmw_ok];
        call klog_s1;

        call wwmw_scrub;
        call wwmw_clear;
        xor rax, rax;
        jmp wwmw_out;

      wwmw_fail_stage:
        lea rax, [rip + _wwmw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wwmw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wwmw_scrub;
        call wwmw_clear;
        mov rax, 1;

      wwmw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
