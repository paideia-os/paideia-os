// tests/kernel/cap/bt_hci_channel_synth.pdx — R39.M1-003 (#1325)
//
// Boot witness for KIND_BT_HCI_CHANNEL.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, direction / packet-
// type validators, adapter presence gate, rights subset refuse,
// uniqueness on chan_key, mint / revoke round-trip.
//
// Fingerprint: R39 KIND_BT_HCI_CHANNEL OK
//
// Cap slots 128..143.

module BtHciChanCapSynth = structure {

  pub let mut _kbhcw_stage : u64 = 0

  pub let kbhcw_ok   : [u8; 28] = "R39 KIND_BT_HCI_CHANNEL OK\n\0"
  pub let kbhcw_fail : [u8; 30] = "R39 KIND_BT_HCI_CHANNEL FAIL\n\0"

  pub let kbhcw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-003 (#1325): clear cap_table slots 128..143.",
      block: {
        push rbx;
        mov rbx, 128;
      kbhcwc_loop:
        cmp rbx, 144;
        jae kbhcwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp kbhcwc_loop;
      kbhcwc_done:
        pop rbx;
        ret
      }
    }

  pub let kbhcw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): reset BT HCI CHANNEL row table + BT ADAPTER row table.",
      block: {
        call bt_hci_chan_table_reset;
        call bt_adapter_table_reset;
        ret
      }
    }

  pub let kbhcw_seed_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-003 (#1325): synthetic KIND_IPC_ENDPOINT at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let kbhcw_seed_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-003 (#1325): synthetic KIND_DEVICE at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let bt_hci_chan_cap_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R39.M1-003 (#1325): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_ADAPTER (empty). (4) BAD_DIR (> 1). (5) BAD_PKT (0). (6) RESERVED_ZERO. (7) BAD_RIGHTS. (8) Happy path. (9) Query fields. (10) IN_USE. (11) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _kbhcw_stage];
        mov [rcx], rax;

        call kbhcw_clear;
        call kbhcw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call kbhc_dir_valid;
        cmp rax, 1;
        jne kbhcw_fail_stage;
        mov rdi, 1;
        call kbhc_dir_valid;
        cmp rax, 1;
        jne kbhcw_fail_stage;
        mov rdi, 2;
        call kbhc_dir_valid;
        cmp rax, 0;
        jne kbhcw_fail_stage;

        // pkt valid
        mov rdi, 0;
        call kbhc_pkt_valid;
        cmp rax, 0;
        jne kbhcw_fail_stage;
        mov rdi, 1;
        call kbhc_pkt_valid;
        cmp rax, 1;
        jne kbhcw_fail_stage;
        mov rdi, 4;
        call kbhc_pkt_valid;
        cmp rax, 1;
        jne kbhcw_fail_stage;
        mov rdi, 5;
        call kbhc_pkt_valid;
        cmp rax, 0;
        jne kbhcw_fail_stage;

        // rights_valid: R_MINT outside mask
        mov rdi, 0x200;
        call kbhc_rights_valid;
        cmp rax, 0;
        jne kbhcw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at slot 129, KIND_DEVICE at slot 130,
        // then mint a KIND_BT_ADAPTER at slot 131.
        mov rdi, 129;
        mov rsi, 0x200;
        mov rdx, 0x0100;
        call kbhcw_seed_endpoint;

        mov rdi, 130;
        mov rsi, 0x200;                  // R_MINT
        mov rdx, 0x0042;
        call kbhcw_seed_device;

        // Mint adapter at slot 131 over device 130.
        mov rdi, 131;
        mov rsi, 130;
        mov rdx, 0x419;
        mov rcx, 0xAD5CAFE;
        mov r8, 0x000D000180860071;      // vendor=0x8086 iface=1 hci_ver=13
        call bt_adapter_cap_mint_inner;
        cmp rax, 0;
        jne kbhcw_fail_stage;

        // packed_dp = direction[7:0] | packet_type[15:8].
        // dir=0 (H2C), pkt=1 (CMD) -> 0x0100.
        mov r15, 0x0100;

        // -- 2. BAD_PARENT (parent slot empty).
        mov rax, 2;
        lea rcx, [rip + _kbhcw_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 128;                    // empty parent
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE01;
        mov r8, 131;                     // adapter_slot
        mov r9, r15;
        call bt_hci_chan_cap_mint_inner;
        mov r11, 0xFFFFF13D;             // MINT_BAD_PARENT
        cmp rax, r11;
        jne kbhcw_fail_stage;

        // -- 3. BAD_ADAPTER (empty adapter_slot).
        mov rax, 3;
        lea rcx, [rip + _kbhcw_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 129;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE02;
        mov r8, 128;                     // empty adapter
        mov r9, r15;
        call bt_hci_chan_cap_mint_inner;
        mov r11, 0xFFFFF13B;             // MINT_BAD_ADAPTER
        cmp rax, r11;
        jne kbhcw_fail_stage;

        // -- 4. BAD_DIR (direction=2).
        mov rax, 4;
        lea rcx, [rip + _kbhcw_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 129;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE03;
        mov r8, 131;
        mov r9, 0x0102;                  // dir=2 pkt=1
        call bt_hci_chan_cap_mint_inner;
        mov r11, 0xFFFFF13A;             // MINT_BAD_DIR
        cmp rax, r11;
        jne kbhcw_fail_stage;

        // -- 5. BAD_PKT (packet_type=0).
        mov rax, 5;
        lea rcx, [rip + _kbhcw_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 129;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE04;
        mov r8, 131;
        mov r9, 0x0000;                  // dir=0 pkt=0
        call bt_hci_chan_cap_mint_inner;
        mov r11, 0xFFFFF139;             // MINT_BAD_PKT
        cmp rax, r11;
        jne kbhcw_fail_stage;

        // -- 6. RESERVED_ZERO ([63:16] set).
        mov rax, 6;
        lea rcx, [rip + _kbhcw_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 129;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE05;
        mov r8, 131;
        mov r9, 0x0000000000010100;      // reserved bit set
        call bt_hci_chan_cap_mint_inner;
        mov r11, 0xFFFFF132;             // RESERVED_ZERO
        cmp rax, r11;
        jne kbhcw_fail_stage;

        // -- 7. BAD_RIGHTS.
        mov rax, 7;
        lea rcx, [rip + _kbhcw_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 129;
        mov rdx, 0x81B;                  // 0x800 outside 0x41B
        mov rcx, 0xC0FFEE06;
        mov r8, 131;
        mov r9, r15;
        call bt_hci_chan_cap_mint_inner;
        mov r11, 0xFFFFF13C;             // MINT_BAD_RIGHTS
        cmp rax, r11;
        jne kbhcw_fail_stage;

        // -- 8. Happy path.
        mov rax, 8;
        lea rcx, [rip + _kbhcw_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 129;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE07;
        mov r8, 131;
        mov r9, r15;
        call bt_hci_chan_cap_mint_inner;
        cmp rax, 0;
        jne kbhcw_fail_stage;

        // -- 9. Query fields.
        mov rax, 9;
        lea rcx, [rip + _kbhcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call kbhc_row_key;
        mov r11, 0xC0FFEE07;
        cmp rax, r11;
        jne kbhcw_fail_stage;

        mov rdi, 0;
        call kbhc_row_endpoint;
        cmp rax, 129;
        jne kbhcw_fail_stage;

        mov rdi, 0;
        call kbhc_row_adapter;
        cmp rax, 131;
        jne kbhcw_fail_stage;

        mov rdi, 0;
        call kbhc_row_dir;
        cmp rax, 0;                      // H2C
        jne kbhcw_fail_stage;

        mov rdi, 0;
        call kbhc_row_pkt;
        cmp rax, 1;                      // CMD
        jne kbhcw_fail_stage;

        // -- 10. IN_USE (duplicate chan_key).
        mov rax, 10;
        lea rcx, [rip + _kbhcw_stage];
        mov [rcx], rax;

        mov rdi, 133;
        mov rsi, 129;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE07;             // same key
        mov r8, 131;
        mov r9, r15;
        call bt_hci_chan_cap_mint_inner;
        mov r11, 0xFFFFF136;             // MINT_IN_USE
        cmp rax, r11;
        jne kbhcw_fail_stage;

        // -- 11. Revoke round-trip.
        mov rax, 11;
        lea rcx, [rip + _kbhcw_stage];
        mov [rcx], rax;

        mov rdi, 132;
        call bt_hci_chan_cap_revoke_inner;
        cmp rax, 0;
        jne kbhcw_fail_stage;

        mov rdi, 132;
        mov rsi, 129;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE07;             // key free after revoke
        mov r8, 131;
        mov r9, r15;
        call bt_hci_chan_cap_mint_inner;
        cmp rax, 0;
        jne kbhcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kbhcw_ok];
        call klog_s1;

        call kbhcw_scrub;
        call kbhcw_clear;
        xor rax, rax;
        jmp kbhcw_out;

      kbhcw_fail_stage:
        lea rax, [rip + _kbhcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kbhcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call kbhcw_scrub;
        call kbhcw_clear;
        mov rax, 1;

      kbhcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
