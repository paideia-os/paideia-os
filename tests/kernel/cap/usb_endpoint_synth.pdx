// tests/kernel/cap/usb_endpoint_synth.pdx — R34.M2-004 (#1175)
//
// Boot witness for KIND_USB_ENDPOINT.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT + KIND_USB_INTERFACE,
// ep_num / ep_type / dir / max_packet refusals, uniqueness, mint /
// revoke round-trip.
//
// Fingerprint: R34 KIND_USB_ENDPOINT OK
//
// Cap slots 140..147. NOT a fresh block: cap_table is exactly 256
// descriptors (0..255 — see cap/table.pdx, verify-cap-stride.sh), and
// by R34.M1 close every slot through 255 was already claimed by an
// earlier witness (usb_interface_witness itself ends at 199; ec_query
// owns 200..211; thermal_zone/battery/battery_monitor/cooling_device
// run through 255). The ORIGINAL R34.M2 draft used 256..263, which
// silently exceeds the table — usb_endpoint_cap_mint_inner's own
// `cmp slot, 256 / jae bad_slot` check refuses slot 256, so the
// "happy path" stage would have hit BAD_SLOT instead of success and
// printed FAIL, not OK. Fixed by reusing sensor_hub_witness's block
// (140..147, tests/kernel/cap/sensor_channel_synth.pdx /
// r30_platform.pdx R32.M5): that witness runs once, early, scrubs on
// both exits, and nothing between it and this one touches 140..147,
// so the reuse is safe despite not being a virgin range.

module UsbEndpointSynth = structure {

  pub let mut _usbep_w_stage : u64 = 0

  pub let usbep_w_ok   : [u8; 27] = "R34 KIND_USB_ENDPOINT OK\n\0\0"
  pub let usbep_w_fail : [u8; 29] = "R34 KIND_USB_ENDPOINT FAIL\n\0\0"

  pub let usbep_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-004 (#1175): clear cap_table slots 140..147. Labels prefixed usbeps_wc_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 140;
      usbeps_wc_loop:
        cmp rbx, 148;
        jae usbeps_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp usbeps_wc_loop;
      usbeps_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usbep_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): reset USB endpoint + interface + device row tables.",
      block: {
        push rbx;
        call usb_endpoint_table_reset;
        call usb_interface_table_reset;
        call usb_device_table_reset;
        pop rbx;
        ret
      }
    }

  pub let usbep_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-004 (#1175): synthetic KIND_DEVICE.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let usbep_w_endpoint_ipc : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (endpoint_id: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-004 (#1175): synthetic KIND_IPC_ENDPOINT with endpoint_id in target_ptr[15:0].",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r14;
        mov rcx, r13;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let usb_endpoint_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R34.M2-004 (#1175): boot witness. Stages: (1) validators. (2) BAD_PARENT on non-IPC_ENDPOINT parent. (3) BAD_INTERFACE on non-USB_INTERFACE arg. (4) Happy path. (5) query fields. (6) IN_USE on duplicate key. (7) BAD_EPNUM (16). (8) BAD_EPTYPE (4). (9) BAD_DIR (2). (10) BAD_MAXPACKET (0 and 1025). (11) revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _usbep_w_stage];
        mov [rcx], rax;

        call usbep_w_clear;
        call usbep_w_scrub;

        // -- 1. Validators.
        xor rdi, rdi;
        call usb_endpoint_epnum_valid;
        cmp rax, 1;
        jne usbep_w_fail_stage;
        mov rdi, 15;
        call usb_endpoint_epnum_valid;
        cmp rax, 1;
        jne usbep_w_fail_stage;
        mov rdi, 16;
        call usb_endpoint_epnum_valid;
        cmp rax, 0;
        jne usbep_w_fail_stage;

        mov rdi, 3;
        call usb_endpoint_eptype_valid;
        cmp rax, 1;
        jne usbep_w_fail_stage;
        mov rdi, 4;
        call usb_endpoint_eptype_valid;
        cmp rax, 0;
        jne usbep_w_fail_stage;

        mov rdi, 1;
        call usb_endpoint_dir_valid;
        cmp rax, 1;
        jne usbep_w_fail_stage;
        mov rdi, 2;
        call usb_endpoint_dir_valid;
        cmp rax, 0;
        jne usbep_w_fail_stage;

        mov rdi, 1;
        call usb_endpoint_maxpacket_valid;
        cmp rax, 1;
        jne usbep_w_fail_stage;
        mov rdi, 1024;
        call usb_endpoint_maxpacket_valid;
        cmp rax, 1;
        jne usbep_w_fail_stage;
        xor rdi, rdi;
        call usb_endpoint_maxpacket_valid;
        cmp rax, 0;
        jne usbep_w_fail_stage;
        mov rdi, 1025;
        call usb_endpoint_maxpacket_valid;
        cmp rax, 0;
        jne usbep_w_fail_stage;

        // -- Setup: mint the base chain (KIND_DEVICE / USB_DEVICE /
        // USB_INTERFACE / IPC_ENDPOINT). Slots: 141, 142, 143, 144.
        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _usbep_w_stage];
        mov [rcx], rax;

        mov rdi, 141;
        mov rsi, 0xDEADBABE;
        mov rdx, 0x200;
        call usbep_w_device;

        mov rdi, 142;
        mov rsi, 141;
        mov rdx, 0x619;
        mov rcx, 7;
        mov r8, 3;
        call usb_device_cap_mint_inner;
        cmp rax, 0;
        jne usbep_w_fail_stage;

        mov rdi, 143;
        mov rsi, 142;
        mov rdx, 0x619;
        mov rcx, 0xC0FFEE99;
        mov r8, 0x0001;                  // ifnum=1, alt=0
        mov r9, 0x20103;
        call usb_interface_cap_mint_inner;
        cmp rax, 0;
        jne usbep_w_fail_stage;

        // Bad parent: use KIND_DEVICE (141) as parent (not IPC_ENDPOINT).
        // packed_ep = ep_num=1 | ep_type=2 (BULK) << 8 | dir=1 (IN) << 16 | max=512 << 32
        // = 1 | 0x200 | 0x10000 | (512 << 32)
        mov r10, 512;
        shl r10, 32;
        mov r11, 1;
        or  r10, r11;
        mov r11, 0x200;
        or  r10, r11;
        mov r11, 0x10000;
        or  r10, r11;
        // r10 now holds packed_ep.

        mov rdi, 140;
        mov rsi, 141;                    // parent = KIND_DEVICE, wrong
        mov rdx, 143;                    // interface_slot
        mov rcx, 0x419;
        mov r8, 0xFACEC0DE;              // endpoint_key
        mov r9, r10;                     // packed_ep
        call usb_endpoint_cap_mint_inner;
        mov r11, 0xFFFFFBCD;             // BAD_PARENT
        cmp rax, r11;
        jne usbep_w_fail_stage;

        // -- 3. BAD_INTERFACE.
        mov rax, 3;
        lea rcx, [rip + _usbep_w_stage];
        mov [rcx], rax;

        // Mint an IPC_ENDPOINT at slot 144.
        mov rdi, 144;
        mov rsi, 42;                     // endpoint_id
        mov rdx, 0x200;                  // RIGHT_MINT
        call usbep_w_endpoint_ipc;

        // r10 was clobbered; rebuild packed_ep.
        mov r10, 512;
        shl r10, 32;
        mov r11, 1;
        or  r10, r11;
        mov r11, 0x200;
        or  r10, r11;
        mov r11, 0x10000;
        or  r10, r11;

        mov rdi, 140;
        mov rsi, 144;                    // IPC_ENDPOINT parent (correct)
        mov rdx, 141;                    // interface_slot = KIND_DEVICE (wrong)
        mov rcx, 0x419;
        mov r8, 0xFACEC0DE;
        mov r9, r10;
        call usb_endpoint_cap_mint_inner;
        mov r11, 0xFFFFFBC7;             // BAD_INTERFACE
        cmp rax, r11;
        jne usbep_w_fail_stage;

        // -- 4. Happy path.
        mov rax, 4;
        lea rcx, [rip + _usbep_w_stage];
        mov [rcx], rax;

        mov r10, 512;
        shl r10, 32;
        mov r11, 1;
        or  r10, r11;
        mov r11, 0x200;
        or  r10, r11;
        mov r11, 0x10000;
        or  r10, r11;

        mov rdi, 140;
        mov rsi, 144;                    // IPC_ENDPOINT
        mov rdx, 143;                    // USB_INTERFACE
        mov rcx, 0x419;
        mov r8, 0xFACEC0DE;
        mov r9, r10;
        call usb_endpoint_cap_mint_inner;
        cmp rax, 0;
        jne usbep_w_fail_stage;

        // -- 5. Query fields.
        mov rax, 5;
        lea rcx, [rip + _usbep_w_stage];
        mov [rcx], rax;

        mov rdi, 140;
        call usb_endpoint_epnum_of_slot;
        cmp rax, 1;
        jne usbep_w_fail_stage;

        mov rdi, 140;
        call usb_endpoint_eptype_of_slot;
        cmp rax, 2;
        jne usbep_w_fail_stage;

        mov rdi, 140;
        call usb_endpoint_dir_of_slot;
        cmp rax, 1;
        jne usbep_w_fail_stage;

        mov rdi, 140;
        call usb_endpoint_maxpacket_of_slot;
        cmp rax, 512;
        jne usbep_w_fail_stage;

        mov rdi, 140;
        call usb_endpoint_interface_of_slot;
        cmp rax, 143;
        jne usbep_w_fail_stage;

        mov rdi, 140;
        call usb_endpoint_key_of_slot;
        mov r11, 0xFACEC0DE;
        cmp rax, r11;
        jne usbep_w_fail_stage;

        // -- 6. IN_USE on duplicate key.
        mov rax, 6;
        lea rcx, [rip + _usbep_w_stage];
        mov [rcx], rax;

        mov r10, 512;
        shl r10, 32;
        mov r11, 2;
        or  r10, r11;
        mov r11, 0x200;
        or  r10, r11;

        mov rdi, 145;
        mov rsi, 144;
        mov rdx, 143;
        mov rcx, 0x419;
        mov r8, 0xFACEC0DE;              // duplicate key
        mov r9, r10;
        call usb_endpoint_cap_mint_inner;
        mov r11, 0xFFFFFBC4;             // IN_USE
        cmp rax, r11;
        jne usbep_w_fail_stage;

        // -- 7. BAD_EPNUM at 16.
        mov rax, 7;
        lea rcx, [rip + _usbep_w_stage];
        mov [rcx], rax;

        mov r10, 512;
        shl r10, 32;
        mov r11, 16;                     // ep_num = 16
        or  r10, r11;
        mov r11, 0x200;
        or  r10, r11;

        mov rdi, 145;
        mov rsi, 144;
        mov rdx, 143;
        mov rcx, 0x419;
        mov r8, 0xC0DEBABE;
        mov r9, r10;
        call usb_endpoint_cap_mint_inner;
        mov r11, 0xFFFFFBCB;             // BAD_EPNUM
        cmp rax, r11;
        jne usbep_w_fail_stage;

        // -- 8. BAD_EPTYPE at 4.
        mov rax, 8;
        lea rcx, [rip + _usbep_w_stage];
        mov [rcx], rax;

        mov r10, 512;
        shl r10, 32;
        mov r11, 1;
        or  r10, r11;
        mov r11, 0x400;                  // ep_type = 4
        or  r10, r11;

        mov rdi, 145;
        mov rsi, 144;
        mov rdx, 143;
        mov rcx, 0x419;
        mov r8, 0xC0DEBABE;
        mov r9, r10;
        call usb_endpoint_cap_mint_inner;
        mov r11, 0xFFFFFBCA;             // BAD_EPTYPE
        cmp rax, r11;
        jne usbep_w_fail_stage;

        // -- 9. BAD_DIR at 2.
        mov rax, 9;
        lea rcx, [rip + _usbep_w_stage];
        mov [rcx], rax;

        mov r10, 512;
        shl r10, 32;
        mov r11, 1;
        or  r10, r11;
        mov r11, 0x200;
        or  r10, r11;
        mov r11, 0x20000;                // dir = 2
        or  r10, r11;

        mov rdi, 145;
        mov rsi, 144;
        mov rdx, 143;
        mov rcx, 0x419;
        mov r8, 0xC0DEBABE;
        mov r9, r10;
        call usb_endpoint_cap_mint_inner;
        mov r11, 0xFFFFFBC9;             // BAD_DIR
        cmp rax, r11;
        jne usbep_w_fail_stage;

        // -- 10. BAD_MAXPACKET at 0 and 1025.
        mov rax, 10;
        lea rcx, [rip + _usbep_w_stage];
        mov [rcx], rax;

        // max = 0
        xor r10, r10;
        mov r11, 1;
        or  r10, r11;
        mov r11, 0x200;
        or  r10, r11;

        mov rdi, 145;
        mov rsi, 144;
        mov rdx, 143;
        mov rcx, 0x419;
        mov r8, 0xC0DEBABE;
        mov r9, r10;
        call usb_endpoint_cap_mint_inner;
        mov r11, 0xFFFFFBC8;             // BAD_MAXPACKET
        cmp rax, r11;
        jne usbep_w_fail_stage;

        // max = 1025
        mov r10, 1025;
        shl r10, 32;
        mov r11, 1;
        or  r10, r11;
        mov r11, 0x200;
        or  r10, r11;

        mov rdi, 145;
        mov rsi, 144;
        mov rdx, 143;
        mov rcx, 0x419;
        mov r8, 0xC0DEBABE;
        mov r9, r10;
        call usb_endpoint_cap_mint_inner;
        mov r11, 0xFFFFFBC8;
        cmp rax, r11;
        jne usbep_w_fail_stage;

        // -- 11. Revoke round-trip.
        mov rax, 11;
        lea rcx, [rip + _usbep_w_stage];
        mov [rcx], rax;

        mov rdi, 140;
        call usb_endpoint_cap_revoke_inner;
        cmp rax, 0;
        jne usbep_w_fail_stage;

        mov r10, 512;
        shl r10, 32;
        mov r11, 1;
        or  r10, r11;
        mov r11, 0x200;
        or  r10, r11;
        mov r11, 0x10000;
        or  r10, r11;

        mov rdi, 140;
        mov rsi, 144;
        mov rdx, 143;
        mov rcx, 0x419;
        mov r8, 0xFACEC0DE;
        mov r9, r10;
        call usb_endpoint_cap_mint_inner;
        cmp rax, 0;
        jne usbep_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + usbep_w_ok];
        call klog_s1;

        call usbep_w_scrub;
        call usbep_w_clear;
        xor rax, rax;
        jmp usbep_w_out;

      usbep_w_fail_stage:
        lea rax, [rip + _usbep_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + usbep_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call usbep_w_scrub;
        call usbep_w_clear;
        mov rax, 1;

      usbep_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
