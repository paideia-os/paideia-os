// tests/kernel/cap/dma_attestation_synth.pdx — R35.M4-001 (#1210)
//
// Boot witness for KIND_DMA_ATTESTATION.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, dock / domain /
// hash / state refusals, uniqueness on attest_key, endpoint_slot
// second-cap gate, mint / revoke round-trip, and the monotone
// consent-state transitions (PENDING -> GRANTED, PENDING -> REVOKED,
// but NOT GRANTED -> PENDING, NOT REVOKED -> GRANTED).
//
// Fingerprint: R35 KIND_DMA_ATTESTATION OK
//
// Cap slots 240..247 — a fresh range, disjoint from every prior
// witness's set (tb_route_synth 216..231, route_teardown_synth
// 232..239). Every exit path scrubs the range so nothing bleeds
// into later witnesses.

module DmaAttestationSynth = structure {

  pub let mut _daaw_stage : u64 = 0

  pub let daaw_ok   : [u8; 24] = "KIND_DMA_ATTESTATION OK\n\0"
  pub let daaw_fail : [u8; 26] = "KIND_DMA_ATTESTATION FAIL\n\0"

  pub let daaw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-001 (#1210): clear cap_table slots 240..247.",
      block: {
        push rbx;
        mov rbx, 240;
      daawc_loop:
        cmp rbx, 248;
        jae daawc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp daawc_loop;
      daawc_done:
        pop rbx;
        ret
      }
    }

  pub let daaw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): reset DMA ATTEST row table.",
      block: {
        push rbx;
        call dma_attest_table_reset;
        pop rbx;
        ret
      }
    }

  pub let daaw_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-001 (#1210): synthetic KIND_IPC_ENDPOINT.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let dma_attestation_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R35.M4-001 (#1210): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_ENDPOINT. (4) Happy path. (5) Query fields. (6) IN_USE on duplicate key. (7) BAD_DOCK (dock=0). (8) BAD_HASH (hash=0). (9) Monotone transitions: PENDING -> GRANTED. (10) GRANTED -> GRANTED refused. (11) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _daaw_stage];
        mov [rcx], rax;

        call daaw_clear;
        call daaw_scrub;

        // -- 1. Validators.
        mov rdi, 1;
        call dma_attest_dock_valid;
        cmp rax, 1;
        jne daaw_fail_stage;
        mov rdi, 0;
        call dma_attest_dock_valid;
        cmp rax, 0;
        jne daaw_fail_stage;
        mov rdi, 0x10000;
        call dma_attest_dock_valid;
        cmp rax, 0;
        jne daaw_fail_stage;

        mov rdi, 0;
        call dma_attest_domain_valid;
        cmp rax, 1;                      // domain=0 is legal
        jne daaw_fail_stage;
        mov rdi, 0x10000;
        call dma_attest_domain_valid;
        cmp rax, 0;
        jne daaw_fail_stage;

        mov rdi, 2;
        call dma_attest_state_valid;
        cmp rax, 1;
        jne daaw_fail_stage;
        mov rdi, 3;
        call dma_attest_state_valid;
        cmp rax, 0;
        jne daaw_fail_stage;

        mov rdi, 1;
        call dma_attest_hash_valid;
        cmp rax, 1;
        jne daaw_fail_stage;
        mov rdi, 0;
        call dma_attest_hash_valid;
        cmp rax, 0;
        jne daaw_fail_stage;
        mov rdi, 0x100000000;
        call dma_attest_hash_valid;
        cmp rax, 0;
        jne daaw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT with RIGHT_MINT at slots 241, 242.
        mov rdi, 241;
        mov rsi, 0x200;
        mov rdx, 0x2222;
        call daaw_endpoint;

        mov rdi, 242;
        mov rsi, 0x200;
        mov rdx, 0x3333;
        call daaw_endpoint;

        // -- 2. BAD_PARENT (parent slot 240 empty).
        mov rax, 2;
        lea rcx, [rip + _daaw_stage];
        mov [rcx], rax;

        // packed_ident: dock=0x21, domain=0x05, hash=0xDEADBEEF
        //   [15:0]  dock_id
        //   [31:16] iommu_domain_id
        //   [63:32] attestation_hash
        mov r10, 0x0021;
        mov r11, 0x0005;
        shl r11, 16;
        or  r10, r11;
        mov r11, 0xDEADBEEF;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 244;                    // slot
        mov rsi, 240;                    // parent = empty
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABE;             // attest_key
        mov r8, 242;                     // endpoint_slot
        mov r9, r10;
        call dma_attest_cap_mint_inner;
        mov r11, 0xFFFFF95D;             // BAD_PARENT
        cmp rax, r11;
        jne daaw_fail_stage;

        // -- 3. BAD_ENDPOINT (endpoint_slot 240 empty).
        mov rax, 3;
        lea rcx, [rip + _daaw_stage];
        mov [rcx], rax;

        mov r10, 0x0021;
        mov r11, 0x0005;
        shl r11, 16;
        or  r10, r11;
        mov r11, 0xDEADBEEF;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 244;
        mov rsi, 241;                    // parent live
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABE;
        mov r8, 240;                     // endpoint_slot empty
        mov r9, r10;
        call dma_attest_cap_mint_inner;
        mov r11, 0xFFFFF957;             // BAD_ENDPOINT
        cmp rax, r11;
        jne daaw_fail_stage;

        // -- 4. Happy path.
        mov rax, 4;
        lea rcx, [rip + _daaw_stage];
        mov [rcx], rax;

        mov r10, 0x0021;
        mov r11, 0x0005;
        shl r11, 16;
        or  r10, r11;
        mov r11, 0xDEADBEEF;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 244;
        mov rsi, 241;
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABE;
        mov r8, 242;
        mov r9, r10;
        call dma_attest_cap_mint_inner;
        cmp rax, 0;
        jne daaw_fail_stage;

        // -- 5. Query fields via slot accessors.
        mov rax, 5;
        lea rcx, [rip + _daaw_stage];
        mov [rcx], rax;

        // Resolve slot -> row, then check state == PENDING.
        mov rdi, 244;
        call dma_attest_row_of_slot;
        mov r15, rax;
        cmp r15, 0xFF;
        je  daaw_fail_stage;

        mov rdi, r15;
        call dma_attest_row_state;
        cmp rax, 0;                      // PENDING
        jne daaw_fail_stage;

        mov rdi, r15;
        call dma_attest_row_dock;
        cmp rax, 0x0021;
        jne daaw_fail_stage;

        mov rdi, r15;
        call dma_attest_row_domain;
        cmp rax, 0x0005;
        jne daaw_fail_stage;

        mov rdi, r15;
        call dma_attest_row_hash;
        mov r11, 0xDEADBEEF;
        cmp rax, r11;
        jne daaw_fail_stage;

        // -- 6. IN_USE on duplicate key.
        mov rax, 6;
        lea rcx, [rip + _daaw_stage];
        mov [rcx], rax;

        mov r10, 0x0022;
        mov r11, 0x0006;
        shl r11, 16;
        or  r10, r11;
        mov r11, 0xC0FFEE01;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 245;
        mov rsi, 241;
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABE;             // duplicate
        mov r8, 242;
        mov r9, r10;
        call dma_attest_cap_mint_inner;
        mov r11, 0xFFFFF954;             // IN_USE
        cmp rax, r11;
        jne daaw_fail_stage;

        // -- 7. BAD_DOCK (dock=0).
        mov rax, 7;
        lea rcx, [rip + _daaw_stage];
        mov [rcx], rax;

        mov r10, 0;                      // dock=0 refused
        mov r11, 0x0006;
        shl r11, 16;
        or  r10, r11;
        mov r11, 0xC0FFEE02;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 245;
        mov rsi, 241;
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABF;
        mov r8, 242;
        mov r9, r10;
        call dma_attest_cap_mint_inner;
        mov r11, 0xFFFFF95B;             // BAD_DOCK
        cmp rax, r11;
        jne daaw_fail_stage;

        // -- 8. BAD_HASH (hash=0).
        mov rax, 8;
        lea rcx, [rip + _daaw_stage];
        mov [rcx], rax;

        mov r10, 0x0022;
        mov r11, 0x0006;
        shl r11, 16;
        or  r10, r11;
        // hash=0

        mov rdi, 245;
        mov rsi, 241;
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABF;
        mov r8, 242;
        mov r9, r10;
        call dma_attest_cap_mint_inner;
        mov r11, 0xFFFFF958;             // BAD_HASH
        cmp rax, r11;
        jne daaw_fail_stage;

        // -- 9. Monotone PENDING -> GRANTED.
        mov rax, 9;
        lea rcx, [rip + _daaw_stage];
        mov [rcx], rax;

        mov rdi, 244;
        call dma_attest_row_of_slot;
        mov r15, rax;
        cmp r15, 0xFF;
        je  daaw_fail_stage;

        mov rdi, r15;
        call dma_attest_row_set_granted;
        cmp rax, 0;
        jne daaw_fail_stage;

        mov rdi, r15;
        call dma_attest_row_state;
        cmp rax, 1;                      // GRANTED
        jne daaw_fail_stage;

        // -- 10. GRANTED -> GRANTED refused (BAD_TRANSITION).
        mov rax, 10;
        lea rcx, [rip + _daaw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        call dma_attest_row_set_granted;
        mov r11, 0xFFFFF950;             // BAD_TRANSITION
        cmp rax, r11;
        jne daaw_fail_stage;

        // -- 11. Revoke round-trip.
        mov rax, 11;
        lea rcx, [rip + _daaw_stage];
        mov [rcx], rax;

        mov rdi, 244;
        call dma_attest_cap_revoke_inner;
        cmp rax, 0;
        jne daaw_fail_stage;

        mov r10, 0x0021;
        mov r11, 0x0005;
        shl r11, 16;
        or  r10, r11;
        mov r11, 0xDEADBEEF;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 244;
        mov rsi, 241;
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABE;             // key free after revoke
        mov r8, 242;
        mov r9, r10;
        call dma_attest_cap_mint_inner;
        cmp rax, 0;
        jne daaw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + daaw_ok];
        call klog_s1;

        call daaw_scrub;
        call daaw_clear;
        xor rax, rax;
        jmp daaw_out;

      daaw_fail_stage:
        lea rax, [rip + _daaw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + daaw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call daaw_scrub;
        call daaw_clear;
        mov rax, 1;

      daaw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
