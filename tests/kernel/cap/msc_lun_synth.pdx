// tests/kernel/cap/msc_lun_synth.pdx — R34.M3-001 (#1176)
//
// Boot witness for KIND_MSC_LUN.
//
// Asserts derivation gate over KIND_USB_INTERFACE, lun_number
// refusals, uniqueness on lun_key, mint/revoke round-trip.
//
// Fingerprint: R34 KIND_MSC_LUN OK
//
// Cap slots 208..215. NOT a fresh block: cap_table is 256 descriptors
// (0..255). This range was chosen by grep of r30_platform.pdx's
// existing per-witness slot allotments: ec_query owns 200..211
// (scrubbed before this witness runs — see r30_platform placement),
// backlight owns 96..99, hotkey 100..103, so 208..215 is inside a
// range that ec_query has already released.
//
// Actually: ec_query's slot block ends at 211 and the range 212..215
// is unused. To be safe (avoid interleaving with ec_query's own
// audit-ring assertions), this witness uses 244..251 which was
// reused historically for battery_monitor -- long retired -- and is
// scrubbed by that witness on its way out. Same pattern used by
// usb_endpoint_synth.pdx.

module MscLunSynth = structure {

  pub let mut _msclun_w_stage : u64 = 0

  pub let msclun_w_ok   : [u8; 22] = "R34 KIND_MSC_LUN OK\n\0\0"
  pub let msclun_w_fail : [u8; 24] = "R34 KIND_MSC_LUN FAIL\n\0\0"

  pub let msclun_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): clear cap_table slots 244..251. Labels prefixed msclunw_wc_.",
      block: {
        push rbx;
        mov rbx, 244;
      msclunw_wc_loop:
        cmp rbx, 252;
        jae msclunw_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp msclunw_wc_loop;
      msclunw_wc_done:
        pop rbx;
        ret
      }
    }

  pub let msclun_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): reset MSC LUN + parent USB interface/device tables.",
      block: {
        push rbx;
        call msc_lun_table_reset;
        call usb_interface_table_reset;
        call usb_device_table_reset;
        pop rbx;
        ret
      }
    }

  pub let msclun_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): synthetic KIND_DEVICE.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let msc_lun_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R34.M3-001 (#1176): boot witness. Stages: (1) validators. (2) BAD_PARENT (non-interface parent). (3) Happy path. (4) Query fields. (5) IN_USE. (6) BAD_NUM (16). (7) revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _msclun_w_stage];
        mov [rcx], rax;

        call msclun_w_clear;
        call msclun_w_scrub;

        // -- 1. Validators.
        xor rdi, rdi;
        call msc_lun_num_valid;
        cmp rax, 1;
        jne msclun_w_fail_stage;
        mov rdi, 15;
        call msc_lun_num_valid;
        cmp rax, 1;
        jne msclun_w_fail_stage;
        mov rdi, 16;
        call msc_lun_num_valid;
        cmp rax, 0;
        jne msclun_w_fail_stage;

        // Setup chain: KIND_DEVICE(244) -> USB_DEVICE(245) -> USB_INTERFACE(246).
        mov rdi, 244;
        mov rsi, 0xDEADBABE;
        mov rdx, 0x200;
        call msclun_w_device;

        mov rdi, 245;
        mov rsi, 244;
        mov rdx, 0x619;
        mov rcx, 7;
        mov r8, 3;
        call usb_device_cap_mint_inner;
        cmp rax, 0;
        jne msclun_w_fail_stage;

        mov rdi, 246;
        mov rsi, 245;
        mov rdx, 0x619;
        mov rcx, 0xC0FFEEAA;
        mov r8, 0x0001;                  // ifnum=1 alt=0
        mov r9, 0x080650;                // class=0x08 subclass=0x06 protocol=0x50
        call usb_interface_cap_mint_inner;
        cmp rax, 0;
        jne msclun_w_fail_stage;

        // -- 2. BAD_PARENT (using KIND_DEVICE as parent).
        mov rax, 2;
        lea rcx, [rip + _msclun_w_stage];
        mov [rcx], rax;

        mov rdi, 247;
        mov rsi, 244;                    // parent = KIND_DEVICE, wrong
        mov rdx, 0x619;
        mov rcx, 0x1234;
        mov r8, 0;
        call msc_lun_cap_mint_inner;
        mov r11, 0xFFFFFBAD;             // BAD_PARENT
        cmp rax, r11;
        jne msclun_w_fail_stage;

        // -- 3. Happy path.
        mov rax, 3;
        lea rcx, [rip + _msclun_w_stage];
        mov [rcx], rax;

        mov rdi, 247;
        mov rsi, 246;                    // USB_INTERFACE parent
        mov rdx, 0x619;
        mov rcx, 0xABCD1234;
        mov r8, 2;                       // lun 2
        call msc_lun_cap_mint_inner;
        cmp rax, 0;
        jne msclun_w_fail_stage;

        // -- 4. Query fields.
        mov rax, 4;
        lea rcx, [rip + _msclun_w_stage];
        mov [rcx], rax;

        mov rdi, 247;
        call msc_lun_num_of_slot;
        cmp rax, 2;
        jne msclun_w_fail_stage;

        mov rdi, 247;
        call msc_lun_key_of_slot;
        mov r11, 0xABCD1234;
        cmp rax, r11;
        jne msclun_w_fail_stage;

        // -- 5. IN_USE on duplicate key.
        mov rax, 5;
        lea rcx, [rip + _msclun_w_stage];
        mov [rcx], rax;

        mov rdi, 248;
        mov rsi, 246;
        mov rdx, 0x619;
        mov rcx, 0xABCD1234;             // duplicate
        mov r8, 3;
        call msc_lun_cap_mint_inner;
        mov r11, 0xFFFFFBA7;             // IN_USE
        cmp rax, r11;
        jne msclun_w_fail_stage;

        // -- 6. BAD_NUM at 16.
        mov rax, 6;
        lea rcx, [rip + _msclun_w_stage];
        mov [rcx], rax;

        mov rdi, 248;
        mov rsi, 246;
        mov rdx, 0x619;
        mov rcx, 0x55555555;
        mov r8, 16;
        call msc_lun_cap_mint_inner;
        mov r11, 0xFFFFFBAB;             // BAD_NUM
        cmp rax, r11;
        jne msclun_w_fail_stage;

        // -- 7. Revoke round-trip.
        mov rax, 7;
        lea rcx, [rip + _msclun_w_stage];
        mov [rcx], rax;

        mov rdi, 247;
        call msc_lun_cap_revoke_inner;
        cmp rax, 0;
        jne msclun_w_fail_stage;

        mov rdi, 247;
        mov rsi, 246;
        mov rdx, 0x619;
        mov rcx, 0xABCD1234;
        mov r8, 2;
        call msc_lun_cap_mint_inner;
        cmp rax, 0;
        jne msclun_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + msclun_w_ok];
        call klog_s1;

        call msclun_w_scrub;
        call msclun_w_clear;
        xor rax, rax;
        jmp msclun_w_out;

      msclun_w_fail_stage:
        lea rax, [rip + _msclun_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + msclun_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call msclun_w_scrub;
        call msclun_w_clear;
        mov rax, 1;

      msclun_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
