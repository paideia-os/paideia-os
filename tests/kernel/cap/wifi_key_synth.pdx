// tests/kernel/cap/wifi_key_synth.pdx — R38.M5-001 (#1309)
//
// Boot witness for KIND_WIFI_KEY (SEALED).
//
// SEALED TRIPLE-CHECK exercised:
//   gate 1: R_READ (0x001) is absent from R_WKEY_ALL (0x418) --
//           a mint carrying R_READ trips wkey_rights_valid.
//   gate 2: NO OP EXPOSES MATERIAL -- op set is enumerated and
//           the max is asserted (WKEY_OP_MAX == 7); op == 8 returns
//           UNSUPPORTED; the six query ops report identity/config
//           only, and BIND_TO_HW is a honesty pin.
//   gate 3: sealed_flag reads back as 1 on the live row.
//
// Fingerprint: R38 KIND_WIFI_KEY OK
//
// Cap slots 208..217 (remapped from 470..479 to fit CAP_SLOT_MAX=256).

module WifiKeySynth = structure {

  pub let mut _wkeyw_stage : u64 = 0

  pub let wkeyw_ok   : [u8; 18] = "KIND_WIFI_KEY OK\0"
  pub let wkeyw_fail : [u8; 20] = "KIND_WIFI_KEY FAIL\0"

  pub let wkeyw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M5-001 (#1309): clear cap_table slots 208..217.",
      block: {
        push rbx;
        mov rbx, 208;
      wkeywc_loop:
        cmp rbx, 218;
        jae wkeywc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp wkeywc_loop;
      wkeywc_done:
        pop rbx;
        ret
      }
    }

  pub let wkeyw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): reset WIFI KEY row table.",
      block: {
        call wifi_key_table_reset;
        ret
      }
    }

  pub let wkeyw_seed_memory : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M5-001 (#1309): synthetic KIND_MEMORY (=4) at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY (= KIND_PAGE)
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let wifi_key_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R38.M5-001 (#1309): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_MEMORY. (4) BAD_RIGHTS + SEALED gate 1: R_READ tripped. (5) BAD_ALGO. (6) BAD_KEY_ID. (7) BAD_LEN. (8) NO_KEY. (9) Happy path. (10) Query fields incl. sealed_flag==1 (SEALED gate 3). (11) IN_USE. (12) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        call wkeyw_clear;
        call wkeyw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call wkey_algo_valid;
        cmp rax, 1;
        jne wkeyw_fail_stage;
        mov rdi, 2;
        call wkey_algo_valid;
        cmp rax, 1;
        jne wkeyw_fail_stage;
        mov rdi, 3;
        call wkey_algo_valid;
        cmp rax, 0;
        jne wkeyw_fail_stage;

        mov rdi, 0;
        call wkey_key_id_valid;
        cmp rax, 1;
        jne wkeyw_fail_stage;
        mov rdi, 7;
        call wkey_key_id_valid;
        cmp rax, 1;
        jne wkeyw_fail_stage;
        mov rdi, 8;
        call wkey_key_id_valid;
        cmp rax, 0;
        jne wkeyw_fail_stage;

        mov rdi, 16;
        call wkey_len_valid;
        cmp rax, 1;
        jne wkeyw_fail_stage;
        mov rdi, 32;
        call wkey_len_valid;
        cmp rax, 1;
        jne wkeyw_fail_stage;
        mov rdi, 24;
        call wkey_len_valid;
        cmp rax, 0;
        jne wkeyw_fail_stage;

        // SEALED gate 1: R_READ bit is OUTSIDE R_WKEY_ALL.
        mov rdi, 0x001;
        call wkey_rights_valid;
        cmp rax, 0;
        jne wkeyw_fail_stage;

        // R_MINT bit is OUTSIDE R_WKEY_ALL too.
        mov rdi, 0x200;
        call wkey_rights_valid;
        cmp rax, 0;
        jne wkeyw_fail_stage;

        // Setup: KIND_MEMORY at 209 (parent) and 210 (memory_slot).
        mov rdi, 209;
        mov rsi, 0x200;                  // R_MINT so it can be a parent
        mov rdx, 0x0042;
        call wkeyw_seed_memory;

        mov rdi, 210;
        mov rsi, 0x11;
        mov rdx, 0x1000;
        call wkeyw_seed_memory;

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        // Pack meta: algo=0, key_id=4, sealed_len=16.
        mov rdi, 0;
        mov rsi, 4;
        mov rdx, 16;
        call wkey_meta_pack;
        mov r15, rax;                    // save meta

        mov rdi, 211;
        mov rsi, 208;                    // empty parent
        mov rdx, 0x418;
        mov rcx, 0xC0FFEEA0;
        mov r8,  210;
        mov r9,  r15;
        call wifi_key_cap_mint_inner;
        mov r11, 0xFFFFF3ED;             // BAD_PARENT
        cmp rax, r11;
        jne wkeyw_fail_stage;

        // -- 3. BAD_MEMORY.
        mov rax, 3;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        mov rdi, 211;
        mov rsi, 209;
        mov rdx, 0x418;
        mov rcx, 0xC0FFEEA1;
        mov r8,  213;                    // empty memory
        mov r9,  r15;
        call wifi_key_cap_mint_inner;
        mov r11, 0xFFFFF3EB;             // BAD_MEMORY
        cmp rax, r11;
        jne wkeyw_fail_stage;

        // -- 4. BAD_RIGHTS + SEALED gate 1: R_READ tripped.
        mov rax, 4;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        mov rdi, 211;
        mov rsi, 209;
        mov rdx, 0x419;                  // R_READ (0x001) tripped
        mov rcx, 0xC0FFEEA2;
        mov r8,  210;
        mov r9,  r15;
        call wifi_key_cap_mint_inner;
        mov r11, 0xFFFFF3EC;             // BAD_RIGHTS
        cmp rax, r11;
        jne wkeyw_fail_stage;

        // -- 5. BAD_ALGO (algo=3).
        mov rax, 5;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 4;
        mov rdx, 16;
        call wkey_meta_pack;
        mov r14, rax;                    // bad-algo meta

        mov rdi, 211;
        mov rsi, 209;
        mov rdx, 0x418;
        mov rcx, 0xC0FFEEA3;
        mov r8,  210;
        mov r9,  r14;
        call wifi_key_cap_mint_inner;
        mov r11, 0xFFFFF3EA;             // BAD_ALGO
        cmp rax, r11;
        jne wkeyw_fail_stage;

        // -- 6. BAD_KEY_ID (key_id=8).
        mov rax, 6;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 8;
        mov rdx, 16;
        call wkey_meta_pack;
        mov r14, rax;

        mov rdi, 211;
        mov rsi, 209;
        mov rdx, 0x418;
        mov rcx, 0xC0FFEEA4;
        mov r8,  210;
        mov r9,  r14;
        call wifi_key_cap_mint_inner;
        mov r11, 0xFFFFF3E9;             // BAD_KEY_ID
        cmp rax, r11;
        jne wkeyw_fail_stage;

        // -- 7. BAD_LEN (sealed_len=24).
        mov rax, 7;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 4;
        mov rdx, 24;
        call wkey_meta_pack;
        mov r14, rax;

        mov rdi, 211;
        mov rsi, 209;
        mov rdx, 0x418;
        mov rcx, 0xC0FFEEA5;
        mov r8,  210;
        mov r9,  r14;
        call wifi_key_cap_mint_inner;
        mov r11, 0xFFFFF3E8;             // BAD_LEN
        cmp rax, r11;
        jne wkeyw_fail_stage;

        // -- 8. NO_KEY (key_key = 0).
        mov rax, 8;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        mov rdi, 211;
        mov rsi, 209;
        mov rdx, 0x418;
        mov rcx, 0;                      // key_key = 0
        mov r8,  210;
        mov r9,  r15;
        call wifi_key_cap_mint_inner;
        mov r11, 0xFFFFF3E7;             // NO_KEY
        cmp rax, r11;
        jne wkeyw_fail_stage;

        // -- 9. Happy path.
        mov rax, 9;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        mov rdi, 211;
        mov rsi, 209;
        mov rdx, 0x418;
        mov rcx, 0xC0FFEEA9;
        mov r8,  210;
        mov r9,  r15;                    // algo=0, key_id=4, len=16
        call wifi_key_cap_mint_inner;
        cmp rax, 0;
        jne wkeyw_fail_stage;

        // -- 10. Query fields incl. sealed_flag (SEALED gate 3).
        mov rax, 10;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // row 0
        call wkey_row_key;
        mov r11, 0xC0FFEEA9;
        cmp rax, r11;
        jne wkeyw_fail_stage;

        mov rdi, 0;
        call wkey_row_memory;
        cmp rax, 210;
        jne wkeyw_fail_stage;

        mov rdi, 0;
        call wkey_row_algo;
        cmp rax, 0;                      // CCMP-128
        jne wkeyw_fail_stage;

        mov rdi, 0;
        call wkey_row_key_id;
        cmp rax, 4;
        jne wkeyw_fail_stage;

        mov rdi, 0;
        call wkey_row_sealed_len;
        cmp rax, 16;
        jne wkeyw_fail_stage;

        // SEALED GATE 3: sealed_flag reads back as 1.
        mov rdi, 0;
        call wkey_row_sealed_flag;
        cmp rax, 1;
        jne wkeyw_fail_stage;

        // -- 11. IN_USE (duplicate key_key).
        mov rax, 11;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        mov rdi, 212;
        mov rsi, 209;
        mov rdx, 0x418;
        mov rcx, 0xC0FFEEA9;             // same key_key
        mov r8,  210;
        mov r9,  r15;
        call wifi_key_cap_mint_inner;
        mov r11, 0xFFFFF3E6;             // IN_USE
        cmp rax, r11;
        jne wkeyw_fail_stage;

        // -- 12. Revoke round-trip.
        mov rax, 12;
        lea rcx, [rip + _wkeyw_stage];
        mov [rcx], rax;

        mov rdi, 211;
        call wifi_key_cap_revoke_inner;
        cmp rax, 0;
        jne wkeyw_fail_stage;

        mov rdi, 211;
        mov rsi, 209;
        mov rdx, 0x418;
        mov rcx, 0xC0FFEEA9;             // key free after revoke
        mov r8,  210;
        mov r9,  r15;
        call wifi_key_cap_mint_inner;
        cmp rax, 0;
        jne wkeyw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wkeyw_ok];
        call klog_s1;

        call wkeyw_scrub;
        call wkeyw_clear;
        xor rax, rax;
        jmp wkeyw_out;

      wkeyw_fail_stage:
        lea rax, [rip + _wkeyw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wkeyw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wkeyw_scrub;
        call wkeyw_clear;
        mov rax, 1;

      wkeyw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
