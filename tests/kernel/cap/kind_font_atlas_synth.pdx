// tests/kernel/cap/kind_font_atlas_synth.pdx -- G5.M1-002 (#1492)
//
// Boot witness for KIND_FONT_ATLAS. Exercises table reset,
// validators, tail_alloc happy path, row accessors, find helpers,
// and tail_free.
//
// Fingerprint: G5 KIND_FONT_ATLAS OK

module KindFontAtlasSynth = structure {

  pub let mut _kfaw_stage : u64 = 0

  pub let kfaw_ok   : [u8; 20] = "KIND_FONT_ATLAS OK\n\0"
  pub let kfaw_fail : [u8; 22] = "KIND_FONT_ATLAS FAIL\n\0"

  pub let kind_font_atlas_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G5.M1-002 (#1492): boot witness. Stages: (1) reset. (2) rights_valid. (3) format_valid. (4) extent_valid. (5) glyphs_valid. (6) tail_alloc. (7) row accessors. (8) find_by_key. (9) find_by_bo. (10) tail_free.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _kfaw_stage];
        mov [rcx], rax;
        call fa_table_reset;

        // 2. rights_valid: 0x619 ok; 0x1000 no.
        mov rax, 2;
        lea rcx, [rip + _kfaw_stage];
        mov [rcx], rax;
        mov rdi, 0x619;
        call fa_rights_valid;
        cmp rax, 1;
        jne kfaw_fail_stage;
        mov rdi, 0x1000;
        call fa_rights_valid;
        cmp rax, 0;
        jne kfaw_fail_stage;

        // 3. format_valid: 1 ok, 4 ok, 0 no, 5 no.
        mov rax, 3;
        lea rcx, [rip + _kfaw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call fa_format_valid;
        cmp rax, 1;
        jne kfaw_fail_stage;
        mov rdi, 4;
        call fa_format_valid;
        cmp rax, 1;
        jne kfaw_fail_stage;
        mov rdi, 0;
        call fa_format_valid;
        cmp rax, 0;
        jne kfaw_fail_stage;
        mov rdi, 5;
        call fa_format_valid;
        cmp rax, 0;
        jne kfaw_fail_stage;

        // 4. extent_valid: (1024, 512) ok; (32, 32) no; (4097, 1024) no.
        mov rax, 4;
        lea rcx, [rip + _kfaw_stage];
        mov [rcx], rax;
        mov rdi, 1024;
        mov rsi, 512;
        call fa_extent_valid;
        cmp rax, 1;
        jne kfaw_fail_stage;
        mov rdi, 32;
        mov rsi, 32;
        call fa_extent_valid;
        cmp rax, 0;
        jne kfaw_fail_stage;
        mov rdi, 4097;
        mov rsi, 1024;
        call fa_extent_valid;
        cmp rax, 0;
        jne kfaw_fail_stage;

        // 5. glyphs_valid: 500 ok, 4096 ok, 4097 no.
        mov rax, 5;
        lea rcx, [rip + _kfaw_stage];
        mov [rcx], rax;
        mov rdi, 500;
        call fa_glyphs_valid;
        cmp rax, 1;
        jne kfaw_fail_stage;
        mov rdi, 4096;
        call fa_glyphs_valid;
        cmp rax, 1;
        jne kfaw_fail_stage;
        mov rdi, 4097;
        call fa_glyphs_valid;
        cmp rax, 0;
        jne kfaw_fail_stage;

        // 6. tail_alloc happy: bo=7, extent=(1024, 1024), fmt=SDF (1),
        //    glyphs=100. Assert row_id == 0.
        mov rax, 6;
        lea rcx, [rip + _kfaw_stage];
        mov [rcx], rax;
        mov rdi, 7;
        mov rsi, 1024;
        mov rdx, 1024;
        mov rcx, 1;
        call fa_body1_pack;
        mov r12, rax;                       // body1
        mov rdi, 100;
        mov rsi, 0;
        call fa_body2_pack;
        mov r13, rax;                       // body2
        mov rdi, 0;
        call fa_hdr_pack;
        mov rdi, rax;
        mov rsi, 0xABCD1234;
        mov rdx, r12;
        mov rcx, r13;
        call fa_tail_alloc;
        cmp rax, 0;
        jne kfaw_fail_stage;
        mov r14, rax;                       // row 0

        // 7. Row accessors return the packed values.
        mov rax, 7;
        lea rcx, [rip + _kfaw_stage];
        mov [rcx], rax;
        mov rdi, r14;
        call fa_row_key;
        mov r10, 0xABCD1234;
        cmp rax, r10;
        jne kfaw_fail_stage;
        mov rdi, r14;
        call fa_row_bo;
        cmp rax, 7;
        jne kfaw_fail_stage;
        mov rdi, r14;
        call fa_row_width;
        cmp rax, 1024;
        jne kfaw_fail_stage;
        mov rdi, r14;
        call fa_row_format;
        cmp rax, 1;
        jne kfaw_fail_stage;
        mov rdi, r14;
        call fa_row_glyphs;
        cmp rax, 100;
        jne kfaw_fail_stage;

        // 8. find_by_key returns row 0 for 0xABCD1234; else NONE.
        mov rax, 8;
        lea rcx, [rip + _kfaw_stage];
        mov [rcx], rax;
        mov rdi, 0xABCD1234;
        call fa_find_by_key;
        cmp rax, 0;
        jne kfaw_fail_stage;
        mov rdi, 0xDEADBEEF;
        call fa_find_by_key;
        mov r10, 0xFF;
        cmp rax, r10;
        jne kfaw_fail_stage;

        // 9. find_by_bo returns row 0 for bo=7; else NONE.
        mov rax, 9;
        lea rcx, [rip + _kfaw_stage];
        mov [rcx], rax;
        mov rdi, 7;
        call fa_find_by_bo;
        cmp rax, 0;
        jne kfaw_fail_stage;
        mov rdi, 42;
        call fa_find_by_bo;
        mov r10, 0xFF;
        cmp rax, r10;
        jne kfaw_fail_stage;

        // 10. tail_free scrubs the row; find_by_key returns NONE.
        mov rax, 10;
        lea rcx, [rip + _kfaw_stage];
        mov [rcx], rax;
        mov rdi, r14;
        call fa_tail_free;
        mov rdi, 0xABCD1234;
        call fa_find_by_key;
        mov r10, 0xFF;
        cmp rax, r10;
        jne kfaw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kfaw_ok];
        call klog_s1;

        call fa_table_reset;
        xor rax, rax;
        jmp kfaw_out;

      kfaw_fail_stage:
        lea rax, [rip + _kfaw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kfaw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call fa_table_reset;
        mov rax, 1;

      kfaw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
