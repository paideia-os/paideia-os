// tests/kernel/cap/ipu6_stream_synth.pdx — R40.M3-002 (#1356)
//
// Boot witness for KIND_IPU6_STREAM.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, camera_slot gate,
// format / dimension / fps refusals, rights subset refuse, NO_KEY,
// BAD_EID (endpoint 0), uniqueness on stream_key, mint/revoke
// round-trip.
//
// Fingerprint: R40 KIND_IPU6_STREAM OK
//
// Cap slots 56..63.

module Ipu6StreamSynth = structure {

  pub let mut _ipu6sw_stage : u64 = 0

  pub let ipu6sw_ok   : [u8; 21] = "KIND_IPU6_STREAM OK\0"
  pub let ipu6sw_fail : [u8; 23] = "KIND_IPU6_STREAM FAIL\0"

  pub let ipu6sw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M3-002 (#1356): clear cap_table slots 56..63.",
      block: {
        push rbx;
        mov rbx, 56;
      ipu6swc_loop:
        cmp rbx, 64;
        jae ipu6swc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp ipu6swc_loop;
      ipu6swc_done:
        pop rbx;
        ret
      }
    }

  pub let ipu6sw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-002 (#1356): reset IPU6 STREAM row table.",
      block: {
        call ipu6_stream_table_reset;
        ret
      }
    }

  pub let ipu6sw_seed_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M3-002 (#1356): synthetic KIND_IPC_ENDPOINT at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let ipu6sw_seed_camera : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M3-002 (#1356): synthetic KIND_CSI_CAMERA at slot.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x17E;                  // KIND_CSI_CAMERA
        xor rdx, rdx;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let ipu6_stream_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R40.M3-002 (#1356): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_EID (parent has endpoint_id=0). (4) BAD_CAMERA. (5) BAD_FORMAT. (6) BAD_WIDTH. (7) BAD_HEIGHT. (8) BAD_FPS. (9) BAD_RIGHTS. (10) NO_KEY. (11) Happy path. (12) Query fields. (13) IN_USE. (14) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        call ipu6sw_clear;
        call ipu6sw_scrub;

        // -- 1. Validators.
        mov rdi, 0x419;
        call ipu6s_rights_valid;
        cmp rax, 1;
        jne ipu6sw_fail_stage;
        mov rdi, 0x200;
        call ipu6s_rights_valid;
        cmp rax, 0;
        jne ipu6sw_fail_stage;

        mov rdi, 1;
        call ipu6s_format_valid;
        cmp rax, 1;
        jne ipu6sw_fail_stage;
        mov rdi, 3;
        call ipu6s_format_valid;
        cmp rax, 1;
        jne ipu6sw_fail_stage;
        mov rdi, 4;
        call ipu6s_format_valid;
        cmp rax, 0;
        jne ipu6sw_fail_stage;
        mov rdi, 0;
        call ipu6s_format_valid;
        cmp rax, 0;
        jne ipu6sw_fail_stage;

        mov rdi, 1;
        call ipu6s_dim_valid;
        cmp rax, 1;
        jne ipu6sw_fail_stage;
        mov rdi, 8192;
        call ipu6s_dim_valid;
        cmp rax, 1;
        jne ipu6sw_fail_stage;
        mov rdi, 8193;
        call ipu6s_dim_valid;
        cmp rax, 0;
        jne ipu6sw_fail_stage;

        mov rdi, 1;
        call ipu6s_fps_valid;
        cmp rax, 1;
        jne ipu6sw_fail_stage;
        mov rdi, 120;
        call ipu6s_fps_valid;
        cmp rax, 1;
        jne ipu6sw_fail_stage;
        mov rdi, 121;
        call ipu6s_fps_valid;
        cmp rax, 0;
        jne ipu6sw_fail_stage;
        mov rdi, 0;
        call ipu6s_fps_valid;
        cmp rax, 0;
        jne ipu6sw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at 57 with R_MINT + endpoint_id 0x0042.
        // KIND_CSI_CAMERA at 58.
        // KIND_IPC_ENDPOINT at 60 with R_MINT + endpoint_id 0 (fabricated).
        mov rdi, 57;
        mov rsi, 0x200;
        mov rdx, 0x0042;
        call ipu6sw_seed_endpoint;

        mov rdi, 58;
        mov rsi, 0x0BEEF;
        call ipu6sw_seed_camera;

        mov rdi, 60;
        mov rsi, 0x200;
        mov rdx, 0x0000;                 // endpoint_id = 0 (fabricated)
        call ipu6sw_seed_endpoint;

        // packed_geom: fmt=NV12=1, width=1920, height=1080, fps=30.
        // [15:0]=1, [31:16]=1920 (0x0780), [47:32]=1080 (0x0438), [55:48]=30 (0x1E).
        mov r15, 0x1E;
        shl r15, 16;
        or  r15, 0x0438;
        shl r15, 16;
        or  r15, 0x0780;
        shl r15, 16;
        or  r15, 0x0001;

        // -- 2. BAD_PARENT (parent slot empty).
        mov rax, 2;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 59;
        mov rsi, 56;                     // empty parent
        mov rdx, 0x419;
        mov rcx, 0xCAFE00;
        mov r8, 58;
        mov r9, r15;
        call ipu6_stream_cap_mint_inner;
        mov r11, 0xFFFFF1FD;
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        // -- 3. BAD_EID (parent endpoint 0).
        mov rax, 3;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 59;
        mov rsi, 60;                     // parent with endpoint_id 0
        mov rdx, 0x419;
        mov rcx, 0xCAFE01;
        mov r8, 58;
        mov r9, r15;
        call ipu6_stream_cap_mint_inner;
        mov r11, 0xFFFFF1F6;
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        // -- 4. BAD_CAMERA (camera_slot names empty).
        mov rax, 4;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 59;
        mov rsi, 57;
        mov rdx, 0x419;
        mov rcx, 0xCAFE02;
        mov r8, 61;                      // empty camera slot
        mov r9, r15;
        call ipu6_stream_cap_mint_inner;
        mov r11, 0xFFFFF1FB;
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        // -- 5. BAD_FORMAT (fmt=4).
        mov rax, 5;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 59;
        mov rsi, 57;
        mov rdx, 0x419;
        mov rcx, 0xCAFE03;
        mov r8, 58;
        // packed_geom with fmt=4
        mov r9, 0x1E;
        shl r9, 16;
        or  r9, 0x0438;
        shl r9, 16;
        or  r9, 0x0780;
        shl r9, 16;
        or  r9, 0x0004;
        call ipu6_stream_cap_mint_inner;
        mov r11, 0xFFFFF1FA;
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        // -- 6. BAD_WIDTH (width=0).
        mov rax, 6;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 59;
        mov rsi, 57;
        mov rdx, 0x419;
        mov rcx, 0xCAFE04;
        mov r8, 58;
        // packed_geom with width=0
        mov r9, 0x1E;
        shl r9, 16;
        or  r9, 0x0438;
        shl r9, 16;
        or  r9, 0x0000;                  // width=0
        shl r9, 16;
        or  r9, 0x0001;
        call ipu6_stream_cap_mint_inner;
        mov r11, 0xFFFFF1F9;
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        // -- 7. BAD_HEIGHT (height=8193).
        mov rax, 7;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 59;
        mov rsi, 57;
        mov rdx, 0x419;
        mov rcx, 0xCAFE05;
        mov r8, 58;
        // packed_geom with height=8193
        mov r9, 0x1E;
        shl r9, 16;
        or  r9, 0x2001;                  // height=8193
        shl r9, 16;
        or  r9, 0x0780;
        shl r9, 16;
        or  r9, 0x0001;
        call ipu6_stream_cap_mint_inner;
        mov r11, 0xFFFFF1F8;
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        // -- 8. BAD_FPS (fps=121).
        mov rax, 8;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 59;
        mov rsi, 57;
        mov rdx, 0x419;
        mov rcx, 0xCAFE06;
        mov r8, 58;
        // packed_geom with fps=121
        mov r9, 0x79;                    // fps=121
        shl r9, 16;
        or  r9, 0x0438;
        shl r9, 16;
        or  r9, 0x0780;
        shl r9, 16;
        or  r9, 0x0001;
        call ipu6_stream_cap_mint_inner;
        mov r11, 0xFFFFF1F7;
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        // -- 9. BAD_RIGHTS.
        mov rax, 9;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 59;
        mov rsi, 57;
        mov rdx, 0x800;                  // outside R_IPU6S_ALL
        mov rcx, 0xCAFE07;
        mov r8, 58;
        mov r9, r15;
        call ipu6_stream_cap_mint_inner;
        mov r11, 0xFFFFF1FC;
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        // -- 10. NO_KEY.
        mov rax, 10;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 59;
        mov rsi, 57;
        mov rdx, 0x419;
        mov rcx, 0;                      // stream_key = 0
        mov r8, 58;
        mov r9, r15;
        call ipu6_stream_cap_mint_inner;
        mov r11, 0xFFFFF1F5;
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        // -- 11. Happy path.
        mov rax, 11;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 59;
        mov rsi, 57;
        mov rdx, 0x419;
        mov rcx, 0xCAFE09;
        mov r8, 58;
        mov r9, r15;
        call ipu6_stream_cap_mint_inner;
        cmp rax, 0;
        jne ipu6sw_fail_stage;

        // -- 12. Query fields.
        mov rax, 12;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call ipu6s_row_key;
        mov r11, 0xCAFE09;
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        mov rdi, 0;
        call ipu6s_row_endpoint;
        cmp rax, 0x0042;
        jne ipu6sw_fail_stage;

        mov rdi, 0;
        call ipu6s_row_camera;
        cmp rax, 58;
        jne ipu6sw_fail_stage;

        mov rdi, 0;
        call ipu6s_row_format;
        cmp rax, 1;
        jne ipu6sw_fail_stage;

        mov rdi, 0;
        call ipu6s_row_width;
        mov r11, 0x0780;                 // 1920
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        mov rdi, 0;
        call ipu6s_row_height;
        mov r11, 0x0438;                 // 1080
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        mov rdi, 0;
        call ipu6s_row_fps;
        cmp rax, 30;
        jne ipu6sw_fail_stage;

        // -- 13. IN_USE (duplicate stream_key).
        mov rax, 13;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 62;
        mov rsi, 57;
        mov rdx, 0x419;
        mov rcx, 0xCAFE09;
        mov r8, 58;
        mov r9, r15;
        call ipu6_stream_cap_mint_inner;
        mov r11, 0xFFFFF1F4;
        cmp rax, r11;
        jne ipu6sw_fail_stage;

        // -- 14. Revoke round-trip.
        mov rax, 14;
        lea rcx, [rip + _ipu6sw_stage];
        mov [rcx], rax;

        mov rdi, 59;
        call ipu6_stream_cap_revoke_inner;
        cmp rax, 0;
        jne ipu6sw_fail_stage;

        mov rdi, 59;
        mov rsi, 57;
        mov rdx, 0x419;
        mov rcx, 0xCAFE09;               // key free after revoke
        mov r8, 58;
        mov r9, r15;
        call ipu6_stream_cap_mint_inner;
        cmp rax, 0;
        jne ipu6sw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ipu6sw_ok];
        call klog_s1;

        call ipu6sw_scrub;
        call ipu6sw_clear;
        xor rax, rax;
        jmp ipu6sw_out;

      ipu6sw_fail_stage:
        lea rax, [rip + _ipu6sw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ipu6sw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ipu6sw_scrub;
        call ipu6sw_clear;
        mov rax, 1;

      ipu6sw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
