// tests/kernel/cap/display_plane_synth.pdx — R36.M4-001 (#1249)
//
// Boot witness for KIND_DISPLAY_PLANE.
//
// Asserts derivation gate over KIND_MEMORY, plane_type / zorder /
// format / dim refusals, uniqueness on plane_key, and mint / revoke
// round-trip.
//
// Fingerprint: R36 KIND_DISPLAY_PLANE OK
//
// Cap slots 64..79.

module DisplayPlaneSynth = structure {

  pub let mut _dppw_stage : u64 = 0

  pub let dppw_ok   : [u8; 27] = "R36 KIND_DISPLAY_PLANE OK\n\0"
  pub let dppw_fail : [u8; 29] = "R36 KIND_DISPLAY_PLANE FAIL\n\0"

  pub let dppw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-001 (#1249): clear cap_table slots 64..79.",
      block: {
        push rbx;
        mov rbx, 64;
      dppwc_loop:
        cmp rbx, 80;
        jae dppwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp dppwc_loop;
      dppwc_done:
        pop rbx;
        ret
      }
    }

  pub let dppw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): reset DISPLAY_PLANE row table.",
      block: {
        call display_plane_table_reset;
        ret
      }
    }

  pub let dppw_memory : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (memory_key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-001 (#1249): synthetic KIND_MEMORY at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let display_plane_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R36.M4-001 (#1249): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_TYPE. (4) BAD_FORMAT. (5) BAD_DIM (w=0). (6) Happy path (primary, XRGB8888, 1920x1080, z=0). (7) Query fields. (8) IN_USE. (9) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dppw_stage];
        mov [rcx], rax;

        call dppw_clear;
        call dppw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call dpp_type_valid;
        cmp rax, 1;
        jne dppw_fail_stage;
        mov rdi, 3;                      // over max (2)
        call dpp_type_valid;
        cmp rax, 0;
        jne dppw_fail_stage;

        mov rdi, 0;
        call dpp_zorder_valid;
        cmp rax, 1;
        jne dppw_fail_stage;
        mov rdi, 0xFF;
        call dpp_zorder_valid;
        cmp rax, 1;
        jne dppw_fail_stage;
        mov rdi, 0x100;
        call dpp_zorder_valid;
        cmp rax, 0;
        jne dppw_fail_stage;

        mov rdi, 0;
        call dpp_format_valid;
        cmp rax, 1;
        jne dppw_fail_stage;
        mov rdi, 4;
        call dpp_format_valid;
        cmp rax, 1;
        jne dppw_fail_stage;
        mov rdi, 5;
        call dpp_format_valid;
        cmp rax, 0;
        jne dppw_fail_stage;

        mov rdi, 1920;
        call dpp_dim_valid;
        cmp rax, 1;
        jne dppw_fail_stage;
        mov rdi, 0;
        call dpp_dim_valid;
        cmp rax, 0;
        jne dppw_fail_stage;

        // Setup: KIND_MEMORY at 65.
        mov rdi, 65;
        mov rsi, 0x200;
        mov rdx, 0xC00F0001;
        call dppw_memory;

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _dppw_stage];
        mov [rcx], rax;

        // packed_all: type=0 | z=0 | fmt=0 | w=1920 | h=1080
        mov r10, 0;                      // type
        mov r11, 0;                      // z
        shl r11, 8;
        or  r10, r11;
        mov r11, 0;                      // fmt
        shl r11, 16;
        or  r10, r11;
        mov r11, 1920;                   // w
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;                   // h
        shl r11, 48;
        or  r10, r11;
        mov r15, r10;                    // stash packed_all

        mov rdi, 66;
        mov rsi, 64;                    // empty parent
        mov rdx, 0x419;
        mov rcx, 0xBEEF0001;
        mov r8, 65;
        mov r9, r15;
        call display_plane_cap_mint_inner;
        mov r11, 0xFFFFF6ED;             // MINT_BAD_PARENT
        cmp rax, r11;
        jne dppw_fail_stage;

        // -- 3. BAD_TYPE (type=3, out of enum).
        mov rax, 3;
        lea rcx, [rip + _dppw_stage];
        mov [rcx], rax;

        mov r10, 3;                      // bad type
        mov r11, 0;
        shl r11, 8;
        or  r10, r11;
        mov r11, 0;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1920;
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 66;
        mov rsi, 65;
        mov rdx, 0x419;
        mov rcx, 0xBEEF0002;
        mov r8, 65;
        mov r9, r10;
        call display_plane_cap_mint_inner;
        mov r11, 0xFFFFF6EB;             // MINT_BAD_TYPE
        cmp rax, r11;
        jne dppw_fail_stage;

        // -- 4. BAD_FORMAT (fmt=5).
        mov rax, 4;
        lea rcx, [rip + _dppw_stage];
        mov [rcx], rax;

        mov r10, 0;                      // primary
        mov r11, 0;
        shl r11, 8;
        or  r10, r11;
        mov r11, 5;                      // bad format
        shl r11, 16;
        or  r10, r11;
        mov r11, 1920;
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 66;
        mov rsi, 65;
        mov rdx, 0x419;
        mov rcx, 0xBEEF0003;
        mov r8, 65;
        mov r9, r10;
        call display_plane_cap_mint_inner;
        mov r11, 0xFFFFF6E9;             // MINT_BAD_FORMAT
        cmp rax, r11;
        jne dppw_fail_stage;

        // -- 5. BAD_DIM (w=0).
        mov rax, 5;
        lea rcx, [rip + _dppw_stage];
        mov [rcx], rax;

        mov r10, 0;
        mov r11, 0;
        shl r11, 8;
        or  r10, r11;
        mov r11, 0;
        shl r11, 16;
        or  r10, r11;
        mov r11, 0;                      // w = 0
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 66;
        mov rsi, 65;
        mov rdx, 0x419;
        mov rcx, 0xBEEF0004;
        mov r8, 65;
        mov r9, r10;
        call display_plane_cap_mint_inner;
        mov r11, 0xFFFFF6E8;             // MINT_BAD_DIM
        cmp rax, r11;
        jne dppw_fail_stage;

        // -- 6. Happy path (primary, XRGB8888, 1920x1080, z=0).
        mov rax, 6;
        lea rcx, [rip + _dppw_stage];
        mov [rcx], rax;

        mov r10, 0;                      // primary
        mov r11, 0;                      // z=0
        shl r11, 8;
        or  r10, r11;
        mov r11, 0;                      // XRGB8888
        shl r11, 16;
        or  r10, r11;
        mov r11, 1920;
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 66;
        mov rsi, 65;
        mov rdx, 0x419;
        mov rcx, 0xBEEF0005;
        mov r8, 65;
        mov r9, r10;
        call display_plane_cap_mint_inner;
        cmp rax, 0;
        jne dppw_fail_stage;

        // -- 7. Query fields.
        mov rax, 7;
        lea rcx, [rip + _dppw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call dpp_row_key;
        mov r11, 0xBEEF0005;
        cmp rax, r11;
        jne dppw_fail_stage;

        mov rdi, 0;
        call dpp_row_memory;
        cmp rax, 65;
        jne dppw_fail_stage;

        mov rdi, 0;
        call dpp_row_type;
        cmp rax, 0;
        jne dppw_fail_stage;

        mov rdi, 0;
        call dpp_row_zorder;
        cmp rax, 0;
        jne dppw_fail_stage;

        mov rdi, 0;
        call dpp_row_format;
        cmp rax, 0;
        jne dppw_fail_stage;

        mov rdi, 0;
        call dpp_row_width;
        cmp rax, 1920;
        jne dppw_fail_stage;

        mov rdi, 0;
        call dpp_row_height;
        cmp rax, 1080;
        jne dppw_fail_stage;

        // -- 8. IN_USE (duplicate key).
        mov rax, 8;
        lea rcx, [rip + _dppw_stage];
        mov [rcx], rax;

        mov r10, 0;
        mov r11, 0;
        shl r11, 8;
        or  r10, r11;
        mov r11, 0;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1920;
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 67;
        mov rsi, 65;
        mov rdx, 0x419;
        mov rcx, 0xBEEF0005;             // duplicate key
        mov r8, 65;
        mov r9, r10;
        call display_plane_cap_mint_inner;
        mov r11, 0xFFFFF6E4;             // MINT_IN_USE
        cmp rax, r11;
        jne dppw_fail_stage;

        // -- 9. Revoke round-trip.
        mov rax, 9;
        lea rcx, [rip + _dppw_stage];
        mov [rcx], rax;

        mov rdi, 66;
        call display_plane_cap_revoke_inner;
        cmp rax, 0;
        jne dppw_fail_stage;

        mov r10, 0;
        mov r11, 0;
        shl r11, 8;
        or  r10, r11;
        mov r11, 0;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1920;
        shl r11, 32;
        or  r10, r11;
        mov r11, 1080;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 66;
        mov rsi, 65;
        mov rdx, 0x419;
        mov rcx, 0xBEEF0005;             // key free after revoke
        mov r8, 65;
        mov r9, r10;
        call display_plane_cap_mint_inner;
        cmp rax, 0;
        jne dppw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dppw_ok];
        call klog_s1;

        call dppw_scrub;
        call dppw_clear;
        xor rax, rax;
        jmp dppw_out;

      dppw_fail_stage:
        lea rax, [rip + _dppw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dppw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dppw_scrub;
        call dppw_clear;
        mov rax, 1;

      dppw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
