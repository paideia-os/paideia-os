// tests/kernel/cap/cooling_device_synth.pdx — R31.M4-001 (#1103)
//
// Boot witness for KIND_COOLING_DEVICE: the derivation gate over
// KIND_DEVICE, the one-cooler-per-device rule, the static-identity
// refusals (index / type / range), the report installer's range
// plausibility gate, the row's cached state semantics, the revoke,
// and the dispatch handler.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arithmetic, refusals and state transitions. IT ASSERTS
// NOTHING ABOUT A FAN SPEED IN RPM, A THROTTLE PERCENT OR A POWER
// TRANSITION, because no code in this tree actuates a cooling
// device -- kind_cooling_device.pdx §4 says so at length.
//
// -----------------------------------------------------------------------------
// Two fingerprints, not one
// -----------------------------------------------------------------------------
//
//   R31 KIND_COOLING_DEVICE OK  — stage A: the capability. Gate halves,
//                                 rights, uniqueness, revoke, dispatch,
//                                 static-identity refusals.
//   R31 COOLING SCALE OK        — stage B: the ordinals. Range refusals
//                                 at both edges, end-to-end round-trip
//                                 through REPORT, sentinel discipline.
//
// Split there because the two fail for unrelated reasons and the
// goldens assert an ordered subsequence: a range error and a broken
// gate would otherwise present as the same missing line.
//
// -----------------------------------------------------------------------------
// Cap slots 252..255
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness in the tree. The R31 range 244..251
// is battery_monitor's; 252..255 is what remains before the loader's
// own boot slots and it is exactly enough for one well-formed parent,
// one parent without RIGHT_MINT, one parent with zero identity, one
// second parent for the uniqueness sub-test, and the mint's own
// subject slot. Both exits revoke every cooler, clear every slot and
// reset the row table, so a failure here cannot be mistaken for a
// fault in whatever runs next.
//
// -----------------------------------------------------------------------------
// The numbers, and why these numbers
// -----------------------------------------------------------------------------
//
// state_min 0, state_max 4 — five fan speeds numbered 0..4, a plausible
// T14 G4 CPU-fan ladder. cooling_type FAN (1). A report of {cur_state
// 3} lands mid-way up the ladder, distinct from state_min so it is not
// the floor sentinel, distinct from state_max so it is not a clamp
// disguised as a success, and distinct from 0xFFFF so it is not the
// COOLING_STATE_NONE sentinel.
//
// 5 appears as a refused state because it is state_max + 1 and clamping
// would substitute state_max for it silently -- the exact failure §3
// warns about.

module CoolingDeviceSynth = structure {

  pub let mut _cd_w_stage : u64 = 0

  pub let cd_w_ok_a   : [u8; 25] = "KIND_COOLING_DEVICE OK\n\0"
  pub let cd_w_fail_a : [u8; 27] = "KIND_COOLING_DEVICE FAIL\n\0"
  pub let cd_w_ok_b   : [u8; 18] = "COOLING SCALE OK\n\0"
  pub let cd_w_fail_b : [u8; 20] = "COOLING SCALE FAIL\n\0"

  // ==========================================================================
  // cd_w_clear() — return slots 252..255 to boot state.
  // ==========================================================================

  pub let cd_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): clear cap_table slots 252..255 through cap_mint_write, the only descriptor writer, so the owner column's unconditional clear (#1587) runs on every one of them. Called on both exits: a witness whose failure path leaked four descriptors would make every witness after it report a different fault than the one that actually happened. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed cd_wc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        mov rbx, 252;
      cd_wc_loop:
        cmp rbx, 256;
        jae cd_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp cd_wc_loop;
      cd_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let cd_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M4-001 (#1103): reset the cooling row table and the counters. The counters are outside the rows so they survive a revoke, which means a fixture that left them populated would hand the next reader of cooling_stat a count of implausible reports this fixture invented. One push leaves rsp%16 == 0 at the nested call. Labels prefixed cd_ws_ per reserved-label discipline.",
      block: {
        push rbx;
        call cooling_device_table_reset;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cd_w_device(slot, key, rights) — mint a synthetic KIND_DEVICE parent.
  // ==========================================================================

  pub let cd_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): write a synthetic KIND_DEVICE descriptor whose target_ptr is `key`, through cap_mint_write. A fixture-local parent rather than a real PCI capability, because what the gate under test reads out of the parent is exactly two things -- kind == 10 and target_ptr -- and manufacturing a real bus enumeration to supply them would test the enumerator rather than the gate. Two pushes leave rsp%16 == 0 at the nested call. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cd_w_pack_range(smin, smax) -> range
  //
  // Pack (state_min, state_max) into the u64 the mint accepts.
  // ==========================================================================

  pub let cd_w_pack_range : (u64, u64) -> u64 !{} @{} =
    fn (smin: u64) (smax: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M4-001 (#1103): pack (smin, smax) as smin | (smax << 32). Provided by the fixture so every mint call site pack the endpoints identically. Pure leaf. Labels prefixed cd_pr_.",
      block: {
        mov rax, rsi;
        shl rax, 32;
        or  rax, rdi;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let cooling_device_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R31.M4-001 (#1103): boot witness for KIND_COOLING_DEVICE. STAGE A drives the capability: both halves of the derivation gate in both directions, the rights subset test, the four static-identity refusals that keep a cooler from existing without a plausible index / type / range, the one-cooler-per-device rule, the wrong-kind revoke refusal, the dispatch handler's per-op rights and its refusal of a non-zero reserved field on the REPORT op, and a re-mint after revoke which is what proves no ghost row was stranded. STAGE B drives the numbers: the range plausibility test at both edges (state_min admitted, state_max admitted, state_max+1 refused, state_min-1 refused via wrap), the sentinel discipline (COOLING_STATE_NONE readable before any report and distinct from any legitimate ordinal), and an end-to-end round trip through REPORT that proves the report count moved by exactly one. Each stage runs only if the previous passed. Both exits call cd_w_scrub and cd_w_clear. Five-push prologue (rbx, r12, r13, r14, r15) leaves rsp%16 == 0 at every nested call; the stage counter lives in module .bss so it survives every callee-save-clobber pattern in the primitives under test. Labels prefixed cd_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        call cd_w_clear;
        call cd_w_scrub;

        // 252 — well-formed parent. 253 — no RIGHT_MINT. 254 —
        // RIGHT_MINT but zero identity. 255 — used as subject / second
        // parent depending on stage.
        mov rdi, 252;
        mov rsi, 0xCD01;
        mov rdx, 0x200;                  // RIGHT_MINT
        call cd_w_device;
        mov rdi, 253;
        mov rsi, 0xCD09;
        mov rdx, 0x001;                  // no RIGHT_MINT
        call cd_w_device;
        mov rdi, 254;
        xor rsi, rsi;                    // no identity
        mov rdx, 0x200;
        call cd_w_device;

        // -- A1. First half of the gate, in both directions.
        mov rax, 2;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        mov rdi, 252;
        call cooling_check_parent_device;
        cmp rax, 1;
        jne cd_w_fail_stage_a;

        mov rdi, 253;
        call cooling_check_parent_device;
        cmp rax, 0;
        jne cd_w_fail_stage_a;

        mov rdi, 255;                    // empty slot
        call cooling_check_parent_device;
        cmp rax, 0;
        jne cd_w_fail_stage_a;

        // Try to mint from a parent without RIGHT_MINT. Subject is 255.
        // Range: 0..4.
        mov rdi, 0;
        mov rsi, 4;
        call cd_w_pack_range;
        mov r15, rax;                    // range

        mov rdi, 255;
        mov rsi, 253;
        mov rdx, 0x41B;
        mov rcx, 0;                      // index
        mov r8, 1;                       // FAN
        mov r9, r15;
        call cooling_cap_mint;
        mov r11, 0xFFFFFE5D;             // COOLING_MINT_BAD_PARENT
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        // -- A2. Rights subset. RIGHT_MINT outside the mask.
        mov rax, 3;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        mov rdi, 0x001;
        call cooling_rights_valid;
        cmp rax, 1;
        jne cd_w_fail_stage_a;
        mov rdi, 0x41B;
        call cooling_rights_valid;
        cmp rax, 1;
        jne cd_w_fail_stage_a;
        mov rdi, 0x200;
        call cooling_rights_valid;
        cmp rax, 0;
        jne cd_w_fail_stage_a;

        mov rdi, 255;
        mov rsi, 252;
        mov rdx, 0x21B;                  // R_COOLING_ALL | RIGHT_MINT
        mov rcx, 0;
        mov r8, 1;
        mov r9, r15;
        call cooling_cap_mint;
        mov r11, 0xFFFFFE5C;             // COOLING_MINT_BAD_RIGHTS
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        // -- A3. Static-identity refusals. index >= 16, type past
        //    COOLING_TYPE_MAX, degenerate range, oversized range.
        mov rax, 4;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        mov rdi, 255;
        mov rsi, 252;
        mov rdx, 0x41B;
        mov rcx, 16;                     // COOLING_INDEX_MAX -> refused
        mov r8, 1;
        mov r9, r15;
        call cooling_cap_mint;
        mov r11, 0xFFFFFE5B;             // COOLING_MINT_BAD_INDEX
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        mov rdi, 255;
        mov rsi, 252;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 4;                       // past COOLING_TYPE_MAX
        mov r9, r15;
        call cooling_cap_mint;
        mov r11, 0xFFFFFE5A;             // COOLING_MINT_BAD_TYPE
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        // Degenerate range smin == smax.
        mov rdi, 3;
        mov rsi, 3;
        call cd_w_pack_range;
        mov r14, rax;

        mov rdi, 255;
        mov rsi, 252;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1;
        mov r9, r14;
        call cooling_cap_mint;
        mov r11, 0xFFFFFE59;             // COOLING_MINT_BAD_RANGE
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        // Descending range smax < smin.
        mov rdi, 5;
        mov rsi, 2;
        call cd_w_pack_range;
        mov r14, rax;

        mov rdi, 255;
        mov rsi, 252;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1;
        mov r9, r14;
        call cooling_cap_mint;
        mov r11, 0xFFFFFE59;
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        // smax past COOLING_STATE_UPPER.
        mov rdi, 0;
        mov rsi, 256;
        call cd_w_pack_range;
        mov r14, rax;

        mov rdi, 255;
        mov rsi, 252;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1;
        mov r9, r14;
        call cooling_cap_mint;
        mov r11, 0xFFFFFE59;
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        // -- A4. Identity is INHERITED. Parent naming no device
        //    cannot resolve to "device 0".
        mov rax, 5;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        mov rdi, 254;
        call cooling_parent_key;
        cmp rax, 0;
        jne cd_w_fail_stage_a;

        mov rdi, 255;
        mov rsi, 254;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1;
        mov r9, r15;                     // valid 0..4 range
        call cooling_cap_mint;
        mov r11, 0xFFFFFE58;             // COOLING_MINT_NO_DEVICE
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        // -- A5. Happy path. Row reads back as minted with the
        //    INHERITED key and no state reported yet.
        mov rax, 6;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        mov rdi, 255;
        mov rsi, 252;
        mov rdx, 0x41B;
        mov rcx, 0;                      // index 0
        mov r8, 1;                       // FAN
        mov r9, r15;
        call cooling_cap_mint;
        cmp rax, 0;
        jne cd_w_fail_stage_a;

        mov rdi, 255;
        call cooling_max_of_slot;
        cmp rax, 4;
        jne cd_w_fail_stage_a;

        mov rdi, 255;
        call cooling_type_of_slot;
        cmp rax, 1;                      // FAN
        jne cd_w_fail_stage_a;

        mov rdi, 255;
        call cooling_state_of_slot;
        cmp rax, 0xFFFF;                 // COOLING_STATE_NONE
        jne cd_w_fail_stage_a;

        mov rdi, 255;
        call cooling_row_of_slot;
        mov rbx, rax;                    // rbx = row across stage
        cmp rbx, 0xFF;
        je  cd_w_fail_stage_a;

        mov rdi, rbx;
        call cooling_row_key;
        cmp rax, 0xCD01;                 // INHERITED key
        jne cd_w_fail_stage_a;

        mov rdi, rbx;
        call cooling_row_parent;
        cmp rax, 252;
        jne cd_w_fail_stage_a;

        mov rdi, rbx;
        call cooling_row_reports;
        cmp rax, 0;                      // no reports yet
        jne cd_w_fail_stage_a;

        // -- A6. ONE COOLER, ONE CAPABILITY. Second mint over the
        //    same device -- into an empty slot -- is REFUSED, not
        //    merged. We first need a fresh subject slot; since 252
        //    is the device and 255 holds the live cooler, use 253's
        //    device (which lacks RIGHT_MINT) — no, we need a
        //    same-device second attempt. Reuse 252 as parent again;
        //    we need a different subject slot. Slot 253 is
        //    occupied; use 254 as the subject by clearing it first.
        mov rax, 7;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        // Clear 254 (currently a KIND_DEVICE stand-in).
        mov rdi, 254;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 254;                    // subject
        mov rsi, 252;                    // SAME device
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1;
        mov r9, r15;
        call cooling_cap_mint;
        mov r11, 0xFFFFFE56;             // COOLING_MINT_COOL_IN_USE
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        mov rdi, 0xCD01;
        call cooling_find_by_key;
        cmp rax, rbx;                    // and it IS this row
        jne cd_w_fail_stage_a;

        // -- A7. Revoke refusals. Cooler revoke aimed at the DEVICE
        //    descriptor must not clear it.
        mov rax, 8;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        mov rdi, 252;                    // KIND_DEVICE
        call cooling_cap_revoke;
        mov r11, 0xFFFFFE54;             // COOLING_WRONG_KIND
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        mov rdi, 254;                    // empty slot (we cleared it)
        call cooling_cap_revoke;
        mov r11, 0xFFFFFE53;             // COOLING_REVOKE_ALREADY
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        // Device survived.
        mov rdi, 252;
        call cooling_check_parent_device;
        cmp rax, 1;
        jne cd_w_fail_stage_a;

        // -- A8. Dispatch handler. Per-op rights, unknown op,
        //    reserved field on REPORT.
        mov rax, 9;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        // target_ptr as cap_mint_write wrote it: row | (slot << 16).
        mov r12, rbx;
        mov r13, 255;
        shl r13, 16;
        or  r12, r13;                    // r12 = target_ptr for slot 255

        // QUERY_MAX is INVOKE.
        mov rdi, 0x008;                  // R_COOLING_INVOKE
        mov rsi, r12;
        mov rdx, 3;                      // QUERY_MAX
        call cap_handler_cooling_device;
        cmp rax, 4;
        jne cd_w_fail_stage_a;

        // QUERY_MAX with only READ is DENIED.
        mov rdi, 0x001;
        mov rsi, r12;
        mov rdx, 3;
        call cap_handler_cooling_device;
        mov r11, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        // QUERY_STATE is READ.
        mov rdi, 0x001;
        mov rsi, r12;
        mov rdx, 4;                      // QUERY_STATE
        call cap_handler_cooling_device;
        cmp rax, 0xFFFF;                 // COOLING_STATE_NONE
        jne cd_w_fail_stage_a;

        // Unknown op.
        mov rdi, 0x41B;
        mov rsi, r12;
        mov rdx, 9;
        call cap_handler_cooling_device;
        mov r11, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        // REPORT with reserved bits set is REFUSED, not masked.
        mov rdi, 0x002;                  // R_COOLING_REPORT
        mov rsi, r12;
        mov r13, 1;
        shl r13, 24;                     // reserved [63:24]
        or  r13, 8;                      // op = 8
        mov rdx, r13;
        call cap_handler_cooling_device;
        mov r11, 0xFFFFFE5E;             // COOLING_TAIL_BAD_ARG
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        // -- A9. Revoke and RE-MINT. Proves no ghost row was stranded.
        mov rax, 10;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        mov rdi, 255;
        call cooling_cap_revoke;
        cmp rax, 0;
        jne cd_w_fail_stage_a;

        mov rdi, rbx;
        call cooling_tail_valid;
        cmp rax, 0;                      // row went with it
        jne cd_w_fail_stage_a;

        mov rdi, 0xCD01;
        call cooling_find_by_key;
        cmp rax, 0xFF;                   // COOLING_ROW_NONE
        jne cd_w_fail_stage_a;

        mov rdi, 255;
        mov rsi, 252;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1;
        mov r9, r15;
        call cooling_cap_mint;
        cmp rax, 0;
        jne cd_w_fail_stage_a;

        // -- A10. Dead row answers COOLING_DECODE_BAD.
        mov rax, 11;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        mov rdi, 7;                      // never-claimed row
        call cooling_row_max;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        mov rdi, 7;
        call cooling_row_state;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        mov rdi, 254;                    // empty slot
        call cooling_max_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        mov rdi, 252;                    // KIND_DEVICE, not a cooler
        call cooling_max_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cd_w_fail_stage_a;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cd_w_ok_a];
        call klog_s1;

        // ================================================================
        // STAGE B — THE NUMBERS.
        // ================================================================

        // -- B1. Type enumeration. Every declared ordinal admitted;
        //    one past refused.
        mov rax, 21;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call cooling_type_valid;
        cmp rax, 1;
        jne cd_w_fail_stage_b;
        mov rdi, 3;
        call cooling_type_valid;
        cmp rax, 1;
        jne cd_w_fail_stage_b;
        mov rdi, 4;
        call cooling_type_valid;
        cmp rax, 0;
        jne cd_w_fail_stage_b;

        // -- B2. Refresh the row handle after the A9 re-mint.
        mov rax, 22;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        mov rdi, 255;
        call cooling_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;
        je  cd_w_fail_stage_b;

        // -- B3. REPORT round trip. Push cur_state 3, read it back,
        //    prove the report count moved by exactly one and the
        //    COOLING_ST_REPORTS global moved by one too.
        mov rax, 23;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call cooling_row_reports;
        mov r14, rax;                    // count before

        mov rdi, 0;                      // COOLING_ST_REPORTS
        call cooling_stat;
        mov r15, rax;                    // global before

        mov rdi, 255;
        mov rsi, 3;
        call cooling_report_install;
        cmp rax, 0;
        jne cd_w_fail_stage_b;

        mov rdi, 255;
        call cooling_state_of_slot;
        cmp rax, 3;
        jne cd_w_fail_stage_b;

        mov rdi, rbx;
        call cooling_row_reports;
        sub rax, r14;
        cmp rax, 1;
        jne cd_w_fail_stage_b;

        mov rdi, 0;
        call cooling_stat;
        sub rax, r15;
        cmp rax, 1;
        jne cd_w_fail_stage_b;

        // -- B4. RANGE PLAUSIBILITY. state_max admitted, state_max+1
        //    refused, state_min admitted, and NOTHING IS CLAMPED --
        //    the refused report does not update cur_state and IS
        //    counted.
        mov rax, 24;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        // state_max (4) admitted.
        mov rdi, 255;
        mov rsi, 4;
        call cooling_report_install;
        cmp rax, 0;
        jne cd_w_fail_stage_b;
        mov rdi, 255;
        call cooling_state_of_slot;
        cmp rax, 4;
        jne cd_w_fail_stage_b;

        // state_min (0) admitted.
        mov rdi, 255;
        xor rsi, rsi;
        call cooling_report_install;
        cmp rax, 0;
        jne cd_w_fail_stage_b;
        mov rdi, 255;
        call cooling_state_of_slot;
        cmp rax, 0;
        jne cd_w_fail_stage_b;

        // state_max+1 refused; row unchanged; counted.
        mov rdi, 1;                      // COOLING_ST_IMPL_STATE
        call cooling_stat;
        mov r14, rax;

        mov rdi, 255;
        mov rsi, 5;                      // past state_max
        call cooling_report_install;
        mov r11, 0xFFFFFE52;             // COOLING_IMPLAUSIBLE_STATE
        cmp rax, r11;
        jne cd_w_fail_stage_b;

        mov rdi, 255;
        call cooling_state_of_slot;
        cmp rax, 0;                      // unchanged from the previous good install
        jne cd_w_fail_stage_b;

        mov rdi, 1;
        call cooling_stat;
        sub rax, r14;
        cmp rax, 1;
        jne cd_w_fail_stage_b;

        // -- B5. Debug print refuses a dead row.
        mov rax, 25;
        lea rcx, [rip + _cd_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call cooling_debug_print;
        cmp rax, 0;
        jne cd_w_fail_stage_b;

        mov rdi, 7;                      // never claimed
        call cooling_debug_print;
        mov r11, 0xFFFFFE5E;             // COOLING_TAIL_BAD_ARG
        cmp rax, r11;
        jne cd_w_fail_stage_b;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cd_w_ok_b];
        call klog_s1;

        call cd_w_scrub;
        call cd_w_clear;
        xor rax, rax;
        jmp cd_w_out;

      cd_w_fail_stage_a:
        lea rax, [rip + _cd_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cd_w_fail_a];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp cd_w_failed;

      cd_w_fail_stage_b:
        lea rax, [rip + _cd_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cd_w_fail_b];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      cd_w_failed:
        call cd_w_scrub;
        call cd_w_clear;
        mov rax, 1;

      cd_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
