// tests/kernel/cap/csi_camera_synth.pdx — R40.M2-001 (#1352)
//
// Boot witness for KIND_CSI_CAMERA.
//
// Asserts derivation gate over KIND_DEVICE, device_slot gate, lanes
// refusal, width/height refusals, rights subset refuse, uniqueness on
// cam_key, mint/revoke round-trip.
//
// Fingerprint: R40 KIND_CSI_CAMERA OK
//
// Cap slots 20..27.

module CsiCameraSynth = structure {

  pub let mut _ccamw_stage : u64 = 0

  pub let ccamw_ok   : [u8; 24] = "R40 KIND_CSI_CAMERA OK\n\0"
  pub let ccamw_fail : [u8; 26] = "R40 KIND_CSI_CAMERA FAIL\n\0"

  pub let ccamw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M2-001 (#1352): clear cap_table slots 20..27.",
      block: {
        push rbx;
        mov rbx, 20;
      ccamwc_loop:
        cmp rbx, 28;
        jae ccamwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp ccamwc_loop;
      ccamwc_done:
        pop rbx;
        ret
      }
    }

  pub let ccamw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): reset CSI CAMERA row table.",
      block: {
        call csi_camera_table_reset;
        ret
      }
    }

  pub let ccamw_seed_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M2-001 (#1352): synthetic KIND_DEVICE at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let csi_camera_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R40.M2-001 (#1352): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_DEVICE. (4) BAD_LANES. (5) BAD_WIDTH. (6) BAD_HEIGHT. (7) BAD_RIGHTS. (8) NO_KEY. (9) Happy path. (10) Query fields. (11) IN_USE. (12) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        call ccamw_clear;
        call ccamw_scrub;

        // -- 1. Validators.
        mov rdi, 0x419;
        call ccam_rights_valid;
        cmp rax, 1;
        jne ccamw_fail_stage;
        mov rdi, 0x200;                  // R_MINT outside mask
        call ccam_rights_valid;
        cmp rax, 0;
        jne ccamw_fail_stage;

        mov rdi, 1;
        call ccam_lanes_valid;
        cmp rax, 1;
        jne ccamw_fail_stage;
        mov rdi, 4;
        call ccam_lanes_valid;
        cmp rax, 1;
        jne ccamw_fail_stage;
        mov rdi, 0;
        call ccam_lanes_valid;
        cmp rax, 0;
        jne ccamw_fail_stage;
        mov rdi, 5;
        call ccam_lanes_valid;
        cmp rax, 0;
        jne ccamw_fail_stage;

        mov rdi, 1;
        call ccam_dim_valid;
        cmp rax, 1;
        jne ccamw_fail_stage;
        mov rdi, 8192;
        call ccam_dim_valid;
        cmp rax, 1;
        jne ccamw_fail_stage;
        mov rdi, 8193;
        call ccam_dim_valid;
        cmp rax, 0;
        jne ccamw_fail_stage;
        mov rdi, 0;
        call ccam_dim_valid;
        cmp rax, 0;
        jne ccamw_fail_stage;

        // Setup: KIND_DEVICE parent at 21 with R_MINT, KIND_DEVICE
        // named by device_slot at 22 (no rights required).
        mov rdi, 21;
        mov rsi, 0x200;
        mov rdx, 0x0042;
        call ccamw_seed_device;

        mov rdi, 22;
        mov rsi, 0;
        mov rdx, 0x1234;
        call ccamw_seed_device;

        // packed_ids: device_slot=22 (0x0016), vendor=0x1B0F (OmniVision),
        //             sensor=0x5670 (OV5670).
        //   [15:0]  = 0x0016  (must be a live cap slot < CAP_SLOT_MAX=256;
        //                       the KIND_DEVICE seed above lands at slot 22)
        //   [31:16] = 0x1B0F
        //   [47:32] = 0x5670
        mov r14, 0x5670;
        shl r14, 16;
        or  r14, 0x1B0F;
        shl r14, 16;
        or  r14, 0x0016;

        // packed_geom: lanes=2, width=1920, height=1080.
        //   [7:0]   = 0x02
        //   [23:8]  = 0x0780
        //   [39:24] = 0x0438
        mov r15, 0x0438;
        shl r15, 16;
        or  r15, 0x0780;
        shl r15, 8;
        or  r15, 0x02;

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        mov rdi, 23;
        mov rsi, 20;                     // empty parent
        mov rdx, 0x419;
        mov rcx, 0xCA71C0DE00;
        mov r8, r14;
        mov r9, r15;
        call csi_camera_cap_mint_inner;
        mov r11, 0xFFFFF23D;
        cmp rax, r11;
        jne ccamw_fail_stage;

        // -- 3. BAD_DEVICE (device_slot 25 is empty).
        mov rax, 3;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        mov rdi, 23;
        mov rsi, 21;
        mov rdx, 0x419;
        mov rcx, 0xCA71C0DE01;
        // packed_ids with device_slot=25 (empty; slot 25 is inside
        // the cap-slot range but no seed was placed there).
        mov r8, 0x5670;
        shl r8, 16;
        or  r8, 0x1B0F;
        shl r8, 16;
        or  r8, 0x0019;                  // device_slot=25
        mov r9, r15;
        call csi_camera_cap_mint_inner;
        mov r11, 0xFFFFF23B;
        cmp rax, r11;
        jne ccamw_fail_stage;

        // -- 4. BAD_LANES (lanes = 5).
        mov rax, 4;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        mov rdi, 23;
        mov rsi, 21;
        mov rdx, 0x419;
        mov rcx, 0xCA71C0DE02;
        mov r8, r14;
        // packed_geom with lanes=5
        mov r9, 0x0438;
        shl r9, 16;
        or  r9, 0x0780;
        shl r9, 8;
        or  r9, 0x05;                    // lanes=5 (illegal)
        call csi_camera_cap_mint_inner;
        mov r11, 0xFFFFF238;
        cmp rax, r11;
        jne ccamw_fail_stage;

        // -- 5. BAD_WIDTH (width = 0).
        mov rax, 5;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        mov rdi, 23;
        mov rsi, 21;
        mov rdx, 0x419;
        mov rcx, 0xCA71C0DE03;
        mov r8, r14;
        // packed_geom with width=0
        mov r9, 0x0438;
        shl r9, 16;
        or  r9, 0;                       // width=0
        shl r9, 8;
        or  r9, 0x02;
        call csi_camera_cap_mint_inner;
        mov r11, 0xFFFFF237;
        cmp rax, r11;
        jne ccamw_fail_stage;

        // -- 6. BAD_HEIGHT (height = 8193).
        mov rax, 6;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        mov rdi, 23;
        mov rsi, 21;
        mov rdx, 0x419;
        mov rcx, 0xCA71C0DE04;
        mov r8, r14;
        // packed_geom with height=8193
        mov r9, 0x2001;                  // height=8193 (illegal)
        shl r9, 16;
        or  r9, 0x0780;
        shl r9, 8;
        or  r9, 0x02;
        call csi_camera_cap_mint_inner;
        mov r11, 0xFFFFF236;
        cmp rax, r11;
        jne ccamw_fail_stage;

        // -- 7. BAD_RIGHTS (bit outside R_CCAM_ALL).
        mov rax, 7;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        mov rdi, 23;
        mov rsi, 21;
        mov rdx, 0x800;                  // outside 0x419
        mov rcx, 0xCA71C0DE05;
        mov r8, r14;
        mov r9, r15;
        call csi_camera_cap_mint_inner;
        mov r11, 0xFFFFF23C;
        cmp rax, r11;
        jne ccamw_fail_stage;

        // -- 8. NO_KEY.
        mov rax, 8;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        mov rdi, 23;
        mov rsi, 21;
        mov rdx, 0x419;
        mov rcx, 0;                      // cam_key = 0
        mov r8, r14;
        mov r9, r15;
        call csi_camera_cap_mint_inner;
        mov r11, 0xFFFFF235;
        cmp rax, r11;
        jne ccamw_fail_stage;

        // -- 9. Happy path.
        mov rax, 9;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        mov rdi, 23;
        mov rsi, 21;
        mov rdx, 0x419;
        mov rcx, 0xCA71C0DE09;
        mov r8, r14;
        mov r9, r15;
        call csi_camera_cap_mint_inner;
        cmp rax, 0;
        jne ccamw_fail_stage;

        // -- 10. Query fields.
        mov rax, 10;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call ccam_row_key;
        mov r11, 0xCA71C0DE09;
        cmp rax, r11;
        jne ccamw_fail_stage;

        mov rdi, 0;
        call ccam_row_device;
        cmp rax, 22;
        jne ccamw_fail_stage;

        mov rdi, 0;
        call ccam_row_vendor;
        mov r11, 0x1B0F;
        cmp rax, r11;
        jne ccamw_fail_stage;

        mov rdi, 0;
        call ccam_row_sensor;
        mov r11, 0x5670;
        cmp rax, r11;
        jne ccamw_fail_stage;

        mov rdi, 0;
        call ccam_row_lanes;
        cmp rax, 2;
        jne ccamw_fail_stage;

        mov rdi, 0;
        call ccam_row_width;
        mov r11, 0x0780;                 // 1920
        cmp rax, r11;
        jne ccamw_fail_stage;

        mov rdi, 0;
        call ccam_row_height;
        mov r11, 0x0438;                 // 1080
        cmp rax, r11;
        jne ccamw_fail_stage;

        // -- 11. IN_USE (duplicate cam_key).
        mov rax, 11;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        mov rdi, 24;
        mov rsi, 21;
        mov rdx, 0x419;
        mov rcx, 0xCA71C0DE09;
        mov r8, r14;
        mov r9, r15;
        call csi_camera_cap_mint_inner;
        mov r11, 0xFFFFF234;
        cmp rax, r11;
        jne ccamw_fail_stage;

        // -- 12. Revoke round-trip.
        mov rax, 12;
        lea rcx, [rip + _ccamw_stage];
        mov [rcx], rax;

        mov rdi, 23;
        call csi_camera_cap_revoke_inner;
        cmp rax, 0;
        jne ccamw_fail_stage;

        mov rdi, 23;
        mov rsi, 21;
        mov rdx, 0x419;
        mov rcx, 0xCA71C0DE09;           // key free after revoke
        mov r8, r14;
        mov r9, r15;
        call csi_camera_cap_mint_inner;
        cmp rax, 0;
        jne ccamw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ccamw_ok];
        call klog_s1;

        call ccamw_scrub;
        call ccamw_clear;
        xor rax, rax;
        jmp ccamw_out;

      ccamw_fail_stage:
        lea rax, [rip + _ccamw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ccamw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ccamw_scrub;
        call ccamw_clear;
        mov rax, 1;

      ccamw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
