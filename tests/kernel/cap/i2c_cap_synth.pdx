// tests/kernel/cap/i2c_cap_synth.pdx — R30.M5-001 (#1070) / R30.M5-002 (#1071)
//
// Boot witness for the I²C capability pair: KIND_I2C_BUS (0x152) and
// KIND_I2C_SLAVE (0x153).
//
// -----------------------------------------------------------------------------
// What this fixture is for
// -----------------------------------------------------------------------------
//
// I²C is a shared bus: every peripheral hangs off the same two wires and
// the controller can address any of them. The claim this milestone makes
// is that a capability naming address A cannot reach address B, and that
// the claim is STRUCTURAL — not a check that could be forgotten, but a
// shape in which the wrong request cannot be phrased.
//
// A structural claim needs a structural witness. Sub-test O is the one
// that matters most: it calls the address resolver and the dispatch
// handler with a NEIGHBOURING DEVICE'S ADDRESS loaded into every
// register and every spare bit an added parameter could plausibly arrive
// in, and asserts the answer is still the capability's own address. That
// is the runtime half of the mutant argument; the compile-time half is
// the `i2c-addr-confine` step in tools/build.sh, which pins the literal
// arity of both resolvers so a mutant that adds an address parameter
// fails the build.
//
// Everything here drives the SHIPPING functions, linked into the real
// kernel. No I²C hardware is touched and no controller register is
// written — this milestone is capability structure only, and the
// capability structure exists entirely in kernel memory.
//
// -----------------------------------------------------------------------------
// Sub-tests
// -----------------------------------------------------------------------------
//
//   A  Reset both row tables; pre-clean cap slots 34..45.
//   B  Seed the base authorities: two KIND_DEVICE controllers with
//      distinct BDF keys, one wrong-kind cap, one KIND_DEVICE without
//      RIGHT_MINT.
//   C  THE BUS DERIVATION GATE, refused five ways: wrong parent kind,
//      right kind without MINT, rights outside R_I2C_BUS_ALL, a bus
//      rate that is not one of the four, and an out-of-range slot.
//      Nothing is written on any refusal.
//   D  The bus mints.
//   E  CONTROLLER IDENTITY IS INHERITED. The row's controller is the
//      parent KIND_DEVICE descriptor's target_ptr — and note that the
//      mint had no controller argument to get it from anywhere else.
//   F  A second bus, over a different controller.
//   G  A third bus minted WITHOUT RIGHT_MINT — legal, and the thing
//      sub-test H uses to prove the slave gate reads more than the kind.
//   H  THE SLAVE DERIVATION GATE, refused six ways: a KIND_DEVICE
//      parent (the bus's own base kind is not enough), a wrong-kind
//      parent, a real bus without MINT, rights outside R_I2C_SLAVE_ALL
//      (RIGHT_MINT itself, which this leaf kind does not carry), a zero
//      driver hint, and an out-of-range slot.
//   I  RESERVED ADDRESSES, REFUSED PER RANGE with distinct codes:
//      0x00 and 0x07 low, 0x78 and 0x7F high, 0x80 out of 7-bit range,
//      0x400 out of 10-bit range, and mode 2 unknown. No row allocated.
//   J  THE BOUNDARIES ARE USABLE: 0x08, 0x77 and 10-bit 0x3FF all mint,
//      and revoking each returns the row and the bus's device count.
//   K  Two slaves at different addresses coexist on one bus.
//   L  DUPLICATE ADDRESS REFUSED. The second mint at 0x1A on the same
//      bus returns ADDR_IN_USE, writes no descriptor and allocates no
//      row.
//   M  SAME ADDRESS, DIFFERENT BUS, PERMITTED — the assertion a global
//      address table would fail.
//   N  Same numeric address in the other framing permitted: 7-bit 0x1A
//      and 10-bit 0x01A are different devices on the wire.
//   O  ADDRESS CONFINEMENT + THE MUTANT. See above.
//   P  BUS REVOKE CASCADES. All three slaves of bus A go; the slave on
//      bus B is untouched.
//   Q  NO ROW LEAK. The freed rows are reusable and, crucially, the
//      freed ADDRESS is re-mintable — which is only true if the cascade
//      scrubbed the row rather than merely unlinking it.
//   R  Tearing down the remaining buses returns both tables to empty.
//   S  Revoke edges: idempotent on an empty slot, and neither kind's
//      revoke will touch the other's descriptor.
//   T  Clean up: slots 34..45 cleared, both tables reset.
//
// Slots 34..45 are outside the set every other witness consumes (0..8,
// 10..12, 14..19, 28..33), and both exits clear them.
//
// On any failure the stage number in _i2c_witness_stage identifies the
// assertion.

module I2cCapSynth = structure {

  // Stage tracker. Memory-backed rather than a register, matching
  // _evt_witness_stage and _kind_opreg_witness_stage: it has to survive
  // every callee-save-clobber pattern in the primitives under test.
  pub let mut _i2c_witness_stage : u64 = 0

  // Row ids captured across calls. Memory-backed for the same reason.
  pub let mut _i2c_w_bus_a_row : u64 = 0
  pub let mut _i2c_w_bus_b_row : u64 = 0
  pub let mut _i2c_w_row_x     : u64 = 0

  // ==========================================================================
  // i2c_w_seed(slot, kind, rights, target) -> ()
  // ==========================================================================

  pub let i2c_w_seed : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-001 (#1070): write a capability descriptor directly into cap_table[slot] (stride 24: kind at +0, rights at +8, target_ptr at +16). The fixture needs BASE authorities -- KIND_DEVICE descriptors with a bdf key in target_ptr -- that no mint path in this kernel produces yet: R22's device_cap_mint is still scaffolding that writes no descriptor. Seeding them directly is what makes the derivation gate testable in BOTH directions rather than only in the refusing one, which is the difference between a gate that is checked and a gate that is merely present. Same device as the op-region witness's base-authority preamble. Leaf. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov [rax + 0],  rsi;
        mov [rax + 8],  rdx;
        mov [rax + 16], rcx;
        ret
      }
    }

  // ==========================================================================
  // i2c_w_kind(slot) -> kind
  // ==========================================================================

  pub let i2c_w_kind : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-001 (#1070): read cap_table[slot].kind. Every 'nothing was written' and 'the descriptor was cleared' assertion in this fixture goes through this one accessor, so a refusal that silently wrote a descriptor cannot pass by being asserted with a differently-shaped read somewhere else. Leaf, pure read. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 0];
        ret
      }
    }

  // ==========================================================================
  // i2c_w_clear_slots() -> ()
  // ==========================================================================

  pub let i2c_w_clear_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-001 (#1070): zero cap_table slots 34..45 (offset 34*24 = 816, twelve slots of 24 bytes = 288 bytes). Called at both entry and both exits so this fixture leaves the capability table exactly as it found it, and so a failing run cannot poison a later witness with a half-built bus. Twelve slots is the whole range this fixture uses; the set is disjoint from every other witness's (0..8, 10..12, 14..19, 28..33). Leaf. Reserved labels: i2c_wc_.",
      block: {
        mov rax, cap_table;
        add rax, 816;
        xor rcx, rcx;
        xor r8, r8;

      i2c_wc_loop:
        cmp r8, 36;                      // 12 slots * 3 qwords
        jae i2c_wc_done;
        mov [rax], rcx;
        add rax, 8;
        add r8, 1;
        jmp i2c_wc_loop;

      i2c_wc_done:
        ret
      }
    }

  // ==========================================================================
  // i2c_cap_witness() -> u64
  // ==========================================================================

  pub let i2c_cap_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-001 (#1070) / R30.M5-002 (#1071): boot witness for the KIND_I2C_BUS and KIND_I2C_SLAVE derivation gates, controller-identity inheritance, the per-range reserved-address policy, the duplicate-address refusal, same-address-different-bus coexistence, mode disambiguation, ADDRESS CONFINEMENT INCLUDING A RUNTIME MUTANT, the bus-to-slave cascade and the absence of row leaks across a mint/revoke cycle. Drives the shipping functions linked into the real kernel; touches no I2C hardware and writes no controller register, because this milestone is capability structure only and that structure lives entirely in kernel memory. Five pushes (rbx, r12, r13, r14, r15) leave rsp%16 == 0 at every nested call; all cross-call state that is not in those registers lives in module .bss for the same reason the stage counter does. Both exits call i2c_w_clear_slots, i2c_bus_table_reset and i2c_slave_table_reset, so a failure cannot leave a half-built bus or a stranded row behind for a later witness to trip over. Labels prefixed i2c_w_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // A. Reset both tables; pre-clean the slot range.
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        call i2c_bus_table_reset;
        call i2c_slave_table_reset;
        call i2c_w_clear_slots;

        call i2c_bus_rows_live;
        cmp rax, 0;
        jne i2c_w_fail;
        call i2c_slave_rows_live;
        cmp rax, 0;
        jne i2c_w_fail;

        // ================================================================
        // B. Seed the base authorities.
        //
        //   34  KIND_DEVICE, INVOKE|MINT, controller 0x1500
        //   35  KIND_DEVICE, INVOKE|MINT, controller 0x1501
        //   36  KIND_PAGE (4), MINT — the wrong kind entirely
        //   37  KIND_DEVICE, INVOKE only — right kind, no MINT
        // ================================================================
        mov rax, 2;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 34;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x208;                  // RIGHT_INVOKE | RIGHT_MINT
        mov rcx, 0x1500;                 // bdf key (bus 0, dev 0x15, fn 0)
        call i2c_w_seed;

        mov rdi, 35;
        mov rsi, 10;
        mov rdx, 0x208;
        mov rcx, 0x1501;                 // a DIFFERENT controller
        call i2c_w_seed;

        mov rdi, 36;
        mov rsi, 4;                      // KIND_PAGE
        mov rdx, 0x208;
        mov rcx, 0x1500;
        call i2c_w_seed;

        mov rdi, 37;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x008;                  // INVOKE only — no MINT
        mov rcx, 0x1500;
        call i2c_w_seed;

        // ================================================================
        // C. THE BUS DERIVATION GATE — refused five ways.
        // ================================================================
        mov rax, 3;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        // (1) parent is the wrong kind.
        mov rdi, 38;
        mov rsi, 36;
        mov rdx, 0x618;
        mov rcx, 400000;
        call i2c_bus_cap_mint;
        mov r15, 0xFFFFFF8D;             // I2C_BUS_MINT_BAD_PARENT
        cmp rax, r15;
        jne i2c_w_fail;

        // (2) parent is the right kind but carries no RIGHT_MINT.
        mov rdi, 38;
        mov rsi, 37;
        mov rdx, 0x618;
        mov rcx, 400000;
        call i2c_bus_cap_mint;
        mov r15, 0xFFFFFF8D;
        cmp rax, r15;
        jne i2c_w_fail;

        // (3) rights outside R_I2C_BUS_ALL. RIGHT_READ is not on this
        //     kind at all — the bus authorises no transaction.
        mov rdi, 38;
        mov rsi, 34;
        mov rdx, 0x001;
        mov rcx, 400000;
        call i2c_bus_cap_mint;
        mov r15, 0xFFFFFF8C;             // I2C_BUS_MINT_BAD_RIGHTS
        cmp rax, r15;
        jne i2c_w_fail;

        // (4) a rate that is not one of the four.
        mov rdi, 38;
        mov rsi, 34;
        mov rdx, 0x618;
        mov rcx, 123456;
        call i2c_bus_cap_mint;
        mov r15, 0xFFFFFF89;             // I2C_BUS_MINT_BAD_SPEED
        cmp rax, r15;
        jne i2c_w_fail;

        // (5) an out-of-range destination slot.
        mov rdi, 256;
        mov rsi, 34;
        mov rdx, 0x618;
        mov rcx, 400000;
        call i2c_bus_cap_mint;
        mov r15, 0xFFFFFF8B;             // I2C_BUS_MINT_BAD_ARG
        cmp rax, r15;
        jne i2c_w_fail;

        // Nothing was written and no row was consumed.
        mov rdi, 38;
        call i2c_w_kind;
        cmp rax, 0;
        jne i2c_w_fail;
        call i2c_bus_rows_live;
        cmp rax, 0;
        jne i2c_w_fail;

        // ================================================================
        // D. The bus mints.
        // ================================================================
        mov rax, 4;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 38;
        mov rsi, 34;
        mov rdx, 0x618;                  // R_I2C_BUS_ALL
        mov rcx, 400000;                 // Fast mode
        call i2c_bus_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, 38;
        call i2c_w_kind;
        mov r15, 0x152;                  // KIND_I2C_BUS
        cmp rax, r15;
        jne i2c_w_fail;

        // ================================================================
        // E. CONTROLLER IDENTITY IS INHERITED, NOT ARGUED.
        //
        // Note what is NOT in the mint above: a controller argument.
        // The row's identity can only have come from the parent
        // KIND_DEVICE descriptor's target_ptr.
        // ================================================================
        mov rax, 5;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 38;
        call i2c_bus_row_of_slot;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je i2c_w_fail;
        lea rcx, [rip + _i2c_w_bus_a_row];
        mov [rcx], rax;
        mov r12, rax;                    // bus A row

        mov rdi, r12;
        call i2c_bus_row_controller;
        mov r15, 0x1500;                 // the PARENT's bdf key
        cmp rax, r15;
        jne i2c_w_fail;

        mov rdi, r12;
        call i2c_bus_row_speed;
        mov r15, 400000;
        cmp rax, r15;
        jne i2c_w_fail;

        mov rdi, r12;
        call i2c_bus_row_parent;
        cmp rax, 34;
        jne i2c_w_fail;

        mov rdi, r12;
        call i2c_bus_row_slaves;
        cmp rax, 0;
        jne i2c_w_fail;

        // ================================================================
        // F. A second bus over a DIFFERENT controller.
        // ================================================================
        mov rax, 6;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 39;
        mov rsi, 35;
        mov rdx, 0x618;
        mov rcx, 100000;                 // Standard mode
        call i2c_bus_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, 39;
        call i2c_bus_row_of_slot;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je i2c_w_fail;
        lea rcx, [rip + _i2c_w_bus_b_row];
        mov [rcx], rax;
        mov r13, rax;                    // bus B row

        mov rdi, r13;
        call i2c_bus_row_controller;
        mov r15, 0x1501;
        cmp rax, r15;
        jne i2c_w_fail;

        // The two buses are distinct rows.
        cmp r12, r13;
        je i2c_w_fail;

        // ================================================================
        // G. A third bus, minted WITHOUT RIGHT_MINT. Legal — and the
        //    thing sub-test H uses to show the slave gate reads the
        //    rights and not only the kind.
        // ================================================================
        mov rax, 7;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 41;
        mov rsi, 34;
        mov rdx, 0x008;                  // INVOKE only — no MINT
        mov rcx, 1000000;                // Fast mode Plus
        call i2c_bus_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        call i2c_bus_rows_live;
        cmp rax, 3;
        jne i2c_w_fail;

        // ================================================================
        // H. THE SLAVE DERIVATION GATE — refused six ways.
        // ================================================================
        mov rax, 8;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        // (1) a KIND_DEVICE parent. The bus's own BASE kind is not
        //     enough: without the bus capability nothing has established
        //     that this controller is an I²C bus at a validated rate.
        mov rdi, 45;
        mov rsi, 34;
        mov rdx, 0x41B;
        mov rcx, 0x1A;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF7D;             // I2C_SLAVE_MINT_BAD_PARENT
        cmp rax, r15;
        jne i2c_w_fail;

        // (2) a wrong-kind parent.
        mov rdi, 45;
        mov rsi, 36;
        mov rdx, 0x41B;
        mov rcx, 0x1A;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF7D;
        cmp rax, r15;
        jne i2c_w_fail;

        // (3) a REAL bus that does not carry RIGHT_MINT.
        mov rdi, 45;
        mov rsi, 41;
        mov rdx, 0x41B;
        mov rcx, 0x1A;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF7D;
        cmp rax, r15;
        jne i2c_w_fail;

        // (4) rights outside R_I2C_SLAVE_ALL. RIGHT_MINT itself: this
        //     kind is a leaf of the derivation lattice.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x200;
        mov rcx, 0x1A;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF7C;             // I2C_SLAVE_MINT_BAD_RIGHTS
        cmp rax, r15;
        jne i2c_w_fail;

        // (5) a zero driver hint.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x1A;
        mov r8, 0;
        mov r9, 0;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF74;             // I2C_SLAVE_MINT_BAD_HINT
        cmp rax, r15;
        jne i2c_w_fail;

        // (6) an out-of-range destination slot.
        mov rdi, 256;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x1A;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF7B;             // I2C_SLAVE_MINT_BAD_ARG
        cmp rax, r15;
        jne i2c_w_fail;

        mov rdi, 45;
        call i2c_w_kind;
        cmp rax, 0;
        jne i2c_w_fail;
        call i2c_slave_rows_live;
        cmp rax, 0;
        jne i2c_w_fail;

        // ================================================================
        // I. RESERVED ADDRESSES, REFUSED PER RANGE.
        // ================================================================
        mov rax, 9;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        // 0x00 — the general call address.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x00;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF77;             // ADDR_RESERVED_LOW
        cmp rax, r15;
        jne i2c_w_fail;

        // 0x07 — the last Hs-mode master code.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x07;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF77;
        cmp rax, r15;
        jne i2c_w_fail;

        // 0x78 — the TEN-BIT ADDRESSING PREFIX. The confinement-critical
        //        one: a 7-bit capability here would reach a 256-address
        //        space.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x78;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF76;             // ADDR_RESERVED_HIGH
        cmp rax, r15;
        jne i2c_w_fail;

        // 0x7F — the top of the reserved high range.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x7F;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF76;
        cmp rax, r15;
        jne i2c_w_fail;

        // 0x80 — outside the 7-bit numeric range entirely. A DIFFERENT
        //        code from the reserved ranges, because "you asked for
        //        something that is not an address" and "you asked for an
        //        address the spec keeps" are different mistakes.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x80;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF78;             // ADDR_RANGE
        cmp rax, r15;
        jne i2c_w_fail;

        // 0x400 — outside the 10-bit range.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x400;
        mov r8, 1;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF78;
        cmp rax, r15;
        jne i2c_w_fail;

        // mode 2 — there are exactly two addressing modes.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x1A;
        mov r8, 2;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF79;             // BAD_MODE
        cmp rax, r15;
        jne i2c_w_fail;

        // Seven refusals, no descriptor and no row.
        mov rdi, 45;
        call i2c_w_kind;
        cmp rax, 0;
        jne i2c_w_fail;
        call i2c_slave_rows_live;
        cmp rax, 0;
        jne i2c_w_fail;

        // ================================================================
        // J. THE BOUNDARIES ARE USABLE, and revoking returns the row.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        // 0x08 — the first usable 7-bit address.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x08;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, r12;
        call i2c_bus_row_slaves;
        cmp rax, 1;
        jne i2c_w_fail;

        mov rdi, 45;
        call i2c_slave_cap_revoke;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, r12;
        call i2c_bus_row_slaves;
        cmp rax, 0;
        jne i2c_w_fail;

        // 0x77 — the last usable 7-bit address.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x77;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, 45;
        call i2c_slave_cap_revoke;
        cmp rax, 0;
        jne i2c_w_fail;

        // 10-bit 0x3FF — the top of the 10-bit space, which is entirely
        // usable because the 11110xx prefix distinguishes the framing.
        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x3FF;
        mov r8, 1;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, 45;
        call i2c_slave_cap_revoke;
        cmp rax, 0;
        jne i2c_w_fail;

        call i2c_slave_rows_live;
        cmp rax, 0;
        jne i2c_w_fail;

        // ================================================================
        // K. Two slaves at different addresses coexist on one bus.
        // ================================================================
        mov rax, 11;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 40;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x1A;
        mov r8, 0;
        mov r9, 0xD1;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, 42;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x2C;
        mov r8, 0;
        mov r9, 0xD2;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, r12;
        call i2c_bus_row_slaves;
        cmp rax, 2;
        jne i2c_w_fail;

        call i2c_slave_rows_live;
        cmp rax, 2;
        jne i2c_w_fail;

        // ================================================================
        // L. DUPLICATE ADDRESS ON THE SAME BUS — REFUSED.
        //
        // Two independent owners of one I²C peripheral interleave
        // register-pointer-then-read sequences and silently read each
        // other's data. A device that must be shared needs an arbiter,
        // which is a thing you build, not a thing you get by minting
        // the capability twice.
        // ================================================================
        mov rax, 12;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 45;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x1A;
        mov r8, 0;
        mov r9, 0xD3;                    // a different driver
        call i2c_slave_cap_mint;
        mov r15, 0xFFFFFF75;             // I2C_SLAVE_MINT_ADDR_IN_USE
        cmp rax, r15;
        jne i2c_w_fail;

        mov rdi, 45;
        call i2c_w_kind;
        cmp rax, 0;
        jne i2c_w_fail;

        call i2c_slave_rows_live;
        cmp rax, 2;
        jne i2c_w_fail;

        mov rdi, r12;
        call i2c_bus_row_slaves;
        cmp rax, 2;
        jne i2c_w_fail;

        // ================================================================
        // M. SAME ADDRESS ON A DIFFERENT BUS — PERMITTED.
        //
        // 0x1A on the touchpad controller and 0x1A on the sensor hub
        // are two devices on two pairs of wires. A global address table
        // would refuse this, and would make an ordinary board unbootable.
        // ================================================================
        mov rax, 13;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 43;
        mov rsi, 39;                     // the OTHER bus
        mov rdx, 0x41B;
        mov rcx, 0x1A;                   // the SAME address
        mov r8, 0;
        mov r9, 0xD4;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, r13;
        call i2c_bus_row_slaves;
        cmp rax, 1;
        jne i2c_w_fail;

        mov rdi, r12;
        call i2c_bus_row_slaves;
        cmp rax, 2;
        jne i2c_w_fail;

        call i2c_slave_rows_live;
        cmp rax, 3;
        jne i2c_w_fail;

        // ================================================================
        // N. The same number in the OTHER framing is a different device.
        // ================================================================
        mov rax, 14;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 44;
        mov rsi, 38;                     // the SAME bus as slot 40
        mov rdx, 0x41B;
        mov rcx, 0x1A;                   // the SAME number
        mov r8, 1;                       // but TEN-BIT framing
        mov r9, 0xD5;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, r12;
        call i2c_bus_row_slaves;
        cmp rax, 3;
        jne i2c_w_fail;

        call i2c_slave_rows_live;
        cmp rax, 4;
        jne i2c_w_fail;

        // ================================================================
        // O. ADDRESS CONFINEMENT — AND THE MUTANT.
        //
        // Every call below loads a NEIGHBOURING DEVICE'S ADDRESS into
        // every register and every spare bit an added address parameter
        // could plausibly arrive in, and asserts the answer is still
        // the capability's own address.
        //
        // The compile-time half of this argument is the
        // `i2c-addr-confine` step in tools/build.sh, which pins the
        // literal arity of i2c_slave_addr_of_slot and
        // i2c_slave_row_addr; the two halves together are why "address
        // a device other than mine" is unphrasable rather than refused.
        // ================================================================
        mov rax, 15;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        // The honest question first.
        mov rdi, 40;
        call i2c_slave_addr_of_slot;
        mov r15, 0x1A;
        cmp rax, r15;
        jne i2c_w_fail;

        // THE MUTANT. Slot 40's capability names 0x1A. Load slot 42's
        // address, 0x2C, into every argument register a second
        // parameter would land in. The resolver takes one argument, so
        // there is nowhere for the smuggled value to be read from.
        mov rdi, 40;
        mov rsi, 0x2C;
        mov rdx, 0x2C;
        mov rcx, 0x2C;
        mov r8,  0x2C;
        mov r9,  0x2C;
        call i2c_slave_addr_of_slot;
        mov r15, 0x1A;
        cmp rax, r15;
        jne i2c_w_fail;

        // And symmetrically: slot 42 cannot be talked into 0x1A.
        mov rdi, 42;
        mov rsi, 0x1A;
        mov rdx, 0x1A;
        mov rcx, 0x1A;
        mov r8,  0x1A;
        mov r9,  0x1A;
        call i2c_slave_addr_of_slot;
        mov r15, 0x2C;
        cmp rax, r15;
        jne i2c_w_fail;

        // Capture slot 40's row for the dispatch-path checks.
        mov rdi, 40;
        call i2c_w_kind;
        mov r15, 0x153;                  // KIND_I2C_SLAVE
        cmp rax, r15;
        jne i2c_w_fail;

        mov rax, cap_table;
        add rax, 960;                    // slot 40 * 24
        mov r14, [rax + 16];
        mov r15, 0xFFFF;
        and r14, r15;                    // slot 40's row_id
        lea rcx, [rip + _i2c_w_row_x];
        mov [rcx], r14;

        // The dispatch path, honestly.
        mov rdi, 0x41B;                  // R_I2C_SLAVE_ALL
        mov rsi, r14;
        mov rdx, 0;                      // QUERY_ADDR
        call cap_handler_i2c_slave;
        mov r15, 0x1A;
        cmp rax, r15;
        jne i2c_w_fail;

        // THE MUTANT, DISPATCH FORM. op_arg is the only caller-supplied
        // word the handler reads, and its top fifty-six bits are
        // discarded before any dispatch decision. Pack 0x2C into them.
        mov rdi, 0x41B;
        mov rsi, r14;
        mov rdx, 0x2C00;                 // op 0, with 0x2C smuggled above
        call cap_handler_i2c_slave;
        mov r15, 0x1A;
        cmp rax, r15;
        jne i2c_w_fail;

        // Same, with every high bit set.
        mov rdi, 0x41B;
        mov rsi, r14;
        mov rdx, 0xFFFFFFFFFFFFFF00;
        call cap_handler_i2c_slave;
        mov r15, 0x1A;
        cmp rax, r15;
        jne i2c_w_fail;

        // The mode and bus queries answer from the row too.
        mov rdi, 0x41B;
        mov rsi, r14;
        mov rdx, 1;                      // QUERY_MODE
        call cap_handler_i2c_slave;
        cmp rax, 0;                      // 7-bit
        jne i2c_w_fail;

        mov rdi, 0x41B;
        mov rsi, r14;
        mov rdx, 2;                      // QUERY_BUS
        call cap_handler_i2c_slave;
        cmp rax, 38;
        jne i2c_w_fail;

        // Rights are enforced per op: OBSERVE alone cannot query.
        mov rdi, 0x400;
        mov rsi, r14;
        mov rdx, 0;
        call cap_handler_i2c_slave;
        mov r15, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r15;
        jne i2c_w_fail;

        // There is no fifth query op, and in particular no transfer op.
        mov rdi, 0x41B;
        mov rsi, r14;
        mov rdx, 9;
        call cap_handler_i2c_slave;
        mov r15, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        cmp rax, r15;
        jne i2c_w_fail;

        // ================================================================
        // P. BUS REVOKE CASCADES TO ITS SLAVES.
        // ================================================================
        mov rax, 16;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 38;
        call i2c_bus_cap_revoke;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, 38;
        call i2c_w_kind;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, 40;
        call i2c_w_kind;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, 42;
        call i2c_w_kind;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, 44;
        call i2c_w_kind;
        cmp rax, 0;
        jne i2c_w_fail;

        // The OTHER bus's device is untouched. A cascade that swept by
        // address rather than by parent row would have taken it: slot
        // 43 holds 0x1A, the same address slot 40 held.
        mov rdi, 43;
        call i2c_w_kind;
        mov r15, 0x153;
        cmp rax, r15;
        jne i2c_w_fail;

        call i2c_slave_rows_live;
        cmp rax, 1;
        jne i2c_w_fail;

        mov rdi, r13;
        call i2c_bus_row_slaves;
        cmp rax, 1;
        jne i2c_w_fail;

        call i2c_bus_rows_live;
        cmp rax, 2;
        jne i2c_w_fail;

        // ================================================================
        // Q. NO ROW LEAK — and the freed ADDRESS is re-mintable, which
        //    is only true if the cascade SCRUBBED the rows rather than
        //    merely unlinking them.
        // ================================================================
        mov rax, 17;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 38;
        mov rsi, 34;
        mov rdx, 0x618;
        mov rcx, 1000000;
        call i2c_bus_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        call i2c_bus_rows_live;
        cmp rax, 3;
        jne i2c_w_fail;

        mov rdi, 38;
        call i2c_bus_row_of_slot;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je i2c_w_fail;
        mov r12, rax;                    // the new bus A row

        mov rdi, r12;
        call i2c_bus_row_slaves;
        cmp rax, 0;
        jne i2c_w_fail;

        // The address the cascade took back is claimable again.
        mov rdi, 40;
        mov rsi, 38;
        mov rdx, 0x41B;
        mov rcx, 0x1A;
        mov r8, 0;
        mov r9, 0xD6;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne i2c_w_fail;

        call i2c_slave_rows_live;
        cmp rax, 2;
        jne i2c_w_fail;

        // ================================================================
        // R. Tearing the rest down returns both tables to empty.
        // ================================================================
        mov rax, 18;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 39;
        call i2c_bus_cap_revoke;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, 43;
        call i2c_w_kind;
        cmp rax, 0;
        jne i2c_w_fail;

        call i2c_slave_rows_live;
        cmp rax, 1;
        jne i2c_w_fail;

        mov rdi, 38;
        call i2c_bus_cap_revoke;
        cmp rax, 0;
        jne i2c_w_fail;

        mov rdi, 41;
        call i2c_bus_cap_revoke;
        cmp rax, 0;
        jne i2c_w_fail;

        call i2c_slave_rows_live;
        cmp rax, 0;
        jne i2c_w_fail;
        call i2c_bus_rows_live;
        cmp rax, 0;
        jne i2c_w_fail;

        // ================================================================
        // S. Revoke edges. Neither kind's revoke will touch the other's
        //    descriptor, and neither will touch a base capability.
        // ================================================================
        mov rax, 19;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        mov rdi, 45;
        call i2c_bus_cap_revoke;
        mov r15, 0xFFFFFF85;             // I2C_BUS_REVOKE_ALREADY
        cmp rax, r15;
        jne i2c_w_fail;

        mov rdi, 45;
        call i2c_slave_cap_revoke;
        mov r15, 0xFFFFFF71;             // I2C_SLAVE_REVOKE_ALREADY
        cmp rax, r15;
        jne i2c_w_fail;

        mov rdi, 34;
        call i2c_bus_cap_revoke;
        mov r15, 0xFFFFFF86;             // I2C_BUS_REVOKE_WRONG_KIND
        cmp rax, r15;
        jne i2c_w_fail;

        mov rdi, 34;
        call i2c_slave_cap_revoke;
        mov r15, 0xFFFFFF72;             // I2C_SLAVE_REVOKE_WRONG_KIND
        cmp rax, r15;
        jne i2c_w_fail;

        // The base authority survived both.
        mov rdi, 34;
        call i2c_w_kind;
        cmp rax, 10;
        jne i2c_w_fail;

        // ================================================================
        // T. Leave the table and both row tables as we found them.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _i2c_witness_stage];
        mov [rcx], rax;

        call i2c_w_clear_slots;
        call i2c_bus_table_reset;
        call i2c_slave_table_reset;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kind_i2c_ok_msg];
        call klog_s1;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      i2c_w_fail:
        call i2c_w_clear_slots;
        call i2c_bus_table_reset;
        call i2c_slave_table_reset;

        lea rax, [rip + _i2c_witness_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kind_i2c_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
