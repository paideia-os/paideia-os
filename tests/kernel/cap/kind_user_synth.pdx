// tests/kernel/cap/kind_user_synth.pdx -- R48.M1-004 (#1520)
//
// Boot witness for KIND_USER. Exercises the mint walker, the four
// refusal codes on the mint gate, and THE cascade-revocation
// invariant #1520 exists to pin: killing a founder cap frees every
// user that transitively descends from it, in ONE call, with no
// scavenger left behind.
//
// The chain is TWO derivations deep -- founder -> alice ->
// alice_work -- not one, so a first implementation that only frees
// direct children (a flat scan rather than a recursive walk) fails
// to close the invariant. §2 of kind_user.pdx expands on why that is
// exactly the class of mistake #1520 is here to refuse.
//
// Fingerprint: R48 KIND_USER OK  (single stage; no numeric stage
// because every step feeds the same invariant).
//
// Cap slots 104..106. 104 = well-formed KIND_HW parent (RIGHT_MINT
// present, non-zero target_ptr as an "identity" -- this is only
// consulted by user_check_parent_hw's second half). 105 = KIND_HW
// parent WITHOUT RIGHT_MINT (used to demonstrate the mint gate
// refuses a well-formed parent that does not carry mint authority).
// 106 = spare / bad-kind parent.

module KindUserSynth = structure {

  pub let mut _kuw_stage : u64 = 0

  pub let kuw_ok   : [u8; 13] = "KIND_USER OK\0"
  pub let kuw_fail : [u8; 15] = "KIND_USER FAIL\0"

  // -------------------------------------------------------------------------
  // kuw_hw(slot, key, rights) -- write a synthetic KIND_HW parent.
  // -------------------------------------------------------------------------

  pub let kuw_hw : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48.M1-004 (#1520): mint a synthetic KIND_HW parent cap into a slot via cap_mint_write. The mint gate under test reads exactly kind (= 14) and rights (bit 0x200 for RIGHT_MINT); a real firmware-issued KIND_HW is not needed because it is those two fields that the gate consults, not the identity beneath them. Three pushes leave rsp%16 == 0 at the nested call. Labels prefixed kuw_hw_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 14;                     // KIND_HW
        mov rdx, r14;                    // rights
        mov rcx, r13;                    // target_ptr = key (arbitrary)
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // -------------------------------------------------------------------------
  // kuw_clear() -- return slots 104..106 to boot state.
  // -------------------------------------------------------------------------

  pub let kuw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48.M1-004 (#1520): clear cap_table slots 104..106 through cap_mint_write so R31.M1-1587's owner clear runs on every one of them. Called on both exits: a witness whose failure path leaked descriptors would make every subsequent witness report a different fault than the one that happened. Two pushes leave rsp%16 == 0. Labels prefixed kuw_wc_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 104;
      kuw_wc_loop:
        cmp rbx, 107;
        jae kuw_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp kuw_wc_loop;
      kuw_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  // -------------------------------------------------------------------------
  // The witness.
  // -------------------------------------------------------------------------

  pub let kind_user_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R48.M1-004 (#1520): boot witness for KIND_USER. Stages: (1) reset; (2) rights_valid subset test in both directions; (3) quota_valid at 0, ceiling, ceiling+1; (4) parent gate refuses NO-MINT and BAD-KIND parents; (5) mint founder via the walker; (6) mint alice under founder; (7) mint alice_work under alice; (8) refuse a duplicate user_key; (9) refuse a delegation whose parent does not exist; (10) THE CASCADE -- revoke founder, assert all three rows dead in one operation. Five callee-save pushes leave rsp%16 == 0 at every nested call. Both exits clear slots + reset the row table. Labels prefixed kuw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) Reset.
        mov rax, 1;
        lea rcx, [rip + _kuw_stage];
        mov [rcx], rax;
        call kuw_clear;
        call user_table_reset;

        // Set up synthetic KIND_HW parents.
        mov rdi, 104;
        mov rsi, 0xC0FE;
        mov rdx, 0x200;                  // RIGHT_MINT
        call kuw_hw;
        mov rdi, 105;
        mov rsi, 0xC0FF;
        mov rdx, 0x001;                  // no RIGHT_MINT
        call kuw_hw;
        // 106 : leave zero (kind == KIND_NULL); the gate refuses on
        // kind != 14.
        mov rdi, 106;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // (2) rights_valid.
        mov rax, 2;
        lea rcx, [rip + _kuw_stage];
        mov [rcx], rax;
        mov rdi, 0x619;                  // R_USER_ALL
        call user_rights_valid;
        cmp rax, 1;
        jne kuw_fail_stage;
        mov rdi, 0x2000;                 // out of R_USER_ALL
        call user_rights_valid;
        cmp rax, 0;
        jne kuw_fail_stage;

        // (3) quota_valid.
        mov rax, 3;
        lea rcx, [rip + _kuw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call user_quota_valid;
        cmp rax, 1;
        jne kuw_fail_stage;
        mov r11, 0x10000000000;          // USER_QUOTA_MAX
        mov rdi, r11;
        call user_quota_valid;
        cmp rax, 1;
        jne kuw_fail_stage;
        mov r11, 0x10000000001;          // ceiling + 1
        mov rdi, r11;
        call user_quota_valid;
        cmp rax, 0;
        jne kuw_fail_stage;

        // (4) parent gate.
        mov rax, 4;
        lea rcx, [rip + _kuw_stage];
        mov [rcx], rax;
        mov rdi, 104;
        call user_check_parent_hw;
        cmp rax, 1;
        jne kuw_fail_stage;
        mov rdi, 105;
        call user_check_parent_hw;
        cmp rax, 0;
        jne kuw_fail_stage;
        mov rdi, 106;
        call user_check_parent_hw;
        cmp rax, 0;
        jne kuw_fail_stage;

        // (5) Mint founder. user_key = 0xF001, no delegated_by.
        mov rax, 5;
        lea rcx, [rip + _kuw_stage];
        mov [rcx], rax;
        mov rdi, 104;                    // parent_slot (KIND_HW + MINT)
        mov rsi, 0x619;                  // rights
        mov rdx, 0xF001;                 // user_key
        mov rcx, 0x10000000;             // quota_bytes (arbitrary, below ceiling)
        mov r8,  0x11111111;             // created_ns
        mov r9,  0;                      // delegated_by_key = founder
        call user_cap_mint_inner;
        // Success -> row_id in [0, USER_MAX). Failure codes live at
        // 0xFFFFED3x -- refuse them.
        mov r10, 16;                     // USER_MAX
        cmp rax, r10;
        jae kuw_fail_stage;
        mov r12, rax;                    // founder row_id

        // (6) Mint alice. user_key = 0xA001, delegated_by = founder's key.
        mov rax, 6;
        lea rcx, [rip + _kuw_stage];
        mov [rcx], rax;
        mov rdi, 104;
        mov rsi, 0x619;
        mov rdx, 0xA001;
        mov rcx, 0x08000000;
        mov r8,  0x22222222;
        mov r9,  0xF001;                 // delegated_by = founder
        call user_cap_mint_inner;
        mov r10, 16;
        cmp rax, r10;
        jae kuw_fail_stage;
        mov r13, rax;                    // alice row_id

        // (7) Mint alice_work. user_key = 0xA002, delegated_by = alice.
        mov rax, 7;
        lea rcx, [rip + _kuw_stage];
        mov [rcx], rax;
        mov rdi, 104;
        mov rsi, 0x619;
        mov rdx, 0xA002;
        mov rcx, 0x01000000;
        mov r8,  0x33333333;
        mov r9,  0xA001;                 // delegated_by = alice
        call user_cap_mint_inner;
        mov r10, 16;
        cmp rax, r10;
        jae kuw_fail_stage;
        mov r14, rax;                    // alice_work row_id

        // Sanity: three distinct row_ids.
        cmp r12, r13;
        je  kuw_fail_stage;
        cmp r12, r14;
        je  kuw_fail_stage;
        cmp r13, r14;
        je  kuw_fail_stage;

        // (8) Duplicate user_key refused with USER_MINT_KEY_INUSE.
        mov rax, 8;
        lea rcx, [rip + _kuw_stage];
        mov [rcx], rax;
        mov rdi, 104;
        mov rsi, 0x619;
        mov rdx, 0xF001;                 // same as founder
        mov rcx, 0x01000000;
        mov r8,  0x44444444;
        mov r9,  0;
        call user_cap_mint_inner;
        mov r10, 0xFFFFED3A;             // USER_MINT_KEY_INUSE
        cmp rax, r10;
        jne kuw_fail_stage;

        // (9) Delegation naming a non-existent parent refused with
        //     USER_MINT_NO_PARENT.
        mov rax, 9;
        lea rcx, [rip + _kuw_stage];
        mov [rcx], rax;
        mov rdi, 104;
        mov rsi, 0x619;
        mov rdx, 0xBEEF;                 // fresh key
        mov rcx, 0x01000000;
        mov r8,  0x55555555;
        mov r9,  0xDEAD;                 // no live row holds 0xDEAD
        call user_cap_mint_inner;
        mov r10, 0xFFFFED38;             // USER_MINT_NO_PARENT
        cmp rax, r10;
        jne kuw_fail_stage;

        // Pre-cascade: all three rows must be live.
        mov rdi, r12;
        call user_tail_valid;
        cmp rax, 1;
        jne kuw_fail_stage;
        mov rdi, r13;
        call user_tail_valid;
        cmp rax, 1;
        jne kuw_fail_stage;
        mov rdi, r14;
        call user_tail_valid;
        cmp rax, 1;
        jne kuw_fail_stage;

        // (10) THE CASCADE. Revoke founder -> alice AND alice_work
        //      must both be dead in the same operation.
        mov rax, 10;
        lea rcx, [rip + _kuw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call user_cap_revoke_cascade;
        cmp rax, 0;                      // USER_OK
        jne kuw_fail_stage;

        mov rdi, r12;
        call user_tail_valid;
        cmp rax, 0;
        jne kuw_fail_stage;
        mov rdi, r13;
        call user_tail_valid;
        cmp rax, 0;
        jne kuw_fail_stage;
        mov rdi, r14;
        call user_tail_valid;
        cmp rax, 0;
        jne kuw_fail_stage;

        // Success.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kuw_ok];
        call klog_s1;

        call kuw_clear;
        call user_table_reset;
        xor rax, rax;
        jmp kuw_out;

      kuw_fail_stage:
        lea rax, [rip + _kuw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kuw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call kuw_clear;
        call user_table_reset;
        mov rax, 1;

      kuw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
