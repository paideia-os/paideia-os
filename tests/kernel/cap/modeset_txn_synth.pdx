// tests/kernel/cap/modeset_txn_synth.pdx — R36.M3-001 (#1244)
//
// Boot witness for KIND_MODESET_TXN.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, LINEAR discipline
// (rights = R_MINT trip returns LINEAR_REFUSED), initial-state pin
// (mint always into OPEN with mode_slot=0), uniqueness on txn_key,
// and mint / revoke round-trip.
//
// Fingerprint: R36 KIND_MODESET_TXN OK
//
// Cap slots 24..39 — a fresh range past every prior witness's set.

module ModesetTxnSynth = structure {

  pub let mut _mtxw_stage : u64 = 0

  pub let mtxw_ok   : [u8; 21] = "KIND_MODESET_TXN OK\0"
  pub let mtxw_fail : [u8; 23] = "KIND_MODESET_TXN FAIL\0"

  pub let mtxw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-001 (#1244): clear cap_table slots 24..39.",
      block: {
        push rbx;
        mov rbx, 24;
      mtxwc_loop:
        cmp rbx, 40;
        jae mtxwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp mtxwc_loop;
      mtxwc_done:
        pop rbx;
        ret
      }
    }

  pub let mtxw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): reset MODESET_TXN row table.",
      block: {
        call modeset_txn_table_reset;
        ret
      }
    }

  // Synthesize KIND_IPC_ENDPOINT at `slot` with target_ptr = endpoint_id.
  pub let mtxw_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-001 (#1244): synthetic KIND_IPC_ENDPOINT.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let modeset_txn_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R36.M3-001 (#1244): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) NO_ENDPOINT. (4) LINEAR_REFUSED (R_MINT in rights). (5) Happy path. (6) Initial-state pin (OPEN, mode_slot=0). (7) IN_USE. (8) BAD_RIGHTS (non-subset). (9) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _mtxw_stage];
        mov [rcx], rax;

        call mtxw_clear;
        call mtxw_scrub;

        // -- 1. Validators.
        mov rdi, 4;                      // MTX_STATE_ABORTED
        call mtx_state_valid;
        cmp rax, 1;
        jne mtxw_fail_stage;
        mov rdi, 5;
        call mtx_state_valid;
        cmp rax, 0;
        jne mtxw_fail_stage;

        mov rdi, 0x419;
        call mtx_rights_valid;
        cmp rax, 1;
        jne mtxw_fail_stage;
        mov rdi, 0x200;                  // R_MINT alone
        call mtx_rights_valid;
        cmp rax, 0;
        jne mtxw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at slot 25 with endpoint_id 0x77.
        mov rdi, 25;
        mov rsi, 0x200;                  // RIGHT_MINT
        mov rdx, 0x77;
        call mtxw_endpoint;

        // -- 2. BAD_PARENT (parent slot 24 empty).
        mov rax, 2;
        lea rcx, [rip + _mtxw_stage];
        mov [rcx], rax;

        mov rdi, 26;
        mov rsi, 24;                    // empty
        mov rdx, 0x419;
        mov rcx, 0xCAFE0001;
        mov r8, 0x100;                   // output_slot
        call modeset_txn_cap_mint_inner;
        mov r11, 0xFFFFF73D;
        cmp rax, r11;
        jne mtxw_fail_stage;

        // -- 3. NO_ENDPOINT (parent target_ptr == 0).
        mov rax, 3;
        lea rcx, [rip + _mtxw_stage];
        mov [rcx], rax;

        mov rdi, 27;
        mov rsi, 0x200;
        mov rdx, 0;                      // endpoint_id = 0
        call mtxw_endpoint;

        mov rdi, 26;
        mov rsi, 27;
        mov rdx, 0x419;
        mov rcx, 0xCAFE0002;
        mov r8, 0x100;
        call modeset_txn_cap_mint_inner;
        mov r11, 0xFFFFF73A;
        cmp rax, r11;
        jne mtxw_fail_stage;

        // -- 4. LINEAR_REFUSED (R_MINT in rights).
        mov rax, 4;
        lea rcx, [rip + _mtxw_stage];
        mov [rcx], rax;

        mov rdi, 26;
        mov rsi, 25;
        mov rdx, 0x619;                  // R_ALL | R_MINT — trips LINEAR
        mov rcx, 0xCAFE0003;
        mov r8, 0x100;
        call modeset_txn_cap_mint_inner;
        mov r11, 0xFFFFF733;             // LINEAR_REFUSED
        cmp rax, r11;
        jne mtxw_fail_stage;

        // -- 5. Happy path.
        mov rax, 5;
        lea rcx, [rip + _mtxw_stage];
        mov [rcx], rax;

        mov rdi, 26;
        mov rsi, 25;
        mov rdx, 0x419;
        mov rcx, 0xCAFE0004;
        mov r8, 0x100;
        call modeset_txn_cap_mint_inner;
        cmp rax, 0;
        jne mtxw_fail_stage;

        // -- 6. Initial-state pin (state=OPEN=0, mode_slot=0).
        mov rax, 6;
        lea rcx, [rip + _mtxw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // row 0
        call mtx_row_state;
        cmp rax, 0;
        jne mtxw_fail_stage;

        mov rdi, 0;
        call mtx_row_mode;
        cmp rax, 0;
        jne mtxw_fail_stage;

        mov rdi, 0;
        call mtx_row_key;
        mov r11, 0xCAFE0004;
        cmp rax, r11;
        jne mtxw_fail_stage;

        // -- 7. IN_USE (duplicate key).
        mov rax, 7;
        lea rcx, [rip + _mtxw_stage];
        mov [rcx], rax;

        mov rdi, 28;
        mov rsi, 25;
        mov rdx, 0x419;
        mov rcx, 0xCAFE0004;             // duplicate
        mov r8, 0x101;
        call modeset_txn_cap_mint_inner;
        mov r11, 0xFFFFF738;
        cmp rax, r11;
        jne mtxw_fail_stage;

        // -- 8. BAD_RIGHTS (non-subset).
        mov rax, 8;
        lea rcx, [rip + _mtxw_stage];
        mov [rcx], rax;

        mov rdi, 28;
        mov rsi, 25;
        mov rdx, 0x1000;                 // outside R_ALL, no R_MINT
        mov rcx, 0xCAFE0005;
        mov r8, 0x101;
        call modeset_txn_cap_mint_inner;
        mov r11, 0xFFFFF73C;
        cmp rax, r11;
        jne mtxw_fail_stage;

        // -- 9. Revoke round-trip.
        mov rax, 9;
        lea rcx, [rip + _mtxw_stage];
        mov [rcx], rax;

        mov rdi, 26;
        call modeset_txn_cap_revoke_inner;
        cmp rax, 0;
        jne mtxw_fail_stage;

        mov rdi, 26;
        mov rsi, 25;
        mov rdx, 0x419;
        mov rcx, 0xCAFE0004;             // key free again
        mov r8, 0x100;
        call modeset_txn_cap_mint_inner;
        cmp rax, 0;
        jne mtxw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mtxw_ok];
        call klog_s1;

        call mtxw_scrub;
        call mtxw_clear;
        xor rax, rax;
        jmp mtxw_out;

      mtxw_fail_stage:
        lea rax, [rip + _mtxw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mtxw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call mtxw_scrub;
        call mtxw_clear;
        mov rax, 1;

      mtxw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
