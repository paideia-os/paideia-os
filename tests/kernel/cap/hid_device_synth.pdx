// tests/kernel/cap/hid_device_synth.pdx — R32.M3-001 (#1125)
//
// Boot witness for KIND_HID_DEVICE: the derivation gate over
// KIND_DEVICE, the one-device-per-key rule, the static-identity
// refusals (index / transport / vendor:product / report_id_count),
// the arity-one report installer, the revoke, and the dispatch
// handler.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arithmetic, refusals and state transitions. IT ASSERTS
// NOTHING ABOUT A REAL DEVICE, A REAL REPORT DESCRIPTOR OR A REAL
// TRANSPORT TRANSFER, because no code in this tree drives a HID
// device from this kind -- kind_hid_device.pdx §4 says so at length.
//
// -----------------------------------------------------------------------------
// Two fingerprints, not one
// -----------------------------------------------------------------------------
//
//   R32 KIND_HID_DEVICE OK    — stage A: the capability. Gate halves,
//                               rights, uniqueness, revoke, dispatch,
//                               static-identity refusals.
//   R32 HID_TRANSPORT scale OK — stage B: the ordinals. The transport
//                                enumeration edges (UNKNOWN refused,
//                                boundary admitted, past boundary
//                                refused), the report installer
//                                round-trip and the sentinel
//                                discipline for empty rows.
//
// -----------------------------------------------------------------------------
// Cap slots 108..113
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness in the tree. Every fixture through
// R32.M2 used the ranges 0..8, 10..12, 14..19, 28..33, 46..63, 64..95,
// 96..99, 110..117, 160..199, 200..251, 252..255. The block 108..113
// avoids 110..117 (used by another fixture) and 96..99 (backlight);
// four device slots plus two subject slots is exactly enough for one
// well-formed parent, one parent without RIGHT_MINT, one parent with
// zero identity, and two subject slots for the mint / re-mint tests.

module HidDeviceSynth = structure {

  pub let mut _hidd_w_stage : u64 = 0

  pub let hidd_w_ok_a   : [u8; 22] = "KIND_HID_DEVICE OK\n\0\0\0"
  pub let hidd_w_fail_a : [u8; 24] = "KIND_HID_DEVICE FAIL\n\0\0\0"
  pub let hidd_w_ok_b   : [u8; 24] = "HID_TRANSPORT scale OK\0"
  pub let hidd_w_fail_b : [u8; 26] = "HID_TRANSPORT scale FAIL\0"

  // ==========================================================================
  // hidd_w_clear() — return slots 108..113 to boot state.
  // ==========================================================================

  pub let hidd_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): clear cap_table slots 108..113 through cap_mint_write, the only descriptor writer, so the owner column's unconditional clear (#1587) runs on every one of them. Called on both exits: a witness whose failure path leaked six descriptors would make every witness after it report a different fault than the one that actually happened. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed hidd_wc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        mov rbx, 108;
      hidd_wc_loop:
        cmp rbx, 114;
        jae hidd_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp hidd_wc_loop;
      hidd_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let hidd_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-001 (#1125): reset the HID device row table and the counters. The counters are outside the rows so they survive a revoke, which means a fixture that left them populated would hand the next reader of hid_device_stat a count of report_installs this fixture invented. One push leaves rsp%16 == 0 at the nested call. Labels prefixed hidd_ws_ per reserved-label discipline.",
      block: {
        push rbx;
        call hid_device_table_reset;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hidd_w_device(slot, key, rights) — mint a synthetic KIND_DEVICE parent.
  // ==========================================================================

  pub let hidd_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): write a synthetic KIND_DEVICE descriptor whose target_ptr is `key`, through cap_mint_write. A fixture-local parent rather than a real PCI capability, because what the gate under test reads out of the parent is exactly two things -- kind == 10 and target_ptr -- and manufacturing a real bus enumeration to supply them would test the enumerator rather than the gate. Two pushes leave rsp%16 == 0 at the nested call. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // hidd_w_pack_ids(vendor, product, rid_count) -> ids
  //
  // vendor in [15:0], product in [31:16], rid_count in [47:32].
  // ==========================================================================

  pub let hidd_w_pack_ids : (u64, u64, u64) -> u64 !{} @{} =
    fn (vendor: u64, product: u64, rid_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-001 (#1125): pack (vendor, product, rid_count) into the ids_and_rid mint argument. Provided by the fixture so every mint call site packs identically. Pure leaf. Labels prefixed hidd_pi_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;                    // vendor
        mov r11, rsi;
        and r11, r10;
        shl r11, 16;                     // product << 16
        or  rax, r11;
        mov r11, rdx;
        and r11, r10;
        shl r11, 32;                     // rid_count << 32
        or  rax, r11;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let hid_device_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R32.M3-001 (#1125): boot witness for KIND_HID_DEVICE. STAGE A drives the capability: both halves of the derivation gate in both directions, the rights subset test, the four static-identity refusals that keep a device from existing without a plausible index / transport / vendor:product / report_id_count, the one-row-per-device rule, the wrong-kind revoke refusal, the dispatch handler's per-op rights and its refusal of any non-zero op_arg[63:8] on the REPORT_INSTALL op (arity ONE), and a re-mint after revoke which is what proves no ghost row was stranded. STAGE B drives the numbers: the transport enumeration boundaries (UNKNOWN refused, USB admitted, past BT refused), the sentinel discipline (empty slot / KIND_DEVICE-parent slot return HID_DECODE_BAD), and an end-to-end round trip through REPORT_INSTALL that proves the report count moved by exactly one. Each stage runs only if the previous passed. Both exits call hidd_w_scrub and hidd_w_clear. Five-push prologue leaves rsp%16 == 0 at every nested call; the stage counter lives in module .bss so it survives every callee-save-clobber pattern in the primitives under test. Labels prefixed hidd_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        call hidd_w_clear;
        call hidd_w_scrub;

        // 108 — well-formed parent. 109 — no RIGHT_MINT. 110 — RIGHT_MINT
        // but zero identity. 111 — used as subject / second parent.
        // 112, 113 — additional subject slots.
        mov rdi, 108;
        mov rsi, 0xD101;
        mov rdx, 0x200;                  // RIGHT_MINT
        call hidd_w_device;
        mov rdi, 109;
        mov rsi, 0xD109;
        mov rdx, 0x001;                  // no RIGHT_MINT
        call hidd_w_device;
        mov rdi, 110;
        xor rsi, rsi;                    // no identity
        mov rdx, 0x200;
        call hidd_w_device;

        // -- A1. First half of the gate, in both directions.
        mov rax, 2;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        mov rdi, 108;
        call hid_device_check_parent_device;
        cmp rax, 1;
        jne hidd_w_fail_stage_a;

        mov rdi, 109;
        call hid_device_check_parent_device;
        cmp rax, 0;
        jne hidd_w_fail_stage_a;

        mov rdi, 111;                    // empty slot
        call hid_device_check_parent_device;
        cmp rax, 0;
        jne hidd_w_fail_stage_a;

        // Try to mint from a parent without RIGHT_MINT. Subject is 111.
        // ids: vendor=0x27C6 (Synaptics), product=0x0123, rid_count=4.
        mov rdi, 0x27C6;
        mov rsi, 0x0123;
        mov rdx, 4;
        call hidd_w_pack_ids;
        mov r15, rax;                    // ids

        mov rdi, 111;
        mov rsi, 109;
        mov rdx, 0x41B;                  // R_HID_ALL
        mov rcx, 0;                      // index
        mov r8, 1;                       // I2C
        mov r9, r15;
        call hid_device_cap_mint;
        mov r11, 0xFFFFFE8D;             // HID_MINT_BAD_PARENT
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // -- A2. Rights subset. RIGHT_MINT outside the mask.
        mov rax, 3;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        mov rdi, 0x001;
        call hid_device_rights_valid;
        cmp rax, 1;
        jne hidd_w_fail_stage_a;
        mov rdi, 0x41B;
        call hid_device_rights_valid;
        cmp rax, 1;
        jne hidd_w_fail_stage_a;
        mov rdi, 0x200;
        call hid_device_rights_valid;
        cmp rax, 0;
        jne hidd_w_fail_stage_a;

        mov rdi, 111;
        mov rsi, 108;
        mov rdx, 0x21B;                  // R_HID_ALL | RIGHT_MINT
        mov rcx, 0;
        mov r8, 1;
        mov r9, r15;
        call hid_device_cap_mint;
        mov r11, 0xFFFFFE8C;             // HID_MINT_BAD_RIGHTS
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // -- A3. Static-identity refusals.
        mov rax, 4;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        // index >= HID_INDEX_MAX
        mov rdi, 111;
        mov rsi, 108;
        mov rdx, 0x41B;
        mov rcx, 16;                     // HID_INDEX_MAX -> refused
        mov r8, 1;
        mov r9, r15;
        call hid_device_cap_mint;
        mov r11, 0xFFFFFE8B;             // HID_MINT_BAD_INDEX
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // transport == UNKNOWN (refused)
        mov rdi, 111;
        mov rsi, 108;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 0;                       // UNKNOWN
        mov r9, r15;
        call hid_device_cap_mint;
        mov r11, 0xFFFFFE8A;             // HID_MINT_BAD_TRANSPORT
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // transport > MAX
        mov rdi, 111;
        mov rsi, 108;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 4;                       // past HID_TRANSPORT_MAX
        mov r9, r15;
        call hid_device_cap_mint;
        mov r11, 0xFFFFFE8A;
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // vendor:product == 0000:0000 (USB reserved placeholder)
        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 4;
        call hidd_w_pack_ids;
        mov r14, rax;

        mov rdi, 111;
        mov rsi, 108;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1;
        mov r9, r14;
        call hid_device_cap_mint;
        mov r11, 0xFFFFFE89;             // HID_MINT_BAD_IDS
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // rid_count > HID_REPORT_ID_MAX
        mov rdi, 0x27C6;
        mov rsi, 0x0123;
        mov rdx, 257;                    // past HID_REPORT_ID_MAX
        call hidd_w_pack_ids;
        mov r14, rax;

        mov rdi, 111;
        mov rsi, 108;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1;
        mov r9, r14;
        call hid_device_cap_mint;
        mov r11, 0xFFFFFE88;             // HID_MINT_BAD_RID_COUNT
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // -- A4. Identity is INHERITED.
        mov rax, 5;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        mov rdi, 110;
        call hid_device_parent_key;
        cmp rax, 0;
        jne hidd_w_fail_stage_a;

        mov rdi, 111;
        mov rsi, 110;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1;
        mov r9, r15;                     // valid ids
        call hid_device_cap_mint;
        mov r11, 0xFFFFFE87;             // HID_MINT_NO_DEVICE
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // -- A5. Happy path.
        mov rax, 6;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        mov rdi, 111;
        mov rsi, 108;
        mov rdx, 0x41B;
        mov rcx, 0;                      // index 0
        mov r8, 1;                       // I2C
        mov r9, r15;
        call hid_device_cap_mint;
        cmp rax, 0;
        jne hidd_w_fail_stage_a;

        mov rdi, 111;
        call hid_device_rid_count_of_slot;
        cmp rax, 4;
        jne hidd_w_fail_stage_a;

        mov rdi, 111;
        call hid_device_transport_of_slot;
        cmp rax, 1;                      // I2C
        jne hidd_w_fail_stage_a;

        mov rdi, 111;
        call hid_device_vendor_of_slot;
        cmp rax, 0x27C6;
        jne hidd_w_fail_stage_a;

        mov rdi, 111;
        call hid_device_product_of_slot;
        cmp rax, 0x0123;
        jne hidd_w_fail_stage_a;

        mov rdi, 111;
        call hid_device_row_of_slot;
        mov rbx, rax;                    // rbx = row across stage
        cmp rbx, 0xFF;
        je  hidd_w_fail_stage_a;

        mov rdi, rbx;
        call hid_device_row_key;
        cmp rax, 0xD101;                 // INHERITED key
        jne hidd_w_fail_stage_a;

        mov rdi, rbx;
        call hid_device_row_parent;
        cmp rax, 108;
        jne hidd_w_fail_stage_a;

        mov rdi, rbx;
        call hid_device_row_reports;
        cmp rax, 0;                      // no reports yet
        jne hidd_w_fail_stage_a;

        // -- A6. ONE DEVICE, ONE CAPABILITY.
        mov rax, 7;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        // Clear 110 for a fresh subject.
        mov rdi, 110;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 110;                    // subject
        mov rsi, 108;                    // SAME device
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1;
        mov r9, r15;
        call hid_device_cap_mint;
        mov r11, 0xFFFFFE85;             // HID_MINT_IN_USE
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        mov rdi, 0xD101;
        call hid_device_find_by_key;
        cmp rax, rbx;                    // and it IS this row
        jne hidd_w_fail_stage_a;

        // -- A7. Revoke refusals.
        mov rax, 8;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        mov rdi, 108;                    // KIND_DEVICE
        call hid_device_cap_revoke;
        mov r11, 0xFFFFFE83;             // HID_WRONG_KIND
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        mov rdi, 110;                    // empty slot (we cleared it)
        call hid_device_cap_revoke;
        mov r11, 0xFFFFFE82;             // HID_REVOKE_ALREADY
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // Device survived.
        mov rdi, 108;
        call hid_device_check_parent_device;
        cmp rax, 1;
        jne hidd_w_fail_stage_a;

        // -- A8. Dispatch handler.
        mov rax, 9;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        // target_ptr as cap_mint_write wrote it: row | (slot << 16).
        mov r12, rbx;
        mov r13, 111;
        shl r13, 16;
        or  r12, r13;                    // r12 = target_ptr for slot 111

        // QUERY_TRANSPORT is INVOKE.
        mov rdi, 0x008;                  // R_HID_INVOKE
        mov rsi, r12;
        mov rdx, 1;                      // QUERY_TRANSPORT
        call cap_handler_hid_device;
        cmp rax, 1;                      // I2C
        jne hidd_w_fail_stage_a;

        // QUERY_TRANSPORT with only READ is DENIED.
        mov rdi, 0x001;
        mov rsi, r12;
        mov rdx, 1;
        call cap_handler_hid_device;
        mov r11, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // Unknown op.
        mov rdi, 0x41B;
        mov rsi, r12;
        mov rdx, 9;
        call cap_handler_hid_device;
        mov r11, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // REPORT_INSTALL with any operand bits set is REFUSED, not masked.
        mov rdi, 0x002;                  // R_HID_REPORT
        mov rsi, r12;
        mov r13, 1;
        shl r13, 8;                      // reserved bits [63:8]
        or  r13, 8;                      // op = 8
        mov rdx, r13;
        call cap_handler_hid_device;
        mov r11, 0xFFFFFE8E;             // HID_TAIL_BAD_ARG
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        // -- A9. Revoke and RE-MINT.
        mov rax, 10;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        mov rdi, 111;
        call hid_device_cap_revoke;
        cmp rax, 0;
        jne hidd_w_fail_stage_a;

        mov rdi, rbx;
        call hid_device_tail_valid;
        cmp rax, 0;                      // row went with it
        jne hidd_w_fail_stage_a;

        mov rdi, 0xD101;
        call hid_device_find_by_key;
        cmp rax, 0xFF;                   // HID_ROW_NONE
        jne hidd_w_fail_stage_a;

        mov rdi, 111;
        mov rsi, 108;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1;
        mov r9, r15;
        call hid_device_cap_mint;
        cmp rax, 0;
        jne hidd_w_fail_stage_a;

        // -- A10. Dead row answers HID_DECODE_BAD.
        mov rax, 11;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        mov rdi, 7;                      // never-claimed row
        call hid_device_row_transport;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        mov rdi, 7;
        call hid_device_row_vendor;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        mov rdi, 110;                    // empty slot
        call hid_device_transport_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        mov rdi, 108;                    // KIND_DEVICE, not a HID row
        call hid_device_transport_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hidd_w_fail_stage_a;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hidd_w_ok_a];
        call klog_s1;

        // ================================================================
        // STAGE B — TRANSPORT scale + REPORT_INSTALL round trip.
        // ================================================================

        // -- B1. Transport enumeration boundaries.
        mov rax, 21;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;                    // UNKNOWN
        call hid_device_transport_valid;
        cmp rax, 0;
        jne hidd_w_fail_stage_b;

        mov rdi, 1;                      // I2C
        call hid_device_transport_valid;
        cmp rax, 1;
        jne hidd_w_fail_stage_b;

        mov rdi, 3;                      // BT (boundary)
        call hid_device_transport_valid;
        cmp rax, 1;
        jne hidd_w_fail_stage_b;

        mov rdi, 4;                      // past BT
        call hid_device_transport_valid;
        cmp rax, 0;
        jne hidd_w_fail_stage_b;

        // -- B2. Refresh the row handle after the A9 re-mint.
        mov rax, 22;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        mov rdi, 111;
        call hid_device_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;
        je  hidd_w_fail_stage_b;

        // -- B3. REPORT_INSTALL round trip.
        mov rax, 23;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call hid_device_row_reports;
        mov r14, rax;                    // count before

        mov rdi, 0;                      // HID_ST_REPORTS
        call hid_device_stat;
        mov r15, rax;                    // global before

        mov rdi, 111;
        call hid_device_report_install;
        cmp rax, 0;
        jne hidd_w_fail_stage_b;

        mov rdi, rbx;
        call hid_device_row_reports;
        sub rax, r14;
        cmp rax, 1;
        jne hidd_w_fail_stage_b;

        mov rdi, 0;
        call hid_device_stat;
        sub rax, r15;
        cmp rax, 1;
        jne hidd_w_fail_stage_b;

        // A second install increments by another one.
        mov rdi, 111;
        call hid_device_report_install;
        cmp rax, 0;
        jne hidd_w_fail_stage_b;

        mov rdi, rbx;
        call hid_device_row_reports;
        sub rax, r14;
        cmp rax, 2;
        jne hidd_w_fail_stage_b;

        // report_install against an EMPTY slot is BAD_SLOT.
        mov rdi, 110;                    // empty
        call hid_device_report_install;
        mov r11, 0xFFFFFE84;             // HID_BAD_SLOT
        cmp rax, r11;
        jne hidd_w_fail_stage_b;

        // -- B4. Debug print refuses a dead row.
        mov rax, 24;
        lea rcx, [rip + _hidd_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call hid_device_debug_print;
        cmp rax, 0;
        jne hidd_w_fail_stage_b;

        mov rdi, 7;                      // never claimed
        call hid_device_debug_print;
        mov r11, 0xFFFFFE8E;             // HID_TAIL_BAD_ARG
        cmp rax, r11;
        jne hidd_w_fail_stage_b;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hidd_w_ok_b];
        call klog_s1;

        call hidd_w_scrub;
        call hidd_w_clear;
        xor rax, rax;
        jmp hidd_w_out;

      hidd_w_fail_stage_a:
        lea rax, [rip + _hidd_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hidd_w_fail_a];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp hidd_w_failed;

      hidd_w_fail_stage_b:
        lea rax, [rip + _hidd_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hidd_w_fail_b];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      hidd_w_failed:
        call hidd_w_scrub;
        call hidd_w_clear;
        mov rax, 1;

      hidd_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
