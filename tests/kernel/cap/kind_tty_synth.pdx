// tests/kernel/cap/kind_tty_synth.pdx -- R30-PREP (#1631)
//
// Boot witness for KIND_TTY.
//
// Fingerprint: R30-PREP KIND_TTY OK
//
// Cap slots 120..122.

module KindTtySynth = structure {

  pub let mut _ttyw_stage : u64 = 0

  pub let ttyw_ok   : [u8; 13] = "KIND_TTY OK\0"
  pub let ttyw_fail : [u8; 15] = "KIND_TTY FAIL\0"

  // Mint a synthetic KIND_IPC_ENDPOINT parent. target_ptr low 16 bits =
  // endpoint_id (matches endpoint_table.pdx §layout at R20b.M1-001);
  // the mint gate itself does not require RIGHT_MINT on the parent.
  pub let ttyw_ep : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30-PREP (#1631): mint a synthetic KIND_IPC_ENDPOINT parent for the tty mint gate. R_IPC_ALL (0x00B) rights; the tty derivation gate only checks kind, so this rights bitmask matches the elevate-channel synth witness. Labels prefixed ttyw_e_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, 0x00B;                  // R_IPC_ALL
        mov rcx, r13;                    // target_ptr = endpoint_id
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let ttyw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30-PREP (#1631): clear cap_table slots 120..122. Labels prefixed ttyw_c_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 120;
      ttyw_c_loop:
        cmp rbx, 123;
        jae ttyw_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp ttyw_c_loop;
      ttyw_c_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kind_tty_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30-PREP (#1631): boot witness. Five callee-save pushes leave rsp%16 == 0. Labels prefixed ttyw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) Reset.
        mov rax, 1;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        call ttyw_clear;
        call tty_table_reset;

        mov rdi, 120;
        mov rsi, 0x0055;                 // tty server endpoint id
        call ttyw_ep;
        mov rdi, 121;                    // wrong kind
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // (2) rights_valid.
        mov rax, 2;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 0x61A;                  // R_TTY_ALL
        call tty_rights_valid;
        cmp rax, 1;
        jne ttyw_fail_stage;
        mov rdi, 0x2000;                 // outside R_TTY_ALL
        call tty_rights_valid;
        cmp rax, 0;
        jne ttyw_fail_stage;

        // (3) rows_valid / cols_valid.
        mov rax, 3;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 25;  call tty_rows_valid; cmp rax, 1; jne ttyw_fail_stage;
        mov rdi, 0;   call tty_rows_valid; cmp rax, 0; jne ttyw_fail_stage;
        mov rdi, 4096; call tty_rows_valid; cmp rax, 1; jne ttyw_fail_stage;
        mov rdi, 4097; call tty_rows_valid; cmp rax, 0; jne ttyw_fail_stage;
        mov rdi, 80;  call tty_cols_valid; cmp rax, 1; jne ttyw_fail_stage;
        mov rdi, 0;   call tty_cols_valid; cmp rax, 0; jne ttyw_fail_stage;

        // (4) parent gate.
        mov rax, 4;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 120;
        call tty_check_parent_endpoint;
        cmp rax, 1;
        jne ttyw_fail_stage;
        mov rdi, 121;                    // wrong kind
        call tty_check_parent_endpoint;
        cmp rax, 0;
        jne ttyw_fail_stage;

        // (5) Mint success. tty_id=0xTTY7, rows=25, cols=80.
        mov rax, 5;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 120;
        mov rsi, 0x61A;
        mov rdx, 0x7777;                 // tty_id
        mov rcx, 25;                     // rows
        mov r8,  80;                     // cols
        call tty_cap_mint_inner;
        mov r10, 16;
        cmp rax, r10;
        jae ttyw_fail_stage;
        mov r12, rax;

        mov rdi, r12;
        call tty_row_id;
        mov r11, 0x7777;
        cmp rax, r11;
        jne ttyw_fail_stage;

        mov rdi, r12;
        call tty_row_rows;
        cmp rax, 25;
        jne ttyw_fail_stage;

        mov rdi, r12;
        call tty_row_cols;
        cmp rax, 80;
        jne ttyw_fail_stage;

        mov rdi, r12;
        call tty_row_bytes;
        cmp rax, 0;                      // starts at 0
        jne ttyw_fail_stage;

        // (6) BAD_ID (tty_id == 0).
        mov rax, 6;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 120;
        mov rsi, 0x61A;
        xor rdx, rdx;
        mov rcx, 24;
        mov r8,  80;
        call tty_cap_mint_inner;
        mov r10, 0xFFFFEC3B;             // TTY_MINT_BAD_ID
        cmp rax, r10;
        jne ttyw_fail_stage;

        // (7) BAD_ROWS.
        mov rax, 7;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 120;
        mov rsi, 0x61A;
        mov rdx, 0x7778;
        xor rcx, rcx;                    // rows = 0
        mov r8,  80;
        call tty_cap_mint_inner;
        mov r10, 0xFFFFEC3A;             // TTY_MINT_BAD_ROWS
        cmp rax, r10;
        jne ttyw_fail_stage;

        // (8) BAD_COLS.
        mov rax, 8;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 120;
        mov rsi, 0x61A;
        mov rdx, 0x7779;
        mov rcx, 24;
        xor r8,  r8;                     // cols = 0
        call tty_cap_mint_inner;
        mov r10, 0xFFFFEC39;             // TTY_MINT_BAD_COLS
        cmp rax, r10;
        jne ttyw_fail_stage;

        // (9) BAD_PARENT.
        mov rax, 9;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 121;                    // wrong kind
        mov rsi, 0x61A;
        mov rdx, 0x777A;
        mov rcx, 24;
        mov r8,  80;
        call tty_cap_mint_inner;
        mov r10, 0xFFFFEC3D;             // TTY_MINT_BAD_PARENT
        cmp rax, r10;
        jne ttyw_fail_stage;

        // (10) WRITE ack bumps bytes_written.
        mov rax, 10;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 0x61A;                  // rights
        mov rsi, r12;                    // target_ptr = row_id (low 16 valid)
        xor rdx, rdx;                    // op = TTY_OP_WRITE (0)
        call cap_handler_tty;
        cmp rax, 0;
        jne ttyw_fail_stage;
        mov rdi, r12;
        call tty_row_bytes;
        cmp rax, 1;
        jne ttyw_fail_stage;
        // A second WRITE bumps to 2.
        mov rdi, 0x61A;
        mov rsi, r12;
        xor rdx, rdx;
        call cap_handler_tty;
        mov rdi, r12;
        call tty_row_bytes;
        cmp rax, 2;
        jne ttyw_fail_stage;

        // (11) WRITE without R_TTY_WRITE is denied.
        mov rax, 11;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 0x008;                  // only R_TTY_INVOKE
        mov rsi, r12;
        xor rdx, rdx;
        call cap_handler_tty;
        mov r10, 0xFFFFFFFFFFFFFFFD;     // DENIED
        cmp rax, r10;
        jne ttyw_fail_stage;

        // (12) QUERY_ROWS returns 25 and requires R_TTY_INVOKE.
        mov rax, 12;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 0x008;                  // R_TTY_INVOKE
        mov rsi, r12;
        mov rdx, 1;                      // TTY_OP_QUERY_ROWS
        call cap_handler_tty;
        cmp rax, 25;
        jne ttyw_fail_stage;
        // Denied without R_TTY_INVOKE.
        mov rdi, 0x400;                  // only R_TTY_OBSERVE
        mov rsi, r12;
        mov rdx, 1;
        call cap_handler_tty;
        mov r10, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r10;
        jne ttyw_fail_stage;

        // (13) QUERY_COLS returns 80.
        mov rax, 13;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 2;                      // TTY_OP_QUERY_COLS
        call cap_handler_tty;
        cmp rax, 80;
        jne ttyw_fail_stage;

        // (14) Reserved bits on op_arg refused.
        mov rax, 14;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 0x101;                  // op=1 + noise in [63:8]
        call cap_handler_tty;
        mov r10, 0xFFFFEC3E;             // TTY_TAIL_BAD_ARG
        cmp rax, r10;
        jne ttyw_fail_stage;

        // (15) Unsupported op refused.
        // rdx was 6 pre-#1986 (TTY_OP_MAX was 5, so 6 was out of range).
        // #1986 raised TTY_OP_MAX to 8 and defined op 6 as TTY_OP_READ.
        // #1998 (R90-XREPO.004) raised TTY_OP_MAX to 13 and defined
        // ops 9..13 (SET_ECHO_ON/OFF, GET_ATTR, SET_VMIN, SET_VTIME);
        // bumped to 14, the first op past the current TTY_OP_MAX. Note:
        // ops 12 and 13 (SET_VMIN, SET_VTIME) route BEFORE the arity-one
        // gate so their byte-encoded arg is legal there; op 14 is
        // outside every routed range and lands on the tty_hn_unsup arm.
        mov rax, 15;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 14;                     // > TTY_OP_MAX (13)
        call cap_handler_tty;
        mov r10, 0xFFFFFFFFFFFFFFFC;     // UNSUP
        cmp rax, r10;
        jne ttyw_fail_stage;

        // (16) revoke happy + already dead.
        mov rax, 16;
        lea rcx, [rip + _ttyw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call tty_cap_revoke;
        cmp rax, 0;
        jne ttyw_fail_stage;
        mov rdi, r12;
        call tty_tail_valid;
        cmp rax, 0;
        jne ttyw_fail_stage;
        mov rdi, r12;
        call tty_cap_revoke;
        mov r10, 0xFFFFEC36;             // TTY_REVOKE_ALREADY
        cmp rax, r10;
        jne ttyw_fail_stage;

        // Success.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ttyw_ok];
        call klog_s1;

        call ttyw_clear;
        call tty_table_reset;
        xor rax, rax;
        jmp ttyw_out;

      ttyw_fail_stage:
        lea rax, [rip + _ttyw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ttyw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ttyw_clear;
        call tty_table_reset;
        mov rax, 1;

      ttyw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
