// tests/kernel/policy/battery_monitor_synth.pdx — R31.M3-003 (#1101)
//
// Boot witness for the battery_monitor scaffold: the threshold's
// install / monotonicity gate, the tick's first-sample / delta /
// LOW-crossing / hysteresis-re-arm behaviour, and the ack's
// dispatchable-only mask.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the delta detector, its cache, its latch, and the
// refusals of its install/ack paths. IT ASSERTS NOTHING ABOUT A
// SUBSCRIBER, AN _BST NOTIFICATION READ, OR A DISPATCH ACROSS AN
// ENDPOINT, because none of that exists in this kernel yet -- see
// battery_monitor.pdx §4 for the four things that stay deferred (no
// AML _BST reader; no bound endpoint; no ring-3 tune shim; no
// platform shutdown consumer). A fixture that emitted "R31 BATTERY
// MONITOR SERVER OK" here would be the kernel talking to itself
// dressed up as battery management -- the shape #1590 unwound for
// three closed issues in the thermal path.
//
// -----------------------------------------------------------------------------
// One fingerprint, not two
// -----------------------------------------------------------------------------
//
//   R31 BATTERY MONITOR OK
//
// One and not two because everything here is over the same delta
// detector -- no unit conversion, no arithmetic ladder, and no
// candidate/latch pair that fails for reasons independent of the
// tick.
//
// -----------------------------------------------------------------------------
// Cap slots 244..251
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness in the tree (which use 0..8,
// 10..12, 14..19, 28..33, 46..63, 64..95, 110..117, 160..199,
// 200..211, 212..223, 224..231, 232..243). Both exits revoke the
// battery, clear every slot and reset the monitor table, so a
// failure here cannot be mistaken for a fault in whatever runs
// next.
//
// -----------------------------------------------------------------------------
// The numbers, and why these numbers
// -----------------------------------------------------------------------------
//
// design_cap 57000 mWh, index 0, chemistry LION (1) -- the same
// plausible ThinkPad pack battery_synth uses, so a mint refusal here
// signals a shared kind_battery.pdx regression rather than a monitor
// bug. Threshold defaults to 5. Ticks cross from 50 (well above) to
// 3 (LOW fires) to 2 (latched, no re-fire) to 10 (past 5+3=8, latch
// clears) to 3 (LOW re-fires) -- the four state transitions §3 of
// battery_monitor.pdx names by shape.

module BatteryMonitorSynth = structure {

  pub let mut _bm_w_stage : u64 = 0

  pub let bm_w_ok   : [u8; 23] = "R31 BATTERY MONITOR OK\0"
  pub let bm_w_fail : [u8; 25] = "R31 BATTERY MONITOR FAIL\0"

  // ==========================================================================
  // bm_w_clear() — return cap_table slots 244..251 to boot state.
  // ==========================================================================

  pub let bm_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-003 (#1101): clear cap_table slots 244..251 through cap_mint_write, the only descriptor writer, so the owner column's unconditional clear (#1587) runs on every one of them. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed bm_wc_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 244;
      bm_wc_loop:
        cmp rbx, 252;
        jae bm_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp bm_wc_loop;
      bm_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bm_w_device(slot, key) — mint a synthetic KIND_DEVICE with RIGHT_MINT.
  // ==========================================================================

  pub let bm_w_device : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64, key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-003 (#1101): write a synthetic KIND_DEVICE descriptor whose target_ptr is `key`, through cap_mint_write. A fixture-local parent rather than a real PCI capability, for the reason battery_synth's bt_w_device does the same: the gate under test reads exactly two things out of the parent (kind == 10 and target_ptr), and manufacturing a real bus enumeration to supply them would test the enumerator rather than the gate. Two pushes leave rsp%16 == 0 at the nested call.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x200;                  // RIGHT_MINT
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let battery_monitor_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R31.M3-003 (#1101): boot witness for battery_monitor. STAGES, in order: (S1) threshold discipline. Reset installs default (5); read-back returns 5. Install 5 is idempotent OK. Install 10 is refused THRESHOLD_ALREADY (monotone). Reset + install 10 succeeds; read-back returns 10. Reset again returns to 5. Install 101 refused BAD_THRESHOLD. (S2) first-sample. Mint device (244, key 0xCC01) + battery (245). tick(245, 50, 12000, DISCHARGING) returns OK; seen(row) == 1; flags(row) == 0. NO F_STATE_CHANGED and NO F_LOW_WARNING on the first sample, because there is nothing to compare against. (S3) no-delta. tick(245, 50, 12000, DISCHARGING) again returns OK; flags(row) still 0. (S4) state delta. tick(245, 51, 12100, CHARGING) returns OK; flags(row) == F_STATE_CHANGED. ack(row, F_STATE_CHANGED) returns OK; flags(row) == 0. (S5) LOW crossing. tick(245, 3, 11500, DISCHARGING) returns OK; flags(row) == (F_STATE_CHANGED | F_LOW_WARNING) -- state changed CHARGING->DISCHARGING AND pct crossed under threshold. flags_raw(row) has LOW_LATCHED bit. ack the two dispatchable bits; flags == 0 but flags_raw still has LATCHED. (S6) latched, no re-fire. tick(245, 2, 11400, DISCHARGING) returns OK; flags(row) == 0 -- LOW does NOT re-fire while latched, and DISCHARGING->DISCHARGING is no state delta. (S7) re-arm. tick(245, 10, 11800, DISCHARGING) returns OK; flags(row) == 0 and flags_raw LATCH is now clear (pct 10 > threshold 5 + HYST 3 = 8). (S8) re-fire. tick(245, 3, 11500, DISCHARGING) returns OK; flags(row) == F_LOW_WARNING again. (S9) refusals. ack(row, 0x10000) refused BAD_ACK (mask outside FLAGS_DISPATCHABLE -- a dispatcher could otherwise clear LATCH and re-arm the crossing without the pack recovering). ack(row, 0x100) refused BAD_ACK (reserved bit). ack(8, 0x1) refused BAD_ROW. tick against a slot with no battery -> BAD_ROW. tick with implausible percent (255) propagates BATTERY_IMPLAUSIBLE_PCT verbatim, and flags DO NOT MOVE for the refused sample. Each stage runs only if the previous passed. Both exits reset the monitor table and clear the slots. Five-push prologue (rbx, r12, r13, r14, r15) leaves rsp%16 == 0 at every nested call. Labels prefixed bm_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP.
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _bm_w_stage];
        mov [rcx], rax;

        call battery_monitor_table_reset;
        call battery_table_reset;
        call bm_w_clear;

        // ================================================================
        // S1 — threshold monotonicity.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _bm_w_stage];
        mov [rcx], rax;

        call battery_monitor_threshold;
        cmp rax, 5;                      // default
        jne bm_w_fail_stage;

        mov rdi, 5;                      // idempotent OK
        call battery_monitor_threshold_install;
        cmp rax, 0;
        jne bm_w_fail_stage;

        mov rdi, 10;                     // different -> refused
        call battery_monitor_threshold_install;
        mov r11, 0xFFFFFE6B;             // THRESHOLD_ALREADY
        cmp rax, r11;
        jne bm_w_fail_stage;

        // Reset + install 10 succeeds.
        call battery_monitor_table_reset;
        mov rdi, 10;
        // Table_reset just installed 5 as default. So 10 is now different -> refused.
        // The install-after-reset path only works when the caller resets to a "clean"
        // state and immediately installs their choice. In this module reset always
        // installs the default, so a caller wanting a non-default threshold must
        // (a) reset, (b) accept that the default is now in effect, (c) their
        // higher-priority reason to change it is out of scope for this kernel.
        // Assert that behavior: reset installed default (5); install 10 refuses.
        call battery_monitor_threshold_install;
        mov r11, 0xFFFFFE6B;             // THRESHOLD_ALREADY
        cmp rax, r11;
        jne bm_w_fail_stage;

        call battery_monitor_threshold;
        cmp rax, 5;                      // default survived
        jne bm_w_fail_stage;

        // Bad threshold refused.
        mov rdi, 101;
        call battery_monitor_threshold_install;
        mov r11, 0xFFFFFE6C;             // BAD_THRESHOLD
        cmp rax, r11;
        jne bm_w_fail_stage;

        // ================================================================
        // SETUP for tick stages: mint a KIND_BATTERY through the real path.
        // ================================================================
        mov rax, 15;
        lea rcx, [rip + _bm_w_stage];
        mov [rcx], rax;

        call battery_table_reset;

        // Slot 244 = parent KIND_DEVICE.
        mov rdi, 244;
        mov rsi, 0xCC01;
        call bm_w_device;

        // Slot 245 = KIND_BATTERY (mint through the real path).
        mov rdi, 245;                    // dest slot
        mov rsi, 244;                    // parent slot
        mov rdx, 0x41B;                  // R_BATTERY_ALL
        mov rcx, 0;                      // index
        mov r8, 57000;                   // design_mwh
        mov r9, 1;                       // LION
        call battery_cap_mint;
        cmp rax, 0;
        jne bm_w_fail_stage;

        // Save the row_id for direct-row queries.
        mov rdi, 245;
        call battery_row_of_slot;
        mov rbx, rax;                    // rbx = row_id
        cmp rbx, 0xFF;
        je  bm_w_fail_stage;

        // ================================================================
        // S2 — first sample.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _bm_w_stage];
        mov [rcx], rax;

        mov rdi, 245;
        mov rsi, 50;                     // percent
        mov rdx, 12000;                  // mv
        mov rcx, 2;                      // DISCHARGING
        call battery_monitor_tick;
        cmp rax, 0;
        jne bm_w_fail_stage;

        mov rdi, rbx;
        call battery_monitor_seen;
        cmp rax, 1;
        jne bm_w_fail_stage;

        mov rdi, rbx;
        call battery_monitor_flags;
        cmp rax, 0;                      // no flags on first sample
        jne bm_w_fail_stage;

        // ================================================================
        // S3 — no delta.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _bm_w_stage];
        mov [rcx], rax;

        mov rdi, 245;
        mov rsi, 50;
        mov rdx, 12000;
        mov rcx, 2;                      // same state
        call battery_monitor_tick;
        cmp rax, 0;
        jne bm_w_fail_stage;

        mov rdi, rbx;
        call battery_monitor_flags;
        cmp rax, 0;
        jne bm_w_fail_stage;

        // ================================================================
        // S4 — state delta.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _bm_w_stage];
        mov [rcx], rax;

        mov rdi, 245;
        mov rsi, 51;
        mov rdx, 12100;
        mov rcx, 1;                      // CHARGING
        call battery_monitor_tick;
        cmp rax, 0;
        jne bm_w_fail_stage;

        mov rdi, rbx;
        call battery_monitor_flags;
        cmp rax, 1;                      // F_STATE_CHANGED
        jne bm_w_fail_stage;

        mov rdi, rbx;
        mov rsi, 1;                      // ack F_STATE_CHANGED
        call battery_monitor_ack;
        cmp rax, 0;
        jne bm_w_fail_stage;

        mov rdi, rbx;
        call battery_monitor_flags;
        cmp rax, 0;
        jne bm_w_fail_stage;

        // ================================================================
        // S5 — LOW crossing (with concurrent state change).
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _bm_w_stage];
        mov [rcx], rax;

        mov rdi, 245;
        mov rsi, 3;                      // below threshold 5
        mov rdx, 11500;
        mov rcx, 2;                      // DISCHARGING (was CHARGING)
        call battery_monitor_tick;
        cmp rax, 0;
        jne bm_w_fail_stage;

        mov rdi, rbx;
        call battery_monitor_flags;
        cmp rax, 3;                      // STATE_CHANGED | LOW_WARNING
        jne bm_w_fail_stage;

        // LATCH bit is in the raw word.
        mov rdi, rbx;
        call battery_monitor_flags_raw;
        mov r11, 1;
        shl r11, 16;                     // LOW_LATCHED
        and rax, r11;
        cmp rax, r11;
        jne bm_w_fail_stage;

        // Ack the two dispatchable bits.
        mov rdi, rbx;
        mov rsi, 3;
        call battery_monitor_ack;
        cmp rax, 0;
        jne bm_w_fail_stage;

        mov rdi, rbx;
        call battery_monitor_flags;
        cmp rax, 0;                      // dispatchable cleared
        jne bm_w_fail_stage;

        // But LATCH survives ack.
        mov rdi, rbx;
        call battery_monitor_flags_raw;
        mov r11, 1;
        shl r11, 16;
        and rax, r11;
        cmp rax, r11;
        jne bm_w_fail_stage;

        // ================================================================
        // S6 — latched, no re-fire.
        // ================================================================
        mov rax, 60;
        lea rcx, [rip + _bm_w_stage];
        mov [rcx], rax;

        mov rdi, 245;
        mov rsi, 2;                      // still below threshold
        mov rdx, 11400;
        mov rcx, 2;                      // still DISCHARGING
        call battery_monitor_tick;
        cmp rax, 0;
        jne bm_w_fail_stage;

        mov rdi, rbx;
        call battery_monitor_flags;
        cmp rax, 0;                      // no re-fire
        jne bm_w_fail_stage;

        // ================================================================
        // S7 — re-arm past threshold + HYST.
        // ================================================================
        mov rax, 70;
        lea rcx, [rip + _bm_w_stage];
        mov [rcx], rax;

        mov rdi, 245;
        mov rsi, 10;                     // > 5 + 3 = 8
        mov rdx, 11800;
        mov rcx, 2;
        call battery_monitor_tick;
        cmp rax, 0;
        jne bm_w_fail_stage;

        mov rdi, rbx;
        call battery_monitor_flags;
        cmp rax, 0;
        jne bm_w_fail_stage;

        // LATCH is now clear.
        mov rdi, rbx;
        call battery_monitor_flags_raw;
        mov r11, 1;
        shl r11, 16;
        and rax, r11;
        cmp rax, 0;
        jne bm_w_fail_stage;

        // ================================================================
        // S8 — re-fire after re-arm.
        // ================================================================
        mov rax, 80;
        lea rcx, [rip + _bm_w_stage];
        mov [rcx], rax;

        mov rdi, 245;
        mov rsi, 3;                      // back below threshold
        mov rdx, 11500;
        mov rcx, 2;
        call battery_monitor_tick;
        cmp rax, 0;
        jne bm_w_fail_stage;

        mov rdi, rbx;
        call battery_monitor_flags;
        cmp rax, 2;                      // F_LOW_WARNING only (no state delta)
        jne bm_w_fail_stage;

        // ================================================================
        // S9 — refusals.
        // ================================================================
        mov rax, 90;
        lea rcx, [rip + _bm_w_stage];
        mov [rcx], rax;

        // Ack with LOW_LATCHED bit in mask -> BAD_ACK.
        mov rdi, rbx;
        mov rsi, 0x10000;
        call battery_monitor_ack;
        mov r11, 0xFFFFFE6A;             // BAD_ACK
        cmp rax, r11;
        jne bm_w_fail_stage;

        // Ack with reserved bit -> BAD_ACK.
        mov rdi, rbx;
        mov rsi, 0x100;
        call battery_monitor_ack;
        mov r11, 0xFFFFFE6A;
        cmp rax, r11;
        jne bm_w_fail_stage;

        // Ack against out-of-range row -> BAD_ROW.
        mov rdi, 8;                      // BATTERY_MONITOR_MAX
        mov rsi, 1;
        call battery_monitor_ack;
        mov r11, 0xFFFFFE6F;             // BAD_ROW
        cmp rax, r11;
        jne bm_w_fail_stage;

        // Tick against a slot naming no battery -> BAD_ROW.
        mov rdi, 246;                    // empty slot
        mov rsi, 50;
        mov rdx, 12000;
        mov rcx, 2;
        call battery_monitor_tick;
        mov r11, 0xFFFFFE6F;
        cmp rax, r11;
        jne bm_w_fail_stage;

        // Tick with implausible percent propagates battery_report_install's
        // refusal verbatim, and flags DO NOT MOVE.
        mov rdi, rbx;
        call battery_monitor_flags;
        mov r14, rax;                    // save flags before

        mov rdi, 245;
        mov rsi, 200;                    // implausible
        mov rdx, 12000;
        mov rcx, 2;
        call battery_monitor_tick;
        mov r11, 0xFFFFFE42;             // BATTERY_IMPLAUSIBLE_PCT
        cmp rax, r11;
        jne bm_w_fail_stage;

        mov rdi, rbx;
        call battery_monitor_flags;
        cmp rax, r14;                    // unchanged
        jne bm_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bm_w_ok];
        call klog_s1;

        call battery_monitor_table_reset;
        call battery_table_reset;
        call bm_w_clear;
        xor rax, rax;
        jmp bm_w_out;

      bm_w_fail_stage:
        lea rax, [rip + _bm_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bm_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call battery_monitor_table_reset;
        call battery_table_reset;
        call bm_w_clear;
        mov rax, 1;

      bm_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
