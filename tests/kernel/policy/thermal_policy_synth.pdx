// tests/kernel/policy/thermal_policy_synth.pdx — R31.M2-003 (#1096)
//
// Boot witness for the thermal-policy MAP -- the level-to-intent table
// and the two readers over it. The name matters: this fixture asserts
// the MAP and not "the policy", because a fingerprint that read
// "THERMAL POLICY OK" here would be the kernel talking to itself
// dressed up as thermal management, which is what #1590 unwound for
// three closed issues. The sibling fixture
// `tests/kernel/cap/thermal_zone_synth.pdx` records that refusal at
// length in its header.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts installation, monotonicity, table refusals and slot
// resolution. IT ASSERTS NOTHING ABOUT A FAN AND NOTHING ABOUT A
// SHUTDOWN. `src/kernel/core/policy/thermal_policy.pdx` §4 lists the
// four things that stay deferred: no cooling channel (#1103), no
// platform-shutdown path (#1580), no ring-3 subscriber (#1097), no
// syscall shim to tune the map from ring 3. Each is a separate issue,
// and each has to land before the corresponding assertion would be
// something other than the kernel congratulating itself.
//
// -----------------------------------------------------------------------------
// One fingerprint, not two
// -----------------------------------------------------------------------------
//
//   R31 THERMAL POLICY MAP OK — the table, its refusals, and the slot
//                                resolver over a scrubbed row.
//
// One and not two, unlike the KIND_THERMAL_ZONE witness's A/B split,
// because everything here is arithmetic over the same table -- there is
// no unit conversion, no arithmetic ladder, and no candidate/latch state
// machine to fail for reasons independent of the install path.
//
// -----------------------------------------------------------------------------
// Cap slots 224..231
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness in the tree (which use 0..8, 10..12,
// 14..19, 28..33, 46..63, 64..95, 110..117, 160..199, 200..211, 212..223).
// Both exits scrub the slots and reset the map, so a failure here cannot
// be mistaken for a fault in whatever runs next. Cap slots are needed
// only for the slot-resolver failure edges (an empty slot and a KIND_DEVICE
// slot); no zone is minted here, and none of the write paths in
// `kind_thermal_zone.pdx` are exercised through this fixture.

module ThermalPolicySynth = structure {

  pub let mut _tp_w_stage : u64 = 0

  pub let tp_w_ok   : [u8; 22] = "THERMAL POLICY MAP OK\0"
  pub let tp_w_fail : [u8; 24] = "THERMAL POLICY MAP FAIL\0"

  // ==========================================================================
  // tp_w_clear() — return slots 224..231 to boot state.
  //
  // Called on entry and on both exits. Uses cap_mint_write, the only
  // descriptor writer, so the owner column's unconditional clear (#1587)
  // runs on every one of them.
  // ==========================================================================

  pub let tp_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-003 (#1096): clear cap_table slots 224..231 through cap_mint_write. A witness whose failure path leaked descriptors would make every witness after it report a different fault than the one that actually happened. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed tp_wc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        mov rbx, 224;
      tp_wc_loop:
        cmp rbx, 232;
        jae tp_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp tp_wc_loop;
      tp_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let thermal_policy_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R31.M2-003 (#1096): boot witness for the thermal-policy map and its two readers. Stages, in order: (S1) reset returns every entry to UNSET, and intent_of_level for every level answers THERMAL_POLICY_INTENT_BAD; the vacuity guard that would otherwise let a broken table pass by having nothing to disagree with. (S2) install refuses OOB level (6 and above), refuses OOB intent (0 -- the UNSET sentinel -- and above THERMAL_POLICY_INTENT_MAX), stores a valid install (NOMINAL -> NONE) and reads it back, then rejects a DIFFERENT intent on the same level with THERMAL_POLICY_MAP_ALREADY and ACCEPTS the SAME intent as idempotent OK. The three states of the monotonicity gate are the shape of the invariant, and one missing corner is how ec_event_map_set would silently reinterpret a byte. (S3) install the six-level default -- NOMINAL -> NONE, ACTIVE1/2/3 -> ACTIVE, PASSIVE -> ACTIVE, CRITICAL -> CRITICAL -- and read each back through intent_of_level. Level 5 (CRITICAL) is INSTALLED WITH INTENT_CRITICAL, which is the assertion that the boundary-of-range compare in install permits MAX and not MAX-1. (S4) the slot resolver refuses. An empty slot answers THERMAL_POLICY_INTENT_BAD (latch of a slot holding nothing is THERMAL_DECODE_BAD, propagated). A slot holding a KIND_DEVICE (not a zone) answers the same. Both exits scrub the map and clear the slots. Five pushes (rbx, r12, r13, r14, r15) leave rsp%16 == 0 at every nested call; the stage counter lives in module .bss so it survives every callee-save-clobber pattern. Labels prefixed tp_w_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _tp_w_stage];
        mov [rcx], rax;

        call thermal_policy_map_reset;
        call tp_w_clear;

        // Slot 224 — a synthetic KIND_DEVICE parent (kind = 10). Used only
        // as a witness that intent_of_slot refuses a non-zone slot. Rights
        // and target_ptr are non-zero so the descriptor is "live" enough
        // to reach the slot-resolver's kind check.
        mov rdi, 224;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x200;
        mov rcx, 0xBB01;
        call cap_mint_write;

        // ================================================================
        // S1 — RESET LEAVES EVERY ENTRY UNSET.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _tp_w_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // NOMINAL
        call thermal_policy_intent_of_level;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne tp_w_fail_stage;

        mov rdi, 5;                      // CRITICAL
        call thermal_policy_intent_of_level;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne tp_w_fail_stage;

        // ================================================================
        // S2 — INSTALL REFUSALS AND THE MONOTONICITY GATE.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _tp_w_stage];
        mov [rcx], rax;

        // (a) OOB level: 6 is one past THERMAL_POLICY_LVL_MAX.
        mov rdi, 6;
        mov rsi, 1;                      // INTENT_NONE
        call thermal_policy_map_install;
        mov r11, 0xFFFFFE2A;             // THERMAL_POLICY_BAD_LEVEL
        cmp rax, r11;
        jne tp_w_fail_stage;

        // (b) OOB intent: 0 (UNSET sentinel) is refused as a stored value.
        mov rdi, 0;
        mov rsi, 0;
        call thermal_policy_map_install;
        mov r11, 0xFFFFFE29;             // THERMAL_POLICY_BAD_INTENT
        cmp rax, r11;
        jne tp_w_fail_stage;

        // (c) OOB intent: MAX+1 is refused.
        mov rdi, 0;
        mov rsi, 4;                      // one past THERMAL_POLICY_INTENT_MAX
        call thermal_policy_map_install;
        mov r11, 0xFFFFFE29;             // THERMAL_POLICY_BAD_INTENT
        cmp rax, r11;
        jne tp_w_fail_stage;

        // (d) A valid install and read-back.
        mov rdi, 0;                      // NOMINAL
        mov rsi, 1;                      // INTENT_NONE
        call thermal_policy_map_install;
        cmp rax, 0;
        jne tp_w_fail_stage;

        mov rdi, 0;
        call thermal_policy_intent_of_level;
        cmp rax, 1;                      // INTENT_NONE
        jne tp_w_fail_stage;

        // (e) Idempotent install of the SAME intent returns OK.
        mov rdi, 0;
        mov rsi, 1;
        call thermal_policy_map_install;
        cmp rax, 0;
        jne tp_w_fail_stage;

        // (f) Install of a DIFFERENT intent on a filled level returns
        //     MAP_ALREADY.
        mov rdi, 0;
        mov rsi, 2;                      // INTENT_ACTIVE
        call thermal_policy_map_install;
        mov r11, 0xFFFFFE28;             // THERMAL_POLICY_MAP_ALREADY
        cmp rax, r11;
        jne tp_w_fail_stage;

        // ================================================================
        // S3 — THE SIX-LEVEL DEFAULT.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _tp_w_stage];
        mov [rcx], rax;

        // NOMINAL was already installed in S2(d). Install the remaining
        // five, level by level.
        mov rdi, 1;                      // ACTIVE1
        mov rsi, 2;                      // INTENT_ACTIVE
        call thermal_policy_map_install;
        cmp rax, 0;
        jne tp_w_fail_stage;

        mov rdi, 2;                      // ACTIVE2
        mov rsi, 2;
        call thermal_policy_map_install;
        cmp rax, 0;
        jne tp_w_fail_stage;

        mov rdi, 3;                      // ACTIVE3
        mov rsi, 2;
        call thermal_policy_map_install;
        cmp rax, 0;
        jne tp_w_fail_stage;

        mov rdi, 4;                      // PASSIVE
        mov rsi, 2;
        call thermal_policy_map_install;
        cmp rax, 0;
        jne tp_w_fail_stage;

        mov rdi, 5;                      // CRITICAL — THE BOUNDARY CASE.
        mov rsi, 3;                      // INTENT_CRITICAL
        call thermal_policy_map_install;
        cmp rax, 0;
        jne tp_w_fail_stage;

        // Read each back.
        mov rdi, 0;
        call thermal_policy_intent_of_level;
        cmp rax, 1;                      // INTENT_NONE
        jne tp_w_fail_stage;

        mov rdi, 1;
        call thermal_policy_intent_of_level;
        cmp rax, 2;                      // INTENT_ACTIVE
        jne tp_w_fail_stage;

        mov rdi, 2;
        call thermal_policy_intent_of_level;
        cmp rax, 2;
        jne tp_w_fail_stage;

        mov rdi, 3;
        call thermal_policy_intent_of_level;
        cmp rax, 2;
        jne tp_w_fail_stage;

        mov rdi, 4;
        call thermal_policy_intent_of_level;
        cmp rax, 2;
        jne tp_w_fail_stage;

        mov rdi, 5;
        call thermal_policy_intent_of_level;
        cmp rax, 3;                      // INTENT_CRITICAL
        jne tp_w_fail_stage;

        // ================================================================
        // S4 — THE SLOT RESOLVER REFUSES A NON-ZONE.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _tp_w_stage];
        mov [rcx], rax;

        // An empty slot: the underlying thermal_zone_crt_latched_of_slot
        // answers THERMAL_DECODE_BAD, which intent_of_slot propagates.
        mov rdi, 231;                    // a slot holding nothing
        call thermal_policy_intent_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;     // THERMAL_POLICY_INTENT_BAD
        cmp rax, r11;
        jne tp_w_fail_stage;

        // A slot holding a KIND_DEVICE, not a zone. Same answer.
        mov rdi, 224;
        call thermal_policy_intent_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne tp_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tp_w_ok];
        call klog_s1;

        call thermal_policy_map_reset;
        call tp_w_clear;
        xor rax, rax;
        jmp tp_w_out;

      tp_w_fail_stage:
        lea rax, [rip + _tp_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tp_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call thermal_policy_map_reset;
        call tp_w_clear;
        mov rax, 1;

      tp_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
