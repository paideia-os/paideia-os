// tests/kernel/input/hotkey_synth.pdx — R31.M6-001/002/003
// (#1111 / #1112 / #1113)
//
// Boot witness for src/kernel/core/input/hotkey_dispatch.pdx: the
// monotone installer, the two lookup shapes, the volume + media
// routing counters (KIND_HID_EVENT deferred), and the ONE composed
// path this milestone binds live -- Fn+F5/F6 through
// backlight_report_install.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts installation, monotonicity refusals, per-sink routing
// counters, and an end-to-end round trip through KIND_BACKLIGHT for
// the two backlight bytes. IT ASSERTS NOTHING ABOUT AN AUDIO STREAM,
// A MICROPHONE MUTE PIN OR A PLAY-PAUSE HID EVENT, because no
// KIND_HID_EVENT exists in this tree (R32 owns it) and no audio
// subsystem exists in this tree (R33 owns it) --
// hotkey_dispatch.pdx §0.1 states this at length.
//
// -----------------------------------------------------------------------------
// THREE FINGERPRINTS, one per issue in the R31.M6 cluster
// -----------------------------------------------------------------------------
//
//   R31 HOTKEY VOLUME OK    — #1111. Volume-key install + route paths.
//   R31 HOTKEY BACKLIGHT OK — #1112. Backlight-key install + the
//                             composed KIND_BACKLIGHT path.
//   R31 HOTKEY MEDIA OK     — #1113. Media-key install + route paths.
//
// Three and not one, because the three issues can fail for unrelated
// reasons (a broken sink enumeration, a KIND_BACKLIGHT regression, a
// counter arithmetic bug), and a golden that asserts an ordered
// subsequence needs the three failures distinguishable in the log.
//
// -----------------------------------------------------------------------------
// Cap slots 100..103
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness in the tree. The backlight fixture
// uses 96..99, and 104..109 was the next unallocated small window;
// 100..103 sits between them and is used by this witness for its own
// well-formed KIND_DEVICE parent (100), a subject slot (101) and two
// spare bytes for a re-mint round trip. Both exits scrub the
// _hotkey_dispatch_table, reset _backlight_table (because the composed
// path mints and revokes a live backlight capability), and clear the
// four cap_table slots.
//
// -----------------------------------------------------------------------------
// The query bytes, and why these bytes
// -----------------------------------------------------------------------------
//
// The T14 G4's shipping BIOS numbers hot-key queries in the 0x10..0x1F
// range with vendor-specific offsets. Rather than baking one BIOS
// revision's numbers in, the fixture picks four bytes in that
// neighbourhood and installs them at fixture time -- 0x11 (Fn+F1
// mute), 0x12/0x13 (Fn+F2/F3 vol-down/up), 0x15 (Fn+F5 bright-down),
// 0x16 (Fn+F6 bright-up), 0x1B (Fn+F11 mic-mute), 0x1C (Fn+F12
// play/pause). The exact numbers do not matter to the fixture -- it
// asserts the arithmetic of install and dispatch, not a firmware fact.

module HotkeySynth = structure {

  pub let mut _hk_w_stage : u64 = 0

  pub let hk_w_ok_v   : [u8; 22] = "R31 HOTKEY VOLUME OK\n\0"
  pub let hk_w_fail_v : [u8; 24] = "R31 HOTKEY VOLUME FAIL\n\0"
  pub let hk_w_ok_b   : [u8; 25] = "R31 HOTKEY BACKLIGHT OK\n\0"
  pub let hk_w_fail_b : [u8; 27] = "R31 HOTKEY BACKLIGHT FAIL\n\0"
  pub let hk_w_ok_m   : [u8; 21] = "R31 HOTKEY MEDIA OK\n\0"
  pub let hk_w_fail_m : [u8; 23] = "R31 HOTKEY MEDIA FAIL\n\0"

  // ==========================================================================
  // hk_w_clear() — return slots 100..103 to boot state.
  // ==========================================================================

  pub let hk_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M6-001/002/003: clear cap_table slots 100..103 through cap_mint_write, the only descriptor writer, so the owner column's unconditional clear runs on every one of them. Called on every exit: a witness whose failure path leaked four descriptors would make every witness after it report a different fault than the one that actually happened. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed hk_wc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        mov rbx, 100;
      hk_wc_loop:
        cmp rbx, 104;
        jae hk_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp hk_wc_loop;
      hk_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let hk_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-001/002/003: reset the hot-key dispatch table, its counters, and the backlight row table (because the backlight stage mints and revokes a live capability that has its own row). Two nested calls; one push leaves rsp%16 == 0 at each. Labels prefixed hk_ws_.",
      block: {
        push rbx;
        call hotkey_dispatch_reset;
        call backlight_table_reset;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hk_w_device(slot, key, rights) — mint a synthetic KIND_DEVICE parent.
  // ==========================================================================

  pub let hk_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M6-002 (#1112): write a synthetic KIND_DEVICE descriptor whose target_ptr is `key`, through cap_mint_write. Two pushes leave rsp%16 == 0 at the nested call.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hk_w_pack_range : (u64, u64) -> u64 !{} @{} =
    fn (bmin: u64) (bmax: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M6-002 (#1112): pack (bmin, bmax) as bmin | (bmax << 32) for backlight_cap_mint. Pure leaf.",
      block: {
        mov rax, rsi;
        shl rax, 32;
        or  rax, rdi;
        ret
      }
    }

  // ==========================================================================
  // hotkey_witness — the fixture. Three stages, three fingerprints.
  // ==========================================================================

  pub let hotkey_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R31.M6-001/002/003 (#1111/#1112/#1113): boot witness for the hot-key dispatch cluster. STAGE V (#1111 volume) drives four volume bytes (mute + down + up + one refused-monotonicity retry) and asserts the routed_volume counter moves by three (three legitimate routes) while routed_backlight and routed_media do not. STAGE B (#1112 backlight) mints a live KIND_BACKLIGHT with brightness range [0..100], installs two backlight-key meanings, drives an UP step from base=50 and a DOWN step from base=50, and asserts backlight_current_of_slot moves to 60 then 40 -- the composed path through backlight_report_install is what makes THIS stage the only one wired to a real actuator. STAGE M (#1113 media) drives two media bytes and asserts routed_media moves by two, mirroring the volume stage's counter shape. Each stage runs only if the previous PASSED, and each stage emits its own fingerprint so a partial pass is visible. Both exits call hk_w_scrub and hk_w_clear. Five-push prologue leaves rsp%16 == 0 at every nested call; the stage counter lives in module .bss so it survives every callee-save-clobber pattern. Labels prefixed hk_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        call hk_w_clear;
        call hk_w_scrub;

        // ================================================================
        // STAGE V — VOLUME (#1111)
        // ================================================================

        // V1. Install three volume bytes. 0x11 = mute, 0x12 = down,
        //     0x13 = up.
        mov rax, 10;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        mov rsi, 1;                      // HK_SINK_VOLUME
        mov rdx, 0;                      // HK_VOL_MUTE
        call hotkey_dispatch_install;
        cmp rax, 0;
        jne hk_w_fail_stage_v;

        mov rdi, 0x12;
        mov rsi, 1;
        mov rdx, 1;                      // HK_VOL_DOWN
        call hotkey_dispatch_install;
        cmp rax, 0;
        jne hk_w_fail_stage_v;

        mov rdi, 0x13;
        mov rsi, 1;
        mov rdx, 2;                      // HK_VOL_UP
        call hotkey_dispatch_install;
        cmp rax, 0;
        jne hk_w_fail_stage_v;

        // V2. Idempotence: re-install the same meaning -> OK.
        mov rax, 11;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        mov rsi, 1;
        mov rdx, 0;
        call hotkey_dispatch_install;
        cmp rax, 0;
        jne hk_w_fail_stage_v;

        // V3. Monotonicity: re-install DIFFERENT meaning -> MAP_ALREADY.
        mov rax, 12;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        mov rsi, 1;
        mov rdx, 2;                      // different action
        call hotkey_dispatch_install;
        mov r11, 0xFFFFFDB6;             // HOTKEY_MAP_ALREADY
        cmp rax, r11;
        jne hk_w_fail_stage_v;

        // V4. Byte 0 refused.
        mov rax, 13;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 0;
        call hotkey_dispatch_install;
        mov r11, 0xFFFFFDB9;             // HOTKEY_BAD_BYTE
        cmp rax, r11;
        jne hk_w_fail_stage_v;

        // V5. Bad sink refused.
        mov rax, 14;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x14;
        mov rsi, 4;                      // past HK_SINK_MAX
        mov rdx, 0;
        call hotkey_dispatch_install;
        mov r11, 0xFFFFFDB8;             // HOTKEY_BAD_SINK
        cmp rax, r11;
        jne hk_w_fail_stage_v;

        // V6. Bad action refused (VOLUME's max is 2).
        mov rax, 15;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x14;
        mov rsi, 1;                      // HK_SINK_VOLUME
        mov rdx, 3;                      // past HK_VOL_MAX
        call hotkey_dispatch_install;
        mov r11, 0xFFFFFDB7;             // HOTKEY_BAD_ACTION
        cmp rax, r11;
        jne hk_w_fail_stage_v;

        // V7. Lookups.
        mov rax, 16;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        call hotkey_dispatch_sink_of;
        cmp rax, 1;                      // HK_SINK_VOLUME
        jne hk_w_fail_stage_v;
        mov rdi, 0x11;
        call hotkey_dispatch_action_of;
        cmp rax, 0;                      // HK_VOL_MUTE
        jne hk_w_fail_stage_v;

        mov rdi, 0x50;                   // never installed
        call hotkey_dispatch_sink_of;
        cmp rax, 0;                      // HK_SINK_NONE
        jne hk_w_fail_stage_v;
        mov rdi, 0x50;
        call hotkey_dispatch_action_of;
        mov r11, 0xFFFFFFFFFFFFFFFF;     // HOTKEY_DECODE_BAD
        cmp rax, r11;
        jne hk_w_fail_stage_v;

        // V8. Route the three volume bytes; counter must move by 3.
        mov rax, 17;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // HK_ST_ROUTED_VOLUME
        call hotkey_dispatch_stat;
        mov r14, rax;                    // before

        mov rdi, 0x11;
        call hotkey_dispatch_route;
        cmp rax, 1;                      // HK_SINK_VOLUME
        jne hk_w_fail_stage_v;

        mov rdi, 0x12;
        call hotkey_dispatch_route;
        cmp rax, 1;
        jne hk_w_fail_stage_v;

        mov rdi, 0x13;
        call hotkey_dispatch_route;
        cmp rax, 1;
        jne hk_w_fail_stage_v;

        mov rdi, 0;
        call hotkey_dispatch_stat;
        sub rax, r14;
        cmp rax, 3;
        jne hk_w_fail_stage_v;

        // V9. Unmapped byte routes to HOTKEY_UNMAPPED and bumps the
        //     unmapped counter by 1.
        mov rax, 18;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 3;                      // HK_ST_UNMAPPED
        call hotkey_dispatch_stat;
        mov r14, rax;

        mov rdi, 0x50;
        call hotkey_dispatch_route;
        mov r11, 0xFFFFFDB5;             // HOTKEY_UNMAPPED
        cmp rax, r11;
        jne hk_w_fail_stage_v;

        mov rdi, 3;
        call hotkey_dispatch_stat;
        sub rax, r14;
        cmp rax, 1;
        jne hk_w_fail_stage_v;

        // -- Stage V PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hk_w_ok_v];
        call klog_s1;

        // ================================================================
        // STAGE B — BACKLIGHT (#1112)
        // ================================================================

        // B1. Mint a live KIND_BACKLIGHT for slot 101, key 0xBB77,
        //     range [0..100], backend ACPI, index 0.
        mov rax, 20;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 100;
        mov rsi, 0xBB77;
        mov rdx, 0x200;                  // RIGHT_MINT
        call hk_w_device;

        mov rdi, 0;
        mov rsi, 100;
        call hk_w_pack_range;
        mov r15, rax;                    // range

        mov rdi, 101;                    // subject
        mov rsi, 100;                    // parent KIND_DEVICE
        mov rdx, 0x41B;                  // R_BACKLIGHT_ALL
        mov rcx, 0;                      // index 0
        mov r8, 3;                       // BACKLIGHT_BACKEND_ACPI
        mov r9, r15;
        call backlight_cap_mint;
        cmp rax, 0;
        jne hk_w_fail_stage_b;

        // B2. Install the two backlight bytes.
        mov rax, 21;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x15;
        mov rsi, 2;                      // HK_SINK_BACKLIGHT
        mov rdx, 0;                      // HK_BL_DOWN
        call hotkey_dispatch_install;
        cmp rax, 0;
        jne hk_w_fail_stage_b;

        mov rdi, 0x16;
        mov rsi, 2;
        mov rdx, 1;                      // HK_BL_UP
        call hotkey_dispatch_install;
        cmp rax, 0;
        jne hk_w_fail_stage_b;

        // B3. Non-backlight byte through the backlight helper -> BAD_SINK.
        mov rax, 22;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x11;                   // volume byte
        mov rsi, 101;
        mov rdx, 50;
        mov rcx, 10;
        call hotkey_dispatch_backlight_step;
        mov r11, 0xFFFFFDB8;             // HOTKEY_BAD_SINK
        cmp rax, r11;
        jne hk_w_fail_stage_b;

        // B4. Zero step refused.
        mov rax, 23;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x16;
        mov rsi, 101;
        mov rdx, 50;
        mov rcx, 0;
        call hotkey_dispatch_backlight_step;
        mov r11, 0xFFFFFDB4;             // HOTKEY_BAD_STEP
        cmp rax, r11;
        jne hk_w_fail_stage_b;

        // B5. Underflow refused (DOWN with base < step).
        mov rax, 24;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x15;                   // HK_BL_DOWN
        mov rsi, 101;
        mov rdx, 5;
        mov rcx, 10;                     // step > base
        call hotkey_dispatch_backlight_step;
        mov r11, 0xFFFFFDB3;             // HOTKEY_BL_FAILED
        cmp rax, r11;
        jne hk_w_fail_stage_b;

        // B6. Overrange refused (UP past brightness_max).
        mov rax, 25;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x16;
        mov rsi, 101;
        mov rdx, 95;
        mov rcx, 10;                     // 95 + 10 = 105 > 100
        call hotkey_dispatch_backlight_step;
        mov r11, 0xFFFFFDB3;             // HOTKEY_BL_FAILED
        cmp rax, r11;
        jne hk_w_fail_stage_b;

        // B7. Happy paths: UP from 50 -> current becomes 60,
        //     DOWN from 50 -> current becomes 40.
        mov rax, 26;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // HK_ST_ROUTED_BACKLIGHT
        call hotkey_dispatch_stat;
        mov r14, rax;                    // before

        mov rdi, 0x16;                   // UP
        mov rsi, 101;
        mov rdx, 50;
        mov rcx, 10;
        call hotkey_dispatch_backlight_step;
        cmp rax, 0;
        jne hk_w_fail_stage_b;

        mov rdi, 101;
        call backlight_current_of_slot;
        cmp rax, 60;
        jne hk_w_fail_stage_b;

        mov rdi, 0x15;                   // DOWN
        mov rsi, 101;
        mov rdx, 50;
        mov rcx, 10;
        call hotkey_dispatch_backlight_step;
        cmp rax, 0;
        jne hk_w_fail_stage_b;

        mov rdi, 101;
        call backlight_current_of_slot;
        cmp rax, 40;
        jne hk_w_fail_stage_b;

        // routed_backlight moved by exactly 2.
        mov rdi, 1;
        call hotkey_dispatch_stat;
        sub rax, r14;
        cmp rax, 2;
        jne hk_w_fail_stage_b;

        // B8. Revoke the backlight so the next witness inherits a
        //     scrubbed table.
        mov rax, 27;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 101;
        call backlight_cap_revoke;
        cmp rax, 0;
        jne hk_w_fail_stage_b;

        // -- Stage B PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hk_w_ok_b];
        call klog_s1;

        // ================================================================
        // STAGE M — MEDIA (#1113)
        // ================================================================

        // M1. Install two media bytes. 0x1B = mic-mute, 0x1C = play.
        mov rax, 30;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x1B;
        mov rsi, 3;                      // HK_SINK_MEDIA
        mov rdx, 0;                      // HK_MEDIA_MIC_MUTE
        call hotkey_dispatch_install;
        cmp rax, 0;
        jne hk_w_fail_stage_m;

        mov rdi, 0x1C;
        mov rsi, 3;
        mov rdx, 1;                      // HK_MEDIA_PLAY
        call hotkey_dispatch_install;
        cmp rax, 0;
        jne hk_w_fail_stage_m;

        // M2. Bad action refused (MEDIA's max is 1).
        mov rax, 31;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x1D;
        mov rsi, 3;
        mov rdx, 2;                      // past HK_MEDIA_MAX
        call hotkey_dispatch_install;
        mov r11, 0xFFFFFDB7;             // HOTKEY_BAD_ACTION
        cmp rax, r11;
        jne hk_w_fail_stage_m;

        // M3. Route the two media bytes; counter moves by 2.
        mov rax, 32;
        lea rcx, [rip + _hk_w_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // HK_ST_ROUTED_MEDIA
        call hotkey_dispatch_stat;
        mov r14, rax;

        mov rdi, 0x1B;
        call hotkey_dispatch_route;
        cmp rax, 3;                      // HK_SINK_MEDIA
        jne hk_w_fail_stage_m;

        mov rdi, 0x1C;
        call hotkey_dispatch_route;
        cmp rax, 3;
        jne hk_w_fail_stage_m;

        mov rdi, 2;
        call hotkey_dispatch_stat;
        sub rax, r14;
        cmp rax, 2;
        jne hk_w_fail_stage_m;

        // -- Stage M PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hk_w_ok_m];
        call klog_s1;

        // ================================================================
        // PASS.
        // ================================================================
        call hk_w_scrub;
        call hk_w_clear;
        xor rax, rax;
        jmp hk_w_out;

      hk_w_fail_stage_v:
        lea rax, [rip + _hk_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hk_w_fail_v];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp hk_w_failed;

      hk_w_fail_stage_b:
        lea rax, [rip + _hk_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hk_w_fail_b];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp hk_w_failed;

      hk_w_fail_stage_m:
        lea rax, [rip + _hk_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hk_w_fail_m];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      hk_w_failed:
        call hk_w_scrub;
        call hk_w_clear;
        mov rax, 1;

      hk_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
