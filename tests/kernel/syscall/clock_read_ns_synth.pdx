// tests/kernel/syscall/clock_read_ns_synth.pdx — #1582 part A R30 witness
//
// Two back-to-back sys_clock_read_ns_body calls + a `pause` between them,
// asserting:
//   * both reads return non-zero (hpet_now_ns's _hpet_ctx.base==0 guard
//     never fires — hpet_init landed at kernel_main.pdx L238, well before
//     boot_continue_after_ring3 reaches witness_r30_platform)
//   * the second read is >= the first (monotonic-non-decreasing property
//     inherited from HPET MAIN_COUNTER's monotonicity)
//
// A `pause` is inserted between the two calls to give the HPET counter
// meaningful ticks to advance on QEMU/TCG (period = 10 ns, so a single
// `pause` doesn't guarantee a full tick — but the imul truncation stays
// monotonic even at a delta of 0, so equality is legal).  The witness
// asserts `second >= first`, not `second > first`, because a fast enough
// silicon path could return identical ns readings within the ~10-100 ns
// HPET quantum without violating the contract.
//
// Fingerprint on the wire:
//   "R30 CLOCK READ NS OK\n"   on success
//   "R30 CLOCK READ NS FAIL\n" on any assertion trip
//
// Called from src/kernel/boot/witness/r30_platform.pdx §clock_read_ns_
// witness_call, appended near the end of the witness sequence with the
// other #1582 witnesses.

module ClockReadNsSynth = structure {

  pub let clock_read_ns_ok_msg   : [u8; 22] = "R30 CLOCK READ NS OK\n\0"
  pub let clock_read_ns_fail_msg : [u8; 24] = "R30 CLOCK READ NS FAIL\n\0"

  // ============================================================================
  // clock_read_ns_witness — two-call monotonicity + non-zero check.
  //
  // Register plan (leaf-caller into sys_clock_read_ns_body and uart_puts):
  //   rbx = first read (preserved across the second call + optional pause)
  //   Body prologue: push rbx; (leaf-caller alignment: entry rsp % 16 == 8
  //   after the `call` from r30_platform; +1 push → rsp % 16 == 0 pre-call
  //   to sys_clock_read_ns_body, which is what SysV requires).
  //
  // sys_clock_read_ns_body is a leaf tail-call to hpet_now_ns; its own
  // callee-save discipline preserves rbx (only rax/rcx are written).
  // uart_puts on the fingerprint emit path preserves rbx by SysV convention.
  // ============================================================================
  pub let clock_read_ns_witness : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "#1582 part A witness. Calls sys_clock_read_ns_body twice (with a `pause` between to let the HPET counter tick) and asserts (a) both reads return non-zero — i.e. hpet_init has run and _hpet_ctx.base is populated — and (b) second >= first (monotonic-non-decreasing).  The `pause` hint is discretionary: on QEMU/TCG the emulated HPET runs slowly enough that a bare back-to-back read may return identical ns without violating the contract, so the assertion uses >= not >.  The witness itself does NOT drive sys_clock_read_ns through the syscall dispatch path — that would require a fake ring-3 stack + iretq round-trip which the boot witness path is not set up for; instead we call the body directly, which is exactly what the dispatch shim does after loading _current_tcb (no user-args on this syscall, so there is no meaningful semantic difference between the direct-body-call and the through-dispatch invocation for the correctness properties this witness measures).  Register discipline: single callee-save push (rbx = first read).  Entry rsp % 16 == 8 (SysV call from r30_platform witness sequence).  1 push → rsp % 16 == 0 pre-call to sys_clock_read_ns_body — matches SysV.  Fingerprint emit via uart_puts (leaf; callee-save clean by convention — SysV preserves rbx across function calls, so the ok/fail msg emit doesn't need to bracket rbx).  Success path: mov rax, 0; pop rbx; ret.  Failure path: same shape with rax = 1.",
      block: {
        push rbx;

        // ---- Sub-test A: first read ----
        call sys_clock_read_ns_body;
        cmp rax, 0;
        je  clock_read_ns_witness_fail;         // hpet not initialised
        mov rbx, rax;                           // rbx = first read

        // Insert a hint that the CPU can rest / yield an SMT sibling.
        // Not required for correctness; helps the HPET counter accumulate
        // ticks on TCG where its increment is coarse relative to the raw
        // rdtsc rate.
        pause;

        // ---- Sub-test B: second read ----
        call sys_clock_read_ns_body;
        cmp rax, 0;
        je  clock_read_ns_witness_fail;         // hpet regressed to 0 (impossible)

        // ---- Assertion: rax (second) >= rbx (first) ----
        cmp rax, rbx;
        jb  clock_read_ns_witness_fail;

        // ---- All green ----
        lea rdi, [rip + clock_read_ns_ok_msg];
        call uart_puts;
        mov rax, 0;
        pop rbx;
        ret;

      clock_read_ns_witness_fail:
        lea rdi, [rip + clock_read_ns_fail_msg];
        call uart_puts;
        mov rax, 1;
        pop rbx;
        ret
      }
    } @no_frame
}
