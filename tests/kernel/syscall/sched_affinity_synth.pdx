// tests/kernel/syscall/sched_affinity_synth.pdx — #1582 part B R30 witness
//
// End-to-end assertion suite for sched_affinity.pdx's three bodies plus
// the runqueue-side LP-E reservation gate.
//
// Sub-tests (each one asserts a single property of the affinity contract):
//
//   (A) Fresh witness slab reads back cpu_mask == ~0u64.
//       task_new zero-inits every real task's slab, so the wildcard
//       ("all CPUs allowed") encoding lives at 0 internally.  The getter
//       translates 0 → ~0u64 at the syscall boundary so POSIX callers
//       never see the ambiguous "0 = empty set" reading.  Uses a
//       standalone 160-byte witness slab (large enough for +128 to be
//       in-slab; smaller than TASK_STRUCT_QWORDS=278 so it does NOT trip
//       tools/verify-task-pool-bounds.sh's STANDALONE_SLABS pin).
//
//   (B) Set a specific mask (0x5 = CPU0 + CPU2), read back exact.
//       Verifies both the store (mov [rdi+128], rsi) and the getter's
//       non-zero passthrough (no translation on values that were user-
//       provided and passed the setter's validation).
//
//   (C) Zero mask → -EINVAL.
//       The setter's Gate 1 — a task with no eligible CPUs would
//       deadlock the scheduler.  Matches POSIX sched_setaffinity's
//       EINVAL on an empty mask.
//
//   (D) Mask with bit beyond MAX_CPUS-1 (bit 4 with MAX_CPUS=4) → -EINVAL.
//       The setter's Gate 2 — bit 4 names a phantom CPU on the R18.M1
//       4-CPU ceiling; accepting it would let a task "reserve" a core
//       that does not exist and starve on real ones.
//
//   (E) LP-E reservation for pid 42 succeeds (return 0), then a second
//       reservation attempt for pid 43 fails with -EEXIST.
//       Verifies sys_reserve_lpe_class_body's guarded-store shape and
//       the "different pid on top of existing reservation" refusal.
//       Idempotent same-pid re-reservation (return 0 for pid 42 again)
//       is asserted as sub-test F.
//
//   (F) Idempotent same-pid re-reservation returns 0 without changing
//       the stored value.
//
// LEAK NOTE: this witness leaves _reserved_lpe_task_pid == 42 on exit.
// There is no release primitive at MVP (see sched_affinity.pdx §file
// header), and no other boot-path caller consumes the reservation, so
// leaving it set is harmless.  The AML executor task (#1087, arriving
// later) will call sys_reserve_lpe_class on its own real pid; that
// call will hit the same-pid-idempotent path only if the executor
// happens to be pid 42, and the -EEXIST refusal otherwise — either
// way, the executor's error handling has to deal with a preexisting
// reservation (a shell running before it, a driver claiming LP-E, etc.).
// A future revision should add sys_release_lpe_class and reset here.
//
// Fingerprint on the wire:
//   "R30 SCHED AFFINITY OK\n"   on success
//   "R30 SCHED AFFINITY FAIL\n" on any assertion trip

module SchedAffinitySynth = structure {

  pub let sched_affinity_ok_msg   : [u8; 23] = "R30 SCHED AFFINITY OK\n\0"
  pub let sched_affinity_fail_msg : [u8; 25] = "R30 SCHED AFFINITY FAIL\n\0"

  // Witness TCB — only the pid field (+0) and cpu_mask field (+128) are
  // read/written by the bodies under test.  Sized [u64; 20] (160 bytes) so
  // +128 is safely in-slab (128+8=136 < 160) while the slab is NOT
  // TASK_STRUCT_QWORDS=278 — this avoids tools/verify-task-pool-bounds.sh's
  // STANDALONE_SLABS pin (which would require adding the slab to the
  // verifier's own list otherwise).  .bss zero-init satisfies "fresh task"
  // preconditions for sub-test (A).
  pub let mut _sched_affinity_witness_task : [u64; 20] = uninit @align(8)

  // ============================================================================
  // sched_affinity_witness — 6 sub-tests, one fingerprint.
  //
  // Body structure: linear cmp/jne to sched_affinity_witness_fail; final
  // ok/fail msg emit via uart_puts.  No callee-save writes — every register
  // used is caller-save per SysV (rax, rcx, rdx, rdi, rsi, r8), and the
  // three body calls (sys_sched_setaffinity_body, sys_sched_getaffinity_body,
  // sys_reserve_lpe_class_body) are all leaf-and-callee-save-clean by
  // construction.
  //
  // Alignment: entry rsp % 16 == 8 (SysV call from r30_platform sequence).
  // Every nested call needs rsp % 16 == 0 pre-call.  We insert a single
  // `sub rsp, 8` / `add rsp, 8` bracket around each body call — matches
  // the #672 discipline everywhere else in the tree.  There is nothing
  // callee-save to preserve, so no push/pop shifts the alignment; the
  // pair sub/add reset it every time.
  // ============================================================================
  pub let sched_affinity_witness : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "#1582 part B witness. Six sub-tests exercising sys_sched_setaffinity_body / sys_sched_getaffinity_body / sys_reserve_lpe_class_body against a standalone .bss witness slab (_sched_affinity_witness_task, [u64;20]=160B — enough for TCB+0 (pid) and TCB+128 (cpu_mask), smaller than TASK_STRUCT_QWORDS so does not need verify-task-pool-bounds.sh STANDALONE_SLABS pinning). Sub-test A: getaffinity on a fresh (all-zero) slab returns ~0u64 — proves the wildcard translation at the syscall boundary. Sub-test B: setaffinity(0x5) then getaffinity == 0x5 — proves the store lands at +128 and the getter passes through non-zero values unchanged. Sub-test C: setaffinity(0) returns -EINVAL (0xFFFFFFFFFFFFFFEA) — proves Gate 1 of the setter refuses the empty-mask case that would deadlock the scheduler. Sub-test D: setaffinity(0x10) — bit 4 on MAX_CPUS=4 hardware — returns -EINVAL — proves Gate 2 of the setter refuses masks naming phantom CPUs beyond MAX_CPUS-1. Sub-test E: sys_reserve_lpe_class(42) returns 0, then sys_reserve_lpe_class(43) returns -EEXIST (0xFFFFFFFFFFFFFFEF) — proves the guarded-store gate and the different-pid refusal. Sub-test F: sys_reserve_lpe_class(42) again returns 0 — proves the same-pid-idempotent path. Leaves _reserved_lpe_task_pid == 42 on exit (no release primitive at MVP; see file header §LEAK NOTE). Register discipline: single callee-save push (rbx, unused but present) at entry flips rsp %16 from 8 to 0, so every nested `call` (three body helpers, one uart_puts) enters callee at rsp %16 == 8 as SysV requires — matches the hpet_synth/xsave_synth witness idiom of one push-at-top, one pop-at-exit. The three body helpers (sys_sched_setaffinity_body, sys_sched_getaffinity_body, sys_reserve_lpe_class_body) are all leaf, callee-save clean, and never write rbx; uart_puts preserves rbx per SysV. @no_frame at the tail matches the hpet_synth / xsave_synth witness idiom.",
      block: {
        // Single callee-save push aligns rsp %16 == 0 for every nested
        // `call` in this body — matches hpet_synth's `push rbx` at
        // L42 (tests/kernel/acpi/hpet_synth.pdx §hpet_synth_witness).
        // rbx is not written anywhere in this body; the push is purely
        // for alignment. Pop before every `ret` path (success + failure).
        push rbx;

        // ============================================================
        // Sub-test A: fresh slab → getaffinity returns ~0u64 (wildcard)
        // ============================================================
        lea rdi, [rip + _sched_affinity_witness_task];
        call sys_sched_getaffinity_body;
        mov rcx, 0xFFFFFFFFFFFFFFFF;
        cmp rax, rcx;
        jne sched_affinity_witness_fail;

        // ============================================================
        // Sub-test B: setaffinity(0x5), then getaffinity == 0x5
        // ============================================================
        lea rdi, [rip + _sched_affinity_witness_task];
        mov rsi, 0x5;                                // CPU0 + CPU2
        call sys_sched_setaffinity_body;
        cmp rax, 0;
        jne sched_affinity_witness_fail;

        lea rdi, [rip + _sched_affinity_witness_task];
        call sys_sched_getaffinity_body;
        cmp rax, 0x5;
        jne sched_affinity_witness_fail;

        // ============================================================
        // Sub-test C: setaffinity(0) → -EINVAL
        // ============================================================
        lea rdi, [rip + _sched_affinity_witness_task];
        mov rsi, 0;
        call sys_sched_setaffinity_body;
        mov rcx, 0xFFFFFFFFFFFFFFEA;                 // -EINVAL
        cmp rax, rcx;
        jne sched_affinity_witness_fail;

        // ============================================================
        // Sub-test D: setaffinity(0x10) — bit 4, beyond MAX_CPUS=4 → -EINVAL
        // ============================================================
        lea rdi, [rip + _sched_affinity_witness_task];
        mov rsi, 0x10;                               // bit 4 only
        call sys_sched_setaffinity_body;
        mov rcx, 0xFFFFFFFFFFFFFFEA;                 // -EINVAL
        cmp rax, rcx;
        jne sched_affinity_witness_fail;

        // ============================================================
        // Sub-test E: reserve LP-E for pid 42 (OK), then pid 43 (EEXIST)
        // ============================================================
        mov rdi, 42;
        call sys_reserve_lpe_class_body;
        cmp rax, 0;
        jne sched_affinity_witness_fail;

        mov rdi, 43;
        call sys_reserve_lpe_class_body;
        mov rcx, 0xFFFFFFFFFFFFFFEF;                 // -EEXIST
        cmp rax, rcx;
        jne sched_affinity_witness_fail;

        // ============================================================
        // Sub-test F: idempotent re-reservation for the SAME pid (42) → 0
        // ============================================================
        mov rdi, 42;
        call sys_reserve_lpe_class_body;
        cmp rax, 0;
        jne sched_affinity_witness_fail;

        // ---- All green ----
        lea rdi, [rip + sched_affinity_ok_msg];
        call uart_puts;
        mov rax, 0;
        pop rbx;
        ret;

      sched_affinity_witness_fail:
        lea rdi, [rip + sched_affinity_fail_msg];
        call uart_puts;
        mov rax, 1;
        pop rbx;
        ret
      }
    } @no_frame
}
