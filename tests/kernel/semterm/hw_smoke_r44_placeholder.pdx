// tests/kernel/semterm/hw_smoke_r44_placeholder.pdx -- R44.M4-003 (#1411)
//
// Dormant HW-smoke placeholder for the R44 semantic terminal GUI on
// real T14 Gen 4 hardware.
//
// Per design decision D7 (`gated:hardware`), this witness stays
// dormant in the smoke matrix until a real T14 G4 machine boots into
// the R44 GUI frontend AND executes at least one live SELECT / plot
// query against the R41 engine, WITH the R37 GPU backend actually
// rendering a Vello scene and the R36 display supervisor reporting
// an HDR-capable output that lets the plot chooser pick from the
// BT.2020 wide-gamut palette rather than the sRGB fallback.
//
// Enabling it requires:
//   - the R23 fb-console + KIND_FRAMEBUFFER path live on real firmware
//     (baseline of the R41 fb witness);
//   - the R36 display supervisor bound to a real KIND_DISPLAY_OUTPUT
//     row surfaced by the DP DDI + EDID reader with hdr_capable
//     reflected through gui_hdr.pdx;
//   - the R37 GPU backend live: Iris Xe / Vello rasterizer producing
//     actual scanlines into the compositor's swapchain;
//   - the G9 presentation_time_feedback subscription streaming real
//     feedback events into gui_feedback.pdx so the adaptive re-render
//     seam has non-witness data to drop detail_level on;
//   - the G10 input router pumping keys into gui_kbdnav.pdx and
//     gui_ime.pdx;
//   - the G11 AT-SPI-like bridge draining gui_a11y.pdx.
//
// The procedure for hardware bring-up is documented in
// tools/hw-smoke-r44-gui-terminal.md. Until then this placeholder
// returns 0 unconditionally so the smoke matrix reports GREEN without
// pretending a bring-up ran.

module HwSmokeR44Placeholder = structure {

  pub let hw_smoke_r44_placeholder : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M4-003 (#1411): dormant HW-smoke per D7 gated:hardware. Returns 0 unconditionally until a real T14 G4 boots the R44 GUI terminal with a live HDR-capable display and executes a query while G9 presentation-time-feedback events flow. See tools/hw-smoke-r44-gui-terminal.md.",
      block: {
        xor rax, rax;
        ret
      }
    }
}
