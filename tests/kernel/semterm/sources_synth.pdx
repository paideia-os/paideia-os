// tests/kernel/semterm/sources_synth.pdx -- R41.M2-002 (#1369)
//
// Boot witness for the semantic-term-core data-source registry.
// Exercises reset (with pre-registration of the five kernel
// sources), lookup on a pre-registered name hash, register + lookup
// round trip on a fresh source, duplicate + zero-hash + zero-schema
// refusals, and registry-full refusal.
//
// Fingerprint: SEMTERM SOURCES OK
// Failure fingerprint: SEMTERM SOURCES FAIL + stage number.

module SourcesSynth = structure {

  pub let mut _srw_stage : u64 = 0

  pub let srw_ok   : [u8; 21] = "SEMTERM SOURCES OK\0"
  pub let srw_fail : [u8; 23] = "SEMTERM SOURCES FAIL\0"

  pub let sources_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M2-002 (#1369): boot witness for the data-source registry. Five-push callee-save discipline. Labels prefixed srw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin.
        mov rax, 1;
        lea rcx, [rip + _srw_stage];
        mov [rcx], rax;

        call src_reset;
        call src_arbitrated;
        cmp rax, 0;
        jne srw_fail_stage;
        call src_bound;
        cmp rax, 1;
        jne srw_fail_stage;
        // Pre-registered: count = 6 (slot 0 reserved + slots 1..5).
        call src_count;
        cmp rax, 6;
        jne srw_fail_stage;

        // -- 2. Pre-registered lookups.
        mov rax, 2;
        lea rcx, [rip + _srw_stage];
        mov [rcx], rax;

        mov rdi, 0xA100;                         // SRC_H_SYSCALLS
        call src_lookup;
        cmp rax, 1;                              // SRC_SYSCALLS
        jne srw_fail_stage;

        mov rdi, 0xA101;                         // SRC_H_CAPS
        call src_lookup;
        cmp rax, 2;
        jne srw_fail_stage;

        mov rdi, 0xA102;                         // SRC_H_TASKS
        call src_lookup;
        cmp rax, 3;
        jne srw_fail_stage;

        mov rdi, 0xA103;                         // SRC_H_INTERRUPTS
        call src_lookup;
        cmp rax, 4;
        jne srw_fail_stage;

        mov rdi, 0xA104;                         // SRC_H_AUDIT
        call src_lookup;
        cmp rax, 5;
        jne srw_fail_stage;

        // Unknown lookup -> 0, err NOT latched.
        mov rdi, 0xDEADBEEF;
        call src_lookup;
        cmp rax, 0;
        jne srw_fail_stage;
        call src_err;
        cmp rax, 0;
        jne srw_fail_stage;

        // -- 3. Field readback for slot 1 (SYSCALLS).
        mov rax, 3;
        lea rcx, [rip + _srw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call src_get_schema;
        cmp rax, 1;
        jne srw_fail_stage;
        mov rdi, 1;
        call src_get_provider;
        cmp rax, 0;                              // no live provider yet
        jne srw_fail_stage;
        mov rdi, 1;
        call src_get_cap;
        cmp rax, 0;
        jne srw_fail_stage;

        // Out-of-range field readback latches err.
        mov rdi, 100;
        call src_get_schema;
        cmp rax, 0;
        jne srw_fail_stage;
        call src_err;
        mov r11, 0xFFFFF0AB;                     // SRC_ERR_BAD_ID
        cmp rax, r11;
        jne srw_fail_stage;

        // Fresh reset (clears latched err).
        call src_reset;

        // -- 4. Register a fresh source.
        mov rax, 4;
        lea rcx, [rip + _srw_stage];
        mov [rcx], rax;

        mov rdi, 0xB000;
        mov rsi, 42;
        mov rdx, 0;                              // no provider
        mov rcx, 0;                              // no cap
        call src_register;
        cmp rax, 6;                              // next slot
        jne srw_fail_stage;

        call src_count;
        cmp rax, 7;
        jne srw_fail_stage;

        mov rdi, 0xB000;
        call src_lookup;
        cmp rax, 6;
        jne srw_fail_stage;

        mov rdi, 6;
        call src_get_schema;
        cmp rax, 42;
        jne srw_fail_stage;

        // -- 5. Duplicate + zero-hash + zero-schema refusals.
        mov rax, 5;
        lea rcx, [rip + _srw_stage];
        mov [rcx], rax;

        mov rdi, 0xB000;                         // duplicate of just-registered
        mov rsi, 42;
        mov rdx, 0;
        mov rcx, 0;
        call src_register;
        cmp rax, 0;
        jne srw_fail_stage;
        call src_err;
        mov r11, 0xFFFFF0AD;                     // SRC_ERR_DUP
        cmp rax, r11;
        jne srw_fail_stage;

        call src_reset;

        // Zero hash refused (must reject BEFORE dup scan).
        xor rdi, rdi;
        mov rsi, 1;
        xor rdx, rdx;
        xor rcx, rcx;
        call src_register;
        cmp rax, 0;
        jne srw_fail_stage;
        call src_err;
        mov r11, 0xFFFFF0A9;
        cmp rax, r11;
        jne srw_fail_stage;

        call src_reset;

        // Zero schema refused.
        mov rdi, 0xC000;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call src_register;
        cmp rax, 0;
        jne srw_fail_stage;
        call src_err;
        mov r11, 0xFFFFF0AA;
        cmp rax, r11;
        jne srw_fail_stage;

        call src_reset;

        // -- 6. Registry-full refusal.
        mov rax, 6;
        lea rcx, [rip + _srw_stage];
        mov [rcx], rax;

        // After reset count is 6; fill the remaining 10 slots (6..15).
        mov r12, 0;
      srw_fill:
        cmp r12, 10;
        jae srw_fill_done;
        mov rbx, r12;
        add rbx, 0xC000;
        mov rdi, rbx;
        mov rsi, 1;
        xor rdx, rdx;
        xor rcx, rcx;
        call src_register;
        cmp rax, 0;
        je  srw_fail_stage;                      // must return non-zero source_id
        add r12, 1;
        jmp srw_fill;
      srw_fill_done:

        call src_count;
        cmp rax, 16;
        jne srw_fail_stage;

        // 17th register refused.
        mov rdi, 0xC0FF;
        mov rsi, 1;
        xor rdx, rdx;
        xor rcx, rcx;
        call src_register;
        cmp rax, 0;
        jne srw_fail_stage;
        call src_err;
        mov r11, 0xFFFFF0AE;
        cmp rax, r11;
        jne srw_fail_stage;

        // Return the module to a clean state.
        call src_reset;
        call src_bound;
        cmp rax, 1;
        jne srw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + srw_ok];
        call klog_s1;

        xor rax, rax;
        jmp srw_out;

      srw_fail_stage:
        lea rax, [rip + _srw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + srw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      srw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
