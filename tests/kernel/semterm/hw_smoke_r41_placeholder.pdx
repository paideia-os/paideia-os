// tests/kernel/semterm/hw_smoke_r41_placeholder.pdx -- R41.M5-003 (#1379)
//
// Dormant HW-smoke placeholder for the R41 semantic terminal on real
// T14 Gen 4 hardware.
//
// Per design decision D7 (`gated:hardware`), this witness stays dormant
// in the smoke matrix until a real T14 G4 machine boots into the fb
// frontend AND executes at least one live SELECT / plot query against
// the R41 engine. Enabling it requires:
//   - the R23 fb-console + KIND_FRAMEBUFFER path live on real firmware,
//   - the R26 USB HID keyboard stack delivering KIND_HID_EVENT rows
//     into semterm/fb_frontend.pdx's input queue,
//   - the R41.M2 engine bound to the pre-registered sources so a
//     SELECT parses, types, and executes against a live provider,
//   - a semterm/session_log.pdx session attached at fb-frontend attach
//     time so the recovery witness has an audit path to record on.
//
// The procedure for hardware bring-up is documented in
// tools/hw-smoke-r41-fb-terminal.md. Until then this placeholder
// returns 0 unconditionally so the smoke matrix reports GREEN without
// pretending a bring-up ran.

module HwSmokeR41Placeholder = structure {

  pub let hw_smoke_r41_placeholder : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M5-003 (#1379): dormant HW-smoke per D7 gated:hardware. Returns 0 unconditionally until a real T14 G4 boots the fb terminal and executes a live query. See tools/hw-smoke-r41-fb-terminal.md.",
      block: {
        xor rax, rax;
        ret
      }
    }
}
