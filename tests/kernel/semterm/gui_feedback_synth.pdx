// tests/kernel/semterm/gui_feedback_synth.pdx -- R44.M4-002 (#1410)
//
// Boot witness for the semterm GUI presentation-time feedback
// arbiter. Exercises reset (init_mark installed, budget == 0, all
// counters zero, both adaptive flags 0), arbitration honesty pin,
// set_budget refusal on budget == 0 (PFB_ERR_BAD_BUDGET) then a
// positive budget lands, report refusal before set_budget
// (PFB_ERR_NO_BUDGET), report refusal on presented_at < rendered_at
// (PFB_ERR_BAD_TIME), the under-budget path (latency latched,
// reports_total++, detail_level = 0, scroll_frozen = 0), the
// over-budget path (over_budget_count++, detail_level = 1,
// scroll_frozen = 1), the restore-on-fast-frame behaviour (an under-
// budget report after an over-budget one drops the flags back to
// zero), and an at-budget report (latency == budget stays under, not
// over, because the compare is strict).
//
// Fingerprint: R44 SEMTERM GUI FEEDBACK OK
// Failure fingerprint: R44 SEMTERM GUI FEEDBACK FAIL + stage number.

module GuiFeedbackSynth = structure {

  pub let mut _pfbw_stage : u64 = 0

  pub let pfbw_ok   : [u8; 25] = "SEMTERM GUI FEEDBACK OK\0"
  pub let pfbw_fail : [u8; 27] = "SEMTERM GUI FEEDBACK FAIL\0"

  pub let gui_feedback_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R44.M4-002 (#1410): boot witness for gui_feedback. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed pfbw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration + zero defaults.
        mov rax, 1;
        lea rcx, [rip + _pfbw_stage];
        mov [rcx], rax;

        call pfb_reset;
        call pfb_arbitrated;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_bound;
        cmp rax, 1;
        jne pfbw_fail_stage;
        call pfb_budget;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_last_latency;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_over_budget_count;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_reports_total;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_detail_level;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_scroll_frozen;
        cmp rax, 0;
        jne pfbw_fail_stage;

        // -- 2. set_budget refusals: budget == 0 rejected.
        mov rax, 2;
        lea rcx, [rip + _pfbw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call pfb_set_budget;
        mov r11, 0xFFFFEE3D;
        cmp rax, r11;
        jne pfbw_fail_stage;
        call pfb_budget;
        cmp rax, 0;                              // unchanged
        jne pfbw_fail_stage;

        // Positive budget lands.
        mov rdi, 16000;                          // 16 ns budget (opaque unit)
        call pfb_set_budget;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_budget;
        cmp rax, 16000;
        jne pfbw_fail_stage;

        // -- 3. Refusal: report before set_budget (re-reset + report).
        mov rax, 3;
        lea rcx, [rip + _pfbw_stage];
        mov [rcx], rax;

        call pfb_reset;
        mov rdi, 100;
        mov rsi, 200;
        call pfb_report;
        mov r11, 0xFFFFEE3C;
        cmp rax, r11;
        jne pfbw_fail_stage;
        call pfb_reports_total;
        cmp rax, 0;                              // unchanged
        jne pfbw_fail_stage;

        // Re-install budget for the remainder.
        mov rdi, 16000;
        call pfb_set_budget;
        cmp rax, 0;
        jne pfbw_fail_stage;

        // -- 4. Refusal: presented_at < rendered_at (BAD_TIME).
        mov rax, 4;
        lea rcx, [rip + _pfbw_stage];
        mov [rcx], rax;

        mov rdi, 500;                            // rendered_at
        mov rsi, 400;                            // presented_at (earlier)
        call pfb_report;
        mov r11, 0xFFFFEE3E;
        cmp rax, r11;
        jne pfbw_fail_stage;
        call pfb_reports_total;
        cmp rax, 0;                              // unchanged
        jne pfbw_fail_stage;

        // -- 5. Under-budget report -> flags stay zero.
        mov rax, 5;
        lea rcx, [rip + _pfbw_stage];
        mov [rcx], rax;

        mov rdi, 1000;
        mov rsi, 9000;                           // latency = 8000 < 16000
        call pfb_report;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_last_latency;
        cmp rax, 8000;
        jne pfbw_fail_stage;
        call pfb_reports_total;
        cmp rax, 1;
        jne pfbw_fail_stage;
        call pfb_over_budget_count;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_detail_level;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_scroll_frozen;
        cmp rax, 0;
        jne pfbw_fail_stage;

        // -- 6. Over-budget report -> flags flip to 1.
        mov rax, 6;
        lea rcx, [rip + _pfbw_stage];
        mov [rcx], rax;

        mov rdi, 10000;
        mov rsi, 40000;                          // latency = 30000 > 16000
        call pfb_report;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_last_latency;
        cmp rax, 30000;
        jne pfbw_fail_stage;
        call pfb_reports_total;
        cmp rax, 2;
        jne pfbw_fail_stage;
        call pfb_over_budget_count;
        cmp rax, 1;
        jne pfbw_fail_stage;
        call pfb_detail_level;
        cmp rax, 1;
        jne pfbw_fail_stage;
        call pfb_scroll_frozen;
        cmp rax, 1;
        jne pfbw_fail_stage;

        // -- 7. Restore on fast frame: under-budget again drops flags.
        mov rax, 7;
        lea rcx, [rip + _pfbw_stage];
        mov [rcx], rax;

        mov rdi, 50000;
        mov rsi, 51000;                          // latency = 1000 << budget
        call pfb_report;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_last_latency;
        cmp rax, 1000;
        jne pfbw_fail_stage;
        call pfb_reports_total;
        cmp rax, 3;
        jne pfbw_fail_stage;
        call pfb_over_budget_count;
        cmp rax, 1;                              // unchanged (was under)
        jne pfbw_fail_stage;
        call pfb_detail_level;
        cmp rax, 0;                              // restored
        jne pfbw_fail_stage;
        call pfb_scroll_frozen;
        cmp rax, 0;                              // restored
        jne pfbw_fail_stage;

        // -- 8. At-budget (latency == budget) counts as under (strict >).
        mov rax, 8;
        lea rcx, [rip + _pfbw_stage];
        mov [rcx], rax;

        mov rdi, 100000;
        mov rsi, 116000;                         // latency = 16000 == budget
        call pfb_report;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_last_latency;
        cmp rax, 16000;
        jne pfbw_fail_stage;
        call pfb_over_budget_count;
        cmp rax, 1;                              // unchanged
        jne pfbw_fail_stage;
        call pfb_detail_level;
        cmp rax, 0;
        jne pfbw_fail_stage;
        call pfb_scroll_frozen;
        cmp rax, 0;
        jne pfbw_fail_stage;

        // Return module to clean state.
        call pfb_reset;
        call pfb_bound;
        cmp rax, 1;
        jne pfbw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pfbw_ok];
        call klog_s1;

        xor rax, rax;
        jmp pfbw_out;

      pfbw_fail_stage:
        lea rax, [rip + _pfbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pfbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pfbw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
