// tests/kernel/semterm/fb_frontend_synth.pdx -- R41.M4-001 (#1374)
//
// Boot witness for the semantic-term framebuffer frontend. Exercises
// reset, arbitration honesty pin, cursor set + refusals (bad row/col
// and bad style), render-prepare packing (row/col/cursor overlay bit
// on a match, off otherwise), and the input queue (push + pop round
// trip, full refusal, empty refusal).
//
// Fingerprint: R41 SEMTERM FB FRONTEND OK
// Failure fingerprint: R41 SEMTERM FB FRONTEND FAIL + stage number.

module FbFrontendSynth = structure {

  pub let mut _sfbw_stage : u64 = 0

  pub let sfbw_ok   : [u8; 29] = "R41 SEMTERM FB FRONTEND OK\n\0"
  pub let sfbw_fail : [u8; 31] = "R41 SEMTERM FB FRONTEND FAIL\n\0"

  pub let fb_frontend_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M4-001 (#1374): boot witness for the fb frontend. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed sfbw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin + empty cursor + empty queue.
        mov rax, 1;
        lea rcx, [rip + _sfbw_stage];
        mov [rcx], rax;

        call sfb_reset;
        call sfb_arbitrated;
        cmp rax, 0;
        jne sfbw_fail_stage;
        call sfb_bound;
        cmp rax, 1;
        jne sfbw_fail_stage;
        call sfb_cursor_row;
        cmp rax, 0;
        jne sfbw_fail_stage;
        call sfb_cursor_col;
        cmp rax, 0;
        jne sfbw_fail_stage;
        call sfb_cursor_style;
        cmp rax, 0;
        jne sfbw_fail_stage;
        call sfb_renders;
        cmp rax, 0;
        jne sfbw_fail_stage;
        call sfb_input_len;
        cmp rax, 0;
        jne sfbw_fail_stage;

        // -- 2. Cursor set and readback.
        mov rax, 2;
        lea rcx, [rip + _sfbw_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 12;
        call sfb_cursor_set;
        cmp rax, 0;
        jne sfbw_fail_stage;
        call sfb_cursor_row;
        cmp rax, 5;
        jne sfbw_fail_stage;
        call sfb_cursor_col;
        cmp rax, 12;
        jne sfbw_fail_stage;

        // -- 3. Cursor set: row out of range.
        mov rax, 3;
        lea rcx, [rip + _sfbw_stage];
        mov [rcx], rax;

        mov rdi, 24;                             // == SFB_ROWS
        mov rsi, 0;
        call sfb_cursor_set;
        mov r11, 0xFFFFF05E;                     // SFB_ERR_BAD_ROW
        cmp rax, r11;
        jne sfbw_fail_stage;

        call sfb_reset;
        mov rdi, 5;
        mov rsi, 12;
        call sfb_cursor_set;
        cmp rax, 0;
        jne sfbw_fail_stage;

        // -- 4. Cursor set: col out of range.
        mov rax, 4;
        lea rcx, [rip + _sfbw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 80;                             // == SFB_COLS
        call sfb_cursor_set;
        mov r11, 0xFFFFF05D;                     // SFB_ERR_BAD_COL
        cmp rax, r11;
        jne sfbw_fail_stage;

        call sfb_reset;

        // -- 5. Cursor style set: valid values 0 and 1.
        mov rax, 5;
        lea rcx, [rip + _sfbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call sfb_cursor_style_set;
        cmp rax, 0;
        jne sfbw_fail_stage;
        call sfb_cursor_style;
        cmp rax, 1;
        jne sfbw_fail_stage;

        mov rdi, 0;
        call sfb_cursor_style_set;
        cmp rax, 0;
        jne sfbw_fail_stage;
        call sfb_cursor_style;
        cmp rax, 0;
        jne sfbw_fail_stage;

        // Bad style refused.
        mov rdi, 2;
        call sfb_cursor_style_set;
        mov r11, 0xFFFFF05C;                     // SFB_ERR_BAD_STYLE
        cmp rax, r11;
        jne sfbw_fail_stage;

        call sfb_reset;

        // -- 6. Render prepare: cursor overlay bit set on match.
        mov rax, 6;
        lea rcx, [rip + _sfbw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 7;
        call sfb_cursor_set;
        cmp rax, 0;
        jne sfbw_fail_stage;

        mov rdi, 3;
        mov rsi, 7;
        call sfb_render_prepare;
        // Expect: (3 << 16) | 7 | (1 << 32) = 0x1_0003_0007.
        mov r11, 0x100030007;
        cmp rax, r11;
        jne sfbw_fail_stage;

        call sfb_renders;
        cmp rax, 1;
        jne sfbw_fail_stage;

        // Different cell: cursor bit off.
        mov rdi, 3;
        mov rsi, 8;
        call sfb_render_prepare;
        // Expect: (3 << 16) | 8 = 0x30008.
        mov r11, 0x30008;
        cmp rax, r11;
        jne sfbw_fail_stage;

        call sfb_renders;
        cmp rax, 2;
        jne sfbw_fail_stage;

        // -- 7. Render prepare refuses out-of-range coordinates.
        mov rax, 7;
        lea rcx, [rip + _sfbw_stage];
        mov [rcx], rax;

        mov rdi, 24;
        mov rsi, 0;
        call sfb_render_prepare;
        mov r11, 0xFFFFF05E;
        cmp rax, r11;
        jne sfbw_fail_stage;

        call sfb_reset;

        mov rdi, 0;
        mov rsi, 80;
        call sfb_render_prepare;
        mov r11, 0xFFFFF05D;
        cmp rax, r11;
        jne sfbw_fail_stage;

        call sfb_reset;

        // -- 8. Input queue: push + pop round trip.
        mov rax, 8;
        lea rcx, [rip + _sfbw_stage];
        mov [rcx], rax;

        mov rdi, 0x41;                           // 'A'
        call sfb_input_push;
        cmp rax, 0;
        jne sfbw_fail_stage;
        mov rdi, 0x42;                           // 'B'
        call sfb_input_push;
        cmp rax, 0;
        jne sfbw_fail_stage;
        mov rdi, 0x43;                           // 'C'
        call sfb_input_push;
        cmp rax, 0;
        jne sfbw_fail_stage;

        call sfb_input_len;
        cmp rax, 3;
        jne sfbw_fail_stage;

        call sfb_input_pop;
        cmp rax, 0x41;
        jne sfbw_fail_stage;
        call sfb_input_pop;
        cmp rax, 0x42;
        jne sfbw_fail_stage;
        call sfb_input_pop;
        cmp rax, 0x43;
        jne sfbw_fail_stage;
        call sfb_input_len;
        cmp rax, 0;
        jne sfbw_fail_stage;

        // Empty refusal.
        call sfb_input_pop;
        cmp rax, 0;
        jne sfbw_fail_stage;
        call sfb_err;
        mov r11, 0xFFFFF05A;                     // SFB_ERR_INPUT_EMPTY
        cmp rax, r11;
        jne sfbw_fail_stage;

        call sfb_reset;

        // -- 9. Full refusal. 63 pushes fill (one slot reserved to distinguish
        //       full from empty); 64th refused.
        mov rax, 9;
        lea rcx, [rip + _sfbw_stage];
        mov [rcx], rax;

        xor r12, r12;                            // count
      sfbw_fill:
        mov rdi, 0x30;                           // '0'
        call sfb_input_push;
        cmp rax, 0;
        jne sfbw_fail_stage;
        add r12, 1;
        cmp r12, 63;
        jb  sfbw_fill;

        call sfb_input_len;
        cmp rax, 63;
        jne sfbw_fail_stage;

        // 64th push refused.
        mov rdi, 0x31;
        call sfb_input_push;
        mov r11, 0xFFFFF05B;                     // SFB_ERR_INPUT_FULL
        cmp rax, r11;
        jne sfbw_fail_stage;

        // Return the module to a clean state.
        call sfb_reset;
        call sfb_bound;
        cmp rax, 1;
        jne sfbw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sfbw_ok];
        call klog_s1;

        xor rax, rax;
        jmp sfbw_out;

      sfbw_fail_stage:
        lea rax, [rip + _sfbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sfbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      sfbw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
