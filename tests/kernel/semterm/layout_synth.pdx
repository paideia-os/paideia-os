// tests/kernel/semterm/layout_synth.pdx -- R41.M3-002 (#1372)
//
// Boot witness for the chart layout engine. Exercises reset,
// arbitration honesty pin, root install (including double-install
// refusal), horizontal and vertical splits with both explicit and
// flex sizes, nested layouts (split-of-split), and refusals on bad
// parent id, bad sizes, and arena exhaustion.
//
// Fingerprint: R41 SEMTERM LAYOUT OK
// Failure fingerprint: R41 SEMTERM LAYOUT FAIL + stage number.

module LayoutSynth = structure {

  pub let mut _layw_stage : u64 = 0

  pub let layw_ok   : [u8; 24] = "R41 SEMTERM LAYOUT OK\n\0"
  pub let layw_fail : [u8; 26] = "R41 SEMTERM LAYOUT FAIL\n\0"

  pub let layout_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M3-002 (#1372): boot witness for the layout engine. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed layw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin + empty arena.
        mov rax, 1;
        lea rcx, [rip + _layw_stage];
        mov [rcx], rax;

        call lay_reset;
        call lay_arbitrated;
        cmp rax, 0;
        jne layw_fail_stage;
        call lay_bound;
        cmp rax, 1;
        jne layw_fail_stage;
        call lay_pane_count;
        cmp rax, 0;
        jne layw_fail_stage;
        call lay_root_set;
        cmp rax, 0;
        jne layw_fail_stage;

        // -- 2. Split before root refused.
        mov rax, 2;
        lea rcx, [rip + _layw_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        mov rsi, 1;
        mov rdx, 1;
        call lay_split_h;
        mov r11, 0xFFFFF07B;                     // LAY_ERR_NO_ROOT
        cmp rax, r11;
        jne layw_fail_stage;

        call lay_reset;

        // -- 3. lay_root installs pane 0 covering 24x80.
        mov rax, 3;
        lea rcx, [rip + _layw_stage];
        mov [rcx], rax;

        mov rdi, 24;
        mov rsi, 80;
        call lay_root;
        cmp rax, 0;                              // pane 0
        jne layw_fail_stage;

        call lay_root_set;
        cmp rax, 1;
        jne layw_fail_stage;
        call lay_pane_count;
        cmp rax, 1;
        jne layw_fail_stage;

        mov rdi, 0;
        call lay_pane_r0;
        cmp rax, 0;
        jne layw_fail_stage;
        mov rdi, 0;
        call lay_pane_c0;
        cmp rax, 0;
        jne layw_fail_stage;
        mov rdi, 0;
        call lay_pane_rows;
        cmp rax, 24;
        jne layw_fail_stage;
        mov rdi, 0;
        call lay_pane_cols;
        cmp rax, 80;
        jne layw_fail_stage;

        // Second lay_root refused.
        mov rdi, 24;
        mov rsi, 80;
        call lay_root;
        mov r11, 0xFFFFF07A;                     // LAY_ERR_ROOT_TWICE
        cmp rax, r11;
        jne layw_fail_stage;

        call lay_reset;

        // -- 4. Horizontal split with explicit sizes.
        mov rax, 4;
        lea rcx, [rip + _layw_stage];
        mov [rcx], rax;

        mov rdi, 24;
        mov rsi, 80;
        call lay_root;

        mov rdi, 0;                              // parent = root
        mov rsi, 1;                              // top = 1 row (title)
        mov rdx, 23;                             // bottom = 23 rows (body)
        call lay_split_h;
        cmp rax, 1;                              // first child id
        jne layw_fail_stage;

        call lay_pane_count;
        cmp rax, 3;
        jne layw_fail_stage;

        mov rdi, 1;                              // top
        call lay_pane_r0;
        cmp rax, 0;
        jne layw_fail_stage;
        mov rdi, 1;
        call lay_pane_rows;
        cmp rax, 1;
        jne layw_fail_stage;
        mov rdi, 1;
        call lay_pane_cols;
        cmp rax, 80;
        jne layw_fail_stage;

        mov rdi, 2;                              // bottom
        call lay_pane_r0;
        cmp rax, 1;
        jne layw_fail_stage;
        mov rdi, 2;
        call lay_pane_rows;
        cmp rax, 23;
        jne layw_fail_stage;
        mov rdi, 2;
        call lay_pane_cols;
        cmp rax, 80;
        jne layw_fail_stage;

        call lay_reset;

        // -- 5. Horizontal split with FLEX bottom (0 = take remainder).
        mov rax, 5;
        lea rcx, [rip + _layw_stage];
        mov [rcx], rax;

        mov rdi, 24;
        mov rsi, 80;
        call lay_root;

        mov rdi, 0;
        mov rsi, 3;                              // top = 3
        mov rdx, 0;                              // bottom flex
        call lay_split_h;
        cmp rax, 1;
        jne layw_fail_stage;

        mov rdi, 2;
        call lay_pane_rows;
        cmp rax, 21;                             // 24 - 3
        jne layw_fail_stage;

        call lay_reset;

        // -- 6. Vertical split.
        mov rax, 6;
        lea rcx, [rip + _layw_stage];
        mov [rcx], rax;

        mov rdi, 24;
        mov rsi, 80;
        call lay_root;

        mov rdi, 0;
        mov rsi, 20;                             // left = 20 cols
        mov rdx, 60;                             // right = 60 cols
        call lay_split_v;
        cmp rax, 1;
        jne layw_fail_stage;

        mov rdi, 1;                              // left
        call lay_pane_c0;
        cmp rax, 0;
        jne layw_fail_stage;
        mov rdi, 1;
        call lay_pane_cols;
        cmp rax, 20;
        jne layw_fail_stage;
        mov rdi, 1;
        call lay_pane_rows;
        cmp rax, 24;
        jne layw_fail_stage;

        mov rdi, 2;                              // right
        call lay_pane_c0;
        cmp rax, 20;
        jne layw_fail_stage;
        mov rdi, 2;
        call lay_pane_cols;
        cmp rax, 60;
        jne layw_fail_stage;

        call lay_reset;

        // -- 7. NESTED: split root horizontally, then split the bottom child
        //         vertically. Row-of-cols in the body area.
        mov rax, 7;
        lea rcx, [rip + _layw_stage];
        mov [rcx], rax;

        mov rdi, 24;
        mov rsi, 80;
        call lay_root;

        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 23;
        call lay_split_h;                        // -> panes 1 (top), 2 (bottom)
        cmp rax, 1;
        jne layw_fail_stage;

        mov rdi, 2;                              // split the bottom pane
        mov rsi, 40;
        mov rdx, 40;
        call lay_split_v;                        // -> panes 3 (left), 4 (right)
        cmp rax, 3;
        jne layw_fail_stage;

        call lay_pane_count;
        cmp rax, 5;
        jne layw_fail_stage;

        mov rdi, 3;                              // left of body
        call lay_pane_r0;
        cmp rax, 1;
        jne layw_fail_stage;
        mov rdi, 3;
        call lay_pane_c0;
        cmp rax, 0;
        jne layw_fail_stage;
        mov rdi, 3;
        call lay_pane_rows;
        cmp rax, 23;
        jne layw_fail_stage;
        mov rdi, 3;
        call lay_pane_cols;
        cmp rax, 40;
        jne layw_fail_stage;

        mov rdi, 4;                              // right of body
        call lay_pane_c0;
        cmp rax, 40;
        jne layw_fail_stage;
        mov rdi, 4;
        call lay_pane_cols;
        cmp rax, 40;
        jne layw_fail_stage;

        call lay_reset;

        // -- 8. Bad-size refusals.
        mov rax, 8;
        lea rcx, [rip + _layw_stage];
        mov [rcx], rax;

        mov rdi, 24;
        mov rsi, 80;
        call lay_root;

        // Both zero -> ambiguous.
        mov rdi, 0;
        xor rsi, rsi;
        xor rdx, rdx;
        call lay_split_h;
        mov r11, 0xFFFFF07C;                     // LAY_ERR_BAD_SIZE
        cmp rax, r11;
        jne layw_fail_stage;

        call lay_reset;
        mov rdi, 24;
        mov rsi, 80;
        call lay_root;

        // Explicit sum > parent -> refused.
        mov rdi, 0;
        mov rsi, 15;
        mov rdx, 15;                             // 30 > 24
        call lay_split_h;
        mov r11, 0xFFFFF07C;
        cmp rax, r11;
        jne layw_fail_stage;

        call lay_reset;
        mov rdi, 24;
        mov rsi, 80;
        call lay_root;

        // Bad parent id.
        mov rdi, 99;
        mov rsi, 1;
        mov rdx, 1;
        call lay_split_h;
        mov r11, 0xFFFFF07D;                     // LAY_ERR_BAD_ID
        cmp rax, r11;
        jne layw_fail_stage;

        call lay_reset;

        // -- 9. Arena-full refusal. Fill until arena rejects.
        mov rax, 9;
        lea rcx, [rip + _layw_stage];
        mov [rcx], rax;

        mov rdi, 24;
        mov rsi, 80;
        call lay_root;

        // Split root repeatedly (14 splits produce 28 more panes + root = 29,
        // then a 15th split would need slot 30 and 31 which are still in
        // range; the 16th requires slot 32 which is out of range).
        mov r12, 0;                              // split counter
      layw_fill:
        cmp r12, 15;                             // 1+2*15 = 31 panes
        jae layw_fill_done;
        mov rdi, 0;                              // split root repeatedly (each
                                                 //   split re-carves the root
                                                 //   with the same top=1
                                                 //   bottom=flex, so the
                                                 //   arithmetic never fails
                                                 //   until arena is full).
        mov rsi, 1;
        mov rdx, 0;
        call lay_split_h;
        // First 15 must succeed; on the 15th split pane_count becomes 31.
        add r12, 1;
        jmp layw_fill;
      layw_fill_done:

        call lay_pane_count;
        cmp rax, 31;
        jne layw_fail_stage;

        // 16th split would try to grow to 33 -> LAY_ERR_FULL.
        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 0;
        call lay_split_h;
        mov r11, 0xFFFFF07E;                     // LAY_ERR_FULL
        cmp rax, r11;
        jne layw_fail_stage;

        // Return the module to a clean state.
        call lay_reset;
        call lay_bound;
        cmp rax, 1;
        jne layw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + layw_ok];
        call klog_s1;

        xor rax, rax;
        jmp layw_out;

      layw_fail_stage:
        lea rax, [rip + _layw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + layw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      layw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
