// tests/kernel/semterm/gui_ime_synth.pdx -- R44.M3-001 (#1406)
//
// Boot witness for the semterm GUI IME binding. Exercises reset
// (zeroed state, init_mark installed), arbitration honesty pin,
// pre-edit push + refusals (bad codepoint 0, buffer full), pre-edit
// pop + refusal (empty), pre-edit clear (idempotent even against
// empty), read-back via preedit_at + refusal (bad idx), commit +
// refusal (nothing to commit), notify pending / notify ack + refusal
// (no notify), and a full compose -> commit -> drain cycle that
// bumps commits_total, notify_flushed, and pushes_total to the
// expected running totals.
//
// Fingerprint: R44 SEMTERM GUI IME OK
// Failure fingerprint: R44 SEMTERM GUI IME FAIL + stage number.

module GuiImeSynth = structure {

  pub let mut _imew_stage : u64 = 0

  pub let imew_ok   : [u8; 25] = "R44 SEMTERM GUI IME OK\n\0"
  pub let imew_fail : [u8; 27] = "R44 SEMTERM GUI IME FAIL\n\0"

  pub let gui_ime_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R44.M3-001 (#1406): boot witness for gui_ime. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed imew_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration + zero defaults.
        mov rax, 1;
        lea rcx, [rip + _imew_stage];
        mov [rcx], rax;

        call ime_reset;
        call ime_arbitrated;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_bound;
        cmp rax, 1;
        jne imew_fail_stage;
        call ime_preedit_len;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_commits_total;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_notify_pending;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_notify_flushed;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_pushes_total;
        cmp rax, 0;
        jne imew_fail_stage;

        // -- 2. Push one code point + refusal for codepoint 0.
        mov rax, 2;
        lea rcx, [rip + _imew_stage];
        mov [rcx], rax;

        mov rdi, 0x4E2D;                         // U+4E2D CJK 中
        call ime_preedit_push;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_preedit_len;
        cmp rax, 1;
        jne imew_fail_stage;
        call ime_pushes_total;
        cmp rax, 1;
        jne imew_fail_stage;

        // Codepoint 0 refused.
        mov rdi, 0;
        call ime_preedit_push;
        mov r11, 0xFFFFEE7E;
        cmp rax, r11;
        jne imew_fail_stage;
        // pushes_total unchanged.
        call ime_pushes_total;
        cmp rax, 1;
        jne imew_fail_stage;

        // Read back preedit[0].
        mov rdi, 0;
        call ime_preedit_at;
        mov r11, 0x4E2D;
        cmp rax, r11;
        jne imew_fail_stage;

        // preedit_at out-of-range refused.
        mov rdi, 1;
        call ime_preedit_at;
        mov r11, 0xFFFFEE7A;
        cmp rax, r11;
        jne imew_fail_stage;

        // -- 3. Pop then clear (idempotent).
        mov rax, 3;
        lea rcx, [rip + _imew_stage];
        mov [rcx], rax;

        call ime_preedit_pop;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_preedit_len;
        cmp rax, 0;
        jne imew_fail_stage;

        // Pop on empty refused.
        call ime_preedit_pop;
        mov r11, 0xFFFFEE7C;
        cmp rax, r11;
        jne imew_fail_stage;

        // Clear on empty is a no-op success.
        call ime_preedit_clear;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_preedit_len;
        cmp rax, 0;
        jne imew_fail_stage;

        // -- 4. Compose 4 code points then clear.
        mov rax, 4;
        lea rcx, [rip + _imew_stage];
        mov [rcx], rax;

        mov rdi, 0x0041;                         // 'A'
        call ime_preedit_push;
        cmp rax, 0;
        jne imew_fail_stage;
        mov rdi, 0x0042;                         // 'B'
        call ime_preedit_push;
        cmp rax, 0;
        jne imew_fail_stage;
        mov rdi, 0x0043;                         // 'C'
        call ime_preedit_push;
        cmp rax, 0;
        jne imew_fail_stage;
        mov rdi, 0x0044;                         // 'D'
        call ime_preedit_push;
        cmp rax, 0;
        jne imew_fail_stage;

        call ime_preedit_len;
        cmp rax, 4;
        jne imew_fail_stage;

        // Slot 2 == 'C'.
        mov rdi, 2;
        call ime_preedit_at;
        mov r11, 0x0043;
        cmp rax, r11;
        jne imew_fail_stage;

        // Clear drops all four.
        call ime_preedit_clear;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_preedit_len;
        cmp rax, 0;
        jne imew_fail_stage;

        // Every slot 0..3 is now the empty marker (0) -- but the
        // read path refuses idx >= preedit_len == 0, so we cannot
        // read them without tripping BAD_IDX.
        mov rdi, 0;
        call ime_preedit_at;
        mov r11, 0xFFFFEE7A;
        cmp rax, r11;
        jne imew_fail_stage;

        // -- 5. Commit refused when preedit empty.
        mov rax, 5;
        lea rcx, [rip + _imew_stage];
        mov [rcx], rax;

        call ime_commit;
        mov r11, 0xFFFFEE7B;
        cmp rax, r11;
        jne imew_fail_stage;
        call ime_commits_total;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_notify_pending;
        cmp rax, 0;
        jne imew_fail_stage;

        // -- 6. Full compose -> commit -> drain cycle.
        mov rax, 6;
        lea rcx, [rip + _imew_stage];
        mov [rcx], rax;

        // Push 3 code points.
        mov rdi, 0x0048;                         // 'H'
        call ime_preedit_push;
        cmp rax, 0;
        jne imew_fail_stage;
        mov rdi, 0x0069;                         // 'i'
        call ime_preedit_push;
        cmp rax, 0;
        jne imew_fail_stage;
        mov rdi, 0x0021;                         // '!'
        call ime_preedit_push;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_preedit_len;
        cmp rax, 3;
        jne imew_fail_stage;

        // Commit returns count (3).
        call ime_commit;
        cmp rax, 3;
        jne imew_fail_stage;
        call ime_preedit_len;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_commits_total;
        cmp rax, 3;
        jne imew_fail_stage;
        call ime_notify_pending;
        cmp rax, 1;
        jne imew_fail_stage;

        // Second commit refused (preedit empty).
        call ime_commit;
        mov r11, 0xFFFFEE7B;
        cmp rax, r11;
        jne imew_fail_stage;

        // Another 2-code-point compose + commit stacks notify_pending.
        mov rdi, 0x004F;                         // 'O'
        call ime_preedit_push;
        cmp rax, 0;
        jne imew_fail_stage;
        mov rdi, 0x004B;                         // 'K'
        call ime_preedit_push;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_commit;
        cmp rax, 2;
        jne imew_fail_stage;
        call ime_commits_total;
        cmp rax, 5;
        jne imew_fail_stage;
        call ime_notify_pending;
        cmp rax, 2;
        jne imew_fail_stage;

        // Drain both notifies.
        call ime_notify_ack;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_notify_pending;
        cmp rax, 1;
        jne imew_fail_stage;
        call ime_notify_flushed;
        cmp rax, 1;
        jne imew_fail_stage;

        call ime_notify_ack;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_notify_pending;
        cmp rax, 0;
        jne imew_fail_stage;
        call ime_notify_flushed;
        cmp rax, 2;
        jne imew_fail_stage;

        // Third notify_ack refused.
        call ime_notify_ack;
        mov r11, 0xFFFFEE79;
        cmp rax, r11;
        jne imew_fail_stage;

        // -- 7. Fill the pre-edit buffer to bound; extra push refused.
        mov rax, 7;
        lea rcx, [rip + _imew_stage];
        mov [rcx], rax;

        call ime_reset;

        // Push 64 code points (loop with codepoints 1..64).
        mov r12, 1;                              // codepoint counter
      imew_fill_lp:
        mov rdi, r12;
        call ime_preedit_push;
        cmp rax, 0;
        jne imew_fail_stage;
        add r12, 1;
        cmp r12, 65;
        jb  imew_fill_lp;

        call ime_preedit_len;
        cmp rax, 64;
        jne imew_fail_stage;

        // Push #65 refused (buffer full).
        mov rdi, 65;
        call ime_preedit_push;
        mov r11, 0xFFFFEE7D;
        cmp rax, r11;
        jne imew_fail_stage;

        // Commit the 64-cp run.
        call ime_commit;
        cmp rax, 64;
        jne imew_fail_stage;
        call ime_commits_total;
        cmp rax, 64;
        jne imew_fail_stage;
        call ime_notify_pending;
        cmp rax, 1;
        jne imew_fail_stage;

        // Return module to clean state.
        call ime_reset;
        call ime_bound;
        cmp rax, 1;
        jne imew_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + imew_ok];
        call klog_s1;

        xor rax, rax;
        jmp imew_out;

      imew_fail_stage:
        lea rax, [rip + _imew_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + imew_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      imew_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
