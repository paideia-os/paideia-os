// tests/kernel/semterm/gui_charts_synth.pdx -- R44.M2-002 (#1404)
//
// Boot witness for the semterm GUI chart primitives seam. Exercises
// reset (defaults AA=ON, CAP=BUTT, JOIN=MITER, no charts, no series),
// arbitration honesty pin, chart_new for all four kinds + refusals
// (bad kind, bad rect), series_add + refusals (bad chart, bad
// palette series), stroke setters + refusals (bad cap, bad join),
// emit_path bumps per-chart + global counters, and pool-full
// boundaries (8 charts, 16 series).
//
// Fingerprint: R44 SEMTERM GUI CHARTS OK
// Failure fingerprint: R44 SEMTERM GUI CHARTS FAIL + stage number.

module GuiChartsSynth = structure {

  pub let mut _chaw_stage : u64 = 0

  pub let chaw_ok   : [u8; 28] = "R44 SEMTERM GUI CHARTS OK\n\0"
  pub let chaw_fail : [u8; 30] = "R44 SEMTERM GUI CHARTS FAIL\n\0"

  pub let gui_charts_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R44.M2-002 (#1404): boot witness for gui_charts. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed chaw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration + defaults.
        mov rax, 1;
        lea rcx, [rip + _chaw_stage];
        mov [rcx], rax;

        call cha_reset;
        call cha_arbitrated;
        cmp rax, 0;
        jne chaw_fail_stage;
        call cha_bound;
        cmp rax, 1;
        jne chaw_fail_stage;
        call cha_chart_count;
        cmp rax, 0;
        jne chaw_fail_stage;
        call cha_series_count;
        cmp rax, 0;
        jne chaw_fail_stage;
        call cha_aa_get;
        cmp rax, 1;                              // CHA_AA_ON default
        jne chaw_fail_stage;
        call cha_cap_get;
        cmp rax, 0;                              // CHA_CAP_BUTT default
        jne chaw_fail_stage;
        call cha_join_get;
        cmp rax, 0;                              // CHA_JOIN_MITER default
        jne chaw_fail_stage;
        call cha_paths_emitted;
        cmp rax, 0;
        jne chaw_fail_stage;

        // -- 2. chart_new: all four kinds valid, out-of-range refused.
        mov rax, 2;
        lea rcx, [rip + _chaw_stage];
        mov [rcx], rax;

        // BAR at (0, 0, 100, 20).
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 100;
        mov r8,  20;
        call cha_chart_new;
        cmp rax, 0;
        jne chaw_fail_stage;

        // LINE at (0, 20, 100, 40).
        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 20;
        mov rcx, 100;
        mov r8,  40;
        call cha_chart_new;
        cmp rax, 1;
        jne chaw_fail_stage;

        // SCATTER at (0, 40, 100, 60).
        mov rdi, 2;
        mov rsi, 0;
        mov rdx, 40;
        mov rcx, 100;
        mov r8,  60;
        call cha_chart_new;
        cmp rax, 2;
        jne chaw_fail_stage;

        // HEATMAP at (0, 60, 100, 80).
        mov rdi, 3;
        mov rsi, 0;
        mov rdx, 60;
        mov rcx, 100;
        mov r8,  80;
        call cha_chart_new;
        cmp rax, 3;
        jne chaw_fail_stage;

        call cha_chart_count;
        cmp rax, 4;
        jne chaw_fail_stage;

        // Readback: BAR chart's kind + rect.
        mov rdi, 0;
        mov rsi, 0;                              // kind field
        call cha_chart_field;
        cmp rax, 0;
        jne chaw_fail_stage;
        mov rdi, 0;
        mov rsi, 3;                              // x1
        call cha_chart_field;
        cmp rax, 100;
        jne chaw_fail_stage;
        mov rdi, 0;
        mov rsi, 4;                              // y1
        call cha_chart_field;
        cmp rax, 20;
        jne chaw_fail_stage;

        // -- 3. Bad kind refused.
        mov rax, 3;
        lea rcx, [rip + _chaw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 10;
        mov r8,  10;
        call cha_chart_new;
        mov r11, 0xFFFFEE9C;
        cmp rax, r11;
        jne chaw_fail_stage;

        // Bad rectangle (x0 >= x1).
        mov rdi, 0;
        mov rsi, 50;
        mov rdx, 0;
        mov rcx, 50;
        mov r8,  10;
        call cha_chart_new;
        mov r11, 0xFFFFEE99;
        cmp rax, r11;
        jne chaw_fail_stage;

        // Bad rectangle (y0 >= y1).
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 30;
        mov rcx, 10;
        mov r8,  30;
        call cha_chart_new;
        mov r11, 0xFFFFEE99;
        cmp rax, r11;
        jne chaw_fail_stage;

        // -- 4. series_add: bind palette series 0..3 to chart 0.
        mov rax, 4;
        lea rcx, [rip + _chaw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call cha_series_add;
        cmp rax, 0;                              // series id 0
        jne chaw_fail_stage;
        mov rdi, 0;
        mov rsi, 1;
        call cha_series_add;
        cmp rax, 1;
        jne chaw_fail_stage;

        // Bind palette series 4 to chart 2.
        mov rdi, 2;
        mov rsi, 4;
        call cha_series_add;
        cmp rax, 2;
        jne chaw_fail_stage;

        call cha_series_count;
        cmp rax, 3;
        jne chaw_fail_stage;

        // Readback.
        mov rdi, 0;
        call cha_series_chart;
        cmp rax, 0;
        jne chaw_fail_stage;
        mov rdi, 0;
        call cha_series_palette;
        cmp rax, 0;
        jne chaw_fail_stage;

        mov rdi, 2;
        call cha_series_chart;
        cmp rax, 2;
        jne chaw_fail_stage;
        mov rdi, 2;
        call cha_series_palette;
        cmp rax, 4;
        jne chaw_fail_stage;

        // -- 5. series_add refusals.
        mov rax, 5;
        lea rcx, [rip + _chaw_stage];
        mov [rcx], rax;

        // Bad chart (chart_count == 4, chart_id 4 refused).
        mov rdi, 4;
        mov rsi, 0;
        call cha_series_add;
        mov r11, 0xFFFFEE9D;
        cmp rax, r11;
        jne chaw_fail_stage;

        // Bad palette series (8 > 7).
        mov rdi, 0;
        mov rsi, 8;
        call cha_series_add;
        mov r11, 0xFFFFEE9A;
        cmp rax, r11;
        jne chaw_fail_stage;

        // Bad series id readback.
        // Clear the latch first: the prior series_add refusals in this
        // stage latched CHA_ERR_BAD_CHART (first-writer-wins), so a
        // cha_err read without a reset would return BAD_CHART instead
        // of BAD_SERIES.
        call cha_reset_err;
        mov rdi, 42;
        call cha_series_chart;
        cmp rax, 0;
        jne chaw_fail_stage;
        call cha_err;
        mov r11, 0xFFFFEE9A;
        cmp rax, r11;
        jne chaw_fail_stage;

        // -- 6. Stroke setters + refusals.
        mov rax, 6;
        lea rcx, [rip + _chaw_stage];
        mov [rcx], rax;

        call cha_reset;

        mov rdi, 0;                              // AA_OFF
        call cha_aa_set;
        cmp rax, 0;
        jne chaw_fail_stage;
        call cha_aa_get;
        cmp rax, 0;
        jne chaw_fail_stage;

        mov rdi, 42;                             // any nonzero -> 1
        call cha_aa_set;
        cmp rax, 0;
        jne chaw_fail_stage;
        call cha_aa_get;
        cmp rax, 1;
        jne chaw_fail_stage;

        // Cap: all three, then 3 refused.
        mov rdi, 1;                              // ROUND
        call cha_cap_set;
        cmp rax, 0;
        jne chaw_fail_stage;
        call cha_cap_get;
        cmp rax, 1;
        jne chaw_fail_stage;
        mov rdi, 2;                              // SQUARE
        call cha_cap_set;
        cmp rax, 0;
        jne chaw_fail_stage;
        mov rdi, 3;
        call cha_cap_set;
        mov r11, 0xFFFFEE98;
        cmp rax, r11;
        jne chaw_fail_stage;

        // Join: all three, then 3 refused.
        mov rdi, 1;                              // ROUND
        call cha_join_set;
        cmp rax, 0;
        jne chaw_fail_stage;
        call cha_join_get;
        cmp rax, 1;
        jne chaw_fail_stage;
        mov rdi, 2;                              // BEVEL
        call cha_join_set;
        cmp rax, 0;
        jne chaw_fail_stage;
        mov rdi, 3;
        call cha_join_set;
        mov r11, 0xFFFFEE97;
        cmp rax, r11;
        jne chaw_fail_stage;

        // -- 7. emit_path bumps per-chart + global.
        mov rax, 7;
        lea rcx, [rip + _chaw_stage];
        mov [rcx], rax;

        call cha_reset;

        // Two charts.
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 50;
        mov r8,  20;
        call cha_chart_new;
        cmp rax, 0;
        jne chaw_fail_stage;
        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 20;
        mov rcx, 50;
        mov r8,  40;
        call cha_chart_new;
        cmp rax, 1;
        jne chaw_fail_stage;

        // 3 paths on chart 0, 2 on chart 1.
        mov rdi, 0;
        call cha_emit_path;
        cmp rax, 0;
        jne chaw_fail_stage;
        mov rdi, 0;
        call cha_emit_path;
        cmp rax, 0;
        jne chaw_fail_stage;
        mov rdi, 0;
        call cha_emit_path;
        cmp rax, 0;
        jne chaw_fail_stage;
        mov rdi, 1;
        call cha_emit_path;
        cmp rax, 0;
        jne chaw_fail_stage;
        mov rdi, 1;
        call cha_emit_path;
        cmp rax, 0;
        jne chaw_fail_stage;

        // Global count = 5.
        call cha_paths_emitted;
        cmp rax, 5;
        jne chaw_fail_stage;

        // Per-chart 0 = 3, per-chart 1 = 2.
        mov rdi, 0;
        mov rsi, 5;                              // paths_local field
        call cha_chart_field;
        cmp rax, 3;
        jne chaw_fail_stage;
        mov rdi, 1;
        mov rsi, 5;
        call cha_chart_field;
        cmp rax, 2;
        jne chaw_fail_stage;

        // emit_path on bad chart refused.
        mov rdi, 4;
        call cha_emit_path;
        mov r11, 0xFFFFEE9D;
        cmp rax, r11;
        jne chaw_fail_stage;

        // -- 8. Charts-full: 8 allowed, 9th refused.
        mov rax, 8;
        lea rcx, [rip + _chaw_stage];
        mov [rcx], rax;

        call cha_reset;
        xor r12, r12;
      chaw_chart_fill:
        mov rdi, 0;                              // kind BAR
        mov rsi, 0;
        mov rdx, r12;
        mov rcx, 10;
        mov r8, r12;
        add r8, 5;                               // y1 > y0
        call cha_chart_new;
        mov r13, r12;
        cmp rax, r13;
        jne chaw_fail_stage;
        add r12, 10;                             // shift down for next
        mov r13, r12;
        shr r13, 4;                              // rebuild count as index later
        cmp r12, 80;
        jb  chaw_chart_fill;

        call cha_chart_count;
        cmp rax, 8;
        jne chaw_fail_stage;

        // 9th refused.
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 80;
        mov rcx, 10;
        mov r8,  85;
        call cha_chart_new;
        mov r11, 0xFFFFEE9E;
        cmp rax, r11;
        jne chaw_fail_stage;

        // -- 9. Series-full: 16 allowed, 17th refused.
        mov rax, 9;
        lea rcx, [rip + _chaw_stage];
        mov [rcx], rax;

        xor r12, r12;
      chaw_series_fill:
        mov rdi, 0;                              // chart 0
        mov r13, r12;
        and r13, 7;                              // palette series 0..7
        mov rsi, r13;
        call cha_series_add;
        mov r13, r12;
        cmp rax, r13;
        jne chaw_fail_stage;
        add r12, 1;
        cmp r12, 16;
        jb  chaw_series_fill;

        call cha_series_count;
        cmp rax, 16;
        jne chaw_fail_stage;

        // 17th refused.
        mov rdi, 0;
        mov rsi, 0;
        call cha_series_add;
        mov r11, 0xFFFFEE9B;
        cmp rax, r11;
        jne chaw_fail_stage;

        // Return module to clean state.
        call cha_reset;
        call cha_bound;
        cmp rax, 1;
        jne chaw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + chaw_ok];
        call klog_s1;

        xor rax, rax;
        jmp chaw_out;

      chaw_fail_stage:
        lea rax, [rip + _chaw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + chaw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      chaw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
