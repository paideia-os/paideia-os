// tests/kernel/semterm/gui_shell_synth.pdx -- R44.M1-001 (#1400)
//
// Boot witness for the semantic-term GUI shell. Exercises reset,
// arbitration honesty pin, region set + refusals (bad id, zero-dim),
// visibility toggling, focus set + hidden-refusal, event queue push
// + pump (with per-region delivery counting), and event queue full
// + empty refusals.
//
// Fingerprint: R44 SEMTERM GUI SHELL OK
// Failure fingerprint: R44 SEMTERM GUI SHELL FAIL + stage number.

module GuiShellSynth = structure {

  pub let mut _gshw_stage : u64 = 0

  pub let gshw_ok   : [u8; 23] = "SEMTERM GUI SHELL OK\0"
  pub let gshw_fail : [u8; 25] = "SEMTERM GUI SHELL FAIL\0"

  pub let gui_shell_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R44.M1-001 (#1400): boot witness for gui_shell. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed gshw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration + defaults.
        mov rax, 1;
        lea rcx, [rip + _gshw_stage];
        mov [rcx], rax;

        call gsh_reset;
        call gsh_arbitrated;
        cmp rax, 0;
        jne gshw_fail_stage;
        call gsh_bound;
        cmp rax, 1;
        jne gshw_fail_stage;
        call gsh_focus_get;
        cmp rax, 0;
        jne gshw_fail_stage;
        call gsh_event_len;
        cmp rax, 0;
        jne gshw_fail_stage;
        call gsh_events_delivered;
        cmp rax, 0;
        jne gshw_fail_stage;

        // -- 2. Region set: install four regions.
        mov rax, 2;
        lea rcx, [rip + _gshw_stage];
        mov [rcx], rax;

        // Region 0 (query editor): 0,0,80,10.
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 80;
        mov r8,  10;
        call gsh_region_set;
        cmp rax, 0;
        jne gshw_fail_stage;

        // Region 1 (results): 0,10,80,10.
        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 10;
        mov rcx, 80;
        mov r8,  10;
        call gsh_region_set;
        cmp rax, 0;
        jne gshw_fail_stage;

        // Region 2 (tab bar): 0,20,80,2.
        mov rdi, 2;
        mov rsi, 0;
        mov rdx, 20;
        mov rcx, 80;
        mov r8,  2;
        call gsh_region_set;
        cmp rax, 0;
        jne gshw_fail_stage;

        // Region 3 (status bar): 0,22,80,2.
        mov rdi, 3;
        mov rsi, 0;
        mov rdx, 22;
        mov rcx, 80;
        mov r8,  2;
        call gsh_region_set;
        cmp rax, 0;
        jne gshw_fail_stage;

        // Verify readbacks for region 0.
        mov rdi, 0;
        mov rsi, 2;                              // w
        call gsh_region_get;
        cmp rax, 80;
        jne gshw_fail_stage;
        mov rdi, 0;
        mov rsi, 3;                              // h
        call gsh_region_get;
        cmp rax, 10;
        jne gshw_fail_stage;

        // -- 3. Region set: bad id.
        mov rax, 3;
        lea rcx, [rip + _gshw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 10;
        mov r8,  10;
        call gsh_region_set;
        mov r11, 0xFFFFEEDE;
        cmp rax, r11;
        jne gshw_fail_stage;

        // -- 4. Region set: zero dim (w).
        mov rax, 4;
        lea rcx, [rip + _gshw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;
        mov r8,  10;
        call gsh_region_set;
        mov r11, 0xFFFFEEDD;
        cmp rax, r11;
        jne gshw_fail_stage;

        // Zero-dim (h).
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 10;
        mov r8,  0;
        call gsh_region_set;
        mov r11, 0xFFFFEEDD;
        cmp rax, r11;
        jne gshw_fail_stage;

        // Reset and reinstall regions.
        call gsh_reset;
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 80;
        mov r8,  10;
        call gsh_region_set;
        cmp rax, 0;
        jne gshw_fail_stage;
        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 10;
        mov rcx, 80;
        mov r8,  10;
        call gsh_region_set;
        cmp rax, 0;
        jne gshw_fail_stage;

        // -- 5. Focus set: hidden refusal, then show + focus.
        mov rax, 5;
        lea rcx, [rip + _gshw_stage];
        mov [rcx], rax;

        // Region 0 is not visible yet (visible = 0 after reset).
        mov rdi, 0;
        call gsh_focus_set;
        mov r11, 0xFFFFEEDC;
        cmp rax, r11;
        jne gshw_fail_stage;

        // Show it, then focus.
        mov rdi, 0;
        mov rsi, 1;
        call gsh_region_show;
        cmp rax, 0;
        jne gshw_fail_stage;

        mov rdi, 0;
        call gsh_focus_set;
        cmp rax, 0;
        jne gshw_fail_stage;
        call gsh_focus_get;
        cmp rax, 0;
        jne gshw_fail_stage;

        // Show region 1 and pivot focus there.
        mov rdi, 1;
        mov rsi, 1;
        call gsh_region_show;
        cmp rax, 0;
        jne gshw_fail_stage;
        mov rdi, 1;
        call gsh_focus_set;
        cmp rax, 0;
        jne gshw_fail_stage;
        call gsh_focus_get;
        cmp rax, 1;
        jne gshw_fail_stage;

        // -- 6. Event push + pump: three events, delivered to focus (region 1).
        mov rax, 6;
        lea rcx, [rip + _gshw_stage];
        mov [rcx], rax;

        mov rdi, 0x11;                           // kind = KEY_DOWN
        mov rsi, 0x41;                           // data = 'A'
        call gsh_event_push;
        cmp rax, 0;
        jne gshw_fail_stage;
        mov rdi, 0x11;
        mov rsi, 0x42;
        call gsh_event_push;
        cmp rax, 0;
        jne gshw_fail_stage;
        mov rdi, 0x11;
        mov rsi, 0x43;
        call gsh_event_push;
        cmp rax, 0;
        jne gshw_fail_stage;

        call gsh_event_len;
        cmp rax, 3;
        jne gshw_fail_stage;

        // Pump three times.
        call gsh_event_pump;
        cmp rax, 0x11;
        jne gshw_fail_stage;
        call gsh_event_pump;
        cmp rax, 0x11;
        jne gshw_fail_stage;
        call gsh_event_pump;
        cmp rax, 0x11;
        jne gshw_fail_stage;

        call gsh_event_len;
        cmp rax, 0;
        jne gshw_fail_stage;

        call gsh_events_delivered;
        cmp rax, 3;
        jne gshw_fail_stage;

        // Region 1 received all three; region 0 received none.
        mov rdi, 1;
        mov rsi, 5;                              // events_delivered
        call gsh_region_get;
        cmp rax, 3;
        jne gshw_fail_stage;
        mov rdi, 0;
        mov rsi, 5;
        call gsh_region_get;
        cmp rax, 0;
        jne gshw_fail_stage;

        // -- 7. Empty pump refused.
        mov rax, 7;
        lea rcx, [rip + _gshw_stage];
        mov [rcx], rax;

        call gsh_event_pump;
        mov r11, 0xFFFFEEDA;
        cmp rax, r11;
        jne gshw_fail_stage;

        // -- 8. Full push refused (7 pushes fill; 8th refused).
        mov rax, 8;
        lea rcx, [rip + _gshw_stage];
        mov [rcx], rax;

        xor r12, r12;                            // count
      gshw_fill:
        mov rdi, 0x20;
        mov rsi, r12;
        call gsh_event_push;
        cmp rax, 0;
        jne gshw_fail_stage;
        add r12, 1;
        cmp r12, 7;
        jb  gshw_fill;

        call gsh_event_len;
        cmp rax, 7;
        jne gshw_fail_stage;

        // 8th push refused.
        mov rdi, 0x20;
        mov rsi, 0;
        call gsh_event_push;
        mov r11, 0xFFFFEEDB;
        cmp rax, r11;
        jne gshw_fail_stage;

        // Return module to clean state.
        call gsh_reset;
        call gsh_bound;
        cmp rax, 1;
        jne gshw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gshw_ok];
        call klog_s1;

        xor rax, rax;
        jmp gshw_out;

      gshw_fail_stage:
        lea rax, [rip + _gshw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gshw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      gshw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
