// tests/kernel/semterm/lexer_synth.pdx -- R41.M1-001 (#1365)
//
// Boot witness for the semantic-term-core command lexer. Exercises
// binding refusal, character classifiers, keyword recognition (both
// happy path and near-miss identifier), single- and multi-char
// operators, punctuation, string literal termination, decimal literal
// overflow, and end-of-input.
//
// Fingerprint: SEMTERM LEXER OK
// Failure fingerprint: SEMTERM LEXER FAIL + stage number.

module LexerSynth = structure {

  pub let mut _lxw_stage : u64 = 0

  pub let lxw_ok   : [u8; 19] = "SEMTERM LEXER OK\0"
  pub let lxw_fail : [u8; 21] = "SEMTERM LEXER FAIL\0"

  // Test inputs.  All ASCII, upper-case keywords per §1.
  pub let lxw_q1   : [u8; 32] = "SELECT id FROM users WHERE x=1\n\0"
  pub let lxw_q2   : [u8; 24] = "a <= b >= c <> d AND x\n\0"
  pub let lxw_q3   : [u8; 10] = "'hello';\n\0"
  pub let lxw_q4_unterm : [u8; 8] = "'hello\n\0"
  pub let lxw_q5_bad  : [u8; 3]  = "@\n\0"

  pub let lexer_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M1-001 (#1365): boot witness for the SQL-adjacent lexer. Five callee-save pushes (rbx, r12-r15) put rsp%16 == 0 at every nested call site (entry rsp%16 == 8 per the R30Platform push rbp discipline; five 8-byte pushes bring it to 0). Labels prefixed lxw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration honesty pin.
        mov rax, 1;
        lea rcx, [rip + _lxw_stage];
        mov [rcx], rax;

        call lex_reset;
        call lex_arbitrated;
        cmp rax, 0;
        jne lxw_fail_stage;

        // Bound? Should be no.
        call lex_bound;
        cmp rax, 0;
        jne lxw_fail_stage;

        // -- 2. Bind refusal: buf == 0.
        mov rax, 2;
        lea rcx, [rip + _lxw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 10;
        call lex_bind;
        mov r11, 0xFFFFF17A;
        cmp rax, r11;
        jne lxw_fail_stage;

        call lex_bound;
        cmp rax, 0;
        jne lxw_fail_stage;

        // -- 3. Bind refusal: len too large.
        mov rax, 3;
        lea rcx, [rip + _lxw_stage];
        mov [rcx], rax;

        lea rdi, [rip + lxw_q1];
        mov rsi, 0x80000000;            // LEX_INPUT_MAX
        call lex_bind;
        mov r11, 0xFFFFF17A;
        cmp rax, r11;
        jne lxw_fail_stage;

        // -- 4. Character classifiers.
        mov rax, 4;
        lea rcx, [rip + _lxw_stage];
        mov [rcx], rax;

        mov rdi, 32;
        call lex_is_space;
        cmp rax, 1;
        jne lxw_fail_stage;
        mov rdi, 65;                    // 'A' -- not space.
        call lex_is_space;
        cmp rax, 0;
        jne lxw_fail_stage;

        mov rdi, 48;                    // '0'
        call lex_is_digit;
        cmp rax, 1;
        jne lxw_fail_stage;
        mov rdi, 57;                    // '9'
        call lex_is_digit;
        cmp rax, 1;
        jne lxw_fail_stage;
        mov rdi, 47;                    // '/'
        call lex_is_digit;
        cmp rax, 0;
        jne lxw_fail_stage;

        mov rdi, 65;
        call lex_is_alpha;
        cmp rax, 1;
        jne lxw_fail_stage;
        mov rdi, 122;
        call lex_is_alpha;
        cmp rax, 1;
        jne lxw_fail_stage;
        mov rdi, 95;                    // '_'
        call lex_is_alpha;
        cmp rax, 1;
        jne lxw_fail_stage;
        mov rdi, 64;                    // '@' -- refused.
        call lex_is_alpha;
        cmp rax, 0;
        jne lxw_fail_stage;

        mov rdi, 65;
        call lex_is_alnum;
        cmp rax, 1;
        jne lxw_fail_stage;
        mov rdi, 48;
        call lex_is_alnum;
        cmp rax, 1;
        jne lxw_fail_stage;
        mov rdi, 64;
        call lex_is_alnum;
        cmp rax, 0;
        jne lxw_fail_stage;

        // -- 5. Happy path: SELECT id FROM users WHERE x=1
        mov rax, 5;
        lea rcx, [rip + _lxw_stage];
        mov [rcx], rax;

        call lex_reset;
        lea rdi, [rip + lxw_q1];
        mov rsi, 30;                    // length excluding \n\0
        call lex_bind;
        cmp rax, 0;
        jne lxw_fail_stage;
        call lex_bound;
        cmp rax, 1;
        jne lxw_fail_stage;

        // Token 1: SELECT
        call lex_next;
        cmp rax, 1;                     // TOK_KW_SELECT
        jne lxw_fail_stage;
        call lex_tok_len;
        cmp rax, 6;
        jne lxw_fail_stage;

        // Token 2: id (IDENT)
        call lex_next;
        cmp rax, 17;                    // TOK_IDENT
        jne lxw_fail_stage;
        call lex_tok_len;
        cmp rax, 2;
        jne lxw_fail_stage;

        // Token 3: FROM
        call lex_next;
        cmp rax, 2;
        jne lxw_fail_stage;

        // Token 4: users (IDENT)
        call lex_next;
        cmp rax, 17;
        jne lxw_fail_stage;
        call lex_tok_len;
        cmp rax, 5;
        jne lxw_fail_stage;

        // Token 5: WHERE
        call lex_next;
        cmp rax, 3;
        jne lxw_fail_stage;

        // Token 6: x
        call lex_next;
        cmp rax, 17;
        jne lxw_fail_stage;
        call lex_tok_len;
        cmp rax, 1;
        jne lxw_fail_stage;

        // Token 7: =
        call lex_next;
        cmp rax, 20;                    // TOK_OP_EQ
        jne lxw_fail_stage;

        // Token 8: 1
        call lex_next;
        cmp rax, 18;                    // TOK_INTLIT
        jne lxw_fail_stage;
        call lex_tok_len;
        cmp rax, 1;
        jne lxw_fail_stage;

        // Token 9: EOF
        call lex_next;
        cmp rax, 0;
        jne lxw_fail_stage;

        // Error latch should still be clean.
        call lex_err;
        cmp rax, 0;
        jne lxw_fail_stage;

        // -- 6. Multi-char operators.
        mov rax, 6;
        lea rcx, [rip + _lxw_stage];
        mov [rcx], rax;

        call lex_reset;
        lea rdi, [rip + lxw_q2];
        mov rsi, 22;                    // length excluding \n\0
        call lex_bind;
        cmp rax, 0;
        jne lxw_fail_stage;

        // a
        call lex_next;
        cmp rax, 17;
        jne lxw_fail_stage;
        // <=
        call lex_next;
        cmp rax, 23;                    // TOK_OP_LE
        jne lxw_fail_stage;
        call lex_tok_len;
        cmp rax, 2;
        jne lxw_fail_stage;
        // b
        call lex_next;
        cmp rax, 17;
        jne lxw_fail_stage;
        // >=
        call lex_next;
        cmp rax, 24;
        jne lxw_fail_stage;
        call lex_tok_len;
        cmp rax, 2;
        jne lxw_fail_stage;
        // c
        call lex_next;
        cmp rax, 17;
        jne lxw_fail_stage;
        // <>
        call lex_next;
        cmp rax, 25;
        jne lxw_fail_stage;
        // d
        call lex_next;
        cmp rax, 17;
        jne lxw_fail_stage;
        // AND
        call lex_next;
        cmp rax, 11;
        jne lxw_fail_stage;
        // x
        call lex_next;
        cmp rax, 17;
        jne lxw_fail_stage;
        call lex_tok_len;
        cmp rax, 1;
        jne lxw_fail_stage;

        // -- 7. String literal.
        mov rax, 7;
        lea rcx, [rip + _lxw_stage];
        mov [rcx], rax;

        call lex_reset;
        lea rdi, [rip + lxw_q3];
        mov rsi, 8;                     // 'hello';
        call lex_bind;
        cmp rax, 0;
        jne lxw_fail_stage;
        call lex_next;
        cmp rax, 19;                    // TOK_STRLIT
        jne lxw_fail_stage;
        call lex_tok_len;
        cmp rax, 7;                     // includes both quotes
        jne lxw_fail_stage;
        call lex_next;
        cmp rax, 33;                    // TOK_SEMI
        jne lxw_fail_stage;
        call lex_next;
        cmp rax, 0;                     // EOF
        jne lxw_fail_stage;
        call lex_err;
        cmp rax, 0;
        jne lxw_fail_stage;

        // -- 8. Unterminated string.
        mov rax, 8;
        lea rcx, [rip + _lxw_stage];
        mov [rcx], rax;

        call lex_reset;
        lea rdi, [rip + lxw_q4_unterm];
        mov rsi, 6;                     // 'hello -- no closing quote
        call lex_bind;
        cmp rax, 0;
        jne lxw_fail_stage;
        call lex_next;
        cmp rax, 0;                     // TOK_EOF returned on error
        jne lxw_fail_stage;
        call lex_err;
        mov r11, 0xFFFFF17E;
        cmp rax, r11;
        jne lxw_fail_stage;
        // Second lex_next should stay in refused state.
        call lex_next;
        cmp rax, 0;
        jne lxw_fail_stage;

        // -- 9. Bad character.
        mov rax, 9;
        lea rcx, [rip + _lxw_stage];
        mov [rcx], rax;

        call lex_reset;
        lea rdi, [rip + lxw_q5_bad];
        mov rsi, 1;                     // just '@'
        call lex_bind;
        cmp rax, 0;
        jne lxw_fail_stage;
        call lex_next;
        cmp rax, 0;
        jne lxw_fail_stage;
        call lex_err;
        mov r11, 0xFFFFF17F;
        cmp rax, r11;
        jne lxw_fail_stage;

        // -- 10. Keyword dispatch: exact match required, near-miss stays IDENT.
        mov rax, 10;
        lea rcx, [rip + _lxw_stage];
        mov [rcx], rax;

        // Byte-by-byte identifier "SELEC" (5 letters, near-miss for SELECT).
        // Use a slice of lxw_q1 (SELEC at offset 0, len 5).
        call lex_reset;
        lea rdi, [rip + lxw_q1];
        mov rsi, 5;                     // "SELEC"
        call lex_bind;
        cmp rax, 0;
        jne lxw_fail_stage;
        call lex_next;
        cmp rax, 17;                    // TOK_IDENT
        jne lxw_fail_stage;

        // -- 11. Counter fanout.
        mov rax, 11;
        lea rcx, [rip + _lxw_stage];
        mov [rcx], rax;

        mov rdi, 0;                     // LEX_ST_BINDS
        call lex_stat;
        cmp rax, 0;
        je  lxw_fail_stage;             // must be > 0 by now

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lxw_ok];
        call klog_s1;

        xor rax, rax;
        jmp lxw_out;

      lxw_fail_stage:
        lea rax, [rip + _lxw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lxw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      lxw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
