// tests/kernel/semterm/session_log_synth.pdx -- R41.M5-002 (#1378)
//
// Boot witness for the semantic-term session log. Exercises reset
// (empty ring, active_session_id == 0, next_session_id == 1),
// arbitration honesty pin, record-before-attach refusal, attach +
// double-attach refusal, detach + detach-empty refusal, three
// records into the ring (values round-trip through slog_get,
// counters advance), wrap behaviour after 65 records (log_count
// saturates at 64, oldest entry visible at idx = 0 is the 2nd
// record, log_head has wrapped once), bad idx / bad field refusals,
// and the audit-forward honesty pin.
//
// Fingerprint: R41 SEMTERM SESSION LOG OK
// Failure fingerprint: R41 SEMTERM SESSION LOG FAIL + stage number.

module SessionLogSynth = structure {

  pub let mut _slogw_stage : u64 = 0

  pub let slogw_ok   : [u8; 29] = "R41 SEMTERM SESSION LOG OK\n\0"
  pub let slogw_fail : [u8; 31] = "R41 SEMTERM SESSION LOG FAIL\n\0"

  pub let session_log_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M5-002 (#1378): boot witness for the session log. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed slogw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin + defaults.
        mov rax, 1;
        lea rcx, [rip + _slogw_stage];
        mov [rcx], rax;

        call slog_reset;
        call slog_arbitrated;
        cmp rax, 0;
        jne slogw_fail_stage;
        call slog_bound;
        cmp rax, 1;
        jne slogw_fail_stage;
        call slog_active;
        cmp rax, 0;
        jne slogw_fail_stage;
        call slog_next_session_id;
        cmp rax, 1;
        jne slogw_fail_stage;
        call slog_len;
        cmp rax, 0;
        jne slogw_fail_stage;
        call slog_exec_count;
        cmp rax, 0;
        jne slogw_fail_stage;
        call slog_total_duration;
        cmp rax, 0;
        jne slogw_fail_stage;
        call slog_audit_forward;
        cmp rax, 0;
        jne slogw_fail_stage;

        // -- 2. record without attach refused.
        mov rax, 2;
        lea rcx, [rip + _slogw_stage];
        mov [rcx], rax;

        mov rdi, 0xAA;
        mov rsi, 10;
        mov rdx, 100;
        call slog_record;
        mov r11, 0xFFFFF01E;                     // SLOG_ERR_NO_SESSION
        cmp rax, r11;
        jne slogw_fail_stage;

        // -- 3. detach without attach refused.
        mov rax, 3;
        lea rcx, [rip + _slogw_stage];
        mov [rcx], rax;

        call slog_reset;
        call slog_detach;
        mov r11, 0xFFFFF01A;                     // SLOG_ERR_DETACH_EMPTY
        cmp rax, r11;
        jne slogw_fail_stage;

        // -- 4. attach yields session_id = 1; second attach refused.
        mov rax, 4;
        lea rcx, [rip + _slogw_stage];
        mov [rcx], rax;

        call slog_reset;
        call slog_attach;
        cmp rax, 1;
        jne slogw_fail_stage;
        call slog_active;
        cmp rax, 1;
        jne slogw_fail_stage;
        call slog_next_session_id;
        cmp rax, 2;
        jne slogw_fail_stage;

        call slog_attach;
        mov r11, 0xFFFFF01D;                     // SLOG_ERR_ALREADY_ACTIVE
        cmp rax, r11;
        jne slogw_fail_stage;

        // -- 5. record three entries; verify readback + counters.
        mov rax, 5;
        lea rcx, [rip + _slogw_stage];
        mov [rcx], rax;

        mov rdi, 0xAA;
        mov rsi, 10;
        mov rdx, 100;
        call slog_record;
        cmp rax, 0;
        jne slogw_fail_stage;

        mov rdi, 0xBB;
        mov rsi, 20;
        mov rdx, 200;
        call slog_record;
        cmp rax, 0;
        jne slogw_fail_stage;

        mov rdi, 0xCC;
        mov rsi, 30;
        mov rdx, 300;
        call slog_record;
        cmp rax, 0;
        jne slogw_fail_stage;

        call slog_len;
        cmp rax, 3;
        jne slogw_fail_stage;
        call slog_exec_count;
        cmp rax, 3;
        jne slogw_fail_stage;
        call slog_total_duration;
        cmp rax, 600;
        jne slogw_fail_stage;

        // Entry 0 (oldest): session=1, hash=0xAA, count=10, dur=100.
        xor rdi, rdi;
        xor rsi, rsi;
        call slog_get;
        cmp rax, 1;
        jne slogw_fail_stage;
        xor rdi, rdi;
        mov rsi, 1;
        call slog_get;
        cmp rax, 0xAA;
        jne slogw_fail_stage;
        xor rdi, rdi;
        mov rsi, 2;
        call slog_get;
        cmp rax, 10;
        jne slogw_fail_stage;
        xor rdi, rdi;
        mov rsi, 3;
        call slog_get;
        cmp rax, 100;
        jne slogw_fail_stage;

        // Entry 2 (newest): hash=0xCC, count=30, dur=300.
        mov rdi, 2;
        mov rsi, 1;
        call slog_get;
        cmp rax, 0xCC;
        jne slogw_fail_stage;
        mov rdi, 2;
        mov rsi, 2;
        call slog_get;
        cmp rax, 30;
        jne slogw_fail_stage;
        mov rdi, 2;
        mov rsi, 3;
        call slog_get;
        cmp rax, 300;
        jne slogw_fail_stage;

        // Clear the err latch from Stage 4's ALREADY_ACTIVE refusal so
        // the BAD_IDX assertion below sees a fresh latch. slog_set_err
        // is first-writer-wins by design (§4), so a witness that tests
        // multiple refusal paths in sequence MUST reset the latch
        // between stages that both assert a specific latched code.
        call slog_reset_err;

        // Bad idx (== log_count).
        mov rdi, 3;
        xor rsi, rsi;
        call slog_get;
        cmp rax, 0;
        jne slogw_fail_stage;
        call slog_err;
        mov r11, 0xFFFFF01C;                     // SLOG_ERR_BAD_IDX
        cmp rax, r11;
        jne slogw_fail_stage;

        // -- 6. Bad field (4).
        mov rax, 6;
        lea rcx, [rip + _slogw_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        mov rsi, 4;
        call slog_get;
        cmp rax, 0;
        jne slogw_fail_stage;

        // -- 7. detach + reattach yields session_id = 2.
        mov rax, 7;
        lea rcx, [rip + _slogw_stage];
        mov [rcx], rax;

        call slog_detach;
        cmp rax, 0;
        jne slogw_fail_stage;
        call slog_active;
        cmp rax, 0;
        jne slogw_fail_stage;

        call slog_attach;
        cmp rax, 2;
        jne slogw_fail_stage;
        call slog_active;
        cmp rax, 2;
        jne slogw_fail_stage;

        // The prior records still live in the ring; log_count survives
        // the detach/attach cycle (the ring is a rolling ledger, not a
        // per-session buffer).
        call slog_len;
        cmp rax, 3;
        jne slogw_fail_stage;

        // -- 8. Wrap: fill to 64 more records to saturate + wrap.
        //        Total after: exec_count = 3 + 64 = 67, log_count = 64,
        //        oldest visible is now the 4th record ever appended,
        //        which used hash = 0x100 (r12 iteration 0).
        mov rax, 8;
        lea rcx, [rip + _slogw_stage];
        mov [rcx], rax;

        xor r12, r12;                            // iteration counter
      slogw_fill:
        mov rdi, r12;
        add rdi, 0x100;                          // hash = 0x100 + i
        mov rsi, r12;                            // count = i
        mov rdx, r12;                            // dur = i (small)
        call slog_record;
        cmp rax, 0;
        jne slogw_fail_stage;
        add r12, 1;
        cmp r12, 64;
        jb  slogw_fill;

        call slog_len;
        cmp rax, 64;
        jne slogw_fail_stage;
        call slog_exec_count;
        cmp rax, 67;
        jne slogw_fail_stage;

        // Oldest live entry (idx 0) is the 4th record ever: hash 0x100.
        xor rdi, rdi;
        mov rsi, 1;
        call slog_get;
        mov r11, 0x100;
        cmp rax, r11;
        jne slogw_fail_stage;

        // Newest live entry (idx 63) is hash 0x100 + 63 = 0x13F.
        mov rdi, 63;
        mov rsi, 1;
        call slog_get;
        mov r11, 0x13F;
        cmp rax, r11;
        jne slogw_fail_stage;

        // Return the module to a clean state.
        call slog_reset;
        call slog_bound;
        cmp rax, 1;
        jne slogw_fail_stage;
        call slog_active;
        cmp rax, 0;
        jne slogw_fail_stage;
        call slog_next_session_id;
        cmp rax, 1;
        jne slogw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + slogw_ok];
        call klog_s1;

        xor rax, rax;
        jmp slogw_out;

      slogw_fail_stage:
        lea rax, [rip + _slogw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + slogw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      slogw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
