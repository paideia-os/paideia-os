// tests/kernel/semterm/recovery_synth.pdx -- R41.M5-001 (#1377)
//
// Boot witness for the semantic-term recovery-mode arbiter. Exercises
// reset (armed = 0, ro = 1, safectl unbound), arbitration honesty pin,
// arm + double-arm refusal, safectl_bind before/after arm, ro widening
// + bad value refusal, the small verb union (SELECT_* accepted,
// UPDATE_* refused while ro == 1, UPDATE_* accepted after rec_set_ro(0)
// and refused again after rec_set_ro(1)), and the verb_count /
// deny_count counters.
//
// Fingerprint: SEMTERM RECOVERY OK
// Failure fingerprint: SEMTERM RECOVERY FAIL + stage number.

module RecoverySynth = structure {

  pub let mut _recw_stage : u64 = 0

  pub let recw_ok   : [u8; 22] = "SEMTERM RECOVERY OK\0"
  pub let recw_fail : [u8; 24] = "SEMTERM RECOVERY FAIL\0"

  pub let recovery_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M5-001 (#1377): boot witness for the recovery arbiter. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed recw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin + defaults.
        mov rax, 1;
        lea rcx, [rip + _recw_stage];
        mov [rcx], rax;

        call rec_reset;
        call rec_arbitrated;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_bound;
        cmp rax, 1;
        jne recw_fail_stage;
        call rec_armed;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_safectl_kind;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_safectl_slot;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_ro;
        cmp rax, 1;
        jne recw_fail_stage;
        call rec_verb_count;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_deny_count;
        cmp rax, 0;
        jne recw_fail_stage;

        // -- 2. safectl_bind before arm refused (NOT_ARMED).
        mov rax, 2;
        lea rcx, [rip + _recw_stage];
        mov [rcx], rax;

        mov rdi, 0x140;
        mov rsi, 3;
        call rec_safectl_bind;
        mov r11, 0xFFFFF02E;                     // REC_ERR_NOT_ARMED
        cmp rax, r11;
        jne recw_fail_stage;

        // set_ro before arm refused (NOT_ARMED).
        mov rdi, 0;
        call rec_set_ro;
        mov r11, 0xFFFFF02E;
        cmp rax, r11;
        jne recw_fail_stage;

        // verb before arm refused (NOT_ARMED).
        mov rdi, 1;
        call rec_verb;
        mov r11, 0xFFFFF02E;
        cmp rax, r11;
        jne recw_fail_stage;

        call rec_reset;

        // -- 3. Arm once, refuse second arm.
        mov rax, 3;
        lea rcx, [rip + _recw_stage];
        mov [rcx], rax;

        call rec_arm;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_armed;
        cmp rax, 1;
        jne recw_fail_stage;

        call rec_arm;
        mov r11, 0xFFFFF02A;                     // REC_ERR_ALREADY_ARMED
        cmp rax, r11;
        jne recw_fail_stage;

        // -- 4. verb before safectl_bind refused (NOT_BOUND).
        mov rax, 4;
        lea rcx, [rip + _recw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call rec_verb;
        mov r11, 0xFFFFF02D;                     // REC_ERR_NOT_BOUND
        cmp rax, r11;
        jne recw_fail_stage;

        // -- 5. safectl_bind after arm.
        mov rax, 5;
        lea rcx, [rip + _recw_stage];
        mov [rcx], rax;

        mov rdi, 0x140;                          // KIND_CAP_ROOT (placeholder)
        mov rsi, 7;
        call rec_safectl_bind;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_safectl_kind;
        cmp rax, 0x140;
        jne recw_fail_stage;
        call rec_safectl_slot;
        cmp rax, 7;
        jne recw_fail_stage;

        // -- 6. SELECT_STATE accepted (RO default).
        mov rax, 6;
        lea rcx, [rip + _recw_stage];
        mov [rcx], rax;

        mov rdi, 1;                              // REC_VERB_SELECT_STATE
        call rec_verb;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_verb_count;
        cmp rax, 1;
        jne recw_fail_stage;

        // SELECT_AUDIT accepted.
        mov rdi, 2;                              // REC_VERB_SELECT_AUDIT
        call rec_verb;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_verb_count;
        cmp rax, 2;
        jne recw_fail_stage;

        // -- 7. UPDATE_RESCUE refused while ro == 1.
        mov rax, 7;
        lea rcx, [rip + _recw_stage];
        mov [rcx], rax;

        mov rdi, 3;                              // REC_VERB_UPDATE_RESCUE
        call rec_verb;
        mov r11, 0xFFFFF02B;                     // REC_ERR_RO_REFUSED
        cmp rax, r11;
        jne recw_fail_stage;
        call rec_deny_count;
        cmp rax, 1;
        jne recw_fail_stage;

        // UPDATE_QUARANTINE also refused.
        mov rdi, 4;                              // REC_VERB_UPDATE_QUARANTINE
        call rec_verb;
        mov r11, 0xFFFFF02B;
        cmp rax, r11;
        jne recw_fail_stage;
        call rec_deny_count;
        cmp rax, 2;
        jne recw_fail_stage;

        // -- 8. Bad verb (0 and 5) refused with BAD_VERB.
        mov rax, 8;
        lea rcx, [rip + _recw_stage];
        mov [rcx], rax;

        xor rdi, rdi;                            // 0
        call rec_verb;
        mov r11, 0xFFFFF02C;                     // REC_ERR_BAD_VERB
        cmp rax, r11;
        jne recw_fail_stage;
        call rec_deny_count;
        cmp rax, 3;
        jne recw_fail_stage;

        mov rdi, 5;
        call rec_verb;
        mov r11, 0xFFFFF02C;
        cmp rax, r11;
        jne recw_fail_stage;
        call rec_deny_count;
        cmp rax, 4;
        jne recw_fail_stage;

        // -- 9. Bad ro value (2) refused.
        mov rax, 9;
        lea rcx, [rip + _recw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        call rec_set_ro;
        mov r11, 0xFFFFF029;                     // REC_ERR_BAD_ROV
        cmp rax, r11;
        jne recw_fail_stage;
        call rec_ro;
        cmp rax, 1;
        jne recw_fail_stage;

        // -- 10. Widen ro to 0, UPDATE_* accepted, restore ro to 1,
        //        UPDATE_* refused again.
        mov rax, 10;
        lea rcx, [rip + _recw_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call rec_set_ro;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_ro;
        cmp rax, 0;
        jne recw_fail_stage;

        mov rdi, 3;                              // REC_VERB_UPDATE_RESCUE
        call rec_verb;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_verb_count;
        cmp rax, 3;
        jne recw_fail_stage;

        mov rdi, 4;
        call rec_verb;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_verb_count;
        cmp rax, 4;
        jne recw_fail_stage;

        mov rdi, 1;
        call rec_set_ro;
        cmp rax, 0;
        jne recw_fail_stage;
        call rec_ro;
        cmp rax, 1;
        jne recw_fail_stage;

        mov rdi, 3;
        call rec_verb;
        mov r11, 0xFFFFF02B;                     // REC_ERR_RO_REFUSED
        cmp rax, r11;
        jne recw_fail_stage;
        call rec_deny_count;
        cmp rax, 5;
        jne recw_fail_stage;

        // -- 11. Not-init refusals after reset with no arm.
        mov rax, 11;
        lea rcx, [rip + _recw_stage];
        mov [rcx], rax;

        call rec_reset;
        // Wipe init_mark to force NOT_INIT: unbind the module by writing
        // 0 to init_mark via a fresh reset then poking arm's gate. We
        // simulate NOT_INIT by observing readbacks after reset only.
        // Since rec_reset installs init_mark, direct NOT_INIT synth
        // requires a controlled unbind path we do not expose here --
        // instead we verify the bound flag round-trips.
        call rec_bound;
        cmp rax, 1;
        jne recw_fail_stage;

        // Return the module to a clean state.
        call rec_reset;
        call rec_bound;
        cmp rax, 1;
        jne recw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + recw_ok];
        call klog_s1;

        xor rax, rax;
        jmp recw_out;

      recw_fail_stage:
        lea rax, [rip + _recw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + recw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      recw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
