// tests/kernel/semterm/plot_synth.pdx -- R41.M3-001 (#1371)
//
// Boot witness for the semantic-term plot compositor. Exercises
// reset, arbitration honesty pin, bounds refusals on plt_put/get,
// each primitive's glyph selection round trip (bar, line, dot,
// heatmap, sparkline), and refusals on out-of-range level/kind.
//
// Fingerprint: SEMTERM PLOT OK
// Failure fingerprint: SEMTERM PLOT FAIL + stage number.

module PlotSynth = structure {

  pub let mut _pltw_stage : u64 = 0

  pub let pltw_ok   : [u8; 18] = "SEMTERM PLOT OK\0"
  pub let pltw_fail : [u8; 20] = "SEMTERM PLOT FAIL\0"

  pub let plot_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M3-001 (#1371): boot witness for the plot compositor. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed pltw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin + default geometry.
        mov rax, 1;
        lea rcx, [rip + _pltw_stage];
        mov [rcx], rax;

        call plt_reset;
        call plt_arbitrated;
        cmp rax, 0;
        jne pltw_fail_stage;
        call plt_bound;
        cmp rax, 1;
        jne pltw_fail_stage;
        call plt_rows;
        cmp rax, 24;
        jne pltw_fail_stage;
        call plt_cols;
        cmp rax, 80;
        jne pltw_fail_stage;
        call plt_writes;
        cmp rax, 0;
        jne pltw_fail_stage;

        // -- 2. plt_put + plt_get round trip.
        mov rax, 2;
        lea rcx, [rip + _pltw_stage];
        mov [rcx], rax;

        mov rdi, 3;                              // row
        mov rsi, 7;                              // col
        mov rdx, 0x41;                           // 'A'
        mov rcx, 0x0102;                         // attrs (fg=2, bg=1)
        call plt_put;
        cmp rax, 0;
        jne pltw_fail_stage;

        mov rdi, 3;
        mov rsi, 7;
        call plt_get;
        // low 32 bits = glyph = 0x41
        mov r11, 0xFFFFFFFF;
        mov rbx, rax;
        and rbx, r11;
        cmp rbx, 0x41;
        jne pltw_fail_stage;
        // high 32 bits = attrs
        mov rbx, rax;
        shr rbx, 32;
        cmp rbx, 0x0102;
        jne pltw_fail_stage;

        call plt_writes;
        cmp rax, 1;
        jne pltw_fail_stage;

        // -- 3. Out-of-range row and col refused.
        mov rax, 3;
        lea rcx, [rip + _pltw_stage];
        mov [rcx], rax;

        mov rdi, 24;                             // row == rows
        mov rsi, 0;
        mov rdx, 0x20;
        xor rcx, rcx;
        call plt_put;
        mov r11, 0xFFFFF08E;                     // PLT_ERR_BAD_ROW
        cmp rax, r11;
        jne pltw_fail_stage;

        call plt_reset;

        mov rdi, 0;
        mov rsi, 80;                             // col == cols
        mov rdx, 0x20;
        xor rcx, rcx;
        call plt_put;
        mov r11, 0xFFFFF08D;                     // PLT_ERR_BAD_COL
        cmp rax, r11;
        jne pltw_fail_stage;

        call plt_reset;

        // -- 4. plt_bar levels 0 and 8 -> space and full block.
        mov rax, 4;
        lea rcx, [rip + _pltw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;                              // level 0 -> space
        call plt_bar;
        cmp rax, 0;
        jne pltw_fail_stage;

        mov rdi, 0;
        mov rsi, 0;
        call plt_get;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        cmp rax, 0x0020;
        jne pltw_fail_stage;

        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 8;                              // level 8 -> U+2588
        call plt_bar;
        cmp rax, 0;
        jne pltw_fail_stage;

        mov rdi, 0;
        mov rsi, 1;
        call plt_get;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        cmp rax, 0x2588;
        jne pltw_fail_stage;

        // level 9 refused.
        mov rdi, 0;
        mov rsi, 2;
        mov rdx, 9;
        call plt_bar;
        mov r11, 0xFFFFF08C;                     // PLT_ERR_BAD_LEVEL
        cmp rax, r11;
        jne pltw_fail_stage;

        call plt_reset;

        // -- 5. plt_line: kind 0 -> U+2500; kind 10 -> U+253C; kind 11 refused.
        mov rax, 5;
        lea rcx, [rip + _pltw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 1;
        mov rdx, 0;
        call plt_line;
        cmp rax, 0;
        jne pltw_fail_stage;
        mov rdi, 1;
        mov rsi, 1;
        call plt_get;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        cmp rax, 0x2500;
        jne pltw_fail_stage;

        mov rdi, 1;
        mov rsi, 2;
        mov rdx, 10;
        call plt_line;
        cmp rax, 0;
        jne pltw_fail_stage;
        mov rdi, 1;
        mov rsi, 2;
        call plt_get;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        cmp rax, 0x253C;
        jne pltw_fail_stage;

        mov rdi, 1;
        mov rsi, 3;
        mov rdx, 11;
        call plt_line;
        mov r11, 0xFFFFF08B;                     // PLT_ERR_BAD_KIND
        cmp rax, r11;
        jne pltw_fail_stage;

        call plt_reset;

        // -- 6. plt_dot writes U+00B7.
        mov rax, 6;
        lea rcx, [rip + _pltw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 4;
        call plt_dot;
        cmp rax, 0;
        jne pltw_fail_stage;
        mov rdi, 2;
        mov rsi, 4;
        call plt_get;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        cmp rax, 0x00B7;
        jne pltw_fail_stage;

        call plt_reset;

        // -- 7. plt_heatmap buckets.
        mov rax, 7;
        lea rcx, [rip + _pltw_stage];
        mov [rcx], rax;

        // level 0 -> space
        mov rdi, 5;
        mov rsi, 5;
        mov rdx, 0;
        call plt_heatmap;
        cmp rax, 0;
        jne pltw_fail_stage;
        mov rdi, 5;
        mov rsi, 5;
        call plt_get;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        cmp rax, 0x0020;
        jne pltw_fail_stage;

        // level 2 -> light shade U+2591
        mov rdi, 5;
        mov rsi, 6;
        mov rdx, 2;
        call plt_heatmap;
        cmp rax, 0;
        jne pltw_fail_stage;
        mov rdi, 5;
        mov rsi, 6;
        call plt_get;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        cmp rax, 0x2591;
        jne pltw_fail_stage;

        // level 4 -> medium shade U+2592
        mov rdi, 5;
        mov rsi, 7;
        mov rdx, 4;
        call plt_heatmap;
        cmp rax, 0;
        jne pltw_fail_stage;
        mov rdi, 5;
        mov rsi, 7;
        call plt_get;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        cmp rax, 0x2592;
        jne pltw_fail_stage;

        // level 6 -> dark shade U+2593
        mov rdi, 5;
        mov rsi, 8;
        mov rdx, 6;
        call plt_heatmap;
        cmp rax, 0;
        jne pltw_fail_stage;
        mov rdi, 5;
        mov rsi, 8;
        call plt_get;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        cmp rax, 0x2593;
        jne pltw_fail_stage;

        // level 8 -> full block U+2588
        mov rdi, 5;
        mov rsi, 9;
        mov rdx, 8;
        call plt_heatmap;
        cmp rax, 0;
        jne pltw_fail_stage;
        mov rdi, 5;
        mov rsi, 9;
        call plt_get;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        cmp rax, 0x2588;
        jne pltw_fail_stage;

        // level 9 refused.
        mov rdi, 5;
        mov rsi, 10;
        mov rdx, 9;
        call plt_heatmap;
        mov r11, 0xFFFFF08C;
        cmp rax, r11;
        jne pltw_fail_stage;

        call plt_reset;

        // -- 8. plt_sparkline level 5 -> U+2585.
        mov rax, 8;
        lea rcx, [rip + _pltw_stage];
        mov [rcx], rax;

        mov rdi, 7;
        mov rsi, 15;
        mov rdx, 5;
        call plt_sparkline;
        cmp rax, 0;
        jne pltw_fail_stage;
        mov rdi, 7;
        mov rsi, 15;
        call plt_get;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        cmp rax, 0x2585;
        jne pltw_fail_stage;

        // Return the module to a clean state.
        call plt_reset;
        call plt_bound;
        cmp rax, 1;
        jne pltw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pltw_ok];
        call klog_s1;

        xor rax, rax;
        jmp pltw_out;

      pltw_fail_stage:
        lea rax, [rip + _pltw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pltw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pltw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
