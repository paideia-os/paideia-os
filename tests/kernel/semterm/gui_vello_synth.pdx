// tests/kernel/semterm/gui_vello_synth.pdx -- R44.M2-001 (#1403)
//
// Boot witness for the semterm GUI Vello rendering seam. Exercises
// reset (four layers with documented defaults, subpx=RGB, atlas
// empty, no pending), arbitration honesty pin, layer show/opacity +
// refusals (bad layer, bad opacity), subpx set + refusal (bad mode),
// atlas add + refusals (empty codepoint, atlas full), atlas readback
// + bad index, route_result -> submit_frame flow (layers_composed
// accumulates visible-layer count, frames_submitted bumps, pending
// clears), and submit_frame refusal without a pending route.
//
// Fingerprint: R44 SEMTERM GUI VELLO OK
// Failure fingerprint: R44 SEMTERM GUI VELLO FAIL + stage number.

module GuiVelloSynth = structure {

  pub let mut _velw_stage : u64 = 0

  pub let velw_ok   : [u8; 27] = "R44 SEMTERM GUI VELLO OK\n\0"
  pub let velw_fail : [u8; 29] = "R44 SEMTERM GUI VELLO FAIL\n\0"

  pub let gui_vello_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R44.M2-001 (#1403): boot witness for gui_vello. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed velw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration + defaults.
        mov rax, 1;
        lea rcx, [rip + _velw_stage];
        mov [rcx], rax;

        call vel_reset;
        call vel_arbitrated;
        cmp rax, 0;
        jne velw_fail_stage;
        call vel_bound;
        cmp rax, 1;
        jne velw_fail_stage;

        // Subpx default = RGB.
        call vel_subpx_get;
        cmp rax, 1;
        jne velw_fail_stage;

        // Atlas empty.
        call vel_atlas_count;
        cmp rax, 0;
        jne velw_fail_stage;

        // No pending.
        call vel_result_pending;
        cmp rax, 0;
        jne velw_fail_stage;

        // Frames + composed both 0.
        call vel_frames_submitted;
        cmp rax, 0;
        jne velw_fail_stage;
        call vel_layers_composed;
        cmp rax, 0;
        jne velw_fail_stage;

        // Layer defaults: BG/TBG/TFG visible+opaque, SEL hidden+half.
        mov rdi, 0;
        call vel_layer_visible;
        cmp rax, 1;
        jne velw_fail_stage;
        mov rdi, 0;
        call vel_layer_opacity;
        cmp rax, 1000;
        jne velw_fail_stage;
        mov rdi, 0;
        call vel_layer_zorder;
        cmp rax, 0;
        jne velw_fail_stage;

        mov rdi, 1;
        call vel_layer_visible;
        cmp rax, 1;
        jne velw_fail_stage;
        mov rdi, 1;
        call vel_layer_opacity;
        cmp rax, 1000;
        jne velw_fail_stage;
        mov rdi, 1;
        call vel_layer_zorder;
        cmp rax, 1;
        jne velw_fail_stage;

        mov rdi, 2;
        call vel_layer_visible;
        cmp rax, 1;
        jne velw_fail_stage;
        mov rdi, 2;
        call vel_layer_opacity;
        cmp rax, 1000;
        jne velw_fail_stage;
        mov rdi, 2;
        call vel_layer_zorder;
        cmp rax, 2;
        jne velw_fail_stage;

        mov rdi, 3;
        call vel_layer_visible;
        cmp rax, 0;                              // SEL hidden
        jne velw_fail_stage;
        mov rdi, 3;
        call vel_layer_opacity;
        cmp rax, 500;                            // SEL half
        jne velw_fail_stage;
        mov rdi, 3;
        call vel_layer_zorder;
        cmp rax, 3;
        jne velw_fail_stage;

        // -- 2. Layer show/opacity: bad layer refused.
        mov rax, 2;
        lea rcx, [rip + _velw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        call vel_layer_visible;
        mov r11, 0xFFFFEEAE;
        cmp rax, 0;                              // returns 0 with err latched
        jne velw_fail_stage;
        call vel_err;
        mov r11, 0xFFFFEEAE;
        cmp rax, r11;
        jne velw_fail_stage;

        // Reset err state by resetting module.
        call vel_reset;

        // Show SEL, hide BG.
        mov rdi, 3;
        mov rsi, 1;
        call vel_layer_show;
        cmp rax, 0;
        jne velw_fail_stage;
        mov rdi, 3;
        call vel_layer_visible;
        cmp rax, 1;
        jne velw_fail_stage;

        mov rdi, 0;
        mov rsi, 0;
        call vel_layer_show;
        cmp rax, 0;
        jne velw_fail_stage;
        mov rdi, 0;
        call vel_layer_visible;
        cmp rax, 0;
        jne velw_fail_stage;

        // Bad layer refused.
        mov rdi, 4;
        mov rsi, 1;
        call vel_layer_show;
        mov r11, 0xFFFFEEAE;
        cmp rax, r11;
        jne velw_fail_stage;

        // Set opacity to 250 on TEXT_FG.
        mov rdi, 2;
        mov rsi, 250;
        call vel_layer_set_opacity;
        cmp rax, 0;
        jne velw_fail_stage;
        mov rdi, 2;
        call vel_layer_opacity;
        cmp rax, 250;
        jne velw_fail_stage;

        // Opacity boundary: 1000 OK.
        mov rdi, 2;
        mov rsi, 1000;
        call vel_layer_set_opacity;
        cmp rax, 0;
        jne velw_fail_stage;

        // Opacity > 1000 refused.
        mov rdi, 2;
        mov rsi, 1001;
        call vel_layer_set_opacity;
        mov r11, 0xFFFFEEAD;
        cmp rax, r11;
        jne velw_fail_stage;

        // Bad layer on set_opacity.
        mov rdi, 4;
        mov rsi, 100;
        call vel_layer_set_opacity;
        mov r11, 0xFFFFEEAE;
        cmp rax, r11;
        jne velw_fail_stage;

        // -- 3. Subpx set + refusal.
        mov rax, 3;
        lea rcx, [rip + _velw_stage];
        mov [rcx], rax;

        call vel_reset;

        // Switch to NONE.
        mov rdi, 0;
        call vel_subpx_set;
        cmp rax, 0;
        jne velw_fail_stage;
        call vel_subpx_get;
        cmp rax, 0;
        jne velw_fail_stage;

        // Back to RGB.
        mov rdi, 1;
        call vel_subpx_set;
        cmp rax, 0;
        jne velw_fail_stage;
        call vel_subpx_get;
        cmp rax, 1;
        jne velw_fail_stage;

        // Mode 2 refused.
        mov rdi, 2;
        call vel_subpx_set;
        mov r11, 0xFFFFEEAC;
        cmp rax, r11;
        jne velw_fail_stage;

        // -- 4. Atlas add / readback / bad index.
        mov rax, 4;
        lea rcx, [rip + _velw_stage];
        mov [rcx], rax;

        call vel_reset;

        // Add three glyphs.
        mov rdi, 0x0041;                         // 'A'
        call vel_atlas_add_glyph;
        cmp rax, 0;
        jne velw_fail_stage;
        mov rdi, 0x0042;                         // 'B'
        call vel_atlas_add_glyph;
        cmp rax, 1;
        jne velw_fail_stage;
        mov rdi, 0x0043;                         // 'C'
        call vel_atlas_add_glyph;
        cmp rax, 2;
        jne velw_fail_stage;

        call vel_atlas_count;
        cmp rax, 3;
        jne velw_fail_stage;

        // Read them back.
        mov rdi, 0;
        call vel_atlas_glyph_at;
        mov r11, 0x0041;
        cmp rax, r11;
        jne velw_fail_stage;
        mov rdi, 1;
        call vel_atlas_glyph_at;
        mov r11, 0x0042;
        cmp rax, r11;
        jne velw_fail_stage;
        mov rdi, 2;
        call vel_atlas_glyph_at;
        mov r11, 0x0043;
        cmp rax, r11;
        jne velw_fail_stage;

        // Bad index refused.
        mov rdi, 3;
        call vel_atlas_glyph_at;
        cmp rax, 0;
        jne velw_fail_stage;
        call vel_err;
        mov r11, 0xFFFFEEAA;
        cmp rax, r11;
        jne velw_fail_stage;

        // Codepoint 0 refused.
        call vel_reset;
        mov rdi, 0;
        call vel_atlas_add_glyph;
        mov r11, 0xFFFFEEA9;
        cmp rax, r11;
        jne velw_fail_stage;

        // -- 5. Atlas reset clears count.
        mov rax, 5;
        lea rcx, [rip + _velw_stage];
        mov [rcx], rax;

        call vel_reset;
        mov rdi, 0x0058;
        call vel_atlas_add_glyph;
        cmp rax, 0;
        jne velw_fail_stage;
        call vel_atlas_reset;
        cmp rax, 0;
        jne velw_fail_stage;
        call vel_atlas_count;
        cmp rax, 0;
        jne velw_fail_stage;

        // -- 6. Route + submit flow.
        mov rax, 6;
        lea rcx, [rip + _velw_stage];
        mov [rcx], rax;

        call vel_reset;

        // Submit without route refused.
        call vel_submit_frame;
        mov r11, 0xFFFFEEA8;
        cmp rax, r11;
        jne velw_fail_stage;

        // Reset and legitimately route.
        call vel_reset;
        mov rdi, 42;
        call vel_route_result;
        cmp rax, 0;
        jne velw_fail_stage;
        call vel_result_pending;
        cmp rax, 1;
        jne velw_fail_stage;
        call vel_result_rows;
        cmp rax, 42;
        jne velw_fail_stage;

        // Submit: four visible layers (all defaults visible except SEL).
        // So layers_composed += 3 (BG, TBG, TFG), frames += 1.
        call vel_submit_frame;
        cmp rax, 0;
        jne velw_fail_stage;
        call vel_frames_submitted;
        cmp rax, 1;
        jne velw_fail_stage;
        call vel_layers_composed;
        cmp rax, 3;
        jne velw_fail_stage;
        call vel_result_pending;
        cmp rax, 0;
        jne velw_fail_stage;

        // Second submit without a new route refused (pending was cleared).
        call vel_submit_frame;
        mov r11, 0xFFFFEEA8;
        cmp rax, r11;
        jne velw_fail_stage;

        // Show SEL and re-route + submit; layers_composed += 4.
        call vel_reset;
        mov rdi, 3;
        mov rsi, 1;
        call vel_layer_show;
        cmp rax, 0;
        jne velw_fail_stage;
        mov rdi, 7;
        call vel_route_result;
        cmp rax, 0;
        jne velw_fail_stage;
        call vel_submit_frame;
        cmp rax, 0;
        jne velw_fail_stage;
        call vel_layers_composed;
        cmp rax, 4;
        jne velw_fail_stage;
        call vel_frames_submitted;
        cmp rax, 1;
        jne velw_fail_stage;

        // -- 7. Atlas-full boundary check via a tight loop.
        //       Fill to 256 exactly; 257th refused.
        mov rax, 7;
        lea rcx, [rip + _velw_stage];
        mov [rcx], rax;

        call vel_reset;
        xor r12, r12;                            // counter
      velw_fill:
        mov rdi, r12;
        add rdi, 1;                              // avoid codepoint 0
        call vel_atlas_add_glyph;
        mov r13, r12;
        cmp rax, r13;
        jne velw_fail_stage;
        add r12, 1;
        cmp r12, 256;
        jb  velw_fill;

        call vel_atlas_count;
        mov r11, 256;
        cmp rax, r11;
        jne velw_fail_stage;

        // 257th refused.
        mov rdi, 0xFFFF;
        call vel_atlas_add_glyph;
        mov r11, 0xFFFFEEAB;
        cmp rax, r11;
        jne velw_fail_stage;

        // Return module to clean state.
        call vel_reset;
        call vel_bound;
        cmp rax, 1;
        jne velw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + velw_ok];
        call klog_s1;

        xor rax, rax;
        jmp velw_out;

      velw_fail_stage:
        lea rax, [rip + _velw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + velw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      velw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
