// tests/kernel/semterm/gui_kbdnav_synth.pdx -- R44.M3-003 (#1408)
//
// Boot witness for the semterm GUI keyboard navigation. Exercises
// reset (widgets_per_panel[*] = 1, panel = 0, widget = 0, ring
// hidden), arbitration honesty pin, widgets_set + refusals (bad
// panel, bad count == 0), ring_show + coerce-to-0/1, next_widget /
// prev_widget cycling with wrap through a 3-widget panel,
// next_panel / prev_panel rotating focus through all four panels
// with widget-focus reset, arrow dispatch (up / left -> prev, down /
// right -> next) + refusal (bad dir), and skip_link_next /
// skip_link_prev resetting widget focus to 0 + bumping skip_hits.
//
// Fingerprint: R44 SEMTERM GUI KBDNAV OK
// Failure fingerprint: R44 SEMTERM GUI KBDNAV FAIL + stage number.

module GuiKbdnavSynth = structure {

  pub let mut _knvw_stage : u64 = 0

  pub let knvw_ok   : [u8; 28] = "R44 SEMTERM GUI KBDNAV OK\n\0"
  pub let knvw_fail : [u8; 30] = "R44 SEMTERM GUI KBDNAV FAIL\n\0"

  pub let gui_kbdnav_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R44.M3-003 (#1408): boot witness for gui_kbdnav. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed knvw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration + defaults.
        mov rax, 1;
        lea rcx, [rip + _knvw_stage];
        mov [rcx], rax;

        call knv_reset;
        call knv_arbitrated;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_bound;
        cmp rax, 1;
        jne knvw_fail_stage;
        call knv_focus_panel;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_ring_visible;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_panel_bumps;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_widget_bumps;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_skip_hits;
        cmp rax, 0;
        jne knvw_fail_stage;

        // widgets_per_panel[i] defaults to 1.
        mov rdi, 0;
        call knv_widgets_get;
        cmp rax, 1;
        jne knvw_fail_stage;
        mov rdi, 3;
        call knv_widgets_get;
        cmp rax, 1;
        jne knvw_fail_stage;

        // Bad panel in widgets_get refused.
        mov rdi, 4;
        call knv_widgets_get;
        mov r11, 0xFFFFEE5E;
        cmp rax, r11;
        jne knvw_fail_stage;

        // -- 2. widgets_set + refusals.
        mov rax, 2;
        lea rcx, [rip + _knvw_stage];
        mov [rcx], rax;

        mov rdi, 0;                              // query editor panel
        mov rsi, 3;                              // 3 widgets
        call knv_widgets_set;
        cmp rax, 0;
        jne knvw_fail_stage;
        mov rdi, 0;
        call knv_widgets_get;
        cmp rax, 3;
        jne knvw_fail_stage;

        mov rdi, 1;                              // results panel
        mov rsi, 5;
        call knv_widgets_set;
        cmp rax, 0;
        jne knvw_fail_stage;
        mov rdi, 2;                              // tab bar panel
        mov rsi, 4;
        call knv_widgets_set;
        cmp rax, 0;
        jne knvw_fail_stage;
        mov rdi, 3;                              // status panel
        mov rsi, 2;
        call knv_widgets_set;
        cmp rax, 0;
        jne knvw_fail_stage;

        // Bad panel refused.
        mov rdi, 4;
        mov rsi, 1;
        call knv_widgets_set;
        mov r11, 0xFFFFEE5E;
        cmp rax, r11;
        jne knvw_fail_stage;
        // Bad count (0) refused.
        mov rdi, 0;
        mov rsi, 0;
        call knv_widgets_set;
        mov r11, 0xFFFFEE5D;
        cmp rax, r11;
        jne knvw_fail_stage;
        // widgets_get on panel 0 unchanged (= 3).
        mov rdi, 0;
        call knv_widgets_get;
        cmp rax, 3;
        jne knvw_fail_stage;

        // -- 3. ring_show coerces to 0/1.
        mov rax, 3;
        lea rcx, [rip + _knvw_stage];
        mov [rcx], rax;

        mov rdi, 5;                              // truthy -> 1
        call knv_ring_show;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_ring_visible;
        cmp rax, 1;
        jne knvw_fail_stage;
        mov rdi, 0;
        call knv_ring_show;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_ring_visible;
        cmp rax, 0;
        jne knvw_fail_stage;
        mov rdi, 1;
        call knv_ring_show;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_ring_visible;
        cmp rax, 1;
        jne knvw_fail_stage;

        // -- 4. next_widget / prev_widget with 3-widget panel 0.
        mov rax, 4;
        lea rcx, [rip + _knvw_stage];
        mov [rcx], rax;

        // From widget 0.
        call knv_focus_widget;
        cmp rax, 0;
        jne knvw_fail_stage;

        call knv_next_widget;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 1;
        jne knvw_fail_stage;

        call knv_next_widget;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 2;
        jne knvw_fail_stage;

        // Wrap.
        call knv_next_widget;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 0;
        jne knvw_fail_stage;

        // prev wraps to 2.
        call knv_prev_widget;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 2;
        jne knvw_fail_stage;

        // widget_bumps = 4.
        call knv_widget_bumps;
        cmp rax, 4;
        jne knvw_fail_stage;

        // -- 5. F6 rotation across panels; widget resets.
        mov rax, 5;
        lea rcx, [rip + _knvw_stage];
        mov [rcx], rax;

        // Widget was 2 on panel 0.
        call knv_next_panel;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_panel;
        cmp rax, 1;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 0;                              // reset
        jne knvw_fail_stage;

        call knv_next_panel;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_panel;
        cmp rax, 2;
        jne knvw_fail_stage;

        call knv_next_panel;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_panel;
        cmp rax, 3;
        jne knvw_fail_stage;

        // Wrap 3 -> 0.
        call knv_next_panel;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_panel;
        cmp rax, 0;
        jne knvw_fail_stage;

        // Shift+F6 wraps 0 -> 3.
        call knv_prev_panel;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_panel;
        cmp rax, 3;
        jne knvw_fail_stage;

        // panel_bumps = 5.
        call knv_panel_bumps;
        cmp rax, 5;
        jne knvw_fail_stage;

        // -- 6. Arrow dispatch on panel 3 (2 widgets).
        mov rax, 6;
        lea rcx, [rip + _knvw_stage];
        mov [rcx], rax;

        // On panel 3, widget starts at 0.
        call knv_focus_widget;
        cmp rax, 0;
        jne knvw_fail_stage;

        // Down (1) -> next -> 1.
        mov rdi, 1;
        call knv_arrow;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 1;
        jne knvw_fail_stage;

        // Right (3) -> next -> wraps to 0.
        mov rdi, 3;
        call knv_arrow;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 0;
        jne knvw_fail_stage;

        // Up (0) -> prev -> wraps to 1.
        mov rdi, 0;
        call knv_arrow;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 1;
        jne knvw_fail_stage;

        // Left (2) -> prev -> 0.
        mov rdi, 2;
        call knv_arrow;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 0;
        jne knvw_fail_stage;

        // Bad direction (4) refused.
        mov rdi, 4;
        call knv_arrow;
        mov r11, 0xFFFFEE5C;
        cmp rax, r11;
        jne knvw_fail_stage;

        // -- 7. skip_link_next / skip_link_prev.
        mov rax, 7;
        lea rcx, [rip + _knvw_stage];
        mov [rcx], rax;

        // Move to panel 1 (5 widgets) and advance widget focus a bit.
        call knv_next_panel;                     // 3 -> 0
        call knv_next_panel;                     // 0 -> 1
        call knv_focus_panel;
        cmp rax, 1;
        jne knvw_fail_stage;
        call knv_next_widget;                    // 0 -> 1
        call knv_next_widget;                    // 1 -> 2
        call knv_focus_widget;
        cmp rax, 2;
        jne knvw_fail_stage;

        // Forward skip-link -> widget = 0; panel unchanged.
        call knv_skip_link_next;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_panel;
        cmp rax, 1;
        jne knvw_fail_stage;
        call knv_skip_hits;
        cmp rax, 1;
        jne knvw_fail_stage;

        // Advance widget again.
        call knv_next_widget;
        call knv_next_widget;
        call knv_next_widget;
        call knv_focus_widget;
        cmp rax, 3;
        jne knvw_fail_stage;

        // Backward skip-link -> widget = 0; panel unchanged; hits = 2.
        call knv_skip_link_prev;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_panel;
        cmp rax, 1;
        jne knvw_fail_stage;
        call knv_skip_hits;
        cmp rax, 2;
        jne knvw_fail_stage;

        // -- 8. Single-widget panel: next/prev are no-op wraps.
        mov rax, 8;
        lea rcx, [rip + _knvw_stage];
        mov [rcx], rax;

        call knv_reset;

        // widgets_per_panel default 1; panel 0 focus at 0.
        call knv_next_widget;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 0;                              // (0 + 1) mod 1 = 0
        jne knvw_fail_stage;
        call knv_prev_widget;
        cmp rax, 0;
        jne knvw_fail_stage;
        call knv_focus_widget;
        cmp rax, 0;                              // (0 + 1 - 1) mod 1 = 0
        jne knvw_fail_stage;

        // Return module to clean state.
        call knv_reset;
        call knv_bound;
        cmp rax, 1;
        jne knvw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + knvw_ok];
        call klog_s1;

        xor rax, rax;
        jmp knvw_out;

      knvw_fail_stage:
        lea rax, [rip + _knvw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + knvw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      knvw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
