// tests/kernel/semterm/gui_layout_synth.pdx -- R44.M1-002 (#1401)
//
// Boot witness for the semantic-term GUI layout. Exercises reset,
// arbitration honesty pin, refusals before any tab exists, tab_new
// (root LEAF allocated, first tab becomes active + focused, later
// tabs do NOT), tab_active_set + bad-tab refusal, pane_split
// (returns new child_b id, orient stored, both children are LEAFs),
// bad orient / non-leaf / bad pane refusals, focus_next round-robin,
// and tabs-full / panes-full boundaries.
//
// Fingerprint: R44 SEMTERM GUI LAYOUT OK
// Failure fingerprint: R44 SEMTERM GUI LAYOUT FAIL + stage number.

module GuiLayoutSynth = structure {

  pub let mut _glyw_stage : u64 = 0

  pub let glyw_ok   : [u8; 24] = "SEMTERM GUI LAYOUT OK\0"
  pub let glyw_fail : [u8; 26] = "SEMTERM GUI LAYOUT FAIL\0"

  pub let gui_layout_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R44.M1-002 (#1401): boot witness for gui_layout. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed glyw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration + defaults.
        mov rax, 1;
        lea rcx, [rip + _glyw_stage];
        mov [rcx], rax;

        call gly_reset;
        call gly_arbitrated;
        cmp rax, 0;
        jne glyw_fail_stage;
        call gly_bound;
        cmp rax, 1;
        jne glyw_fail_stage;
        call gly_tab_count;
        cmp rax, 0;
        jne glyw_fail_stage;
        call gly_pane_alloc_next;
        cmp rax, 0;
        jne glyw_fail_stage;

        // -- 2. NO_TABS refusal: focus_set / focus_next / tab_active_set
        //       all refuse before any tab exists.
        mov rax, 2;
        lea rcx, [rip + _glyw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call gly_focus_set;
        mov r11, 0xFFFFEECC;
        cmp rax, r11;
        jne glyw_fail_stage;

        call gly_focus_next;
        mov r11, 0xFFFFEECC;
        cmp rax, r11;
        jne glyw_fail_stage;

        mov rdi, 0;
        call gly_tab_active_set;
        mov r11, 0xFFFFEECC;
        cmp rax, r11;
        jne glyw_fail_stage;

        call gly_reset;

        // -- 3. tab_new: first tab becomes active + focused on its root.
        mov rax, 3;
        lea rcx, [rip + _glyw_stage];
        mov [rcx], rax;

        mov rdi, 0xA1;                           // title_hash
        call gly_tab_new;
        cmp rax, 0;                              // first tab id
        jne glyw_fail_stage;

        call gly_tab_count;
        cmp rax, 1;
        jne glyw_fail_stage;
        call gly_pane_alloc_next;
        cmp rax, 1;
        jne glyw_fail_stage;
        call gly_tab_active_get;
        cmp rax, 0;
        jne glyw_fail_stage;
        call gly_focus_get;
        cmp rax, 0;                              // root pane
        jne glyw_fail_stage;

        // Root pane is a LEAF with session_hash = 0xA1.
        mov rdi, 0;
        call gly_pane_kind;
        cmp rax, 1;                              // LEAF
        jne glyw_fail_stage;
        mov rdi, 0;
        mov rsi, 1;                              // session_hash field
        call gly_pane_field;
        mov r11, 0xA1;
        cmp rax, r11;
        jne glyw_fail_stage;

        // -- 4. Second tab: does NOT change active / focus.
        mov rax, 4;
        lea rcx, [rip + _glyw_stage];
        mov [rcx], rax;

        mov rdi, 0xB2;
        call gly_tab_new;
        cmp rax, 1;
        jne glyw_fail_stage;

        call gly_tab_active_get;
        cmp rax, 0;
        jne glyw_fail_stage;
        call gly_focus_get;
        cmp rax, 0;
        jne glyw_fail_stage;

        // Pivot active + focus to second tab's root (pane 1).
        mov rdi, 1;
        call gly_tab_active_set;
        cmp rax, 0;
        jne glyw_fail_stage;
        mov rdi, 1;
        call gly_focus_set;
        cmp rax, 0;
        jne glyw_fail_stage;
        call gly_focus_get;
        cmp rax, 1;
        jne glyw_fail_stage;

        // Bad tab refused.
        mov rdi, 5;
        call gly_tab_active_set;
        mov r11, 0xFFFFEECD;
        cmp rax, r11;
        jne glyw_fail_stage;

        // -- 5. Pane split: LEAF at pane 0 promoted to SPLIT.
        //       Returns child_b id (should be 3 -- pane 2 = child_a, pane 3 = child_b).
        mov rax, 5;
        lea rcx, [rip + _glyw_stage];
        mov [rcx], rax;

        // Split with bad orient refused.
        mov rdi, 0;
        mov rsi, 2;
        call gly_pane_split;
        mov r11, 0xFFFFEEC8;
        cmp rax, r11;
        jne glyw_fail_stage;

        // Legit split, orient = V.
        mov rdi, 0;
        mov rsi, 1;                              // GLY_ORIENT_V
        call gly_pane_split;
        cmp rax, 3;
        jne glyw_fail_stage;

        call gly_pane_alloc_next;
        cmp rax, 4;
        jne glyw_fail_stage;

        // Pane 0 is now SPLIT (orient=V, child_a=2, child_b=3).
        mov rdi, 0;
        call gly_pane_kind;
        cmp rax, 2;                              // SPLIT
        jne glyw_fail_stage;
        mov rdi, 0;
        mov rsi, 1;                              // orient
        call gly_pane_field;
        cmp rax, 1;                              // V
        jne glyw_fail_stage;
        mov rdi, 0;
        mov rsi, 2;                              // child_a
        call gly_pane_field;
        cmp rax, 2;
        jne glyw_fail_stage;
        mov rdi, 0;
        mov rsi, 3;                              // child_b
        call gly_pane_field;
        cmp rax, 3;
        jne glyw_fail_stage;

        // Panes 2 and 3 are LEAFs; pane 2 inherited session_hash 0xA1
        // (from the old root LEAF of tab 0); pane 3 is fresh (hash = 0).
        mov rdi, 2;
        call gly_pane_kind;
        cmp rax, 1;
        jne glyw_fail_stage;
        mov rdi, 2;
        mov rsi, 1;
        call gly_pane_field;
        mov r11, 0xA1;
        cmp rax, r11;
        jne glyw_fail_stage;
        mov rdi, 3;
        mov rsi, 1;
        call gly_pane_field;
        cmp rax, 0;
        jne glyw_fail_stage;

        // -- 6. Split on non-LEAF refused (pane 0 is SPLIT now).
        mov rax, 6;
        lea rcx, [rip + _glyw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call gly_pane_split;
        mov r11, 0xFFFFEEC9;
        cmp rax, r11;
        jne glyw_fail_stage;

        // Bad pane refused.
        mov rdi, 42;
        mov rsi, 0;
        call gly_pane_split;
        mov r11, 0xFFFFEECA;
        cmp rax, r11;
        jne glyw_fail_stage;

        // Focus_set on SPLIT (pane 0) refused.
        mov rdi, 0;
        call gly_focus_set;
        mov r11, 0xFFFFEEC9;
        cmp rax, r11;
        jne glyw_fail_stage;

        // -- 7. focus_next round-robin. Starting at pane 1 (current focus)
        //       and cycling among LEAFs 1, 2, 3 (pane 0 is SPLIT, skipped).
        mov rax, 7;
        lea rcx, [rip + _glyw_stage];
        mov [rcx], rax;

        // Focus is at 1; next LEAF is 2.
        call gly_focus_next;
        cmp rax, 0;
        jne glyw_fail_stage;
        call gly_focus_get;
        cmp rax, 2;
        jne glyw_fail_stage;

        // Next: 3.
        call gly_focus_next;
        cmp rax, 0;
        jne glyw_fail_stage;
        call gly_focus_get;
        cmp rax, 3;
        jne glyw_fail_stage;

        // Next: wraps, skipping SPLIT pane 0, lands on LEAF 1.
        call gly_focus_next;
        cmp rax, 0;
        jne glyw_fail_stage;
        call gly_focus_get;
        cmp rax, 1;
        jne glyw_fail_stage;

        // -- 8. Tabs-full: 8 tabs allowed, 9th refused.
        mov rax, 8;
        lea rcx, [rip + _glyw_stage];
        mov [rcx], rax;

        call gly_reset;
        xor r12, r12;
      glyw_tab_fill:
        mov rdi, r12;
        add rdi, 0x100;
        call gly_tab_new;
        mov r13, r12;
        cmp rax, r13;
        jne glyw_fail_stage;
        add r12, 1;
        cmp r12, 8;
        jb  glyw_tab_fill;

        call gly_tab_count;
        cmp rax, 8;
        jne glyw_fail_stage;

        // 9th refused.
        mov rdi, 0x900;
        call gly_tab_new;
        mov r11, 0xFFFFEECE;
        cmp rax, r11;
        jne glyw_fail_stage;

        // Return module to clean state.
        call gly_reset;
        call gly_bound;
        cmp rax, 1;
        jne glyw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + glyw_ok];
        call klog_s1;

        xor rax, rax;
        jmp glyw_out;

      glyw_fail_stage:
        lea rax, [rip + _glyw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + glyw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      glyw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
