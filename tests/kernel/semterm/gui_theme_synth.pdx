// tests/kernel/semterm/gui_theme_synth.pdx -- R44.M1-003 (#1402)
//
// Boot witness for the semantic-term GUI theme registry. Exercises
// reset (DARK / IOSEVKA / 14pt defaults), arbitration honesty pin,
// theme_set + refusals (bad theme), font_set + refusals (bad font),
// font_size_set + refusals (below min, above max), persist_pending
// bookkeeping across a sequence of setters, and persist_flush drain
// + persist_flushed running total.
//
// Fingerprint: R44 SEMTERM GUI THEME OK
// Failure fingerprint: R44 SEMTERM GUI THEME FAIL + stage number.

module GuiThemeSynth = structure {

  pub let mut _gthw_stage : u64 = 0

  pub let gthw_ok   : [u8; 27] = "R44 SEMTERM GUI THEME OK\n\0"
  pub let gthw_fail : [u8; 29] = "R44 SEMTERM GUI THEME FAIL\n\0"

  pub let gui_theme_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R44.M1-003 (#1402): boot witness for gui_theme. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed gthw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration + defaults.
        mov rax, 1;
        lea rcx, [rip + _gthw_stage];
        mov [rcx], rax;

        call gth_reset;
        call gth_arbitrated;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_bound;
        cmp rax, 1;
        jne gthw_fail_stage;
        call gth_theme_get;
        cmp rax, 1;                              // DARK
        jne gthw_fail_stage;
        call gth_font_get;
        cmp rax, 0;                              // IOSEVKA
        jne gthw_fail_stage;
        call gth_font_size_get;
        cmp rax, 14;
        jne gthw_fail_stage;
        call gth_persist_pending;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_persist_flushed;
        cmp rax, 0;
        jne gthw_fail_stage;

        // -- 2. theme_set: valid values 0, 1, 2.
        mov rax, 2;
        lea rcx, [rip + _gthw_stage];
        mov [rcx], rax;

        mov rdi, 0;                              // LIGHT
        call gth_theme_set;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_theme_get;
        cmp rax, 0;
        jne gthw_fail_stage;

        mov rdi, 2;                              // HIGH_CONTRAST
        call gth_theme_set;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_theme_get;
        cmp rax, 2;
        jne gthw_fail_stage;

        // Bad theme (3) refused.
        mov rdi, 3;
        call gth_theme_set;
        mov r11, 0xFFFFEEBE;
        cmp rax, r11;
        jne gthw_fail_stage;

        // persist_pending = 2 (LIGHT, HIGH_CONTRAST; the refused one
        // does NOT bump the counter).
        call gth_persist_pending;
        cmp rax, 2;
        jne gthw_fail_stage;

        // -- 3. font_set: valid 0, 1.
        mov rax, 3;
        lea rcx, [rip + _gthw_stage];
        mov [rcx], rax;

        mov rdi, 1;                              // MONO_FALLBACK
        call gth_font_set;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_font_get;
        cmp rax, 1;
        jne gthw_fail_stage;

        // Bad font (2) refused.
        mov rdi, 2;
        call gth_font_set;
        mov r11, 0xFFFFEEBD;
        cmp rax, r11;
        jne gthw_fail_stage;

        // persist_pending = 3.
        call gth_persist_pending;
        cmp rax, 3;
        jne gthw_fail_stage;

        // -- 4. font_size: extremities of the valid range.
        mov rax, 4;
        lea rcx, [rip + _gthw_stage];
        mov [rcx], rax;

        mov rdi, 8;                              // min
        call gth_font_size_set;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_font_size_get;
        cmp rax, 8;
        jne gthw_fail_stage;

        mov rdi, 48;                             // max
        call gth_font_size_set;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_font_size_get;
        cmp rax, 48;
        jne gthw_fail_stage;

        // Below min refused.
        mov rdi, 7;
        call gth_font_size_set;
        mov r11, 0xFFFFEEBC;
        cmp rax, r11;
        jne gthw_fail_stage;

        // Above max refused.
        mov rdi, 49;
        call gth_font_size_set;
        mov r11, 0xFFFFEEBC;
        cmp rax, r11;
        jne gthw_fail_stage;

        // persist_pending = 5.
        call gth_persist_pending;
        cmp rax, 5;
        jne gthw_fail_stage;

        // -- 5. persist_flush drains and bumps persist_flushed.
        mov rax, 5;
        lea rcx, [rip + _gthw_stage];
        mov [rcx], rax;

        call gth_persist_flush;
        cmp rax, 5;                              // count returned
        jne gthw_fail_stage;
        call gth_persist_pending;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_persist_flushed;
        cmp rax, 5;
        jne gthw_fail_stage;

        // Second flush returns 0.
        call gth_persist_flush;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_persist_flushed;
        cmp rax, 5;
        jne gthw_fail_stage;

        // A subsequent setter bumps pending again; flush accumulates.
        mov rdi, 0;
        call gth_theme_set;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_persist_pending;
        cmp rax, 1;
        jne gthw_fail_stage;
        call gth_persist_flush;
        cmp rax, 1;
        jne gthw_fail_stage;
        call gth_persist_flushed;
        cmp rax, 6;
        jne gthw_fail_stage;

        // -- 6. Reset returns defaults + clears pending/flushed.
        mov rax, 6;
        lea rcx, [rip + _gthw_stage];
        mov [rcx], rax;

        call gth_reset;
        call gth_theme_get;
        cmp rax, 1;
        jne gthw_fail_stage;
        call gth_font_get;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_font_size_get;
        cmp rax, 14;
        jne gthw_fail_stage;
        call gth_persist_pending;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_persist_flushed;
        cmp rax, 0;
        jne gthw_fail_stage;
        call gth_bound;
        cmp rax, 1;
        jne gthw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gthw_ok];
        call klog_s1;

        xor rax, rax;
        jmp gthw_out;

      gthw_fail_stage:
        lea rax, [rip + _gthw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gthw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      gthw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
