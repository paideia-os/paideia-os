// tests/kernel/semterm/gui_scroll_synth.pdx -- R44.M2-003 (#1405)
//
// Boot witness for the semterm GUI smooth scrolling seam. Exercises
// reset (zeroed state, init_mark installed), arbitration honesty
// pin, viewport / content set + zero-refusal, max_offset_ss formula
// (content <= viewport clamps to 0), scroll_to refusals (no content,
// bad target, bad frames, anim busy), ease-out cubic animation with
// numerically-predictable Q0.10 arithmetic (2- and 4-frame runs
// forward, 2-frame backward), snap-to-target on final frame,
// animate_step accepting a multi-frame advance, animate_step
// refusals (idle, zero frames), scr_reproject_glyph subtraction,
// and scr_offset_int round-to-nearest.
//
// Numerical fixtures for ease-out cubic (Q0.10 arithmetic):
//   For frames_total = 2, after step 1 (left = 1):
//     progress = 512, u = 512, u2 = 256, u3 = 128, eased = 896.
//   For frames_total = 4, per step:
//     step 1: progress = 256, u = 768, u2 = 576, u3 = 432, eased = 592.
//     step 2: progress = 512, u = 512, u2 = 256, u3 = 128, eased = 896.
//     step 3: progress = 768, u = 256, u2 =  64, u3 =  16, eased = 1008.
//
// Fingerprint: R44 SEMTERM GUI SCROLL OK
// Failure fingerprint: R44 SEMTERM GUI SCROLL FAIL + stage number.

module GuiScrollSynth = structure {

  pub let mut _scrw_stage : u64 = 0

  pub let scrw_ok   : [u8; 24] = "SEMTERM GUI SCROLL OK\0"
  pub let scrw_fail : [u8; 26] = "SEMTERM GUI SCROLL FAIL\0"

  pub let gui_scroll_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R44.M2-003 (#1405): boot witness for gui_scroll. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed scrw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration + defaults.
        mov rax, 1;
        lea rcx, [rip + _scrw_stage];
        mov [rcx], rax;

        call scr_reset;
        call scr_arbitrated;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_bound;
        cmp rax, 1;
        jne scrw_fail_stage;
        call scr_viewport_get;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_content_get;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_offset_ss;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_frames_total;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_frames_left;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_frames_advanced;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_max_offset_ss;
        cmp rax, 0;
        jne scrw_fail_stage;

        // -- 2. viewport_set / content_set + zero refusal.
        mov rax, 2;
        lea rcx, [rip + _scrw_stage];
        mov [rcx], rax;

        mov rdi, 100;
        call scr_viewport_set;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_viewport_get;
        cmp rax, 100;
        jne scrw_fail_stage;

        mov rdi, 400;
        call scr_content_set;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_content_get;
        cmp rax, 400;
        jne scrw_fail_stage;

        // Zero refused.
        mov rdi, 0;
        call scr_viewport_set;
        mov r11, 0xFFFFEE8E;
        cmp rax, r11;
        jne scrw_fail_stage;
        mov rdi, 0;
        call scr_content_set;
        mov r11, 0xFFFFEE8E;
        cmp rax, r11;
        jne scrw_fail_stage;

        // max_offset_ss = (400 - 100) * 1024 = 307200.
        call scr_max_offset_ss;
        mov r11, 307200;
        cmp rax, r11;
        jne scrw_fail_stage;

        // -- 3. Content <= viewport clamps max to 0.
        mov rax, 3;
        lea rcx, [rip + _scrw_stage];
        mov [rcx], rax;

        call scr_reset;
        mov rdi, 100;
        call scr_viewport_set;
        cmp rax, 0;
        jne scrw_fail_stage;
        mov rdi, 100;                            // content == viewport
        call scr_content_set;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_max_offset_ss;
        cmp rax, 0;
        jne scrw_fail_stage;

        mov rdi, 50;                             // content < viewport
        call scr_content_set;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_max_offset_ss;
        cmp rax, 0;
        jne scrw_fail_stage;

        // Scroll refused: max is 0, any positive target is out of range.
        mov rdi, 1;
        mov rsi, 1;
        call scr_scroll_to;
        mov r11, 0xFFFFEE8C;
        cmp rax, r11;
        jne scrw_fail_stage;

        // -- 4. scroll_to refusals: no content, bad frames.
        mov rax, 4;
        lea rcx, [rip + _scrw_stage];
        mov [rcx], rax;

        // Fresh module: no viewport, no content -> NO_CONTENT.
        call scr_reset;
        mov rdi, 0;
        mov rsi, 1;
        call scr_scroll_to;
        mov r11, 0xFFFFEE8D;
        cmp rax, r11;
        jne scrw_fail_stage;

        // Viewport but no content -> NO_CONTENT.
        call scr_reset;
        mov rdi, 100;
        call scr_viewport_set;
        mov rdi, 0;
        mov rsi, 1;
        call scr_scroll_to;
        mov r11, 0xFFFFEE8D;
        cmp rax, r11;
        jne scrw_fail_stage;

        // Content set; frames == 0 refused.
        call scr_reset;
        mov rdi, 100;
        call scr_viewport_set;
        mov rdi, 400;
        call scr_content_set;
        mov rdi, 0;
        mov rsi, 0;
        call scr_scroll_to;
        mov r11, 0xFFFFEE8B;
        cmp rax, r11;
        jne scrw_fail_stage;

        // target > max_offset_ss refused.
        mov rdi, 307201;                         // one past max
        mov rsi, 4;
        call scr_scroll_to;
        mov r11, 0xFFFFEE8C;
        cmp rax, r11;
        jne scrw_fail_stage;

        // Boundary: target == max_offset_ss accepted.
        mov rdi, 307200;
        mov rsi, 4;
        call scr_scroll_to;
        cmp rax, 0;
        jne scrw_fail_stage;

        // Anim busy: scroll_to while animating refused.
        mov rdi, 1024;
        mov rsi, 2;
        call scr_scroll_to;
        mov r11, 0xFFFFEE8A;
        cmp rax, r11;
        jne scrw_fail_stage;

        // -- 5. Forward ease-out cubic: start = 0, target = 4096, 4 frames.
        //       Step-by-step offsets: 2368, 3584, 4032, SNAP 4096.
        mov rax, 5;
        lea rcx, [rip + _scrw_stage];
        mov [rcx], rax;

        call scr_reset;
        mov rdi, 100;
        call scr_viewport_set;
        mov rdi, 400;
        call scr_content_set;

        // scroll_to(target=4096, frames=4).
        mov rdi, 4096;
        mov rsi, 4;
        call scr_scroll_to;
        cmp rax, 0;
        jne scrw_fail_stage;

        call scr_frames_total;
        cmp rax, 4;
        jne scrw_fail_stage;
        call scr_frames_left;
        cmp rax, 4;
        jne scrw_fail_stage;

        // Step 1: eased = 592 -> offset = 4096 * 592 >> 10 = 2368.
        mov rdi, 1;
        call scr_animate_step;
        mov r11, 2368;
        cmp rax, r11;
        jne scrw_fail_stage;
        call scr_offset_ss;
        mov r11, 2368;
        cmp rax, r11;
        jne scrw_fail_stage;
        call scr_frames_left;
        cmp rax, 3;
        jne scrw_fail_stage;

        // Step 2: eased = 896 -> offset = 4096 * 896 >> 10 = 3584.
        mov rdi, 1;
        call scr_animate_step;
        mov r11, 3584;
        cmp rax, r11;
        jne scrw_fail_stage;

        // Step 3: eased = 1008 -> offset = 4096 * 1008 >> 10 = 4032.
        mov rdi, 1;
        call scr_animate_step;
        mov r11, 4032;
        cmp rax, r11;
        jne scrw_fail_stage;

        // Step 4: SNAP to target 4096.
        mov rdi, 1;
        call scr_animate_step;
        mov r11, 4096;
        cmp rax, r11;
        jne scrw_fail_stage;
        call scr_frames_left;
        cmp rax, 0;
        jne scrw_fail_stage;
        call scr_frames_advanced;
        cmp rax, 4;
        jne scrw_fail_stage;

        // Idle animate_step refused.
        mov rdi, 1;
        call scr_animate_step;
        mov r11, 0xFFFFEE89;
        cmp rax, r11;
        jne scrw_fail_stage;

        // -- 6. Multi-frame animate_step: same total, 2-frame advance.
        //       animate_step(2) after animate_step(2) = target snap.
        mov rax, 6;
        lea rcx, [rip + _scrw_stage];
        mov [rcx], rax;

        call scr_reset;
        mov rdi, 100;
        call scr_viewport_set;
        mov rdi, 400;
        call scr_content_set;

        // scroll_to(target=1024, frames=2). start=0, target=1024.
        // step 1 (left=1): progress=512, eased=896 -> offset = 896.
        // step 2 (left=0): SNAP 1024.
        mov rdi, 1024;
        mov rsi, 2;
        call scr_scroll_to;
        cmp rax, 0;
        jne scrw_fail_stage;

        // animate_step(1) -> 896.
        mov rdi, 1;
        call scr_animate_step;
        mov r11, 896;
        cmp rax, r11;
        jne scrw_fail_stage;

        // animate_step(5) -> clamps to remaining 1 frame -> SNAP 1024.
        mov rdi, 5;
        call scr_animate_step;
        mov r11, 1024;
        cmp rax, r11;
        jne scrw_fail_stage;
        call scr_frames_left;
        cmp rax, 0;
        jne scrw_fail_stage;

        // animate_step(0) refused (BAD_FRAMES) -- even while idle,
        // BAD_FRAMES precedes the ANIM_IDLE check per the code path,
        // so the queue of errors goes:
        //  - not init (fails)
        //  - frames == 0 (BAD_FRAMES)
        //  - anim idle (ANIM_IDLE)
        // With bad-frames-first ordering, animate_step(0) after
        // completion reports BAD_FRAMES.
        mov rdi, 0;
        call scr_animate_step;
        mov r11, 0xFFFFEE8B;
        cmp rax, r11;
        jne scrw_fail_stage;

        // -- 7. Backward scroll: start = 1024, target = 0, 2 frames.
        //       step 1 (left=1): eased=896, delta=1024
        //                        offset = 1024 - (1024*896)>>10 = 1024-896 = 128.
        //       step 2 (left=0): SNAP 0.
        mov rax, 7;
        lea rcx, [rip + _scrw_stage];
        mov [rcx], rax;

        call scr_reset;
        mov rdi, 100;
        call scr_viewport_set;
        mov rdi, 400;
        call scr_content_set;

        // Position offset at 1024 first: scroll from 0 -> 1024 in 1 frame (snap).
        mov rdi, 1024;
        mov rsi, 1;
        call scr_scroll_to;
        cmp rax, 0;
        jne scrw_fail_stage;
        mov rdi, 1;
        call scr_animate_step;
        mov r11, 1024;
        cmp rax, r11;
        jne scrw_fail_stage;

        // Now scroll back to 0 in 2 frames.
        mov rdi, 0;
        mov rsi, 2;
        call scr_scroll_to;
        cmp rax, 0;
        jne scrw_fail_stage;

        mov rdi, 1;
        call scr_animate_step;
        mov r11, 128;
        cmp rax, r11;
        jne scrw_fail_stage;

        mov rdi, 1;
        call scr_animate_step;
        cmp rax, 0;                              // SNAP 0
        jne scrw_fail_stage;

        // -- 8. scr_offset_int round-to-nearest.
        mov rax, 8;
        lea rcx, [rip + _scrw_stage];
        mov [rcx], rax;

        call scr_reset;
        mov rdi, 100;
        call scr_viewport_set;
        mov rdi, 4096;
        call scr_content_set;

        // offset 0 -> 0
        call scr_offset_int;
        cmp rax, 0;
        jne scrw_fail_stage;

        // offset 511 -> 0.
        mov rdi, 511;
        mov rsi, 1;
        call scr_scroll_to;
        mov rdi, 1;
        call scr_animate_step;
        call scr_offset_int;
        cmp rax, 0;
        jne scrw_fail_stage;

        // offset 512 -> 1.
        mov rdi, 512;
        mov rsi, 1;
        call scr_scroll_to;
        mov rdi, 1;
        call scr_animate_step;
        call scr_offset_int;
        cmp rax, 1;
        jne scrw_fail_stage;

        // offset 1024 -> 1.
        mov rdi, 1024;
        mov rsi, 1;
        call scr_scroll_to;
        mov rdi, 1;
        call scr_animate_step;
        call scr_offset_int;
        cmp rax, 1;
        jne scrw_fail_stage;

        // offset 1536 -> 2.
        mov rdi, 1536;
        mov rsi, 1;
        call scr_scroll_to;
        mov rdi, 1;
        call scr_animate_step;
        call scr_offset_int;
        cmp rax, 2;
        jne scrw_fail_stage;

        // -- 9. scr_reproject_glyph.
        mov rax, 9;
        lea rcx, [rip + _scrw_stage];
        mov [rcx], rax;

        call scr_reset;
        mov rdi, 100;
        call scr_viewport_set;
        mov rdi, 4096;
        call scr_content_set;

        // offset = 512.
        mov rdi, 512;
        mov rsi, 1;
        call scr_scroll_to;
        mov rdi, 1;
        call scr_animate_step;

        // reproject(1024) = 1024 - 512 = 512.
        mov rdi, 1024;
        call scr_reproject_glyph;
        cmp rax, 512;
        jne scrw_fail_stage;

        // reproject(2048) = 2048 - 512 = 1536.
        mov rdi, 2048;
        call scr_reproject_glyph;
        mov r11, 1536;
        cmp rax, r11;
        jne scrw_fail_stage;

        // Return module to clean state.
        call scr_reset;
        call scr_bound;
        cmp rax, 1;
        jne scrw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + scrw_ok];
        call klog_s1;

        xor rax, rax;
        jmp scrw_out;

      scrw_fail_stage:
        lea rax, [rip + _scrw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + scrw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      scrw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
