// tests/kernel/semterm/palette_synth.pdx -- R41.M3-003 (#1373)
//
// Boot witness for the color palette API. Exercises reset,
// arbitration honesty pin, the 16-entry default RGB table (spot
// checks against the xterm canon), ANSI SGR foreground and
// background mapping (30..37 / 90..97 / 40..47 / 100..107), the
// eight-slot colorblind-safe series mapping, the xterm-256 extended
// palette formula (6x6x6 cube and grayscale ramp), and refusals on
// out-of-range indices.
//
// Fingerprint: SEMTERM PALETTE OK
// Failure fingerprint: SEMTERM PALETTE FAIL + stage number.

module PaletteSynth = structure {

  pub let mut _palw_stage : u64 = 0

  pub let palw_ok   : [u8; 21] = "SEMTERM PALETTE OK\n\0"
  pub let palw_fail : [u8; 23] = "SEMTERM PALETTE FAIL\n\0"

  pub let palette_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M3-003 (#1373): boot witness for the color palette API. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed palw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin.
        mov rax, 1;
        lea rcx, [rip + _palw_stage];
        mov [rcx], rax;

        call pal_reset;
        call pal_arbitrated;
        cmp rax, 0;
        jne palw_fail_stage;
        call pal_bound;
        cmp rax, 1;
        jne palw_fail_stage;

        // -- 2. Default RGB spot checks (xterm canon).
        mov rax, 2;
        lea rcx, [rip + _palw_stage];
        mov [rcx], rax;

        xor rdi, rdi;                            // idx 0 = black
        call pal_default_rgb;
        cmp rax, 0x000000;
        jne palw_fail_stage;

        mov rdi, 1;                              // red
        call pal_default_rgb;
        mov r11, 0xCD0000;
        cmp rax, r11;
        jne palw_fail_stage;

        mov rdi, 4;                              // blue
        call pal_default_rgb;
        mov r11, 0x0000EE;
        cmp rax, r11;
        jne palw_fail_stage;

        mov rdi, 8;                              // bright-black
        call pal_default_rgb;
        mov r11, 0x7F7F7F;
        cmp rax, r11;
        jne palw_fail_stage;

        mov rdi, 15;                             // bright-white
        call pal_default_rgb;
        mov r11, 0xFFFFFF;
        cmp rax, r11;
        jne palw_fail_stage;

        // -- 3. ANSI FG mapping. idx 0..7 -> 30..37; idx 8..15 -> 90..97.
        mov rax, 3;
        lea rcx, [rip + _palw_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call pal_ansi_fg;
        cmp rax, 30;
        jne palw_fail_stage;

        mov rdi, 7;
        call pal_ansi_fg;
        cmp rax, 37;
        jne palw_fail_stage;

        mov rdi, 8;
        call pal_ansi_fg;
        cmp rax, 90;
        jne palw_fail_stage;

        mov rdi, 15;
        call pal_ansi_fg;
        cmp rax, 97;
        jne palw_fail_stage;

        // -- 4. ANSI BG mapping. idx 0..7 -> 40..47; idx 8..15 -> 100..107.
        mov rax, 4;
        lea rcx, [rip + _palw_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call pal_ansi_bg;
        cmp rax, 40;
        jne palw_fail_stage;

        mov rdi, 7;
        call pal_ansi_bg;
        cmp rax, 47;
        jne palw_fail_stage;

        mov rdi, 8;
        call pal_ansi_bg;
        cmp rax, 100;
        jne palw_fail_stage;

        mov rdi, 15;
        call pal_ansi_bg;
        cmp rax, 107;
        jne palw_fail_stage;

        // -- 5. Series mapping (colorblind-safe order per §1).
        mov rax, 5;
        lea rcx, [rip + _palw_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call pal_series_color;
        cmp rax, 4;                              // blue
        jne palw_fail_stage;

        mov rdi, 1;
        call pal_series_color;
        cmp rax, 11;                             // bright-yellow
        jne palw_fail_stage;

        mov rdi, 7;
        call pal_series_color;
        cmp rax, 3;                              // yellow
        jne palw_fail_stage;

        // -- 6. Extended palette: idx 0..15 defers to default.
        mov rax, 6;
        lea rcx, [rip + _palw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        call pal_extended;
        mov r11, 0x0000EE;
        cmp rax, r11;
        jne palw_fail_stage;

        // idx 16 -> (0, 0, 0) from cube formula (r_step=0, g_step=0, b_step=0)
        mov rdi, 16;
        call pal_extended;
        cmp rax, 0x000000;
        jne palw_fail_stage;

        // idx 51 -> r=0, g=0, b=5 -> b_channel = 55 + 5*40 = 255
        //   n = 35; r_step = 35/36 = 0; g_step = (35/6)%6 = 5; b_step = 35%6 = 5
        //   Wait: n = 51 - 16 = 35; r_step = 35/36 = 0; rem = 35;
        //         g_step = 35/6 = 5; b_step = 35%6 = 5
        //   r=0, g=55+5*40=255, b=55+5*40=255
        //   RGB = 0x00FFFF
        mov rdi, 51;
        call pal_extended;
        mov r11, 0x00FFFF;
        cmp rax, r11;
        jne palw_fail_stage;

        // idx 231 -> n = 215; r_step = 5, g_step = 5, b_step = 5 -> all 255
        //   215/36 = 5 rem 35; 35/6 = 5 rem 5.
        //   RGB = 0xFFFFFF
        mov rdi, 231;
        call pal_extended;
        mov r11, 0xFFFFFF;
        cmp rax, r11;
        jne palw_fail_stage;

        // idx 232 -> grayscale n=0 -> gray = 8; RGB = 0x080808
        mov rdi, 232;
        call pal_extended;
        mov r11, 0x080808;
        cmp rax, r11;
        jne palw_fail_stage;

        // idx 255 -> n=23; gray = 8 + 230 = 238 = 0xEE; RGB = 0xEEEEEE
        mov rdi, 255;
        call pal_extended;
        mov r11, 0xEEEEEE;
        cmp rax, r11;
        jne palw_fail_stage;

        // -- 7. Out-of-range refusals.
        mov rax, 7;
        lea rcx, [rip + _palw_stage];
        mov [rcx], rax;

        mov rdi, 16;                             // >= 16
        call pal_default_rgb;
        cmp rax, 0;
        jne palw_fail_stage;
        call pal_err;
        mov r11, 0xFFFFF06E;                     // PAL_ERR_BAD_IDX
        cmp rax, r11;
        jne palw_fail_stage;

        call pal_reset;

        mov rdi, 16;
        call pal_ansi_fg;
        cmp rax, 0;
        jne palw_fail_stage;
        call pal_err;
        mov r11, 0xFFFFF06E;
        cmp rax, r11;
        jne palw_fail_stage;

        call pal_reset;

        mov rdi, 8;                              // >= 8
        call pal_series_color;
        cmp rax, 0;
        jne palw_fail_stage;
        call pal_err;
        mov r11, 0xFFFFF06D;                     // PAL_ERR_BAD_SERIES
        cmp rax, r11;
        jne palw_fail_stage;

        call pal_reset;

        mov rdi, 256;                            // >= 256
        call pal_extended;
        cmp rax, 0;
        jne palw_fail_stage;
        call pal_err;
        mov r11, 0xFFFFF06C;                     // PAL_ERR_BAD_EXT
        cmp rax, r11;
        jne palw_fail_stage;

        // Return the module to a clean state.
        call pal_reset;
        call pal_bound;
        cmp rax, 1;
        jne palw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + palw_ok];
        call klog_s1;

        xor rax, rax;
        jmp palw_out;

      palw_fail_stage:
        lea rax, [rip + _palw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + palw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      palw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
