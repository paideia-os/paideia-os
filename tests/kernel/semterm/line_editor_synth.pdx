// tests/kernel/semterm/line_editor_synth.pdx -- R41.M4-002 (#1375)
//
// Boot witness for the semantic-term line editor. Exercises reset,
// arbitration honesty pin, insert + character-range refusal, cursor
// motion primitives (left/right/home/end + refusals), backspace and
// delete + empty refusals, kill_line + yank round trip, history push +
// up + down + empty refusal, and the completion-hook stub.
//
// Fingerprint: R41 SEMTERM LINE EDITOR OK
// Failure fingerprint: R41 SEMTERM LINE EDITOR FAIL + stage number.

module LineEditorSynth = structure {

  pub let mut _ledw_stage : u64 = 0

  pub let ledw_ok   : [u8; 29] = "R41 SEMTERM LINE EDITOR OK\n\0"
  pub let ledw_fail : [u8; 31] = "R41 SEMTERM LINE EDITOR FAIL\n\0"

  pub let line_editor_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M4-002 (#1375): boot witness for the line editor. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed ledw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin + empty buffer.
        mov rax, 1;
        lea rcx, [rip + _ledw_stage];
        mov [rcx], rax;

        call led_reset;
        call led_arbitrated;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_bound;
        cmp rax, 1;
        jne ledw_fail_stage;
        call led_buf_len;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_cursor;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_hist_count;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_kill_len;
        cmp rax, 0;
        jne ledw_fail_stage;

        // -- 2. Insert 'H', 'i': buf = "Hi"; cursor = 2.
        mov rax, 2;
        lea rcx, [rip + _ledw_stage];
        mov [rcx], rax;

        mov rdi, 0x48;                           // 'H'
        call led_insert;
        cmp rax, 0;
        jne ledw_fail_stage;
        mov rdi, 0x69;                           // 'i'
        call led_insert;
        cmp rax, 0;
        jne ledw_fail_stage;

        call led_buf_len;
        cmp rax, 2;
        jne ledw_fail_stage;
        call led_cursor;
        cmp rax, 2;
        jne ledw_fail_stage;

        mov rdi, 0;
        call led_get_at;
        cmp rax, 0x48;
        jne ledw_fail_stage;
        mov rdi, 1;
        call led_get_at;
        cmp rax, 0x69;
        jne ledw_fail_stage;

        // -- 3. Insert non-printable byte refused.
        mov rax, 3;
        lea rcx, [rip + _ledw_stage];
        mov [rcx], rax;

        mov rdi, 0x08;                           // BS -- outside [0x20, 0x7E]
        call led_insert;
        mov r11, 0xFFFFF049;                     // LED_ERR_BAD_CH
        cmp rax, r11;
        jne ledw_fail_stage;

        call led_reset;

        // -- 4. Cursor motion. Build "abc" then walk.
        mov rax, 4;
        lea rcx, [rip + _ledw_stage];
        mov [rcx], rax;

        mov rdi, 0x61;                           // 'a'
        call led_insert;
        cmp rax, 0;
        jne ledw_fail_stage;
        mov rdi, 0x62;                           // 'b'
        call led_insert;
        cmp rax, 0;
        jne ledw_fail_stage;
        mov rdi, 0x63;                           // 'c'
        call led_insert;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_cursor;
        cmp rax, 3;
        jne ledw_fail_stage;

        call led_home;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_cursor;
        cmp rax, 0;
        jne ledw_fail_stage;

        // Left at 0 refused.
        call led_left;
        mov r11, 0xFFFFF04E;                     // LED_ERR_BAD_POS
        cmp rax, r11;
        jne ledw_fail_stage;

        call led_reset;

        // -- 5. Insert-mid: "ac" then cursor left, insert 'b' -> "abc".
        mov rax, 5;
        lea rcx, [rip + _ledw_stage];
        mov [rcx], rax;

        mov rdi, 0x61;
        call led_insert;
        mov rdi, 0x63;
        call led_insert;
        call led_left;                           // cursor = 1
        cmp rax, 0;
        jne ledw_fail_stage;
        mov rdi, 0x62;
        call led_insert;                         // -> "abc", cursor = 2
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_buf_len;
        cmp rax, 3;
        jne ledw_fail_stage;
        mov rdi, 0;
        call led_get_at;
        cmp rax, 0x61;
        jne ledw_fail_stage;
        mov rdi, 1;
        call led_get_at;
        cmp rax, 0x62;
        jne ledw_fail_stage;
        mov rdi, 2;
        call led_get_at;
        cmp rax, 0x63;
        jne ledw_fail_stage;

        // -- 6. Backspace erases 'b' (cursor = 2 before) -> "ac".
        mov rax, 6;
        lea rcx, [rip + _ledw_stage];
        mov [rcx], rax;

        call led_backspace;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_buf_len;
        cmp rax, 2;
        jne ledw_fail_stage;
        mov rdi, 0;
        call led_get_at;
        cmp rax, 0x61;
        jne ledw_fail_stage;
        mov rdi, 1;
        call led_get_at;
        cmp rax, 0x63;
        jne ledw_fail_stage;

        // -- 7. Delete: cursor was 1 after backspace; delete removes 'c'.
        mov rax, 7;
        lea rcx, [rip + _ledw_stage];
        mov [rcx], rax;

        call led_delete;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_buf_len;
        cmp rax, 1;
        jne ledw_fail_stage;

        // Delete past end refused.
        call led_end;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_delete;
        mov r11, 0xFFFFF04C;                     // LED_ERR_BUF_EMPTY
        cmp rax, r11;
        jne ledw_fail_stage;

        call led_reset;

        // -- 8. kill_line + yank round trip.
        mov rax, 8;
        lea rcx, [rip + _ledw_stage];
        mov [rcx], rax;

        // Build "abcde", cursor at end.
        mov rdi, 0x61;
        call led_insert;
        mov rdi, 0x62;
        call led_insert;
        mov rdi, 0x63;
        call led_insert;
        mov rdi, 0x64;
        call led_insert;
        mov rdi, 0x65;
        call led_insert;
        // Move cursor to 2.
        call led_home;
        call led_right;
        call led_right;
        call led_cursor;
        cmp rax, 2;
        jne ledw_fail_stage;

        // Kill from cursor: kill "cde", buf becomes "ab", kill_len = 3.
        call led_kill_line;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_buf_len;
        cmp rax, 2;
        jne ledw_fail_stage;
        call led_kill_len;
        cmp rax, 3;
        jne ledw_fail_stage;

        // Yank at end -> "abcde".
        call led_end;
        call led_yank;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_buf_len;
        cmp rax, 5;
        jne ledw_fail_stage;
        mov rdi, 2;
        call led_get_at;
        cmp rax, 0x63;
        jne ledw_fail_stage;
        mov rdi, 4;
        call led_get_at;
        cmp rax, 0x65;
        jne ledw_fail_stage;

        call led_reset;

        // -- 9. History push + up + down.
        mov rax, 9;
        lea rcx, [rip + _ledw_stage];
        mov [rcx], rax;

        // Push "x".
        mov rdi, 0x78;
        call led_insert;
        call led_history_push;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_hist_count;
        cmp rax, 1;
        jne ledw_fail_stage;

        // Reset current line, push "yz".
        call led_reset;
        mov rdi, 0x79;
        call led_insert;
        mov rdi, 0x7A;
        call led_insert;
        // "yz" not pushed to hist; push it now.
        call led_history_push;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_hist_count;
        cmp rax, 1;                              // reset cleared history too
        jne ledw_fail_stage;

        // History up: load "yz" back into buf.
        call led_history_up;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_buf_len;
        cmp rax, 2;
        jne ledw_fail_stage;
        mov rdi, 0;
        call led_get_at;
        cmp rax, 0x79;
        jne ledw_fail_stage;

        // Another up refused (only one entry).
        call led_history_up;
        mov r11, 0xFFFFF04B;                     // LED_ERR_HIST_EMPTY
        cmp rax, r11;
        jne ledw_fail_stage;

        // Down past head refused.
        call led_history_down;
        mov r11, 0xFFFFF04B;
        cmp rax, r11;
        jne ledw_fail_stage;

        call led_reset;

        // -- 10. Completion hook returns 0 (stub) with no error latch.
        mov rax, 10;
        lea rcx, [rip + _ledw_stage];
        mov [rcx], rax;

        call led_complete_next;
        cmp rax, 0;
        jne ledw_fail_stage;
        call led_err;
        cmp rax, 0;
        jne ledw_fail_stage;

        // -- 11. Buffer-full refusal via 128 inserts.
        mov rax, 11;
        lea rcx, [rip + _ledw_stage];
        mov [rcx], rax;

        xor r12, r12;
      ledw_fill:
        mov rdi, 0x2E;                           // '.'
        call led_insert;
        cmp rax, 0;
        jne ledw_fail_stage;
        add r12, 1;
        cmp r12, 128;
        jb  ledw_fill;

        call led_buf_len;
        cmp rax, 128;
        jne ledw_fail_stage;

        // 129th insert refused.
        mov rdi, 0x2E;
        call led_insert;
        mov r11, 0xFFFFF04D;                     // LED_ERR_BUF_FULL
        cmp rax, r11;
        jne ledw_fail_stage;

        // Return the module to a clean state.
        call led_reset;
        call led_bound;
        cmp rax, 1;
        jne ledw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ledw_ok];
        call klog_s1;

        xor rax, rax;
        jmp ledw_out;

      ledw_fail_stage:
        lea rax, [rip + _ledw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ledw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      ledw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
