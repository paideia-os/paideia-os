// tests/kernel/semterm/types_synth.pdx -- R41.M1-003 (#1367)
//
// Boot witness for the semantic-term-core query type system. Exercises
// reset, env bind/lookup with duplicate + overflow refusals, effect-row
// union masking, per-node inference for Literal / TableRef /
// ColumnExpr / BinOp / SelectStmt, and refusal on a comparison whose
// operands disagree.
//
// Fingerprint: R41 SEMTERM TYPES OK
// Failure fingerprint: R41 SEMTERM TYPES FAIL + stage number.

module TypesSynth = structure {

  pub let mut _tyw_stage : u64 = 0

  pub let tyw_ok   : [u8; 23] = "R41 SEMTERM TYPES OK\n\0"
  pub let tyw_fail : [u8; 25] = "R41 SEMTERM TYPES FAIL\n\0"

  pub let tyw_q_ok : [u8; 24] = "SELECT id FROM users;\n\0"

  pub let types_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M1-003 (#1367): boot witness for the query type system. Exercises env refusals, effect masking, per-node inference, and the SELECT root shape. Labels prefixed tyw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin.
        mov rax, 1;
        lea rcx, [rip + _tyw_stage];
        mov [rcx], rax;

        call tyq_reset;
        call tyq_arbitrated;
        cmp rax, 0;
        jne tyw_fail_stage;
        call tyq_bound;
        cmp rax, 1;
        jne tyw_fail_stage;
        call tyq_env_count;
        cmp rax, 0;
        jne tyw_fail_stage;

        // -- 2. Bind + lookup.
        mov rax, 2;
        lea rcx, [rip + _tyw_stage];
        mov [rcx], rax;

        mov rdi, 0xAAAA;
        mov rsi, 1;                     // TY_INT
        call tyq_bind;
        cmp rax, 0;
        jne tyw_fail_stage;

        mov rdi, 0xBBBB;
        mov rsi, 2;                     // TY_TEXT
        call tyq_bind;
        cmp rax, 0;
        jne tyw_fail_stage;

        call tyq_env_count;
        cmp rax, 2;
        jne tyw_fail_stage;

        mov rdi, 0xAAAA;
        call tyq_lookup;
        cmp rax, 1;
        jne tyw_fail_stage;

        mov rdi, 0xBBBB;
        call tyq_lookup;
        cmp rax, 2;
        jne tyw_fail_stage;

        mov rdi, 0xCCCC;                // unbound
        call tyq_lookup;
        cmp rax, 0;
        jne tyw_fail_stage;

        // -- 3. Bind refusals.
        mov rax, 3;
        lea rcx, [rip + _tyw_stage];
        mov [rcx], rax;

        // Duplicate.
        mov rdi, 0xAAAA;
        mov rsi, 1;
        call tyq_bind;
        mov r11, 0xFFFFF15B;
        cmp rax, r11;
        jne tyw_fail_stage;

        // Bad type.
        mov rdi, 0xDDDD;
        mov rsi, 7;                     // > TY_MAX
        call tyq_bind;
        mov r11, 0xFFFFF15F;
        cmp rax, r11;
        jne tyw_fail_stage;

        // -- 4. Effect row union.
        mov rax, 4;
        lea rcx, [rip + _tyw_stage];
        mov [rcx], rax;

        mov rdi, 1;                     // EFR_READ
        mov rsi, 2;                     // EFR_WRITE
        call tyq_effect_union;
        cmp rax, 3;
        jne tyw_fail_stage;

        // Bit outside mask must be dropped.
        mov rdi, 1;
        mov rsi, 0x80;
        call tyq_effect_union;
        cmp rax, 1;
        jne tyw_fail_stage;

        // -- 5. Env overflow.
        mov rax, 5;
        lea rcx, [rip + _tyw_stage];
        mov [rcx], rax;

        // Fill up to 32.  Currently at 2; add 30 more.
        mov r12, 0;
      tyw_fill:
        cmp r12, 30;
        jae tyw_fill_done;
        mov rbx, r12;
        add rbx, 0x1000;                // unique hashes
        mov rdi, rbx;
        mov rsi, 1;
        call tyq_bind;
        cmp rax, 0;
        jne tyw_fail_stage;
        add r12, 1;
        jmp tyw_fill;
      tyw_fill_done:
        call tyq_env_count;
        cmp rax, 32;
        jne tyw_fail_stage;

        // Overflow refusal.
        mov rdi, 0xEEEE;
        mov rsi, 1;
        call tyq_bind;
        mov r11, 0xFFFFF15C;
        cmp rax, r11;
        jne tyw_fail_stage;

        // -- 6. Inference: build an AST via the parser and infer.
        //       Query: SELECT id FROM users;
        //       Expected: root -> TY_RELATION, EFR_READ.
        mov rax, 6;
        lea rcx, [rip + _tyw_stage];
        mov [rcx], rax;

        call par_reset;
        call lex_reset;
        lea rdi, [rip + tyw_q_ok];
        mov rsi, 21;
        call lex_bind;
        cmp rax, 0;
        jne tyw_fail_stage;

        call par_parse_select;
        cmp rax, 0;
        je  tyw_fail_stage;
        mov rbx, rax;

        // Fresh type env for this inference.
        call tyq_reset;

        mov rdi, rbx;
        call tyq_infer;
        cmp rax, 5;                     // TY_RELATION
        jne tyw_fail_stage;

        call tyq_root_ty;
        cmp rax, 5;
        jne tyw_fail_stage;

        call tyq_root_efr;
        // Must include EFR_READ.
        and rax, 1;
        cmp rax, 1;
        jne tyw_fail_stage;

        // Node cache is populated: node[root] type and efr.
        mov rdi, rbx;
        call tyq_node_ty;
        cmp rax, 5;
        jne tyw_fail_stage;

        // -- 7. Inference refusal: build a synthetic AST BIN_OP whose
        //       LEFT is Literal(INT) and RIGHT is Literal(TEXT). This
        //       must refuse with TYQ_ERR_MISMATCH.
        mov rax, 7;
        lea rcx, [rip + _tyw_stage];
        mov [rcx], rax;

        call par_reset;
        call tyq_reset;

        // Allocate LEFT literal (INT).
        mov rdi, 9;                     // AST_LITERAL
        call par_alloc;
        cmp rax, 0;
        je  tyw_fail_stage;
        mov r12, rax;                   // left idx
        mov rdi, r12;
        mov rsi, 4;                     // P0 = tok_kind
        mov rdx, 18;                    // TOK_INTLIT
        call par_node_set;
        cmp rax, 0;
        jne tyw_fail_stage;

        // Allocate RIGHT literal (TEXT).
        mov rdi, 9;
        call par_alloc;
        cmp rax, 0;
        je  tyw_fail_stage;
        mov r13, rax;
        mov rdi, r13;
        mov rsi, 4;
        mov rdx, 19;                    // TOK_STRLIT
        call par_node_set;
        cmp rax, 0;
        jne tyw_fail_stage;

        // Allocate BIN_OP.
        mov rdi, 7;                     // AST_BIN_OP
        call par_alloc;
        cmp rax, 0;
        je  tyw_fail_stage;
        mov r14, rax;
        mov rdi, r14;
        mov rsi, 1;                     // LEFT
        mov rdx, r12;
        call par_node_set;
        cmp rax, 0;
        jne tyw_fail_stage;
        mov rdi, r14;
        mov rsi, 2;                     // RIGHT
        mov rdx, r13;
        call par_node_set;
        cmp rax, 0;
        jne tyw_fail_stage;
        mov rdi, r14;
        mov rsi, 4;                     // P0 = op
        mov rdx, 20;                    // TOK_OP_EQ
        call par_node_set;
        cmp rax, 0;
        jne tyw_fail_stage;

        mov rdi, r14;
        call tyq_infer;
        cmp rax, 0;
        jne tyw_fail_stage;             // must fail (returns 0)
        call tyq_err;
        mov r11, 0xFFFFF159;            // TYQ_ERR_MISMATCH
        cmp rax, r11;
        jne tyw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tyw_ok];
        call klog_s1;

        xor rax, rax;
        jmp tyw_out;

      tyw_fail_stage:
        lea rax, [rip + _tyw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tyw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      tyw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
