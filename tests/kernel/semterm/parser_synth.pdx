// tests/kernel/semterm/parser_synth.pdx -- R41.M1-002 (#1366)
//
// Boot witness for the semantic-term-core parser. Exercises reset,
// arena allocation bounds, per-node cell bounds, expectation refusal,
// and a minimal SELECT col FROM tab recogniser end-to-end.
//
// Fingerprint: R41 SEMTERM PARSER OK
// Failure fingerprint: R41 SEMTERM PARSER FAIL + stage number.

module ParserSynth = structure {

  pub let mut _paw_stage : u64 = 0

  pub let paw_ok   : [u8; 24] = "R41 SEMTERM PARSER OK\n\0"
  pub let paw_fail : [u8; 26] = "R41 SEMTERM PARSER FAIL\n\0"

  pub let paw_q1 : [u8; 24] = "SELECT id FROM users;\n\0"
  pub let paw_q2 : [u8; 24] = "SELECT u.id FROM users\n\0"
  pub let paw_q3 : [u8; 24] = "SELECT id FROM 1\n\0"

  pub let parser_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M1-002 (#1366): boot witness for the recursive-descent parser. Same five-push callee-save discipline as every witness in this tree. Labels prefixed paw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration honesty pin.
        mov rax, 1;
        lea rcx, [rip + _paw_stage];
        mov [rcx], rax;

        call par_reset;
        call par_arbitrated;
        cmp rax, 0;
        jne paw_fail_stage;
        call par_bound;
        cmp rax, 1;
        jne paw_fail_stage;
        call par_next_idx;
        cmp rax, 1;                     // 0 reserved
        jne paw_fail_stage;
        call par_root;
        cmp rax, 0;
        jne paw_fail_stage;
        call par_capacity;
        cmp rax, 256;
        jne paw_fail_stage;

        // -- 2. Alloc: one node.
        mov rax, 2;
        lea rcx, [rip + _paw_stage];
        mov [rcx], rax;

        mov rdi, 2;                     // AST_TABLE_REF
        call par_alloc;
        cmp rax, 1;                     // first slot
        jne paw_fail_stage;
        mov rbx, rax;

        // par_node_get(idx, AST_OFF_KIND) == AST_TABLE_REF
        mov rdi, rbx;
        mov rsi, 0;
        call par_node_get;
        cmp rax, 2;
        jne paw_fail_stage;

        // par_node_set / get round trip on P0.
        mov rdi, rbx;
        mov rsi, 4;
        mov rdx, 0x1234;
        call par_node_set;
        cmp rax, 0;
        jne paw_fail_stage;
        mov rdi, rbx;
        mov rsi, 4;
        call par_node_get;
        mov r11, 0x1234;
        cmp rax, r11;
        jne paw_fail_stage;

        // par_node_set out-of-range off refused.
        mov rdi, rbx;
        mov rsi, 8;
        mov rdx, 0;
        call par_node_set;
        mov r11, 0xFFFFF16B;
        cmp rax, r11;
        jne paw_fail_stage;

        // par_node_set on idx 0 (reserved) refused.
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        call par_node_set;
        mov r11, 0xFFFFF16B;
        cmp rax, r11;
        jne paw_fail_stage;

        // -- 3. Alloc without reset refuses. Skip: par_alloc without
        //       reset would need us to zero init_mark first. Instead
        //       exercise the not-init path by manually reset-only-state.
        //       Handled via arena-full below rather than not-init.

        // -- 4. Arena-full. Push next to 256, then attempt one more.
        mov rax, 4;
        lea rcx, [rip + _paw_stage];
        mov [rcx], rax;

        // Clear the err latch from Stage 2's BAD_NODE refusals so this
        // stage's ARENA_FULL assertion sees a fresh latch. The parser's
        // set_err is first-writer-wins by design (§3), so a witness that
        // tests multiple refusal paths in sequence MUST reset the latch
        // between stages that both assert a specific latched code.
        call par_reset_err;

        // We already used slot 1. Fill 2..255 (254 more) then attempt.
        mov r12, 0;
      paw_fill:
        cmp r12, 254;
        jae paw_fill_done;
        mov rdi, 0;                     // AST_NONE
        call par_alloc;
        cmp rax, 0;
        je  paw_fail_stage;
        add r12, 1;
        jmp paw_fill;
      paw_fill_done:
        // One more should refuse.
        mov rdi, 0;
        call par_alloc;
        cmp rax, 0;
        jne paw_fail_stage;
        call par_err;
        mov r11, 0xFFFFF16E;
        cmp rax, r11;
        jne paw_fail_stage;

        // -- 5. Happy path: SELECT id FROM users;
        mov rax, 5;
        lea rcx, [rip + _paw_stage];
        mov [rcx], rax;

        call par_reset;
        call lex_reset;
        lea rdi, [rip + paw_q1];
        mov rsi, 21;                    // "SELECT id FROM users;"
        call lex_bind;
        cmp rax, 0;
        jne paw_fail_stage;

        call par_parse_select;
        cmp rax, 0;
        je  paw_fail_stage;
        mov rbx, rax;                   // root

        // Root kind must be AST_SELECT_STMT.
        mov rdi, rbx;
        mov rsi, 0;
        call par_node_get;
        cmp rax, 1;
        jne paw_fail_stage;

        // LEFT = column expr; must be non-zero.
        mov rdi, rbx;
        mov rsi, 1;
        call par_node_get;
        cmp rax, 0;
        je  paw_fail_stage;
        mov r12, rax;

        // The column expr's kind must be AST_COLUMN_EXPR.
        mov rdi, r12;
        mov rsi, 0;
        call par_node_get;
        cmp rax, 6;
        jne paw_fail_stage;

        // RIGHT = table ref; non-zero.
        mov rdi, rbx;
        mov rsi, 2;
        call par_node_get;
        cmp rax, 0;
        je  paw_fail_stage;
        mov r13, rax;

        // Table ref kind.
        mov rdi, r13;
        mov rsi, 0;
        call par_node_get;
        cmp rax, 2;
        jne paw_fail_stage;

        // par_root readback matches.
        call par_root;
        cmp rax, rbx;
        jne paw_fail_stage;

        call par_err;
        cmp rax, 0;
        jne paw_fail_stage;

        // -- 6. Qualified column: SELECT u.id FROM users
        mov rax, 6;
        lea rcx, [rip + _paw_stage];
        mov [rcx], rax;

        call par_reset;
        call lex_reset;
        lea rdi, [rip + paw_q2];
        mov rsi, 22;                    // "SELECT u.id FROM users"
        call lex_bind;
        cmp rax, 0;
        jne paw_fail_stage;

        call par_parse_select;
        cmp rax, 0;
        je  paw_fail_stage;
        mov rbx, rax;

        // LEFT = ColumnExpr with qualifier + column both non-zero.
        mov rdi, rbx;
        mov rsi, 1;
        call par_node_get;
        mov r12, rax;
        mov rdi, r12;
        mov rsi, 5;                     // P1 = qualifier_len
        call par_node_get;
        cmp rax, 1;                     // 'u' is 1 byte
        jne paw_fail_stage;
        mov rdi, r12;
        mov rsi, 7;                     // P3 = column_len
        call par_node_get;
        cmp rax, 2;                     // 'id' is 2 bytes
        jne paw_fail_stage;

        // -- 7. Unexpected token: SELECT id FROM 1
        mov rax, 7;
        lea rcx, [rip + _paw_stage];
        mov [rcx], rax;

        call par_reset;
        call lex_reset;
        lea rdi, [rip + paw_q3];
        mov rsi, 16;                    // "SELECT id FROM 1"
        call lex_bind;
        cmp rax, 0;
        jne paw_fail_stage;

        call par_parse_select;
        cmp rax, 0;
        jne paw_fail_stage;             // must fail
        call par_err;
        mov r11, 0xFFFFF16F;
        cmp rax, r11;
        jne paw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + paw_ok];
        call klog_s1;

        xor rax, rax;
        jmp paw_out;

      paw_fail_stage:
        lea rax, [rip + _paw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + paw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      paw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
