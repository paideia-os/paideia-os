// tests/kernel/semterm/gui_a11y_synth.pdx -- R44.M3-002 (#1407)
//
// Boot witness for the semterm GUI a11y binding. Exercises reset
// (zeroed state, init_mark installed), arbitration honesty pin,
// root_add exclusivity (first call succeeds; second refused with
// HAS_ROOT), child_add before root (NO_ROOT refusal), kind + parent
// validation (bad kind, bad parent -- including the NO_PARENT
// sentinel, which fires as BAD_PARENT because it is out of range),
// depth propagation across a 3-level tree, node_field reads +
// refusals (bad node, bad field), publish_pending bookkeeping across
// a sequence of adds, publish_flush drain + publishes_flushed
// running total, and pool-full refusal at NODE_MAX = 32.
//
// Fingerprint: R44 SEMTERM GUI A11Y OK
// Failure fingerprint: R44 SEMTERM GUI A11Y FAIL + stage number.

module GuiA11ySynth = structure {

  pub let mut _a11w_stage : u64 = 0

  pub let a11w_ok   : [u8; 22] = "SEMTERM GUI A11Y OK\n\0"
  pub let a11w_fail : [u8; 24] = "SEMTERM GUI A11Y FAIL\n\0"

  pub let gui_a11y_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R44.M3-002 (#1407): boot witness for gui_a11y. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed a11w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration + defaults.
        mov rax, 1;
        lea rcx, [rip + _a11w_stage];
        mov [rcx], rax;

        call a11_reset;
        call a11_arbitrated;
        cmp rax, 0;
        jne a11w_fail_stage;
        call a11_bound;
        cmp rax, 1;
        jne a11w_fail_stage;
        call a11_node_count;
        cmp rax, 0;
        jne a11w_fail_stage;
        call a11_publish_pending;
        cmp rax, 0;
        jne a11w_fail_stage;
        call a11_publishes_flushed;
        cmp rax, 0;
        jne a11w_fail_stage;
        call a11_root_installed;
        cmp rax, 0;
        jne a11w_fail_stage;

        // -- 2. child_add before root refused (NO_ROOT).
        mov rax, 2;
        lea rcx, [rip + _a11w_stage];
        mov [rcx], rax;

        mov rdi, 0;                              // parent_id
        mov rsi, 0;                              // kind = TEXT_INPUT
        mov rdx, 100;                            // name_id
        mov rcx, 200;                            // value_id
        call a11_child_add;
        mov r11, 0xFFFFEE6B;
        cmp rax, r11;
        jne a11w_fail_stage;
        call a11_node_count;
        cmp rax, 0;
        jne a11w_fail_stage;

        // -- 3. root_add: valid + bad-kind refusal + HAS_ROOT refusal.
        mov rax, 3;
        lea rcx, [rip + _a11w_stage];
        mov [rcx], rax;

        // Bad kind (4) refused BEFORE root installed.
        mov rdi, 4;                              // > A11Y_KIND_MAX
        mov rsi, 100;
        mov rdx, 200;
        call a11_root_add;
        mov r11, 0xFFFFEE6D;
        cmp rax, r11;
        jne a11w_fail_stage;
        call a11_root_installed;
        cmp rax, 0;
        jne a11w_fail_stage;

        // Valid root: TEXT_INPUT for the query editor.
        mov rdi, 0;                              // TEXT_INPUT
        mov rsi, 100;                            // name = query_editor
        mov rdx, 200;                            // value = current input
        call a11_root_add;
        cmp rax, 0;                              // root id
        jne a11w_fail_stage;
        call a11_root_installed;
        cmp rax, 1;
        jne a11w_fail_stage;
        call a11_node_count;
        cmp rax, 1;
        jne a11w_fail_stage;
        call a11_publish_pending;
        cmp rax, 1;
        jne a11w_fail_stage;

        // Root fields.
        mov rdi, 0;
        mov rsi, 0;                              // field 0 = kind
        call a11_node_field;
        cmp rax, 0;                              // TEXT_INPUT
        jne a11w_fail_stage;
        mov rdi, 0;
        mov rsi, 1;                              // field 1 = name_id
        call a11_node_field;
        cmp rax, 100;
        jne a11w_fail_stage;
        mov rdi, 0;
        mov rsi, 3;                              // field 3 = parent_id
        call a11_node_field;
        mov r11, 0xFFFFFFFFFFFFFFFF;             // A11Y_NO_PARENT
        cmp rax, r11;
        jne a11w_fail_stage;
        mov rdi, 0;
        mov rsi, 4;                              // field 4 = depth
        call a11_node_field;
        cmp rax, 0;                              // root depth
        jne a11w_fail_stage;

        // Second root_add refused (HAS_ROOT).
        mov rdi, 1;                              // TABLE
        mov rsi, 101;
        mov rdx, 201;
        call a11_root_add;
        mov r11, 0xFFFFEE6C;
        cmp rax, r11;
        jne a11w_fail_stage;
        call a11_node_count;
        cmp rax, 1;
        jne a11w_fail_stage;

        // -- 4. child_add validation: bad kind, bad parent.
        mov rax, 4;
        lea rcx, [rip + _a11w_stage];
        mov [rcx], rax;

        // Bad parent (id 1 does not yet exist).
        mov rdi, 1;
        mov rsi, 1;                              // TABLE
        mov rdx, 101;
        mov rcx, 201;
        call a11_child_add;
        mov r11, 0xFFFFEE6A;
        cmp rax, r11;
        jne a11w_fail_stage;

        // Parent == A11Y_NO_PARENT sentinel also refused (BAD_PARENT).
        mov rdi, 0xFFFFFFFFFFFFFFFF;
        mov rsi, 1;
        mov rdx, 101;
        mov rcx, 201;
        call a11_child_add;
        mov r11, 0xFFFFEE6A;
        cmp rax, r11;
        jne a11w_fail_stage;

        // Bad kind (4).
        mov rdi, 0;
        mov rsi, 4;
        mov rdx, 101;
        mov rcx, 201;
        call a11_child_add;
        mov r11, 0xFFFFEE6D;
        cmp rax, r11;
        jne a11w_fail_stage;

        // node_count unchanged.
        call a11_node_count;
        cmp rax, 1;
        jne a11w_fail_stage;

        // -- 5. Build a 3-level tree: root -> table -> cell (x3) + chart.
        mov rax, 5;
        lea rcx, [rip + _a11w_stage];
        mov [rcx], rax;

        // table under root (id=1, depth=1)
        mov rdi, 0;
        mov rsi, 1;                              // TABLE
        mov rdx, 300;
        mov rcx, 0;
        call a11_child_add;
        cmp rax, 1;
        jne a11w_fail_stage;
        // cell00 under table (id=2, depth=2)
        mov rdi, 1;
        mov rsi, 2;                              // CELL
        mov rdx, 400;
        mov rcx, 500;
        call a11_child_add;
        cmp rax, 2;
        jne a11w_fail_stage;
        // cell01 under table (id=3, depth=2)
        mov rdi, 1;
        mov rsi, 2;                              // CELL
        mov rdx, 401;
        mov rcx, 501;
        call a11_child_add;
        cmp rax, 3;
        jne a11w_fail_stage;
        // cell10 under table (id=4, depth=2)
        mov rdi, 1;
        mov rsi, 2;
        mov rdx, 410;
        mov rcx, 510;
        call a11_child_add;
        cmp rax, 4;
        jne a11w_fail_stage;
        // chart under root (id=5, depth=1)
        mov rdi, 0;
        mov rsi, 3;                              // CHART_REGION
        mov rdx, 600;
        mov rcx, 0;
        call a11_child_add;
        cmp rax, 5;
        jne a11w_fail_stage;

        call a11_node_count;
        cmp rax, 6;
        jne a11w_fail_stage;

        // Depth of cell01 (id 3) is 2.
        mov rdi, 3;
        mov rsi, 4;                              // depth
        call a11_node_field;
        cmp rax, 2;
        jne a11w_fail_stage;
        // Parent of cell01 is table (1).
        mov rdi, 3;
        mov rsi, 3;                              // parent_id
        call a11_node_field;
        cmp rax, 1;
        jne a11w_fail_stage;
        // Kind of chart (id 5) is CHART_REGION (3).
        mov rdi, 5;
        mov rsi, 0;
        call a11_node_field;
        cmp rax, 3;
        jne a11w_fail_stage;
        // Depth of chart is 1.
        mov rdi, 5;
        mov rsi, 4;
        call a11_node_field;
        cmp rax, 1;
        jne a11w_fail_stage;

        // publish_pending = 6 (root + 5 children).
        call a11_publish_pending;
        cmp rax, 6;
        jne a11w_fail_stage;

        // -- 6. node_field refusals.
        mov rax, 6;
        lea rcx, [rip + _a11w_stage];
        mov [rcx], rax;

        // Node out of range.
        mov rdi, 6;
        mov rsi, 0;
        call a11_node_field;
        mov r11, 0xFFFFEE69;
        cmp rax, r11;
        jne a11w_fail_stage;
        // Field out of range.
        mov rdi, 0;
        mov rsi, 5;
        call a11_node_field;
        mov r11, 0xFFFFEE68;
        cmp rax, r11;
        jne a11w_fail_stage;

        // -- 7. Flush publish_pending -> 0; flushed running total grows.
        mov rax, 7;
        lea rcx, [rip + _a11w_stage];
        mov [rcx], rax;

        call a11_publish_flush;
        cmp rax, 6;                              // count returned
        jne a11w_fail_stage;
        call a11_publish_pending;
        cmp rax, 0;
        jne a11w_fail_stage;
        call a11_publishes_flushed;
        cmp rax, 6;
        jne a11w_fail_stage;

        // Second flush returns 0.
        call a11_publish_flush;
        cmp rax, 0;
        jne a11w_fail_stage;
        call a11_publishes_flushed;
        cmp rax, 6;
        jne a11w_fail_stage;

        // Another add bumps pending; flush accumulates.
        mov rdi, 0;
        mov rsi, 2;
        mov rdx, 700;
        mov rcx, 0;
        call a11_child_add;
        cmp rax, 6;
        jne a11w_fail_stage;
        call a11_publish_pending;
        cmp rax, 1;
        jne a11w_fail_stage;
        call a11_publish_flush;
        cmp rax, 1;
        jne a11w_fail_stage;
        call a11_publishes_flushed;
        cmp rax, 7;
        jne a11w_fail_stage;

        // -- 8. Pool-full: fill up to 32 then refuse.
        mov rax, 8;
        lea rcx, [rip + _a11w_stage];
        mov [rcx], rax;

        call a11_reset;
        // Root.
        mov rdi, 0;
        mov rsi, 100;
        mov rdx, 200;
        call a11_root_add;
        cmp rax, 0;
        jne a11w_fail_stage;

        // Add 31 children under root -> node_count = 32.
        mov r12, 0;                              // loop counter
      a11w_fill_lp:
        mov rdi, 0;                              // parent = root
        mov rsi, 2;                              // CELL
        mov rdx, r12;                            // name_id = counter
        mov rcx, 0;
        call a11_child_add;
        // Check success and returned id.
        mov r11, 0xFFFFEE6E;
        cmp rax, r11;
        je  a11w_fail_stage;
        add r12, 1;
        cmp r12, 31;
        jb  a11w_fill_lp;

        call a11_node_count;
        cmp rax, 32;
        jne a11w_fail_stage;

        // Another child_add refused (NODES_FULL).
        mov rdi, 0;
        mov rsi, 2;
        mov rdx, 999;
        mov rcx, 0;
        call a11_child_add;
        mov r11, 0xFFFFEE6E;
        cmp rax, r11;
        jne a11w_fail_stage;

        // Return module to clean state.
        call a11_reset;
        call a11_bound;
        cmp rax, 1;
        jne a11w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + a11w_ok];
        call klog_s1;

        xor rax, rax;
        jmp a11w_out;

      a11w_fail_stage:
        lea rax, [rip + _a11w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + a11w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      a11w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
