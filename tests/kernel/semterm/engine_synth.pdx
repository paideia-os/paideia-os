// tests/kernel/semterm/engine_synth.pdx -- R41.M2-001 (#1368)
//
// Boot witness for the semantic-term-core query engine. Builds a
// SELECT id FROM users AST via the lexer + parser, registers the
// "users" name-hash in the sources registry, calls eng_plan, drains
// eng_next until end-of-stream, and confirms the result-set carries
// the synthetic-provider rows.
//
// Also exercises refusals: eng_plan when the AST root is a Literal
// (not a SelectStmt) latches ENG_ERR_BAD_ROOT; eng_plan with an
// unregistered FROM hash latches ENG_ERR_NO_SOURCE; a second
// eng_plan while a plan is live latches ENG_ERR_BUSY.
//
// Fingerprint: R41 SEMTERM ENGINE OK
// Failure fingerprint: R41 SEMTERM ENGINE FAIL + stage number.

module EngineSynth = structure {

  pub let mut _egw_stage : u64 = 0

  pub let egw_ok   : [u8; 24] = "R41 SEMTERM ENGINE OK\n\0"
  pub let egw_fail : [u8; 26] = "R41 SEMTERM ENGINE FAIL\n\0"

  pub let egw_q : [u8; 24] = "SELECT id FROM users;\n\0"

  pub let engine_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M2-001 (#1368): boot witness for the query engine. Five-push callee-save discipline. Nested calls: lex_bind, par_parse_select, src_register, eng_plan, eng_next loop. Labels prefixed egw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset the whole stack + arbitration honesty pin.
        mov rax, 1;
        lea rcx, [rip + _egw_stage];
        mov [rcx], rax;

        call eng_reset;
        call src_reset;
        call rs_reset;
        call par_reset;
        call lex_reset;
        call tyq_reset;

        call eng_arbitrated;
        cmp rax, 0;
        jne egw_fail_stage;
        call eng_bound;
        cmp rax, 1;
        jne egw_fail_stage;
        call eng_phase;
        cmp rax, 0;
        jne egw_fail_stage;
        call eng_emitted;
        cmp rax, 0;
        jne egw_fail_stage;

        // -- 2. Register the "users" name hash into the sources registry.
        //       Placeholder hash 0xB0DE stands in for whatever the
        //       terminal frontend will actually hash the ident "users"
        //       to; the engine is identifier-agnostic (see §5).
        mov rax, 2;
        lea rcx, [rip + _egw_stage];
        mov [rcx], rax;

        mov rdi, 0xB0DE;
        mov rsi, 42;                             // arbitrary schema tag
        xor rdx, rdx;                            // no live provider
        xor rcx, rcx;                            // no cap
        call src_register;
        cmp rax, 0;
        je  egw_fail_stage;
        mov r15, rax;                            // registered source_id

        // -- 3. Parse "SELECT id FROM users;" into an AST.
        mov rax, 3;
        lea rcx, [rip + _egw_stage];
        mov [rcx], rax;

        lea rdi, [rip + egw_q];
        mov rsi, 21;
        call lex_bind;
        cmp rax, 0;
        jne egw_fail_stage;

        call par_parse_select;
        cmp rax, 0;
        je  egw_fail_stage;
        mov rbx, rax;                            // root idx

        // -- 4. eng_plan with unknown FROM hash refused.
        mov rax, 4;
        lea rcx, [rip + _egw_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        mov rsi, 0xDEAD;                         // unregistered
        call eng_plan;
        mov r11, 0xFFFFF0BD;                     // ENG_ERR_NO_SOURCE
        cmp rax, r11;
        jne egw_fail_stage;
        call eng_phase;
        cmp rax, 0;                              // still IDLE
        jne egw_fail_stage;

        // Reset the err latch by resetting the engine (and preserve the
        // parser + sources state we still need).
        call eng_reset;

        // -- 5. eng_plan with a Literal root refused (BAD_ROOT).
        mov rax, 5;
        lea rcx, [rip + _egw_stage];
        mov [rcx], rax;

        // Build an AST_LITERAL node in a fresh parser arena.
        call par_reset;
        mov rdi, 9;                              // AST_LITERAL
        call par_alloc;
        cmp rax, 0;
        je  egw_fail_stage;
        mov r12, rax;                            // literal idx
        mov rdi, r12;
        mov rsi, 4;                              // P0 = tok_kind
        mov rdx, 18;                             // TOK_INTLIT
        call par_node_set;
        cmp rax, 0;
        jne egw_fail_stage;

        mov rdi, r12;
        mov rsi, 0xB0DE;
        call eng_plan;
        mov r11, 0xFFFFF0BE;                     // ENG_ERR_BAD_ROOT
        cmp rax, r11;
        jne egw_fail_stage;

        // Reset engine to clear err.
        call eng_reset;

        // -- 6. Happy path.
        mov rax, 6;
        lea rcx, [rip + _egw_stage];
        mov [rcx], rax;

        // Re-parse the SELECT.
        call par_reset;
        call lex_reset;
        lea rdi, [rip + egw_q];
        mov rsi, 21;
        call lex_bind;
        cmp rax, 0;
        jne egw_fail_stage;
        call par_parse_select;
        cmp rax, 0;
        je  egw_fail_stage;
        mov rbx, rax;                            // root idx

        mov rdi, rbx;
        mov rsi, 0xB0DE;
        call eng_plan;
        cmp rax, 0;
        jne egw_fail_stage;

        call eng_phase;
        cmp rax, 1;                              // ENG_PHASE_PLANNED
        jne egw_fail_stage;
        call eng_src_id;
        cmp rax, r15;
        jne egw_fail_stage;

        // -- 7. Busy: a second eng_plan while the plan is live refused.
        mov rax, 7;
        lea rcx, [rip + _egw_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        mov rsi, 0xB0DE;
        call eng_plan;
        mov r11, 0xFFFFF0BC;                     // ENG_ERR_BUSY
        cmp rax, r11;
        jne egw_fail_stage;

        // -- 8. Drain: eng_next must yield ENG_SYNTH_ROWS (=4) rows.
        mov rax, 8;
        lea rcx, [rip + _egw_stage];
        mov [rcx], rax;

        mov r13, 0;                              // yield count
      egw_drain:
        call eng_next;
        cmp rax, 1;
        jne egw_drain_end;
        add r13, 1;
        cmp r13, 10;                             // safety bound
        jae egw_fail_stage;
        jmp egw_drain;
      egw_drain_end:
        cmp rax, 0;
        jne egw_fail_stage;                      // must be clean end, not err
        cmp r13, 4;                              // ENG_SYNTH_ROWS
        jne egw_fail_stage;

        call eng_emitted;
        cmp rax, 4;
        jne egw_fail_stage;
        call eng_phase;
        cmp rax, 3;                              // ENG_PHASE_DRAINED
        jne egw_fail_stage;

        // Result-set: 4 rows, sealed, single column.
        call rs_prod_row;
        cmp rax, 4;
        jne egw_fail_stage;
        call rs_more;
        cmp rax, 0;
        jne egw_fail_stage;
        call rs_cols;
        cmp rax, 1;
        jne egw_fail_stage;

        // Row 0's cell is RS_TAG_INT with payload 0 (loop index).
        mov rdi, 0;
        mov rsi, 0;
        call rs_get;
        mov r14, rax;
        mov rdi, r14;
        call rs_tag;
        cmp rax, 1;                              // RS_TAG_INT
        jne egw_fail_stage;
        mov rdi, r14;
        call rs_payload;
        cmp rax, 0;
        jne egw_fail_stage;

        // Row 3's payload is 3.
        mov rdi, 3;
        mov rsi, 0;
        call rs_get;
        mov r14, rax;
        mov rdi, r14;
        call rs_payload;
        cmp rax, 3;
        jne egw_fail_stage;

        // -- 9. Close + eng_next after close refused.
        mov rax, 9;
        lea rcx, [rip + _egw_stage];
        mov [rcx], rax;

        call eng_close;
        cmp rax, 0;
        jne egw_fail_stage;
        call eng_phase;
        cmp rax, 0;                              // IDLE
        jne egw_fail_stage;

        call eng_next;
        mov r11, 0xFFFFF0BB;                     // ENG_ERR_NOT_PLANNED
        cmp rax, r11;
        jne egw_fail_stage;

        // Leave the module clean for downstream witnesses.
        call eng_reset;
        call src_reset;
        call rs_reset;
        call par_reset;
        call lex_reset;
        call tyq_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + egw_ok];
        call klog_s1;

        xor rax, rax;
        jmp egw_out;

      egw_fail_stage:
        lea rax, [rip + _egw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + egw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      egw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
