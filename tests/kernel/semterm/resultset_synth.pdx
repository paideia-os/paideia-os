// tests/kernel/semterm/resultset_synth.pdx -- R41.M2-003 (#1370)
//
// Boot witness for the semantic-term-core result-set buffer.
// Exercises reset, arbitration honesty pin, tag pack/unpack round
// trip with refusal on bad tag, open/push/next end-to-end, sealed
// drain, backpressure signalling (more_bit set but consumer at
// prod_row), and refusals on out-of-range col/row.
//
// Fingerprint: SEMTERM RESULTSET OK
// Failure fingerprint: SEMTERM RESULTSET FAIL + stage number.

module ResultsetSynth = structure {

  pub let mut _rsw_stage : u64 = 0

  pub let rsw_ok   : [u8; 23] = "SEMTERM RESULTSET OK\0"
  pub let rsw_fail : [u8; 25] = "SEMTERM RESULTSET FAIL\0"

  pub let resultset_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M2-003 (#1370): boot witness for the result-set buffer. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed rsw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin.
        mov rax, 1;
        lea rcx, [rip + _rsw_stage];
        mov [rcx], rax;

        call rs_reset;
        call rs_arbitrated;
        cmp rax, 0;
        jne rsw_fail_stage;
        call rs_bound;
        cmp rax, 1;
        jne rsw_fail_stage;
        call rs_opened;
        cmp rax, 0;
        jne rsw_fail_stage;
        call rs_prod_row;
        cmp rax, 0;
        jne rsw_fail_stage;
        call rs_cons_row;
        cmp rax, 0;
        jne rsw_fail_stage;
        call rs_more;
        cmp rax, 0;
        jne rsw_fail_stage;

        // -- 2. Pack / unpack round trip.
        mov rax, 2;
        lea rcx, [rip + _rsw_stage];
        mov [rcx], rax;

        mov rdi, 1;                              // RS_TAG_INT
        mov rsi, 42;
        call rs_pack;
        mov rbx, rax;                            // packed cell

        mov rdi, rbx;
        call rs_tag;
        cmp rax, 1;
        jne rsw_fail_stage;

        mov rdi, rbx;
        call rs_payload;
        cmp rax, 42;
        jne rsw_fail_stage;

        // Bad tag refused, latches err.
        mov rdi, 4;                              // > RS_TAG_MAX
        mov rsi, 0;
        call rs_pack;
        cmp rax, 0;
        jne rsw_fail_stage;
        call rs_err;
        mov r11, 0xFFFFF09A;
        cmp rax, r11;
        jne rsw_fail_stage;

        // Fresh reset before continuing (clears the latched err).
        call rs_reset;

        // -- 3. Push without open must refuse.
        mov rax, 3;
        lea rcx, [rip + _rsw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        call rs_pack;
        mov rbx, rax;
        xor rdi, rdi;
        mov rsi, rbx;
        call rs_push;
        mov r11, 0xFFFFF099;                     // RS_ERR_NOT_OPEN
        cmp rax, r11;
        jne rsw_fail_stage;

        call rs_reset;

        // -- 4. Open with bad cols refused.
        mov rax, 4;
        lea rcx, [rip + _rsw_stage];
        mov [rcx], rax;

        xor rdi, rdi;                            // cols = 0
        call rs_open;
        mov r11, 0xFFFFF098;                     // RS_ERR_BAD_COLS
        cmp rax, r11;
        jne rsw_fail_stage;

        mov rdi, 9;                              // > 8
        call rs_open;
        mov r11, 0xFFFFF098;
        cmp rax, r11;
        jne rsw_fail_stage;

        call rs_reset;

        // -- 5. Open + push 3 single-column rows + seal + drain via rs_next.
        mov rax, 5;
        lea rcx, [rip + _rsw_stage];
        mov [rcx], rax;

        mov rdi, 1;                              // cols = 1
        call rs_open;
        cmp rax, 0;
        jne rsw_fail_stage;
        call rs_opened;
        cmp rax, 1;
        jne rsw_fail_stage;
        call rs_cols;
        cmp rax, 1;
        jne rsw_fail_stage;
        call rs_more;
        cmp rax, 1;
        jne rsw_fail_stage;

        mov r12, 0;
      rsw_push_loop:
        cmp r12, 3;
        jae rsw_push_done;
        mov rdi, 1;                              // RS_TAG_INT
        mov rsi, r12;
        add rsi, 100;
        call rs_pack;
        mov rsi, rax;
        xor rdi, rdi;                            // col 0
        call rs_push;
        cmp rax, 0;
        jne rsw_fail_stage;
        add r12, 1;
        jmp rsw_push_loop;
      rsw_push_done:

        call rs_prod_row;
        cmp rax, 3;
        jne rsw_fail_stage;

        // Backpressure: consumer catches up while more_bit still 1.
        mov r13, 0;
      rsw_drain1:
        cmp r13, 3;
        jae rsw_drain1_done;
        call rs_next;
        cmp rax, 1;
        jne rsw_fail_stage;
        add r13, 1;
        jmp rsw_drain1;
      rsw_drain1_done:

        call rs_next;
        mov r11, 0xFFFFF09D;                     // RS_ERR_EMPTY (backpressure)
        cmp rax, r11;
        jne rsw_fail_stage;

        // Seal + rs_next returns 0 (drained + sealed).
        call rs_seal;
        cmp rax, 0;
        jne rsw_fail_stage;
        call rs_more;
        cmp rax, 0;
        jne rsw_fail_stage;
        call rs_next;
        cmp rax, 0;
        jne rsw_fail_stage;

        // -- 6. Random-access rs_get on committed rows.
        mov rax, 6;
        lea rcx, [rip + _rsw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call rs_get;
        mov rbx, rax;
        mov rdi, rbx;
        call rs_tag;
        cmp rax, 1;
        jne rsw_fail_stage;
        mov rdi, rbx;
        call rs_payload;
        cmp rax, 100;
        jne rsw_fail_stage;

        mov rdi, 2;
        mov rsi, 0;
        call rs_get;
        mov rdi, rax;
        call rs_payload;
        cmp rax, 102;
        jne rsw_fail_stage;

        // Out-of-range row refused.
        mov rdi, 100;
        mov rsi, 0;
        call rs_get;
        cmp rax, 0;
        jne rsw_fail_stage;
        call rs_err;
        mov r11, 0xFFFFF09B;                     // RS_ERR_BAD_ROW
        cmp rax, r11;
        jne rsw_fail_stage;

        // Out-of-range col refused.
        call rs_reset;
        mov rdi, 2;
        call rs_open;
        cmp rax, 0;
        jne rsw_fail_stage;
        mov rdi, 5;                              // > cols=2
        mov rsi, 0;
        call rs_push;
        mov r11, 0xFFFFF09C;                     // RS_ERR_BAD_COL
        cmp rax, r11;
        jne rsw_fail_stage;

        // -- 7. Return the module to a clean state (some other witness
        //       may run after us; the invariant is that init_mark
        //       survives a reset).
        call rs_reset;
        call rs_bound;
        cmp rax, 1;
        jne rsw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rsw_ok];
        call klog_s1;

        xor rax, rax;
        jmp rsw_out;

      rsw_fail_stage:
        lea rax, [rip + _rsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      rsw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
