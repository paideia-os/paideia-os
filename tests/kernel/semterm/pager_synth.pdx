// tests/kernel/semterm/pager_synth.pdx -- R41.M4-003 (#1376)
//
// Boot witness for the semantic-term pager. Exercises reset,
// arbitration honesty pin, pgr_open + refusals (bad rows_per_page,
// double open), page arithmetic (page_start / page_end for full and
// partial last page), next/prev navigation (including
// AT_START/AT_END refusals), search_set roundtrip, and quit
// stickiness.
//
// Fingerprint: SEMTERM PAGER OK
// Failure fingerprint: SEMTERM PAGER FAIL + stage number.

module PagerSynth = structure {

  pub let mut _pgrw_stage : u64 = 0

  pub let pgrw_ok   : [u8; 19] = "SEMTERM PAGER OK\n\0"
  pub let pgrw_fail : [u8; 21] = "SEMTERM PAGER FAIL\n\0"

  pub let pager_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R41.M4-003 (#1376): boot witness for the pager. Five-push callee-save discipline mirrors every witness in this tree. Labels prefixed pgrw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin + not opened.
        mov rax, 1;
        lea rcx, [rip + _pgrw_stage];
        mov [rcx], rax;

        call pgr_reset;
        call pgr_arbitrated;
        cmp rax, 0;
        jne pgrw_fail_stage;
        call pgr_bound;
        cmp rax, 1;
        jne pgrw_fail_stage;
        call pgr_opened;
        cmp rax, 0;
        jne pgrw_fail_stage;

        // -- 2. Navigation before open refused.
        mov rax, 2;
        lea rcx, [rip + _pgrw_stage];
        mov [rcx], rax;

        call pgr_next_page;
        mov r11, 0xFFFFF03E;                     // PGR_ERR_NOT_OPEN
        cmp rax, r11;
        jne pgrw_fail_stage;

        call pgr_reset;
        call pgr_prev_page;
        mov r11, 0xFFFFF03E;
        cmp rax, r11;
        jne pgrw_fail_stage;

        call pgr_reset;
        call pgr_page_start;
        cmp rax, 0;
        jne pgrw_fail_stage;
        call pgr_err;
        mov r11, 0xFFFFF03E;
        cmp rax, r11;
        jne pgrw_fail_stage;

        call pgr_reset;

        // -- 3. Open with bad rows_per_page (0 and 25) refused.
        mov rax, 3;
        lea rcx, [rip + _pgrw_stage];
        mov [rcx], rax;

        mov rdi, 100;
        xor rsi, rsi;
        call pgr_open;
        mov r11, 0xFFFFF03D;                     // PGR_ERR_BAD_ROWS
        cmp rax, r11;
        jne pgrw_fail_stage;

        call pgr_reset;
        mov rdi, 100;
        mov rsi, 25;
        call pgr_open;
        mov r11, 0xFFFFF03D;
        cmp rax, r11;
        jne pgrw_fail_stage;

        call pgr_reset;

        // -- 4. Open (100 rows, 10 per page): last_page = 9.
        mov rax, 4;
        lea rcx, [rip + _pgrw_stage];
        mov [rcx], rax;

        mov rdi, 100;
        mov rsi, 10;
        call pgr_open;
        cmp rax, 0;
        jne pgrw_fail_stage;
        call pgr_opened;
        cmp rax, 1;
        jne pgrw_fail_stage;
        call pgr_total_rows;
        cmp rax, 100;
        jne pgrw_fail_stage;
        call pgr_rows_per_page;
        cmp rax, 10;
        jne pgrw_fail_stage;
        call pgr_current_page;
        cmp rax, 0;
        jne pgrw_fail_stage;

        // Page 0: start = 0, end = 10.
        call pgr_page_start;
        cmp rax, 0;
        jne pgrw_fail_stage;
        call pgr_page_end;
        cmp rax, 10;
        jne pgrw_fail_stage;

        // -- 5. Double open refused.
        mov rax, 5;
        lea rcx, [rip + _pgrw_stage];
        mov [rcx], rax;

        mov rdi, 50;
        mov rsi, 5;
        call pgr_open;
        mov r11, 0xFFFFF039;                     // PGR_ERR_ALREADY_OPEN
        cmp rax, r11;
        jne pgrw_fail_stage;

        // -- 6. Prev at page 0 refused.
        mov rax, 6;
        lea rcx, [rip + _pgrw_stage];
        mov [rcx], rax;

        call pgr_prev_page;
        mov r11, 0xFFFFF03C;                     // PGR_ERR_AT_START
        cmp rax, r11;
        jne pgrw_fail_stage;

        // -- 7. Next 9 times to reach last page.
        mov rax, 7;
        lea rcx, [rip + _pgrw_stage];
        mov [rcx], rax;

        xor r12, r12;
      pgrw_next:
        call pgr_next_page;
        cmp rax, 0;
        jne pgrw_fail_stage;
        add r12, 1;
        cmp r12, 9;
        jb  pgrw_next;

        call pgr_current_page;
        cmp rax, 9;
        jne pgrw_fail_stage;

        // Last page: start = 90, end = 100.
        call pgr_page_start;
        cmp rax, 90;
        jne pgrw_fail_stage;
        call pgr_page_end;
        cmp rax, 100;
        jne pgrw_fail_stage;

        // Next at last page refused.
        call pgr_next_page;
        mov r11, 0xFFFFF03B;                     // PGR_ERR_AT_END
        cmp rax, r11;
        jne pgrw_fail_stage;

        // -- 8. Search set roundtrip.
        mov rax, 8;
        lea rcx, [rip + _pgrw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234;
        call pgr_search_set;
        cmp rax, 0;
        jne pgrw_fail_stage;
        call pgr_search_offset;
        cmp rax, 0x1234;
        jne pgrw_fail_stage;

        // -- 9. Quit sticks and refuses subsequent nav.
        mov rax, 9;
        lea rcx, [rip + _pgrw_stage];
        mov [rcx], rax;

        call pgr_quit;
        cmp rax, 0;
        jne pgrw_fail_stage;
        call pgr_quit_flag;
        cmp rax, 1;
        jne pgrw_fail_stage;

        call pgr_next_page;
        mov r11, 0xFFFFF03A;                     // PGR_ERR_QUIT
        cmp rax, r11;
        jne pgrw_fail_stage;

        call pgr_reset;
        mov rdi, 5;
        mov rsi, 3;
        call pgr_open;
        cmp rax, 0;
        jne pgrw_fail_stage;

        // -- 10. Partial last page: 5 rows / 3 per page -> last_page = 1;
        //        page 1: start = 3, end = 5.
        mov rax, 10;
        lea rcx, [rip + _pgrw_stage];
        mov [rcx], rax;

        call pgr_next_page;
        cmp rax, 0;
        jne pgrw_fail_stage;
        call pgr_current_page;
        cmp rax, 1;
        jne pgrw_fail_stage;
        call pgr_page_start;
        cmp rax, 3;
        jne pgrw_fail_stage;
        call pgr_page_end;
        cmp rax, 5;
        jne pgrw_fail_stage;

        call pgr_next_page;
        mov r11, 0xFFFFF03B;
        cmp rax, r11;
        jne pgrw_fail_stage;

        // -- 11. Empty table (0 rows): last_page = 0, both nav refuse.
        mov rax, 11;
        lea rcx, [rip + _pgrw_stage];
        mov [rcx], rax;

        call pgr_reset;
        xor rdi, rdi;
        mov rsi, 5;
        call pgr_open;
        cmp rax, 0;
        jne pgrw_fail_stage;
        call pgr_page_start;
        cmp rax, 0;
        jne pgrw_fail_stage;
        call pgr_page_end;
        cmp rax, 0;
        jne pgrw_fail_stage;

        call pgr_next_page;
        mov r11, 0xFFFFF03B;
        cmp rax, r11;
        jne pgrw_fail_stage;

        call pgr_prev_page;
        mov r11, 0xFFFFF03C;
        cmp rax, r11;
        jne pgrw_fail_stage;

        // Return the module to a clean state.
        call pgr_reset;
        call pgr_bound;
        cmp rax, 1;
        jne pgrw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pgrw_ok];
        call klog_s1;

        xor rax, rax;
        jmp pgrw_out;

      pgrw_fail_stage:
        lea rax, [rip + _pgrw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pgrw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pgrw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
