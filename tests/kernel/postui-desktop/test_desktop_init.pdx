// tests/kernel/postui-desktop/test_desktop_init.pdx -- Wave RRR / PU-DT-01
//
// Assert src/user/postui-desktop/entry.pdx's pdx_desktop_init calls
// compositor_register_client, then desktop_surface_gate, then
// terminal_widget_init, in that exact order (the sequence the issue
// names) -- and, since the mirror makes it observable for free, that
// status_bar_clock_init runs fourth.
//
// WHY A MIRROR, NOT A DIRECT CALL. postui-desktop's own modules
// (entry.pdx, surface_wire.pdx, terminal_widget.pdx, status_bar.pdx) are
// not yet linked together into one binary -- src/user/postui-desktop/
// README.md's "Lifecycle status": tools/build-user.sh excludes
// postui-desktop/* from every link line today. This file is built
// standalone (`paideia-as build --emit elf64`, one file, no link step --
// tools/compile-one.sh's own pattern), so it cannot `call` the real
// entry.pdx::pdx_desktop_init and have that resolve to anything.
// tdi_pdx_desktop_init_mirror below is a byte-for-byte copy of
// entry.pdx's pdx_desktop_init (as of this landing) under a test-local
// name, so an eventual real link against entry.pdx never collides on the
// symbol `pdx_desktop_init`.
//
// WEAK STUBS. compositor_register_client / desktop_surface_gate /
// terminal_widget_init / status_bar_clock_init are the four real
// dependencies pdx_desktop_init calls; each is stubbed here under its
// REAL name (not mirrored) because each one is a collaborator this test
// is not exercising, not the thing under test -- and each records the
// order it ran in, which is the whole point. "WEAK" in the sense that
// these are meant to be shadowed by the real client_registry.pdx /
// surface_wire.pdx / terminal_widget.pdx / status_bar.pdx definitions
// the moment linking makes that possible, not a paideia-as language-
// level `weak` attribute (no such attribute exists in this toolchain
// today).
//
// FOLLOW-UP (missing test infrastructure, not missing product API).
// Once postui-desktop gains a real multi-object test link target (a
// `tests/kernel/postui-desktop` entry in tools/build-user.sh, or a
// dedicated test linker script), delete tdi_pdx_desktop_init_mirror and
// have a rewritten witness `call` the genuine entry.pdx::pdx_desktop_init
// directly -- at which point the four WEAK stubs below must also be
// deleted so the real definitions are the ones actually linked in and
// call-order is observed via a shared trace capability rather than by
// substitution.
//
// Sequence IDs recorded into _tdi_trace: 1=compositor_register_client,
// 2=desktop_surface_gate, 3=terminal_widget_init, 4=status_bar_clock_init.

module TestDesktopInit = structure {

  pub let mut _tdi_state     : [u64; 3] = uninit @align(64)
  pub let mut _tdi_trace     : [u64; 4] = uninit @align(64)
  pub let mut _tdi_trace_len : u64 = 0

  // ==========================================================================
  // WEAK stubs -- see file header. Each is a pure leaf: no nested calls, no
  // callee-saved registers to preserve, so none of them need push/pop.
  // ==========================================================================

  pub let compositor_register_client : (u64, u64) -> u64 !{mem} @{} =
    fn (app_id: u64) (caps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PU-DT-01: WEAK stub standing in for src/user/compositor/client_registry.pdx's real compositor_register_client (not linkable into this standalone test file today -- see header). Appends sequence id 1 to _tdi_trace and returns a canned non-zero client-table slot. Leaf, no nested calls. Labels prefixed tdi_crc_.",
      block: {
        lea r10, [rip + _tdi_trace_len];
        mov rax, [r10];
        lea r11, [rip + _tdi_trace];
        mov rcx, 1;
        mov [r11 + rax*8], rcx;
        add rax, 1;
        mov [r10], rax;
        mov rax, 7;
        ret
      }
    }

  pub let desktop_surface_gate : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PU-DT-01: WEAK stub standing in for src/user/postui-desktop/surface_wire.pdx's real desktop_surface_gate (see header). Appends sequence id 2, returns 0 (SURFACE_WIRE_OK). Leaf. Labels prefixed tdi_dsg_.",
      block: {
        lea r10, [rip + _tdi_trace_len];
        mov rax, [r10];
        lea r11, [rip + _tdi_trace];
        mov rcx, 2;
        mov [r11 + rax*8], rcx;
        add rax, 1;
        mov [r10], rax;
        xor rax, rax;
        ret
      }
    }

  pub let terminal_widget_init : (u64) -> u64 !{mem} @{} =
    fn (tty_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PU-DT-01: WEAK stub standing in for src/user/postui-desktop/terminal_widget.pdx's real terminal_widget_init (see header). Appends sequence id 3, returns 0 (TW_OK). Leaf. Labels prefixed tdi_twi_.",
      block: {
        lea r10, [rip + _tdi_trace_len];
        mov rax, [r10];
        lea r11, [rip + _tdi_trace];
        mov rcx, 3;
        mov [r11 + rax*8], rcx;
        add rax, 1;
        mov [r10], rax;
        xor rax, rax;
        ret
      }
    }

  pub let status_bar_clock_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PU-DT-01: WEAK stub standing in for src/user/postui-desktop/status_bar.pdx's real status_bar_clock_init (see header). Appends sequence id 4. Leaf. Labels prefixed tdi_sbci_.",
      block: {
        lea r10, [rip + _tdi_trace_len];
        mov rax, [r10];
        lea r11, [rip + _tdi_trace];
        mov rcx, 4;
        mov [r11 + rax*8], rcx;
        add rax, 1;
        mov [r10], rax;
        ret
      }
    }

  // ==========================================================================
  // tdi_pdx_desktop_init_mirror -- byte-for-byte copy of entry.pdx's
  // pdx_desktop_init, under a test-local name (see header §WHY A MIRROR).
  // ==========================================================================

  pub let tdi_pdx_desktop_init_mirror : () -> u64 !{mem, sysreg} @{cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "PU-DT-01: mirror of entry.pdx::pdx_desktop_init's four-step init sequence, calling this file's WEAK stubs above by the same names the real init calls the real modules by. r12 holds &_tdi_state across all four calls, pushed/popped around the body exactly as the original does. Labels prefixed tdim_.",
      block: {
        push r12;
        lea r12, [rip + _tdi_state];

        mov rdi, 1;
        mov rsi, 3;
        call compositor_register_client;
        mov [r12 + 0], rax;

        mov rdi, 0;
        call desktop_surface_gate;
        mov [r12 + 8], rax;

        mov rdi, 0;
        call terminal_widget_init;
        mov [r12 + 16], rax;

        call status_bar_clock_init;

        mov rax, [r12 + 0];
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // test_desktop_init_witness() -> u64      0 = pass, else failing stage
  // ==========================================================================

  pub let test_desktop_init_witness : () -> u64 !{mem, sysreg} @{cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "PU-DT-01: reset the trace, run the mirrored init sequence, assert _tdi_trace == [1,2,3,4] and _tdi_trace_len == 4 -- compositor_register_client first, then desktop_surface_gate, then terminal_widget_init (the three the issue names explicitly), then status_bar_clock_init (the real fourth step). Returns 0 on pass, else the 1-based stage number of the first mismatch (5 = wrong trace length). Labels prefixed tdiw_.",
      block: {
        lea r10, [rip + _tdi_trace_len];
        xor rax, rax;
        mov [r10], rax;

        call tdi_pdx_desktop_init_mirror;

        lea r10, [rip + _tdi_trace_len];
        mov rax, [r10];
        cmp rax, 4;
        jne tdiw_fail_len;

        lea r11, [rip + _tdi_trace];

        mov rax, [r11 + 0];
        cmp rax, 1;
        jne tdiw_fail_1;

        mov rax, [r11 + 8];
        cmp rax, 2;
        jne tdiw_fail_2;

        mov rax, [r11 + 16];
        cmp rax, 3;
        jne tdiw_fail_3;

        mov rax, [r11 + 24];
        cmp rax, 4;
        jne tdiw_fail_4;

        xor rax, rax;
        ret;
      tdiw_fail_len:
        mov rax, 5;
        ret;
      tdiw_fail_1:
        mov rax, 1;
        ret;
      tdiw_fail_2:
        mov rax, 2;
        ret;
      tdiw_fail_3:
        mov rax, 3;
        ret;
      tdiw_fail_4:
        mov rax, 4;
        ret
      }
    }
}
