// tests/kernel/postui-desktop/test_terminal_frame_swap.pdx -- Wave RRR / PU-DT-02
//
// Assert src/user/postui-desktop/terminal_widget.pdx's
// terminal_widget_frame_swap bumps its vblank-placeholder swap counter
// (terminal_widget_swap_count) when a 128x48 ARGB frame is swapped in.
//
// "MOCK VBLANK COUNTER" == THE REAL swap_count FIELD. terminal_widget.pdx's
// own file header already documents swap_count as "a same-process counter
// bump today, not a real vblank ISR hookup... The counter exists so a
// smoke witness can prove terminal_widget_frame_swap ran." There is no
// separate vblank-specific counter to invent for this test -- it is the
// exact mechanism the issue is asking to be exercised.
//
// WHY MIRRORS, NOT DIRECT CALLS. Same reasoning as test_desktop_init.pdx's
// header: postui-desktop's modules are not yet linked together (see
// src/user/postui-desktop/README.md's "Lifecycle status"), so this
// standalone `paideia-as build --emit elf64` file cannot `call` the real
// terminal_widget.o. tfs_terminal_widget_frame_swap_mirror /
// tfs_terminal_widget_swap_count_mirror below are byte-for-byte copies of
// terminal_widget.pdx's terminal_widget_frame_swap / terminal_widget_
// swap_count (as of this landing), under test-local names with private
// state (_tfs_frame mirrors _tw_frame's [scanline_ptr, scanline_len,
// swap_count] layout).
//
// WEAK STUB: desktop_surface_gate. terminal_widget_frame_swap's real body
// gates every swap on the real desktop_surface_gate (surface_wire.pdx),
// which bottoms out in sys_cap_invoke -- a real syscall this standalone
// userspace test cannot make. desktop_surface_gate is WEAK-stubbed here
// under its real name to always report SURFACE_WIRE_OK (0), simulating
// "the surface is plumbed". The fail-closed case (cap_slot unmapped) is
// PU-DT-05's job (test_surface_wire_fail_closed.pdx), not this file's.
//
// FOLLOW-UP. Once postui-desktop gets a real multi-object test link
// target, delete the mirrors and the desktop_surface_gate stub and link
// directly against the real terminal_widget.o + surface_wire.o (backed,
// at that point, by a real or QEMU-mocked KIND_SURFACE cap for the
// gate's non-zero path).

module TestTerminalFrameSwap = structure {

  pub let TW_OK         : u64 = 0
  pub let TW_BAD_ARG    : u64 = 0xFFFFE180
  pub let TW_NO_SURFACE : u64 = 0xFFFFE181

  // _tfs_frame: [scanline_ptr, scanline_len, swap_count] -- mirrors
  // terminal_widget.pdx's _tw_frame layout exactly.
  pub let mut _tfs_frame : [u64; 3] = uninit @align(64)

  // 128x48 ARGB8888 seed frame: 128 * 48 * 4 = 24576 bytes.
  pub let TFS_FRAME_W_PX    : u64 = 128
  pub let TFS_FRAME_H_PX    : u64 = 48
  pub let TFS_FRAME_BYTES   : u64 = 24576   // 128 * 48 * 4
  pub let mut _tfs_scanline : [u8; 24576] = uninit @align(64)

  // Placeholder non-zero surface slot -- any nonzero value; the WEAK
  // stub below never inspects it.
  pub let TFS_SURFACE_SLOT : u64 = 1

  // ==========================================================================
  // WEAK stub -- see file header.
  // ==========================================================================

  pub let desktop_surface_gate : (u64) -> u64 !{} @{} =
    fn (slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "PU-DT-02: WEAK stub standing in for surface_wire.pdx's real desktop_surface_gate (see header) -- always reports SURFACE_WIRE_OK so the frame-swap path under test proceeds past the gate. Leaf, no memory touched. Labels prefixed tfs_dsg_.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Mirrors of terminal_widget.pdx's frame-swap machinery (see header).
  // ==========================================================================

  pub let tfs_terminal_widget_frame_swap_mirror : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (surface_slot: u64) (scanline_ptr: u64) (scanline_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "PU-DT-02: mirror of terminal_widget.pdx::terminal_widget_frame_swap, unchanged register discipline (r12=scanline_ptr, r13=scanline_len held across the call to the WEAK-stubbed desktop_surface_gate). Labels prefixed tfsw_.",
      block: {
        cmp rsi, 0;
        je tfsw_bad_arg;
        push r12;
        push r13;
        mov r12, rsi;
        mov r13, rdx;
        call desktop_surface_gate;
        cmp rax, 0;
        jne tfsw_no_surface;
        lea r10, [rip + _tfs_frame];
        mov [r10 + 0], r12;
        mov [r10 + 8], r13;
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        pop r13;
        pop r12;
        xor rax, rax;
        ret;
      tfsw_no_surface:
        pop r13;
        pop r12;
        mov rax, 0xFFFFE181;
        ret;
      tfsw_bad_arg:
        mov rax, 0xFFFFE180;
        ret
      }
    }

  pub let tfs_terminal_widget_swap_count_mirror : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PU-DT-02: mirror of terminal_widget.pdx::terminal_widget_swap_count. Labels prefixed tfsc_.",
      block: {
        lea r10, [rip + _tfs_frame];
        mov rax, [r10 + 16];
        ret
      }
    }

  // ==========================================================================
  // test_terminal_frame_swap_witness() -> u64      0 = pass, else failing stage
  // ==========================================================================

  pub let test_terminal_frame_swap_witness : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "PU-DT-02: zero _tfs_frame, seed the 128x48 ARGB scanline buffer with a recognisable non-zero pattern, read the counter before any swap (must be 0), swap once through the mirror, and assert: the swap accepted (TW_OK), the counter incremented to 1, and the recorded scanline_ptr/scanline_len match what was passed -- the 'vblank-triggered swap fires' property the issue asks for. Labels prefixed ttfsw_.",
      block: {
        lea r10, [rip + _tfs_frame];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;

        lea rdi, [rip + _tfs_scanline];
        mov rcx, 3072;                     // 24576 / 8
        mov rax, 0xAABBCCDDAABBCCDD;       // recognisable non-zero fill
        rep_stosq;

        call tfs_terminal_widget_swap_count_mirror;
        cmp rax, 0;
        jne ttfsw_fail_1;

        mov rdi, 1;                        // TFS_SURFACE_SLOT
        lea rsi, [rip + _tfs_scanline];
        mov rdx, 24576;                    // TFS_FRAME_BYTES
        call tfs_terminal_widget_frame_swap_mirror;
        cmp rax, 0;
        jne ttfsw_fail_2;

        call tfs_terminal_widget_swap_count_mirror;
        cmp rax, 1;
        jne ttfsw_fail_3;

        lea r10, [rip + _tfs_frame];
        lea r11, [rip + _tfs_scanline];
        mov rax, [r10 + 0];
        cmp rax, r11;
        jne ttfsw_fail_4;

        mov rax, [r10 + 8];
        cmp rax, 24576;
        jne ttfsw_fail_5;

        xor rax, rax;
        ret;
      ttfsw_fail_1:
        mov rax, 1;
        ret;
      ttfsw_fail_2:
        mov rax, 2;
        ret;
      ttfsw_fail_3:
        mov rax, 3;
        ret;
      ttfsw_fail_4:
        mov rax, 4;
        ret;
      ttfsw_fail_5:
        mov rax, 5;
        ret
      }
    }
}
