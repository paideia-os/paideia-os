// tests/kernel/postui-desktop/test_status_bar_composite.pdx -- Wave RRR / PU-DT-03
//
// Assert a composite status-bar render places all three widget slots
// (clock, battery, wifi) at fixed x-offsets and that each slot's content
// is a non-zero-byte pattern.
//
// MISSING API (documented, not silently invented as if real).
// src/user/postui-desktop/status_bar.pdx exports status_bar_clock_init /
// status_bar_clock_tick / status_bar_battery_percent / status_bar_wifi_
// signal_pct / status_bar_wifi_ssid_len / status_bar_wifi_ssid_ptr -- one
// accessor per widget -- but NO status_bar_render composing all three
// into one destination buffer, and config.pdx has no STATUS_BAR_CLOCK_X /
// STATUS_BAR_BATTERY_X / STATUS_BAR_WIFI_X layout constants (only
// STATUS_BAR_HEIGHT_PX exists). tsb_status_bar_render_stub below is a
// test-local placeholder for that missing composite renderer, deliberately
// NOT named status_bar_render and NOT placed in status_bar.pdx, so a real
// future export of that name never collides with this test's stand-in.
//
// FOLLOW-UP (product API gap, file separately from this test wave):
//   1. config.pdx: add STATUS_BAR_CLOCK_X=0 / STATUS_BAR_BATTERY_X=200 /
//      STATUS_BAR_WIFI_X=400 (the offsets this test asserts against, per
//      the issue's own layout) alongside STATUS_BAR_HEIGHT_PX.
//   2. status_bar.pdx: add a real status_bar_render(dest_ptr) that calls
//      the three existing per-widget accessors and blits each into its
//      rect, the way terminal_widget.pdx's Frame-to-rect blit consumes
//      _tw_frame. Once that lands, delete tsb_status_bar_render_stub and
//      point the witness at the real export.
//
// WHY MIRRORS FOR THE THREE ACCESSORS, NOT DIRECT CALLS. postui-desktop's
// modules are not yet linked together (README.md "Lifecycle status"), so
// this standalone `paideia-as build --emit elf64` file cannot `call` the
// real status_bar.o. The three widget-value mirrors below
// (tsb_status_bar_clock_init_mirror / _clock_tick_mirror /
// _battery_percent_mirror / _wifi_signal_pct_mirror) are byte-for-byte
// copies of status_bar.pdx's real bodies (as of this landing) under
// test-local names.
//
// WEAK STUB: sys_clock_read_ns. status_bar_clock_tick's real logic reads
// the monotonic clock via this syscall wrapper -- a real syscall this
// standalone test cannot make. Stubbed under its real name to return a
// fixed 5,000,000ns reading, which clears the poll-interval delta
// (STATUS_BAR_CLOCK_POLL_NS = 1,000,000ns) on the very first tick against
// a freshly-zeroed clock cell, giving a deterministic non-zero cached
// value. status_bar_battery_percent(0) and status_bar_wifi_signal_pct()
// need no stub: both are pure/placeholder-path at slot=0, per status_bar.
// pdx's own header (§BATTERY, §WIFI) -- neither makes a syscall in the
// path this test exercises.

module TestStatusBarComposite = structure {

  pub let TSB_CLOCK_X   : u64 = 0
  pub let TSB_BATTERY_X : u64 = 200
  pub let TSB_WIFI_X    : u64 = 400

  // Mirrors status_bar.pdx's _sb_clock: [last_poll_ns, cached_ns].
  pub let mut _tsb_clock : [u64; 2] = uninit @align(64)

  // Composite render destination: 64 qwords (512 bytes), wide enough to
  // hold a qword at each of the three x-offsets above.
  pub let mut _tsb_dest : [u64; 64] = uninit @align(64)

  // ==========================================================================
  // WEAK stub -- see file header.
  // ==========================================================================

  pub let sys_clock_read_ns : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "PU-DT-03: WEAK stub for the real sys_clock_read_ns syscall wrapper (src/user/syscall_shim.pdx) -- this standalone test cannot make a real syscall. Returns a fixed 5,000,000ns (5ms) reading, deterministic across runs. Leaf. Labels prefixed tsb_scrn_.",
      block: {
        mov rax, 5000000;
        ret
      }
    }

  // ==========================================================================
  // Mirrors of status_bar.pdx's per-widget accessors (see header).
  // ==========================================================================

  pub let tsb_status_bar_clock_init_mirror : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PU-DT-03: mirror of status_bar.pdx::status_bar_clock_init. Labels prefixed tsb_sbci_.",
      block: {
        lea r10, [rip + _tsb_clock];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        ret
      }
    }

  pub let tsb_status_bar_clock_tick_mirror : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "PU-DT-03: mirror of status_bar.pdx::status_bar_clock_tick, calling the WEAK-stubbed sys_clock_read_ns above by its real name. r12 holds &_tsb_clock across the call, pushed/popped as the original does. Labels prefixed tsb_sbct_.",
      block: {
        push r12;
        lea r12, [rip + _tsb_clock];
        call sys_clock_read_ns;
        mov r10, rax;
        mov r11, [r12 + 0];
        mov rax, r10;
        sub rax, r11;
        cmp rax, 1000000;
        jb tsb_sbct_stale_ok;
        mov [r12 + 0], r10;
        mov [r12 + 8], r10;
      tsb_sbct_stale_ok:
        mov rax, [r12 + 8];
        pop r12;
        ret
      }
    }

  pub let tsb_status_bar_battery_percent_mirror : (u64) -> u64 !{sysreg} @{cap} =
    fn (battery_slot: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "PU-DT-03: mirror of status_bar.pdx::status_bar_battery_percent. This test always passes battery_slot=0 (placeholder path); the sys_cap_invoke call on the non-zero path is never reached and is left as an unresolved external reference, exactly as the real file leaves it in isolation. Labels prefixed tsb_sbbp_.",
      block: {
        cmp rdi, 0;
        je tsb_sbbp_placeholder;
        mov rsi, 3;
        call sys_cap_invoke;
        ret;
      tsb_sbbp_placeholder:
        mov rax, 75;
        ret
      }
    }

  pub let tsb_status_bar_wifi_signal_pct_mirror : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "PU-DT-03: mirror of status_bar.pdx::status_bar_wifi_signal_pct -- fixed placeholder, no syscall. Labels prefixed tsb_sbws_.",
      block: {
        mov rax, 60;
        ret
      }
    }

  // ==========================================================================
  // tsb_status_bar_render_stub -- test-local composite renderer, standing
  // in for the missing product API (see header §MISSING API).
  // ==========================================================================

  pub let tsb_status_bar_render_stub : (u64) -> () !{mem, sysreg} @{cap} =
    fn (dest_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "PU-DT-03: composite three widget slots into dest_ptr at TSB_CLOCK_X=0 / TSB_BATTERY_X=200 / TSB_WIFI_X=400, one qword each, via the three widget mirrors above (battery queried at slot=0, the config.pdx placeholder-not-granted convention). r12 holds dest_ptr across the three widget calls, pushed/popped around the body. Labels prefixed tsbr_.",
      block: {
        push r12;
        mov r12, rdi;

        call tsb_status_bar_clock_init_mirror;
        call tsb_status_bar_clock_tick_mirror;
        mov [r12 + 0], rax;          // TSB_CLOCK_X

        mov rdi, 0;
        call tsb_status_bar_battery_percent_mirror;
        mov [r12 + 200], rax;        // TSB_BATTERY_X

        call tsb_status_bar_wifi_signal_pct_mirror;
        mov [r12 + 400], rax;        // TSB_WIFI_X

        pop r12;
        ret
      }
    }

  // ==========================================================================
  // test_status_bar_composite_witness() -> u64      0 = pass, else failing stage
  // ==========================================================================

  pub let test_status_bar_composite_witness : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "PU-DT-03: zero the 512-byte destination, render the composite, then assert each of the three qword slots is non-zero and matches the exact widget value the mirrors are deterministic for (clock=5,000,000 from the WEAK-stubbed clock reading; battery=75, status_bar.pdx's own STATUS_BAR_BATTERY_PLACEHOLDER_PCT; wifi=60, status_bar.pdx's own fixed placeholder). Labels prefixed tscw_.",
      block: {
        lea rdi, [rip + _tsb_dest];
        xor rax, rax;
        mov rcx, 64;
        rep_stosq;

        lea rdi, [rip + _tsb_dest];
        call tsb_status_bar_render_stub;

        lea r10, [rip + _tsb_dest];

        mov rax, [r10 + 0];
        cmp rax, 0;
        je tscw_fail_clock;
        cmp rax, 5000000;
        jne tscw_fail_clock;

        mov rax, [r10 + 200];
        cmp rax, 0;
        je tscw_fail_battery;
        cmp rax, 75;
        jne tscw_fail_battery;

        mov rax, [r10 + 400];
        cmp rax, 0;
        je tscw_fail_wifi;
        cmp rax, 60;
        jne tscw_fail_wifi;

        xor rax, rax;
        ret;
      tscw_fail_clock:
        mov rax, 1;
        ret;
      tscw_fail_battery:
        mov rax, 2;
        ret;
      tscw_fail_wifi:
        mov rax, 3;
        ret
      }
    }
}
