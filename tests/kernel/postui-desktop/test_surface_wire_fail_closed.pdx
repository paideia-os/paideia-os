// tests/kernel/postui-desktop/test_surface_wire_fail_closed.pdx -- Wave RRR
// / PU-DT-05
//
// Assert src/user/postui-desktop/surface_wire.pdx's desktop_surface_gate
// fails CLOSED on an unmapped capability slot (cap_slot=0), per config.pdx's
// "0 == not granted at spawn" convention.
//
// NAMING: SURFACE_GATE_REFUSED == THE REAL SURFACE_WIRE_REFUSED. The issue
// text names the expected return "SURFACE_GATE_REFUSED"; surface_wire.pdx's
// real exported constant is SURFACE_WIRE_REFUSED (0xFFFFE190). Same value,
// different name -- SURFACE_GATE_REFUSED below is a local alias asserting
// numeric equality with the real constant, not a claim that surface_wire.
// pdx exports a symbol by that name.
//
// WHY A MIRROR, NOT A DIRECT CALL. postui-desktop's modules are not yet
// linked together (src/user/postui-desktop/README.md "Lifecycle status"),
// so this standalone `paideia-as build --emit elf64` file cannot `call`
// the real surface_wire.o. tsw_desktop_surface_gate_mirror below is a
// byte-for-byte copy of surface_wire.pdx's real desktop_surface_gate (as
// of this landing), under a test-local name.
//
// NO WEAK STUB NEEDED. slot=0 refuses inside desktop_surface_gate BEFORE
// any call to sys_cap_invoke (`cmp rdi, 0; je dsg_refused` is the very
// first thing the real function does) -- exactly the fail-closed property
// this test asserts. The mirror's non-zero branch still references
// sys_cap_invoke, left as a genuine unresolved external exactly as the
// real surface_wire.pdx leaves it when built in isolation; this test
// never exercises that branch, so no stub is required.
//
// FOLLOW-UP. Once postui-desktop gets a real multi-object test link
// target, delete the mirror and `call` the genuine surface_wire.o
// directly.

module TestSurfaceWireFailClosed = structure {

  pub let SURFACE_WIRE_OK      : u64 = 0
  pub let SURFACE_GATE_REFUSED : u64 = 0xFFFFE190   // == surface_wire.pdx's SURFACE_WIRE_REFUSED

  // ==========================================================================
  // Mirror of surface_wire.pdx's real desktop_surface_gate (see header).
  // ==========================================================================

  pub let tsw_desktop_surface_gate_mirror : (u64) -> u64 !{sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "PU-DT-05: mirror of surface_wire.pdx::desktop_surface_gate, unchanged. slot==0 refuses before any syscall (dsg_refused), matching config.pdx's DESKTOP_SURFACE_SLOT=0 'not granted' convention -- this is the fail-closed path the witness exercises. The non-zero branch's call to sys_cap_invoke is left unresolved (see header §NO WEAK STUB NEEDED); this test never reaches it. Labels prefixed dsg_.",
      block: {
        cmp rdi, 0;
        je dsg_refused;
        mov rsi, 0;
        call sys_cap_invoke;
        cmp rax, 0;
        je dsg_refused;
        mov r10, 0xFFFFFFFFFFFFFFFE;
        cmp rax, r10;
        je dsg_refused;
        mov r10, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r10;
        je dsg_refused;
        xor rax, rax;
        ret;
      dsg_refused:
        mov rax, 0xFFFFE190;
        ret
      }
    }

  // ==========================================================================
  // test_surface_wire_fail_closed_witness() -> u64      0 = pass, 1 = fail
  // ==========================================================================

  pub let test_surface_wire_fail_closed_witness : () -> u64 !{sysreg} @{cap} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "PU-DT-05: call the mirrored gate with cap_slot=0 (unmapped) and assert it returns SURFACE_GATE_REFUSED (0xFFFFE190, == the real SURFACE_WIRE_REFUSED) rather than SURFACE_WIRE_OK or anything else -- the fail-closed contract. Labels prefixed tswfc_.",
      block: {
        mov rdi, 0;
        call tsw_desktop_surface_gate_mirror;
        mov r10, 0xFFFFE190;
        cmp rax, r10;
        jne tswfc_fail;
        xor rax, rax;
        ret;
      tswfc_fail:
        mov rax, 1;
        ret
      }
    }
}
