// tests/kernel/audit/audit_schema_synth.pdx — R40.M5-001 (#1363)
//
// Boot witness for the R40.M5 audit-schema unification.  Exercises the
// canonical row shape's packers and validators against the failure
// taxonomy 0xFFFFF180..0xFFFFF18F, and drives audit_emit end-to-end
// through drv_audit_emit so a subscriber that decodes with the schema's
// unpackers reads back exactly the (actor, target, payload_lo) triple
// the emitter packed.
//
// Stages:
//   (1) aud_ev_valid: recognises 1..12; refuses 0 / 13.
//   (2) aud_ev_is_cap: 1/2 -> 1; 3..12 -> 0.
//   (3) aud_field_valid: 0..8 -> 1; 9 -> 0.
//   (4) aud_kind_valid: 0 -> 1; 0x13F -> 0; 0x140 -> 1; 0x197 -> 1; 0x198 -> 0.
//   (upper bound bumped through R47/G2/G3/G4/G5/G6/R48b/R30-PREP; see
//    core/audit/audit_schema.pdx aud_kind_valid comment.)
//   (5) aud_pack_at + unpack round-trip for (0x1234, 0x5678) and the
//       boundary case (0xFFFF, 0xFFFF).
//   (6) aud_pack_payload + aud_unpack_payload_lo for 0x12345678.
//   (7) aud_pack_principal + aud_prin_{actor,target,payload_lo} round
//       trip: (at=(0xAAAA<<16)|0xBBBB, payload_lo=0xCCCCDDDD) ->
//       principal must decode to actor=0xAAAA, target=0xBBBB,
//       payload_lo=0xCCCCDDDD.
//   (8) audit_emit end-to-end: takes a live drv_audit_seq snapshot,
//       emits one canonical MINT record, reads the seq back and asserts
//       it advanced by 1 -- proves the wire from the schema wrapper to
//       the underlying ring.
//   (9) audit_emit refusal: evt=0 -> AUD_ERR_BAD_EVT; drv_audit_seq
//       MUST NOT have advanced (refusal never records).
//   (10) audit_emit refusal: kind=0x13F -> AUD_ERR_BAD_KIND; seq stable.
//   (11) audit_emit refusal: payload_lo=0x100000000 -> AUD_ERR_BAD_PAYLOAD;
//        seq stable.
//   (12) principal-decode composition: read back the record from stage 8
//        through drv_audit_field(field=4, back=0) and decode with
//        aud_prin_actor/target/payload_lo to assert the schema round-trip
//        went through the actual ring rather than a private cache.
//
// Fingerprint: R40 AUDIT SCHEMA OK
//
// Failure fingerprint: R40 AUDIT SCHEMA FAIL, followed by the stage
// number for diagnosis.

module AuditSchemaSynth = structure {

  pub let mut _audw_stage : u64 = 0

  pub let audw_ok   : [u8; 17] = "AUDIT SCHEMA OK\n\0"
  pub let audw_fail : [u8; 19] = "AUDIT SCHEMA FAIL\n\0"

  pub let audit_schema_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R40.M5-001 (#1363): boot witness for the audit-schema unification. Exercises validators, packers, unpackers, and audit_emit end-to-end against a live drv_audit_seq snapshot. Failure records the stage number rather than a code so a broken validator and a broken packer are distinguishable in the boot log. rbx = drv_audit_seq snapshot; r12/r13 unused. Five callee-save pushes (rbx, r12-r15) put rsp%16 == 0 at every nested call (entry rsp%16 == 8; five pushes -> 0), which SysV requires. Labels prefixed audw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. aud_ev_valid.
        mov rax, 1;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call aud_ev_valid;
        cmp rax, 0;
        jne audw_fail_stage;

        mov rdi, 1;
        call aud_ev_valid;
        cmp rax, 1;
        jne audw_fail_stage;

        mov rdi, 12;
        call aud_ev_valid;
        cmp rax, 1;
        jne audw_fail_stage;

        mov rdi, 13;
        call aud_ev_valid;
        cmp rax, 0;
        jne audw_fail_stage;

        // -- 2. aud_ev_is_cap.
        mov rax, 2;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call aud_ev_is_cap;
        cmp rax, 1;
        jne audw_fail_stage;

        mov rdi, 2;
        call aud_ev_is_cap;
        cmp rax, 1;
        jne audw_fail_stage;

        mov rdi, 3;
        call aud_ev_is_cap;
        cmp rax, 0;
        jne audw_fail_stage;

        mov rdi, 12;
        call aud_ev_is_cap;
        cmp rax, 0;
        jne audw_fail_stage;

        // -- 3. aud_field_valid.
        mov rax, 3;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call aud_field_valid;
        cmp rax, 1;
        jne audw_fail_stage;

        mov rdi, 8;
        call aud_field_valid;
        cmp rax, 1;
        jne audw_fail_stage;

        mov rdi, 9;
        call aud_field_valid;
        cmp rax, 0;
        jne audw_fail_stage;

        // -- 4. aud_kind_valid.
        mov rax, 4;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call aud_kind_valid;
        cmp rax, 1;
        jne audw_fail_stage;

        mov rdi, 0x13F;
        call aud_kind_valid;
        cmp rax, 0;
        jne audw_fail_stage;

        mov rdi, 0x140;
        call aud_kind_valid;
        cmp rax, 1;
        jne audw_fail_stage;

        mov rdi, 0x197;                  // upper bound (R30-PREP #1631)
        call aud_kind_valid;
        cmp rax, 1;
        jne audw_fail_stage;

        mov rdi, 0x198;                  // one past upper bound
        call aud_kind_valid;
        cmp rax, 0;
        jne audw_fail_stage;

        // -- 5. aud_pack_at + unpack.
        mov rax, 5;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234;
        mov rsi, 0x5678;
        call aud_pack_at;
        mov r15, rax;
        mov r11, 0x12345678;
        cmp rax, r11;
        jne audw_fail_stage;

        mov rdi, r15;
        call aud_unpack_actor;
        mov r11, 0x1234;
        cmp rax, r11;
        jne audw_fail_stage;

        mov rdi, r15;
        call aud_unpack_target;
        mov r11, 0x5678;
        cmp rax, r11;
        jne audw_fail_stage;

        // Boundary (0xFFFF, 0xFFFF).
        mov rdi, 0xFFFF;
        mov rsi, 0xFFFF;
        call aud_pack_at;
        mov r15, rax;
        mov r11, 0xFFFFFFFF;
        cmp rax, r11;
        jne audw_fail_stage;

        mov rdi, r15;
        call aud_unpack_actor;
        mov r11, 0xFFFF;
        cmp rax, r11;
        jne audw_fail_stage;

        // -- 6. aud_pack_payload + unpack.
        mov rax, 6;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        mov rdi, 0x12345678;
        mov rsi, 0;
        call aud_pack_payload;
        mov r15, rax;
        mov r11, 0x12345678;
        cmp rax, r11;
        jne audw_fail_stage;

        mov rdi, r15;
        call aud_unpack_payload_lo;
        mov r11, 0x12345678;
        cmp rax, r11;
        jne audw_fail_stage;

        // -- 7. aud_pack_principal round trip.
        mov rax, 7;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        // at = (0xAAAA << 16) | 0xBBBB = 0xAAAABBBB
        mov rdi, 0xAAAA;
        mov rsi, 0xBBBB;
        call aud_pack_at;
        mov r14, rax;                        // at

        mov rdi, r14;
        mov rsi, 0xCCCCDDDD;
        call aud_pack_principal;
        mov r15, rax;                        // principal
        // Expected principal = (0xAAAABBBB << 32) | 0xCCCCDDDD
        //                    = 0xAAAABBBBCCCCDDDD
        mov r11, 0xAAAABBBBCCCCDDDD;
        cmp rax, r11;
        jne audw_fail_stage;

        mov rdi, r15;
        call aud_prin_actor;
        mov r11, 0xAAAA;
        cmp rax, r11;
        jne audw_fail_stage;

        mov rdi, r15;
        call aud_prin_target;
        mov r11, 0xBBBB;
        cmp rax, r11;
        jne audw_fail_stage;

        mov rdi, r15;
        call aud_prin_payload_lo;
        mov r11, 0xCCCCDDDD;
        cmp rax, r11;
        jne audw_fail_stage;

        // -- 8. audit_emit end-to-end (canonical MINT).
        mov rax, 8;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        call drv_audit_seq;
        mov rbx, rax;                        // seq snapshot

        // aud_pack_at(0x11, 0x22) -> at
        mov rdi, 0x11;
        mov rsi, 0x22;
        call aud_pack_at;
        mov r14, rax;

        // audit_emit(kind=0x150, slot=99, evt=AUD_EV_MINT=1,
        //            at=r14, result=0, payload_lo=0x33)
        mov rdi, 0x150;
        mov rsi, 99;
        mov rdx, 1;
        mov rcx, r14;
        mov r8,  0;
        mov r9,  0x33;
        call audit_emit;
        cmp rax, 0;
        jne audw_fail_stage;

        call drv_audit_seq;
        mov r11, rbx;
        add r11, 1;
        cmp rax, r11;
        jne audw_fail_stage;

        // -- 9. audit_emit refuse evt=0 (BAD_EVT). Seq must NOT advance.
        mov rax, 9;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        call drv_audit_seq;
        mov rbx, rax;

        mov rdi, 0;                          // kind
        mov rsi, 0;                          // slot
        mov rdx, 0;                          // evt = 0 -> refused
        mov rcx, 0;                          // at
        mov r8,  0;                          // result
        mov r9,  0;                          // payload_lo
        call audit_emit;
        mov r11, 0xFFFFF18F;                 // AUD_ERR_BAD_EVT
        cmp rax, r11;
        jne audw_fail_stage;

        call drv_audit_seq;
        cmp rax, rbx;                        // must equal snapshot
        jne audw_fail_stage;

        // -- 10. audit_emit refuse kind=0x13F (BAD_KIND). Seq stable.
        mov rax, 10;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        call drv_audit_seq;
        mov rbx, rax;

        mov rdi, 0x13F;                      // just below derived-kind range
        mov rsi, 0;
        mov rdx, 1;                          // valid evt
        mov rcx, 0;
        mov r8,  0;
        mov r9,  0;
        call audit_emit;
        mov r11, 0xFFFFF18A;                 // AUD_ERR_BAD_KIND
        cmp rax, r11;
        jne audw_fail_stage;

        call drv_audit_seq;
        cmp rax, rbx;
        jne audw_fail_stage;

        // -- 11. audit_emit refuse payload_lo=0x100000000 (BAD_PAYLOAD).
        mov rax, 11;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        call drv_audit_seq;
        mov rbx, rax;

        mov rdi, 0x150;
        mov rsi, 0;
        mov rdx, 1;
        mov rcx, 0;
        mov r8,  0;
        mov r9,  0x100000000;                // 2^32 -- above 32-bit range
        call audit_emit;
        mov r11, 0xFFFFF18B;                 // AUD_ERR_BAD_PAYLOAD
        cmp rax, r11;
        jne audw_fail_stage;

        call drv_audit_seq;
        cmp rax, rbx;
        jne audw_fail_stage;

        // -- 12. Composition through the actual ring: emit one canonical
        //        record, then read field 4 (principal) back through
        //        drv_audit_field(field=4, back=0) and decode with the
        //        schema's unpackers.  Proves the wire is end-to-end.
        mov rax, 12;
        lea rcx, [rip + _audw_stage];
        mov [rcx], rax;

        mov rdi, 0x77;
        mov rsi, 0x88;
        call aud_pack_at;
        mov r14, rax;                        // at = 0x00770088

        mov rdi, 0x150;
        mov rsi, 42;
        mov rdx, 2;                          // AUD_EV_REVOKE
        mov rcx, r14;
        mov r8,  0;
        mov r9,  0xFEED;
        call audit_emit;
        cmp rax, 0;
        jne audw_fail_stage;

        // drv_audit_field(back=0, field=4=principal)
        mov rdi, 0;                          // back (newest record)
        mov rsi, 4;                          // field 4 = principal
        call drv_audit_field;
        mov r15, rax;                        // principal read from ring

        mov rdi, r15;
        call aud_prin_actor;
        mov r11, 0x77;
        cmp rax, r11;
        jne audw_fail_stage;

        mov rdi, r15;
        call aud_prin_target;
        mov r11, 0x88;
        cmp rax, r11;
        jne audw_fail_stage;

        mov rdi, r15;
        call aud_prin_payload_lo;
        mov r11, 0xFEED;
        cmp rax, r11;
        jne audw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + audw_ok];
        call klog_s1;

        xor rax, rax;
        jmp audw_out;

      audw_fail_stage:
        lea rax, [rip + _audw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + audw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      audw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
