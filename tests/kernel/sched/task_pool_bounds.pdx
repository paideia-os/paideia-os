// tests/kernel/sched/task_pool_bounds.pdx — R31.M2-1594 (#1594)
//
// Boot witness: the task pool contains every slab the pid ceiling can name.
//
// -----------------------------------------------------------------------------
// The defect this exists for
// -----------------------------------------------------------------------------
//
// `_task_pool` was declared `[u64; 17792]` — 142336 bytes, which is 64 * 2224,
// the STRUCT size. `task_new` strides 4096 per slot, the SLOT size. 142336 /
// 4096 = 34.75, so pid 35 was the last whose construction landed fully inside
// the array and every pid from 36 to 63 wrote a complete task_struct past its
// end, into `_task_kernel_stacks`. A task_struct aliased onto another task's
// kernel stack is not a corrupted buffer; it is two writers with different
// ideas about what the bytes mean, one of them a return-address chain.
//
// It survived ~53 iterations of witnesses because THE BOOT PATH USES FOUR PIDS.
// No test in the tree had ever asked for a thirty-sixth. That is the whole
// lesson: a bound that only the untravelled part of the range violates is
// invisible to every test that travels the ordinary part, so the witness has
// to DRIVE the range deliberately rather than observe boot doing it.
//
// -----------------------------------------------------------------------------
// Why the obvious witness proves nothing
// -----------------------------------------------------------------------------
//
// The natural fixture — seed a sentinel into `_pid_table` / `_pid_gen`,
// allocate past the boundary, assert the sentinel survives — PASSES ON THE
// BROKEN TREE. Those two arrays sit at pool_end + 0 and pool_end + 512, and
// the first overflowing slab (pid 36) starts at pool_end + 1024: the 2224-byte
// construction of pid 35 stops 848 bytes short of `_pid_table`, and pid 36
// begins 1024 bytes past where `_pid_gen` ends. The linker had laid both
// arrays inside slot 34's UNUSED PADDING, and nothing addresses a slab above
// +2224, so they were never touched. The structure that actually took the
// damage was the one after them.
//
// So the canary here is not aimed at a guessed neighbour. It is aimed at
// `_tpb_limit` — the LOWEST address, among the pid-indexed structures this
// kernel has, that lies above the pool base. Whatever the linker put next is
// what gets watched, and sub-test C compares the pool's addressed extent
// against that measured address rather than against a number from the source.
// That is the check that would have caught #1594 on the day it was written:
// it needs no knowledge of what 17792 was supposed to mean.
//
// -----------------------------------------------------------------------------
// Sub-tests
// -----------------------------------------------------------------------------
//
//   A  REFUSALS. task_slab_of_pid answers 0 for pid 0, for MAX_PIDS, for
//      MAX_PIDS+1 and for a huge pid. pid 0 matters on its own: it is the
//      reserved sentinel, and (0-1) << 12 is 0xFFFFFFFFFFFFF000, which lands
//      the slab one slot BELOW the pool base — a `jae MAX_PIDS` bound alone
//      does not stop it.
//
//   B  SHAPE. For every pid in [1, PID_MAX] the answer is base + (pid-1)*4096:
//      dense, contiguous, starting at the base. This is a tautology against
//      the same formula and is not the detector; it is here so that C's
//      containment argument — "checking the highest slab checks all of them"
//      — is asserted rather than assumed.
//
//   C  HEADROOM. slab(PID_MAX) + TASK_STRUCT_BYTES <= _tpb_limit. THE
//      DETECTOR. On the broken tree: 253952 + 2224 = 256176 against a limit of
//      142336. It fails by 113840 bytes and names both numbers.
//
//   D  SWEEP. For every FREE pid in [1, PID_MAX] — which on the broken tree
//      means every pid from 36 up — write a recognisable pattern across the
//      full task_struct footprint, check the canary, zero it again, check the
//      canary again. This is the empirical half: it drives the writes that the
//      arithmetic in C only reasons about.
//
//      Each pid is containment-checked against _tpb_limit BEFORE its write.
//      That is deliberate and is not a weakening: on a healthy tree all 63
//      writes happen and the property is genuinely exercised, and on a broken
//      one the fixture reports the first pid that would leave the pool instead
//      of scribbling 110 KiB across the kernel stacks to prove a point C has
//      already proved. A witness that damages the machine to demonstrate
//      damage has stopped being a diagnostic.
//
//   E  THE REAL CONSTRUCTOR, AT THE TOP OF THE RANGE. A and B ask
//      task_slab_of_pid; D writes through its answer. Neither runs `task_new`,
//      and task_new is where the bug lived. E forces the pid table full up to
//      PID_MAX-1, calls task_new for real, and asserts the construction landed
//      in the pool at the address task_slab_of_pid names, with pid, kernel-
//      stack top and generation all stamped — then frees it and puts the table
//      back exactly as it found it. This is the "allocate past slot 35, up to
//      the ceiling" the issue asks for, through the shipping path.
//
// -----------------------------------------------------------------------------
// Interference
// -----------------------------------------------------------------------------
//
// The fixture is called from kernel_main between the task_free witness and the
// task_new witness, where the pid table is provably empty: the task_free
// witness has just completed 100 task_new/task_free round trips and asserted
// that _pid_table[1] came back to 0 and that the physical free count returned
// to its snapshot. D skips any pid whose _pid_table entry is non-zero and E
// only forces entries that are already zero, restoring exactly those, so the
// fixture is correct even if that placement changes and a task is live.
//
// E leaves _pid_gen[PID_MAX] at 1 rather than 0. That is a real allocation
// that really happened, and no consumer treats a bumped generation for a dead
// pid as anything but stale — see task_pool.pdx §_pid_gen. death_witness uses
// pid 40 and is unaffected.

module TaskPoolBounds = structure {

  // ==========================================================================
  // Geometry the fixture asserts against.
  //
  // These are deliberately RESTATED here rather than read from TaskPool.
  // paideia-as has no constant folding across modules, so an assembly witness
  // must embed its immediates either way; restating them next to a comment
  // that says where the source lives is honest about that. The build gate
  // (tools/verify-task-pool-bounds.sh) pins the TaskPool side; a divergence
  // between the two is caught by sub-tests A and B, which compare answers
  // rather than literals.
  // ==========================================================================

  pub let TPB_MAX_PIDS      : u64 = 64      // TaskPool.MAX_PIDS
  pub let TPB_PID_MAX       : u64 = 63      // TaskPool.PID_MAX
  pub let TPB_SLOT_BYTES    : u64 = 4096    // TaskPool.TASK_SLOT_BYTES
  pub let TPB_STRUCT_QWORDS : u64 = 278     // TaskPool.TASK_STRUCT_QWORDS
  pub let TPB_STRUCT_BYTES  : u64 = 2224    // TaskPool.TASK_STRUCT_BYTES
  pub let TPB_CANARY_QWORDS : u64 = 512     // 4 KiB of watched neighbour

  // Stage breadcrumb, reported on failure so the log names the sub-test.
  pub let mut _tpb_stage  : u64 = 0

  // The measured neighbour: lowest address above &_task_pool among the
  // pid-indexed structures. Computed, never assumed.
  pub let mut _tpb_limit  : u64 = 0

  // Snapshot of [_tpb_limit, _tpb_limit + 4096).
  pub let mut _tpb_canary : [u64; 512] = uninit @align(8)

  // Which _pid_table entries sub-test E forced, so it can restore exactly
  // those and no others.
  pub let mut _tpb_forced : [u64; 64] = uninit @align(8)

  // ==========================================================================
  // tpb_consider(best, cand) -> u64
  //
  // Fold one candidate neighbour into the running minimum-above-base.
  // Answers `best` unchanged if `cand` is at or below the pool base (it is
  // not a neighbour ABOVE the pool) or is no closer than the incumbent.
  // A best of 0 means "nothing seen yet" and any candidate above base wins.
  // ==========================================================================
  pub let tpb_consider : (u64, u64) -> u64 !{} @{} =
    fn (best: u64, cand: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R31.M2-1594 (#1594): running minimum of the .bss objects lying above &_task_pool, used to MEASURE the pool's available extent rather than take it from the source literal that was wrong. rdi = incumbent (0 = none yet), rsi = candidate. Answers the incumbent unless the candidate is strictly above the pool base AND strictly below the incumbent. Unsigned comparisons throughout (jbe/jae) because these are kernel-half virtual addresses with bit 63 set — a signed compare would order them backwards and silently pick the wrong neighbour, which is the one way this helper could fail quietly. Pure arithmetic on link-time addresses: no effects, no capabilities, leaf, rax the only register written.",
      block: {
        lea rax, [rip + _task_pool];
        cmp rsi, rax;
        jbe tpb_consider_keep;               // candidate not above the base
        cmp rdi, 0;
        je tpb_consider_take;                // no incumbent yet
        cmp rsi, rdi;
        jae tpb_consider_keep;               // incumbent is closer
      tpb_consider_take:
        mov rax, rsi;
        ret;
      tpb_consider_keep:
        mov rax, rdi;
        ret
      }
    } @no_frame

  // ==========================================================================
  // tpb_limit_compute() -> u64
  //
  // The lowest address above &_task_pool among every pid-indexed structure
  // this kernel has, plus the two standalone TCB slabs that neighbour them.
  // Answers 0 if none of them is above the pool, which sub-test C treats as a
  // failure rather than as "unbounded" — a measurement that measured nothing
  // must not read as headroom.
  // ==========================================================================
  pub let tpb_limit_compute : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R31.M2-1594 (#1594): measure the pool's usable extent from the LINKED IMAGE instead of from a source literal. Folds six .bss objects through tpb_consider and publishes the winner in _tpb_limit. The set is the three pid-indexed arrays (_pid_table, _pid_gen, _task_kernel_stacks), the parallel per-pid XSAVE storage (_task_xsave_areas), and two standalone task slabs (_idle_task_slot, _sched_witness_boot_tcb) — chosen because these are the objects a pool overflow would reach FIRST and because each is a structure whose corruption is silent. It is not a claim that nothing else is nearby: an object outside the set that the pool overran would be missed, which is why sub-test C's arithmetic and the build gate exist alongside this. One push (rbx) holds the incumbent across the six nested calls and keeps rsp %16 == 0 at each. tpb_consider is a @no_frame leaf that writes only rax.",
      block: {
        push rbx;
        push r12;

        xor rbx, rbx;                        // incumbent = none

        mov rdi, rbx;
        lea rsi, [rip + _pid_table];
        call tpb_consider;
        mov rbx, rax;

        mov rdi, rbx;
        lea rsi, [rip + _pid_gen];
        call tpb_consider;
        mov rbx, rax;

        mov rdi, rbx;
        lea rsi, [rip + _task_kernel_stacks];
        call tpb_consider;
        mov rbx, rax;

        mov rdi, rbx;
        lea rsi, [rip + _task_xsave_areas];
        call tpb_consider;
        mov rbx, rax;

        mov rdi, rbx;
        lea rsi, [rip + _idle_task_slot];
        call tpb_consider;
        mov rbx, rax;

        mov rdi, rbx;
        lea rsi, [rip + _sched_witness_boot_tcb];
        call tpb_consider;
        mov rbx, rax;

        lea rcx, [rip + _tpb_limit];
        mov [rcx], rbx;
        mov rax, rbx;

        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // tpb_canary_snapshot() -> ()
  //
  // Copy 4 KiB from the measured neighbour into private storage. No-op if the
  // limit is 0 — sub-test C has already failed in that case.
  // ==========================================================================
  pub let tpb_canary_snapshot : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R31.M2-1594 (#1594): snapshot [_tpb_limit, _tpb_limit + 4096) into _tpb_canary. READ-ONLY with respect to the watched region: the fixture never seeds a sentinel into a live structure, because _pid_table and _pid_gen carry real allocator state at every point this fixture can run and a fixture that overwrote them to prove they were not overwritten would be the same class of bug it is testing for. The live content IS the canary, and 4096 bytes is chosen to span the first slot's worth of overflow — the first out-of-pool slab starts within one slot of the pool end by construction. rcx = qword index, rax = source base, rdx = destination base, r8 = transfer scratch. Leaf, no nested calls. Answers 0 always.",
      block: {
        lea rax, [rip + _tpb_limit];
        mov rax, [rax];
        cmp rax, 0;
        je tpb_snap_done;
        lea rdx, [rip + _tpb_canary];
        xor rcx, rcx;
      tpb_snap_loop:
        cmp rcx, 512;                        // TPB_CANARY_QWORDS
        jae tpb_snap_done;
        mov r8, [rax + rcx*8];
        mov [rdx + rcx*8], r8;
        add rcx, 1;
        jmp tpb_snap_loop;
      tpb_snap_done:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // tpb_canary_check_x(exempt_a, exempt_b) -> u64    0 = intact, 1 = disturbed
  //
  // The two exemptions are ADDRESSES, not indices, and exist for exactly one
  // caller: sub-test E, which runs the real `task_new`. The watched region
  // begins at the first structure above the pool, and on this image that
  // structure is `_pid_table` — so a genuine allocation legitimately writes
  // two qwords inside the canary (`_pid_table[pid]` and `_pid_gen[pid]`).
  //
  // Naming those two by address rather than widening the window or moving it
  // above the tables is deliberate: they are the exact writes task_new is
  // DOCUMENTED to make, every other byte of the region stays under
  // observation, and both exempted qwords are separately asserted by E
  // (the table entry must come back to 0 after task_free, the generation must
  // be non-zero). An exemption that is checked elsewhere is a narrowing; one
  // that is checked nowhere is a hole.
  //
  // Passing 0 for either exempts nothing: no qword lives at address 0.
  // ==========================================================================
  pub let tpb_canary_check_x : (u64, u64) -> u64 !{mem} @{} =
    fn (exempt_a: u64, exempt_b: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R31.M2-1594 (#1594): compare the watched region against the snapshot taken by tpb_canary_snapshot, skipping at most two named addresses. Answers 1 on the first differing non-exempt qword and 0 if all 512 agree. A limit of 0 answers 1 — 'nothing was watched' must not be reported as 'nothing was disturbed', which is precisely the vacuous-pass shape that let #1594 survive 53 iterations. The exemptions are compared as ADDRESSES against rax + rcx*8, so they are correct whatever the link order does to the region's start; 0 exempts nothing because no qword lives there. rcx = index, rax/rdx = bases, r8/r9 = compared qwords, r10 = current address. Leaf, no nested calls.",
      block: {
        lea rax, [rip + _tpb_limit];
        mov rax, [rax];
        cmp rax, 0;
        je tpb_check_bad;                    // nothing watched != nothing hit
        lea rdx, [rip + _tpb_canary];
        xor rcx, rcx;
      tpb_check_loop:
        cmp rcx, 512;                        // TPB_CANARY_QWORDS
        jae tpb_check_good;
        mov r10, rcx;
        shl r10, 3;
        add r10, rax;                        // r10 = &watched[rcx]
        cmp r10, rdi;
        je tpb_check_next;
        cmp r10, rsi;
        je tpb_check_next;
        mov r8, [rax + rcx*8];
        mov r9, [rdx + rcx*8];
        cmp r8, r9;
        jne tpb_check_bad;
      tpb_check_next:
        add rcx, 1;
        jmp tpb_check_loop;
      tpb_check_good:
        xor rax, rax;
        ret;
      tpb_check_bad:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // tpb_canary_check() -> u64        0 = intact, 1 = disturbed
  //
  // The unexempted form: nothing in the watched region may move at all.
  // ==========================================================================
  pub let tpb_canary_check : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R31.M2-1594 (#1594): tpb_canary_check_x with no exemptions — every qword of the watched region must be unchanged. Used by sub-test D, which writes only through slab addresses and therefore has no licence to move anything outside the pool. One-line forwarder; rdi/rsi are caller-save and set to 0 before the tail call.",
      block: {
        xor rdi, rdi;
        xor rsi, rsi;
        call tpb_canary_check_x;
        ret
      }
    }

  // ==========================================================================
  // tpb_restore() -> ()
  //
  // Undo sub-test E's forced _pid_table entries — exactly those, and only
  // those. Called from both exits.
  // ==========================================================================
  pub let tpb_restore : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R31.M2-1594 (#1594): release only the _pid_table entries this fixture forced. _tpb_forced[p] is non-zero exactly for the p that sub-test E filled, which are exactly the p that were free when it ran, so a task that was live before the fixture is never freed by it. Called from BOTH exits of the witness so a failed assertion cannot leave the allocator with 62 phantom occupants — which would make every subsequent task_new in the boot path allocate the wrong pid and would break the shell fingerprints in a way whose cause is nowhere near its symptom. rcx = index, rax/rdx = table bases, r8 = scratch. Leaf, no nested calls.",
      block: {
        lea rax, [rip + _tpb_forced];
        lea rdx, [rip + _pid_table];
        mov rcx, 1;
      tpb_restore_loop:
        cmp rcx, 64;                         // TPB_MAX_PIDS
        jae tpb_restore_done;
        mov r8, [rax + rcx*8];
        cmp r8, 0;
        je tpb_restore_next;
        mov r9, 0;
        mov [rdx + rcx*8], r9;               // release the forced entry
        mov [rax + rcx*8], r9;               // and forget we forced it
      tpb_restore_next:
        add rcx, 1;
        jmp tpb_restore_loop;
      tpb_restore_done:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // task_pool_bounds_witness() -> u64        0 = pass, 1 = fail
  // ==========================================================================
  pub let task_pool_bounds_witness : () -> u64 !{sysreg, mem} @{boot, fs} =
    fn () -> unsafe {
      effects: {sysreg, mem},
      capabilities: {boot, fs},
      justification: "R31.M2-1594 (#1594): boot witness that _task_pool contains every slab the pid ceiling can name. Five sub-tests, A..E, described in the file header. The load-bearing one is C, which compares the pool's addressed extent against a MEASURED neighbour address rather than against any number in the source — on the broken tree it reports 256176 against 142336. D drives the writes C reasons about, containment-checked per pid so a broken tree is diagnosed rather than damaged. E runs the shipping constructor at PID_MAX, which is the only sub-test that exercises task_new itself, and is the reason the fixture needs {fs} (task_free's capability) and {sysreg} (klog's effect). Five pushes (rbx/r12/r13/r14/r15) keep rsp %16 == 0 across every nested call; r12 = pid loop variable, r13 = slab under test, r14 = &_task_pool, r15 = comparison scratch, rbx = saved limit. Failure reports the stage breadcrumb via klog_s1_d1 and RETURNS rather than halting, matching every other witness in the tree: detection is the absence of the OK line from the golden-ordered log, and a fixture that halted would hide every later assertion. Both exits call tpb_restore, because leaving 62 phantom _pid_table occupants behind would misdirect every subsequent task_new in the boot path. Labels prefixed tpb_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        lea r14, [rip + _task_pool];         // r14 = pool base, held throughout

        // ================================================================
        // A. Refusals. Out-of-range pids get no address at all.
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        mov rdi, 0;                          // reserved sentinel
        call task_slab_of_pid;
        cmp rax, 0;
        jne tpb_w_fail;

        mov rdi, 64;                         // TPB_MAX_PIDS — one past the table
        call task_slab_of_pid;
        cmp rax, 0;
        jne tpb_w_fail;

        mov rdi, 65;
        call task_slab_of_pid;
        cmp rax, 0;
        jne tpb_w_fail;

        mov rdi, 0xFFFFFFFFFFFFFFFF;
        call task_slab_of_pid;
        cmp rax, 0;
        jne tpb_w_fail;

        // ================================================================
        // B. Shape. slab(pid) == base + (pid-1)*TPB_SLOT_BYTES, densely,
        //    for every allocatable pid.
        // ================================================================
        mov rax, 2;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        mov r12, 1;
      tpb_w_shape_loop:
        cmp r12, 64;                         // TPB_MAX_PIDS
        jae tpb_w_shape_done;

        mov rdi, r12;
        call task_slab_of_pid;
        cmp rax, 0;
        je tpb_w_fail;                       // an allocatable pid must have a slab
        mov r13, rax;

        mov rcx, r12;
        sub rcx, 1;
        shl rcx, 12;                         // TPB_SLOT_BYTES
        mov r15, r14;
        add r15, rcx;
        cmp r13, r15;
        jne tpb_w_fail;

        add r12, 1;
        jmp tpb_w_shape_loop;
      tpb_w_shape_done:

        // ================================================================
        // C. Headroom — THE DETECTOR.
        //
        //    slab(PID_MAX) + TASK_STRUCT_BYTES must not reach the nearest
        //    structure above the pool. Measured, not declared.
        // ================================================================
        mov rax, 3;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        call tpb_limit_compute;              // publishes _tpb_limit
        cmp rax, 0;
        je tpb_w_fail;                       // measured nothing: not headroom
        mov rbx, rax;                        // rbx = limit

        mov rdi, 63;                         // TPB_PID_MAX
        call task_slab_of_pid;
        cmp rax, 0;
        je tpb_w_fail;
        add rax, 2224;                       // TPB_STRUCT_BYTES
        cmp rax, rbx;
        ja tpb_w_fail;                       // highest slab overruns the pool

        // ================================================================
        // D. Sweep. Write the full task_struct footprint through every free
        //    slab up to the ceiling, checking the watched region after each.
        // ================================================================
        mov rax, 4;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        call tpb_canary_snapshot;

        mov r12, 1;
      tpb_w_sweep_loop:
        cmp r12, 64;                         // TPB_MAX_PIDS
        jae tpb_w_sweep_done;

        // Skip pids that currently host a task. The fixture must be correct
        // wherever it is called from, not only where it is called from now.
        lea rax, [rip + _pid_table];
        mov rcx, [rax + r12*8];
        cmp rcx, 0;
        jne tpb_w_sweep_next;

        mov rdi, r12;
        call task_slab_of_pid;
        cmp rax, 0;
        je tpb_w_fail;
        mov r13, rax;

        // Per-pid containment BEFORE the write: diagnose, do not damage.
        mov rax, r13;
        add rax, 2224;                       // TPB_STRUCT_BYTES
        cmp rax, rbx;
        ja tpb_w_fail;

        // Pattern across the full footprint.
        mov rdi, r13;
        mov rcx, 278;                        // TPB_STRUCT_QWORDS
        mov rax, 0xA5A5A5A5A5A5A5A5;
        rep_stosq;

        call tpb_canary_check;
        cmp rax, 0;
        jne tpb_w_fail;

        // Back to the .bss-zero state task_free leaves behind.
        mov rdi, r13;
        mov rcx, 278;                        // TPB_STRUCT_QWORDS
        xor rax, rax;
        rep_stosq;

        call tpb_canary_check;
        cmp rax, 0;
        jne tpb_w_fail;

      tpb_w_sweep_next:
        add r12, 1;
        jmp tpb_w_sweep_loop;
      tpb_w_sweep_done:

        // ================================================================
        // E. The shipping constructor, at the top of the range.
        //
        //    Force every free pid below PID_MAX to look occupied so
        //    pid_alloc's dense-low-first scan has to reach PID_MAX, then
        //    build a real task there.
        // ================================================================
        mov rax, 5;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        mov r12, 1;
      tpb_w_fill_loop:
        cmp r12, 63;                         // TPB_PID_MAX — leave it free
        jae tpb_w_fill_done;

        lea rax, [rip + _pid_table];
        mov rcx, [rax + r12*8];
        cmp rcx, 0;
        jne tpb_w_fill_next;                 // already live: leave it alone

        mov r15, 1;                          // placeholder occupant
        mov [rax + r12*8], r15;
        lea rax, [rip + _tpb_forced];
        mov [rax + r12*8], r15;

      tpb_w_fill_next:
        add r12, 1;
        jmp tpb_w_fill_loop;
      tpb_w_fill_done:

        // Re-baseline the canary. The fill above wrote 62 entries of
        // _pid_table, which lives INSIDE the watched region on this image —
        // that is the fixture's own deliberate mutation of allocator state,
        // not a finding. The property E is about is what task_new does from
        // here, so the baseline is taken from here.
        call tpb_canary_snapshot;

        mov rax, 6;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        xor rdi, rdi;                        // parent = NULL
        call task_new;
        cmp rax, 0;
        je tpb_w_fail;                       // the ceiling pid must be buildable
        mov r13, rax;

        // The task landed where task_slab_of_pid says it should.
        mov rax, 7;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        mov rdi, 63;                         // TPB_PID_MAX
        call task_slab_of_pid;
        cmp rax, r13;
        jne tpb_w_fail;

        // ... and it is inside the pool, by the same measured bound as C.
        mov rax, 8;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        mov rax, r13;
        add rax, 2224;                       // TPB_STRUCT_BYTES
        cmp rax, rbx;
        ja tpb_w_fail;

        // pid stamped.
        mov rax, 9;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        mov eax, [r13 + 0];                  // TASK_OFF_PID
        cmp eax, 63;
        jne tpb_w_fail;

        // Per-task kernel stack top stamped: base + pid * KSTACK_BYTES.
        mov rax, 10;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        mov rax, [r13 + 24];                 // TASK_OFF_KSTACK_TOP
        lea rcx, [rip + _task_kernel_stacks];
        mov r15, 63;
        shl r15, 14;                         // * 16384
        add rcx, r15;
        cmp rax, rcx;
        jne tpb_w_fail;

        // Incarnation stamped — never zero for a live task.
        mov rax, 11;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        mov rdi, 63;
        call pid_gen_read;
        cmp rax, 0;
        je tpb_w_fail;

        // Nothing outside the pool moved while a REAL task was constructed,
        // except the two allocator qwords task_new is documented to write —
        // _pid_table[63] and _pid_gen[63] — which live inside the watched
        // region on this image and are each asserted separately.
        mov rax, 12;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        lea rdi, [rip + _pid_table];
        add rdi, 504;                        // &_pid_table[63]
        lea rsi, [rip + _pid_gen];
        add rsi, 504;                        // &_pid_gen[63]
        call tpb_canary_check_x;
        cmp rax, 0;
        jne tpb_w_fail;

        mov rax, 13;
        lea rcx, [rip + _tpb_stage];
        mov [rcx], rax;

        mov rdi, r13;
        call task_free;

        // The slot came back.
        lea rax, [rip + _pid_table];
        mov rcx, [rax + 504];                // _pid_table[63]
        cmp rcx, 0;
        jne tpb_w_fail;

        call tpb_restore;

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + task_pool_bounds_ok_msg];
        call klog_s1;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      tpb_w_fail:
        call tpb_restore;

        lea rax, [rip + _tpb_stage];
        mov r8, [rax];
        mov rdi, 1;                          // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + task_pool_bounds_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
