// tests/kernel/ipc/vmd_config_channel_synth.pdx — R47.M2-001 (#1415)
//
// Boot witness for the VMD config-channel schema.  Opens a session,
// steps it through READ / WRITE / CLOSE, and asserts state + seq.
//
// Fingerprint: R47 VMD CONFIG CHAN OK

module VmdConfigChannelSynth = structure {

  pub let mut _vccw_stage : u64 = 0

  pub let vccw_ok   : [u8; 24] = "R47 VMD CONFIG CHAN OK\n\0"
  pub let vccw_fail : [u8; 26] = "R47 VMD CONFIG CHAN FAIL\n\0"

  pub let vmd_config_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R47.M2-001 (#1415): boot witness.",
      block: {
        push rbx;

        mov rax, 1;
        lea rcx, [rip + _vccw_stage];
        mov [rcx], rax;

        call vmd_config_channel_reset;

        // -- 2. Open session for endpoint_slot 241.
        mov rax, 2;
        lea rcx, [rip + _vccw_stage];
        mov [rcx], rax;
        mov rdi, 241;
        call vcc_open;
        cmp rax, 0;                      // first session id = 0
        jne vccw_fail_stage;

        // -- 3. State == OPEN (1).
        mov rax, 3;
        lea rcx, [rip + _vccw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vcc_row_state;
        cmp rax, 1;
        jne vccw_fail_stage;

        // -- 4. Step READ + WRITE.
        mov rax, 4;
        lea rcx, [rip + _vccw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0xB1;                   // READ
        call vcc_step;
        cmp rax, 0;
        jne vccw_fail_stage;
        mov rdi, 0;
        mov rsi, 0xB2;                   // WRITE
        call vcc_step;
        cmp rax, 0;
        jne vccw_fail_stage;

        // -- 5. seq == 2.
        mov rax, 5;
        lea rcx, [rip + _vccw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vcc_row_seq;
        cmp rax, 2;
        jne vccw_fail_stage;

        // -- 6. Step CLOSE.
        mov rax, 6;
        lea rcx, [rip + _vccw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0xB3;
        call vcc_step;
        cmp rax, 0;
        jne vccw_fail_stage;

        // -- 7. State == CLOSED (2).
        mov rax, 7;
        lea rcx, [rip + _vccw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vcc_row_state;
        cmp rax, 2;
        jne vccw_fail_stage;

        // -- 8. NOT_OPEN on stepping a closed session.
        mov rax, 8;
        lea rcx, [rip + _vccw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0xB1;
        call vcc_step;
        mov r11, 0xFFFFFD7B;
        cmp rax, r11;
        jne vccw_fail_stage;

        // -- 9. BAD_VERB.
        mov rax, 9;
        lea rcx, [rip + _vccw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0xC0;                   // out of range
        call vcc_step;
        mov r11, 0xFFFFFD7E;
        cmp rax, r11;
        jne vccw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vccw_ok];
        call klog_s1;
        call vmd_config_channel_reset;
        xor rax, rax;
        jmp vccw_out;

      vccw_fail_stage:
        lea rax, [rip + _vccw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vccw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_config_channel_reset;
        mov rax, 1;

      vccw_out:
        pop rbx;
        ret
      }
    }
}
