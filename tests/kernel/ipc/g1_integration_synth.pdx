// tests/kernel/ipc/g1_integration_synth.pdx -- G1.M3-001..006 (#1437-#1442)
//
// Combined witness for the G1.M3 cross-engine and integration
// checks:
//
//   G1.M3-001 (#1437): cross-engine wait: GPU timeline (R37) ->
//     display timeline. Exercised as a schema-only present_flush
//     that carries a value from a hypothetical GPU submit; the
//     real cross-engine wiring lands in G3 (compositor).
//
//   G1.M3-002 (#1438): reverse cross-engine wait. Same shape.
//
//   G1.M3-003 (#1439): u64 wrap discipline. Already exercised in
//     timeline_synth.pdx stages 8-10; re-checks the boundary here
//     for redundancy.
//
//   G1.M3-004 (#1440): explicit-sync + present-flush integration.
//     End-to-end: seed a timeline, flush with value N, wait for N,
//     assert reached.
//
//   G1.M3-005 (#1441): P1 acceptance. Verifies the structural
//     absence of implicit-sync symbols in this kernel: dpt_row_
//     signal exists; no implicit "commit_frame_no_sync" or
//     "present_now_implicit" symbol exists. The absence check is
//     enforced by tools/verify-implicit-sync-forbidden.sh at build
//     time; here we assert the positive symbol exists.
//
//   G1.M3-006 (#1442): HW-smoke placeholder. Real T14 wiring; the
//     dormant witness records the intent.
//
// Fingerprint: G1 INTEGRATION OK

module G1IntegrationSynth = structure {

  pub let mut _g1iw_stage : u64 = 0

  pub let g1iw_ok   : [u8; 19] = "G1 INTEGRATION OK\n\0"
  pub let g1iw_fail : [u8; 21] = "G1 INTEGRATION FAIL\n\0"

  pub let g1_integration_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G1.M3-001..006 (#1437-#1442): integrated witness. Stages: (1) reset. (2) Seed timeline (engine=2, output=1, key=0x2222). (3) M3-004 end-to-end: flush(row0->10), wait for 10 reaches immediately. (4) M3-001 cross-engine forward: emulate GPU-timeline-signal via dpt_row_signal(v=100), then a display wait for 100 reaches. (5) M3-002 reverse: signal a display frame at v=200, GPU-side observer (dpt_row_value) sees 200. (6) M3-003 wrap: dpy_timeline_reached(current=1, want=u64_max-3) reaches (near-wrap). (7) M3-005 P1: dpt_row_signal symbol exists (this call itself is the proof). (8) Cleanup.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _g1iw_stage];
        mov [rcx], rax;
        call dpt_table_reset;
        call dpy_timeline_stats_reset;

        // 2. Seed a timeline row.
        mov rax, 2;
        lea rcx, [rip + _g1iw_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 1;
        call dpt_body1_pack;
        mov rdi, 0;
        mov rsi, 0x2222;
        mov rdx, rax;
        xor rcx, rcx;
        call dpt_tail_alloc;
        cmp rax, 0;
        jne g1iw_fail_stage;

        // 3. M3-004: flush(row0, 10), then wait_le(row0, 10, 0)
        //    should return non-error (reached immediately because
        //    the flush advanced the value to 10).
        mov rax, 3;
        lea rcx, [rip + _g1iw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 10;
        call dpt_row_signal;
        cmp rax, 0;
        jne g1iw_fail_stage;
        mov rdi, 0;
        mov rsi, 10;
        mov rdx, 0;
        call dpy_timeline_wait_le;
        mov r10, 0xFFFFF68E;             // DPY_TL_TIMEOUT
        cmp rax, r10;
        je  g1iw_fail_stage;
        mov r10, 0xFFFFF68D;
        cmp rax, r10;
        je  g1iw_fail_stage;

        // 4. M3-001 cross-engine forward: signal 100, wait reaches.
        mov rax, 4;
        lea rcx, [rip + _g1iw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 100;
        call dpt_row_signal;
        cmp rax, 0;
        jne g1iw_fail_stage;
        mov rdi, 0;
        mov rsi, 100;
        mov rdx, 0;
        call dpy_timeline_wait_le;
        mov r10, 0xFFFFF68E;
        cmp rax, r10;
        je  g1iw_fail_stage;

        // 5. M3-002 reverse: signal 200, dpt_row_value observes 200.
        mov rax, 5;
        lea rcx, [rip + _g1iw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 200;
        call dpt_row_signal;
        cmp rax, 0;
        jne g1iw_fail_stage;
        mov rdi, 0;
        call dpt_row_value;
        cmp rax, 200;
        jne g1iw_fail_stage;

        // 6. M3-003 wrap: dpy_timeline_reached(1, u64_max-3) reaches
        //    (near-wrap: current=1, want=near u64 max, but signed
        //    subtraction gives a small positive so reached==1).
        mov rax, 6;
        lea rcx, [rip + _g1iw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 0xFFFFFFFFFFFFFFFC;
        call dpy_timeline_reached;
        cmp rax, 1;
        jne g1iw_fail_stage;

        // 7. Cleanup.
        mov rax, 7;
        lea rcx, [rip + _g1iw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call dpt_tail_free;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g1iw_ok];
        call klog_s1;

        call dpt_table_reset;
        call dpy_timeline_stats_reset;
        xor rax, rax;
        jmp g1iw_out;

      g1iw_fail_stage:
        lea rax, [rip + _g1iw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g1iw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dpt_table_reset;
        call dpy_timeline_stats_reset;
        mov rax, 1;

      g1iw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
