// tests/kernel/ipc/elevate_broker_roundtrip_synth.pdx -- R48-PREP-005.M3
//   (design/services/svc-elevate-broker-registration.md §4.M3)
//
// Client-roundtrip witness for svc.elevate-broker: proves that a client
// resolving the well-known name via the REAL syscall bodies and sending a
// REQ frame on ELEVATE_BROKER_ENDPOINT_ID (16) gets back a reply frame
// whose payload is ELVB_DISPATCH_STUB -- the same value both
// elevate_broker_dispatch (kernel stub, #1627) and the M2 userspace daemon
// (src/user/elevate_broker_daemon.pdx, R48-PREP-005.M2) return for every
// recognised ELV_OP_* code.
//
// -----------------------------------------------------------------------------
// Placement: why this is NOT wired into r30_platform.pdx
// -----------------------------------------------------------------------------
//
// The design doc (§4.M3 "Scope") drafted registering this witness in
// src/kernel/boot/witness/r30_platform.pdx right after
// elevate_broker_witness_call, and flagged the ordering as an open
// question: "If the current R30 platform-witness placement fires before
// init's third fork+exec, either move the witness later or drive the
// roundtrip from a post-init witness page."
//
// At M3 land time it does fire too early. witness_r30_platform is called
// from boot_continue_after_ring3 BEFORE witness_r17_init_sched runs
// init_bootstrap_witness (which is what first populates _init_task and
// its user_pml4 -- see kernel_main.pdx: `call witness_r30_platform;` at
// the top of the witness block, `call witness_r17_init_sched;` several
// calls later). Any witness that borrows a scratch page out of init's
// address space via user_write_bytes_via_walk / user_read_bytes_via_walk
// needs that address space to exist first.
//
// This witness is therefore called directly from kernel_main.pdx's
// boot_continue_after_ring3, immediately after `call witness_r20b_echo_rpc;`
// -- the same call site m5_echo_witness/m6_rpc_witness already use to
// borrow init's [0x7FFFFFFFB000, 0x7FFFFFFFB100) scratch window, which by
// that point in the boot sequence is fully mapped (init's task_slab,
// user_pml4 and user stack are all established earlier in
// boot_continue_after_ring3, well before this call site is reached).
//
// -----------------------------------------------------------------------------
// What this witness does NOT prove
// -----------------------------------------------------------------------------
//
// It does not exercise the real, spawned elevate_broker_daemon process.
// init's fork+exec of that daemon (M2) only happens after real ring-3
// execution begins, which starts at `enter_userland_initial` -- the LAST
// call in boot_continue_after_ring3, which iretq's away and never
// returns. No kernel-witness call site in this stream ever runs
// concurrently with, or after, a real scheduled userspace task; every
// witness in this file (m5_echo_witness, m6_rpc_witness, the ACPI
// supervisor / PCI enumerator roundtrips in rpc_servers.pdx, etc.) proves
// its substrate the same way: driving BOTH the client and server side of
// the wire sequentially, kernel-side, against binaries whose real ring-3
// spawn "wires up" at a later round (rpc_servers.pdx's own header uses
// that exact phrase for acpi_supervisor / pci_enumerator). This witness
// follows the identical, already-proven pattern: the CLIENT half is the
// real sys_svc_lookup_body / sys_ipc_send_body / sys_ipc_recv_body
// syscall bodies acting on the REAL, M1-bringup-published
// ELEVATE_BROKER_ENDPOINT_ID (16); the SERVER half calls the REAL
// elevate_broker_dispatch (the exact function the M2 daemon's dispatch
// arm mirrors byte-for-byte -- see elevate_broker_daemon.pdx's file
// header) and replies via the REAL sys_ipc_reply_body. What is proved:
// the wire protocol (frame_encode/decode, FRAME_OP_REPLY_BIT, payload
// framing) and the dispatch stub value round-trip correctly end-to-end
// against the live, well-known endpoint. What is NOT proved: that the
// M2 daemon binary itself is the process draining that endpoint at boot
// -- that requires real multi-task scheduling, deferred past this round
// (matches rpc_servers.pdx's own scope note for its two userspace
// server witnesses).
//
// -----------------------------------------------------------------------------
// User-page layout (borrowed from init's unused deepest stack page, same
// window m5_echo_witness / m6_rpc_witness already use):
// -----------------------------------------------------------------------------
//
//   +0x00  request hdr          (8 bytes) -- client -> endpoint 16
//   +0x08  request payload sink (8 bytes) -- unused; request payload_len=0
//   +0x20  server recv hdr sink     (8 bytes)
//   +0x28  server recv payload sink (8 bytes) -- unused; payload_len=0
//   +0x40  reply hdr             (8 bytes; op = ELV_OP_REQ | 0x80)
//   +0x48  reply payload         (8 bytes; = ELVB_DISPATCH_STUB)
//   +0x60  client recv reply hdr sink     (8 bytes)
//   +0x68  client recv reply payload sink (8 bytes)
//   +0x80  "svc.elevate-broker" copy for sys_svc_lookup_body (18 bytes;
//          padding to +0xA0 in the pre-wipe keeps this well clear of the
//          hdr/payload region above)
//
// Sub-tests (numeric stage tracked in _elvbcw_stage; any failure jumps to
// elvbcw_fail_stage with the stage):
//
//   0. Raw resolve: svc_lookup(elevate_broker_name, 18) ==
//      ELEVATE_BROKER_ENDPOINT_ID (16) -- proves the well-known name
//      resolves to the REAL, endpoint_alloc_at-claimed id the M1 bringup
//      published (kernel_main.pdx's elevate_broker_bringup, called
//      before witness_r30_platform).
//   1. Client-facing resolve: publish the name (18 bytes) to user_va
//      0x7FFFFFFFB080, then sys_svc_lookup_body(0x7FFFFFFFB080, 18)
//      returns a cap-table slot id in [0..255] -- proves the actual
//      syscall body a userspace client would invoke (cap-mint path)
//      resolves and mints successfully against the same row.
//   2. frame_encode request hdr: op=ELV_OP_REQ(1), ver=1, flags=0,
//      payload_len=0.
//   3. Pre-wipe user page @0x7FFFFFFFB000 (4096 zero bytes).
//   4. Publish request hdr (8 bytes) to user_va 0x7FFFFFFFB000.
//   5. CLIENT SEND: sys_ipc_send_body(16, 0x7FFFFFFFB000, 0x7FFFFFFFB008,
//      0) -> 0 (SYS_IPC_SEND_OK).
//   6. endpoint_is_full(16) == 1 (request pending on the well-known
//      endpoint).
//   7. SERVER RECV: sys_ipc_recv_body(16, 0x7FFFFFFFB020, 0x7FFFFFFFB028,
//      4088) -> 0 (payload_len, matches the request's payload_len=0).
//   8. Verify: hdr @ user_va 0x7FFFFFFFB020 byte-exact matches the
//      encoded request hdr.
//   9. elevate_broker_dispatch(op=ELV_OP_REQ=1, arg=0) ->
//      ELVB_DISPATCH_STUB (0xFFFFEBFB) -- the real dispatch primitive,
//      not a hand-rolled constant.
//  10. Publish reply payload (8 bytes = ELVB_DISPATCH_STUB) to user_va
//      0x7FFFFFFFB048.
//  11. frame_encode reply hdr: op=ELV_OP_REQ|0x80=0x81, ver=1, flags=0,
//      payload_len=8.
//  12. Publish reply hdr (8 bytes) to user_va 0x7FFFFFFFB040.
//  13. SERVER REPLY: sys_ipc_reply_body(16, 0x7FFFFFFFB040, 0x7FFFFFFFB048,
//      8) -> 0.
//  14. endpoint_is_full(16) == 1 (reply now pending).
//  15. CLIENT RECV: sys_ipc_recv_body(16, 0x7FFFFFFFB060, 0x7FFFFFFFB068,
//      4088) -> 8 (payload_len).
//  16. Verify: reply hdr @ user_va 0x7FFFFFFFB060 byte-exact matches the
//      encoded reply hdr.
//  17. Verify: FRAME_OP_REPLY_BIT (bit 7 of byte 0) is set on the
//      drained reply hdr.
//  18. Verify: reply payload @ user_va 0x7FFFFFFFB068's first u64 ==
//      ELVB_DISPATCH_STUB (0xFFFFEBFB) -- the acceptance criterion.
//
// Endpoint 16 is the PERMANENT well-known elevate-broker endpoint (claimed
// once at boot by elevate_broker_bringup) -- unlike m5_echo_witness's
// freshly-alloc'd endpoint, this witness does NOT endpoint_free it on
// exit. By sub-test 18 the endpoint is drained back to empty (the CLIENT
// RECV at sub-test 15 took the only pending message), so nothing is left
// dangling for any later boot stage.
//
// Register discipline: entered via a bare `call` from
// boot_continue_after_ring3 with no compensating push at the call site
// (matches every sibling witness call in that function -- witness_r20b_ipc,
// witness_r20b_loader, witness_r20b_echo_rpc, witness_rpc_servers, etc.),
// so this function's own 5-push callee-save prologue (rbx/r12/r13/r14/r15)
// is what restores correct parity for its nested calls, exactly mirroring
// m5_echo_witness / elevate_broker_witness's own prologues. r12 stashes
// the ELVB_DISPATCH_STUB value returned by elevate_broker_dispatch across
// the write into the reply-payload scratch. No other cross-call state is
// carried (the endpoint id is the literal constant 16 at every call site).
// All internal labels are elvbcw_-prefixed per this tree's reserved-label
// convention. No `test` instruction is used; all gates are `cmp`.
//
// Fingerprint: "ELEVATE BROKER CLIENT OK" (no round/milestone/issue tag,
// per design/policy/output-provenance-strip.md).

module ElevateBrokerRoundtripSynth = structure {

  pub let mut _elvbcw_stage : u64 = 0

  pub let mut _elvbcw_hdr_scratch       : [u64; 1]   = uninit @align(8)
  pub let mut _elvbcw_reply_hdr_scratch : [u64; 1]   = uninit @align(8)
  pub let mut _elvbcw_zero_scratch      : [u64; 512] = uninit @align(8)
  pub let mut _elvbcw_verify_scratch    : [u64; 1]   = uninit @align(8)

  pub let elvbcw_ok   : [u8; 26] = "ELEVATE BROKER CLIENT OK\0"
  pub let elvbcw_fail : [u8; 28] = "ELEVATE BROKER CLIENT FAIL\0"

  pub let elevate_broker_roundtrip_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R48-PREP-005.M3 (design/services/svc-elevate-broker-registration.md §4.M3): client-roundtrip witness for svc.elevate-broker. Drives the real sys_svc_lookup_body / sys_ipc_send_body / sys_ipc_recv_body / sys_ipc_reply_body syscall bodies plus the real elevate_broker_dispatch against the M1-bringup-published ELEVATE_BROKER_ENDPOINT_ID (16), kernel-side sequentially (client half then server half then client half again) -- the same pattern m5_echo_witness / m6_rpc_witness / rpc_servers.pdx's ACPI-supervisor and PCI-enumerator witnesses already use for target-shape userspace daemons whose real ring-3 spawn has not yet run at this point in boot. Entered via a bare `call` from boot_continue_after_ring3 (no compensating push at the call site, matching every sibling witness call there), so this function's own 5-push callee-save prologue (rbx/r12/r13/r14/r15 -- rbx/r14 unused scratch, kept for the proven parity shape) is what restores correct alignment for nested calls, mirroring elevate_broker_witness / m5_echo_witness exactly. r12 stashes ELVB_DISPATCH_STUB across the write into the reply-payload scratch; r13/r15 are free scratch across nested calls that don't need cross-call survival. Labels prefixed elvbcw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- Sub-test 0: raw resolve -- svc_lookup(name, 18) == 16.
        xor rax, rax;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;                          // stage = 0

        lea rdi, [rip + elevate_broker_name];
        mov rsi, 18;                              // ELEVATE_BROKER_NAME_LEN
        call svc_lookup;
        mov r10, 16;                               // ELEVATE_BROKER_ENDPOINT_ID
        cmp rax, r10;
        jne elvbcw_fail_stage;

        // -- Sub-test 1: client-facing resolve -- publish name to
        //    0x7FFFFFFFB080, sys_svc_lookup_body -> slot in [0..255].
        mov rax, 1;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        mov rdi, 0x7FFFFFFFB080;                  // user_va
        lea rsi, [rip + elevate_broker_name];      // kernel_src
        mov rdx, 18;                               // len
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        mov rdi, 0x7FFFFFFFB080;                  // user_name_va
        mov rsi, 18;                               // name_len
        call sys_svc_lookup_body;
        cmp rax, 256;                              // slot_id must be < 256
        jae elvbcw_fail_stage;                     // >= 256 means errno

        // -- Sub-test 2: frame_encode request hdr.
        //    op=ELV_OP_REQ(1), ver=1, flags=0, payload_len=0.
        mov rax, 2;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _elvbcw_hdr_scratch];
        mov rsi, 1;                                // ELV_OP_REQ
        mov rdx, 1;                                // ver
        mov rcx, 0;                                // flags
        mov r8, 0;                                 // payload_len
        call frame_encode;
        cmp rax, 0;                                // FRAME_ENCODE_OK
        jne elvbcw_fail_stage;

        // -- Sub-test 3: pre-wipe user page @0x7FFFFFFFB000 (4096 bytes).
        mov rax, 3;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        mov rdi, 0x7FFFFFFFB000;
        lea rsi, [rip + _elvbcw_zero_scratch];
        mov rdx, 4096;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        // -- Sub-test 4: publish request hdr (8 bytes) to 0x7FFFFFFFB000.
        mov rax, 4;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        mov rdi, 0x7FFFFFFFB000;
        lea rsi, [rip + _elvbcw_hdr_scratch];
        mov rdx, 8;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        // -- Sub-test 5: CLIENT SEND -- sys_ipc_send_body(16,
        //    0x7FFFFFFFB000, 0x7FFFFFFFB008, 0) -> 0.
        mov rax, 5;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        mov rdi, 16;                               // ELEVATE_BROKER_ENDPOINT_ID
        mov rsi, 0x7FFFFFFFB000;                  // user_hdr_va
        mov rdx, 0x7FFFFFFFB008;                  // user_payload_va (unused, len=0)
        mov rcx, 0;                                // payload_len
        call sys_ipc_send_body;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        // -- Sub-test 6: endpoint_is_full(16) == 1.
        mov rax, 6;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        mov rdi, 16;
        call endpoint_is_full;
        cmp rax, 1;
        jne elvbcw_fail_stage;

        // -- Sub-test 7: SERVER RECV -- sys_ipc_recv_body(16,
        //    0x7FFFFFFFB020, 0x7FFFFFFFB028, 4088) -> 0 (payload_len).
        mov rax, 7;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        mov rdi, 16;
        mov rsi, 0x7FFFFFFFB020;                  // server recv hdr sink
        mov rdx, 0x7FFFFFFFB028;                  // server recv payload sink
        mov rcx, 4088;                              // user_payload_max
        call sys_ipc_recv_body;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        // -- Sub-test 8: verify request hdr byte-exact at 0x7FFFFFFFB020.
        mov rax, 8;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _elvbcw_verify_scratch];
        mov rsi, 0x7FFFFFFFB020;
        mov rdx, 8;
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        lea r10, [rip + _elvbcw_verify_scratch];
        mov rax, [r10];                            // received hdr u64
        lea r10, [rip + _elvbcw_hdr_scratch];
        mov r11, [r10];                            // original encoded request hdr
        cmp rax, r11;
        jne elvbcw_fail_stage;

        // -- Sub-test 9: elevate_broker_dispatch(op=ELV_OP_REQ=1, arg=0)
        //    -> ELVB_DISPATCH_STUB (0xFFFFEBFB).
        mov rax, 9;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        mov rdi, 1;                                 // ELV_OP_REQ
        mov rsi, 0;                                 // arg (unused by the stub)
        call elevate_broker_dispatch;
        mov r10, 0xFFFFEBFB;                        // ELVB_DISPATCH_STUB
        cmp rax, r10;
        jne elvbcw_fail_stage;
        mov r12, rax;                               // stash the stub value

        // -- Sub-test 10: publish reply payload (8 bytes) to 0x7FFFFFFFB048.
        mov rax, 10;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        lea r10, [rip + _elvbcw_verify_scratch];
        mov [r10], r12;                             // stage the stub value in scratch
        mov rdi, 0x7FFFFFFFB048;
        lea rsi, [rip + _elvbcw_verify_scratch];
        mov rdx, 8;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        // -- Sub-test 11: frame_encode reply hdr.
        //    op=ELV_OP_REQ|0x80=0x81, ver=1, flags=0, payload_len=8.
        mov rax, 11;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _elvbcw_reply_hdr_scratch];
        mov rsi, 0x81;                              // op = 0x01 | 0x80
        mov rdx, 1;                                 // ver
        mov rcx, 0;                                 // flags
        mov r8, 8;                                  // payload_len
        call frame_encode;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        // -- Sub-test 12: publish reply hdr (8 bytes) to 0x7FFFFFFFB040.
        mov rax, 12;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        mov rdi, 0x7FFFFFFFB040;
        lea rsi, [rip + _elvbcw_reply_hdr_scratch];
        mov rdx, 8;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        // -- Sub-test 13: SERVER REPLY -- sys_ipc_reply_body(16,
        //    0x7FFFFFFFB040, 0x7FFFFFFFB048, 8) -> 0.
        mov rax, 13;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        mov rdi, 16;                                // ELEVATE_BROKER_ENDPOINT_ID
        mov rsi, 0x7FFFFFFFB040;                   // reply hdr_va (bit-7 set)
        mov rdx, 0x7FFFFFFFB048;                   // reply payload_va (stub value)
        mov rcx, 8;                                 // payload_len
        call sys_ipc_reply_body;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        // -- Sub-test 14: endpoint_is_full(16) == 1 (reply pending).
        mov rax, 14;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        mov rdi, 16;
        call endpoint_is_full;
        cmp rax, 1;
        jne elvbcw_fail_stage;

        // -- Sub-test 15: CLIENT RECV -- sys_ipc_recv_body(16,
        //    0x7FFFFFFFB060, 0x7FFFFFFFB068, 4088) -> 8.
        mov rax, 15;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        mov rdi, 16;
        mov rsi, 0x7FFFFFFFB060;                   // client recv reply hdr sink
        mov rdx, 0x7FFFFFFFB068;                   // client recv reply payload sink
        mov rcx, 4088;
        call sys_ipc_recv_body;
        cmp rax, 8;
        jne elvbcw_fail_stage;

        // -- Sub-test 16: verify reply hdr byte-exact at 0x7FFFFFFFB060.
        mov rax, 16;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _elvbcw_verify_scratch];
        mov rsi, 0x7FFFFFFFB060;
        mov rdx, 8;
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        lea r10, [rip + _elvbcw_verify_scratch];
        mov rax, [r10];                            // received reply hdr u64
        lea r10, [rip + _elvbcw_reply_hdr_scratch];
        mov r11, [r10];                            // expected reply hdr (op=0x81)
        cmp rax, r11;
        jne elvbcw_fail_stage;

        // -- Sub-test 17: verify FRAME_OP_REPLY_BIT set on the drained hdr.
        mov rax, 17;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        lea r10, [rip + _elvbcw_verify_scratch];
        mov rax, [r10];                            // still holds reply hdr
        and rax, 0x80;                             // FRAME_OP_REPLY_BIT
        cmp rax, 0;
        je  elvbcw_fail_stage;

        // -- Sub-test 18: verify reply payload's first u64 ==
        //    ELVB_DISPATCH_STUB (0xFFFFEBFB). THE acceptance criterion.
        mov rax, 18;
        lea rcx, [rip + _elvbcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _elvbcw_verify_scratch];
        mov rsi, 0x7FFFFFFFB068;
        mov rdx, 8;
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne elvbcw_fail_stage;

        lea r10, [rip + _elvbcw_verify_scratch];
        mov rax, [r10];                            // received reply payload u64
        mov r10, 0xFFFFEBFB;                       // ELVB_DISPATCH_STUB
        cmp rax, r10;
        jne elvbcw_fail_stage;

        // Success.
        mov rdi, 3;                                 // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + elvbcw_ok];
        call klog_s1;
        xor rax, rax;
        jmp elvbcw_out;

      elvbcw_fail_stage:
        lea rax, [rip + _elvbcw_stage];
        mov r8, [rax];                              // r8 = stage (u64)
        mov rdi, 1;                                  // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + elvbcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      elvbcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
