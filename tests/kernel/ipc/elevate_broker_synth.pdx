// tests/kernel/ipc/elevate_broker_synth.pdx -- R48b substrate-prep (#1627)
//
// Reworked by R48-PREP-005.M1 (design/services/svc-elevate-broker-
// registration.md): kernel_main now calls elevate_broker_bringup BEFORE
// this witness runs, claiming ELEVATE_BROKER_ENDPOINT_ID (16) via
// endpoint_alloc_at and publishing "svc.elevate-broker" against it. This
// witness therefore no longer registers a synthetic endpoint id (the old
// 0x33) itself -- svc_register is add-only (§2.3 of the design doc), so a
// second registration from here would either refuse as a duplicate or,
// worse, if it ran first, would publish the name against an endpoint id
// nothing had actually claimed. Instead this witness asserts against the
// real, already-published row.
//
// Boot witness for the svc.elevate-broker registration seam.
//
//   * elevate_broker_stats_reset() + counters read as zero.
//   * svc_lookup for "svc.elevate-broker" resolves to
//     ELEVATE_BROKER_ENDPOINT_ID (16) -- the row kernel_main's
//     elevate_broker_bringup published before boot reached this witness.
//   * A second registration attempt against that same real endpoint id
//     refuses with ELVB_REGISTER_DUP (svc_register's add-only
//     discipline).
//   * elevate_broker_dispatch recognises the three ELV_OP_* values and
//     returns ELVB_DISPATCH_STUB for each; an unknown op returns
//     ELVB_DISPATCH_BAD_OP.
//   * Counters record the exact number of failures / stub returns; a
//     drift there would surface a second writer of the counter table
//     before it could reach production.
//
// Fingerprint: R48b ELEVATE_BROKER OK

module ElevateBrokerSynth = structure {

  pub let mut _elvbw_stage : u64 = 0

  pub let elvbw_ok   : [u8; 19] = "ELEVATE_BROKER OK\0"
  pub let elvbw_fail : [u8; 21] = "ELEVATE_BROKER FAIL\0"

  pub let elevate_broker_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R48b substrate-prep (#1627): boot witness for elevate broker seam. NOT capabilities={cap} because the seam does not touch cap_table; it touches _svc_broker_table (via svc_register) and _elevate_broker_stats. Five callee-save pushes leave rsp%16 == 0. Labels prefixed elvbw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) Reset.
        mov rax, 1;
        lea rcx, [rip + _elvbw_stage];
        mov [rcx], rax;
        call elevate_broker_stats_reset;

        mov rdi, 0;
        call elevate_broker_stat;
        cmp rax, 0;
        jne elvbw_fail_stage;

        // (2) Row already published by kernel-side bringup
        // (R48-PREP-005.M1: elevate_broker_bringup ran from kernel_main,
        // before this witness fired) -- assert svc_lookup resolves the
        // canonical name to the reserved well-known id rather than
        // registering a synthetic one here.
        mov rax, 2;
        lea rcx, [rip + _elvbw_stage];
        mov [rcx], rax;
        lea rdi, [rip + elevate_broker_name];
        mov rsi, 18;                     // ELEVATE_BROKER_NAME_LEN
        call svc_lookup;
        mov r10, 16;                     // ELEVATE_BROKER_ENDPOINT_ID
        cmp rax, r10;
        jne elvbw_fail_stage;

        // (4) Duplicate registration refused -- the row from kernel_main's
        // bringup is already live, so re-registering the same name over
        // the real endpoint id must refuse with ELVB_REGISTER_DUP
        // (svc_register's add-only discipline; see design/services/svc-
        // elevate-broker-registration.md §2.3).
        mov rax, 4;
        lea rcx, [rip + _elvbw_stage];
        mov [rcx], rax;
        mov rdi, 16;                     // ELEVATE_BROKER_ENDPOINT_ID
        call elevate_broker_register;
        mov r10, 0xFFFFEBFE;             // ELVB_REGISTER_DUP
        cmp rax, r10;
        jne elvbw_fail_stage;

        mov rdi, 1;                      // ELVB_ST_REG_FAIL
        call elevate_broker_stat;
        cmp rax, 1;
        jne elvbw_fail_stage;

        // (5) BAD_ID (endpoint > 0xFFFF).
        mov rax, 5;
        lea rcx, [rip + _elvbw_stage];
        mov [rcx], rax;
        mov r11, 0x100000;
        mov rdi, r11;
        call elevate_broker_register;
        mov r10, 0xFFFFEBFF;             // ELVB_REGISTER_BAD_ID
        cmp rax, r10;
        jne elvbw_fail_stage;

        // (6) dispatch(REQ), dispatch(APR), dispatch(EXP) -> STUB.
        mov rax, 6;
        lea rcx, [rip + _elvbw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // ELV_OP_REQ
        mov rsi, 0xAA;
        call elevate_broker_dispatch;
        mov r10, 0xFFFFEBFB;             // ELVB_DISPATCH_STUB
        cmp rax, r10;
        jne elvbw_fail_stage;

        mov rdi, 2;                      // ELV_OP_APR
        mov rsi, 0xBB;
        call elevate_broker_dispatch;
        mov r10, 0xFFFFEBFB;
        cmp rax, r10;
        jne elvbw_fail_stage;

        mov rdi, 3;                      // ELV_OP_EXP
        mov rsi, 0xCC;
        call elevate_broker_dispatch;
        mov r10, 0xFFFFEBFB;
        cmp rax, r10;
        jne elvbw_fail_stage;

        mov rdi, 2;                      // ELVB_ST_DISPATCH
        call elevate_broker_stat;
        cmp rax, 3;
        jne elvbw_fail_stage;

        // (7) dispatch(0) -> BAD_OP; dispatch(99) -> BAD_OP.
        mov rax, 7;
        lea rcx, [rip + _elvbw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        xor rsi, rsi;
        call elevate_broker_dispatch;
        mov r10, 0xFFFFEBFA;
        cmp rax, r10;
        jne elvbw_fail_stage;

        mov rdi, 99;
        xor rsi, rsi;
        call elevate_broker_dispatch;
        mov r10, 0xFFFFEBFA;
        cmp rax, r10;
        jne elvbw_fail_stage;

        mov rdi, 3;                      // ELVB_ST_BAD_OP
        call elevate_broker_stat;
        cmp rax, 2;
        jne elvbw_fail_stage;

        // Success.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + elvbw_ok];
        call klog_s1;

        call elevate_broker_stats_reset;
        xor rax, rax;
        jmp elvbw_out;

      elvbw_fail_stage:
        lea rax, [rip + _elvbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + elvbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call elevate_broker_stats_reset;
        mov rax, 1;

      elvbw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
