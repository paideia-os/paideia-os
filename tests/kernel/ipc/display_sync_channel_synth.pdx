// tests/kernel/ipc/display_sync_channel_synth.pdx -- G1.M1-002 (#1428)
//
// Boot witness for display_sync_channel schema. Exercises event
// validator, slot validator, and refuses that both dsc_apply_wait
// and dsc_apply_flush return NO_TIMELINE for a slot that does not
// name a live KIND_DISPLAY_TIMELINE (which is the only shape the
// witness can reach without minting a real cap, and is the
// documented dormant-path per D7).
//
// Fingerprint: G1 DISPLAY SYNC CHAN OK

module DisplaySyncChannelSynth = structure {

  pub let mut _dscw_stage : u64 = 0

  pub let dscw_ok   : [u8; 25] = "G1 DISPLAY SYNC CHAN OK\0"
  pub let dscw_fail : [u8; 27] = "G1 DISPLAY SYNC CHAN FAIL\0"

  pub let display_sync_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G1.M1-002 (#1428): boot witness. Stages: (1) reset. (2) ev_valid. (3) slot_valid. (4) dsc_apply_wait on unmapped slot returns NO_TIMELINE. (5) dsc_apply_flush on unmapped slot returns NO_TIMELINE. Deferred: happy path requires a live KIND_DISPLAY_TIMELINE cap mint, which is exercised by kind_display_timeline_synth.pdx.",
      block: {
        push rbx;
        push r12;
        push r13;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _dscw_stage];
        mov [rcx], rax;
        call dsc_stats_reset;

        // 2. ev_valid: 0xA0/0xA1 ok, 0xA2 no.
        mov rax, 2;
        lea rcx, [rip + _dscw_stage];
        mov [rcx], rax;
        mov rdi, 0xA0;
        call dsc_ev_valid;
        cmp rax, 1;
        jne dscw_fail_stage;
        mov rdi, 0xA1;
        call dsc_ev_valid;
        cmp rax, 1;
        jne dscw_fail_stage;
        mov rdi, 0xA2;
        call dsc_ev_valid;
        cmp rax, 0;
        jne dscw_fail_stage;

        // 3. slot_valid: 0 ok, 255 ok, 256 no.
        mov rax, 3;
        lea rcx, [rip + _dscw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call dsc_slot_valid;
        cmp rax, 1;
        jne dscw_fail_stage;
        mov rdi, 255;
        call dsc_slot_valid;
        cmp rax, 1;
        jne dscw_fail_stage;
        mov rdi, 256;
        call dsc_slot_valid;
        cmp rax, 0;
        jne dscw_fail_stage;

        // 4. dsc_apply_wait on unmapped slot -> NO_TIMELINE.
        mov rax, 4;
        lea rcx, [rip + _dscw_stage];
        mov [rcx], rax;
        mov rdi, 100;                    // arbitrary unused slot
        mov rsi, 1;
        mov rdx, 0;
        call dsc_apply_wait;
        mov r10, 0xFFFFF69B;             // DSC_NO_TIMELINE
        cmp rax, r10;
        jne dscw_fail_stage;

        // 5. dsc_apply_flush on unmapped slot -> NO_TIMELINE.
        mov rax, 5;
        lea rcx, [rip + _dscw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        mov rsi, 1;
        call dsc_apply_flush;
        mov r10, 0xFFFFF69B;
        cmp rax, r10;
        jne dscw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dscw_ok];
        call klog_s1;

        call dsc_stats_reset;
        xor rax, rax;
        jmp dscw_out;

      dscw_fail_stage:
        lea rax, [rip + _dscw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dscw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dsc_stats_reset;
        mov rax, 1;

      dscw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
