// tests/kernel/ipc/g3_integration_synth.pdx -- G3.M3-004 + G3.M3-005 (#1470, #1471)
//
// Combined witness for the G3 M3 integration:
//
//   M3-004: VK_EXT_swapchain_maintenance1 discard shape.
//           Seed a swapchain image row, transition to QUEUED, then
//           discard-release. Assert state = DISCARDED and a
//           VFC_EV_DISCARD record lands on the feedback stream.
//
//   M3-005: P3 fractional-scale acceptance. Assert (3, 2) and
//           (5, 4) pass; (6, 4) and (0, 1) refused.
//
// Fingerprint: G3 INTEGRATION OK

module G3IntegrationSynth = structure {

  pub let mut _g3iw_stage : u64 = 0

  pub let g3iw_ok   : [u8; 19] = "G3 INTEGRATION OK\0"
  pub let g3iw_fail : [u8; 21] = "G3 INTEGRATION FAIL\0"

  pub let g3_integration_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G3.M3-004 (#1470) + G3.M3-005 (#1471): integrated witness. Stages: (1) reset all state. (2) Seed one swapchain image row (state = QUEUED). (3) discard_release -> state = DISCARDED. (4) pop feedback: VFC_EV_DISCARD record. (5) P3 scale (3, 2) accepted, (6, 4) refused. (6) Cleanup.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _g3iw_stage];
        mov [rcx], rax;
        call vksi_table_reset;
        call vfc_reset;
        call vkf_reset;

        // 2. seed swapchain image row 0 with state = QUEUED (3).
        mov rax, 2;
        lea rcx, [rip + _g3iw_stage];
        mov [rcx], rax;
        mov rdi, 5;
        mov rsi, 7;
        mov rdx, 0;
        mov rcx, 0;
        mov r8,  100;
        call vksi_body1_pack;
        mov r12, rax;                      // body1
        mov rdi, 101;
        call vksi_body2_pack;
        mov r13, rax;                      // body2
        mov rdi, 42;
        mov rsi, 3;                        // QUEUED
        call vksi_hdr_pack;
        mov rdi, rax;
        mov rsi, 0xC0DE;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  555;                      // present_id
        mov r9,  0;
        call vksi_tail_alloc;
        cmp rax, 0;
        jne g3iw_fail_stage;

        // 3. discard_release.
        mov rax, 3;
        lea rcx, [rip + _g3iw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 555;
        call vkf_discard_release;
        cmp rax, 0;
        jne g3iw_fail_stage;
        mov rdi, 0;
        call vksi_row_state;
        cmp rax, 5;                        // DISCARDED
        jne g3iw_fail_stage;

        // 4. pop feedback: (present_id=555, payload=0).
        mov rax, 4;
        lea rcx, [rip + _g3iw_stage];
        mov [rcx], rax;
        call vfc_pop;
        cmp rax, 555;
        jne g3iw_fail_stage;

        // 5. P3 scale: (3, 2) ok; (6, 4) no.
        mov rax, 5;
        lea rcx, [rip + _g3iw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 2;
        call vkf_scale_valid;
        cmp rax, 1;
        jne g3iw_fail_stage;
        mov rdi, 6;
        mov rsi, 4;
        call vkf_scale_valid;
        cmp rax, 0;
        jne g3iw_fail_stage;

        // 6. cleanup.
        mov rax, 6;
        lea rcx, [rip + _g3iw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vksi_tail_free;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g3iw_ok];
        call klog_s1;

        call vksi_table_reset;
        call vfc_reset;
        call vkf_reset;
        xor rax, rax;
        jmp g3iw_out;

      g3iw_fail_stage:
        lea rax, [rip + _g3iw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g3iw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vksi_table_reset;
        call vfc_reset;
        call vkf_reset;
        mov rax, 1;

      g3iw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
