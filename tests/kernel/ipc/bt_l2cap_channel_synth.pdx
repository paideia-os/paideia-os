// tests/kernel/ipc/bt_l2cap_channel_synth.pdx — R39.M2-004 (#1330)
//
// Boot witness for bt_l2cap_channel schema.
//
// Asserts verb validator, connect(psm, mtu) with the LE minimum MTU
// (23) accepted and (22) refused, the session FSM
// INIT -> OPEN -> CLOSED with illegal transitions refused, and
// send/recv len-vs-mtu bounds.
//
// Fingerprint: R39 BT L2CAP CHAN OK

module BtL2capChannelSynth = structure {

  pub let mut _bl2cw_stage : u64 = 0

  pub let bl2cw_ok   : [u8; 18] = "BT L2CAP CHAN OK\n\0"
  pub let bl2cw_fail : [u8; 20] = "BT L2CAP CHAN FAIL\n\0"

  pub let bl2cw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): reset session table.",
      block: {
        call bl2c_reset;
        ret
      }
    }

  pub let bt_l2cap_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M2-004 (#1330): boot witness. Stages: (1) verb validator. (2) connect -> session 0 (state OPEN). (3) connect refuses chan_slot=0 (BAD_ARG). (4) connect refuses psm=0 (BAD_PSM). (5) connect refuses mtu=22 (BAD_MTU). (6) send within mtu bumps tx_bytes. (7) send len=0 refused (BAD_LEN). (8) send len > mtu refused (BAD_LEN). (9) recv within mtu bumps rx_bytes. (10) disconnect -> free slot. (11) double disconnect refused (NOT_ACTIVE). (12) send after disconnect refused. (13) recv after disconnect refused.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        call bl2cw_scrub;

        // -- 1. Verb validator.
        mov rdi, 0xB0;
        call bl2c_verb_valid;
        cmp rax, 1;
        jne bl2cw_fail_stage;
        mov rdi, 0xB3;
        call bl2c_verb_valid;
        cmp rax, 1;
        jne bl2cw_fail_stage;
        mov rdi, 0xAF;
        call bl2c_verb_valid;
        cmp rax, 0;
        jne bl2cw_fail_stage;
        mov rdi, 0xB4;
        call bl2c_verb_valid;
        cmp rax, 0;
        jne bl2cw_fail_stage;

        // -- 2. connect -> session 0.
        mov rax, 2;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, 0x2222;                 // chan_slot
        mov rsi, 0x001F;                 // psm
        mov rdx, 100;                    // mtu
        call bl2c_connect;
        cmp rax, 0;
        jne bl2cw_fail_stage;
        mov r15, rax;                    // session_id

        mov rdi, r15;
        call bl2c_state_of;
        cmp rax, 1;                      // OPEN
        jne bl2cw_fail_stage;

        mov rdi, r15;
        call bl2c_mtu_of;
        cmp rax, 100;
        jne bl2cw_fail_stage;

        // -- 3. connect refuses chan_slot=0.
        mov rax, 3;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x001F;
        mov rdx, 100;
        call bl2c_connect;
        mov r11, 0xFFFFF0DF;             // BAD_ARG
        cmp rax, r11;
        jne bl2cw_fail_stage;

        // -- 4. connect refuses psm=0.
        mov rax, 4;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, 0x3333;
        mov rsi, 0;
        mov rdx, 100;
        call bl2c_connect;
        mov r11, 0xFFFFF0D9;             // BAD_PSM
        cmp rax, r11;
        jne bl2cw_fail_stage;

        // -- 5. connect refuses mtu=22.
        mov rax, 5;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, 0x4444;
        mov rsi, 0x1F;
        mov rdx, 22;
        call bl2c_connect;
        mov r11, 0xFFFFF0D8;             // BAD_MTU
        cmp rax, r11;
        jne bl2cw_fail_stage;

        // -- 6. send within mtu bumps tx_bytes.
        mov rax, 6;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        mov rsi, 40;
        call bl2c_send;
        cmp rax, 0;
        jne bl2cw_fail_stage;

        mov rdi, r15;
        call bl2c_tx_bytes;
        cmp rax, 40;
        jne bl2cw_fail_stage;

        // Second send accumulates.
        mov rdi, r15;
        mov rsi, 25;
        call bl2c_send;
        cmp rax, 0;
        jne bl2cw_fail_stage;

        mov rdi, r15;
        call bl2c_tx_bytes;
        cmp rax, 65;
        jne bl2cw_fail_stage;

        // -- 7. send len=0 refused.
        mov rax, 7;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        mov rsi, 0;
        call bl2c_send;
        mov r11, 0xFFFFF0D3;             // BAD_LEN
        cmp rax, r11;
        jne bl2cw_fail_stage;

        // -- 8. send len > mtu refused.
        mov rax, 8;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        mov rsi, 101;
        call bl2c_send;
        mov r11, 0xFFFFF0D3;             // BAD_LEN
        cmp rax, r11;
        jne bl2cw_fail_stage;

        // -- 9. recv within mtu bumps rx_bytes.
        mov rax, 9;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        mov rsi, 33;
        call bl2c_recv;
        cmp rax, 0;
        jne bl2cw_fail_stage;

        mov rdi, r15;
        call bl2c_rx_bytes;
        cmp rax, 33;
        jne bl2cw_fail_stage;

        // -- 10. disconnect -> ok.
        mov rax, 10;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        call bl2c_disconnect;
        cmp rax, 0;
        jne bl2cw_fail_stage;

        // -- 11. Double disconnect refused (session now inactive).
        mov rax, 11;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        call bl2c_disconnect;
        mov r11, 0xFFFFF0DB;             // NOT_ACTIVE
        cmp rax, r11;
        jne bl2cw_fail_stage;

        // -- 12. Send after disconnect refused.
        mov rax, 12;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        mov rsi, 10;
        call bl2c_send;
        mov r11, 0xFFFFF0DB;             // NOT_ACTIVE
        cmp rax, r11;
        jne bl2cw_fail_stage;

        // -- 13. Recv after disconnect refused.
        mov rax, 13;
        lea rcx, [rip + _bl2cw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        mov rsi, 10;
        call bl2c_recv;
        mov r11, 0xFFFFF0DB;             // NOT_ACTIVE
        cmp rax, r11;
        jne bl2cw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bl2cw_ok];
        call klog_s1;

        call bl2cw_scrub;
        xor rax, rax;
        jmp bl2cw_out;

      bl2cw_fail_stage:
        lea rax, [rip + _bl2cw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bl2cw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call bl2cw_scrub;
        mov rax, 1;

      bl2cw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
