// tests/kernel/ipc/sensor_read_channel_synth.pdx — R32.M5-003 (#1135)
//
// Boot witness for src/kernel/core/ipc/sensor_read_channel.pdx.
//
// Asserts the pack/unpack round-trip for SUBSCRIBE_REQ,
// SAMPLE_STREAM (two words), UNSUBSCRIBE_REQ, and the refusal
// discipline for the four gates (BAD_EV, BAD_TYPE, BAD_RATE,
// BAD_AXIS, BAD_TS, BAD_RESERVED).
//
// Fingerprint: R32 SENSOR SCHEMA OK
//
// No cap slots. Pure pack/unpack.

module SensorReadChannelSynth = structure {

  pub let mut _srch_w_stage : u64 = 0

  pub let srch_w_ok   : [u8; 22] = "R32 SENSOR SCHEMA OK\n\0"
  pub let srch_w_fail : [u8; 24] = "R32 SENSOR SCHEMA FAIL\n\0"

  pub let sensor_read_channel_witness : () -> u64 !{sysreg} @{boot} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {boot},
      justification: "R32.M5-003 (#1135): boot witness for sensor_read_channel schema. Round-trips SUBSCRIBE_REQ (type, rate) and SAMPLE_STREAM (ts, x, y, z) through their packers and unpackers, then drives the refusal band (BAD_EV via ev_valid, BAD_TYPE via pack_subscribe with type=0 and type=MAX+1, BAD_RATE with rate=0 and rate=MAX+1, BAD_AXIS with a value outside int16 range, BAD_TS with a value that overflows u32, BAD_RESERVED via a word0 unpack with reserved bits set). Pure arithmetic; no cap_table touch, no allocator. Four-push prologue (rbx/r12/r13/r14) leaves rsp%16 == 0 at every nested call: 8 (call retaddr) + 4*8 = 40 %16 == 8; wait -- match hid_event_synth's five-push convention instead. Actually 4 pushes gives rsp%16 == 8 which is the same as entry, so nested calls without XMM args are fine either way; retain the 4-push shape for symmetry with the other schema witnesses.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _srch_w_stage];
        mov [rcx], rax;

        // -- 1. ev_valid enumeration.
        mov rdi, 0x8F;                   // just below block
        call sensor_read_ch_ev_valid;
        cmp rax, 0;
        jne srch_w_fail_stage;
        mov rdi, 0x90;
        call sensor_read_ch_ev_valid;
        cmp rax, 1;
        jne srch_w_fail_stage;
        mov rdi, 0x91;
        call sensor_read_ch_ev_valid;
        cmp rax, 1;
        jne srch_w_fail_stage;
        mov rdi, 0x92;
        call sensor_read_ch_ev_valid;
        cmp rax, 1;
        jne srch_w_fail_stage;
        mov rdi, 0x93;                   // just past block
        call sensor_read_ch_ev_valid;
        cmp rax, 0;
        jne srch_w_fail_stage;

        // -- 2. Subscribe round-trip.
        mov rax, 2;
        lea rcx, [rip + _srch_w_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // ACCEL
        mov rsi, 400;
        call sensor_read_ch_pack_subscribe;
        mov rbx, rax;
        // type byte
        mov r11, rbx;
        shr r11, 56;
        cmp r11, 0x90;
        jne srch_w_fail_stage;
        mov rdi, rbx;
        call sensor_read_ch_sub_type;
        cmp rax, 2;
        jne srch_w_fail_stage;
        mov rdi, rbx;
        call sensor_read_ch_sub_rate;
        cmp rax, 400;
        jne srch_w_fail_stage;

        // BAD_TYPE (0)
        xor rdi, rdi;
        mov rsi, 100;
        call sensor_read_ch_pack_subscribe;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne srch_w_fail_stage;

        // BAD_TYPE (MAX+1)
        mov rdi, 4;
        mov rsi, 100;
        call sensor_read_ch_pack_subscribe;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne srch_w_fail_stage;

        // BAD_RATE (0)
        mov rdi, 1;
        xor rsi, rsi;
        call sensor_read_ch_pack_subscribe;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne srch_w_fail_stage;

        // BAD_RATE (MAX+1)
        mov rdi, 1;
        mov rsi, 1001;
        call sensor_read_ch_pack_subscribe;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne srch_w_fail_stage;

        // -- 3. Unsubscribe pack.
        mov rax, 3;
        lea rcx, [rip + _srch_w_stage];
        mov [rcx], rax;

        call sensor_read_ch_pack_unsubscribe;
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0x92;
        jne srch_w_fail_stage;

        // -- 4. Sample word0 round-trip.
        mov rax, 4;
        lea rcx, [rip + _srch_w_stage];
        mov [rcx], rax;

        mov rdi, 0x1234ABCD;
        call sensor_read_ch_pack_sample_word0;
        mov rbx, rax;
        mov rdi, rbx;
        call sensor_read_ch_sample_ts;
        mov r11, 0x1234ABCD;
        cmp rax, r11;
        jne srch_w_fail_stage;

        // BAD_TS (overflow u32)
        mov rdi, 0x100000000;
        call sensor_read_ch_pack_sample_word0;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne srch_w_fail_stage;

        // -- 5. Sample word1 round-trip: x=100, y=-200, z=32767.
        mov rax, 5;
        lea rcx, [rip + _srch_w_stage];
        mov [rcx], rax;

        mov rdi, 100;
        mov rsi, 0xFFFFFFFFFFFFFF38;     // -200 sign-extended
        mov rdx, 32767;
        call sensor_read_ch_pack_sample_word1;
        mov rbx, rax;

        mov rdi, rbx;
        call sensor_read_ch_sample_x;
        cmp rax, 100;
        jne srch_w_fail_stage;

        mov rdi, rbx;
        call sensor_read_ch_sample_y;
        mov r11, 0xFFFFFFFFFFFFFF38;     // -200
        cmp rax, r11;
        jne srch_w_fail_stage;

        mov rdi, rbx;
        call sensor_read_ch_sample_z;
        cmp rax, 32767;
        jne srch_w_fail_stage;

        // int16 boundary: 32768 refused.
        mov rdi, 32768;
        mov rsi, 0;
        mov rdx, 0;
        call sensor_read_ch_pack_sample_word1;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne srch_w_fail_stage;

        // -- 6. Unpackers refuse a word whose type byte is wrong.
        mov rax, 6;
        lea rcx, [rip + _srch_w_stage];
        mov [rcx], rax;

        // subscribe word decoded as sample_ts -> DECODE_BAD.
        mov rdi, 1;
        mov rsi, 100;
        call sensor_read_ch_pack_subscribe;
        mov rdi, rax;
        call sensor_read_ch_sample_ts;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne srch_w_fail_stage;

        // sample word decoded as subscribe rate -> DECODE_BAD.
        mov rdi, 0x1000;
        call sensor_read_ch_pack_sample_word0;
        mov rdi, rax;
        call sensor_read_ch_sub_rate;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne srch_w_fail_stage;

        // -- 7. Reserved bits in word0 refused.
        mov rax, 7;
        lea rcx, [rip + _srch_w_stage];
        mov [rcx], rax;

        // Construct a word0 with a reserved-range bit set.
        mov rdi, 0x91;
        shl rdi, 56;
        mov r10, 1;
        shl r10, 40;                     // reserved [55:32]
        or  rdi, r10;
        or  rdi, 0x100;                  // ts
        call sensor_read_ch_sample_ts;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne srch_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + srch_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp srch_w_out;

      srch_w_fail_stage:
        lea rax, [rip + _srch_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + srch_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      srch_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
