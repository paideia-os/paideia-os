// tests/kernel/ipc/font_load_channel_synth.pdx -- G5.M1-003 (#1493)
//
// Boot witness for font_load_channel. Exercises event/slot
// validators and confirms apply_* refuse cleanly on unmapped slots.
//
// Fingerprint: G5 FONT_LOAD_CHAN OK

module FontLoadChannelSynth = structure {

  pub let mut _flcw_stage : u64 = 0

  pub let flcw_ok   : [u8; 20] = "G5 FONT_LOAD_CHAN OK\0"
  pub let flcw_fail : [u8; 22] = "G5 FONT_LOAD_CHAN FAIL\0"

  pub let font_load_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G5.M1-003 (#1493): boot witness. Stages: (1) reset. (2) ev_valid. (3) slot_valid. (4) apply_load happy on fresh table. (5) apply_load duplicate key refused. (6) apply_subset refuses on unmapped slot. (7) apply_evict refuses on unmapped slot.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _flcw_stage];
        mov [rcx], rax;
        call flc_stats_reset;
        call fa_table_reset;

        // 2. ev_valid.
        mov rax, 2;
        lea rcx, [rip + _flcw_stage];
        mov [rcx], rax;
        mov rdi, 0xD0;
        call flc_ev_valid;
        cmp rax, 1;
        jne flcw_fail_stage;
        mov rdi, 0xD2;
        call flc_ev_valid;
        cmp rax, 1;
        jne flcw_fail_stage;
        mov rdi, 0xD3;
        call flc_ev_valid;
        cmp rax, 0;
        jne flcw_fail_stage;

        // 3. slot_valid.
        mov rax, 3;
        lea rcx, [rip + _flcw_stage];
        mov [rcx], rax;
        mov rdi, 255;
        call flc_slot_valid;
        cmp rax, 1;
        jne flcw_fail_stage;
        mov rdi, 256;
        call flc_slot_valid;
        cmp rax, 0;
        jne flcw_fail_stage;

        // 4. apply_load: fresh key 0xF00D5 -> row 0.
        mov rax, 4;
        lea rcx, [rip + _flcw_stage];
        mov [rcx], rax;
        mov rdi, 0xF00D5;
        mov rsi, 1024;
        mov rdx, 1024;
        mov rcx, 1;                         // FONT_FORMAT_SDF
        call flc_apply_load;
        cmp rax, 0;
        jne flcw_fail_stage;

        // 5. apply_load again with same key -> KEY_IN_USE.
        mov rax, 5;
        lea rcx, [rip + _flcw_stage];
        mov [rcx], rax;
        mov rdi, 0xF00D5;
        mov rsi, 1024;
        mov rdx, 1024;
        mov rcx, 1;
        call flc_apply_load;
        mov r10, 0xFFFFEDE7;
        cmp rax, r10;
        jne flcw_fail_stage;

        // 6. apply_subset on unmapped slot 42 -> NO_ATLAS.
        mov rax, 6;
        lea rcx, [rip + _flcw_stage];
        mov [rcx], rax;
        mov rdi, 42;
        mov rsi, 100;
        call flc_apply_subset;
        mov r10, 0xFFFFEDE9;
        cmp rax, r10;
        jne flcw_fail_stage;

        // 7. apply_evict on unmapped slot 42 -> NO_ATLAS.
        mov rax, 7;
        lea rcx, [rip + _flcw_stage];
        mov [rcx], rax;
        mov rdi, 42;
        call flc_apply_evict;
        mov r10, 0xFFFFEDE9;
        cmp rax, r10;
        jne flcw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + flcw_ok];
        call klog_s1;

        call flc_stats_reset;
        call fa_table_reset;
        xor rax, rax;
        jmp flcw_out;

      flcw_fail_stage:
        lea rax, [rip + _flcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + flcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call flc_stats_reset;
        call fa_table_reset;
        mov rax, 1;

      flcw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
