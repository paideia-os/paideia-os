// tests/kernel/ipc/hid_event_stream_channel_synth.pdx — R32.M3-004 (#1128)
//
// Boot witness for the hid_event_stream schema: the event-ordinal
// validator, the four packers (KBD_PRESS, KBD_RELEASE, MOUSE_MOVE,
// MOUSE_CLICK), the unpackers, and the reserved-bits gate.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arithmetic and refusals over the pack/unpack surface,
// and it asserts the round-trip: every field a packer accepted is
// the field its unpacker extracts. IT ASSERTS NOTHING ABOUT A SEND,
// A SUBSCRIBER, AN ENDPOINT OR A WIRE, because no code in this tree
// dispatches hid_event_stream events across a process boundary --
// design/ipc/hid-event-stream-session.md §7 records the deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R32 HID EVENT STREAM SCHEMA OK
//
// One and not four (per-event), unlike the KIND_HID_EVENT witness's
// A/B split, because there is no state machine here and nothing to
// fail for reasons independent of the packer -- everything is bit-
// arithmetic over the schema table.
//
// -----------------------------------------------------------------------------
// No cap slots
// -----------------------------------------------------------------------------
//
// The schema module has no capability, no row and no cap_table read.
// This witness mints nothing and clears nothing.

module HidEventStreamChannelSynth = structure {

  pub let mut _hesch_w_stage : u64 = 0

  pub let hesch_w_ok   : [u8; 28] = "HID EVENT STREAM SCHEMA OK\0\0"
  pub let hesch_w_fail : [u8; 29] = "HID EVENT STREAM SCHEMA FAIL\0"

  pub let hid_event_stream_schema_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M3-004 (#1128): boot witness for the hid_event_stream_channel schema. Stages: (S1) ev_valid answers 1 for {0x81..0x84} and 0 for {0, 0x7F (below range), 0x85 (past MAX), 0x01 (mask bit, not event ordinal)}. (S2) pack_kbd_press round trip on scancode=0x0055: unpack -> 0x0055; type extractor -> 0x81; reserved-bits gate -> 1. Refusal: scancode=0x10000 -> DECODE_BAD. (S3) pack_kbd_release round trip on scancode=0xABCD; type -> 0x82. kbd_scancode() on a MOUSE_MOVE word -> DECODE_BAD (dispatch discrimination). (S4) pack_mouse_move round trip on {dx=5, dy=-3}: dx() -> 5; dy() -> sign-extended 0xFFFFFFFFFFFFFFFD. Boundary: {dx=INT16_MAX, dy=INT16_MIN} round-trips. Refusal: dx=32768 -> DECODE_BAD; dx=-32769 (sign-extended = 0xFFFFFFFFFFFF7FFF) -> DECODE_BAD. (S5) mouse_dx() on a KBD_PRESS word -> DECODE_BAD. (S6) pack_mouse_click round trip on {button=1, edge=1}: button() -> 1; edge() -> 1. Boundary: {button=255, edge=0} round-trips. Refusal: button=0x100 -> DECODE_BAD; edge=2 -> DECODE_BAD. (S7) reserved-bits gate refuses a KBD word whose reserved [55:16] is non-zero (produced by OR-ing a value in). Each stage runs only if the previous passed. Five-push prologue leaves rsp%16 == 0 at every klog call. Labels prefixed hesch_w_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 -- ev_valid.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _hesch_w_stage];
        mov [rcx], rax;

        mov rdi, 0x81;
        call hid_event_stream_ch_ev_valid;
        cmp rax, 1;
        jne hesch_w_fail_stage;

        mov rdi, 0x82;
        call hid_event_stream_ch_ev_valid;
        cmp rax, 1;
        jne hesch_w_fail_stage;

        mov rdi, 0x83;
        call hid_event_stream_ch_ev_valid;
        cmp rax, 1;
        jne hesch_w_fail_stage;

        mov rdi, 0x84;
        call hid_event_stream_ch_ev_valid;
        cmp rax, 1;
        jne hesch_w_fail_stage;

        xor rdi, rdi;
        call hid_event_stream_ch_ev_valid;
        cmp rax, 0;
        jne hesch_w_fail_stage;

        mov rdi, 0x7F;                   // below range
        call hid_event_stream_ch_ev_valid;
        cmp rax, 0;
        jne hesch_w_fail_stage;

        mov rdi, 0x85;                   // past MAX
        call hid_event_stream_ch_ev_valid;
        cmp rax, 0;
        jne hesch_w_fail_stage;

        mov rdi, 0x01;                   // mask bit, not ordinal
        call hid_event_stream_ch_ev_valid;
        cmp rax, 0;
        jne hesch_w_fail_stage;

        // ================================================================
        // S2 -- pack_kbd_press round trip + refusal.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _hesch_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0055;
        call hid_event_stream_ch_pack_kbd_press;
        mov rbx, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_kbd_scancode;
        cmp rax, 0x0055;
        jne hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_type;
        cmp rax, 0x81;
        jne hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_payload_reserved_ok;
        cmp rax, 1;
        jne hesch_w_fail_stage;

        // Refusal.
        mov rdi, 0x10000;
        call hid_event_stream_ch_pack_kbd_press;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hesch_w_fail_stage;

        // ================================================================
        // S3 -- pack_kbd_release round trip + dispatch discrimination.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _hesch_w_stage];
        mov [rcx], rax;

        mov rdi, 0xABCD;
        call hid_event_stream_ch_pack_kbd_release;
        mov rbx, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_kbd_scancode;
        cmp rax, 0xABCD;
        jne hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_type;
        cmp rax, 0x82;
        jne hesch_w_fail_stage;

        // ================================================================
        // S4 -- pack_mouse_move round trip + sign-extend + refusals.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _hesch_w_stage];
        mov [rcx], rax;

        // {dx=5, dy=-3 sign-extended}.
        mov rdi, 5;
        mov rsi, 0xFFFFFFFFFFFFFFFD;     // -3 int16, sign-extended
        call hid_event_stream_ch_pack_mouse_move;
        mov rbx, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_mouse_dx;
        cmp rax, 5;
        jne hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_mouse_dy;
        mov r11, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r11;
        jne hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_type;
        cmp rax, 0x83;
        jne hesch_w_fail_stage;

        // Boundary: {dx=INT16_MAX, dy=INT16_MIN sign-extended}.
        mov rdi, 0x7FFF;
        mov rsi, 0xFFFFFFFFFFFF8000;     // -32768 sign-extended
        call hid_event_stream_ch_pack_mouse_move;
        mov rbx, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_mouse_dx;
        cmp rax, 0x7FFF;
        jne hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_mouse_dy;
        mov r11, 0xFFFFFFFFFFFF8000;
        cmp rax, r11;
        jne hesch_w_fail_stage;

        // Refusal: dx = 32768 (INT16_MAX + 1) unsigned overflow.
        mov rdi, 0x8000;
        xor rsi, rsi;
        call hid_event_stream_ch_pack_mouse_move;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hesch_w_fail_stage;

        // Refusal: dx = -32769 (INT16_MIN - 1) sign-extended.
        mov rdi, 0xFFFFFFFFFFFF7FFF;
        xor rsi, rsi;
        call hid_event_stream_ch_pack_mouse_move;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hesch_w_fail_stage;

        // ================================================================
        // S5 -- mouse_dx on a KBD word -> DECODE_BAD.
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _hesch_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0055;
        call hid_event_stream_ch_pack_kbd_press;
        mov rbx, rax;

        mov rdi, rbx;
        call hid_event_stream_ch_mouse_dx;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hesch_w_fail_stage;

        // ================================================================
        // S6 -- pack_mouse_click round trip + boundary + refusals.
        // ================================================================
        mov rax, 60;
        lea rcx, [rip + _hesch_w_stage];
        mov [rcx], rax;

        // Round trip: {button=1, edge=1}.
        mov rdi, 1;
        mov rsi, 1;
        call hid_event_stream_ch_pack_mouse_click;
        mov rbx, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_click_button;
        cmp rax, 1;
        jne hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_click_edge;
        cmp rax, 1;
        jne hesch_w_fail_stage;

        // Boundary: {button=255, edge=0}.
        mov rdi, 255;
        xor rsi, rsi;
        call hid_event_stream_ch_pack_mouse_click;
        mov rbx, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_click_button;
        cmp rax, 255;
        jne hesch_w_fail_stage;

        mov rdi, rbx;
        call hid_event_stream_ch_click_edge;
        cmp rax, 0;
        jne hesch_w_fail_stage;

        // Refusal: button = 0x100.
        mov rdi, 0x100;
        xor rsi, rsi;
        call hid_event_stream_ch_pack_mouse_click;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hesch_w_fail_stage;

        // Refusal: edge = 2.
        xor rdi, rdi;
        mov rsi, 2;
        call hid_event_stream_ch_pack_mouse_click;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hesch_w_fail_stage;

        // ================================================================
        // S7 -- reserved-bits gate rejects tampered KBD word.
        // ================================================================
        mov rax, 70;
        lea rcx, [rip + _hesch_w_stage];
        mov [rcx], rax;

        // Legitimate KBD_PRESS.
        mov rdi, 0x55;
        call hid_event_stream_ch_pack_kbd_press;
        mov rbx, rax;

        // OR a bit into reserved [55:16].
        mov r10, 1;
        shl r10, 16;                     // bit 16 (first reserved bit for KBD)
        or  rbx, r10;

        mov rdi, rbx;
        call hid_event_stream_ch_payload_reserved_ok;
        cmp rax, 0;
        jne hesch_w_fail_stage;

        // Unknown type byte -> reserved_ok returns 0.
        mov rdi, 0;                      // type byte 0
        call hid_event_stream_ch_payload_reserved_ok;
        cmp rax, 0;
        jne hesch_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hesch_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hesch_w_out;

      hesch_w_fail_stage:
        lea rax, [rip + _hesch_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hesch_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hesch_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
