// tests/kernel/ipc/hub_topology_channel_synth.pdx — R34.M1-004 (#1170)
//
// Boot witness for src/kernel/core/ipc/hub_topology_channel.pdx.
//
// Asserts pack/unpack round-trip and refusal discipline for
// DEVICE_ATTACHED, DEVICE_DETACHED, PORT_STATUS_CHG.
//
// Fingerprint: R34 HUB TOPOLOGY SCHEMA OK

module HubTopologyChannelSynth = structure {

  pub let mut _htp_w_stage : u64 = 0

  pub let htp_w_ok   : [u8; 30] = "R34 HUB TOPOLOGY SCHEMA OK\n\0\0\0\0"
  pub let htp_w_fail : [u8; 32] = "R34 HUB TOPOLOGY SCHEMA FAIL\n\0\0\0\0"

  pub let hub_topology_channel_witness : () -> u64 !{sysreg} @{boot} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {boot},
      justification: "R34.M1-004 (#1170): boot witness for hub_topology_channel schema. Round-trips ATTACHED / DETACHED / STATUS_CHG through packers and unpackers, and drives every refusal edge (BAD_SLOT, BAD_PORT, BAD_SPEED, BAD_EVENT).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _htp_w_stage];
        mov [rcx], rax;

        // -- 1. Validators.
        mov rdi, 0x3F;
        call hub_topo_op_valid;
        cmp rax, 0;
        jne htp_w_fail_stage;
        mov rdi, 0x40;
        call hub_topo_op_valid;
        cmp rax, 1;
        jne htp_w_fail_stage;
        mov rdi, 0x42;
        call hub_topo_op_valid;
        cmp rax, 1;
        jne htp_w_fail_stage;
        mov rdi, 0x43;
        call hub_topo_op_valid;
        cmp rax, 0;
        jne htp_w_fail_stage;

        // -- 2. ATTACHED round-trip.
        mov rax, 2;
        lea rcx, [rip + _htp_w_stage];
        mov [rcx], rax;

        mov rdi, 42;
        mov rsi, 3;
        mov rdx, 4;                      // SUPER
        call hub_topo_pack_attached;
        mov rbx, rax;
        mov rdi, rbx;
        call hub_topo_op;
        cmp rax, 0x40;
        jne htp_w_fail_stage;
        mov rdi, rbx;
        call hub_topo_hub_slot;
        cmp rax, 42;
        jne htp_w_fail_stage;
        mov rdi, rbx;
        call hub_topo_port;
        cmp rax, 3;
        jne htp_w_fail_stage;
        mov rdi, rbx;
        call hub_topo_speed;
        cmp rax, 4;
        jne htp_w_fail_stage;

        // BAD_SLOT (>= 256).
        mov rdi, 256;
        mov rsi, 3;
        mov rdx, 4;
        call hub_topo_pack_attached;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne htp_w_fail_stage;

        // BAD_PORT (>= 16).
        mov rdi, 42;
        mov rsi, 16;
        mov rdx, 4;
        call hub_topo_pack_attached;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne htp_w_fail_stage;

        // BAD_SPEED (0).
        mov rdi, 42;
        mov rsi, 3;
        xor rdx, rdx;
        call hub_topo_pack_attached;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne htp_w_fail_stage;

        // -- 3. DETACHED round-trip.
        mov rax, 3;
        lea rcx, [rip + _htp_w_stage];
        mov [rcx], rax;

        mov rdi, 100;
        mov rsi, 7;
        call hub_topo_pack_detached;
        mov rbx, rax;
        mov rdi, rbx;
        call hub_topo_op;
        cmp rax, 0x41;
        jne htp_w_fail_stage;
        mov rdi, rbx;
        call hub_topo_hub_slot;
        cmp rax, 100;
        jne htp_w_fail_stage;
        mov rdi, rbx;
        call hub_topo_port;
        cmp rax, 7;
        jne htp_w_fail_stage;

        // Speed of a DETACHED word -> DECODE_BAD (op != 0x40).
        mov rdi, rbx;
        call hub_topo_speed;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne htp_w_fail_stage;

        // -- 4. STATUS_CHG round-trip.
        mov rax, 4;
        lea rcx, [rip + _htp_w_stage];
        mov [rcx], rax;

        mov rdi, 55;
        mov rsi, 2;
        mov rdx, 3;                      // ADDRESSED
        call hub_topo_pack_status_chg;
        mov rbx, rax;
        mov rdi, rbx;
        call hub_topo_op;
        cmp rax, 0x42;
        jne htp_w_fail_stage;
        mov rdi, rbx;
        call hub_topo_hub_slot;
        cmp rax, 55;
        jne htp_w_fail_stage;
        mov rdi, rbx;
        call hub_topo_port;
        cmp rax, 2;
        jne htp_w_fail_stage;
        mov rdi, rbx;
        call hub_topo_event;
        cmp rax, 3;
        jne htp_w_fail_stage;

        // BAD_EVENT (0).
        mov rdi, 55;
        mov rsi, 2;
        xor rdx, rdx;
        call hub_topo_pack_status_chg;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne htp_w_fail_stage;

        // BAD_EVENT (6).
        mov rdi, 55;
        mov rsi, 2;
        mov rdx, 6;
        call hub_topo_pack_status_chg;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne htp_w_fail_stage;

        // -- 5. Unpackers refuse a wrong-op word.
        mov rax, 5;
        lea rcx, [rip + _htp_w_stage];
        mov [rcx], rax;

        // attached word decoded as event -> DECODE_BAD.
        mov rdi, 1;
        mov rsi, 1;
        mov rdx, 1;
        call hub_topo_pack_attached;
        mov rdi, rax;
        call hub_topo_event;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne htp_w_fail_stage;

        // status_chg word decoded as speed -> DECODE_BAD.
        mov rdi, 1;
        mov rsi, 1;
        mov rdx, 1;
        call hub_topo_pack_status_chg;
        mov rdi, rax;
        call hub_topo_speed;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne htp_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + htp_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp htp_w_out;

      htp_w_fail_stage:
        lea rax, [rip + _htp_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + htp_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      htp_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
