// tests/kernel/ipc/modeset_channel_synth.pdx — R36.M3-002 (#1245)
//
// Boot witness for modeset_channel FSM. Asserts event validator,
// transition-table entries for every legal edge, refusals for every
// illegal edge, pack + unpack symmetry, and end-to-end walk of the
// canonical session (BEGIN_TXN -> SET_MODE -> SET_PLANE -> SET_PLANE
// -> COMMIT) on a synthetic KIND_MODESET_TXN row.
//
// Fingerprint: R36 MODESET CHAN OK
//
// Cap slots 56..63.

module ModesetChannelSynth = structure {

  pub let mut _mchw_stage : u64 = 0

  pub let mchw_ok   : [u8; 21] = "R36 MODESET CHAN OK\n\0"
  pub let mchw_fail : [u8; 23] = "R36 MODESET CHAN FAIL\n\0"

  pub let mchw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-002 (#1245): clear cap_table slots 56..63.",
      block: {
        push rbx;
        mov rbx, 56;
      mchwc_loop:
        cmp rbx, 64;
        jae mchwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp mchwc_loop;
      mchwc_done:
        pop rbx;
        ret
      }
    }

  pub let mchw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-002 (#1245): reset MODESET_TXN row table.",
      block: {
        call modeset_txn_table_reset;
        ret
      }
    }

  pub let mchw_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-002 (#1245): synthetic KIND_IPC_ENDPOINT.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let modeset_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R36.M3-002 (#1245): boot witness. Stages: (1) ev_valid. (2) transition table happy edges. (3) transition table refused edges. (4) pack/unpack symmetry. (5) canonical session walk (BEGIN_TXN -> SET_MODE -> SET_PLANE -> SET_PLANE -> COMMIT) end-to-end. (6) refused mid-session (SET_PLANE from OPEN, COMMIT from OPEN, SET_MODE from PLANE_SET).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _mchw_stage];
        mov [rcx], rax;

        call mchw_clear;
        call mchw_scrub;

        // -- 1. mch_ev_valid: 0x90..0x94 yes; 0x8F and 0x95 no.
        mov rdi, 0x90;
        call mch_ev_valid;
        cmp rax, 1;
        jne mchw_fail_stage;
        mov rdi, 0x94;
        call mch_ev_valid;
        cmp rax, 1;
        jne mchw_fail_stage;
        mov rdi, 0x8F;
        call mch_ev_valid;
        cmp rax, 0;
        jne mchw_fail_stage;
        mov rdi, 0x95;
        call mch_ev_valid;
        cmp rax, 0;
        jne mchw_fail_stage;

        // -- 2. Transition table — happy edges.
        mov rax, 2;
        lea rcx, [rip + _mchw_stage];
        mov [rcx], rax;

        // OPEN + BEGIN_TXN -> OPEN
        mov rdi, 0;
        mov rsi, 0x90;
        call mch_transition;
        cmp rax, 0;
        jne mchw_fail_stage;

        // OPEN + SET_MODE -> MODE_SET
        mov rdi, 0;
        mov rsi, 0x91;
        call mch_transition;
        cmp rax, 1;
        jne mchw_fail_stage;

        // MODE_SET + SET_PLANE -> PLANE_SET
        mov rdi, 1;
        mov rsi, 0x92;
        call mch_transition;
        cmp rax, 2;
        jne mchw_fail_stage;

        // PLANE_SET + SET_PLANE -> PLANE_SET (star)
        mov rdi, 2;
        mov rsi, 0x92;
        call mch_transition;
        cmp rax, 2;
        jne mchw_fail_stage;

        // PLANE_SET + COMMIT -> COMMITTING
        mov rdi, 2;
        mov rsi, 0x93;
        call mch_transition;
        cmp rax, 3;
        jne mchw_fail_stage;

        // OPEN + ABORT -> ABORTED
        mov rdi, 0;
        mov rsi, 0x94;
        call mch_transition;
        cmp rax, 4;
        jne mchw_fail_stage;

        // -- 3. Refused edges (UNREACH = 0xFF).
        mov rax, 3;
        lea rcx, [rip + _mchw_stage];
        mov [rcx], rax;

        // OPEN + SET_PLANE -> UNREACH
        mov rdi, 0;
        mov rsi, 0x92;
        call mch_transition;
        cmp rax, 0xFF;
        jne mchw_fail_stage;

        // OPEN + COMMIT -> UNREACH
        mov rdi, 0;
        mov rsi, 0x93;
        call mch_transition;
        cmp rax, 0xFF;
        jne mchw_fail_stage;

        // MODE_SET + SET_MODE -> UNREACH
        mov rdi, 1;
        mov rsi, 0x91;
        call mch_transition;
        cmp rax, 0xFF;
        jne mchw_fail_stage;

        // COMMITTING + ABORT -> UNREACH (terminal-ish)
        mov rdi, 3;
        mov rsi, 0x94;
        call mch_transition;
        cmp rax, 0xFF;
        jne mchw_fail_stage;

        // -- 4. Pack/unpack symmetry.
        mov rax, 4;
        lea rcx, [rip + _mchw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234;
        call mch_pack_txn;
        mov r15, rax;
        cmp rax, 0x1234;
        jne mchw_fail_stage;

        mov rdi, r15;
        call mch_unpack_txn;
        cmp rax, 0x1234;
        jne mchw_fail_stage;

        mov rdi, 0x1234;
        mov rsi, 0x0500;
        call mch_pack_mode;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  mchw_fail_stage;

        mov rdi, r15;
        call mch_unpack_mode;
        cmp rax, 0x0500;
        jne mchw_fail_stage;

        mov rdi, 0x1234;
        mov rsi, 3;
        call mch_pack_plane;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  mchw_fail_stage;

        mov rdi, r15;
        call mch_unpack_plane;
        cmp rax, 3;
        jne mchw_fail_stage;

        // Pack refusals.
        mov rdi, 0;                      // slot 0
        call mch_pack_txn;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne mchw_fail_stage;

        mov rdi, 0x1234;
        mov rsi, 16;                     // plane > MAX
        call mch_pack_plane;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne mchw_fail_stage;

        // -- 5. End-to-end walk against a synthetic KIND_MODESET_TXN.
        mov rax, 5;
        lea rcx, [rip + _mchw_stage];
        mov [rcx], rax;

        // Endpoint at 57 with id 0x77.
        mov rdi, 57;
        mov rsi, 0x200;
        mov rdx, 0x77;
        call mchw_endpoint;

        // Mint MODESET_TXN at slot 58.
        mov rdi, 58;
        mov rsi, 57;
        mov rdx, 0x419;
        mov rcx, 0xF00D0001;
        mov r8, 0x100;
        call modeset_txn_cap_mint_inner;
        cmp rax, 0;
        jne mchw_fail_stage;

        // BEGIN_TXN (aux=0)
        mov rdi, 58;
        mov rsi, 0x90;
        mov rdx, 0;
        call mch_event_apply;
        cmp rax, 0;
        jne mchw_fail_stage;

        // SET_MODE (aux=mode_slot=0x0500)
        mov rdi, 58;
        mov rsi, 0x91;
        mov rdx, 0x0500;
        call mch_event_apply;
        cmp rax, 0;
        jne mchw_fail_stage;

        // Row state should now be MODE_SET (1); mode_slot should be 0x0500.
        mov rdi, 58;
        call mtx_row_of_slot;
        mov r15, rax;                    // row_id
        cmp r15, 0xFF;
        je  mchw_fail_stage;

        mov rdi, r15;
        call mtx_row_state;
        cmp rax, 1;
        jne mchw_fail_stage;

        mov rdi, r15;
        call mtx_row_mode;
        cmp rax, 0x0500;
        jne mchw_fail_stage;

        // SET_PLANE (aux=plane_id=2)
        mov rdi, 58;
        mov rsi, 0x92;
        mov rdx, 2;
        call mch_event_apply;
        cmp rax, 0;
        jne mchw_fail_stage;

        // SET_PLANE again (star)
        mov rdi, 58;
        mov rsi, 0x92;
        mov rdx, 3;
        call mch_event_apply;
        cmp rax, 0;
        jne mchw_fail_stage;

        mov rdi, r15;
        call mtx_row_state;
        cmp rax, 2;                      // PLANE_SET
        jne mchw_fail_stage;

        // COMMIT
        mov rdi, 58;
        mov rsi, 0x93;
        mov rdx, 0;
        call mch_event_apply;
        cmp rax, 0;
        jne mchw_fail_stage;

        mov rdi, r15;
        call mtx_row_state;
        cmp rax, 3;                      // COMMITTING
        jne mchw_fail_stage;

        // -- 6. Refused mid-session transitions.
        mov rax, 6;
        lea rcx, [rip + _mchw_stage];
        mov [rcx], rax;

        // COMMITTING + anything -> refused.
        mov rdi, 58;
        mov rsi, 0x92;
        mov rdx, 0;
        call mch_event_apply;
        mov r11, 0xFFFFF71B;
        cmp rax, r11;
        jne mchw_fail_stage;

        // Fresh txn: SET_PLANE from OPEN refused.
        call mchw_scrub;
        call mchw_clear;
        mov rdi, 57;
        mov rsi, 0x200;
        mov rdx, 0x77;
        call mchw_endpoint;

        mov rdi, 58;
        mov rsi, 57;
        mov rdx, 0x419;
        mov rcx, 0xF00D0002;
        mov r8, 0x100;
        call modeset_txn_cap_mint_inner;
        cmp rax, 0;
        jne mchw_fail_stage;

        mov rdi, 58;
        mov rsi, 0x92;
        mov rdx, 1;
        call mch_event_apply;
        mov r11, 0xFFFFF71B;
        cmp rax, r11;
        jne mchw_fail_stage;

        // COMMIT from OPEN refused.
        mov rdi, 58;
        mov rsi, 0x93;
        mov rdx, 0;
        call mch_event_apply;
        mov r11, 0xFFFFF71B;
        cmp rax, r11;
        jne mchw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mchw_ok];
        call klog_s1;

        call mchw_scrub;
        call mchw_clear;
        xor rax, rax;
        jmp mchw_out;

      mchw_fail_stage:
        lea rax, [rip + _mchw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mchw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call mchw_scrub;
        call mchw_clear;
        mov rax, 1;

      mchw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
