// tests/kernel/ipc/scanout_lease_channel_synth.pdx -- G2.M1-002 (#1444)
//
// Boot witness for scanout_lease_channel schema. Exercises event
// ordinals, slot validators, and refusals against unmapped slots.
//
// Fingerprint: G2 SCANOUT LEASE CHAN OK

module ScanoutLeaseChannelSynth = structure {

  pub let mut _slcw_stage : u64 = 0

  pub let slcw_ok   : [u8; 26] = "G2 SCANOUT LEASE CHAN OK\n\0"
  pub let slcw_fail : [u8; 28] = "G2 SCANOUT LEASE CHAN FAIL\n\0"

  pub let scanout_lease_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G2.M1-002 (#1444): boot witness. Stages: (1) reset. (2) ev_valid (0xC0, 0xC1, 0xC2 ok; 0xBF, 0xC3 no). (3) slot_valid (0 ok; 256 no). (4) apply_present on unmapped -> NO_LEASE. (5) apply_release on unmapped -> NO_LEASE. (6) counter reads.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _slcw_stage];
        mov [rcx], rax;
        call slc_stats_reset;
        call sl_table_reset;
        call scanout_reset;

        // 2. ev_valid.
        mov rax, 2;
        lea rcx, [rip + _slcw_stage];
        mov [rcx], rax;
        mov rdi, 0xC0;
        call slc_ev_valid;
        cmp rax, 1;
        jne slcw_fail_stage;
        mov rdi, 0xC2;
        call slc_ev_valid;
        cmp rax, 1;
        jne slcw_fail_stage;
        mov rdi, 0xBF;
        call slc_ev_valid;
        cmp rax, 0;
        jne slcw_fail_stage;
        mov rdi, 0xC3;
        call slc_ev_valid;
        cmp rax, 0;
        jne slcw_fail_stage;

        // 3. slot_valid.
        mov rax, 3;
        lea rcx, [rip + _slcw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call slc_slot_valid;
        cmp rax, 1;
        jne slcw_fail_stage;
        mov rdi, 256;
        call slc_slot_valid;
        cmp rax, 0;
        jne slcw_fail_stage;

        // 4. apply_present on unmapped slot -> NO_LEASE.
        mov rax, 4;
        lea rcx, [rip + _slcw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        mov rsi, 50;
        mov rdx, 1;
        call slc_apply_present;
        mov r10, 0xFFFFF628;             // SLC_NO_LEASE
        cmp rax, r10;
        jne slcw_fail_stage;

        // 5. apply_release on unmapped -> NO_LEASE.
        mov rax, 5;
        lea rcx, [rip + _slcw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        call slc_apply_release;
        mov r10, 0xFFFFF628;
        cmp rax, r10;
        jne slcw_fail_stage;

        // 6. Counter reads.
        mov rax, 6;
        lea rcx, [rip + _slcw_stage];
        mov [rcx], rax;
        mov rdi, 3;                      // SLC_ST_REFUSED
        call slc_stat;
        cmp rax, 0;
        je  slcw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + slcw_ok];
        call klog_s1;

        call slc_stats_reset;
        call sl_table_reset;
        call scanout_reset;
        xor rax, rax;
        jmp slcw_out;

      slcw_fail_stage:
        lea rax, [rip + _slcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + slcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call slc_stats_reset;
        call sl_table_reset;
        call scanout_reset;
        mov rax, 1;

      slcw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
