// tests/kernel/ipc/vk_present_feedback_channel_synth.pdx -- G3.M3-001 (#1467)
//
// Boot witness for vk_present_feedback_channel. Exercises reset,
// event validator, push/pop round-trip, len tracking, and
// vfc_wait_for_present on an already-satisfied ID.
//
// Fingerprint: G3 VK_PRESENT_FB_CHAN OK

module VkPresentFeedbackChannelSynth = structure {

  pub let mut _vfcw_stage : u64 = 0

  pub let vfcw_ok   : [u8; 26] = "G3 VK_PRESENT_FB_CHAN OK\0"
  pub let vfcw_fail : [u8; 28] = "G3 VK_PRESENT_FB_CHAN FAIL\0"

  pub let vk_present_feedback_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G3.M3-001 (#1467): boot witness. Stages: (1) reset. (2) ev_valid. (3) push happy. (4) len = 1. (5) pop returns pushed record. (6) len = 0. (7) push 32 to fill queue; 33rd refused QUEUE_FULL. (8) reset + push (id=42, ts=100). (9) vfc_wait_for_present target_id=42 timeout=0 returns 100.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _vfcw_stage];
        mov [rcx], rax;
        call vfc_reset;

        // 2. ev_valid.
        mov rax, 2;
        lea rcx, [rip + _vfcw_stage];
        mov [rcx], rax;
        mov rdi, 0xD0;
        call vfc_ev_valid;
        cmp rax, 1;
        jne vfcw_fail_stage;
        mov rdi, 0xD2;
        call vfc_ev_valid;
        cmp rax, 1;
        jne vfcw_fail_stage;
        mov rdi, 0xD3;
        call vfc_ev_valid;
        cmp rax, 0;
        jne vfcw_fail_stage;

        // 3. push happy.
        mov rax, 3;
        lea rcx, [rip + _vfcw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 111;
        call vfc_push;
        cmp rax, 0;
        jne vfcw_fail_stage;

        // 4. len = 1.
        mov rax, 4;
        lea rcx, [rip + _vfcw_stage];
        mov [rcx], rax;
        call vfc_len;
        cmp rax, 1;
        jne vfcw_fail_stage;

        // 5. pop returns (1, 111).
        mov rax, 5;
        lea rcx, [rip + _vfcw_stage];
        mov [rcx], rax;
        call vfc_pop;
        cmp rax, 1;
        jne vfcw_fail_stage;
        cmp rdx, 111;
        jne vfcw_fail_stage;

        // 6. len = 0.
        mov rax, 6;
        lea rcx, [rip + _vfcw_stage];
        mov [rcx], rax;
        call vfc_len;
        cmp rax, 0;
        jne vfcw_fail_stage;

        // 7. push 31, then push 32nd fails (queue holds 31 records
        //    of 32 slots since head==tail means empty; head+1==tail
        //    means full).
        mov rax, 7;
        lea rcx, [rip + _vfcw_stage];
        mov [rcx], rax;
        call vfc_reset;
        xor r12, r12;
      vfcw_fill_loop:
        cmp r12, 31;
        jae vfcw_fill_done;
        mov rdi, r12;
        add rdi, 1;
        mov rsi, 200;
        call vfc_push;
        cmp rax, 0;
        jne vfcw_fail_stage;
        add r12, 1;
        jmp vfcw_fill_loop;
      vfcw_fill_done:
        mov rdi, 999;
        mov rsi, 0;
        call vfc_push;
        mov r10, 0xFFFFEDEB;
        cmp rax, r10;
        jne vfcw_fail_stage;

        // 8. reset + push (id=42, ts=100).
        mov rax, 8;
        lea rcx, [rip + _vfcw_stage];
        mov [rcx], rax;
        call vfc_reset;
        mov rdi, 42;
        mov rsi, 100;
        call vfc_push;
        cmp rax, 0;
        jne vfcw_fail_stage;

        // 9. wait_for_present(42, 0) returns 100 (payload).
        mov rax, 9;
        lea rcx, [rip + _vfcw_stage];
        mov [rcx], rax;
        mov rdi, 42;
        mov rsi, 0;
        call vfc_wait_for_present;
        cmp rax, 100;
        jne vfcw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vfcw_ok];
        call klog_s1;

        call vfc_reset;
        xor rax, rax;
        jmp vfcw_out;

      vfcw_fail_stage:
        lea rax, [rip + _vfcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vfcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vfc_reset;
        mov rax, 1;

      vfcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
