// tests/kernel/ipc/vrr_channel_synth.pdx -- G1.M2-003 (#1434)
//
// Boot witness for vrr_channel schema. Exercises event/slot
// validators + refusal of get/enable/disable against a slot that
// does not name a live KIND_VRR_RANGE.
//
// Fingerprint: G1 VRR CHAN OK

module VrrChannelSynth = structure {

  pub let mut _vrcw_stage : u64 = 0

  pub let vrcw_ok   : [u8; 16] = "G1 VRR CHAN OK\0"
  pub let vrcw_fail : [u8; 18] = "G1 VRR CHAN FAIL\0"

  pub let vrr_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G1.M2-003 (#1434): boot witness. Stages: (1) reset. (2) ev_valid. (3) slot_valid. (4) vrc_apply_get on unmapped slot -> NO_RANGE. (5) vrc_apply_enable on unmapped -> NO_RANGE. (6) vrc_apply_disable on unmapped -> NO_RANGE.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _vrcw_stage];
        mov [rcx], rax;
        call vrc_stats_reset;

        // 2. ev_valid.
        mov rax, 2;
        lea rcx, [rip + _vrcw_stage];
        mov [rcx], rax;
        mov rdi, 0xB0;
        call vrc_ev_valid;
        cmp rax, 1;
        jne vrcw_fail_stage;
        mov rdi, 0xB2;
        call vrc_ev_valid;
        cmp rax, 1;
        jne vrcw_fail_stage;
        mov rdi, 0xB3;
        call vrc_ev_valid;
        cmp rax, 0;
        jne vrcw_fail_stage;

        // 3. slot_valid.
        mov rax, 3;
        lea rcx, [rip + _vrcw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vrc_slot_valid;
        cmp rax, 1;
        jne vrcw_fail_stage;
        mov rdi, 256;
        call vrc_slot_valid;
        cmp rax, 0;
        jne vrcw_fail_stage;

        // 4. apply_get on unmapped -> NO_RANGE.
        mov rax, 4;
        lea rcx, [rip + _vrcw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        call vrc_apply_get;
        mov r10, 0xFFFFF65B;
        cmp rax, r10;
        jne vrcw_fail_stage;

        // 5. apply_enable on unmapped -> NO_RANGE.
        mov rax, 5;
        lea rcx, [rip + _vrcw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        mov rsi, 3;
        call vrc_apply_enable;
        mov r10, 0xFFFFF65B;
        cmp rax, r10;
        jne vrcw_fail_stage;

        // 6. apply_disable on unmapped -> NO_RANGE.
        mov rax, 6;
        lea rcx, [rip + _vrcw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        mov rsi, 3;
        call vrc_apply_disable;
        mov r10, 0xFFFFF65B;
        cmp rax, r10;
        jne vrcw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrcw_ok];
        call klog_s1;

        call vrc_stats_reset;
        xor rax, rax;
        jmp vrcw_out;

      vrcw_fail_stage:
        lea rax, [rip + _vrcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vrc_stats_reset;
        mov rax, 1;

      vrcw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
