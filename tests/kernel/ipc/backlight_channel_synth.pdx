// tests/kernel/ipc/backlight_channel_synth.pdx — R31.M5-002 (#1107)
//
// Boot witness for the backlight_channel schema: the two validators
// (op / event), the four packers (GET reply, GET_RANGE reply, SET
// request, BRIGHTNESS_CHANGED payload) and the six unpackers.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arithmetic and refusals over the pack/unpack surface, and
// it asserts the round-trip: every field a packer accepted is the field
// its unpacker extracts. IT ASSERTS NOTHING ABOUT A SEND, A SUBSCRIBER,
// AN ENDPOINT OR A WIRE, because no code in this tree dispatches
// backlight_channel events -- design/ipc/backlight-channel-schema.md §7
// records the deferrals in the language kind_backlight.pdx §4 uses.
//
// -----------------------------------------------------------------------------
// One fingerprint, not two
// -----------------------------------------------------------------------------
//
//   R31 BACKLIGHT CHANNEL OK
//
// One and not two, unlike backlight_synth's A/B split, because there is
// no state machine here and nothing to fail for reasons independent of
// the packer -- everything is bit-arithmetic over the schema table.
//
// -----------------------------------------------------------------------------
// No cap slots
// -----------------------------------------------------------------------------
//
// The schema module has no capability, no row and no cap_table read.
// This witness therefore mints nothing and clears nothing, and the
// enclosing block does not need to reserve a slot range for it.

module BacklightChannelSynth = structure {

  pub let mut _bchl_w_stage : u64 = 0

  pub let bchl_w_ok   : [u8; 25] = "R31 BACKLIGHT CHANNEL OK\0"
  pub let bchl_w_fail : [u8; 27] = "R31 BACKLIGHT CHANNEL FAIL\0"

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let backlight_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R31.M5-002 (#1107): boot witness for the backlight_channel schema. Stages, in order: (S1) op_valid answers 1 for GET/SET/GET_RANGE and 0 for {0 (.bss default), 4 (past MAX), 0x80 (event ordinal, not an op)}. (S2) ev_valid answers 1 for BRIGHTNESS_CHANGED (0x80) and 0 for {0x81 (past EV_MAX), 1 (op ordinal, not an event)}. (S3) pack_get_reply round trip: pack {current=60, reports=17} and unpack each field back to the same value; a bit slip in the pack shifts or in the extract masks fails at least one of the two. Refusals: current=0x10000 (past 16b) and reports=0x100000000 (past 32b) each yield DECODE_BAD. (S4) pack_range_reply round trip: pack {min=0, max=100}; refusals: max=min and max<min. (S5) pack_brightness_changed round trip: pack {prev=40, new=60}; refusals: prev==new (a no-op transition), prev/new past 16b. (S6) pack_set_request: level=60 admitted and round-trip via set_request_level; level=0x10000 refused (BAD_LEVEL). Each stage runs only if the previous passed. No mint, no revoke, no cap_table touch. Five-push prologue (rbx, r12, r13, r14, r15) leaves rsp%16 == 0 at every klog_s1 call. Labels prefixed bchl_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 -- op_valid.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _bchl_w_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // GET
        call backlight_channel_op_valid;
        cmp rax, 1;
        jne bchl_w_fail_stage;

        mov rdi, 2;                      // SET
        call backlight_channel_op_valid;
        cmp rax, 1;
        jne bchl_w_fail_stage;

        mov rdi, 3;                      // GET_RANGE
        call backlight_channel_op_valid;
        cmp rax, 1;
        jne bchl_w_fail_stage;

        mov rdi, 0;                      // .bss default
        call backlight_channel_op_valid;
        cmp rax, 0;
        jne bchl_w_fail_stage;

        mov rdi, 4;                      // past OP_MAX
        call backlight_channel_op_valid;
        cmp rax, 0;
        jne bchl_w_fail_stage;

        mov rdi, 0x80;                   // event ordinal, not an op
        call backlight_channel_op_valid;
        cmp rax, 0;
        jne bchl_w_fail_stage;

        // ================================================================
        // S2 -- ev_valid.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _bchl_w_stage];
        mov [rcx], rax;

        mov rdi, 0x80;                   // BRIGHTNESS_CHANGED
        call backlight_channel_ev_valid;
        cmp rax, 1;
        jne bchl_w_fail_stage;

        mov rdi, 0x81;                   // past EV_MAX
        call backlight_channel_ev_valid;
        cmp rax, 0;
        jne bchl_w_fail_stage;

        mov rdi, 1;                      // op ordinal, not an event
        call backlight_channel_ev_valid;
        cmp rax, 0;
        jne bchl_w_fail_stage;

        // ================================================================
        // S3 -- pack_get_reply round trip and refusals.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _bchl_w_stage];
        mov [rcx], rax;

        // Round trip: {current=60, reports=17}.
        mov rdi, 60;
        mov rsi, 17;
        call backlight_channel_pack_get_reply;
        mov rbx, rax;

        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  bchl_w_fail_stage;

        mov rdi, rbx;
        call backlight_channel_get_reply_current;
        cmp rax, 60;
        jne bchl_w_fail_stage;

        mov rdi, rbx;
        call backlight_channel_get_reply_reports;
        cmp rax, 17;
        jne bchl_w_fail_stage;

        // Refusal: current > 16b.
        mov rdi, 0x10000;
        mov rsi, 0;
        call backlight_channel_pack_get_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bchl_w_fail_stage;

        // Refusal: reports > 32b.
        mov rdi, 0;
        mov rsi, 0x100000000;
        call backlight_channel_pack_get_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bchl_w_fail_stage;

        // ================================================================
        // S4 -- pack_range_reply round trip and refusals.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _bchl_w_stage];
        mov [rcx], rax;

        // Round trip: {min=0, max=100}.
        mov rdi, 0;
        mov rsi, 100;
        call backlight_channel_pack_range_reply;
        mov rbx, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  bchl_w_fail_stage;

        mov rdi, rbx;
        call backlight_channel_range_reply_min;
        cmp rax, 0;
        jne bchl_w_fail_stage;

        mov rdi, rbx;
        call backlight_channel_range_reply_max;
        cmp rax, 100;
        jne bchl_w_fail_stage;

        // Refusal: max == min.
        mov rdi, 50;
        mov rsi, 50;
        call backlight_channel_pack_range_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bchl_w_fail_stage;

        // Refusal: max < min.
        mov rdi, 100;
        mov rsi, 50;
        call backlight_channel_pack_range_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bchl_w_fail_stage;

        // ================================================================
        // S5 -- pack_brightness_changed round trip and refusals.
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _bchl_w_stage];
        mov [rcx], rax;

        // Round trip: {prev=40, new=60}.
        mov rdi, 40;
        mov rsi, 60;
        call backlight_channel_pack_brightness_changed;
        mov rbx, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  bchl_w_fail_stage;

        mov rdi, rbx;
        call backlight_channel_bc_prev;
        cmp rax, 40;
        jne bchl_w_fail_stage;

        mov rdi, rbx;
        call backlight_channel_bc_new;
        cmp rax, 60;
        jne bchl_w_fail_stage;

        // Refusal: prev == new.
        mov rdi, 60;
        mov rsi, 60;
        call backlight_channel_pack_brightness_changed;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bchl_w_fail_stage;

        // Refusal: prev > 16b.
        mov rdi, 0x10000;
        mov rsi, 60;
        call backlight_channel_pack_brightness_changed;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bchl_w_fail_stage;

        // Refusal: new > 16b.
        mov rdi, 40;
        mov rsi, 0x10000;
        call backlight_channel_pack_brightness_changed;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bchl_w_fail_stage;

        // ================================================================
        // S6 -- pack_set_request round trip and refusal.
        // ================================================================
        mov rax, 60;
        lea rcx, [rip + _bchl_w_stage];
        mov [rcx], rax;

        mov rdi, 60;
        call backlight_channel_pack_set_request;
        mov rbx, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  bchl_w_fail_stage;

        mov rdi, rbx;
        call backlight_channel_set_request_level;
        cmp rax, 60;
        jne bchl_w_fail_stage;

        // Boundary: level=0 admitted (a legitimate floor).
        mov rdi, 0;
        call backlight_channel_pack_set_request;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  bchl_w_fail_stage;

        // Boundary: level=0xFFFF admitted (a 16-bit-max ordinal).
        mov rdi, 0xFFFF;
        call backlight_channel_pack_set_request;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  bchl_w_fail_stage;

        // Refusal: level > 16b -> BAD_LEVEL (via DECODE_BAD sentinel).
        mov rdi, 0x10000;
        call backlight_channel_pack_set_request;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bchl_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bchl_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp bchl_w_out;

      bchl_w_fail_stage:
        lea rax, [rip + _bchl_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bchl_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      bchl_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
