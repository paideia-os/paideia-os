// tests/kernel/ipc/vello_render_channel_synth.pdx -- G4.M1-004 (#1478)
//
// Boot witness for vello_render_channel schema. Exercises event
// ordinals, slot bounds, and counter roundtrips.
//
// Fingerprint: G4 VELLO_RENDER_CHAN OK

module VelloRenderChannelSynth = structure {

  pub let mut _vrcsw_stage : u64 = 0

  pub let vrcsw_ok   : [u8; 25] = "G4 VELLO_RENDER_CHAN OK\n\0"
  pub let vrcsw_fail : [u8; 27] = "G4 VELLO_RENDER_CHAN FAIL\n\0"

  pub let vello_render_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G4.M1-004 (#1478): boot witness. Stages: (1) stats_reset. (2) ev_valid at boundaries. (3) slot_valid. (4) note + stat roundtrip. Three callee-save pushes (odd) keep rsp aligned across nested klog / vrc calls: entry 8, +3*8=24, 8+24 mod 16 = 0.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _vrcsw_stage];
        mov [rcx], rax;
        call vrenc_stats_reset;

        // 2. ev_valid.
        mov rax, 2;
        lea rcx, [rip + _vrcsw_stage];
        mov [rcx], rax;
        mov rdi, 0xD0;
        call vrenc_ev_valid;
        cmp rax, 1;
        jne vrcsw_fail_stage;
        mov rdi, 0xD2;
        call vrenc_ev_valid;
        cmp rax, 1;
        jne vrcsw_fail_stage;
        mov rdi, 0xCF;
        call vrenc_ev_valid;
        cmp rax, 0;
        jne vrcsw_fail_stage;
        mov rdi, 0xD3;
        call vrenc_ev_valid;
        cmp rax, 0;
        jne vrcsw_fail_stage;

        // 3. slot_valid.
        mov rax, 3;
        lea rcx, [rip + _vrcsw_stage];
        mov [rcx], rax;
        mov rdi, 255;
        call vrenc_slot_valid;
        cmp rax, 1;
        jne vrcsw_fail_stage;
        mov rdi, 256;
        call vrenc_slot_valid;
        cmp rax, 0;
        jne vrcsw_fail_stage;

        // 4. note + stat: encodes counter bumps by 1.
        mov rax, 4;
        lea rcx, [rip + _vrcsw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vrenc_note;
        mov rdi, 0;
        call vrenc_stat;
        cmp rax, 1;
        jne vrcsw_fail_stage;
        mov rdi, 3;                       // refused
        call vrenc_note;
        mov rdi, 3;
        call vrenc_stat;
        cmp rax, 1;
        jne vrcsw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrcsw_ok];
        call klog_s1;

        call vrenc_stats_reset;
        xor rax, rax;
        jmp vrcsw_out;

      vrcsw_fail_stage:
        lea rax, [rip + _vrcsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrcsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vrenc_stats_reset;
        mov rax, 1;

      vrcsw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
