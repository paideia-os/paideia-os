// tests/kernel/ipc/battery_channel_synth.pdx — R31.M3-002 (#1100)
//
// Boot witness for the battery_channel schema: the two validators
// (op / event), the three packers (READ_STATE reply, STATE_CHANGED
// payload, LOW_WARNING payload) and the seven unpackers.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arithmetic and refusals over the pack/unpack surface, and
// it asserts the round-trip: every field a packer accepted is the
// field its unpacker extracts. IT ASSERTS NOTHING ABOUT A SEND, A
// SUBSCRIBER, AN ENDPOINT OR A WIRE, because no code in this tree
// dispatches battery_channel events -- design/ipc/battery-channel-
// schema.md §7 records the deferrals in the language kind_battery.pdx
// §4 uses for its own.
//
// -----------------------------------------------------------------------------
// One fingerprint, not two
// -----------------------------------------------------------------------------
//
//   R31 BATTERY CHANNEL OK
//
// One and not two, unlike battery_synth's A/B split, because there is
// no unit conversion here and no cached state machine to fail for
// reasons independent of the packer -- everything is bit-arithmetic
// over the schema table.
//
// -----------------------------------------------------------------------------
// No cap slots
// -----------------------------------------------------------------------------
//
// The schema module has no capability, no row and no cap_table read.
// This witness therefore mints nothing and clears nothing, and the
// enclosing block does not need to reserve a slot range for it. The
// slots in adjacent witnesses (0..8, 10..12, 14..19, 28..33, 46..63,
// 64..95, 110..117, 160..199, 200..211, 212..223, 224..231, 232..243)
// are left undisturbed.

module BatteryChannelSynth = structure {

  pub let mut _bch_w_stage : u64 = 0

  pub let bch_w_ok   : [u8; 19] = "BATTERY CHANNEL OK\0"
  pub let bch_w_fail : [u8; 21] = "BATTERY CHANNEL FAIL\0"

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let battery_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R31.M3-002 (#1100): boot witness for the battery_channel schema. Stages, in order: (S1) op_valid answers 1 for READ_STATE (1) and 0 for everything else including 0 (.bss default) and 2 (unknown). (S2) ev_valid answers 1 for STATE_CHANGED (0x80) and LOW_WARNING (0x81) and 0 for 0x82 (past _MAX) and for any RPC ordinal that would collide with the low half. (S3) pack_reply round trip: pack {pct=85, state=DISCHARGING (2), mv=12042, reports=17} and unpack each of the four fields back to the same value; a bit slip in the pack shifts or in the extract masks fails at least one of the four. Then edge cases: pct=0 admitted (a legitimate flat pack), pct=100 admitted (a legitimate full pack), pct=0xFF admitted (the row's 'no report' sentinel), pct=101 REFUSED with DECODE_BAD, state=5 admitted, state=6 REFUSED, mv=25000 admitted, mv=25001 REFUSED, reports=0xFFFFFFFF admitted, reports=0x100000000 REFUSED (the 32-bit truncation is a visible failure rather than a silent one). (S4) pack_state_changed round trip: pack {prev=DISCHARGING, new=CHARGING, pct=80, mv=12100}, unpack each field. Refusals: prev==new -> DECODE_BAD (a change payload with no change is a lie), prev>MAX and new>MAX -> DECODE_BAD, pct=0xFF -> DECODE_BAD (no report cannot participate in a transition), mv>MAX -> DECODE_BAD. (S5) pack_low_warning round trip: pack {pct=4, threshold=5, mv=11000}, unpack each field. Refusals: pct>threshold -> DECODE_BAD (a LOW warning above threshold is a lie), pct>MAX, threshold>MAX, mv>MAX. Each stage runs only if the previous passed. No mint, no revoke, no cap_table touch. Five-push prologue (rbx, r12, r13, r14, r15) leaves rsp%16 == 0 at every klog_s1 call. Labels prefixed bch_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 — op_valid.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _bch_w_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // READ_STATE
        call battery_channel_op_valid;
        cmp rax, 1;
        jne bch_w_fail_stage;

        mov rdi, 0;                      // .bss default
        call battery_channel_op_valid;
        cmp rax, 0;
        jne bch_w_fail_stage;

        mov rdi, 2;                      // unknown
        call battery_channel_op_valid;
        cmp rax, 0;
        jne bch_w_fail_stage;

        mov rdi, 0x80;                   // event ordinal, not an op
        call battery_channel_op_valid;
        cmp rax, 0;
        jne bch_w_fail_stage;

        // ================================================================
        // S2 — ev_valid.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _bch_w_stage];
        mov [rcx], rax;

        mov rdi, 0x80;                   // STATE_CHANGED
        call battery_channel_ev_valid;
        cmp rax, 1;
        jne bch_w_fail_stage;

        mov rdi, 0x81;                   // LOW_WARNING
        call battery_channel_ev_valid;
        cmp rax, 1;
        jne bch_w_fail_stage;

        mov rdi, 0x82;                   // past EV_MAX
        call battery_channel_ev_valid;
        cmp rax, 0;
        jne bch_w_fail_stage;

        mov rdi, 1;                      // op ordinal, not an event
        call battery_channel_ev_valid;
        cmp rax, 0;
        jne bch_w_fail_stage;

        // ================================================================
        // S3 — pack_reply round trip and edge refusals.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _bch_w_stage];
        mov [rcx], rax;

        // Round trip: {85, 2, 12042, 17}.
        mov rdi, 85;
        mov rsi, 2;
        mov rdx, 12042;
        mov rcx, 17;
        call battery_channel_pack_reply;
        mov rbx, rax;                    // save the packed word

        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  bch_w_fail_stage;            // packer must not have refused

        mov rdi, rbx;
        call battery_channel_reply_percent;
        cmp rax, 85;
        jne bch_w_fail_stage;

        mov rdi, rbx;
        call battery_channel_reply_state;
        cmp rax, 2;
        jne bch_w_fail_stage;

        mov rdi, rbx;
        call battery_channel_reply_voltage;
        cmp rax, 12042;
        jne bch_w_fail_stage;

        mov rdi, rbx;
        call battery_channel_reply_reports;
        cmp rax, 17;
        jne bch_w_fail_stage;

        // Edge: pct=0, state=0, mv=0, reports=0 (all legal).
        xor rdi, rdi;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call battery_channel_pack_reply;
        cmp rax, 0;
        jne bch_w_fail_stage;

        // Edge: pct=100 admitted.
        mov rdi, 100;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;
        call battery_channel_pack_reply;
        cmp rax, 100;
        jne bch_w_fail_stage;

        // Edge: pct=0xFF admitted (row's 'no report' sentinel).
        mov rdi, 0xFF;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;
        call battery_channel_pack_reply;
        cmp rax, 0xFF;
        jne bch_w_fail_stage;

        // Refusal: pct=101 -> DECODE_BAD.
        mov rdi, 101;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;
        call battery_channel_pack_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // Edge: state=5 admitted, state=6 refused.
        mov rdi, 0;
        mov rsi, 5;
        mov rdx, 0;
        mov rcx, 0;
        call battery_channel_pack_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  bch_w_fail_stage;

        mov rdi, 0;
        mov rsi, 6;
        mov rdx, 0;
        mov rcx, 0;
        call battery_channel_pack_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // Edge: mv=25000 admitted, mv=25001 refused.
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 25000;
        mov rcx, 0;
        call battery_channel_pack_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  bch_w_fail_stage;

        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 25001;
        mov rcx, 0;
        call battery_channel_pack_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // Edge: reports=0xFFFFFFFF admitted, > 32b refused.
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0xFFFFFFFF;
        call battery_channel_pack_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  bch_w_fail_stage;

        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0x100000000;
        call battery_channel_pack_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // ================================================================
        // S4 — pack_state_changed round trip and refusals.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _bch_w_stage];
        mov [rcx], rax;

        // Round trip: {prev=2 (DISCHARGING), new=1 (CHARGING), pct=80, mv=12100}.
        mov rdi, 2;
        mov rsi, 1;
        mov rdx, 80;
        mov rcx, 12100;
        call battery_channel_pack_state_changed;
        mov rbx, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  bch_w_fail_stage;

        mov rdi, rbx;
        call battery_channel_sc_prev;
        cmp rax, 2;
        jne bch_w_fail_stage;

        mov rdi, rbx;
        call battery_channel_sc_new;
        cmp rax, 1;
        jne bch_w_fail_stage;

        mov rdi, rbx;
        call battery_channel_sc_pct;
        cmp rax, 80;
        jne bch_w_fail_stage;

        mov rdi, rbx;
        call battery_channel_sc_mv;
        cmp rax, 12100;
        jne bch_w_fail_stage;

        // Refusal: prev == new.
        mov rdi, 2;
        mov rsi, 2;
        mov rdx, 80;
        mov rcx, 12100;
        call battery_channel_pack_state_changed;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // Refusal: prev > MAX.
        mov rdi, 6;
        mov rsi, 1;
        mov rdx, 80;
        mov rcx, 12100;
        call battery_channel_pack_state_changed;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // Refusal: new > MAX.
        mov rdi, 1;
        mov rsi, 6;
        mov rdx, 80;
        mov rcx, 12100;
        call battery_channel_pack_state_changed;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // Refusal: pct = 0xFF (not in 0..100 for a transition).
        mov rdi, 2;
        mov rsi, 1;
        mov rdx, 0xFF;
        mov rcx, 12100;
        call battery_channel_pack_state_changed;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // Refusal: mv > MAX.
        mov rdi, 2;
        mov rsi, 1;
        mov rdx, 80;
        mov rcx, 25001;
        call battery_channel_pack_state_changed;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // ================================================================
        // S5 — pack_low_warning round trip and refusals.
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _bch_w_stage];
        mov [rcx], rax;

        // Round trip: {pct=4, threshold=5, mv=11000}.
        mov rdi, 4;
        mov rsi, 5;
        mov rdx, 11000;
        call battery_channel_pack_low_warning;
        mov rbx, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  bch_w_fail_stage;

        mov rdi, rbx;
        call battery_channel_lw_pct;
        cmp rax, 4;
        jne bch_w_fail_stage;

        mov rdi, rbx;
        call battery_channel_lw_threshold;
        cmp rax, 5;
        jne bch_w_fail_stage;

        mov rdi, rbx;
        call battery_channel_lw_mv;
        cmp rax, 11000;
        jne bch_w_fail_stage;

        // Boundary: pct == threshold admitted.
        mov rdi, 5;
        mov rsi, 5;
        mov rdx, 11000;
        call battery_channel_pack_low_warning;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  bch_w_fail_stage;

        // Refusal: pct > threshold.
        mov rdi, 6;
        mov rsi, 5;
        mov rdx, 11000;
        call battery_channel_pack_low_warning;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // Refusal: pct > MAX.
        mov rdi, 101;
        mov rsi, 100;
        mov rdx, 11000;
        call battery_channel_pack_low_warning;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // Refusal: threshold > MAX.
        mov rdi, 4;
        mov rsi, 101;
        mov rdx, 11000;
        call battery_channel_pack_low_warning;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // Refusal: mv > MAX.
        mov rdi, 4;
        mov rsi, 5;
        mov rdx, 25001;
        call battery_channel_pack_low_warning;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bch_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bch_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp bch_w_out;

      bch_w_fail_stage:
        lea rax, [rip + _bch_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bch_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      bch_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
