// tests/kernel/ipc/pcm_ring_channel_synth.pdx — R33.M3-004 (#1150)
//
// Boot witness for the pcm_ring_channel schema. Round-trips every
// packer/unpacker and drives the refusal band.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//   R33 PCM RING SCHEMA OK

module PcmRingChannelSynth = structure {

  pub let mut _pcmr_w_stage : u64 = 0

  pub let pcmr_w_ok   : [u8; 24] = "R33 PCM RING SCHEMA OK\0"
  pub let pcmr_w_fail : [u8; 26] = "R33 PCM RING SCHEMA FAIL\0"

  pub let pcm_ring_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M3-004 (#1150): boot witness for the pcm_ring_channel schema. Stages: (S1) op_valid — 0 refused, 0x10..0x13 accepted, 0xE0 refused, 0xFF refused. (S2) FILL_NEXT round-trip. (S3) DRAIN_CURRENT round-trip. (S4) XRUN_NOTIFY round-trip. (S5) SEEK round-trip. (S6) reply round-trips: FILL_ACK/DRAIN_ACK/XRUN_ACK/SEEK_ACK. (S7) refusal edges: FILL_NEXT with buf=0 -> DECODE_BAD; XRUN_NOTIFY at 2^40 -> DECODE_BAD; SEEK at 2^56 -> DECODE_BAD; DRAIN_ACK with frames >= 2^16 -> DECODE_BAD. Labels prefixed pcmr_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // S1.
        mov rax, 10;
        lea rcx, [rip + _pcmr_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call pcm_ring_op_valid;
        cmp rax, 0;
        jne pcmr_w_fail_stage;

        mov rdi, 0x10;
        call pcm_ring_op_valid;
        cmp rax, 1;
        jne pcmr_w_fail_stage;
        mov rdi, 0x11;
        call pcm_ring_op_valid;
        cmp rax, 1;
        jne pcmr_w_fail_stage;
        mov rdi, 0x12;
        call pcm_ring_op_valid;
        cmp rax, 1;
        jne pcmr_w_fail_stage;
        mov rdi, 0x13;
        call pcm_ring_op_valid;
        cmp rax, 1;
        jne pcmr_w_fail_stage;

        mov rdi, 0xE0;
        call pcm_ring_op_valid;
        cmp rax, 0;
        jne pcmr_w_fail_stage;
        mov rdi, 0xFF;
        call pcm_ring_op_valid;
        cmp rax, 0;
        jne pcmr_w_fail_stage;

        // S2 FILL_NEXT round-trip.
        mov rax, 20;
        lea rcx, [rip + _pcmr_w_stage];
        mov [rcx], rax;

        mov rdi, 42;
        mov rsi, 1024;
        call pcm_ring_pack_fill_next_req;
        mov rbx, rax;

        mov rdi, rbx;
        call pcm_ring_req_op;
        cmp rax, 0x10;
        jne pcmr_w_fail_stage;

        mov rdi, rbx;
        call pcm_ring_fill_next_req_buf;
        cmp rax, 42;
        jne pcmr_w_fail_stage;

        mov rdi, rbx;
        call pcm_ring_fill_next_req_frames;
        cmp rax, 1024;
        jne pcmr_w_fail_stage;

        // S3 DRAIN_CURRENT round-trip.
        mov rax, 30;
        lea rcx, [rip + _pcmr_w_stage];
        mov [rcx], rax;

        call pcm_ring_pack_drain_current_req;
        mov rbx, rax;
        cmp rbx, 0x11;
        jne pcmr_w_fail_stage;

        // S4 XRUN_NOTIFY round-trip.
        mov rax, 40;
        lea rcx, [rip + _pcmr_w_stage];
        mov [rcx], rax;

        mov rdi, 777;
        call pcm_ring_pack_xrun_notify_req;
        mov rbx, rax;

        mov rdi, rbx;
        call pcm_ring_xrun_notify_req_period;
        cmp rax, 777;
        jne pcmr_w_fail_stage;

        // S5 SEEK round-trip.
        mov rax, 50;
        lea rcx, [rip + _pcmr_w_stage];
        mov [rcx], rax;

        mov rdi, 0x12345678;
        call pcm_ring_pack_seek_req;
        mov rbx, rax;

        mov rdi, rbx;
        call pcm_ring_seek_req_sample;
        mov r11, 0x12345678;
        cmp rax, r11;
        jne pcmr_w_fail_stage;

        // S6 reply round-trips.
        mov rax, 60;
        lea rcx, [rip + _pcmr_w_stage];
        mov [rcx], rax;

        mov rdi, 0xABCD;
        call pcm_ring_pack_fill_ack;
        mov rbx, rax;
        mov rdi, rbx;
        call pcm_ring_fill_ack_status;
        mov r11, 0xABCD;
        cmp rax, r11;
        jne pcmr_w_fail_stage;

        mov rdi, 300;
        mov rsi, 128;
        call pcm_ring_pack_drain_ack;
        mov rbx, rax;
        mov rdi, rbx;
        call pcm_ring_drain_ack_period;
        cmp rax, 300;
        jne pcmr_w_fail_stage;
        mov rdi, rbx;
        call pcm_ring_drain_ack_frames;
        cmp rax, 128;
        jne pcmr_w_fail_stage;

        // S7 refusal edges.
        mov rax, 70;
        lea rcx, [rip + _pcmr_w_stage];
        mov [rcx], rax;

        // FILL_NEXT with buf=0 -> DECODE_BAD.
        xor rdi, rdi;
        mov rsi, 1024;
        call pcm_ring_pack_fill_next_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne pcmr_w_fail_stage;

        // FILL_NEXT with buf > 65535 -> DECODE_BAD.
        mov rdi, 65536;
        mov rsi, 1024;
        call pcm_ring_pack_fill_next_req;
        cmp rax, r11;
        jne pcmr_w_fail_stage;

        // XRUN_NOTIFY with period > 2^40 -> DECODE_BAD.
        mov rdi, 1;
        shl rdi, 41;
        call pcm_ring_pack_xrun_notify_req;
        cmp rax, r11;
        jne pcmr_w_fail_stage;

        // SEEK at 2^56 -> DECODE_BAD.
        mov rdi, 1;
        shl rdi, 56;
        call pcm_ring_pack_seek_req;
        cmp rax, r11;
        jne pcmr_w_fail_stage;

        // DRAIN_ACK with frames >= 2^16 -> DECODE_BAD.
        mov rdi, 300;
        mov rsi, 65536;
        call pcm_ring_pack_drain_ack;
        cmp rax, r11;
        jne pcmr_w_fail_stage;

        // Unpacker on wrong op -> DECODE_BAD.
        mov rdi, 0x11;                   // DRAIN_CURRENT frame
        call pcm_ring_fill_next_req_buf;
        cmp rax, r11;
        jne pcmr_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pcmr_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp pcmr_w_out;

      pcmr_w_fail_stage:
        lea rax, [rip + _pcmr_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pcmr_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pcmr_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
