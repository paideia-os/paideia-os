// tests/kernel/ipc/wifi_data_channel_synth.pdx — R38.M3-005 (#1302)
//
// Boot witness for wifi_data_channel schema.  Asserts verb validator,
// TX/RX_FRAME pack + unpack symmetry, refusals (zero vif, zero buf_ref,
// zero buf_len, out-of-range vif/buf_ref/buf_len).
//
// Fingerprint: R38 WIFI DATA CHAN OK

module WifiDataChannelSynth = structure {

  pub let mut _wdcw_stage : u64 = 0

  pub let wdcw_ok   : [u8; 18] = "WIFI DATA CHAN OK\0"
  pub let wdcw_fail : [u8; 20] = "WIFI DATA CHAN FAIL\0"

  pub let wifi_data_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M3-005 (#1302): boot witness. Stages: (1) verb_valid. (2) TX_FRAME pack + unpack. (3) vif 0 refused. (4) buf_ref 0 refused. (5) buf_len 0 refused. (6) vif out-of-range refused. (7) buf_len out-of-range refused. (8) RX_FRAME pack + unpack (same shape).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wdcw_stage];
        mov [rcx], rax;

        // -- 1. Verb valid.
        mov rdi, 0x80;
        call wdc_verb_valid;
        cmp rax, 1;
        jne wdcw_fail_stage;
        mov rdi, 0x81;
        call wdc_verb_valid;
        cmp rax, 1;
        jne wdcw_fail_stage;
        mov rdi, 0x82;
        call wdc_verb_valid;
        cmp rax, 0;
        jne wdcw_fail_stage;

        // -- 2. TX_FRAME pack + unpack round-trip.
        mov rax, 2;
        lea rcx, [rip + _wdcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0A5;                  // vif
        mov rsi, 0x00DEAD;               // buf_ref
        mov rdx, 0x0001234;              // buf_len
        call wdc_pack_frame;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  wdcw_fail_stage;
        mov r11, 0xFFFFFFFFFFFFFFFE;
        cmp rax, r11;
        je  wdcw_fail_stage;
        mov r11, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r11;
        je  wdcw_fail_stage;

        mov rdi, r15;
        call wdc_frame_vif;
        cmp rax, 0x0A5;
        jne wdcw_fail_stage;
        mov rdi, r15;
        call wdc_frame_buf_ref;
        cmp rax, 0x00DEAD;
        jne wdcw_fail_stage;
        mov rdi, r15;
        call wdc_frame_buf_len;
        cmp rax, 0x0001234;
        jne wdcw_fail_stage;

        // -- 3. vif 0 refused.
        mov rax, 3;
        lea rcx, [rip + _wdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x00DEAD;
        mov rdx, 0x0001234;
        call wdc_pack_frame;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne wdcw_fail_stage;

        // -- 4. buf_ref 0 refused.
        mov rax, 4;
        lea rcx, [rip + _wdcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0A5;
        mov rsi, 0;
        mov rdx, 0x0001234;
        call wdc_pack_frame;
        mov r11, 0xFFFFFFFFFFFFFFFE;
        cmp rax, r11;
        jne wdcw_fail_stage;

        // -- 5. buf_len 0 refused.
        mov rax, 5;
        lea rcx, [rip + _wdcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0A5;
        mov rsi, 0x00DEAD;
        mov rdx, 0;
        call wdc_pack_frame;
        mov r11, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r11;
        jne wdcw_fail_stage;

        // -- 6. vif out-of-range refused (0x1000).
        mov rax, 6;
        lea rcx, [rip + _wdcw_stage];
        mov [rcx], rax;

        mov rdi, 0x1000;
        mov rsi, 0x00DEAD;
        mov rdx, 0x0001234;
        call wdc_pack_frame;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne wdcw_fail_stage;

        // -- 7. buf_len out-of-range refused (0x10000000).
        mov rax, 7;
        lea rcx, [rip + _wdcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0A5;
        mov rsi, 0x00DEAD;
        mov rdx, 0x10000000;
        call wdc_pack_frame;
        mov r11, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r11;
        jne wdcw_fail_stage;

        // -- 8. RX_FRAME pack + unpack (same shape).
        mov rax, 8;
        lea rcx, [rip + _wdcw_stage];
        mov [rcx], rax;

        mov rdi, 0x001;
        mov rsi, 0x000001;
        mov rdx, 0x000001;
        call wdc_pack_frame;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  wdcw_fail_stage;

        mov rdi, r15;
        call wdc_frame_vif;
        cmp rax, 0x001;
        jne wdcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wdcw_ok];
        call klog_s1;

        xor rax, rax;
        jmp wdcw_out;

      wdcw_fail_stage:
        lea rax, [rip + _wdcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wdcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      wdcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
