// tests/kernel/ipc/regdomain_channel_synth.pdx — R38.M6-002 (#1315)
//
// Boot witness for regdomain_channel schema.  Exercises:
//   (1) rdc_source_valid recognises 1/2/3 and refuses 0/4.
//   (2) rdc_cc_valid recognises non-zero 16-bit and refuses 0 / 0x10000.
//   (3) pack + unpack symmetry for the three sources against a
//       (cc = US, ts = 0x12_3456_789A) sample.
//   (4) pack refuses cc == 0 (PACK_BAD_CC).
//   (5) pack refuses source == 0 (PACK_BAD_SOURCE).
//   (6) pack refuses source == 4 (PACK_BAD_SOURCE).
//   (7) pack refuses ts == 0 (PACK_BAD_TS).
//   (8) pack refuses ts >= 2^40 (PACK_BAD_TS).
//   (9) source-byte in packed hint is [1..3], never 0xFF -- the
//       sentinel-vs-payload argument in §1 holds.
//
// Fingerprint: R38 REGDOM CHAN OK

module RegdomainChannelSynth = structure {

  pub let mut _rdcw_stage : u64 = 0

  pub let rdcw_ok   : [u8; 15] = "REGDOM CHAN OK\0"
  pub let rdcw_fail : [u8; 17] = "REGDOM CHAN FAIL\0"

  pub let regdomain_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M6-002 (#1315): boot witness. Stages: (1) source_valid table. (2) cc_valid boundary. (3) pack/unpack symmetry for the three sources. (4) cc=0 PACK_BAD_CC. (5) source=0 PACK_BAD_SOURCE. (6) source=4 PACK_BAD_SOURCE. (7) ts=0 PACK_BAD_TS. (8) ts=2^40 PACK_BAD_TS. (9) sentinel-vs-payload argument.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. source_valid table.
        mov rax, 1;
        lea rcx, [rip + _rdcw_stage];
        mov [rcx], rax;

        mov rdi, 1;                       // EEPROM
        call rdc_source_valid;
        cmp rax, 1;
        jne rdcw_fail_stage;
        mov rdi, 2;                       // GNSS
        call rdc_source_valid;
        cmp rax, 1;
        jne rdcw_fail_stage;
        mov rdi, 3;                       // DEFAULT
        call rdc_source_valid;
        cmp rax, 1;
        jne rdcw_fail_stage;
        mov rdi, 0;
        call rdc_source_valid;
        cmp rax, 0;
        jne rdcw_fail_stage;
        mov rdi, 4;
        call rdc_source_valid;
        cmp rax, 0;
        jne rdcw_fail_stage;

        // -- 2. cc_valid boundary.
        mov rax, 2;
        lea rcx, [rip + _rdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call rdc_cc_valid;
        cmp rax, 0;
        jne rdcw_fail_stage;

        mov rdi, 1;
        call rdc_cc_valid;
        cmp rax, 1;
        jne rdcw_fail_stage;

        mov rdi, 0xFFFF;
        call rdc_cc_valid;
        cmp rax, 1;
        jne rdcw_fail_stage;

        mov rdi, 0x10000;
        call rdc_cc_valid;
        cmp rax, 0;
        jne rdcw_fail_stage;

        // -- 3. pack + unpack symmetry for the three sources.
        mov rax, 3;
        lea rcx, [rip + _rdcw_stage];
        mov [rcx], rax;

        mov rdi, 0x5553;                  // cc = US
        mov rsi, 1;                       // source = EEPROM
        mov rdx, 0x123456789A;            // ts (40-bit)
        call rdc_pack_hint;
        mov r15, rax;
        // Not a sentinel.
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  rdcw_fail_stage;
        mov r11, 0xFFFFFFFFFFFFFFFE;
        cmp rax, r11;
        je  rdcw_fail_stage;
        mov r11, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r11;
        je  rdcw_fail_stage;

        // Expected exact value: (ts << 24) | (src << 16) | cc
        //   = (0x123456789A << 24) | (0x01 << 16) | 0x5553
        //   = 0x123456789A_01_5553
        mov r11, 0x123456789A015553;
        cmp rax, r11;
        jne rdcw_fail_stage;

        mov rdi, r15;
        call rdc_hint_cc;
        mov r11, 0x5553;
        cmp rax, r11;
        jne rdcw_fail_stage;

        mov rdi, r15;
        call rdc_hint_source;
        cmp rax, 1;
        jne rdcw_fail_stage;

        mov rdi, r15;
        call rdc_hint_ts;
        mov r11, 0x123456789A;
        cmp rax, r11;
        jne rdcw_fail_stage;

        // Source = GNSS
        mov rdi, 0x5553;
        mov rsi, 2;
        mov rdx, 0x1;
        call rdc_pack_hint;
        mov r14, rax;
        mov rdi, r14;
        call rdc_hint_source;
        cmp rax, 2;
        jne rdcw_fail_stage;

        // Source = DEFAULT
        mov rdi, 0x5757;                  // WW
        mov rsi, 3;
        mov rdx, 0xFFFFFFFFFF;            // ts = max 40-bit
        call rdc_pack_hint;
        mov r13, rax;
        mov rdi, r13;
        call rdc_hint_source;
        cmp rax, 3;
        jne rdcw_fail_stage;
        mov rdi, r13;
        call rdc_hint_ts;
        mov r11, 0xFFFFFFFFFF;
        cmp rax, r11;
        jne rdcw_fail_stage;

        // -- 4. pack cc=0 refused.
        mov rax, 4;
        lea rcx, [rip + _rdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 1;
        call rdc_pack_hint;
        mov r11, 0xFFFFFFFFFFFFFFFF;      // PACK_BAD_CC
        cmp rax, r11;
        jne rdcw_fail_stage;

        // -- 5. pack source=0 refused.
        mov rax, 5;
        lea rcx, [rip + _rdcw_stage];
        mov [rcx], rax;

        mov rdi, 0x5553;
        mov rsi, 0;
        mov rdx, 1;
        call rdc_pack_hint;
        mov r11, 0xFFFFFFFFFFFFFFFE;      // PACK_BAD_SOURCE
        cmp rax, r11;
        jne rdcw_fail_stage;

        // -- 6. pack source=4 refused.
        mov rax, 6;
        lea rcx, [rip + _rdcw_stage];
        mov [rcx], rax;

        mov rdi, 0x5553;
        mov rsi, 4;
        mov rdx, 1;
        call rdc_pack_hint;
        mov r11, 0xFFFFFFFFFFFFFFFE;
        cmp rax, r11;
        jne rdcw_fail_stage;

        // -- 7. pack ts=0 refused.
        mov rax, 7;
        lea rcx, [rip + _rdcw_stage];
        mov [rcx], rax;

        mov rdi, 0x5553;
        mov rsi, 1;
        mov rdx, 0;
        call rdc_pack_hint;
        mov r11, 0xFFFFFFFFFFFFFFFD;      // PACK_BAD_TS
        cmp rax, r11;
        jne rdcw_fail_stage;

        // -- 8. pack ts >= 2^40 refused.
        mov rax, 8;
        lea rcx, [rip + _rdcw_stage];
        mov [rcx], rax;

        mov rdi, 0x5553;
        mov rsi, 1;
        mov rdx, 0x10000000000;           // 2^40
        call rdc_pack_hint;
        mov r11, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r11;
        jne rdcw_fail_stage;

        // -- 9. sentinel-vs-payload argument: valid packed hint's
        // source byte is 1/2/3 -- never 0xFF -- so PACK_BAD_* is
        // distinguishable from any successful pack.
        mov rax, 9;
        lea rcx, [rip + _rdcw_stage];
        mov [rcx], rax;

        mov rdi, r15;                     // stage-3 sample
        call rdc_hint_source;
        cmp rax, 0xFF;
        je  rdcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rdcw_ok];
        call klog_s1;

        xor rax, rax;
        jmp rdcw_out;

      rdcw_fail_stage:
        lea rax, [rip + _rdcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rdcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      rdcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
