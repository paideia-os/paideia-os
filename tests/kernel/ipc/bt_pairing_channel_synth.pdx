// tests/kernel/ipc/bt_pairing_channel_synth.pdx — R39.M4-003 (#1337)
//
// Boot witness for bt_pairing_channel schema.
//
// Drives the three verbs (begin_pairing, confirm_passkey, complete),
// asserts consent stub returns 1, refuses (0,0) peer, refuses out-of-
// range passkey, and refuses complete before passkey.
//
// Fingerprint: R39 BT PAIRING CHAN OK

module BtPairingChannelSynth = structure {

  pub let mut _bpcw_stage : u64 = 0

  pub let bpcw_ok   : [u8; 24] = "R39 BT PAIRING CHAN OK\n\0"
  pub let bpcw_fail : [u8; 26] = "R39 BT PAIRING CHAN FAIL\n\0"

  pub let bpcw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-003 (#1337): reset bt_pairing_channel session table.",
      block: {
        call bpc_reset;
        ret
      }
    }

  pub let bt_pairing_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M4-003 (#1337): boot witness. Stages: (1) verb valid. (2) verb invalid. (3) begin_pairing (0,0) refused. (4) consent stub returns 1. (5) begin_pairing happy. (6) confirm_passkey bad range refused. (7) confirm_passkey happy. (8) complete happy -> sealed_key_slot with high bit set. (9) complete twice -> ALREADY_COMPLETE.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _bpcw_stage];
        mov [rcx], rax;

        call bpcw_scrub;

        // -- 1. Verb valid.
        mov rdi, 0x90;
        call bpc_verb_valid;
        cmp rax, 1;
        jne bpcw_fail_stage;
        mov rdi, 0x92;
        call bpc_verb_valid;
        cmp rax, 1;
        jne bpcw_fail_stage;

        // -- 2. Verb invalid.
        mov rax, 2;
        lea rcx, [rip + _bpcw_stage];
        mov [rcx], rax;

        mov rdi, 0x8F;
        call bpc_verb_valid;
        cmp rax, 0;
        jne bpcw_fail_stage;
        mov rdi, 0x93;
        call bpc_verb_valid;
        cmp rax, 0;
        jne bpcw_fail_stage;

        // -- 3. begin_pairing (0,0) refused.
        mov rax, 3;
        lea rcx, [rip + _bpcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call bpc_begin_pairing;
        mov r11, 0xFFFFF2DE;             // BAD_PEER
        cmp rax, r11;
        jne bpcw_fail_stage;

        // -- 4. Consent stub returns 1.
        mov rax, 4;
        lea rcx, [rip + _bpcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call bpc_broker_request;
        cmp rax, 1;
        jne bpcw_fail_stage;

        // -- 5. begin_pairing happy.
        mov rax, 5;
        lea rcx, [rip + _bpcw_stage];
        mov [rcx], rax;

        mov rdi, 0xAABBCCDD;
        mov rsi, 0x11223344;
        call bpc_begin_pairing;
        cmp rax, 0;                      // pair_slot 0
        jne bpcw_fail_stage;
        mov r14, rax;                    // pair_slot

        // Verify consent_flag readback.
        mov rdi, r14;
        call bpc_consent_of;
        cmp rax, 1;
        jne bpcw_fail_stage;

        // Verify state == AWAITING_PASSKEY (1).
        mov rdi, r14;
        call bpc_state_of;
        cmp rax, 1;
        jne bpcw_fail_stage;

        // -- 6. confirm_passkey bad range refused.
        mov rax, 6;
        lea rcx, [rip + _bpcw_stage];
        mov [rcx], rax;

        mov rdi, r14;
        mov rsi, 1000000;                // > 999999
        call bpc_confirm_passkey;
        mov r11, 0xFFFFF2D7;             // PASSKEY_INVALID
        cmp rax, r11;
        jne bpcw_fail_stage;

        // -- 7. confirm_passkey happy.
        mov rax, 7;
        lea rcx, [rip + _bpcw_stage];
        mov [rcx], rax;

        mov rdi, r14;
        mov rsi, 123456;
        call bpc_confirm_passkey;
        cmp rax, 0;
        jne bpcw_fail_stage;

        // Verify state == PASSKEY_OK (2).
        mov rdi, r14;
        call bpc_state_of;
        cmp rax, 2;
        jne bpcw_fail_stage;

        // -- 8. complete happy -> sealed_key_slot high bit set.
        mov rax, 8;
        lea rcx, [rip + _bpcw_stage];
        mov [rcx], rax;

        mov rdi, r14;
        call bpc_complete;
        mov r15, rax;
        // High bit must be set.
        mov r11, 0x80000000;
        mov rax, r15;
        and rax, r11;
        cmp rax, r11;
        jne bpcw_fail_stage;

        // Verify state == COMPLETE (3).
        mov rdi, r14;
        call bpc_state_of;
        cmp rax, 3;
        jne bpcw_fail_stage;

        // -- 9. complete twice -> ALREADY_COMPLETE.
        mov rax, 9;
        lea rcx, [rip + _bpcw_stage];
        mov [rcx], rax;

        mov rdi, r14;
        call bpc_complete;
        mov r11, 0xFFFFF2D5;             // ALREADY_COMPLETE
        cmp rax, r11;
        jne bpcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bpcw_ok];
        call klog_s1;

        call bpcw_scrub;
        xor rax, rax;
        jmp bpcw_out;

      bpcw_fail_stage:
        lea rax, [rip + _bpcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bpcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call bpcw_scrub;
        mov rax, 1;

      bpcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
