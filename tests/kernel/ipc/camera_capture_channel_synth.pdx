// tests/kernel/ipc/camera_capture_channel_synth.pdx — R40.M3-003 (#1357)
//
// Boot witness for camera_capture_channel.  Asserts session FSM
// discipline: open -> configure -> begin -> frame* -> end -> close,
// each transition's BAD_STATE from wrong entry state, frame BAD_BO
// on bo_slot=0, configure BAD_FORMAT/DIM/FPS, packer/unpacker
// round-trip, and counter fanout.
//
// Fingerprint: R40 CAM CAPTURE CHAN OK

module CameraCaptureChannelSynth = structure {

  pub let mut _cccw_stage : u64 = 0

  pub let cccw_ok   : [u8; 24] = "R40 CAM CAPTURE CHAN OK\n\0"
  pub let cccw_fail : [u8; 26] = "R40 CAM CAPTURE CHAN FAIL\n\0"

  pub let camera_capture_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R40.M3-003 (#1357): boot witness. Stages: (1) reset + validators. (2) BAD_STATE (configure before open, frame before begin, end before begin, close from CLOSED). (3) open BAD_STREAM (slot=0). (4) Happy open. (5) BAD_STATE (open when OPENED). (6) configure BAD_FORMAT/BAD_DIM/BAD_FPS. (7) Happy configure. (8) begin_stream. (9) frame BAD_BO. (10) frame chain (three). (11) end_stream. (12) close. (13) packer round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        call ccc_reset;

        // -- 1. Op validators.
        mov rdi, 0x60;
        call ccc_op_valid;
        cmp rax, 1;
        jne cccw_fail_stage;
        mov rdi, 0x65;
        call ccc_op_valid;
        cmp rax, 1;
        jne cccw_fail_stage;
        mov rdi, 0x5F;
        call ccc_op_valid;
        cmp rax, 0;
        jne cccw_fail_stage;
        mov rdi, 0x66;
        call ccc_op_valid;
        cmp rax, 0;
        jne cccw_fail_stage;

        mov rdi, 1;
        call ccc_format_valid;
        cmp rax, 1;
        jne cccw_fail_stage;
        mov rdi, 4;
        call ccc_format_valid;
        cmp rax, 0;
        jne cccw_fail_stage;

        // -- 2. BAD_STATE guards from CLOSED.
        mov rax, 2;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 1920;
        mov rdx, 1080;
        mov rcx, 30;
        call ccc_configure;
        mov r11, 0xFFFFF1DE;
        cmp rax, r11;
        jne cccw_fail_stage;

        call ccc_begin_stream;
        mov r11, 0xFFFFF1DE;
        cmp rax, r11;
        jne cccw_fail_stage;

        mov rdi, 0x100;
        call ccc_frame;
        mov r11, 0xFFFFF1D7;             // NOT_STREAMING
        cmp rax, r11;
        jne cccw_fail_stage;

        call ccc_end_stream;
        mov r11, 0xFFFFF1DE;
        cmp rax, r11;
        jne cccw_fail_stage;

        call ccc_close;
        mov r11, 0xFFFFF1DE;
        cmp rax, r11;
        jne cccw_fail_stage;

        // -- 3. open BAD_STREAM.
        mov rax, 3;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call ccc_open;
        mov r11, 0xFFFFF1DA;
        cmp rax, r11;
        jne cccw_fail_stage;

        // -- 4. Happy open.
        mov rax, 4;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        mov rdi, 59;                     // simulated KIND_IPU6_STREAM slot
        call ccc_open;
        cmp rax, 0;
        jne cccw_fail_stage;

        call ccc_fsm_get;
        cmp rax, 1;                      // OPENED
        jne cccw_fail_stage;

        call ccc_stream_slot_get;
        cmp rax, 59;
        jne cccw_fail_stage;

        // -- 5. BAD_STATE (open when OPENED).
        mov rax, 5;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        mov rdi, 60;
        call ccc_open;
        mov r11, 0xFFFFF1DE;
        cmp rax, r11;
        jne cccw_fail_stage;

        // -- 6. configure refusals.
        mov rax, 6;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // BAD_FORMAT
        mov rsi, 1920;
        mov rdx, 1080;
        mov rcx, 30;
        call ccc_configure;
        mov r11, 0xFFFFF1DD;
        cmp rax, r11;
        jne cccw_fail_stage;

        mov rdi, 1;
        mov rsi, 8193;                   // BAD_DIM
        mov rdx, 1080;
        mov rcx, 30;
        call ccc_configure;
        mov r11, 0xFFFFF1DC;
        cmp rax, r11;
        jne cccw_fail_stage;

        mov rdi, 1;
        mov rsi, 1920;
        mov rdx, 1080;
        mov rcx, 121;                    // BAD_FPS
        call ccc_configure;
        mov r11, 0xFFFFF1DB;
        cmp rax, r11;
        jne cccw_fail_stage;

        // -- 7. Happy configure.
        mov rax, 7;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // NV12
        mov rsi, 1920;
        mov rdx, 1080;
        mov rcx, 30;
        call ccc_configure;
        cmp rax, 0;
        jne cccw_fail_stage;

        call ccc_fsm_get;
        cmp rax, 2;                      // CONFIGURED
        jne cccw_fail_stage;

        // -- 8. begin_stream.
        mov rax, 8;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        call ccc_begin_stream;
        cmp rax, 0;
        jne cccw_fail_stage;

        call ccc_fsm_get;
        cmp rax, 3;                      // STREAMING
        jne cccw_fail_stage;

        // -- 9. frame BAD_BO.
        mov rax, 9;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call ccc_frame;
        mov r11, 0xFFFFF1D9;
        cmp rax, r11;
        jne cccw_fail_stage;

        // -- 10. Frame chain: three frames with distinct bo_slots.
        mov rax, 10;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        mov rdi, 0x101;
        call ccc_frame;
        cmp rax, 0;
        jne cccw_fail_stage;
        mov rdi, 0x102;
        call ccc_frame;
        cmp rax, 0;
        jne cccw_fail_stage;
        mov rdi, 0x103;
        call ccc_frame;
        cmp rax, 0;
        jne cccw_fail_stage;

        call ccc_frames_get;
        cmp rax, 3;
        jne cccw_fail_stage;

        call ccc_last_bo_get;
        cmp rax, 0x103;
        jne cccw_fail_stage;

        // -- 11. end_stream.
        mov rax, 11;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        call ccc_end_stream;
        cmp rax, 0;
        jne cccw_fail_stage;

        call ccc_fsm_get;
        cmp rax, 2;                      // back to CONFIGURED
        jne cccw_fail_stage;

        // -- 12. close.
        mov rax, 12;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        call ccc_close;
        cmp rax, 0;
        jne cccw_fail_stage;

        call ccc_fsm_get;
        cmp rax, 0;                      // CLOSED
        jne cccw_fail_stage;

        // -- 13. Packer round-trip: frame reply pack + unpack.
        mov rax, 13;
        lea rcx, [rip + _cccw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234;
        call ccc_pack_frame_reply;
        mov r12, rax;                    // save packed
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r11;
        je  cccw_fail_stage;

        mov rdi, r12;
        call ccc_op_of;
        cmp rax, 0x63;
        jne cccw_fail_stage;

        mov rdi, r12;
        call ccc_bo_slot_of;
        cmp rax, 0x1234;
        jne cccw_fail_stage;

        // Pack refuses bo_slot=0.
        mov rdi, 0;
        call ccc_pack_frame_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cccw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cccw_ok];
        call klog_s1;

        call ccc_reset;
        xor rax, rax;
        jmp cccw_out;

      cccw_fail_stage:
        lea rax, [rip + _cccw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cccw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ccc_reset;
        mov rax, 1;

      cccw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
