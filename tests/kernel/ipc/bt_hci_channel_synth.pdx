// tests/kernel/ipc/bt_hci_channel_synth.pdx — R39.M1-004 (#1326)
//
// Boot witness for bt_hci_channel schema.
//
// Asserts verb validator, opcode OGF/OCF pack + unpack symmetry against
// the canonical M1 corpus (RESET, READ_LOCAL_VERSION, LE_SET_SCAN_ENABLE),
// and the session FSM: open -> send_cmd -> recv_evt -> close, with the
// two illegal transitions (double send_cmd, recv_evt before send_cmd)
// refused.
//
// Fingerprint: R39 BT HCI CHAN OK

module BtHciChannelSynth = structure {

  pub let mut _bhcw_stage : u64 = 0

  pub let bhcw_ok   : [u8; 16] = "BT HCI CHAN OK\0"
  pub let bhcw_fail : [u8; 18] = "BT HCI CHAN FAIL\0"

  pub let bhcw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): reset session table.",
      block: {
        call bhc_reset;
        ret
      }
    }

  pub let bt_hci_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M1-004 (#1326): boot witness. Stages: (1) verb validator. (2) opcode pack RESET / READ_LOCAL_VERSION / LE_SET_SCAN_ENABLE + unpack OGF/OCF. (3) opcode BAD_OPCODE (OGF > 63). (4) opcode BAD_OPCODE (OCF > 1023). (5) open -> session 0. (6) send_cmd RESET on session 0 -> AWAITING_EVT. (7) send_cmd refused in AWAITING_EVT (BAD_STATE). (8) recv_evt in AWAITING_EVT -> OPEN. (9) recv_evt refused in OPEN. (10) recv_evt BAD_EVT_CODE. (11) close -> free slot. (12) double close refused.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        call bhcw_scrub;

        // -- 1. Verb validator.
        mov rdi, 0xA0;
        call bhc_verb_valid;
        cmp rax, 1;
        jne bhcw_fail_stage;
        mov rdi, 0xA3;
        call bhc_verb_valid;
        cmp rax, 1;
        jne bhcw_fail_stage;
        mov rdi, 0x9F;
        call bhc_verb_valid;
        cmp rax, 0;
        jne bhcw_fail_stage;
        mov rdi, 0xA4;
        call bhc_verb_valid;
        cmp rax, 0;
        jne bhcw_fail_stage;

        // -- 2. Opcode pack + unpack for canonical corpus.
        mov rax, 2;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        // RESET = OGF 0x03, OCF 0x003 -> 0x0C03.
        mov rdi, 0x03;
        mov rsi, 0x003;
        call bhc_opcode_pack;
        mov r11, 0x0C03;
        cmp rax, r11;
        jne bhcw_fail_stage;

        mov rdi, 0x0C03;
        call bhc_opcode_ogf;
        cmp rax, 0x03;
        jne bhcw_fail_stage;

        mov rdi, 0x0C03;
        call bhc_opcode_ocf;
        cmp rax, 0x003;
        jne bhcw_fail_stage;

        // READ_LOCAL_VERSION = OGF 0x04, OCF 0x001 -> 0x1001.
        mov rdi, 0x04;
        mov rsi, 0x001;
        call bhc_opcode_pack;
        mov r11, 0x1001;
        cmp rax, r11;
        jne bhcw_fail_stage;

        // LE_SET_SCAN_ENABLE = OGF 0x08, OCF 0x00C -> 0x200C.
        mov rdi, 0x08;
        mov rsi, 0x00C;
        call bhc_opcode_pack;
        mov r11, 0x200C;
        cmp rax, r11;
        jne bhcw_fail_stage;

        // -- 3. Opcode BAD_OPCODE (OGF > 63).
        mov rax, 3;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        mov rdi, 64;
        mov rsi, 0;
        call bhc_opcode_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bhcw_fail_stage;

        // -- 4. Opcode BAD_OPCODE (OCF > 1023).
        mov rax, 4;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1024;
        call bhc_opcode_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bhcw_fail_stage;

        // -- 5. open -> session 0.
        mov rax, 5;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234;                 // synthetic chan_slot
        call bhc_open;
        cmp rax, 0;
        jne bhcw_fail_stage;
        mov r15, rax;                    // session_id

        // State should be OPEN (1).
        mov rdi, r15;
        call bhc_state_of;
        cmp rax, 1;
        jne bhcw_fail_stage;

        // -- 6. send_cmd RESET.
        mov rax, 6;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        mov rsi, 0x0C03;
        mov rdx, 0;
        call bhc_send_cmd;
        cmp rax, 0;
        jne bhcw_fail_stage;

        // State should be AWAITING_EVT (2).
        mov rdi, r15;
        call bhc_state_of;
        cmp rax, 2;
        jne bhcw_fail_stage;

        // opcode_of should be 0x0C03.
        mov rdi, r15;
        call bhc_opcode_of;
        mov r11, 0x0C03;
        cmp rax, r11;
        jne bhcw_fail_stage;

        // -- 7. send_cmd refused in AWAITING_EVT (BAD_STATE).
        mov rax, 7;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        mov rsi, 0x1001;
        mov rdx, 0;
        call bhc_send_cmd;
        mov r11, 0xFFFFF11A;             // BAD_STATE
        cmp rax, r11;
        jne bhcw_fail_stage;

        // -- 8. recv_evt in AWAITING_EVT -> OPEN.
        mov rax, 8;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        mov rsi, 0x0E;                   // Command Complete
        call bhc_recv_evt;
        cmp rax, 0;
        jne bhcw_fail_stage;

        mov rdi, r15;
        call bhc_state_of;
        cmp rax, 1;                      // OPEN
        jne bhcw_fail_stage;

        mov rdi, r15;
        call bhc_last_evt;
        cmp rax, 0x0E;
        jne bhcw_fail_stage;

        // -- 9. recv_evt refused in OPEN (BAD_STATE).
        mov rax, 9;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        mov rsi, 0x0E;
        call bhc_recv_evt;
        mov r11, 0xFFFFF11A;             // BAD_STATE
        cmp rax, r11;
        jne bhcw_fail_stage;

        // -- 10. recv_evt BAD_EVT_CODE (> 255) after entering AWAITING_EVT.
        mov rax, 10;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        mov rsi, 0x0C03;
        mov rdx, 0;
        call bhc_send_cmd;
        cmp rax, 0;
        jne bhcw_fail_stage;

        mov rdi, r15;
        mov rsi, 256;
        call bhc_recv_evt;
        mov r11, 0xFFFFF118;             // BAD_EVT_CODE
        cmp rax, r11;
        jne bhcw_fail_stage;

        // Return to OPEN via a valid evt.
        mov rdi, r15;
        mov rsi, 0x0F;
        call bhc_recv_evt;
        cmp rax, 0;
        jne bhcw_fail_stage;

        // -- 11. close -> ok.
        mov rax, 11;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        call bhc_close;
        cmp rax, 0;
        jne bhcw_fail_stage;

        // -- 12. Double close refused (session now inactive).
        mov rax, 12;
        lea rcx, [rip + _bhcw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        call bhc_close;
        mov r11, 0xFFFFF11B;             // NOT_ACTIVE
        cmp rax, r11;
        jne bhcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bhcw_ok];
        call klog_s1;

        call bhcw_scrub;
        xor rax, rax;
        jmp bhcw_out;

      bhcw_fail_stage:
        lea rax, [rip + _bhcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bhcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call bhcw_scrub;
        mov rax, 1;

      bhcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
