// tests/kernel/ipc/color_management_channel_synth.pdx -- G6.M1-004 (#1512)
//
// Boot witness for the color_management_channel schema.
//
// Fingerprint: G6 COLOR_MGMT_CHAN OK

module ColorManagementChannelSynth = structure {

  pub let mut _cmw_stage : u64 = 0

  pub let cmw_ok   : [u8; 22] = "G6 COLOR_MGMT_CHAN OK\0"
  pub let cmw_fail : [u8; 24] = "G6 COLOR_MGMT_CHAN FAIL\0"

  pub let color_management_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G6.M1-004 (#1512): schema witness. Stages: (1) reset. (2) ev_valid. (3) prim_valid. (4) size_valid. (5) lum_valid. (6) query_gamut apply. (7) get_tonemap apply. (8) set_ref_dpy apply. (9) refuse min>=max. Three-push discipline for rsp%16 == 0 before inner calls.",
      block: {
        push rbx;
        push r12;
        push r13;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _cmw_stage];
        mov [rcx], rax;
        call cmc_stats_reset;

        // 2. ev.
        mov rax, 2;
        lea rcx, [rip + _cmw_stage];
        mov [rcx], rax;
        mov rdi, 0xE0;
        call cmc_ev_valid;
        cmp rax, 1;
        jne cmw_fail_stage;
        mov rdi, 0xE3;
        call cmc_ev_valid;
        cmp rax, 0;
        jne cmw_fail_stage;

        // 3. prim.
        mov rax, 3;
        lea rcx, [rip + _cmw_stage];
        mov [rcx], rax;
        mov rdi, 4;
        call cmc_prim_valid;
        cmp rax, 1;
        jne cmw_fail_stage;
        mov rdi, 5;
        call cmc_prim_valid;
        cmp rax, 0;
        jne cmw_fail_stage;

        // 4. size.
        mov rax, 4;
        lea rcx, [rip + _cmw_stage];
        mov [rcx], rax;
        mov rdi, 32;
        call cmc_size_valid;
        cmp rax, 1;
        jne cmw_fail_stage;
        mov rdi, 65;
        call cmc_size_valid;
        cmp rax, 0;
        jne cmw_fail_stage;

        // 5. lum.
        mov rax, 5;
        lea rcx, [rip + _cmw_stage];
        mov [rcx], rax;
        mov rdi, 1000;
        call cmc_lum_valid;
        cmp rax, 1;
        jne cmw_fail_stage;
        mov rdi, 10001;
        call cmc_lum_valid;
        cmp rax, 0;
        jne cmw_fail_stage;

        // 6. query_gamut: slot 0 (even) -> PRIM_SRGB=1.
        mov rax, 6;
        lea rcx, [rip + _cmw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call cmc_apply_query_gamut;
        cmp rax, 1;
        jne cmw_fail_stage;

        // 7. get_tonemap(sRGB, REC2020, 32) -> ok.
        mov rax, 7;
        lea rcx, [rip + _cmw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 4;
        mov rdx, 32;
        call cmc_apply_get_tonemap;
        cmp rax, 0;
        jne cmw_fail_stage;

        // 8. set_ref_dpy(REC2020, 1000, 1) -> ok.
        mov rax, 8;
        lea rcx, [rip + _cmw_stage];
        mov [rcx], rax;
        mov rdi, 4;
        mov rsi, 1000;
        mov rdx, 1;
        call cmc_apply_set_ref_dpy;
        cmp rax, 0;
        jne cmw_fail_stage;

        // 9. Refuse min >= max.
        mov rax, 9;
        lea rcx, [rip + _cmw_stage];
        mov [rcx], rax;
        mov rdi, 4;
        mov rsi, 100;
        mov rdx, 100;
        call cmc_apply_set_ref_dpy;
        mov r10, 0xFFFFEDFB;
        cmp rax, r10;
        jne cmw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cmw_ok];
        call klog_s1;
        xor rax, rax;
        jmp cmw_out;

      cmw_fail_stage:
        lea rax, [rip + _cmw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cmw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      cmw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
