// tests/kernel/ipc/pcie_hotplug_channel_synth.pdx — R35.M1-003 (#1197)
//
// Boot witness for the pcie_hotplug_channel schema.
//
// Asserts word0 pack / unpack round-trips, subscriber add / remove /
// duplicate refusal, fanout by bdf match + wildcard, delivery
// accounting.
//
// Fingerprint: R35 PCIE HOTPLUG CHAN OK

module PcieHotplugChannelSynth = structure {

  pub let mut _phcw_stage : u64 = 0

  pub let phcw_ok   : [u8; 22] = "PCIE HOTPLUG CHAN OK\n\0"
  pub let phcw_fail : [u8; 24] = "PCIE HOTPLUG CHAN FAIL\n\0"

  pub let pcie_hotplug_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M1-003 (#1197): boot witness. Stages: (1) reset. (2) pack/unpack round-trip. (3) refuse malformed. (4) subscriber add + remove. (5) duplicate refused. (6) fanout by bdf match. (7) fanout by wildcard. (8) refuse bad event on enqueue.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _phcw_stage];
        mov [rcx], rax;

        call pcie_hotplug_channel_reset;

        // -- 2. Pack/unpack round-trip.
        mov rax, 2;
        lea rcx, [rip + _phcw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // event_type
        mov rsi, 0x0100;                 // bdf
        mov rdx, 0x0108;                 // port_status
        call phc_pack_word0;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r15, r11;
        je  phcw_fail_stage;

        mov rdi, r15;
        call phc_word0_event;
        cmp rax, 1;
        jne phcw_fail_stage;

        mov rdi, r15;
        call phc_word0_bdf;
        cmp rax, 0x0100;
        jne phcw_fail_stage;

        mov rdi, r15;
        call phc_word0_status;
        cmp rax, 0x0108;
        jne phcw_fail_stage;

        // -- 3. Refuse malformed (event > 3).
        mov rax, 3;
        lea rcx, [rip + _phcw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 0x0100;
        mov rdx, 0x0108;
        call phc_pack_word0;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne phcw_fail_stage;

        // -- 4. Subscriber add + remove.
        mov rax, 4;
        lea rcx, [rip + _phcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0100;                 // bdf
        mov rsi, 0xE1;                   // endpoint
        call phc_sub_add;
        mov r15, rax;                    // row_id 0
        cmp r15, 0;
        jne phcw_fail_stage;

        mov rdi, r15;
        call phc_sub_row_bdf;
        cmp rax, 0x0100;
        jne phcw_fail_stage;

        mov rdi, r15;
        call phc_sub_row_endpoint;
        cmp rax, 0xE1;
        jne phcw_fail_stage;

        // -- 5. Duplicate refused.
        mov rax, 5;
        lea rcx, [rip + _phcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0100;                 // same bdf
        mov rsi, 0xE1;                   // same endpoint
        call phc_sub_add;
        mov r11, 0xFFFFFA18;             // IN_USE
        cmp rax, r11;
        jne phcw_fail_stage;

        // -- 6. Fanout by bdf match.
        mov rax, 6;
        lea rcx, [rip + _phcw_stage];
        mov [rcx], rax;

        // Enqueue on bdf 0x0100; sub 0 receives.
        mov rdi, 0x0100;
        mov rsi, 0;                      // event_type
        mov rdx, 0x0108;                 // port_status
        call pcie_hotplug_channel_enqueue;
        cmp rax, 0;
        jne phcw_fail_stage;

        mov rdi, 0;                      // row 0
        call phc_sub_row_delivered;
        cmp rax, 1;
        jne phcw_fail_stage;

        // Enqueue on unrelated bdf 0x0200; sub 0 unchanged.
        mov rdi, 0x0200;
        mov rsi, 0;
        mov rdx, 0;
        call pcie_hotplug_channel_enqueue;
        cmp rax, 0;
        jne phcw_fail_stage;

        mov rdi, 0;
        call phc_sub_row_delivered;
        cmp rax, 1;                      // still 1
        jne phcw_fail_stage;

        // -- 7. Wildcard subscriber receives every event.
        mov rax, 7;
        lea rcx, [rip + _phcw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // bdf 0 = wildcard
        mov rsi, 0xE2;
        call phc_sub_add;
        mov r15, rax;                    // row 1

        mov rdi, 0x0300;
        mov rsi, 0;
        mov rdx, 0;
        call pcie_hotplug_channel_enqueue;
        cmp rax, 0;
        jne phcw_fail_stage;

        mov rdi, r15;
        call phc_sub_row_delivered;
        cmp rax, 1;
        jne phcw_fail_stage;

        // -- 8. Refuse bad event on enqueue.
        mov rax, 8;
        lea rcx, [rip + _phcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0100;
        mov rsi, 4;                      // out of range
        mov rdx, 0;
        call pcie_hotplug_channel_enqueue;
        mov r11, 0xFFFFFA1D;             // BAD_EVENT
        cmp rax, r11;
        jne phcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + phcw_ok];
        call klog_s1;

        call pcie_hotplug_channel_reset;
        xor rax, rax;
        jmp phcw_out;

      phcw_fail_stage:
        lea rax, [rip + _phcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + phcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pcie_hotplug_channel_reset;
        mov rax, 1;

      phcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
