// tests/kernel/ipc/text_shape_channel_synth.pdx -- G5.M2-003 (#1498)
//
// Boot witness for text_shape_channel. Exercises event/slot
// validators, geom/scale packers, features_hash pass-through, and
// apply_invalidate refusal on unmapped slot.
//
// Fingerprint: G5 TEXT_SHAPE_CHAN OK

module TextShapeChannelSynth = structure {

  pub let mut _tscw_stage : u64 = 0

  pub let tscw_ok   : [u8; 21] = "G5 TEXT_SHAPE_CHAN OK\0"
  pub let tscw_fail : [u8; 23] = "G5 TEXT_SHAPE_CHAN FAIL\0"

  pub let text_shape_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G5.M2-003 (#1498): boot witness. Stages: (1) reset. (2) ev_valid. (3) slot_valid. (4) pack_geom. (5) pack_scale. (6) apply_features_hash happy + refused. (7) apply_invalidate on unmapped slot -> NO_SHAPE.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _tscw_stage];
        mov [rcx], rax;
        call tsc_stats_reset;
        call ts_table_reset;

        // 2. ev_valid: 0xD3 / 0xD5 / 0xD6.
        mov rax, 2;
        lea rcx, [rip + _tscw_stage];
        mov [rcx], rax;
        mov rdi, 0xD3;
        call tsc_ev_valid;
        cmp rax, 1;
        jne tscw_fail_stage;
        mov rdi, 0xD5;
        call tsc_ev_valid;
        cmp rax, 1;
        jne tscw_fail_stage;
        mov rdi, 0xD6;
        call tsc_ev_valid;
        cmp rax, 0;
        jne tscw_fail_stage;

        // 3. slot_valid.
        mov rax, 3;
        lea rcx, [rip + _tscw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        call tsc_slot_valid;
        cmp rax, 1;
        jne tscw_fail_stage;
        mov rdi, 256;
        call tsc_slot_valid;
        cmp rax, 0;
        jne tscw_fail_stage;

        // 4. pack_geom: (50, 800, 24) -> 0x00180320_0032.
        //   glyph 50, w 800 (0x320), h 24 (0x18).
        mov rax, 4;
        lea rcx, [rip + _tscw_stage];
        mov [rcx], rax;
        mov rdi, 50;
        mov rsi, 800;
        mov rdx, 24;
        call tsc_pack_geom;
        mov r12, rax;
        // Read back glyph_count.
        mov rax, r12;
        and rax, 0xFFFF;
        cmp rax, 50;
        jne tscw_fail_stage;
        // Read back ext_w.
        mov rax, r12;
        shr rax, 16;
        and rax, 0xFFFF;
        cmp rax, 800;
        jne tscw_fail_stage;
        // Refuse out-of-range.
        mov rdi, 0x10000;
        mov rsi, 100;
        mov rdx, 100;
        call tsc_pack_geom;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        jne tscw_fail_stage;

        // 5. pack_scale: (3, 2) unpacks; (5, 0) refused.
        mov rax, 5;
        lea rcx, [rip + _tscw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 2;
        call tsc_pack_scale;
        mov r12, rax;
        mov rax, r12;
        and rax, 0xFFFF;
        cmp rax, 3;
        jne tscw_fail_stage;
        mov rax, r12;
        shr rax, 16;
        and rax, 0xFFFF;
        cmp rax, 2;
        jne tscw_fail_stage;
        mov rdi, 5;
        mov rsi, 0;
        call tsc_pack_scale;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        jne tscw_fail_stage;

        // 6. apply_features_hash: KERN -> non-zero hash; 0x100 refused.
        mov rax, 6;
        lea rcx, [rip + _tscw_stage];
        mov [rcx], rax;
        mov rdi, 1;                         // KERN
        call tsc_apply_features_hash;
        cmp rax, 0;
        je  tscw_fail_stage;
        mov rdi, 0x100;
        call tsc_apply_features_hash;
        mov r10, 0xFFFFEDDA;
        cmp rax, r10;
        jne tscw_fail_stage;

        // 7. apply_invalidate on unmapped slot 42 -> NO_SHAPE.
        mov rax, 7;
        lea rcx, [rip + _tscw_stage];
        mov [rcx], rax;
        mov rdi, 42;
        call tsc_apply_invalidate;
        mov r10, 0xFFFFEDD7;
        cmp rax, r10;
        jne tscw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tscw_ok];
        call klog_s1;

        call tsc_stats_reset;
        call ts_table_reset;
        xor rax, rax;
        jmp tscw_out;

      tscw_fail_stage:
        lea rax, [rip + _tscw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tscw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call tsc_stats_reset;
        call ts_table_reset;
        mov rax, 1;

      tscw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
