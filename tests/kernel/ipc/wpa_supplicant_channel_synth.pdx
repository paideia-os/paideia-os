// tests/kernel/ipc/wpa_supplicant_channel_synth.pdx — R38.M5-005 (#1313)
//
// Boot witness for wpa_supplicant_channel schema.  Asserts verb
// validator, pack + unpack symmetry for the three verbs, and
// refusals (zero slot, zero ref, key_id > 7).
//
// Fingerprint: R38 WPA SUPP CHAN OK

module WpaSupplicantChannelSynth = structure {

  pub let mut _wscw_stage : u64 = 0

  pub let wscw_ok   : [u8; 17] = "WPA SUPP CHAN OK\n\0"
  pub let wscw_fail : [u8; 19] = "WPA SUPP CHAN FAIL\n\0"

  pub let wpa_supplicant_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M5-005 (#1313): boot witness. Stages: (1) verb_valid. (2) derive_ptk pack + unpack. (3) derive_ptk pmk=0 refused. (4) install_gtk pack + unpack. (5) install_gtk kid=8 refused. (6) install_ptk pack + unpack. (7) install_ptk ptk=0 refused.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wscw_stage];
        mov [rcx], rax;

        // -- 1. Verb valid.
        mov rdi, 0x90;
        call wsc_verb_valid;
        cmp rax, 1;
        jne wscw_fail_stage;
        mov rdi, 0x92;
        call wsc_verb_valid;
        cmp rax, 1;
        jne wscw_fail_stage;
        mov rdi, 0x93;
        call wsc_verb_valid;
        cmp rax, 0;
        jne wscw_fail_stage;
        mov rdi, 0x00;
        call wsc_verb_valid;
        cmp rax, 0;
        jne wscw_fail_stage;

        // -- 2. Derive PTK pack + unpack.
        mov rax, 2;
        lea rcx, [rip + _wscw_stage];
        mov [rcx], rax;

        mov rdi, 0x00A1;                 // pmk_key_slot
        mov rsi, 0x00CDEF;               // anonce_ref (24-bit)
        mov rdx, 0x00BEEF;               // snonce_ref (24-bit)
        call wsc_pack_derive_ptk;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  wscw_fail_stage;
        mov r11, 0xFFFFFFFFFFFFFFFE;
        cmp rax, r11;
        je  wscw_fail_stage;
        mov r11, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r11;
        je  wscw_fail_stage;

        mov rdi, r15;
        call wsc_derive_pmk;
        cmp rax, 0x00A1;
        jne wscw_fail_stage;
        mov rdi, r15;
        call wsc_derive_anonce;
        cmp rax, 0x00CDEF;
        jne wscw_fail_stage;
        mov rdi, r15;
        call wsc_derive_snonce;
        cmp rax, 0x00BEEF;
        jne wscw_fail_stage;

        // -- 3. Derive PTK pmk=0 refused.
        mov rax, 3;
        lea rcx, [rip + _wscw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x00CDEF;
        mov rdx, 0x00BEEF;
        call wsc_pack_derive_ptk;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne wscw_fail_stage;

        // -- 4. Install GTK pack + unpack.
        mov rax, 4;
        lea rcx, [rip + _wscw_stage];
        mov [rcx], rax;

        mov rdi, 0x00123456;             // gtk_material_ref (24-bit)
        mov rsi, 3;                      // key_id
        call wsc_pack_install_gtk;
        mov r15, rax;
        // Expect: 0x03_123456
        mov r11, 0x03123456;
        cmp rax, r11;
        jne wscw_fail_stage;

        mov rdi, r15;
        call wsc_install_gtk_ref;
        cmp rax, 0x00123456;
        jne wscw_fail_stage;
        mov rdi, r15;
        call wsc_install_gtk_kid;
        cmp rax, 3;
        jne wscw_fail_stage;

        // -- 5. Install GTK kid=8 refused.
        mov rax, 5;
        lea rcx, [rip + _wscw_stage];
        mov [rcx], rax;

        mov rdi, 0x00123456;
        mov rsi, 8;
        call wsc_pack_install_gtk;
        mov r11, 0xFFFFFFFFFFFFFFFE;
        cmp rax, r11;
        jne wscw_fail_stage;

        // -- 6. Install PTK pack + unpack.
        mov rax, 6;
        lea rcx, [rip + _wscw_stage];
        mov [rcx], rax;

        mov rdi, 0x00A2;                 // ptk_slot
        mov rsi, 4;                      // key_id (pairwise per 802.11)
        call wsc_pack_install_ptk;
        mov r15, rax;
        // Expect: 0x04_00A2
        mov r11, 0x0400A2;
        cmp rax, r11;
        jne wscw_fail_stage;

        mov rdi, r15;
        call wsc_install_ptk_slot;
        cmp rax, 0x00A2;
        jne wscw_fail_stage;
        mov rdi, r15;
        call wsc_install_ptk_kid;
        cmp rax, 4;
        jne wscw_fail_stage;

        // -- 7. Install PTK ptk=0 refused.
        mov rax, 7;
        lea rcx, [rip + _wscw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 4;
        call wsc_pack_install_ptk;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne wscw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wscw_ok];
        call klog_s1;

        xor rax, rax;
        jmp wscw_out;

      wscw_fail_stage:
        lea rax, [rip + _wscw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wscw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      wscw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
