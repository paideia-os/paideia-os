// tests/kernel/ipc/g5_integration_synth.pdx -- G5 integration
//
// End-to-end structural witness for the G5 lattice:
//   1. Load a font atlas via font_load_channel.apply_load (SDF).
//   2. Format-select for a fractional scale returns FONT_FORMAT_SDF.
//   3. sdf_gen against the atlas returns a bumped glyphs_present.
//   4. Sub-pixel cache seeded, invalidation on scale change wipes it.
//   5. P9 predicate accepts 3/2 (P9 acceptance).
//   6. shape_channel features_hash pass-through returns non-zero.
//
// Fingerprint: G5 INTEGRATION OK

module G5IntegrationSynth = structure {

  pub let mut _g5iw_stage : u64 = 0

  pub let g5iw_ok   : [u8; 19] = "G5 INTEGRATION OK\n\0"
  pub let g5iw_fail : [u8; 21] = "G5 INTEGRATION FAIL\n\0"

  pub let g5_integration_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G5 M1..M4 integration: exercises the whole G5 lattice end-to-end in a synthetic run, then reports the fingerprint.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _g5iw_stage];
        mov [rcx], rax;
        call fa_table_reset;
        call ts_table_reset;
        call sdf_reset;
        call subpx_reset;
        call ce_reset;
        call shp_reset;
        call flc_stats_reset;
        call tsc_stats_reset;

        // 1. Load atlas via channel: key=0x600D, 1024x1024, SDF.
        mov rax, 2;
        lea rcx, [rip + _g5iw_stage];
        mov [rcx], rax;
        mov rdi, 0x600D;
        mov rsi, 1024;
        mov rdx, 1024;
        mov rcx, 1;
        call flc_apply_load;
        cmp rax, 0;
        jne g5iw_fail_stage;
        mov r12, rax;                       // atlas row 0

        // 2. Format selection at 24px, 3/2, no flags -> SDF.
        mov rax, 3;
        lea rcx, [rip + _g5iw_stage];
        mov [rcx], rax;
        mov rdi, 24;
        mov rsi, 3;
        mov rdx, 2;
        mov rcx, 0;
        call sdf_format_select;
        cmp rax, 1;
        jne g5iw_fail_stage;

        // 3. sdf_gen against atlas row -> glyphs_present + 1.
        mov rax, 4;
        lea rcx, [rip + _g5iw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        mov rsi, 66;
        mov rdx, 32;
        mov rcx, 1;                         // matches atlas format
        call sdf_gen;
        cmp rax, 1;
        jne g5iw_fail_stage;

        // 4. sub-pixel: insert (row=r12, 3, 2); invalidate returns 1.
        mov rax, 5;
        lea rcx, [rip + _g5iw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        mov rsi, 3;
        mov rdx, 2;
        call subpx_cache_insert;
        mov rdi, r12;
        call subpx_cache_invalidate;
        cmp rax, 1;
        jne g5iw_fail_stage;

        // 5. P9 3/2 accepted.
        mov rax, 6;
        lea rcx, [rip + _g5iw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 2;
        call subpx_p9_valid;
        cmp rax, 1;
        jne g5iw_fail_stage;

        // 6. features_hash KERN|LIGA -> non-zero via schema.
        mov rax, 7;
        lea rcx, [rip + _g5iw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        call tsc_apply_features_hash;
        cmp rax, 0;
        je  g5iw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g5iw_ok];
        call klog_s1;

        call fa_table_reset;
        call ts_table_reset;
        call sdf_reset;
        call subpx_reset;
        call ce_reset;
        call shp_reset;
        call flc_stats_reset;
        call tsc_stats_reset;
        xor rax, rax;
        jmp g5iw_out;

      g5iw_fail_stage:
        lea rax, [rip + _g5iw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g5iw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call fa_table_reset;
        call ts_table_reset;
        call sdf_reset;
        call subpx_reset;
        call ce_reset;
        call shp_reset;
        call flc_stats_reset;
        call tsc_stats_reset;
        mov rax, 1;

      g5iw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
