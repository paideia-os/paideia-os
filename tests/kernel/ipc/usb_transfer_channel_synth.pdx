// tests/kernel/ipc/usb_transfer_channel_synth.pdx — R34.M3-004 (#1179)
//
// Boot witness for src/kernel/core/ipc/usb_transfer_channel.pdx.
//
// Asserts pack/unpack round-trip and refusal discipline for SUBMIT,
// CANCEL, POLL and STATUS frames plus the IOMMU-mapped bit.
//
// Fingerprint: R34 USB TRANSFER CHAN OK
// No cap slots.

module UsbTransferChannelSynth = structure {

  pub let mut _uxc_w_stage : u64 = 0

  pub let uxc_w_ok   : [u8; 22] = "USB TRANSFER CHAN OK\0"
  pub let uxc_w_fail : [u8; 24] = "USB TRANSFER CHAN FAIL\0"

  pub let usb_transfer_channel_witness : () -> u64 !{sysreg} @{boot} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {boot},
      justification: "R34.M3-004 (#1179): schema witness. Stages: (1) validators. (2) SUBMIT round-trip. (3) BAD_SLOT (>=256). (4) BAD_DIR (2). (5) BAD_LEN (0x8000). (6) BAD_TIMEOUT (60001). (7) reserved != 0 refused. (8) CANCEL/POLL round-trip. (9) STATUS round-trip + wrong-op decode.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _uxc_w_stage];
        mov [rcx], rax;

        // -- 1. Validators.
        mov rdi, 0x5F;
        call usb_xfer_op_valid;
        cmp rax, 0;
        jne uxc_w_fail_stage;
        mov rdi, 0x60;
        call usb_xfer_op_valid;
        cmp rax, 1;
        jne uxc_w_fail_stage;
        mov rdi, 0x63;
        call usb_xfer_op_valid;
        cmp rax, 1;
        jne uxc_w_fail_stage;
        mov rdi, 0x64;
        call usb_xfer_op_valid;
        cmp rax, 0;
        jne uxc_w_fail_stage;

        mov rdi, 0;
        call usb_xfer_status_valid;
        cmp rax, 1;
        jne uxc_w_fail_stage;
        mov rdi, 3;
        call usb_xfer_status_valid;
        cmp rax, 1;
        jne uxc_w_fail_stage;
        mov rdi, 4;
        call usb_xfer_status_valid;
        cmp rax, 0;
        jne uxc_w_fail_stage;

        // -- 2. SUBMIT round-trip.
        mov rax, 2;
        lea rcx, [rip + _uxc_w_stage];
        mov [rcx], rax;

        mov rdi, 42;                     // endpoint_slot
        mov rsi, 1;                      // direction IN
        mov rdx, 1;                      // iommu_mapped true
        mov rcx, 512;                    // length
        mov r8, 1000;                    // timeout
        mov r9, 0;                       // reserved
        call usb_xfer_pack_submit;
        mov rbx, rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  uxc_w_fail_stage;

        mov rdi, rbx;
        call usb_xfer_op;
        cmp rax, 0x60;
        jne uxc_w_fail_stage;

        mov rdi, rbx;
        call usb_xfer_slot;
        cmp rax, 42;
        jne uxc_w_fail_stage;

        mov rdi, rbx;
        call usb_xfer_direction;
        cmp rax, 1;
        jne uxc_w_fail_stage;

        mov rdi, rbx;
        call usb_xfer_iommu;
        cmp rax, 1;
        jne uxc_w_fail_stage;

        mov rdi, rbx;
        call usb_xfer_length;
        cmp rax, 512;
        jne uxc_w_fail_stage;

        mov rdi, rbx;
        call usb_xfer_timeout;
        cmp rax, 1000;
        jne uxc_w_fail_stage;

        // -- 3. BAD_SLOT (>= 256).
        mov rax, 3;
        lea rcx, [rip + _uxc_w_stage];
        mov [rcx], rax;

        mov rdi, 256;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;
        mov r8, 0;
        mov r9, 0;
        call usb_xfer_pack_submit;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne uxc_w_fail_stage;

        // -- 4. BAD_DIR (2).
        mov rax, 4;
        lea rcx, [rip + _uxc_w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 2;                      // bad
        mov rdx, 0;
        mov rcx, 0;
        mov r8, 0;
        mov r9, 0;
        call usb_xfer_pack_submit;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne uxc_w_fail_stage;

        // -- 5. BAD_LEN (0x8000).
        mov rax, 5;
        lea rcx, [rip + _uxc_w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0x8000;                 // bad (max is 0x7FFF)
        mov r8, 0;
        mov r9, 0;
        call usb_xfer_pack_submit;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne uxc_w_fail_stage;

        // -- 6. BAD_TIMEOUT (60001).
        mov rax, 6;
        lea rcx, [rip + _uxc_w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;
        mov r8, 60001;                   // bad
        mov r9, 0;
        call usb_xfer_pack_submit;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne uxc_w_fail_stage;

        // -- 7. Reserved != 0 refused.
        mov rax, 7;
        lea rcx, [rip + _uxc_w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;
        mov r8, 0;
        mov r9, 1;                       // bad reserved
        call usb_xfer_pack_submit;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne uxc_w_fail_stage;

        // -- 8. CANCEL / POLL round-trip.
        mov rax, 8;
        lea rcx, [rip + _uxc_w_stage];
        mov [rcx], rax;

        mov rdi, 55;
        call usb_xfer_pack_cancel;
        mov rbx, rax;
        mov rdi, rbx;
        call usb_xfer_op;
        cmp rax, 0x61;
        jne uxc_w_fail_stage;
        mov rdi, rbx;
        call usb_xfer_slot;
        cmp rax, 55;
        jne uxc_w_fail_stage;

        mov rdi, 77;
        call usb_xfer_pack_poll;
        mov rbx, rax;
        mov rdi, rbx;
        call usb_xfer_op;
        cmp rax, 0x62;
        jne uxc_w_fail_stage;
        mov rdi, rbx;
        call usb_xfer_slot;
        cmp rax, 77;
        jne uxc_w_fail_stage;

        // CANCEL BAD_SLOT.
        mov rdi, 256;
        call usb_xfer_pack_cancel;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne uxc_w_fail_stage;

        // -- 9. STATUS round-trip + wrong-op decode.
        mov rax, 9;
        lea rcx, [rip + _uxc_w_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // COMPLETE
        mov rsi, 64;                     // residue
        call usb_xfer_pack_status;
        mov rbx, rax;
        mov rdi, rbx;
        call usb_xfer_op;
        cmp rax, 0x63;
        jne uxc_w_fail_stage;
        mov rdi, rbx;
        call usb_xfer_status;
        cmp rax, 1;
        jne uxc_w_fail_stage;
        mov rdi, rbx;
        call usb_xfer_residue;
        cmp rax, 64;
        jne uxc_w_fail_stage;

        // Attempt status decode on a SUBMIT word -> DECODE_BAD.
        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;
        mov r8, 0;
        mov r9, 0;
        call usb_xfer_pack_submit;
        mov rdi, rax;
        call usb_xfer_status;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne uxc_w_fail_stage;

        // BAD status ordinal (4).
        mov rdi, 4;
        mov rsi, 0;
        call usb_xfer_pack_status;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne uxc_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + uxc_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp uxc_w_out;

      uxc_w_fail_stage:
        lea rax, [rip + _uxc_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + uxc_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      uxc_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
