// tests/kernel/ipc/tb_topology_channel_synth.pdx — R35.M2-004 (#1204)
//
// Boot witness for the tb_topology_channel schema.
//
// Asserts word0/word1 pack + unpack round-trips, reserved-bits
// refusal, subscriber add / remove / duplicate refusal, event
// entry-point refusals, fanout by route filter + wildcard.
//
// Fingerprint: R35 TB TOPOLOGY CHAN OK

module TbTopologyChannelSynth = structure {

  pub let mut _ttcw_stage : u64 = 0

  pub let ttcw_ok   : [u8; 25] = "R35 TB TOPOLOGY CHAN OK\n\0"
  pub let ttcw_fail : [u8; 27] = "R35 TB TOPOLOGY CHAN FAIL\n\0"

  pub let tb_topology_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M2-004 (#1204): boot witness. Stages: (1) reset + pack/unpack round-trip. (2) refuse malformed. (3) subscriber add + remove. (4) duplicate refused. (5) fanout by route match. (6) fanout by wildcard. (7) tunnel_established event.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ttcw_stage];
        mov [rcx], rax;

        call tb_topology_channel_reset;

        // Pack / unpack round-trip.
        mov rdi, 0;                      // kind = ROUTER_APPEARED
        mov rsi, 0x000021;               // route_id
        mov rdx, 0x000001;               // parent route
        call ttc_pack_word0;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r15, r11;
        je  ttcw_fail_stage;

        mov rdi, r15;
        call ttc_word0_kind;
        cmp rax, 0;
        jne ttcw_fail_stage;
        mov rdi, r15;
        call ttc_word0_field_a;
        cmp rax, 0x000021;
        jne ttcw_fail_stage;
        mov rdi, r15;
        call ttc_word0_field_b;
        cmp rax, 0x000001;
        jne ttcw_fail_stage;

        mov rdi, 4;                      // adapter_count in field_c
        call ttc_pack_word1;
        cmp rax, 4;
        jne ttcw_fail_stage;

        // -- 2. Refuse malformed (kind > 3).
        mov rax, 2;
        lea rcx, [rip + _ttcw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 0;
        mov rdx, 0;
        call ttc_pack_word0;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne ttcw_fail_stage;

        // Refuse route > 24 bits.
        mov rdi, 0;
        mov rsi, 0x1000000;
        mov rdx, 0;
        call ttc_pack_word0;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne ttcw_fail_stage;

        // -- 3. Subscriber add + remove.
        mov rax, 3;
        lea rcx, [rip + _ttcw_stage];
        mov [rcx], rax;

        mov rdi, 0x000021;               // route filter
        mov rsi, 0x1000;                 // endpoint
        call ttc_sub_add;
        mov r15, rax;
        mov r11, 0xFFFFF9BF;
        cmp r15, r11;
        je  ttcw_fail_stage;

        mov rdi, r15;
        call ttc_sub_remove;
        cmp rax, 0;
        jne ttcw_fail_stage;

        // -- 4. Duplicate refused.
        mov rax, 4;
        lea rcx, [rip + _ttcw_stage];
        mov [rcx], rax;

        mov rdi, 0x000021;
        mov rsi, 0x1000;
        call ttc_sub_add;
        mov r15, rax;
        mov r11, 0xFFFFF9BF;
        cmp r15, r11;
        je  ttcw_fail_stage;

        // Same (filter, endpoint) — must fail with SUB_IN_USE.
        mov rdi, 0x000021;
        mov rsi, 0x1000;
        call ttc_sub_add;
        mov r11, 0xFFFFF9B7;
        cmp rax, r11;
        jne ttcw_fail_stage;

        // -- 5. Fanout by route match.
        mov rax, 5;
        lea rcx, [rip + _ttcw_stage];
        mov [rcx], rax;

        // Emit router_appeared for matching route — subscriber's
        // delivered counter should tick.
        mov rdi, 0x000021;
        mov rsi, 0x000001;
        mov rdx, 4;
        call tb_topology_router_appeared;
        cmp rax, 0;
        jne ttcw_fail_stage;

        mov rdi, r15;
        call ttc_sub_row_delivered;
        cmp rax, 1;
        jne ttcw_fail_stage;

        // Emit for non-matching route — delivered stays 1.
        mov rdi, 0x000042;
        mov rsi, 0;
        mov rdx, 2;
        call tb_topology_router_appeared;
        cmp rax, 0;
        jne ttcw_fail_stage;

        mov rdi, r15;
        call ttc_sub_row_delivered;
        cmp rax, 1;
        jne ttcw_fail_stage;

        // -- 6. Wildcard subscriber.
        mov rax, 6;
        lea rcx, [rip + _ttcw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // wildcard
        mov rsi, 0x2000;
        call ttc_sub_add;
        mov r14, rax;
        mov r11, 0xFFFFF9BF;
        cmp r14, r11;
        je  ttcw_fail_stage;

        mov rdi, 0x000099;
        call tb_topology_router_departed;
        cmp rax, 0;
        jne ttcw_fail_stage;

        mov rdi, r14;
        call ttc_sub_row_delivered;
        cmp rax, 1;
        jne ttcw_fail_stage;

        // -- 7. tunnel_established event.
        mov rax, 7;
        lea rcx, [rip + _ttcw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // TB_TUNNEL_PCIE_UP
        mov rsi, 0x000021;               // source_adapter (matches r15)
        mov rdx, 0x000042;               // sink_adapter
        call tb_topology_tunnel_established;
        cmp rax, 0;
        jne ttcw_fail_stage;

        mov rdi, r15;
        call ttc_sub_row_delivered;
        cmp rax, 2;                      // one router_appeared match + one tunnel match
        jne ttcw_fail_stage;

        // Refuse bad tunnel type.
        mov rdi, 5;
        mov rsi, 0x000021;
        mov rdx, 0x000042;
        call tb_topology_tunnel_established;
        mov r11, 0xFFFFF9BB;
        cmp rax, r11;
        jne ttcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ttcw_ok];
        call klog_s1;

        call tb_topology_channel_reset;
        xor rax, rax;
        jmp ttcw_out;

      ttcw_fail_stage:
        lea rax, [rip + _ttcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ttcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call tb_topology_channel_reset;
        mov rax, 1;

      ttcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
