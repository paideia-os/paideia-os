// tests/kernel/ipc/fs_channel_synth.pdx -- R42.M4-004 (#1395)
//
// Boot witness for the fs_channel schema: the two validators
// (op / event), the kind validator, and the pack/unpack primitives
// for every RPC family (open req + reply, fd+len header,
// single-path, two-path, stat reply). Round trips assert every
// packer's fields survive the corresponding unpacker; refusals
// assert every width and reserved gate produces FSC_DECODE_BAD.
//
// This witness ASSERTS NOTHING ABOUT A SEND, A SUBSCRIBER, AN
// ENDPOINT, OR A WIRE. The schema module has no capability, no row,
// and no cap_table read.
//
// Fingerprint: R42 FS CHAN OK
// Failure fingerprint: R42 FS CHAN FAIL + stage number.

module FsChannelSynth = structure {

  pub let mut _fscw_stage : u64 = 0

  pub let fscw_ok   : [u8; 13] = "FS CHAN OK\n\0"
  pub let fscw_fail : [u8; 15] = "FS CHAN FAIL\n\0"

  pub let fs_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M4-004 (#1395): boot witness for the fs_channel schema. Stages, in order: (S1) op_valid answers 1 for each ordinal in [OP_OPEN..OP_SYNC] and 0 for {0 (.bss default), 11 (past OP_MAX), 0x80 (event reserved)}. (S2) ev_valid answers 0 for every ev (no events today). (S3) kind_valid answers 1 for {REG, DIR, LNK} and 0 for {0, 4}. (S4) OPEN request round-trip: pack {path_id=0x1234, flags=0xA5}, unpack path_id and flags. Refusals: path_id=0x100000000 (past 32b), flags=0x100 (past 8b). (S5) OPEN reply round-trip: pack fd=0xDEAD; refusal fd=0x100000000. (S6) fd_len round-trip: pack {fd=42, len=0x40000000}, unpack fd and len. Refusals: fd=0x10000 (past 16b), len=0x100000000 (past 32b). (S7) path round-trip: pack path_id=0xF00D. Refusal: past 32b. (S8) two_paths round-trip: pack {from=0x11, to=0x22}. Refusals: either past 32b. (S9) stat_reply round-trip: pack {kind=DIR, size=0x1000}, unpack kind and size. Refusals: kind=0 (unset), kind=4 (past MAX), size past 32b. Five-push prologue leaves rsp%16 == 0 at every klog_s1 call. Labels prefixed fscw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- S1. op_valid.
        mov rax, 1;
        lea rcx, [rip + _fscw_stage];
        mov [rcx], rax;

        mov rdi, 1; call fsc_op_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 2; call fsc_op_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 3; call fsc_op_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 4; call fsc_op_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 5; call fsc_op_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 6; call fsc_op_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 7; call fsc_op_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 8; call fsc_op_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 9; call fsc_op_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 10; call fsc_op_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 0; call fsc_op_valid; cmp rax, 0; jne fscw_fail_stage;
        mov rdi, 11; call fsc_op_valid; cmp rax, 0; jne fscw_fail_stage;
        mov rdi, 0x80; call fsc_op_valid; cmp rax, 0; jne fscw_fail_stage;

        // -- S2. ev_valid (all zero).
        mov rax, 2;
        lea rcx, [rip + _fscw_stage];
        mov [rcx], rax;

        mov rdi, 0; call fsc_ev_valid; cmp rax, 0; jne fscw_fail_stage;
        mov rdi, 1; call fsc_ev_valid; cmp rax, 0; jne fscw_fail_stage;
        mov rdi, 0x80; call fsc_ev_valid; cmp rax, 0; jne fscw_fail_stage;
        mov rdi, 0xFF; call fsc_ev_valid; cmp rax, 0; jne fscw_fail_stage;

        // -- S3. kind_valid.
        mov rax, 3;
        lea rcx, [rip + _fscw_stage];
        mov [rcx], rax;

        mov rdi, 1; call fsc_kind_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 2; call fsc_kind_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 3; call fsc_kind_valid; cmp rax, 1; jne fscw_fail_stage;
        mov rdi, 0; call fsc_kind_valid; cmp rax, 0; jne fscw_fail_stage;
        mov rdi, 4; call fsc_kind_valid; cmp rax, 0; jne fscw_fail_stage;

        // -- S4. OPEN request round-trip + refusals.
        mov rax, 4;
        lea rcx, [rip + _fscw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234;
        mov rsi, 0xA5;
        call fsc_pack_open_request;
        mov rbx, rax;                        // save packed
        mov rdi, rbx;
        call fsc_open_request_path_id;
        mov r11, 0x1234;
        cmp rax, r11;
        jne fscw_fail_stage;
        mov rdi, rbx;
        call fsc_open_request_flags;
        mov r11, 0xA5;
        cmp rax, r11;
        jne fscw_fail_stage;

        // Refuse path_id past 32b.
        mov rdi, 0x100000000;
        mov rsi, 0;
        call fsc_pack_open_request;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fscw_fail_stage;
        // Refuse flags past 8b.
        mov rdi, 0;
        mov rsi, 0x100;
        call fsc_pack_open_request;
        cmp rax, r11;
        jne fscw_fail_stage;

        // -- S5. OPEN reply.
        mov rax, 5;
        lea rcx, [rip + _fscw_stage];
        mov [rcx], rax;

        mov rdi, 0xDEAD;
        call fsc_pack_open_reply;
        mov rbx, rax;
        mov rdi, rbx;
        call fsc_open_reply_fd;
        mov r11, 0xDEAD;
        cmp rax, r11;
        jne fscw_fail_stage;

        mov rdi, 0x100000000;
        call fsc_pack_open_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fscw_fail_stage;

        // -- S6. fd_len round-trip + refusals.
        mov rax, 6;
        lea rcx, [rip + _fscw_stage];
        mov [rcx], rax;

        mov rdi, 42;
        mov rsi, 0x40000000;
        call fsc_pack_fd_len;
        mov rbx, rax;
        mov rdi, rbx;
        call fsc_fd_len_fd;
        cmp rax, 42;
        jne fscw_fail_stage;
        mov rdi, rbx;
        call fsc_fd_len_len;
        mov r11, 0x40000000;
        cmp rax, r11;
        jne fscw_fail_stage;

        mov rdi, 0x10000;
        mov rsi, 1;
        call fsc_pack_fd_len;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fscw_fail_stage;
        mov rdi, 1;
        mov rsi, 0x100000000;
        call fsc_pack_fd_len;
        cmp rax, r11;
        jne fscw_fail_stage;

        // -- S7. single-path packer.
        mov rax, 7;
        lea rcx, [rip + _fscw_stage];
        mov [rcx], rax;

        mov rdi, 0xF00D;
        call fsc_pack_path;
        mov rbx, rax;
        mov rdi, rbx;
        call fsc_path_id;
        mov r11, 0xF00D;
        cmp rax, r11;
        jne fscw_fail_stage;

        mov rdi, 0x100000000;
        call fsc_pack_path;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fscw_fail_stage;

        // -- S8. two_paths packer.
        mov rax, 8;
        lea rcx, [rip + _fscw_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        mov rsi, 0x22;
        call fsc_pack_two_paths;
        mov rbx, rax;
        mov rdi, rbx;
        call fsc_two_paths_from;
        cmp rax, 0x11;
        jne fscw_fail_stage;
        mov rdi, rbx;
        call fsc_two_paths_to;
        cmp rax, 0x22;
        jne fscw_fail_stage;

        mov rdi, 0x100000000;
        mov rsi, 1;
        call fsc_pack_two_paths;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fscw_fail_stage;
        mov rdi, 1;
        mov rsi, 0x100000000;
        call fsc_pack_two_paths;
        cmp rax, r11;
        jne fscw_fail_stage;

        // -- S9. stat_reply round-trip + refusals.
        mov rax, 9;
        lea rcx, [rip + _fscw_stage];
        mov [rcx], rax;

        mov rdi, 2;                          // KIND_DIR
        mov rsi, 0x1000;
        call fsc_pack_stat_reply;
        mov rbx, rax;
        mov rdi, rbx;
        call fsc_stat_reply_kind;
        cmp rax, 2;
        jne fscw_fail_stage;
        mov rdi, rbx;
        call fsc_stat_reply_size;
        mov r11, 0x1000;
        cmp rax, r11;
        jne fscw_fail_stage;

        // Refuse kind=0 (unset).
        mov rdi, 0;
        mov rsi, 1;
        call fsc_pack_stat_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fscw_fail_stage;
        // Refuse kind past MAX.
        mov rdi, 4;
        mov rsi, 1;
        call fsc_pack_stat_reply;
        cmp rax, r11;
        jne fscw_fail_stage;
        // Refuse size past 32b.
        mov rdi, 1;
        mov rsi, 0x100000000;
        call fsc_pack_stat_reply;
        cmp rax, r11;
        jne fscw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + fscw_ok];
        call klog_s1;

        xor rax, rax;
        jmp fscw_out;

      fscw_fail_stage:
        lea rax, [rip + _fscw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + fscw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      fscw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
