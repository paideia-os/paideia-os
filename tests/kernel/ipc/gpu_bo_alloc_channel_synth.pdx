// tests/kernel/ipc/gpu_bo_alloc_channel_synth.pdx — R37.M3-005 (#1266)
//
// Boot witness for gpu_bo_alloc_channel schema.
//
// Asserts verb validator, per-verb pack + unpack symmetry, and
// reserved-field / out-of-range refusals across the six verbs.
//
// Fingerprint: R37 GPU BO ALLOC CHAN OK

module GpuBoAllocChannelSynth = structure {

  pub let mut _bocw_stage : u64 = 0

  pub let bocw_ok   : [u8; 23] = "GPU BO ALLOC CHAN OK\n\0"
  pub let bocw_fail : [u8; 25] = "GPU BO ALLOC CHAN FAIL\n\0"

  pub let gpu_bo_alloc_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M3-005 (#1266): boot witness. Stages: (1) verb valid. (2) verb invalid. (3) ALLOC pack+unpack. (4) ALLOC size=0 refused. (5) ALLOC bad tiling refused. (6) FREE pack+unpack. (7) FREE slot=0 refused. (8) EXPORT_FD / IMPORT_FD round-trip. (9) CPU_MAP / CPU_UNMAP round-trip. (10) CPU_UNMAP misalign refused.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _bocw_stage];
        mov [rcx], rax;

        // -- 1. Verb valid.
        mov rdi, 0x80;
        call boc_verb_valid;
        cmp rax, 1;
        jne bocw_fail_stage;
        mov rdi, 0x85;
        call boc_verb_valid;
        cmp rax, 1;
        jne bocw_fail_stage;

        // -- 2. Verb invalid.
        mov rax, 2;
        lea rcx, [rip + _bocw_stage];
        mov [rcx], rax;

        mov rdi, 0x7F;
        call boc_verb_valid;
        cmp rax, 0;
        jne bocw_fail_stage;
        mov rdi, 0x86;
        call boc_verb_valid;
        cmp rax, 0;
        jne bocw_fail_stage;

        // -- 3. ALLOC pack + unpack round-trip.
        mov rax, 3;
        lea rcx, [rip + _bocw_stage];
        mov [rcx], rax;

        mov rdi, 65536;                  // size
        mov rsi, 3;                      // tiling = TILE4
        mov rdx, 2;                      // cache = UC
        call boc_pack_alloc;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  bocw_fail_stage;

        mov rdi, r15;
        call boc_alloc_size;
        cmp rax, 65536;
        jne bocw_fail_stage;

        mov rdi, r15;
        call boc_alloc_tiling;
        cmp rax, 3;
        jne bocw_fail_stage;

        mov rdi, r15;
        call boc_alloc_cache;
        cmp rax, 2;
        jne bocw_fail_stage;

        // -- 4. ALLOC size=0 refused (BOC_BAD_SIZE per #1613).
        mov rax, 4;
        lea rcx, [rip + _bocw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        call boc_pack_alloc;
        mov r11, 0xFFFFF60E;             // BOC_BAD_SIZE
        cmp rax, r11;
        jne bocw_fail_stage;

        // -- 5. ALLOC bad tiling refused (BOC_BAD_TILING per #1613).
        mov rax, 5;
        lea rcx, [rip + _bocw_stage];
        mov [rcx], rax;

        mov rdi, 4096;
        mov rsi, 5;                      // bad tiling
        mov rdx, 0;
        call boc_pack_alloc;
        mov r11, 0xFFFFF60D;             // BOC_BAD_TILING
        cmp rax, r11;
        jne bocw_fail_stage;

        // -- 6. FREE pack + unpack.
        mov rax, 6;
        lea rcx, [rip + _bocw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234;
        call boc_pack_free;
        mov r15, rax;
        cmp rax, 0x1234;
        jne bocw_fail_stage;

        mov rdi, r15;
        call boc_free_slot;
        cmp rax, 0x1234;
        jne bocw_fail_stage;

        // -- 7. FREE slot=0 refused (BOC_BAD_SLOT per #1613).
        mov rax, 7;
        lea rcx, [rip + _bocw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call boc_pack_free;
        mov r11, 0xFFFFF60B;             // BOC_BAD_SLOT
        cmp rax, r11;
        jne bocw_fail_stage;

        // -- 8. EXPORT_FD / IMPORT_FD round-trip.
        mov rax, 8;
        lea rcx, [rip + _bocw_stage];
        mov [rcx], rax;

        mov rdi, 0x0055;
        call boc_pack_export_fd;
        mov r15, rax;
        cmp rax, 0x0055;
        jne bocw_fail_stage;

        mov rdi, r15;
        call boc_export_slot;
        cmp rax, 0x0055;
        jne bocw_fail_stage;

        mov rdi, 0xDEADBEEF;             // fd
        call boc_pack_import_fd;
        mov r15, rax;
        mov r11, 0xDEADBEEF;
        cmp rax, r11;
        jne bocw_fail_stage;

        mov rdi, r15;
        call boc_import_fd;
        mov r11, 0xDEADBEEF;
        cmp rax, r11;
        jne bocw_fail_stage;

        // -- 9. CPU_MAP / CPU_UNMAP round-trip.
        mov rax, 9;
        lea rcx, [rip + _bocw_stage];
        mov [rcx], rax;

        mov rdi, 0x0077;
        call boc_pack_cpu_map;
        mov r15, rax;
        cmp rax, 0x0077;
        jne bocw_fail_stage;

        mov rdi, r15;
        call boc_map_slot;
        cmp rax, 0x0077;
        jne bocw_fail_stage;

        mov rdi, 0x7000000000;           // page-aligned vaddr
        call boc_pack_cpu_unmap;
        mov r15, rax;
        mov r11, 0x7000000000;
        cmp rax, r11;
        jne bocw_fail_stage;

        mov rdi, r15;
        call boc_unmap_vaddr;
        mov r11, 0x7000000000;
        cmp rax, r11;
        jne bocw_fail_stage;

        // -- 10. CPU_UNMAP misalign refused (BOC_BAD_VADDR per #1613).
        mov rax, 10;
        lea rcx, [rip + _bocw_stage];
        mov [rcx], rax;

        mov rdi, 0x7000000001;           // misaligned
        call boc_pack_cpu_unmap;
        mov r11, 0xFFFFF609;             // BOC_BAD_VADDR
        cmp rax, r11;
        jne bocw_fail_stage;

        mov rdi, 0;                      // zero refused
        call boc_pack_cpu_unmap;
        mov r11, 0xFFFFF609;             // BOC_BAD_VADDR
        cmp rax, r11;
        jne bocw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bocw_ok];
        call klog_s1;

        xor rax, rax;
        jmp bocw_out;

      bocw_fail_stage:
        lea rax, [rip + _bocw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bocw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      bocw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
