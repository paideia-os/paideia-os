// tests/kernel/ipc/wifi_control_channel_synth.pdx — R38.M3-004 (#1301)
//
// Boot witness for wifi_control_channel schema.  Asserts verb validator,
// pack + unpack symmetry for all five verbs, and refusals (zero vif,
// zero key, zero ssid_ref, out-of-range).
//
// Fingerprint: R38 WIFI CTRL CHAN OK

module WifiControlChannelSynth = structure {

  pub let mut _wccw_stage : u64 = 0

  pub let wccw_ok   : [u8; 18] = "WIFI CTRL CHAN OK\n\0"
  pub let wccw_fail : [u8; 20] = "WIFI CTRL CHAN FAIL\n\0"

  pub let wifi_control_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M3-004 (#1301): boot witness. Stages: (1) verb_valid. (2) scan pack + unpack. (3) scan vif 0 refused. (4) connect pack + unpack. (5) connect ssid 0 refused. (6) disconnect pack + unpack. (7) set_key pack + unpack. (8) set_key key 0 refused. (9) get_stats pack + unpack.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wccw_stage];
        mov [rcx], rax;

        // -- 1. Verb valid.
        mov rdi, 0x80;
        call wcc_verb_valid;
        cmp rax, 1;
        jne wccw_fail_stage;
        mov rdi, 0x84;
        call wcc_verb_valid;
        cmp rax, 1;
        jne wccw_fail_stage;
        mov rdi, 0x85;
        call wcc_verb_valid;
        cmp rax, 0;
        jne wccw_fail_stage;
        mov rdi, 0x00;
        call wcc_verb_valid;
        cmp rax, 0;
        jne wccw_fail_stage;

        // -- 2. Scan pack + unpack.
        mov rax, 2;
        lea rcx, [rip + _wccw_stage];
        mov [rcx], rax;

        mov rdi, 0x0123;
        call wcc_pack_scan;
        mov r15, rax;
        cmp rax, 0x0123;
        jne wccw_fail_stage;

        mov rdi, r15;
        call wcc_scan_vif;
        cmp rax, 0x0123;
        jne wccw_fail_stage;

        // -- 3. Scan vif 0 refused.
        mov rax, 3;
        lea rcx, [rip + _wccw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call wcc_pack_scan;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne wccw_fail_stage;

        // -- 4. Connect pack + unpack.
        mov rax, 4;
        lea rcx, [rip + _wccw_stage];
        mov [rcx], rax;

        mov rdi, 0x00A1;                 // vif
        mov rsi, 0x00CDEF;               // ssid_ref (24-bit)
        mov rdx, 0x00BEEF;               // bss_ref (24-bit)
        call wcc_pack_connect;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  wccw_fail_stage;
        // Also check not the error sentinels.
        mov r11, 0xFFFFFFFFFFFFFFFE;
        cmp rax, r11;
        je  wccw_fail_stage;
        mov r11, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r11;
        je  wccw_fail_stage;

        mov rdi, r15;
        call wcc_connect_vif;
        cmp rax, 0x00A1;
        jne wccw_fail_stage;
        mov rdi, r15;
        call wcc_connect_ssid;
        cmp rax, 0x00CDEF;
        jne wccw_fail_stage;
        mov rdi, r15;
        call wcc_connect_bss;
        cmp rax, 0x00BEEF;
        jne wccw_fail_stage;

        // -- 5. Connect ssid 0 refused.
        mov rax, 5;
        lea rcx, [rip + _wccw_stage];
        mov [rcx], rax;

        mov rdi, 0x00A1;
        mov rsi, 0;
        mov rdx, 0x00BEEF;
        call wcc_pack_connect;
        mov r11, 0xFFFFFFFFFFFFFFFE;
        cmp rax, r11;
        jne wccw_fail_stage;

        // -- 6. Disconnect pack + unpack.
        mov rax, 6;
        lea rcx, [rip + _wccw_stage];
        mov [rcx], rax;

        mov rdi, 0x00A1;
        call wcc_pack_disconnect;
        mov r15, rax;
        cmp rax, 0x00A1;
        jne wccw_fail_stage;
        mov rdi, r15;
        call wcc_disconnect_vif;
        cmp rax, 0x00A1;
        jne wccw_fail_stage;

        // -- 7. Set_key pack + unpack.
        mov rax, 7;
        lea rcx, [rip + _wccw_stage];
        mov [rcx], rax;

        mov rdi, 0x00A1;
        mov rsi, 0x0055;
        call wcc_pack_set_key;
        mov r15, rax;
        // Expect: 0x0055_00A1
        mov r11, 0x005500A1;
        cmp rax, r11;
        jne wccw_fail_stage;

        mov rdi, r15;
        call wcc_set_key_vif;
        cmp rax, 0x00A1;
        jne wccw_fail_stage;
        mov rdi, r15;
        call wcc_set_key_key;
        cmp rax, 0x0055;
        jne wccw_fail_stage;

        // -- 8. Set_key key 0 refused.
        mov rax, 8;
        lea rcx, [rip + _wccw_stage];
        mov [rcx], rax;

        mov rdi, 0x00A1;
        mov rsi, 0;
        call wcc_pack_set_key;
        mov r11, 0xFFFFFFFFFFFFFFFE;
        cmp rax, r11;
        jne wccw_fail_stage;

        // -- 9. Get_stats pack + unpack.
        mov rax, 9;
        lea rcx, [rip + _wccw_stage];
        mov [rcx], rax;

        mov rdi, 0x00A1;
        call wcc_pack_get_stats;
        mov r15, rax;
        cmp rax, 0x00A1;
        jne wccw_fail_stage;
        mov rdi, r15;
        call wcc_get_stats_vif;
        cmp rax, 0x00A1;
        jne wccw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wccw_ok];
        call klog_s1;

        xor rax, rax;
        jmp wccw_out;

      wccw_fail_stage:
        lea rax, [rip + _wccw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wccw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      wccw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
