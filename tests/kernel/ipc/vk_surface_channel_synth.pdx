// tests/kernel/ipc/vk_surface_channel_synth.pdx -- G3.M1-004 (#1460)
//
// Boot witness for vk_surface_channel schema. Kernel-side dormant
// coverage: exercises event/slot/extent/mode/count validators and
// asserts vsc_apply_* refuse cleanly on unmapped surface slots
// (which is the only shape the witness can reach without minting
// a real KIND_VK_SURFACE, and is the documented dormant-path per
// D7).
//
// Fingerprint: G3 VK_SURFACE_CHAN OK

module VkSurfaceChannelSynth = structure {

  pub let mut _vscw_stage : u64 = 0

  pub let vscw_ok   : [u8; 23] = "G3 VK_SURFACE_CHAN OK\n\0"
  pub let vscw_fail : [u8; 25] = "G3 VK_SURFACE_CHAN FAIL\n\0"

  pub let vk_surface_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G3.M1-004 (#1460): boot witness. Stages: (1) reset. (2) ev_valid. (3) slot_valid. (4) extent_valid. (5) mode_valid. (6) count_valid. (7) apply_create refuses on unmapped slot. (8) apply_acquire refuses. (9) apply_destroy refuses.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _vscw_stage];
        mov [rcx], rax;
        call vsc_stats_reset;

        // 2. ev_valid.
        mov rax, 2;
        lea rcx, [rip + _vscw_stage];
        mov [rcx], rax;
        mov rdi, 0xC0;
        call vsc_ev_valid;
        cmp rax, 1;
        jne vscw_fail_stage;
        mov rdi, 0xC3;
        call vsc_ev_valid;
        cmp rax, 1;
        jne vscw_fail_stage;
        mov rdi, 0xC4;
        call vsc_ev_valid;
        cmp rax, 0;
        jne vscw_fail_stage;

        // 3. slot_valid: 255 ok, 256 no.
        mov rax, 3;
        lea rcx, [rip + _vscw_stage];
        mov [rcx], rax;
        mov rdi, 255;
        call vsc_slot_valid;
        cmp rax, 1;
        jne vscw_fail_stage;
        mov rdi, 256;
        call vsc_slot_valid;
        cmp rax, 0;
        jne vscw_fail_stage;

        // 4. extent_valid.
        mov rax, 4;
        lea rcx, [rip + _vscw_stage];
        mov [rcx], rax;
        mov rdi, 1920;
        mov rsi, 1080;
        call vsc_extent_valid;
        cmp rax, 1;
        jne vscw_fail_stage;
        mov rdi, 0;
        mov rsi, 1;
        call vsc_extent_valid;
        cmp rax, 0;
        jne vscw_fail_stage;

        // 5. mode_valid.
        mov rax, 5;
        lea rcx, [rip + _vscw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        call vsc_mode_valid;
        cmp rax, 1;
        jne vscw_fail_stage;
        mov rdi, 4;
        call vsc_mode_valid;
        cmp rax, 0;
        jne vscw_fail_stage;

        // 6. count_valid: 2..4 ok; 1 no; 5 no.
        mov rax, 6;
        lea rcx, [rip + _vscw_stage];
        mov [rcx], rax;
        mov rdi, 2;
        call vsc_count_valid;
        cmp rax, 1;
        jne vscw_fail_stage;
        mov rdi, 4;
        call vsc_count_valid;
        cmp rax, 1;
        jne vscw_fail_stage;
        mov rdi, 1;
        call vsc_count_valid;
        cmp rax, 0;
        jne vscw_fail_stage;
        mov rdi, 5;
        call vsc_count_valid;
        cmp rax, 0;
        jne vscw_fail_stage;

        // 7. apply_create on unmapped slot 200 -> NO_SURFACE.
        mov rax, 7;
        lea rcx, [rip + _vscw_stage];
        mov [rcx], rax;
        mov rdi, 200;
        mov rsi, 1920;
        mov rdx, 1080;
        mov rcx, 0;
        mov r8,  2;
        call vsc_apply_create;
        mov r10, 0xFFFFEDF9;
        cmp rax, r10;
        jne vscw_fail_stage;

        // 8. apply_acquire on unmapped slot -> NO_SURFACE.
        mov rax, 8;
        lea rcx, [rip + _vscw_stage];
        mov [rcx], rax;
        mov rdi, 200;
        mov rsi, 0;
        call vsc_apply_acquire;
        mov r10, 0xFFFFEDF9;
        cmp rax, r10;
        jne vscw_fail_stage;

        // 9. apply_destroy on unmapped slot -> NO_SURFACE.
        mov rax, 9;
        lea rcx, [rip + _vscw_stage];
        mov [rcx], rax;
        mov rdi, 200;
        call vsc_apply_destroy;
        mov r10, 0xFFFFEDF9;
        cmp rax, r10;
        jne vscw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vscw_ok];
        call klog_s1;

        call vsc_stats_reset;
        xor rax, rax;
        jmp vscw_out;

      vscw_fail_stage:
        lea rax, [rip + _vscw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vscw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vsc_stats_reset;
        mov rax, 1;

      vscw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
