// tests/kernel/ipc/display_topology_channel_synth.pdx — R36.M2-004 (#1242)
//
// Boot witness for display_topology_channel schema. Asserts event
// validator, connected/disconnected/mode_list_changed pack+unpack
// symmetry, and reserved-field / out-of-range refusals.
//
// Fingerprint: R36 DPY TOPO CHAN OK

module DisplayTopologyChannelSynth = structure {

  pub let mut _dtcw_stage : u64 = 0

  pub let dtcw_ok   : [u8; 18] = "DPY TOPO CHAN OK\n\0"
  pub let dtcw_fail : [u8; 20] = "DPY TOPO CHAN FAIL\n\0"

  pub let display_topology_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R36.M2-004 (#1242): boot witness. Stages: (1) ev valid. (2) ev invalid. (3) connected pack + unpack. (4) connected slot 0 refused. (5) connected type 4 refused. (6) disconnected pack + unpack. (7) disconnected slot 0 refused. (8) mode_list_changed pack + unpack.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dtcw_stage];
        mov [rcx], rax;

        mov rdi, 0x80;
        call dtc_ev_valid;
        cmp rax, 1;
        jne dtcw_fail_stage;
        mov rdi, 0x82;
        call dtc_ev_valid;
        cmp rax, 1;
        jne dtcw_fail_stage;

        // -- 2. Invalid event ordinals.
        mov rax, 2;
        lea rcx, [rip + _dtcw_stage];
        mov [rcx], rax;

        mov rdi, 0x00;
        call dtc_ev_valid;
        cmp rax, 0;
        jne dtcw_fail_stage;
        mov rdi, 0x83;
        call dtc_ev_valid;
        cmp rax, 0;
        jne dtcw_fail_stage;

        // -- 3. Connected pack + unpack round-trip.
        mov rax, 3;
        lea rcx, [rip + _dtcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0123;                 // output_slot
        mov rsi, 0x0100;                 // engine_slot
        mov rdx, 3;                      // ddi
        mov rcx, 2;                      // type = eDP
        call dtc_pack_connected;
        mov r15, rax;                    // save payload
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dtcw_fail_stage;

        mov rdi, r15;
        call dtc_conn_output_slot;
        cmp rax, 0x0123;
        jne dtcw_fail_stage;

        mov rdi, r15;
        call dtc_conn_engine_slot;
        cmp rax, 0x0100;
        jne dtcw_fail_stage;

        mov rdi, r15;
        call dtc_conn_ddi;
        cmp rax, 3;
        jne dtcw_fail_stage;

        mov rdi, r15;
        call dtc_conn_type;
        cmp rax, 2;
        jne dtcw_fail_stage;

        // -- 4. Connected slot 0 refused.
        mov rax, 4;
        lea rcx, [rip + _dtcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x0100;
        mov rdx, 3;
        mov rcx, 2;
        call dtc_pack_connected;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne dtcw_fail_stage;

        // -- 5. Connected type 4 refused.
        mov rax, 5;
        lea rcx, [rip + _dtcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0123;
        mov rsi, 0x0100;
        mov rdx, 3;
        mov rcx, 4;                      // BAD type
        call dtc_pack_connected;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne dtcw_fail_stage;

        // -- 6. Disconnected pack + unpack.
        mov rax, 6;
        lea rcx, [rip + _dtcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0055;
        call dtc_pack_disconnected;
        mov r15, rax;
        cmp rax, 0x0055;
        jne dtcw_fail_stage;

        mov rdi, r15;
        call dtc_disc_output_slot;
        cmp rax, 0x0055;
        jne dtcw_fail_stage;

        // -- 7. Disconnected slot 0 refused.
        mov rax, 7;
        lea rcx, [rip + _dtcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call dtc_pack_disconnected;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne dtcw_fail_stage;

        // -- 8. Mode_list_changed pack + unpack.
        mov rax, 8;
        lea rcx, [rip + _dtcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0123;
        mov rsi, 42;
        call dtc_pack_mode_list_changed;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dtcw_fail_stage;

        mov rdi, r15;
        call dtc_mlc_output_slot;
        cmp rax, 0x0123;
        jne dtcw_fail_stage;

        mov rdi, r15;
        call dtc_mlc_mode_count;
        cmp rax, 42;
        jne dtcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dtcw_ok];
        call klog_s1;

        xor rax, rax;
        jmp dtcw_out;

      dtcw_fail_stage:
        lea rax, [rip + _dtcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dtcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      dtcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
