// tests/kernel/ipc/bt_gatt_channel_synth.pdx — R39.M3-004 (#1334)
//
// Boot witness for bt_gatt_channel schema.
//
// Asserts verb validator, per-verb pack + unpack symmetry, and
// reserved-field / out-of-range refusals across the four verbs
// (read_char, write_char, subscribe, notify).
//
// Fingerprint: R39 BT GATT CHAN OK

module BtGattChannelSynth = structure {

  pub let mut _btgcw_stage : u64 = 0

  pub let btgcw_ok   : [u8; 21] = "R39 BT GATT CHAN OK\n\0"
  pub let btgcw_fail : [u8; 23] = "R39 BT GATT CHAN FAIL\n\0"

  pub let bt_gatt_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M3-004 (#1334): boot witness. Stages: (1) verb valid. (2) verb invalid. (3) READ_CHAR pack+unpack. (4) READ_CHAR conn_slot=0 refused. (5) WRITE_CHAR pack+unpack. (6) WRITE_CHAR value over-width refused. (7) SUBSCRIBE round-trip. (8) SUBSCRIBE handle=0 refused. (9) NOTIFY round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _btgcw_stage];
        mov [rcx], rax;

        // -- 1. Verb valid.
        mov rdi, 0x80;
        call btgc_verb_valid;
        cmp rax, 1;
        jne btgcw_fail_stage;
        mov rdi, 0x83;
        call btgc_verb_valid;
        cmp rax, 1;
        jne btgcw_fail_stage;

        // -- 2. Verb invalid.
        mov rax, 2;
        lea rcx, [rip + _btgcw_stage];
        mov [rcx], rax;

        mov rdi, 0x7F;
        call btgc_verb_valid;
        cmp rax, 0;
        jne btgcw_fail_stage;
        mov rdi, 0x84;
        call btgc_verb_valid;
        cmp rax, 0;
        jne btgcw_fail_stage;

        // -- 3. READ_CHAR pack + unpack round-trip.
        mov rax, 3;
        lea rcx, [rip + _btgcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0042;
        mov rsi, 0x1234;
        call btgc_pack_read_char;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  btgcw_fail_stage;

        mov rdi, r15;
        call btgc_read_slot;
        cmp rax, 0x0042;
        jne btgcw_fail_stage;

        mov rdi, r15;
        call btgc_read_handle;
        cmp rax, 0x1234;
        jne btgcw_fail_stage;

        // -- 4. READ_CHAR conn_slot=0 refused (BTGC_BAD_SLOT per #1614).
        mov rax, 4;
        lea rcx, [rip + _btgcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x1234;
        call btgc_pack_read_char;
        mov r11, 0xFFFFF30E;             // BTGC_BAD_SLOT
        cmp rax, r11;
        jne btgcw_fail_stage;

        // -- 5. WRITE_CHAR pack + unpack.
        mov rax, 5;
        lea rcx, [rip + _btgcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0055;
        mov rsi, 0xABCD;
        mov rdx, 0xDEADBEEF;
        call btgc_pack_write_char;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  btgcw_fail_stage;

        mov rdi, r15;
        call btgc_write_slot;
        cmp rax, 0x0055;
        jne btgcw_fail_stage;

        mov rdi, r15;
        call btgc_write_handle;
        cmp rax, 0xABCD;
        jne btgcw_fail_stage;

        mov rdi, r15;
        call btgc_write_value;
        mov r11, 0xDEADBEEF;
        cmp rax, r11;
        jne btgcw_fail_stage;

        // -- 6. WRITE_CHAR value over-width refused (BTGC_BAD_VALUE per #1614).
        mov rax, 6;
        lea rcx, [rip + _btgcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0055;
        mov rsi, 0xABCD;
        mov rdx, 0x100000000;            // > u32 max
        call btgc_pack_write_char;
        mov r11, 0xFFFFF30C;             // BTGC_BAD_VALUE
        cmp rax, r11;
        jne btgcw_fail_stage;

        // -- 7. SUBSCRIBE round-trip.
        mov rax, 7;
        lea rcx, [rip + _btgcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0066;
        mov rsi, 0x5678;
        call btgc_pack_subscribe;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  btgcw_fail_stage;

        mov rdi, r15;
        call btgc_sub_slot;
        cmp rax, 0x0066;
        jne btgcw_fail_stage;

        mov rdi, r15;
        call btgc_sub_handle;
        cmp rax, 0x5678;
        jne btgcw_fail_stage;

        // -- 8. SUBSCRIBE handle=0 refused (BTGC_BAD_HANDLE per #1614).
        mov rax, 8;
        lea rcx, [rip + _btgcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0066;
        mov rsi, 0;
        call btgc_pack_subscribe;
        mov r11, 0xFFFFF30D;             // BTGC_BAD_HANDLE
        cmp rax, r11;
        jne btgcw_fail_stage;

        // -- 9. NOTIFY round-trip.
        mov rax, 9;
        lea rcx, [rip + _btgcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0077;
        mov rsi, 0x9ABC;
        mov rdx, 0x12345678;
        call btgc_pack_notify;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  btgcw_fail_stage;

        mov rdi, r15;
        call btgc_notify_slot;
        cmp rax, 0x0077;
        jne btgcw_fail_stage;

        mov rdi, r15;
        call btgc_notify_handle;
        cmp rax, 0x9ABC;
        jne btgcw_fail_stage;

        mov rdi, r15;
        call btgc_notify_value;
        mov r11, 0x12345678;
        cmp rax, r11;
        jne btgcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + btgcw_ok];
        call klog_s1;

        xor rax, rax;
        jmp btgcw_out;

      btgcw_fail_stage:
        lea rax, [rip + _btgcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + btgcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      btgcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
