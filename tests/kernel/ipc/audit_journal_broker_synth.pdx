// tests/kernel/ipc/audit_journal_broker_synth.pdx -- R48b substrate-prep (#1628)
//
// Boot witness for the svc.audit-journal registration seam + the four
// UEJ_KIND_TOOL_* constants.
//
// Fingerprint: R48b AUDIT_JOURNAL OK

module AuditJournalBrokerSynth = structure {

  pub let mut _ajbw_stage : u64 = 0

  pub let ajbw_ok   : [u8; 17] = "AUDIT_JOURNAL OK\n\0"
  pub let ajbw_fail : [u8; 19] = "AUDIT_JOURNAL FAIL\n\0"

  pub let audit_journal_broker_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R48b substrate-prep (#1628): boot witness for the audit-journal broker seam + UEJ event constants. Same shape as elevate_broker_witness. Five callee-save pushes leave rsp%16 == 0. Labels prefixed ajbw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) Reset.
        mov rax, 1;
        lea rcx, [rip + _ajbw_stage];
        mov [rcx], rax;
        call audit_journal_broker_stats_reset;

        // (2) UEJ_KIND_TOOL_* constants and uej_kind_valid.
        mov rax, 2;
        lea rcx, [rip + _ajbw_stage];
        mov [rcx], rax;
        mov rdi, 128; call uej_kind_valid; cmp rax, 1; jne ajbw_fail_stage;
        mov rdi, 129; call uej_kind_valid; cmp rax, 1; jne ajbw_fail_stage;
        mov rdi, 130; call uej_kind_valid; cmp rax, 1; jne ajbw_fail_stage;
        mov rdi, 131; call uej_kind_valid; cmp rax, 1; jne ajbw_fail_stage;
        mov rdi, 127; call uej_kind_valid; cmp rax, 0; jne ajbw_fail_stage;
        mov rdi, 132; call uej_kind_valid; cmp rax, 0; jne ajbw_fail_stage;

        // (3) Register with endpoint 0x44.
        mov rax, 3;
        lea rcx, [rip + _ajbw_stage];
        mov [rcx], rax;
        mov rdi, 0x44;
        call audit_journal_broker_register;
        cmp rax, 0;
        jne ajbw_fail_stage;

        mov rdi, 0;                      // AJB_ST_REGISTERS
        call audit_journal_broker_stat;
        cmp rax, 1;
        jne ajbw_fail_stage;

        // (4) svc_lookup resolves.
        mov rax, 4;
        lea rcx, [rip + _ajbw_stage];
        mov [rcx], rax;
        lea rdi, [rip + audit_journal_broker_name];
        mov rsi, 17;                     // AUDIT_JOURNAL_BROKER_NAME_LEN
        call svc_lookup;
        cmp rax, 0x44;
        jne ajbw_fail_stage;

        // (5) Duplicate refused.
        mov rax, 5;
        lea rcx, [rip + _ajbw_stage];
        mov [rcx], rax;
        mov rdi, 0x44;
        call audit_journal_broker_register;
        mov r10, 0xFFFFEBEE;             // AJB_REGISTER_DUP
        cmp rax, r10;
        jne ajbw_fail_stage;

        // (6) BAD_ID.
        mov rax, 6;
        lea rcx, [rip + _ajbw_stage];
        mov [rcx], rax;
        mov r11, 0x100000;
        mov rdi, r11;
        call audit_journal_broker_register;
        mov r10, 0xFFFFEBEF;             // AJB_REGISTER_BAD_ID
        cmp rax, r10;
        jne ajbw_fail_stage;

        // (7) dispatch every UEJ_KIND_TOOL_* -> STUB.
        mov rax, 7;
        lea rcx, [rip + _ajbw_stage];
        mov [rcx], rax;

        mov rdi, 128;                    // INSTALL
        mov rsi, 0xAA;
        call audit_journal_broker_dispatch;
        mov r10, 0xFFFFEBEB;             // AJB_DISPATCH_STUB
        cmp rax, r10;
        jne ajbw_fail_stage;

        mov rdi, 129;                    // REMOVE
        mov rsi, 0xBB;
        call audit_journal_broker_dispatch;
        mov r10, 0xFFFFEBEB;
        cmp rax, r10;
        jne ajbw_fail_stage;

        mov rdi, 130;                    // INVOKE
        mov rsi, 0xCC;
        call audit_journal_broker_dispatch;
        mov r10, 0xFFFFEBEB;
        cmp rax, r10;
        jne ajbw_fail_stage;

        mov rdi, 131;                    // ERROR
        mov rsi, 0xDD;
        call audit_journal_broker_dispatch;
        mov r10, 0xFFFFEBEB;
        cmp rax, r10;
        jne ajbw_fail_stage;

        mov rdi, 2;                      // AJB_ST_DISPATCH
        call audit_journal_broker_stat;
        cmp rax, 4;
        jne ajbw_fail_stage;

        // (8) dispatch(127) + dispatch(132) refused.
        mov rax, 8;
        lea rcx, [rip + _ajbw_stage];
        mov [rcx], rax;

        mov rdi, 127;
        xor rsi, rsi;
        call audit_journal_broker_dispatch;
        mov r10, 0xFFFFEBEA;
        cmp rax, r10;
        jne ajbw_fail_stage;

        mov rdi, 132;
        xor rsi, rsi;
        call audit_journal_broker_dispatch;
        mov r10, 0xFFFFEBEA;
        cmp rax, r10;
        jne ajbw_fail_stage;

        mov rdi, 3;                      // AJB_ST_BAD_KIND
        call audit_journal_broker_stat;
        cmp rax, 2;
        jne ajbw_fail_stage;

        // Success.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ajbw_ok];
        call klog_s1;

        call audit_journal_broker_stats_reset;
        xor rax, rax;
        jmp ajbw_out;

      ajbw_fail_stage:
        lea rax, [rip + _ajbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ajbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call audit_journal_broker_stats_reset;
        mov rax, 1;

      ajbw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
