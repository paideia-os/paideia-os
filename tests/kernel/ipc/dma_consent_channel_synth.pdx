// tests/kernel/ipc/dma_consent_channel_synth.pdx — R35.M4-002 (#1211)
//
// Boot witness for the dma_consent_channel schema.
//
// Asserts word0 pack/unpack round-trip, reserved-bits refusal, RPC
// request/reply matching, in-flight duplicate refusal, seq-mismatch
// on stray reply.
//
// Fingerprint: R35 DMA CONSENT CHAN OK

module DmaConsentChannelSynth = structure {

  pub let mut _dccw_stage : u64 = 0

  pub let dccw_ok   : [u8; 24] = "R35 DMA CONSENT CHAN OK\n\0"
  pub let dccw_fail : [u8; 26] = "R35 DMA CONSENT CHAN FAIL\n\0"

  pub let dma_consent_channel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M4-002 (#1211): boot witness. Stages: (1) reset + pack/unpack round-trip. (2) refuse malformed ops. (3) request/reply round-trip. (4) in-flight duplicate refused. (5) seq-mismatch on stray reply. (6) pending count discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dccw_stage];
        mov [rcx], rax;

        call dma_consent_channel_reset;

        // Pack / unpack round-trip.
        mov rdi, 0;                      // REQ_CONSENT
        mov rsi, 0x000021;               // dock_id
        mov rdx, 0;                      // req_seq
        call dcc_pack_word0;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r15, r11;
        je  dccw_fail_stage;

        mov rdi, r15;
        call dcc_word0_op;
        cmp rax, 0;
        jne dccw_fail_stage;

        mov rdi, r15;
        call dcc_word0_dock;
        cmp rax, 0x000021;
        jne dccw_fail_stage;

        // -- 2. Refuse malformed (op > 6).
        mov rax, 2;
        lea rcx, [rip + _dccw_stage];
        mov [rcx], rax;

        mov rdi, 7;
        mov rsi, 0x000021;
        mov rdx, 0;
        call dcc_pack_word0;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne dccw_fail_stage;

        // Refuse dock > 24 bits.
        mov rdi, 0;
        mov rsi, 0x1000000;
        mov rdx, 0;
        call dcc_pack_word0;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne dccw_fail_stage;

        // -- 3. Request/reply round-trip.
        mov rax, 3;
        lea rcx, [rip + _dccw_stage];
        mov [rcx], rax;

        mov rdi, 0x000021;               // dock_id
        mov rsi, 0x1000;                 // caller_endpoint
        mov rdx, 0xDEADBEEF;             // device_desc
        mov rcx, 0x1111;                 // issued_at
        call dma_consent_request;
        mov r15, rax;                    // seq
        mov r11, 0xFFFFF94F;
        cmp r15, r11;
        je  dccw_fail_stage;
        mov r11, 0xFFFFF949;
        cmp r15, r11;
        je  dccw_fail_stage;

        // Reply RESP_GRANTED (op=2) with the seq — must return
        // caller_endpoint = 0x1000.
        mov rdi, 2;
        mov rsi, r15;
        call dma_consent_reply;
        cmp rax, 0x1000;
        jne dccw_fail_stage;

        // -- 4. In-flight duplicate refused.
        mov rax, 4;
        lea rcx, [rip + _dccw_stage];
        mov [rcx], rax;

        mov rdi, 0x000022;
        mov rsi, 0x2000;
        mov rdx, 0xC0FFEE;
        mov rcx, 0x2222;
        call dma_consent_request;
        mov r14, rax;
        mov r11, 0xFFFFF949;
        cmp r14, r11;
        je  dccw_fail_stage;

        // Same (dock, endpoint) — must fail IN_FLIGHT.
        mov rdi, 0x000022;
        mov rsi, 0x2000;
        mov rdx, 0xC0FFEE;
        mov rcx, 0x2222;
        call dma_consent_request;
        mov r11, 0xFFFFF948;             // IN_FLIGHT
        cmp rax, r11;
        jne dccw_fail_stage;

        // -- 5. Seq mismatch on stray reply.
        mov rax, 5;
        lea rcx, [rip + _dccw_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // RESP_PENDING
        mov rsi, 0x000ABCDE;             // random seq that was never issued
        call dma_consent_reply;
        mov r11, 0xFFFFF947;             // SEQ_MISMATCH
        cmp rax, r11;
        jne dccw_fail_stage;

        // Bad op on reply.
        mov rdi, 0;                      // op=0 is REQ_CONSENT, not a reply
        mov rsi, r14;
        call dma_consent_reply;
        mov r11, 0xFFFFF94E;             // BAD_OP
        cmp rax, r11;
        jne dccw_fail_stage;

        // -- 6. Pending count. Should be exactly 1 (dock=0x22 still
        // pending; the 0x21 request was replied to).
        mov rax, 6;
        lea rcx, [rip + _dccw_stage];
        mov [rcx], rax;

        call dma_consent_req_pending_count;
        cmp rax, 1;
        jne dccw_fail_stage;

        // Reply for r14 — pending count returns to 0.
        mov rdi, 2;
        mov rsi, r14;
        call dma_consent_reply;
        cmp rax, 0x2000;
        jne dccw_fail_stage;

        call dma_consent_req_pending_count;
        cmp rax, 0;
        jne dccw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dccw_ok];
        call klog_s1;

        call dma_consent_channel_reset;
        xor rax, rax;
        jmp dccw_out;

      dccw_fail_stage:
        lea rax, [rip + _dccw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dccw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dma_consent_channel_reset;
        mov rax, 1;

      dccw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
