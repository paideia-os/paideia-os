// tests/kernel/ipc/fp_capture_channel_synth.pdx — R34.M6-002 (#1191)
//
// Boot witness for src/kernel/core/ipc/fp_capture_channel.pdx.
//
// Asserts pack/unpack round-trip and refusal discipline for the five
// frame ordinals (ENROLL_START, ENROLL_ADD_FRAME, ENROLL_COMMIT,
// VERIFY, DELETE_TEMPLATE).
//
// Fingerprint: R34 FP CAPTURE CHAN OK

module FpCaptureChannelSynth = structure {

  pub let mut _fpc_w_stage : u64 = 0

  pub let fpc_w_ok   : [u8; 24] = "R34 FP CAPTURE CHAN OK\n\0"
  pub let fpc_w_fail : [u8; 26] = "R34 FP CAPTURE CHAN FAIL\n\0"

  pub let fp_capture_channel_witness : () -> u64 !{sysreg} @{boot} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {boot},
      justification: "R34.M6-002 (#1191): boot witness for fp_capture_channel schema. Round-trips every op through packers and unpackers, and drives every refusal edge (BAD_TEMPLATE 0, BAD_OUTCOME 3).",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _fpc_w_stage];
        mov [rcx], rax;

        // -- 1. Validators.
        mov rdi, 0x4F;
        call fp_cap_op_valid;
        cmp rax, 0;
        jne fpc_w_fail_stage;
        mov rdi, 0x50;
        call fp_cap_op_valid;
        cmp rax, 1;
        jne fpc_w_fail_stage;
        mov rdi, 0x54;
        call fp_cap_op_valid;
        cmp rax, 1;
        jne fpc_w_fail_stage;
        mov rdi, 0x55;
        call fp_cap_op_valid;
        cmp rax, 0;
        jne fpc_w_fail_stage;

        // -- 2. ENROLL_START, ADD_FRAME, COMMIT request.
        mov rax, 2;
        lea rcx, [rip + _fpc_w_stage];
        mov [rcx], rax;

        call fp_cap_pack_enroll_start;
        cmp rax, 0x50;
        jne fpc_w_fail_stage;
        mov rdi, rax;
        call fp_cap_op;
        cmp rax, 0x50;
        jne fpc_w_fail_stage;

        call fp_cap_pack_enroll_add_frame;
        cmp rax, 0x51;
        jne fpc_w_fail_stage;

        call fp_cap_pack_enroll_commit;
        cmp rax, 0x52;
        jne fpc_w_fail_stage;

        // -- 3. ENROLL_COMMIT reply.
        mov rax, 3;
        lea rcx, [rip + _fpc_w_stage];
        mov [rcx], rax;

        mov rdi, 42;
        call fp_cap_pack_enroll_commit_reply;
        mov rbx, rax;
        mov rdi, rbx;
        call fp_cap_op;
        cmp rax, 0x52;
        jne fpc_w_fail_stage;
        mov rdi, rbx;
        call fp_cap_template_id;
        cmp rax, 42;
        jne fpc_w_fail_stage;

        // -- 4. VERIFY request and reply.
        mov rax, 4;
        lea rcx, [rip + _fpc_w_stage];
        mov [rcx], rax;

        mov rdi, 7;
        call fp_cap_pack_verify;
        mov rbx, rax;
        mov rdi, rbx;
        call fp_cap_template_id;
        cmp rax, 7;
        jne fpc_w_fail_stage;

        // VERIFY with tid == 0 refused.
        mov rdi, 0;
        call fp_cap_pack_verify;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fpc_w_fail_stage;

        // Reply with outcome = MATCH.
        mov rdi, 0;
        call fp_cap_pack_verify_reply;
        mov rbx, rax;
        mov rdi, rbx;
        call fp_cap_outcome;
        cmp rax, 0;
        jne fpc_w_fail_stage;

        // Reply with outcome = TIMEOUT.
        mov rdi, 2;
        call fp_cap_pack_verify_reply;
        mov rbx, rax;
        mov rdi, rbx;
        call fp_cap_outcome;
        cmp rax, 2;
        jne fpc_w_fail_stage;

        // BAD_OUTCOME (3).
        mov rdi, 3;
        call fp_cap_pack_verify_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fpc_w_fail_stage;

        // -- 5. DELETE_TEMPLATE.
        mov rax, 5;
        lea rcx, [rip + _fpc_w_stage];
        mov [rcx], rax;

        mov rdi, 99;
        call fp_cap_pack_delete_template;
        mov rbx, rax;
        mov rdi, rbx;
        call fp_cap_op;
        cmp rax, 0x54;
        jne fpc_w_fail_stage;
        mov rdi, rbx;
        call fp_cap_template_id;
        cmp rax, 99;
        jne fpc_w_fail_stage;

        // DELETE with tid == 0 refused.
        mov rdi, 0;
        call fp_cap_pack_delete_template;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fpc_w_fail_stage;

        // -- 6. Unpackers refuse a wrong-op word for outcome.
        mov rax, 6;
        lea rcx, [rip + _fpc_w_stage];
        mov [rcx], rax;

        // Feed ENROLL_START word to outcome unpacker.
        mov rdi, 0x50;
        call fp_cap_outcome;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fpc_w_fail_stage;

        // Feed ENROLL_START word to template_id unpacker.
        mov rdi, 0x50;
        call fp_cap_template_id;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fpc_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + fpc_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp fpc_w_out;

      fpc_w_fail_stage:
        lea rax, [rip + _fpc_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + fpc_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      fpc_w_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
