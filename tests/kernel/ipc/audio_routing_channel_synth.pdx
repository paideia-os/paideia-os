// tests/kernel/ipc/audio_routing_channel_synth.pdx -- R33.M5-001 (#1157)
//
// Boot witness for src/kernel/core/ipc/audio_routing_channel.pdx.
//
// Round-trips pack/unpack for CREATE_ROUTE, DESTROY_ROUTE, SET_GAIN,
// SET_MUTE + reply shapes; drives the refusal band.
//
// Fingerprint: R33 AUDIO ROUTING SCHEMA OK
//
// No cap slots. Pure pack/unpack.

module AudioRoutingChannelSynth = structure {

  pub let mut _arch_w_stage : u64 = 0

  // Trailing \n\0 (not just \0): klog_emit_core copies tag_ptr until NUL, and
  // the earlier off-by-one array size (27/29) TRUNCATED the terminator so
  // the copy ran on into the next .rodata symbol, merging this witness's
  // FAIL line with the next witness's OK ("R33 AUDIO ROUTING SCHEMA
  // FAILR31 BACKLIGHT CHANNEL OK line=2"). The \n mirrors bl_w_ok_a's pattern.
  pub let arch_w_ok   : [u8; 25] = "AUDIO ROUTING SCHEMA OK\0"
  pub let arch_w_fail : [u8; 27] = "AUDIO ROUTING SCHEMA FAIL\0"

  pub let audio_routing_channel_witness : () -> u64 !{sysreg} @{boot} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {boot},
      justification: "R33.M5-001 (#1157): boot witness for audio_routing_channel schema. Round-trips each of the four RPCs plus the four reply shapes, then drives the refusal band. Labels prefixed arch_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        // 1. op_valid enumeration.
        mov rax, 1;
        lea rcx, [rip + _arch_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call audio_routing_op_valid;
        cmp rax, 0;
        jne arch_w_fail_stage;
        mov rdi, 0x20;
        call audio_routing_op_valid;
        cmp rax, 1;
        jne arch_w_fail_stage;
        mov rdi, 0x23;
        call audio_routing_op_valid;
        cmp rax, 1;
        jne arch_w_fail_stage;
        mov rdi, 0x24;
        call audio_routing_op_valid;
        cmp rax, 0;
        jne arch_w_fail_stage;
        mov rdi, 0xF0;
        call audio_routing_op_valid;
        cmp rax, 0;
        jne arch_w_fail_stage;

        // 2. CREATE_ROUTE round-trip.
        mov rax, 2;
        lea rcx, [rip + _arch_w_stage];
        mov [rcx], rax;

        mov rdi, 3;                      // src
        mov rsi, 7;                      // dst
        xor rdx, rdx;                    // mute=0
        mov rcx, 1000;                   // gain=+1000
        call audio_routing_pack_create_req;
        mov rbx, rax;

        mov rdi, rbx;
        call audio_routing_req_op;
        cmp rax, 0x20;
        jne arch_w_fail_stage;

        mov rdi, rbx;
        call audio_routing_create_req_source;
        cmp rax, 3;
        jne arch_w_fail_stage;
        mov rdi, rbx;
        call audio_routing_create_req_dest;
        cmp rax, 7;
        jne arch_w_fail_stage;
        mov rdi, rbx;
        call audio_routing_create_req_mute;
        cmp rax, 0;
        jne arch_w_fail_stage;
        mov rdi, rbx;
        call audio_routing_create_req_gain;
        cmp rax, 1000;
        jne arch_w_fail_stage;

        // BAD_SLOT via packer.
        mov rdi, 256;
        mov rsi, 7;
        xor rdx, rdx;
        mov rcx, 1000;
        call audio_routing_pack_create_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne arch_w_fail_stage;

        // BAD_GAIN via packer.
        mov rdi, 3;
        mov rsi, 7;
        xor rdx, rdx;
        mov rcx, 0x8000;                 // out of Q15
        call audio_routing_pack_create_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne arch_w_fail_stage;

        // 3. DESTROY_ROUTE round-trip.
        mov rax, 3;
        lea rcx, [rip + _arch_w_stage];
        mov [rcx], rax;

        mov rdi, 42;
        call audio_routing_pack_destroy_req;
        mov rbx, rax;
        mov rdi, rbx;
        call audio_routing_req_op;
        cmp rax, 0x21;
        jne arch_w_fail_stage;
        mov rdi, rbx;
        call audio_routing_destroy_req_route;
        cmp rax, 42;
        jne arch_w_fail_stage;

        // 4. SET_GAIN round-trip.
        mov rax, 4;
        lea rcx, [rip + _arch_w_stage];
        mov [rcx], rax;

        mov rdi, 42;
        mov rsi, 0xFFFFFFFFFFFFFC18;     // -1000 sign-extended
        call audio_routing_pack_set_gain_req;
        mov rbx, rax;
        mov rdi, rbx;
        call audio_routing_req_op;
        cmp rax, 0x22;
        jne arch_w_fail_stage;
        mov rdi, rbx;
        call audio_routing_set_gain_req_route;
        cmp rax, 42;
        jne arch_w_fail_stage;
        mov rdi, rbx;
        call audio_routing_set_gain_req_gain;
        mov r11, 0xFFFFFFFFFFFFFC18;     // -1000
        cmp rax, r11;
        jne arch_w_fail_stage;

        // 5. SET_MUTE round-trip.
        mov rax, 5;
        lea rcx, [rip + _arch_w_stage];
        mov [rcx], rax;

        mov rdi, 42;
        mov rsi, 1;
        call audio_routing_pack_set_mute_req;
        mov rbx, rax;
        mov rdi, rbx;
        call audio_routing_req_op;
        cmp rax, 0x23;
        jne arch_w_fail_stage;
        mov rdi, rbx;
        call audio_routing_set_mute_req_route;
        cmp rax, 42;
        jne arch_w_fail_stage;
        mov rdi, rbx;
        call audio_routing_set_mute_req_mute;
        cmp rax, 1;
        jne arch_w_fail_stage;

        // BAD_MUTE via packer.
        mov rdi, 42;
        mov rsi, 2;
        call audio_routing_pack_set_mute_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne arch_w_fail_stage;

        // 6. Reply pack/unpack.
        mov rax, 6;
        lea rcx, [rip + _arch_w_stage];
        mov [rcx], rax;

        mov rdi, 99;
        mov rsi, 0;
        call audio_routing_pack_create_ack;
        mov rbx, rax;
        mov rdi, rbx;
        call audio_routing_req_op;
        cmp rax, 0xF0;
        jne arch_w_fail_stage;
        mov rdi, rbx;
        call audio_routing_create_ack_route;
        cmp rax, 99;
        jne arch_w_fail_stage;

        mov rdi, 0;
        call audio_routing_pack_destroy_ack;
        mov rbx, rax;
        mov rdi, rbx;
        call audio_routing_req_op;
        cmp rax, 0xF1;
        jne arch_w_fail_stage;

        // Success.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + arch_w_ok];
        call klog_s1;

        xor rax, rax;
        jmp arch_w_out;

      arch_w_fail_stage:
        lea rax, [rip + _arch_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + arch_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      arch_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
