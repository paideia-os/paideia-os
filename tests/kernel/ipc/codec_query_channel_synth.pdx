// tests/kernel/ipc/codec_query_channel_synth.pdx -- R33.M2-005 (#1146)
//
// Boot witness for src/kernel/core/ipc/codec_query_channel.pdx.
//
// Asserts the pack/unpack round-trip for GET_WIDGETS, GET_PINS,
// SET_PIN_CTL, SET_GAIN, SET_MUTE (both request and reply), and the
// refusal discipline for the four gates (BAD_OP, BAD_ADDR, BAD_NODE,
// BAD_PAYLOAD, BAD_COUNT).
//
// Fingerprint: R33 CODEC QUERY SCHEMA OK
//
// No cap slots. Pure pack/unpack.

module CodecQueryChannelSynth = structure {

  pub let mut _cqch_w_stage : u64 = 0

  pub let cqch_w_ok   : [u8; 22] = "CODEC QUERY SCHEMA OK\0"
  pub let cqch_w_fail : [u8; 24] = "CODEC QUERY SCHEMA FAIL\0"

  pub let codec_query_channel_witness : () -> u64 !{sysreg} @{boot} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {boot},
      justification: "R33.M2-005 (#1146): boot witness for codec_query_channel schema. Round-trips each of the five RPCs plus the three reply shapes, then drives the refusal band (BAD_OP via op_valid, BAD_ADDR via pack with codec_addr=16, BAD_NODE via pack with node=256, BAD_PAYLOAD via pack with ctl=256 / gain=128 / side=2 / mute=2, BAD_COUNT via reply with count=2^24). Pure arithmetic; no cap_table touch. Four-push prologue matches the sensor_read_channel witness. Labels prefixed cqch_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        // -- 1. op_valid enumeration.
        mov rax, 1;
        lea rcx, [rip + _cqch_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;                    // 0 -> refused
        call codec_q_op_valid;
        cmp rax, 0;
        jne cqch_w_fail_stage;
        mov rdi, 1;
        call codec_q_op_valid;
        cmp rax, 1;
        jne cqch_w_fail_stage;
        mov rdi, 5;
        call codec_q_op_valid;
        cmp rax, 1;
        jne cqch_w_fail_stage;
        mov rdi, 6;                      // past request set
        call codec_q_op_valid;
        cmp rax, 0;
        jne cqch_w_fail_stage;
        mov rdi, 0xF0;                   // SET_ACK, not a request
        call codec_q_op_valid;
        cmp rax, 0;
        jne cqch_w_fail_stage;

        // -- 2. get_widgets round-trip.
        mov rax, 2;
        lea rcx, [rip + _cqch_w_stage];
        mov [rcx], rax;
        mov rdi, 3;
        call codec_q_pack_get_widgets_req;
        mov rbx, rax;
        mov rdi, rbx;
        call codec_q_req_op;
        cmp rax, 1;
        jne cqch_w_fail_stage;
        mov rdi, rbx;
        call codec_q_get_widgets_req_addr;
        cmp rax, 3;
        jne cqch_w_fail_stage;

        // BAD_ADDR.
        mov rdi, 16;
        call codec_q_pack_get_widgets_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cqch_w_fail_stage;

        // -- 3. get_pins round-trip.
        mov rax, 3;
        lea rcx, [rip + _cqch_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        call codec_q_pack_get_pins_req;
        mov rbx, rax;
        mov rdi, rbx;
        call codec_q_req_op;
        cmp rax, 2;
        jne cqch_w_fail_stage;
        mov rdi, rbx;
        call codec_q_get_pins_req_addr;
        cmp rax, 2;
        jne cqch_w_fail_stage;

        // -- 4. set_pin_ctl round-trip.
        mov rax, 4;
        lea rcx, [rip + _cqch_w_stage];
        mov [rcx], rax;
        mov rdi, 1;                      // codec
        mov rsi, 5;                      // node
        mov rdx, 0x40;                   // ctl (hp_enable)
        call codec_q_pack_set_pin_ctl_req;
        mov rbx, rax;
        mov rdi, rbx;
        call codec_q_req_op;
        cmp rax, 3;
        jne cqch_w_fail_stage;
        mov rdi, rbx;
        call codec_q_set_pin_ctl_req_addr;
        cmp rax, 1;
        jne cqch_w_fail_stage;
        mov rdi, rbx;
        call codec_q_set_pin_ctl_req_node;
        cmp rax, 5;
        jne cqch_w_fail_stage;
        mov rdi, rbx;
        call codec_q_set_pin_ctl_req_ctl;
        cmp rax, 0x40;
        jne cqch_w_fail_stage;

        // BAD_NODE.
        mov rdi, 0;
        mov rsi, 256;
        mov rdx, 0;
        call codec_q_pack_set_pin_ctl_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cqch_w_fail_stage;

        // BAD_PAYLOAD (ctl >= 256).
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 256;
        call codec_q_pack_set_pin_ctl_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cqch_w_fail_stage;

        // -- 5. set_gain round-trip.
        mov rax, 5;
        lea rcx, [rip + _cqch_w_stage];
        mov [rcx], rax;
        mov rdi, 2;                      // codec
        mov rsi, 7;                      // node
        mov rdx, 0x50;                   // gain (7-bit)
        mov rcx, 1;                      // side = 1
        call codec_q_pack_set_gain_req;
        mov rbx, rax;
        mov rdi, rbx;
        call codec_q_req_op;
        cmp rax, 4;
        jne cqch_w_fail_stage;
        mov rdi, rbx;
        call codec_q_set_gain_req_gain;
        cmp rax, 0x50;
        jne cqch_w_fail_stage;
        mov rdi, rbx;
        call codec_q_set_gain_req_side;
        cmp rax, 1;
        jne cqch_w_fail_stage;

        // BAD_PAYLOAD (gain 128).
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 128;
        mov rcx, 0;
        call codec_q_pack_set_gain_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cqch_w_fail_stage;

        // BAD_PAYLOAD (side 2).
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 2;
        call codec_q_pack_set_gain_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cqch_w_fail_stage;

        // -- 6. set_mute round-trip.
        mov rax, 6;
        lea rcx, [rip + _cqch_w_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 9;
        mov rdx, 1;                      // mute on
        mov rcx, 0;                      // side = 0
        call codec_q_pack_set_mute_req;
        mov rbx, rax;
        mov rdi, rbx;
        call codec_q_req_op;
        cmp rax, 5;
        jne cqch_w_fail_stage;
        mov rdi, rbx;
        call codec_q_set_mute_req_mute;
        cmp rax, 1;
        jne cqch_w_fail_stage;

        // BAD_PAYLOAD (mute 2).
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 2;
        mov rcx, 0;
        call codec_q_pack_set_mute_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cqch_w_fail_stage;

        // -- 7. Reply packers.
        mov rax, 7;
        lea rcx, [rip + _cqch_w_stage];
        mov [rcx], rax;
        mov rdi, 54;
        call codec_q_pack_get_widgets_reply;
        mov rbx, rax;
        mov rdi, rbx;
        call codec_q_get_widgets_reply_count;
        cmp rax, 54;
        jne cqch_w_fail_stage;

        mov rdi, 8;
        call codec_q_pack_get_pins_reply;
        mov rbx, rax;
        mov rdi, rbx;
        call codec_q_get_pins_reply_count;
        cmp rax, 8;
        jne cqch_w_fail_stage;

        // BAD_COUNT.
        mov rdi, 16777216;
        call codec_q_pack_get_widgets_reply;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cqch_w_fail_stage;

        // SET_ACK round-trip.
        mov rdi, 42;
        call codec_q_pack_set_ack;
        mov rbx, rax;
        mov rdi, rbx;
        call codec_q_set_ack_status;
        cmp rax, 42;
        jne cqch_w_fail_stage;

        // -- 8. Unpackers refuse wrong-op frames.
        mov rax, 8;
        lea rcx, [rip + _cqch_w_stage];
        mov [rcx], rax;
        // get_widgets req decoded as set_pin_ctl addr -> DECODE_BAD.
        mov rdi, 3;
        call codec_q_pack_get_widgets_req;
        mov rdi, rax;
        call codec_q_set_pin_ctl_req_addr;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cqch_w_fail_stage;

        // set_ack decoded as set_gain gain -> DECODE_BAD.
        mov rdi, 0;
        call codec_q_pack_set_ack;
        mov rdi, rax;
        call codec_q_set_gain_req_gain;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne cqch_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cqch_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp cqch_w_out;

      cqch_w_fail_stage:
        lea rax, [rip + _cqch_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cqch_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      cqch_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
