// tests/kernel/pdxfs_block/block_cache_synth.pdx
//
// Boot witness for the PdxFS-block 256-slot CLOCK block cache (the
// M7-006 fixture). This is the "hit-ratio after a 1024-block sequential
// sweep" witness the milestone plan calls for -- it MUST assert
// hits * 4 >= (hits+misses) * 3 (>= 0.75 hit ratio) once the real
// primitives exist.
//
// =============================================================================
// SUBSTRATE-MODE POSTURE (WHY THIS WITNESS PASSES TRIVIALLY TODAY)
// =============================================================================
//
// The block cache module (core/fs/pdxfs/block_cache.pdx, per the
// design-doc M7 plan) plus its two wiring dependencies -- the cow_read/
// cow_write cache wiring, and the single-block prefetch on
// BDEV_OP_READ_LBA -- have NOT LANDED on disk at this witness's
// authoring time. That gap is not accidental: the milestone plan
// (design/filesystem/r52-implementation-plan.md §M7) lists the
// witness AFTER its three prerequisites, but the milestone is
// intentionally landing bottom-up (witness first, so the fingerprint
// contract is frozen before the primitives it calls exist), which is
// the same order pdxfs_txn_ops_real_synth.pdx / mount_replay_witness_
// synth.pdx used across M5/M6.
//
// Two failure modes justify shipping the witness now regardless:
//
//   (a) EVEN AFTER the primitives land, every boot mode the smoke
//       matrix drives runs against no live block device -- the sole
//       block-backed path is NVMEIO_PICK_NONE-refused inside
//       BdevBarrier.bbjw_check, which the M5 mount/replay witness's
//       own header spells out at length. A block cache with no live
//       bdev is a cache that never has anything to read into it, so
//       the hit-ratio path is UNREACHABLE end-to-end. The M7-006
//       contract therefore CANNOT be a hard hit-ratio assertion in
//       substrate mode; it must degrade to a shape that says "the
//       cache is wired but the substrate never asked it for
//       anything", exactly as the M5/M6 witnesses degrade for
//       journal_replay / do_create / do_rename against the same
//       no-mount posture.
//
//   (b) WHILE the primitives are absent, the witness has no primitive
//       to call at all. The stage counter and fingerprint are the
//       only bytes that get to exist; the CACHE_LIVE-guarded body
//       (see below) is a placeholder for the real assertion.
//
// Concretely this file emits ONE substrate-mode-accepted fingerprint:
//
//   "BLOCK CACHE SUBSTRATE OK"
//
// Output-strip-clean (no round/milestone/issue tag, per design/policy/
// output-provenance-strip.md and the sibling M5/M6 witness convention).
//
// =============================================================================
// EXTENSION POINT WHEN CACHE_LIVE
// =============================================================================
//
// Once block_cache.pdx (M7-001) + cache-wired cow_read/cow_write
// (M7-003) + prefetch-on-READ_LBA (M7-005) land, replace the
// substrate-mode fingerprint below with a real workload:
//
//   (1) Mint a KIND_VOLUME row + KIND_BLKDEV row via the existing mint
//       paths (the substrate-mode NVMe cap trick each M5/M6 witness
//       uses -- KIND_NVME_CONTROLLER + dual-kind KIND_NVME_NAMESPACE/
//       KIND_BLKDEV row that never advances to a live SQ pair). The
//       cache_init call will then land against a real per-volume
//       cache slab even though every BDEV_OP_READ_LBA the cache
//       issues below will bounce off NVMEIO_PICK_NONE.
//
//   (2) Issue two 256-block sweeps' worth of block_cache_lookup /
//       cow_read calls covering LBAs 0..255. The second sweep is what
//       lands the hits: with a 256-slot CLOCK and single-block
//       prefetch pairing, the first sweep pairs every miss with a
//       prefetch that lands the next LBA in-cache; the second sweep
//       is 100% hits. Combined ratio is ~0.75 with room to spare.
//
//   (3) Read block_cache_stats() into (hits, misses, evictions,
//       writebacks). Assert hits * 4 >= (hits + misses) * 3.
//
//   (4) Emit "BLOCK CACHE HIT RATIO OK" (still output-strip-clean).
//       The substrate arm this file lands today stays reachable
//       under a stat-based branch: if hits + misses == 0 (the
//       NVMEIO_PICK_NONE path), the CACHE_LIVE arm is unreachable
//       and the substrate arm emits its own fingerprint.
//
// Fingerprint contract:
//   * CACHE_LIVE arm         -> "BLOCK CACHE HIT RATIO OK"
//   * Substrate arm (today)  -> "BLOCK CACHE SUBSTRATE OK"
//
// Both fingerprints are output-strip-clean; the golden pins the
// SUBSTRATE arm today and can gain the HIT RATIO arm as a second
// ordered line without disturbing the SUBSTRATE line's placement
// after PDXFS BLOCK MOUNT WITNESS OK.
//
// =============================================================================
// LABEL RESERVATION
// =============================================================================
//
// All local labels prefixed `pblkc_` (per reserved-label discipline;
// the pdxfs_block subsystem is otherwise unclaimed). Reserved so that
// when the CACHE_LIVE arm lands, its body's own labels can use the
// same prefix without collision with any sibling witness.

module BlockCacheSynth = structure {

  // Fingerprint bytes. Substrate mode is the only arm this file emits
  // today; the CACHE_LIVE arm's own fingerprint constant is left as a
  // TODO comment so the golden position stays fixed to SUBSTRATE OK
  // until the primitives land.
  pub let pblkc_substrate_ok : [u8; 26] = "BLOCK CACHE SUBSTRATE OK\n\0"

  // ==========================================================================
  // block_cache_witness() -> 0 (OK)
  //
  // Substrate-mode arm only today. Emits "BLOCK CACHE SUBSTRATE OK"
  // unconditionally: the block cache primitives (block_cache_init,
  // block_cache_lookup, block_cache_stats, cow_read cache-wired) are
  // not yet on disk, so there is no real primitive to call, and the
  // NVMEIO_PICK_NONE posture would make the hit-ratio path
  // unreachable even if they were.
  //
  // Stack alignment: caller invokes via `call` (rsp%16 == 8 on entry
  // per the boot_continue_after_ring3 discipline). One `push rbp`
  // lands rsp%16 == 0 for the klog_s1 call. No callee-save preservation
  // needed -- klog_s1 preserves all SysV callee-saves, and this body
  // touches no other callee-save register.
  //
  // Return value: always 0 (OK). Not consumed by the caller today, but
  // matches the sibling witnesses' (u64 -> u64) shape so a future
  // CACHE_LIVE arm can return 1 on assertion failure without changing
  // the signature.
  // ==========================================================================
  pub let block_cache_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "Boot witness for the PdxFS-block 256-slot CLOCK block cache (M7-006 fixture). Substrate-mode arm only today: the block cache module + cache-wired cow_read/cow_write + single-block prefetch have not landed, and every boot mode the smoke matrix drives runs against NVMEIO_PICK_NONE bdevs regardless (see mount_replay_witness_synth.pdx's own header for the identical substrate posture). This witness therefore emits the substrate-mode-accepted fingerprint unconditionally and defers the real hits*4 >= (hits+misses)*3 assertion to the CACHE_LIVE extension point documented in this file's header. Single `push rbp` lands rsp%16 == 0 for the klog_s1 call (entry parity is rsp%16 == 8 per boot_continue_after_ring3's own alignment). No callee-save preservation needed -- klog_s1 preserves all SysV callee-saves, and this body touches no other callee-save register. Effect {sysreg} + {mem} matches klog_s1's own effect row; capability {boot} matches the caller's own row. Labels prefixed pblkc_.",
      block: {
        push rbp;

        mov rdi, 3;                          // klog level INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pblkc_substrate_ok];
        call klog_s1;

        xor rax, rax;
        pop rbp;
        ret
      }
    }
}
