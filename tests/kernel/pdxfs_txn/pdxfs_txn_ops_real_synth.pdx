// tests/kernel/pdxfs_txn/pdxfs_txn_ops_real_synth.pdx
//
// Boot witness for the KIND_PDXFS_TXN write-side op arms with their
// REAL bodies wired (post-R52.M6-001/004/005 -- pdxfs_txn_commit_wal,
// pdxfs_txn_abort_wal, pdxfs_txn_do_create, pdxfs_txn_do_rename).
//
// Sibling to tests/kernel/pdxfs_txn/pdxfs_txn_ops_synth.pdx: that
// fixture (R42-PREP-007) proves the op-code seams + STUB counters at
// the point where CREATE/RENAME/UNLINK were still wire-only stubs;
// this fixture proves the seams still hold now that COMMIT/ABORT/
// CREATE/RENAME dispatch into the real journal-writing / inode-
// allocating bodies -- and in particular that the "no root PdxFS-block
// mount" substrate mode every boot witness runs under still yields the
// well-typed outcome each real body's own header documents:
//
//   * pdxfs_txn_commit_wal   -- no mount is NOT an error (rax == 0),
//                               then pxt_hn_commit's transition arm
//                               takes the row OPEN -> COMMITTED.
//   * pdxfs_txn_abort_wal    -- symmetric: rax == 0, OPEN -> ABORTED.
//   * pdxfs_txn_do_create    -- no mount is a REAL refusal
//                               (PXT_TAIL_BAD_ARG, 0xFFFFEC1E). No
//                               transition; row stays OPEN.
//   * pdxfs_txn_do_rename    -- same posture as do_create.
//
// Both CREATE and RENAME accept EITHER a substrate-mode refusal OR
// (if a boot mode ever mounts a real block-backed root before this
// witness runs -- none does today, but the discipline established
// across M1..M5 witnesses accepts either NVMEIO_PICK_NONE-family
// substrate refusals or real success) rax == 0. Any other value is a
// hard failure.
//
// UNLINK (still a STUB at this landing per pxt_hn_unlink's own header
// comment) and PXT_STUB_OK's retirement are out of scope -- whichever
// of those lands first can extend this fixture in-place without
// disturbing the M6-004/005/001/002 assertions this file locks down.
//
// The witness deliberately calls cap_handler_pdxfs_txn directly
// (bypassing cap_invoke_dispatch), matching the sibling ops_synth
// witness's own precedent so a failure names the op-code seam without
// dragging in the kind-dispatch cascade.
//
// Uses cap slots 128..135 (disjoint from the sibling ops_synth's own
// 116..127 window -- both witnesses' pxor_clear/pxow_clear scrubs are
// slot-range-local and cannot collide).
//
// Fingerprint: "PDXFS TXN OPS REAL OK".

module PdxfsTxnOpsRealSynth = structure {

  pub let mut _pxor_stage : u64 = 0

  pub let pxor_ok   : [u8; 23] = "PDXFS TXN OPS REAL OK\n\0"
  pub let pxor_fail : [u8; 25] = "PDXFS TXN OPS REAL FAIL\n\0"

  // Names for the CREATE and RENAME stage helpers. Length values are
  // encoded as immediates rather than derived from the array length at
  // call sites (the pdxfs_txn_stage_* helpers take name_ptr + name_len
  // as separate args). The two rename halves reuse the same target
  // dir_inode (1, the root inode) since do_rename does not resolve
  // parent directories -- the value only threads back into the
  // JOP_DENTRY_DEL / _ADD record payloads and, in substrate mode, is
  // refused before either encode call anyway.
  pub let pxor_name_hello : [u8; 5] = "hello"
  pub let pxor_name_foo   : [u8; 3] = "foo"
  pub let pxor_name_bar   : [u8; 3] = "bar"

  // ==========================================================================
  // pxor_mem(slot, key, rights) -> ()
  //
  // Mint a synthetic KIND_MEMORY parent at `slot` so pdxfs_txn_cap_
  // mint_inner's parent gate accepts it. Same shape as pxow_mem/pxtw_
  // mem across the sibling witnesses.  Three callee-save pushes align
  // rsp%16 == 0 for the nested call.
  // ==========================================================================
  pub let pxor_mem : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "Boot witness helper: mint a synthetic KIND_MEMORY parent for the real-ops witness. Kind = 4 (KIND_MEMORY), rights per caller (typically RIGHT_MINT = 0x200). Mirrors pxow_mem in tests/kernel/pdxfs_txn/pdxfs_txn_ops_synth.pdx one-for-one. Labels prefixed pxor_m_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r14;                    // rights
        mov rcx, r13;                    // target_ptr = key
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pxor_clear() -> ()
  //
  // Scrub cap slots 128..135 so a witness re-run lands within a
  // predictable window. The sys_pdxfs_txn_open scan itself starts at
  // slot 0, so the returned cap_slot may fall outside 128..135
  // depending on the rest of boot state -- the witness does not depend
  // on WHICH slot it gets, only that it gets one.
  // ==========================================================================
  pub let pxor_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "Boot witness helper: clear cap_table slots 128..135 for the real-ops witness. Same shape as pxow_clear in the sibling ops_synth witness, one range up. Labels prefixed pxor_c_.",
      block: {
        push rbx;
        mov rbx, 128;
      pxor_c_loop:
        cmp rbx, 136;
        jae pxor_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pxor_c_loop;
      pxor_c_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pxor_open(mode, txn_id, wal_off) -> row_id (bounded < PXT_MAX = 16)
  //
  // Mint a fresh txn cap over the KIND_MEMORY parent at slot 128 via
  // the real sys_pdxfs_txn_open_body syscall entry, then resolve its
  // row_id via pdxfs_txn_row_of_slot. Returns 0xFF (PXT_ROW_NONE) or
  // any >= PXT_MAX sentinel on any failure so the caller can range-
  // check with the same `jae pxor_fail_stage` pattern the sibling
  // witness uses. Three callee-save pushes align rsp%16 == 0 across
  // the two nested cross-file calls.
  // ==========================================================================
  pub let pxor_open : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (mode: u64) (txn_id: u64) (wal_off: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "Boot witness helper: compose sys_pdxfs_txn_open_body + pdxfs_txn_row_of_slot into a single row_id-returning primitive. Parent slot pinned at 128 (this witness's own KIND_MEMORY parent minted in stage 1). Three callee-save pushes leave rsp%16 == 0. Labels prefixed pxor_o_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // mode
        mov r13, rsi;                    // txn_id
        mov r14, rdx;                    // wal_off

        mov rdi, 128;                    // parent_slot
        mov rsi, r12;                    // mode
        mov rdx, r13;                    // txn_id
        mov rcx, r14;                    // wal_off
        call sys_pdxfs_txn_open_body;

        // sys_pdxfs_txn_open_body returns a cap_slot in [0, 256) on
        // success; any error is >= 0xFFFFEC10 (in particular ENFILE,
        // encoded as -33 = 0xFFFFFFFFFFFFFFDF, is >= 256).
        mov r10, 256;
        cmp rax, r10;
        jae pxor_o_out;                  // forward the error verbatim

        // Resolve cap_slot -> row_id.
        mov rdi, rax;
        call pdxfs_txn_row_of_slot;
        // row_of_slot returns PXT_ROW_NONE (0xFF) on any failure; that
        // is >= PXT_MAX (16), so the same bound check the caller uses
        // catches it. Success (row < 16) falls through.

      pxor_o_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_txn_ops_real_witness() -> 0 (OK) | 1 (FAIL)
  //
  // Five callee-save pushes leave rsp%16 == 0 at every nested call.
  // Register plan:
  //   rbx = current txn row_id under exercise (per stage)
  //   r12..r15 = scratch, freshly loaded before each use
  // ==========================================================================
  pub let pdxfs_txn_ops_real_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "Boot witness for the KIND_PDXFS_TXN M6 real bodies. Stage (1) mints a KIND_MEMORY parent at slot 128 for every subsequent open. Stage (2) opens a txn (mode MODIFY, txn_id 0xE001), invokes PXT_OP_COMMIT via cap_handler_pdxfs_txn, expects rax == 0, verifies state == COMMITTED. Stage (3) opens a second txn (mode DELETE, txn_id 0xE002), invokes PXT_OP_ABORT, expects rax == 0, verifies state == ABORTED. Stage (4) opens a third txn (mode CREATE, txn_id 0xE003), stages a target name via pdxfs_txn_stage_create_name, invokes PXT_OP_CREATE, and accepts EITHER rax == 0 (success) OR rax == PXT_TAIL_BAD_ARG (0xFFFFEC1E -- the substrate-mode refusal each real M6 body documents for a boot with no PdxFS-block root mount). Stage (5) opens a fourth txn (mode MODIFY, txn_id 0xE004), stages both rename halves via pdxfs_txn_stage_rename_src/_dst, invokes PXT_OP_RENAME, and accepts the same {success | substrate refusal} pair. Direct call to cap_handler_pdxfs_txn bypasses cap_invoke_dispatch so a failure names the op-code seam. Five callee-save pushes (rbx/r12/r13/r14/r15) leave rsp%16 == 0. Effects/capabilities widen to match the widest nested call (sys_pdxfs_txn_open_body -> {mem, sysreg} @ {cap} plus boot for klog_s1). Labels prefixed pxor_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ==================================================================
        // (1) Reset. Scrub cap slots 128..135, reset the transaction
        //     table, mint a KIND_MEMORY parent at slot 128 carrying
        //     RIGHT_MINT so every subsequent sys_pdxfs_txn_open_body
        //     call has a valid parent to land against.
        // ==================================================================
        mov rax, 1;
        lea rcx, [rip + _pxor_stage];
        mov [rcx], rax;
        call pxor_clear;
        call pdxfs_txn_table_reset;
        mov rdi, 128;
        mov rsi, 0xF130;                 // opaque parent key
        mov rdx, 0x200;                  // RIGHT_MINT
        call pxor_mem;

        // ==================================================================
        // (2) PXT_OP_COMMIT -- REAL body via pdxfs_txn_commit_wal.
        //     Open a txn (mode MODIFY, so no CREATE/DELETE semantics
        //     bleed into the commit path). No block-backed root mount
        //     is present in substrate mode, so pdxfs_txn_commit_wal
        //     short-circuits to PXT_OK (== 0) per its own header
        //     comment; pxt_hn_commit then transitions the row
        //     OPEN -> COMMITTED via pdxfs_txn_row_transition. A
        //     non-zero rax here means either the mount-table gate
        //     misfired or the transition arm broke.
        // ==================================================================
        mov rax, 2;
        lea rcx, [rip + _pxor_stage];
        mov [rcx], rax;
        mov rdi, 2;                      // PXT_MODE_MODIFY
        mov rsi, 0xE001;                 // txn_id
        mov rdx, 0x3000;                 // wal_off
        call pxor_open;
        mov r10, 16;                     // PXT_MAX
        cmp rax, r10;
        jae pxor_fail_stage;
        mov rbx, rax;                    // rbx = row_id under exercise

        mov rdi, 0x008;                  // R_PDXFS_TXN_INVOKE
        mov rsi, rbx;                    // target_ptr = row_id
        mov rdx, 7;                      // PXT_OP_COMMIT
        call cap_handler_pdxfs_txn;
        cmp rax, 0;
        jne pxor_fail_stage;

        mov rdi, rbx;
        call pdxfs_txn_row_state;
        cmp rax, 2;                      // PXT_STATE_COMMITTED
        jne pxor_fail_stage;

        // ==================================================================
        // (3) PXT_OP_ABORT -- REAL body via pdxfs_txn_abort_wal.
        //     Mirrors stage (2): open, invoke, expect rax == 0,
        //     verify state == ABORTED.
        // ==================================================================
        mov rax, 3;
        lea rcx, [rip + _pxor_stage];
        mov [rcx], rax;
        mov rdi, 3;                      // PXT_MODE_DELETE
        mov rsi, 0xE002;                 // txn_id
        mov rdx, 0x4000;                 // wal_off
        call pxor_open;
        mov r10, 16;
        cmp rax, r10;
        jae pxor_fail_stage;
        mov rbx, rax;

        mov rdi, 0x008;
        mov rsi, rbx;
        mov rdx, 8;                      // PXT_OP_ABORT
        call cap_handler_pdxfs_txn;
        cmp rax, 0;
        jne pxor_fail_stage;

        mov rdi, rbx;
        call pdxfs_txn_row_state;
        cmp rax, 3;                      // PXT_STATE_ABORTED
        jne pxor_fail_stage;

        // ==================================================================
        // (4) PXT_OP_CREATE -- REAL body via pdxfs_txn_do_create.
        //     Open a fresh txn (mode CREATE), stage a 5-byte target
        //     name ("hello") via pdxfs_txn_stage_create_name, then
        //     invoke. Substrate mode has no MOUNT_BACKEND_PDXFS_BLOCK
        //     root mount so do_create's own gate refuses with PXT_
        //     TAIL_BAD_ARG (0xFFFFEC1E) before any journal or inode
        //     write is attempted -- this is a REAL refusal, not a
        //     silent no-op (do_create's own header spells that out
        //     explicitly). Accept EITHER 0 (success -- if a future
        //     boot mode mounts a real block-backed root before this
        //     witness runs) OR 0xFFFFEC1E (the documented substrate
        //     refusal). Any other value fails.
        // ==================================================================
        mov rax, 4;
        lea rcx, [rip + _pxor_stage];
        mov [rcx], rax;
        mov rdi, 1;                      // PXT_MODE_CREATE
        mov rsi, 0xE003;
        mov rdx, 0x5000;
        call pxor_open;
        mov r10, 16;
        cmp rax, r10;
        jae pxor_fail_stage;
        mov rbx, rax;

        // Stage the target name for this row.
        mov rdi, rbx;                    // row_id
        lea rsi, [rip + pxor_name_hello];
        mov rdx, 5;                      // name_len
        call pdxfs_txn_stage_create_name;

        // Invoke PXT_OP_CREATE.
        mov rdi, 0x008;
        mov rsi, rbx;
        mov rdx, 9;                      // PXT_OP_CREATE
        call cap_handler_pdxfs_txn;
        cmp rax, 0;
        je  pxor_create_ok;
        mov r11, 0xFFFFEC1E;             // PXT_TAIL_BAD_ARG
        cmp rax, r11;
        jne pxor_fail_stage;
      pxor_create_ok:

        // ==================================================================
        // (5) PXT_OP_RENAME -- REAL body via pdxfs_txn_do_rename.
        //     Mirrors stage (4): open (mode MODIFY), stage both ends
        //     (src=foo, dst=bar; dir_inode=1, target_inode=1 --
        //     substrate mode never touches these values before the
        //     refusal), invoke, accept {0 | PXT_TAIL_BAD_ARG}.
        // ==================================================================
        mov rax, 5;
        lea rcx, [rip + _pxor_stage];
        mov [rcx], rax;
        mov rdi, 2;                      // PXT_MODE_MODIFY
        mov rsi, 0xE004;
        mov rdx, 0x6000;
        call pxor_open;
        mov r10, 16;
        cmp rax, r10;
        jae pxor_fail_stage;
        mov rbx, rax;

        // Stage rename source: (row_id, old_dir_inode, old_name_ptr,
        // old_name_len).
        mov rdi, rbx;
        mov rsi, 1;                      // old_dir_inode (root)
        lea rdx, [rip + pxor_name_foo];
        mov rcx, 3;                      // old_name_len
        call pdxfs_txn_stage_rename_src;

        // Stage rename destination: (row_id, new_dir_inode, new_name_ptr,
        // new_name_len, target_inode).
        mov rdi, rbx;
        mov rsi, 1;                      // new_dir_inode (root)
        lea rdx, [rip + pxor_name_bar];
        mov rcx, 3;                      // new_name_len
        mov r8,  1;                      // target_inode (placeholder)
        call pdxfs_txn_stage_rename_dst;

        // Invoke PXT_OP_RENAME.
        mov rdi, 0x008;
        mov rsi, rbx;
        mov rdx, 10;                     // PXT_OP_RENAME
        call cap_handler_pdxfs_txn;
        cmp rax, 0;
        je  pxor_rename_ok;
        mov r11, 0xFFFFEC1E;             // PXT_TAIL_BAD_ARG
        cmp rax, r11;
        jne pxor_fail_stage;
      pxor_rename_ok:

        // ==================================================================
        // (6) Success -- emit OK fingerprint and tear down.
        // ==================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxor_ok];
        call klog_s1;

        call pxor_clear;
        call pdxfs_txn_table_reset;
        xor rax, rax;
        jmp pxor_out;

      pxor_fail_stage:
        lea rax, [rip + _pxor_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxor_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pxor_clear;
        call pdxfs_txn_table_reset;
        mov rax, 1;

      pxor_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
