// tests/kernel/pdxfs_txn/pdxfs_txn_ops_synth.pdx -- R42-PREP-007 (#1629)
//
// Boot witness for the KIND_PDXFS_TXN write-side op codes landed at
// #1629: sys_pdxfs_txn_open (syscall body), PXT_OP_COMMIT (op 7),
// PXT_OP_ABORT (op 8), PXT_OP_CREATE (op 9), PXT_OP_RENAME (op 10),
// PXT_OP_UNLINK (op 11).
//
// Two round trips:
//
//   (A) open -> create-refuse -> commit -> query_state
//       Mint mode = PXT_MODE_CREATE (1). CREATE now has a real walker
//       body (R52.M6-001/#1709); without a staged target name and no
//       mounted PdxFS-block root the witness expects the refusal code
//       PXT_TAIL_BAD_ARG (0xFFFFEC1E). After commit the row's state
//       byte transitions OPEN (1) -> COMMITTED (2). A second commit
//       refuses with PXT_BAD_TRANSITION.
//
//   (B) open -> unlink-refuse -> abort -> query_state
//       Mint mode = PXT_MODE_DELETE (3). UNLINK now has a real walker
//       body (R52.M6-003/#1711); without a staged target the witness
//       expects the refusal code TXN_UNLINK_NO_NAME (0xFFFFED2B).
//       After abort the row's state byte transitions OPEN (1) ->
//       ABORTED (3). A commit after abort refuses with
//       PXT_BAD_TRANSITION.
//
// A third stage exercises PXT_OP_RENAME on the (now COMMITTED) txn 1
// row; RENAME's OPEN gate refuses with PXT_BAD_TRANSITION
// (0xFFFFEC15), proving the RENAME dispatch arm is wired to a real
// walker (R52.M6-002/#1710) rather than a substrate-prep stub.
//
// R52.M6-006 (#1714) retired the R42-PREP-007 STUB-return sentinel
// PXT_STUB_OK; every op-code arm now returns PXT_OK on success or a
// real errno on failure, so the CREATE / RENAME / UNLINK per-op
// success counters only bump on a mount-backed transaction (not this
// synthetic KIND_MEMORY witness) -- the counter assertions therefore
// cover only the always-bumped OPENS / COMMITS / ABORTS slots.
//
// Fingerprint: R42-PREP-007 PDXFS TXN OPS OK
//
// Uses cap slots 116..127 (disjoint from the existing kind_pdxfs_
// txn_witness which owns 112..114 -- pxtw_clear scrubs exactly that
// range, so a run of both witnesses in sequence sees clean state
// per witness).
//
// The witness deliberately calls cap_handler_pdxfs_txn directly
// (bypassing cap_invoke_dispatch) so a failure in this file names
// the op-code seam without dragging in the kind-dispatch cascade
// -- matching every other tests/kernel/cap/kind_*_synth.pdx that
// tests one kind in isolation.

module PdxfsTxnOpsSynth = structure {

  pub let mut _pxow_stage : u64 = 0

  pub let pxow_ok   : [u8; 18] = "PDXFS TXN OPS OK\n\0"
  pub let pxow_fail : [u8; 20] = "PDXFS TXN OPS FAIL\n\0"

  // ==========================================================================
  // pxow_mem(slot, key, rights) -> ()
  //
  // Mint a synthetic KIND_MEMORY parent at `slot` so pdxfs_txn_cap_
  // mint_inner's parent gate accepts it.  Same shape as pxtw_mem in
  // tests/kernel/cap/kind_pdxfs_txn_synth.pdx §Section 1.  Three
  // callee-save pushes align rsp%16 == 0 for the nested call.
  // ==========================================================================
  pub let pxow_mem : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R42-PREP-007 (#1629): mint a synthetic KIND_MEMORY parent for the ops witness. Kind = 4 (KIND_MEMORY), rights per caller (typically RIGHT_MINT = 0x200). Labels prefixed pxow_m_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r14;                    // rights
        mov rcx, r13;                    // target_ptr = key
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pxow_clear() -> ()
  //
  // Scrub cap slots 116..127 so the sys_pdxfs_txn_open free-slot
  // scan lands within a predictable window on witness re-run.  The
  // scan itself starts at slot 0, so the returned cap_slot may fall
  // outside 116..127 depending on the rest of the boot state -- the
  // witness does not depend on WHICH slot it gets, only that it
  // gets one.
  // ==========================================================================
  pub let pxow_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R42-PREP-007 (#1629): clear cap_table slots 116..127. Labels prefixed pxow_c_.",
      block: {
        push rbx;
        mov rbx, 116;
      pxow_c_loop:
        cmp rbx, 128;
        jae pxow_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pxow_c_loop;
      pxow_c_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_txn_ops_witness() -> 0 (OK) | 1 (FAIL)
  //
  // Five callee-save pushes leave rsp %16 == 0 at every nested
  // call.  Register plan:
  //   rbx = txn 1 cap slot (survives cross-file calls)
  //   r12 = txn 1 row_id
  //   r13 = txn 2 cap slot
  //   r14 = txn 2 row_id
  //   r15 = scratch for counter reads
  // ==========================================================================
  pub let pdxfs_txn_ops_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R42-PREP-007 (#1629): boot witness for KIND_PDXFS_TXN write-side ops (sys_pdxfs_txn_open + PXT_OP_COMMIT/ABORT/CREATE/RENAME/UNLINK). Two round trips: (A) open -> create-stub -> commit -> query_state == COMMITTED; a duplicate commit refuses with PXT_BAD_TRANSITION. (B) open -> unlink-stub -> abort -> query_state == ABORTED; a commit-after-abort refuses. Third stage exercises PXT_OP_RENAME stub. Counter assertions verify OPENS/COMMITS/ABORTS/CREATES/UNLINKS/RENAMES all bumped. Five callee-save pushes leave rsp%16 == 0. Direct call to cap_handler_pdxfs_txn bypasses cap_invoke_dispatch so a failure names the op-code seam. Labels prefixed pxow_. Effects/capabilities widen to match sys_pdxfs_txn_open_body (mem, sysreg, cap) plus boot for klog_s1.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ==================================================================
        // (1) Reset the transaction table and clear the cap slot window.
        //     Mint a KIND_MEMORY parent at slot 116 carrying RIGHT_MINT.
        // ==================================================================
        mov rax, 1;
        lea rcx, [rip + _pxow_stage];
        mov [rcx], rax;
        call pxow_clear;
        call pdxfs_txn_table_reset;
        mov rdi, 116;
        mov rsi, 0xF120;
        mov rdx, 0x200;                  // RIGHT_MINT
        call pxow_mem;

        // ==================================================================
        // (2) Round trip A -- open + create-stub + commit.
        //     sys_pdxfs_txn_open_body(parent=116, mode=CREATE=1,
        //                             txn_id=0xD001, wal_off=0x1000)
        //     -> cap_slot in [0, 256).
        // ==================================================================
        mov rax, 2;
        lea rcx, [rip + _pxow_stage];
        mov [rcx], rax;
        mov rdi, 116;
        mov rsi, 1;                      // PXT_MODE_CREATE
        mov rdx, 0xD001;
        mov rcx, 0x1000;
        call sys_pdxfs_txn_open_body;
        mov r10, 256;
        cmp rax, r10;
        jae pxow_fail_stage;
        mov rbx, rax;                    // rbx = txn 1 cap slot

        // Extract row_id via the standard slot -> row helper.  Any
        // dead row / wrong kind returns PXT_ROW_NONE (0xFF), which
        // is >= PXT_MAX (16), so the same bound check catches both.
        mov rdi, rbx;
        call pdxfs_txn_row_of_slot;
        mov r10, 16;                     // PXT_MAX
        cmp rax, r10;
        jae pxow_fail_stage;
        mov r12, rax;                    // r12 = txn 1 row_id

        // Invoke PXT_OP_CREATE (op 9). Now dispatches to the REAL
        // pdxfs_txn_do_create body (R52.M6-001 landing). This witness
        // stages no target name, so do_create's own `name_len == 0`
        // gate refuses with PXT_TAIL_BAD_ARG (0xFFFFEC1E) before any
        // journal or inode write is attempted -- see pdxfs_txn_do_
        // create's own header comment for the refuse-not-noop posture.
        // The real-body coverage (staged name + substrate acceptance
        // of {success | PXT_TAIL_BAD_ARG}) lives in the sibling
        // pdxfs_txn_ops_real_synth.pdx witness; this arm now asserts
        // only the seam continues to route to a code that refuses on
        // an unstaged CREATE.
        // cap_handler_pdxfs_txn(rights=R_PDXFS_TXN_INVOKE=0x008,
        //                       target_ptr=row_id, op_arg=9).
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 9;
        call cap_handler_pdxfs_txn;
        mov r11, 0xFFFFEC1E;             // PXT_TAIL_BAD_ARG (no name staged)
        cmp rax, r11;
        jne pxow_fail_stage;

        // Invoke PXT_OP_COMMIT (op 7).  REAL -> PXT_OK (0).
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 7;
        call cap_handler_pdxfs_txn;
        cmp rax, 0;
        jne pxow_fail_stage;

        // Query state via the row accessor -- expect COMMITTED (2).
        mov rdi, r12;
        call pdxfs_txn_row_state;
        cmp rax, 2;
        jne pxow_fail_stage;

        // Duplicate commit -- expect PXT_BAD_TRANSITION.
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 7;
        call cap_handler_pdxfs_txn;
        mov r11, 0xFFFFEC15;             // PXT_BAD_TRANSITION
        cmp rax, r11;
        jne pxow_fail_stage;

        // ==================================================================
        // (3) Round trip B -- open + unlink-stub + abort.
        //     mode = PXT_MODE_DELETE (3); txn_id = 0xD002; wal 0x2000.
        // ==================================================================
        mov rax, 3;
        lea rcx, [rip + _pxow_stage];
        mov [rcx], rax;
        mov rdi, 116;
        mov rsi, 3;                      // PXT_MODE_DELETE
        mov rdx, 0xD002;
        mov rcx, 0x2000;
        call sys_pdxfs_txn_open_body;
        mov r10, 256;
        cmp rax, r10;
        jae pxow_fail_stage;
        mov r13, rax;                    // r13 = txn 2 cap slot

        mov rdi, r13;
        call pdxfs_txn_row_of_slot;
        mov r10, 16;
        cmp rax, r10;
        jae pxow_fail_stage;
        mov r14, rax;                    // r14 = txn 2 row_id

        // Invoke PXT_OP_UNLINK (op 11). Now dispatches to the REAL
        // pdxfs_txn_do_unlink body (R52.M6-003 landing). This witness
        // stages no target, so do_unlink's own `name_len == 0` gate
        // refuses with TXN_UNLINK_NO_NAME (0xFFFFED2B) -- distinct
        // from CREATE's generic PXT_TAIL_BAD_ARG (do_unlink reserves
        // NO_NAME specifically for the "caller forgot the required
        // staging call" condition, mirroring #1710's own TXN_RENAME_
        // NO_SRC treatment). The real-body coverage (staged target +
        // substrate acceptance) lives in the sibling ops_real_synth
        // witness.
        mov rdi, 0x008;
        mov rsi, r14;
        mov rdx, 11;
        call cap_handler_pdxfs_txn;
        mov r11, 0xFFFFED2B;             // TXN_UNLINK_NO_NAME (no target staged)
        cmp rax, r11;
        jne pxow_fail_stage;

        // Invoke PXT_OP_ABORT (op 8).  REAL -> PXT_OK.
        mov rdi, 0x008;
        mov rsi, r14;
        mov rdx, 8;
        call cap_handler_pdxfs_txn;
        cmp rax, 0;
        jne pxow_fail_stage;

        // Query state -- expect ABORTED (3).
        mov rdi, r14;
        call pdxfs_txn_row_state;
        cmp rax, 3;
        jne pxow_fail_stage;

        // Commit-after-abort -- expect PXT_BAD_TRANSITION.
        mov rdi, 0x008;
        mov rsi, r14;
        mov rdx, 7;
        call cap_handler_pdxfs_txn;
        mov r11, 0xFFFFEC15;
        cmp rax, r11;
        jne pxow_fail_stage;

        // ==================================================================
        // (4) PXT_OP_RENAME on the already-COMMITTED txn 1 row (r12).
        //     Was a STUB call under R42-PREP-007; post-#1710 it
        //     dispatches to the REAL pdxfs_txn_do_rename body, whose
        //     first gate is `row_state == PXT_STATE_OPEN`. Since r12
        //     is COMMITTED (2), that gate refuses with PXT_BAD_
        //     TRANSITION (0xFFFFEC15) -- see pdxfs_txn_do_rename's own
        //     header. This assertion also proves the state gate is
        //     reached BEFORE any stage/mount work, i.e. that the seam
        //     survived the STUB retirement in the correct order. The
        //     real-body coverage (fresh OPEN row + staged src/dst +
        //     substrate acceptance) lives in the sibling ops_real_
        //     synth witness.
        // ==================================================================
        mov rax, 4;
        lea rcx, [rip + _pxow_stage];
        mov [rcx], rax;
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 10;                     // PXT_OP_RENAME
        call cap_handler_pdxfs_txn;
        mov r11, 0xFFFFEC15;             // PXT_BAD_TRANSITION (row is COMMITTED)
        cmp rax, r11;
        jne pxow_fail_stage;

        // ==================================================================
        // (5) Counter assertions.  Every counter must be >= its
        //     expected minimum (2 opens, 1 commit, 1 abort).  We
        //     assert `>=` rather than `==` so a future addition of
        //     extra witness stages does not break this one -- and so
        //     pxow_fail_stage sees which stage failed via _pxow_stage.
        //
        //     The CREATES/RENAMES/UNLINKS counters are NOT asserted
        //     here: post-#1709/#1710/#1711 those bump ONLY on the
        //     success return path (matching COMMIT/ABORT's own bump-
        //     only-on-success convention). Every CREATE/UNLINK/RENAME
        //     call this witness issues refuses -- CREATE with PXT_
        //     TAIL_BAD_ARG (no name staged), UNLINK with TXN_UNLINK_
        //     NO_NAME, RENAME with PXT_BAD_TRANSITION (COMMITTED
        //     row) -- and refusals do not bump. The real-body
        //     coverage that exercises the success bump path lives in
        //     the sibling pdxfs_txn_ops_real_synth.pdx witness.
        // ==================================================================
        mov rax, 5;
        lea rcx, [rip + _pxow_stage];
        mov [rcx], rax;

        mov rdi, 9;                      // PXT_ST_OPENS
        call pdxfs_txn_stat;
        cmp rax, 2;
        jb  pxow_fail_stage;

        mov rdi, 4;                      // PXT_ST_COMMITS
        call pdxfs_txn_stat;
        cmp rax, 1;
        jb  pxow_fail_stage;

        mov rdi, 5;                      // PXT_ST_ABORTS
        call pdxfs_txn_stat;
        cmp rax, 1;
        jb  pxow_fail_stage;

        // ==================================================================
        // (6) Success -- emit OK fingerprint and tear down.
        // ==================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxow_ok];
        call klog_s1;

        call pxow_clear;
        call pdxfs_txn_table_reset;
        xor rax, rax;
        jmp pxow_out;

      pxow_fail_stage:
        lea rax, [rip + _pxow_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxow_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pxow_clear;
        call pdxfs_txn_table_reset;
        mov rax, 1;

      pxow_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
