// tests/kernel/fs/pdxfs/nvme_write_synth.pdx -- R42.M5-001 (#1396)
//
// Boot witness for the PDXFS v1 NVMe write path integration.
// Exercises reset (queue + state cleared, next_cid == 1),
// bad-len refusal, submit -> read-back of (cid, lba, len, status =
// PENDING), batch_flush moves entries to SUBMITTED (bumps
// flushed_total + flush_count), completion of a submitted cid
// (bumps completion_count, status -> COMPLETED), completion
// of an already-completed cid (ALREADY_DONE), completion of a
// pending cid (NOT_SUBMIT), completion of an unknown cid (BAD_CID),
// SQ-full path (submit until batch_head == depth), then reset clears.
//
// Fingerprint: PDXFS NVME WRITE OK
// Failure fingerprint: PDXFS NVME WRITE FAIL + stage number.

module NvmeWriteSynth = structure {

  pub let mut _nvww_stage : u64 = 0

  pub let nvww_ok : [u8; 22] = "PDXFS NVME WRITE OK\0"
  pub let nvww_fail : [u8; 24] = "PDXFS NVME WRITE FAIL\0"

  pub let nvme_write_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M5-001 (#1396): boot witness for pdxfs nvme_write. Five-push callee-save discipline. Stages exercise: reset defaults, len=0 refusal, three-write submit + read-back, batch_flush transitions, three completions (one already-done, one pending, one bad-cid), and a full-SQ fill. Labels prefixed nvww_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- S1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _nvww_stage];
        mov [rcx], rax;

        call nvw_reset;
        call nvw_bound;
        cmp rax, 1;
        jne nvww_fail_stage;
        call nvw_err;
        cmp rax, 0;
        jne nvww_fail_stage;
        call nvw_depth;
        cmp rax, 64;
        jne nvww_fail_stage;
        call nvw_batch_head;
        cmp rax, 0;
        jne nvww_fail_stage;
        call nvw_next_cid;
        cmp rax, 1;
        jne nvww_fail_stage;
        call nvw_submit_count;
        cmp rax, 0;
        jne nvww_fail_stage;
        call nvw_flush_count;
        cmp rax, 0;
        jne nvww_fail_stage;
        call nvw_flushed_total;
        cmp rax, 0;
        jne nvww_fail_stage;
        call nvw_completion_count;
        cmp rax, 0;
        jne nvww_fail_stage;

        // -- S2. submit len=0 refused (BAD_LEN).
        mov rax, 2;
        lea rcx, [rip + _nvww_stage];
        mov [rcx], rax;

        mov rdi, 0x1000;
        mov rsi, 0;
        call nvw_submit;
        cmp rax, 0;
        jne nvww_fail_stage;
        call nvw_err;
        mov r11, 0xFFFFEF0D;                    // NVW_ERR_BAD_LEN
        cmp rax, r11;
        jne nvww_fail_stage;
        call nvw_reset;

        // -- S3. Three good submits: cids 1, 2, 3.
        mov rax, 3;
        lea rcx, [rip + _nvww_stage];
        mov [rcx], rax;

        mov rdi, 0x1000;
        mov rsi, 0x200;
        call nvw_submit;
        cmp rax, 1;
        jne nvww_fail_stage;
        mov rdi, 0x2000;
        mov rsi, 0x400;
        call nvw_submit;
        cmp rax, 2;
        jne nvww_fail_stage;
        mov rdi, 0x3000;
        mov rsi, 0x600;
        call nvw_submit;
        cmp rax, 3;
        jne nvww_fail_stage;

        call nvw_batch_head;
        cmp rax, 3;
        jne nvww_fail_stage;
        call nvw_next_cid;
        cmp rax, 4;
        jne nvww_fail_stage;
        call nvw_submit_count;
        cmp rax, 3;
        jne nvww_fail_stage;

        // Read-back entry 0 (cid=1, lba=0x1000, len=0x200, status=PENDING).
        mov rdi, 0; call nvw_cid_at; cmp rax, 1; jne nvww_fail_stage;
        mov rdi, 0; call nvw_lba_at; mov r11, 0x1000; cmp rax, r11; jne nvww_fail_stage;
        mov rdi, 0; call nvw_len_at; mov r11, 0x200; cmp rax, r11; jne nvww_fail_stage;
        mov rdi, 0; call nvw_status_at; cmp rax, 0; jne nvww_fail_stage;

        // Read-back entry 2 (cid=3, lba=0x3000, len=0x600, status=PENDING).
        mov rdi, 2; call nvw_cid_at; cmp rax, 3; jne nvww_fail_stage;
        mov rdi, 2; call nvw_lba_at; mov r11, 0x3000; cmp rax, r11; jne nvww_fail_stage;
        mov rdi, 2; call nvw_len_at; mov r11, 0x600; cmp rax, r11; jne nvww_fail_stage;
        mov rdi, 2; call nvw_status_at; cmp rax, 0; jne nvww_fail_stage;

        // -- S4. batch_flush moves 3 pending -> submitted.
        mov rax, 4;
        lea rcx, [rip + _nvww_stage];
        mov [rcx], rax;

        call nvw_batch_flush;
        cmp rax, 3;
        jne nvww_fail_stage;
        call nvw_flush_count;
        cmp rax, 1;
        jne nvww_fail_stage;
        call nvw_flushed_total;
        cmp rax, 3;
        jne nvww_fail_stage;
        // Every entry is now SUBMITTED (status = 1).
        mov rdi, 0; call nvw_status_at; cmp rax, 1; jne nvww_fail_stage;
        mov rdi, 1; call nvw_status_at; cmp rax, 1; jne nvww_fail_stage;
        mov rdi, 2; call nvw_status_at; cmp rax, 1; jne nvww_fail_stage;
        // Second flush is a no-op (no entries in PENDING) but still bumps
        // flush_count.
        call nvw_batch_flush;
        cmp rax, 0;
        jne nvww_fail_stage;
        call nvw_flush_count;
        cmp rax, 2;
        jne nvww_fail_stage;
        call nvw_flushed_total;
        cmp rax, 3;
        jne nvww_fail_stage;

        // -- S5. completion(cid=2) transitions entry 1 -> COMPLETED.
        mov rax, 5;
        lea rcx, [rip + _nvww_stage];
        mov [rcx], rax;

        mov rdi, 2;
        call nvw_completion;
        cmp rax, 1;
        jne nvww_fail_stage;
        mov rdi, 1; call nvw_status_at; cmp rax, 2; jne nvww_fail_stage;
        call nvw_completion_count;
        cmp rax, 1;
        jne nvww_fail_stage;

        // Re-completion of same cid -> ALREADY_DONE.
        mov rdi, 2;
        call nvw_completion;
        cmp rax, 0;
        jne nvww_fail_stage;
        call nvw_err;
        mov r11, 0xFFFFEF0B;                    // NVW_ERR_ALREADY_DONE
        cmp rax, r11;
        jne nvww_fail_stage;
        // Clear latch by re-seeding.
        call nvw_reset;

        // -- S6. Completion of pending cid -> NOT_SUBMIT.
        mov rax, 6;
        lea rcx, [rip + _nvww_stage];
        mov [rcx], rax;

        mov rdi, 0x4000;
        mov rsi, 0x800;
        call nvw_submit;
        cmp rax, 1;
        jne nvww_fail_stage;
        // Do NOT flush; entry status stays PENDING (0).
        mov rdi, 1;
        call nvw_completion;
        cmp rax, 0;
        jne nvww_fail_stage;
        call nvw_err;
        mov r11, 0xFFFFEF0A;                    // NVW_ERR_NOT_SUBMIT
        cmp rax, r11;
        jne nvww_fail_stage;
        call nvw_reset;

        // -- S7. Completion of unknown cid -> BAD_CID.
        mov rax, 7;
        lea rcx, [rip + _nvww_stage];
        mov [rcx], rax;

        mov rdi, 0x1000;
        mov rsi, 0x200;
        call nvw_submit;
        cmp rax, 1;
        jne nvww_fail_stage;
        call nvw_batch_flush;
        cmp rax, 1;
        jne nvww_fail_stage;
        mov rdi, 999;
        call nvw_completion;
        cmp rax, 0;
        jne nvww_fail_stage;
        call nvw_err;
        mov r11, 0xFFFFEF0C;                    // NVW_ERR_BAD_CID
        cmp rax, r11;
        jne nvww_fail_stage;
        call nvw_reset;

        // -- S8. Fill the SQ (64 entries), 65th submit -> SQ_FULL.
        mov rax, 8;
        lea rcx, [rip + _nvww_stage];
        mov [rcx], rax;

        xor rbx, rbx;                           // i = 0
      nvww_fill_top:
        cmp rbx, 64;
        jae nvww_fill_done;

        mov rdi, rbx;
        add rdi, 0x10000;                       // lba = 0x10000 + i
        mov rsi, 0x100;
        call nvw_submit;
        // Expected cid = i + 1
        mov r11, rbx;
        add r11, 1;
        cmp rax, r11;
        jne nvww_fail_stage;
        add rbx, 1;
        jmp nvww_fill_top;

      nvww_fill_done:
        call nvw_batch_head;
        cmp rax, 64;
        jne nvww_fail_stage;

        // 65th submit fails with SQ_FULL.
        mov rdi, 0x20000;
        mov rsi, 0x100;
        call nvw_submit;
        cmp rax, 0;
        jne nvww_fail_stage;
        call nvw_err;
        mov r11, 0xFFFFEF0E;                    // NVW_ERR_SQ_FULL
        cmp rax, r11;
        jne nvww_fail_stage;

        // Reset the module to a clean state.
        call nvw_reset;
        call nvw_bound;
        cmp rax, 1;
        jne nvww_fail_stage;
        call nvw_err;
        cmp rax, 0;
        jne nvww_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nvww_ok];
        call klog_s1;

        xor rax, rax;
        jmp nvww_out;

      nvww_fail_stage:
        lea rax, [rip + _nvww_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nvww_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      nvww_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
