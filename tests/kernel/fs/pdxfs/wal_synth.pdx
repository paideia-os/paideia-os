// tests/kernel/fs/pdxfs/wal_synth.pdx -- R42.M2-001 (#1384)
//
// Boot witness for the PDXFS-v1 WAL ring buffer. Exercises reset
// (ring cleared, next_seq = 1), append happy path with prev_seq
// chaining, bad-size refusal, ring-full refusal after 64 records
// (walked in a small prime, then reset), per-record accessor
// readback, bad-idx refusal on every accessor, fsync bookkeeping
// (high_water advances), write-ahead invariant refusal
// (wal_block_write before wal_fsync), and the OK block-write path
// after fsync.
//
// Fingerprint: R42 PDXFS WAL OK
// Failure fingerprint: R42 PDXFS WAL FAIL + stage number.

module WalSynth = structure {

  pub let mut _walw_stage : u64 = 0

  pub let walw_ok   : [u8; 19] = "R42 PDXFS WAL OK\n\0"
  pub let walw_fail : [u8; 21] = "R42 PDXFS WAL FAIL\n\0"

  pub let wal_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M2-001 (#1384): boot witness for pdxfs WAL. Five-push callee-save discipline. Labels prefixed walw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _walw_stage];
        mov [rcx], rax;

        call wal_reset;
        call wal_bound;
        cmp rax, 1;
        jne walw_fail_stage;
        call wal_err;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_head;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_next_seq;
        cmp rax, 1;
        jne walw_fail_stage;
        call wal_fsync_high_water;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_append_count;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_fsync_count;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_block_write_count;
        cmp rax, 0;
        jne walw_fail_stage;

        // -- 2. Bad-size refusal on append.
        mov rax, 2;
        lea rcx, [rip + _walw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call wal_append;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_err;
        mov r11, 0xFFFFEFCB;                    // WAL_ERR_BAD_SIZE
        cmp rax, r11;
        jne walw_fail_stage;
        call wal_head;
        cmp rax, 0;
        jne walw_fail_stage;

        // Clear the latch by resetting for the rest.
        call wal_reset;

        // -- 3. Bad-idx refusals on every accessor while ring empty.
        mov rax, 3;
        lea rcx, [rip + _walw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call wal_seq_at;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_err;
        mov r11, 0xFFFFEFCD;                    // WAL_ERR_BAD_IDX
        cmp rax, r11;
        jne walw_fail_stage;

        call wal_reset;
        mov rdi, 0;
        call wal_size_at;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_err;
        mov r11, 0xFFFFEFCD;
        cmp rax, r11;
        jne walw_fail_stage;

        call wal_reset;
        mov rdi, 0;
        call wal_checksum_at;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_err;
        mov r11, 0xFFFFEFCD;
        cmp rax, r11;
        jne walw_fail_stage;

        call wal_reset;
        mov rdi, 0;
        call wal_prev_at;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_err;
        mov r11, 0xFFFFEFCD;
        cmp rax, r11;
        jne walw_fail_stage;

        call wal_reset;
        mov rdi, 0;
        call wal_flags_at;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_err;
        mov r11, 0xFFFFEFCD;
        cmp rax, r11;
        jne walw_fail_stage;

        call wal_reset;

        // -- 4. Append happy path. Three records with prev-seq chain.
        //         record[0]: seq=1, size=100, prev=0
        //         record[1]: seq=2, size=200, prev=1
        //         record[2]: seq=3, size=300, prev=2
        mov rax, 4;
        lea rcx, [rip + _walw_stage];
        mov [rcx], rax;

        mov rdi, 100;
        mov rsi, 0;
        call wal_append;
        cmp rax, 1;
        jne walw_fail_stage;

        mov rdi, 200;
        mov rsi, 1;
        call wal_append;
        cmp rax, 2;
        jne walw_fail_stage;

        mov rdi, 300;
        mov rsi, 2;
        call wal_append;
        cmp rax, 3;
        jne walw_fail_stage;

        call wal_head;
        cmp rax, 3;
        jne walw_fail_stage;
        call wal_next_seq;
        cmp rax, 4;
        jne walw_fail_stage;
        call wal_append_count;
        cmp rax, 3;
        jne walw_fail_stage;

        // -- 5. Per-record readback.
        mov rax, 5;
        lea rcx, [rip + _walw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call wal_seq_at;
        cmp rax, 1;
        jne walw_fail_stage;
        mov rdi, 0;
        call wal_size_at;
        cmp rax, 100;
        jne walw_fail_stage;
        mov rdi, 0;
        call wal_prev_at;
        cmp rax, 0;
        jne walw_fail_stage;
        mov rdi, 0;
        call wal_flags_at;
        cmp rax, 0;
        jne walw_fail_stage;

        mov rdi, 1;
        call wal_seq_at;
        cmp rax, 2;
        jne walw_fail_stage;
        mov rdi, 1;
        call wal_size_at;
        cmp rax, 200;
        jne walw_fail_stage;
        mov rdi, 1;
        call wal_prev_at;
        cmp rax, 1;
        jne walw_fail_stage;

        mov rdi, 2;
        call wal_seq_at;
        cmp rax, 3;
        jne walw_fail_stage;
        mov rdi, 2;
        call wal_size_at;
        cmp rax, 300;
        jne walw_fail_stage;
        mov rdi, 2;
        call wal_prev_at;
        cmp rax, 2;
        jne walw_fail_stage;

        // Placeholder checksum = seq XOR size XOR prev_seq.
        //   record[0]: 1 XOR 100 XOR 0 = 101 (0x65)
        //   record[1]: 2 XOR 200 XOR 1 = 203 (0xCB)
        //   record[2]: 3 XOR 300 XOR 2 = 301 (0x12D)
        mov rdi, 0;
        call wal_checksum_at;
        cmp rax, 101;
        jne walw_fail_stage;
        mov rdi, 1;
        call wal_checksum_at;
        cmp rax, 203;
        jne walw_fail_stage;
        mov rdi, 2;
        call wal_checksum_at;
        cmp rax, 301;
        jne walw_fail_stage;

        // -- 6. Write-ahead invariant refusal: wal_block_write before
        //         wal_fsync must refuse with WAL_ERR_INVARIANT.
        mov rax, 6;
        lea rcx, [rip + _walw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call wal_block_write;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_err;
        mov r11, 0xFFFFEFCC;                    // WAL_ERR_INVARIANT
        cmp rax, r11;
        jne walw_fail_stage;
        call wal_block_write_count;
        cmp rax, 0;
        jne walw_fail_stage;

        // Bad-idx refusal on block_write for idx >= head.
        // (latch is already set from above; check that a NEW clean
        // state under a reset then a bad-idx call sets the right code.)
        call wal_reset;
        // Repopulate 3 records (identical to §4).
        mov rdi, 100;
        mov rsi, 0;
        call wal_append;
        mov rdi, 200;
        mov rsi, 1;
        call wal_append;
        mov rdi, 300;
        mov rsi, 2;
        call wal_append;

        mov rdi, 3;
        call wal_block_write;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_err;
        mov r11, 0xFFFFEFCD;                    // WAL_ERR_BAD_IDX
        cmp rax, r11;
        jne walw_fail_stage;

        // -- 7. fsync then block_write succeeds. High water advances
        //         to 3; every record's flags bit 0 becomes 1.
        mov rax, 7;
        lea rcx, [rip + _walw_stage];
        mov [rcx], rax;

        call wal_reset;
        mov rdi, 100;
        mov rsi, 0;
        call wal_append;
        mov rdi, 200;
        mov rsi, 1;
        call wal_append;
        mov rdi, 300;
        mov rsi, 2;
        call wal_append;

        call wal_fsync;
        cmp rax, 3;
        jne walw_fail_stage;
        call wal_fsync_high_water;
        cmp rax, 3;
        jne walw_fail_stage;
        call wal_fsync_count;
        cmp rax, 1;
        jne walw_fail_stage;

        mov rdi, 0;
        call wal_flags_at;
        cmp rax, 1;
        jne walw_fail_stage;
        mov rdi, 1;
        call wal_flags_at;
        cmp rax, 1;
        jne walw_fail_stage;
        mov rdi, 2;
        call wal_flags_at;
        cmp rax, 1;
        jne walw_fail_stage;

        mov rdi, 1;
        call wal_block_write;
        cmp rax, 1;
        jne walw_fail_stage;
        call wal_block_write_count;
        cmp rax, 1;
        jne walw_fail_stage;
        mov rdi, 1;
        call wal_flags_at;
        cmp rax, 3;                             // bit 0 + bit 1
        jne walw_fail_stage;

        // A second fsync with no new records returns 0 (nothing to do).
        call wal_fsync;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_fsync_high_water;
        cmp rax, 3;
        jne walw_fail_stage;

        // -- 8. Ring-full refusal after 64 appends.
        mov rax, 8;
        lea rcx, [rip + _walw_stage];
        mov [rcx], rax;

        call wal_reset;
        xor r12, r12;
      walw_fill:
        mov rdi, 8;                             // arbitrary size
        mov rsi, r12;                           // prev_seq (roughly)
        call wal_append;
        cmp rax, 0;
        je  walw_fail_stage;
        add r12, 1;
        cmp r12, 64;
        jb  walw_fill;

        call wal_head;
        cmp rax, 64;
        jne walw_fail_stage;

        // 65th append refuses with RING_FULL.
        mov rdi, 8;
        mov rsi, 64;
        call wal_append;
        cmp rax, 0;
        jne walw_fail_stage;
        call wal_err;
        mov r11, 0xFFFFEFCE;                    // WAL_ERR_RING_FULL
        cmp rax, r11;
        jne walw_fail_stage;
        call wal_head;
        cmp rax, 64;
        jne walw_fail_stage;

        // Return module to a clean state.
        call wal_reset;
        call wal_bound;
        cmp rax, 1;
        jne walw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + walw_ok];
        call klog_s1;

        xor rax, rax;
        jmp walw_out;

      walw_fail_stage:
        lea rax, [rip + _walw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + walw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      walw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
