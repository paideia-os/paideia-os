// tests/kernel/fs/pdxfs/upgrade_dryrun_synth.pdx -- R42.M4-002 (#1393)
//
// Boot witness for the PDXFS lite -> v1 upgrade dry-run + report
// module. Exercises reset (src + state cleared), report readback
// before walk: NOT_WALKED for all four fields, walk before seed:
// NO_SOURCE, walk with bad magic: BAD_MAGIC, walk with V1 magic:
// ALREADY_V1, happy walk with 16 lite blocks: verifies the report
// arithmetic per source §1 (blocks_before=16, blocks_after=21,
// free_delta = -5 (0xFFFFFFFFFFFFFFFB), duration = 144, walked=1,
// walk_count=1), and a re-seed invalidates the walk (walked -> 0,
// report readback refuses again).
//
// Fingerprint: R42 PDXFS UPGRADE DRYRUN OK
// Failure fingerprint: R42 PDXFS UPGRADE DRYRUN FAIL + stage number.

module UpgradeDryrunSynth = structure {

  pub let mut _dryw_stage : u64 = 0

  pub let dryw_ok   : [u8; 30] = "R42 PDXFS UPGRADE DRYRUN OK\n\0"
  pub let dryw_fail : [u8; 32] = "R42 PDXFS UPGRADE DRYRUN FAIL\n\0"

  pub let upgrade_dryrun_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M4-002 (#1393): boot witness for pdxfs upgrade_dryrun. Five-push callee-save discipline. Labels prefixed dryw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _dryw_stage];
        mov [rcx], rax;

        call dry_reset;
        call dry_bound;
        cmp rax, 1;
        jne dryw_fail_stage;
        call dry_err;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_src_magic;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_src_blocks;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_walk_count;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_is_walked;
        cmp rax, 0;
        jne dryw_fail_stage;

        // -- 2. Report readback before walk: NOT_WALKED on all four.
        mov rax, 2;
        lea rcx, [rip + _dryw_stage];
        mov [rcx], rax;

        call dry_blocks_before;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_err;
        mov r11, 0xFFFFEF3B;                    // DRY_ERR_NOT_WALKED
        cmp rax, r11;
        jne dryw_fail_stage;
        call dry_reset;

        call dry_blocks_after;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_err;
        mov r11, 0xFFFFEF3B;
        cmp rax, r11;
        jne dryw_fail_stage;
        call dry_reset;

        call dry_free_delta;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_err;
        mov r11, 0xFFFFEF3B;
        cmp rax, r11;
        jne dryw_fail_stage;
        call dry_reset;

        call dry_duration;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_err;
        mov r11, 0xFFFFEF3B;
        cmp rax, r11;
        jne dryw_fail_stage;
        call dry_reset;

        // -- 3. Walk before seed: NO_SOURCE.
        mov rax, 3;
        lea rcx, [rip + _dryw_stage];
        mov [rcx], rax;

        call dry_walk;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_err;
        mov r11, 0xFFFFEF3E;                    // DRY_ERR_NO_SOURCE
        cmp rax, r11;
        jne dryw_fail_stage;
        call dry_reset;

        // -- 4. Walk with bad magic: BAD_MAGIC.
        mov rax, 4;
        lea rcx, [rip + _dryw_stage];
        mov [rcx], rax;

        mov rdi, 0xDEADBEEF;
        mov rsi, 32;
        call dry_seed;
        cmp rax, 1;
        jne dryw_fail_stage;
        call dry_walk;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_err;
        mov r11, 0xFFFFEF3D;                    // DRY_ERR_BAD_MAGIC
        cmp rax, r11;
        jne dryw_fail_stage;
        call dry_reset;

        // -- 5. Walk with V1 magic: ALREADY_V1.
        mov rax, 5;
        lea rcx, [rip + _dryw_stage];
        mov [rcx], rax;

        mov rdi, 0x50444653563200;              // DRY_MAGIC_V1
        mov rsi, 8;
        call dry_seed;
        cmp rax, 1;
        jne dryw_fail_stage;
        call dry_walk;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_err;
        mov r11, 0xFFFFEF3C;                    // DRY_ERR_ALREADY_V1
        cmp rax, r11;
        jne dryw_fail_stage;
        call dry_reset;

        // -- 6. Happy walk: LITE magic + 16 blocks.
        //         blocks_after = 16 + 16/4 + 1 = 21.
        //         free_delta   = 16 - 21 = -5 = 0xFFFFFFFFFFFFFFFB.
        //         duration     = 16 * 8 + 16 = 144.
        mov rax, 6;
        lea rcx, [rip + _dryw_stage];
        mov [rcx], rax;

        mov rdi, 0x504446534C31;                // DRY_MAGIC_LITE
        mov rsi, 16;
        call dry_seed;
        cmp rax, 1;
        jne dryw_fail_stage;

        call dry_walk;
        cmp rax, 16;
        jne dryw_fail_stage;
        call dry_is_walked;
        cmp rax, 1;
        jne dryw_fail_stage;

        call dry_blocks_before;
        cmp rax, 16;
        jne dryw_fail_stage;
        call dry_blocks_after;
        cmp rax, 21;
        jne dryw_fail_stage;
        call dry_free_delta;
        mov r11, 0xFFFFFFFFFFFFFFFB;
        cmp rax, r11;
        jne dryw_fail_stage;
        call dry_duration;
        cmp rax, 144;
        jne dryw_fail_stage;
        call dry_walk_count;
        cmp rax, 1;
        jne dryw_fail_stage;
        call dry_err;
        cmp rax, 0;
        jne dryw_fail_stage;

        // -- 7. Re-seed clears the walk. Report readback refuses.
        mov rax, 7;
        lea rcx, [rip + _dryw_stage];
        mov [rcx], rax;

        mov rdi, 0x504446534C31;
        mov rsi, 4;
        call dry_seed;
        cmp rax, 1;
        jne dryw_fail_stage;

        call dry_is_walked;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_blocks_before;
        cmp rax, 0;
        jne dryw_fail_stage;
        call dry_err;
        mov r11, 0xFFFFEF3B;                    // DRY_ERR_NOT_WALKED
        cmp rax, r11;
        jne dryw_fail_stage;

        // Fresh walk on the smaller volume.
        call dry_reset;
        mov rdi, 0x504446534C31;
        mov rsi, 4;
        call dry_seed;
        call dry_walk;
        cmp rax, 4;
        jne dryw_fail_stage;
        // blocks_after = 4 + 4/4 + 1 = 6.
        call dry_blocks_after;
        cmp rax, 6;
        jne dryw_fail_stage;
        // free_delta = -2.
        call dry_free_delta;
        mov r11, 0xFFFFFFFFFFFFFFFE;
        cmp rax, r11;
        jne dryw_fail_stage;

        // Return module to a clean state.
        call dry_reset;
        call dry_bound;
        cmp rax, 1;
        jne dryw_fail_stage;
        call dry_err;
        cmp rax, 0;
        jne dryw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dryw_ok];
        call klog_s1;

        xor rax, rax;
        jmp dryw_out;

      dryw_fail_stage:
        lea rax, [rip + _dryw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dryw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      dryw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
