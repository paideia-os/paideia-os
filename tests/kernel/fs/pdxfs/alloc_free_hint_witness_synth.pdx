// tests/kernel/fs/pdxfs/alloc_free_hint_witness_synth.pdx -- R52.M3-005 (#1696)
//
// Boot witness for the PDXFS-on-block v1 bitmap block allocator
// (src/kernel/core/fs/pdxfs/allocator.pdx, #1692 + #1694): alloc 8
// blocks (asserting monotonically increasing bit indices), free 4 of
// them, and prove `alloc_hint` moves back down once
// `alloc_scan_on_mount` re-seeds it against the now-partially-freed
// bitmap.
//
// Design authority: design/filesystem/r52-implementation-plan.md §2.3
// step 5 (#1696: "Boot witness: allocate 8 blocks, free 4, verify
// alloc_hint moved and the LIFO stack has 4 entries").
//
// Fingerprint: "ALLOC WITNESS OK" (no round/milestone/issue prefix,
// per this issue's own instruction and design/policy/output-
// provenance-strip.md).
//
// -----------------------------------------------------------------------------
// SCOPE
// -----------------------------------------------------------------------------
//
// `alloc_block`/`free_block`/`alloc_scan_on_mount` all bottom out in a
// real `cap_invoke(bdev_cap, BDEV_OP_READ_LBA/WRITE_LBA)` (via
// `alloc_bm_ensure_loaded`/`alloc_bm_load_block` and
// `bdev_barrier_write`) -- there is no loopback/RAM-backed KIND_BLKDEV
// in this tree, and `tools/run-smoke.sh` never attaches a live NVMe or
// AHCI device (no MCFG under `-kernel` boot, so PCI enumeration itself
// is skipped), so a real BDEV_OP_READ_LBA/WRITE_LBA can never reach
// BDEV_ERR_OK under any smoke invocation that exists today -- exactly
// the gap tests/kernel/fs/pdxfs/mkfs_probe_witness_synth.pdx's own
// header already documents in detail for this same milestone's #1691.
//
// This witness therefore follows the SAME substrate-mode pattern
// tests/kernel/nvme/bdev_cross_family_soak_synth.pdx and
// tests/kernel/cap/bdev_cross_family_synth.pdx already establish for
// driving a REAL cap_invoke BDEV path without live hardware: mint a
// real KIND_NVME_CONTROLLER + dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV
// row, but never call `nvme_io_create_pair` on it (no live SQ pair
// reaches NVME_IOP_STATE_SQ_LIVE). `nvme_io_submit_rw`'s own step 2
// (`nvme_io_pick_pair`) then fails BEFORE touching any MMIO register
// and forwards `NVMEIO_PICK_NONE` (0xFFFFEC58) verbatim through
// `cap_invoke` -- and `BdevBarrier.bbjw_check` (the exact predicate
// `alloc_bm_ensure_loaded`/`alloc_bm_load_block`/`alloc_block`/
// `free_block` all call on every cap_invoke-forwarded status, per
// allocator.pdx's own header) explicitly treats `NVMEIO_PICK_NONE` as
// acceptable alongside `BDEV_ERR_OK`. This makes every real READ_LBA/
// WRITE_LBA the allocator issues succeed (from the allocator's own
// point of view) without ever touching real hardware -- the exact
// substrate-mode outcome allocator.pdx's header was written to
// tolerate.
//
// Because no real DMA transfer ever happens under NVMEIO_PICK_NONE,
// `_alloc_bm_buf` (allocator.pdx's own confined-writer resident bitmap
// block, `ec_confine_one`d to `core/fs/pdxfs/allocator.o` --
// tools/build.sh -- so this file cannot write it directly even if it
// wanted to) is never overwritten with any "disk" content by a
// READ_LBA -- it keeps whatever the allocator's OWN bit-set/bit-clear
// calls last left in it. Combined with `_alloc_bm_buf` being fresh
// `.bss` (zero-initialized, standard ELF loader guarantee) and this
// being the FIRST witness in the whole R52.M3 milestone to ever call
// `alloc_block`/`free_block`/`alloc_scan_on_mount`, the bitmap starts
// all-clear and every mutation this witness makes through the real
// allocator API is the only thing that ever touches it -- exactly the
// deterministic in-memory state machine this witness needs to prove
// "alloc 8, free 4, hint moves back" end to end through the REAL
// public API, not a hand-rolled duplicate.
//
// -----------------------------------------------------------------------------
// What this witness proves
// -----------------------------------------------------------------------------
//
// (1) `alloc_init(sb_ptr)` + `alloc_scan_on_mount(bdev_cap, sb_ptr)`
//     against a fresh (all-clear) one-block bitmap region seed
//     `alloc_hint` to 0 (`alloc_get_hint() == 0`).
// (2) `alloc_block(bdev_cap, 0)` called 8 times in a row -- with the
//     free stack empty every time, each call takes the linear-scan
//     path starting at hint 0, and since every prior call already set
//     the lowest still-clear bit, each successive call returns
//     `data_lba + i` for i = 0..7 in strict order (`data_lba` = 26 in
//     this fixture) -- asserted EXACTLY (26, 27, ..., 33), which both
//     proves and is strictly stronger than "monotonically increasing
//     bit indices" (a regression that skipped, repeated, or
//     reordered a bit index would fail one of these exact checks,
//     not just a loose `>` comparison).
// (3) Re-running `alloc_scan_on_mount` after all 8 blocks are
//     allocated finds bit 8 (the first still-clear bit) and seeds
//     `alloc_hint = 8` -- the "would keep advancing" baseline this
//     witness needs so the next step's "moved BACK" claim has
//     something concrete to move back FROM.
// (4) `free_block(bdev_cap, lba)` called 4 times against the FIRST 4
//     allocated lbas (26..29, i.e. bit indices 0..3) each returns 0,
//     and `alloc_free_stack_count()` reads back exactly 4 immediately
//     after (the LIFO hint stack this issue's own instruction names).
// (5) Re-running `alloc_scan_on_mount` a third time -- now against a
//     bitmap with bits 0..3 clear again and bits 4..7 still set --
//     finds bit 0 first and re-seeds `alloc_hint = 0`: the hint moved
//     BACK from 8 to 0, exactly this issue's headline assertion.
//
// -----------------------------------------------------------------------------
// Synthetic superblock fixture
// -----------------------------------------------------------------------------
//
// `_afhw_sb` is a private (not `_alloc_state`-confined) 4 KiB scratch
// buffer this file owns outright, zeroed then stamped with only the
// three fields `alloc_init` actually reads (superblock.pdx, #1682):
// `alloc_lba` (u64 @+56) = 11, `alloc_bcount` (u64 @+64) = 1 (a single
// resident bitmap block keeps every `alloc_scan_on_mount` walk a
// single-iteration loop), `data_lba` (u64 @+88) = 26. No other
// superblock field is read by `alloc_init`/`alloc_scan_on_mount`, so
// the rest of the buffer is left zero (magic/version/etc. are never
// validated by these two functions -- `sb_validate_all` is not called
// anywhere in this witness, matching mkfs_probe_witness_synth.pdx's
// own precedent of driving only the real functions a given call chain
// actually needs).
//
// -----------------------------------------------------------------------------
// Cap slots 172..175 (fresh-ish range; see tests/kernel/drivers/audio/
// route_table_synth.pdx / tests/kernel/cap/gpu_context_synth.pdx /
// tests/kernel/cap/fw_session_cap_synth.pdx for the overlapping claims
// this range is NOT disjoint from -- tolerated per this tree's own
// established practice: every witness clears its own range on entry
// AND on every exit path, and boot witnesses run strictly
// sequentially, so no two witnesses' cap rows are ever live at once)
// -----------------------------------------------------------------------------
//
//   172 = synthetic KIND_PCI_DEV parent for the NVMe controller
//   173 = KIND_NVME_CONTROLLER (row 0)
//   174 = KIND_NVME_NAMESPACE (row 0, dual-kind with slot 175)
//   175 = KIND_BLKDEV, family NVME (dual-kind with ns row 0) -- the
//         bdev_cap passed to every allocator call in this witness
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// One callee-save push (rbx = &_afhw_sb, the sb_ptr reused across
// every `alloc_init`/`alloc_scan_on_mount` call) leaves rsp%16 == 0
// (entry rsp%16 == 8 + 8 = 16) for every nested call this function
// makes directly, matching `alloc_init`'s own 1-push shape
// (allocator.pdx). `bdev_cap` (175) and every expected lba/index are
// compile-time-constant immediates -- no register needs to carry them
// across calls, so no further push is needed. The one `sub rsp, 32` /
// `add rsp, 32` bracket around `nvme_ns_dual_kind_mint`'s params_ptr
// staging is 16-byte-aligned, so rsp%16 stays 0 across it (matching
// tests/kernel/nvme/bdev_cross_family_soak_synth.pdx's identical
// bracket). Stage number lives in `_afhw_stage` (memory, not a
// register), matching tests/kernel/fs/pdxfs/superblock_witness_synth.
// pdx's own `_pdxbw_stage` idiom.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere in this file -- every field
// touched is a u64 (`mov`) or u32 (`mov_d`), so no `mov_b` is needed.
// No `test` instruction anywhere; every comparison uses `cmp` +
// `je`/`jne`/`jae`. Every label is prefixed `afhw_` (Alloc-Free-Hint
// Witness) per the reserved-label discipline (`alloc`/`free`
// themselves are reserved and never used bare as a label).
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately
// after `ahci_hot_remove_write_witness_call` (the most recent addition
// to that file at the time of this landing). Golden:
// tests/r17/shell-shutdown.golden ("ALLOC WITNESS OK" appended right
// after "HOT REMOVE WRITE EIO OK").

module AllocFreeHintWitnessSynth = structure {

  pub let mut _afhw_sb    : [u64; 512] = uninit @align(4096)
  pub let mut _afhw_stage : u64 = 0

  pub let afhw_ok   : [u8; 18] = "ALLOC WITNESS OK\n\0"
  pub let afhw_fail : [u8; 20] = "ALLOC WITNESS FAIL\n\0"

  // ==========================================================================
  // afhw_clear() -- scrub cap_table slots 172..175 inclusive.
  // ==========================================================================
  pub let afhw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M3-005 (#1696): clear cap_table slots 172..175 (this witness's whole fixed slot claim). Same shape as every other synth fixture's own _clear helper (e.g. tests/kernel/nvme/ahci_hot_remove_write_synth.pdx's hrw_clear). Labels prefixed afhw_cl_.",
      block: {
        push rbx;
        mov rbx, 172;
      afhw_cl_loop:
        cmp rbx, 176;
        jae afhw_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp afhw_cl_loop;
      afhw_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // alloc_free_hint_witness() -> u64
  //
  // See module header for the full stage-by-step scope note, the
  // substrate-mode NVMe-cap trick this witness relies on, and the
  // synthetic superblock fixture's field layout.
  // ==========================================================================
  pub let alloc_free_hint_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R52.M3-005 (#1696): allocator boot witness (alloc 8 + free 4 + hint moved). One callee-save push (rbx = &_afhw_sb) leaves rsp%16==0 for every nested call. Body per the module header's numbered scope note: (1) defensive reset (nvme_ctrl_table_reset, nvme_ns_table_reset, afhw_clear). (2)-(4) mint a real KIND_NVME_CONTROLLER (slot 173, row 0) + dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots 174/175, row 0) under a synthetic KIND_PCI_DEV parent (slot 172), never advancing to a live SQ pair -- READ_LBA/WRITE_LBA against slot 175 therefore always forward NVMEIO_PICK_NONE (0xFFFFEC58), which BdevBarrier.bbjw_check treats as acceptable. (5) zero + stamp _afhw_sb's three allocator-relevant fields (alloc_lba@+56=11, alloc_bcount@+64=1, data_lba@+88=26). (6)-(8) alloc_init(rbx) + alloc_scan_on_mount(175, rbx) + alloc_get_hint() == 0 (fresh all-clear bitmap). (9)-(16) alloc_block(175, 0) x8, asserted EXACTLY equal to 26..33 in order (data_lba + bit_index; each call's linear scan from hint 0 skips every already-set bit from a prior call, so this also proves strictly-monotonic bit indices, a strictly stronger check than a loose > comparison). (17)-(18) alloc_scan_on_mount(175, rbx) again + alloc_get_hint() == 8 (first clear bit after all 8 are set -- the 'before' baseline). (19)-(22) free_block(175, lba) x4 against the first 4 allocated lbas (26..29), each asserted == 0. (23) alloc_free_stack_count() == 4 (checked BEFORE the next alloc_scan_on_mount, whose internal alloc_init empties the stack). (24)-(25) alloc_scan_on_mount(175, rbx) a third time + alloc_get_hint() == 0 -- the hint moved back from 8 to 0, this issue's headline assertion. (26) all pass -> klog_s1(3, SUBSYS_BOOT, afhw_ok); cleanup (afhw_clear + nvme_ctrl_table_reset + nvme_ns_table_reset); return 0. Any stage divergence -> afhw_fail_stage, which logs the stage number via klog_s1_d1(k_line) exactly as tests/kernel/fs/pdxfs/superblock_witness_synth.pdx's own pdxbw_fail_stage does, then runs the same cleanup and returns 1. Labels prefixed afhw_.",
      block: {
        push rbx;

        // -----------------------------------------------------------
        // (1) Defensive reset.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call afhw_clear;

        // -----------------------------------------------------------
        // (2) Synthetic KIND_PCI_DEV parent (slot 172).
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        mov rdi, 172;
        mov rsi, 0x30;                    // KIND_PCI_DEV
        mov rdx, 0x21F;                   // R_DEV_ALL | RIGHT_MINT
        mov rcx, 0xFACEFEED;              // synthetic bdf
        call cap_mint_write;

        // -----------------------------------------------------------
        // (3) KIND_NVME_CONTROLLER (slot 173, row 0). Never advanced
        // to a live SQ pair -- substrate-mode posture.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        mov rdi, 172;                     // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                   // R_NVMEC_ALL
        xor rdx, rdx;                     // ctrl_idx = 0
        mov rcx, 0x400000;                // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                       // expect row 0
        jne afhw_fail_stage;

        mov rdi, 173;
        mov rsi, 0x198;                   // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                     // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) Dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots
        // 174/175, row 0).
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;                // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;                // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;               // block_count
        xor rax, rax;
        mov [rsp + 24], rax;               // parent_ctrl_row = 0
        mov rdi, 174;                      // ns_slot
        mov rsi, 175;                      // blk_slot
        mov rdx, 173;                      // parent_slot (KIND_NVME_CONTROLLER)
        mov rcx, 0x41F;                    // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                     // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                      // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                        // expect row 0
        jne afhw_fail_stage;

        // -----------------------------------------------------------
        // (5) Zero + stamp the synthetic superblock fixture.
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        lea rbx, [rip + _afhw_sb];
        xor rax, rax;
        xor rcx, rcx;
      afhw_zero_top:
        cmp rcx, 512;
        jae afhw_zero_done;
        mov [rbx + rcx * 8], rax;
        add rcx, 1;
        jmp afhw_zero_top;
      afhw_zero_done:

        mov rax, 11;
        mov [rbx + 56], rax;               // alloc_lba
        mov rax, 1;
        mov [rbx + 64], rax;               // alloc_bcount (one resident block)
        mov rax, 26;
        mov [rbx + 88], rax;               // data_lba

        // -----------------------------------------------------------
        // (6)-(8) alloc_init + alloc_scan_on_mount seed alloc_hint to
        // 0 against the fresh all-clear bitmap.
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call alloc_init;
        cmp rax, 0;
        jne afhw_fail_stage;

        mov rax, 7;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        mov rdi, 175;
        mov rsi, rbx;
        call alloc_scan_on_mount;
        cmp rax, 0;
        jne afhw_fail_stage;

        mov rax, 8;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        call alloc_get_hint;
        cmp rax, 0;
        jne afhw_fail_stage;

        // -----------------------------------------------------------
        // (9)-(16) alloc_block(175, 0) x8 -- exact lba 26..33.
        // -----------------------------------------------------------
        mov rax, 9;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        xor rsi, rsi;
        call alloc_block;
        cmp rax, 26;
        jne afhw_fail_stage;

        mov rax, 10;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        xor rsi, rsi;
        call alloc_block;
        cmp rax, 27;
        jne afhw_fail_stage;

        mov rax, 11;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        xor rsi, rsi;
        call alloc_block;
        cmp rax, 28;
        jne afhw_fail_stage;

        mov rax, 12;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        xor rsi, rsi;
        call alloc_block;
        cmp rax, 29;
        jne afhw_fail_stage;

        mov rax, 13;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        xor rsi, rsi;
        call alloc_block;
        cmp rax, 30;
        jne afhw_fail_stage;

        mov rax, 14;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        xor rsi, rsi;
        call alloc_block;
        cmp rax, 31;
        jne afhw_fail_stage;

        mov rax, 15;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        xor rsi, rsi;
        call alloc_block;
        cmp rax, 32;
        jne afhw_fail_stage;

        mov rax, 16;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        xor rsi, rsi;
        call alloc_block;
        cmp rax, 33;
        jne afhw_fail_stage;

        // -----------------------------------------------------------
        // (17)-(18) rescan -> alloc_hint == 8 (the "before" baseline).
        // -----------------------------------------------------------
        mov rax, 17;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        mov rdi, 175;
        mov rsi, rbx;
        call alloc_scan_on_mount;
        cmp rax, 0;
        jne afhw_fail_stage;

        mov rax, 18;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        call alloc_get_hint;
        cmp rax, 8;
        jne afhw_fail_stage;

        // -----------------------------------------------------------
        // (19)-(22) free_block(175, lba) x4 against lbas 26..29.
        // -----------------------------------------------------------
        mov rax, 19;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        mov rsi, 26;
        call free_block;
        cmp rax, 0;
        jne afhw_fail_stage;

        mov rax, 20;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        mov rsi, 27;
        call free_block;
        cmp rax, 0;
        jne afhw_fail_stage;

        mov rax, 21;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        mov rsi, 28;
        call free_block;
        cmp rax, 0;
        jne afhw_fail_stage;

        mov rax, 22;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;
        mov rdi, 175;
        mov rsi, 29;
        call free_block;
        cmp rax, 0;
        jne afhw_fail_stage;

        // -----------------------------------------------------------
        // (23) LIFO free stack holds exactly 4 entries.
        // -----------------------------------------------------------
        mov rax, 23;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        call alloc_free_stack_count;
        cmp rax, 4;
        jne afhw_fail_stage;

        // -----------------------------------------------------------
        // (24)-(25) rescan -> alloc_hint moves back from 8 to 0.
        // -----------------------------------------------------------
        mov rax, 24;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        mov rdi, 175;
        mov rsi, rbx;
        call alloc_scan_on_mount;
        cmp rax, 0;
        jne afhw_fail_stage;

        mov rax, 25;
        lea rcx, [rip + _afhw_stage];
        mov [rcx], rax;

        call alloc_get_hint;
        cmp rax, 0;
        jne afhw_fail_stage;

        // -----------------------------------------------------------
        // (26) All checks passed.
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + afhw_ok];
        call klog_s1;

        call afhw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp afhw_out;

      afhw_fail_stage:
        lea rax, [rip + _afhw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + afhw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call afhw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        mov rax, 1;

      afhw_out:
        pop rbx;
        ret
      }
    }
}
