// tests/kernel/fs/pdxfs/mkfs_probe_witness_synth.pdx -- R52.M2-006 (#1691)
//
// Boot witness: probe finds one PDXB volume + UUID fingerprint.
//
// Design authority: design/filesystem/r52-implementation-plan.md
// §2.2 step 6 (#1691). #1688 (userspace mkfs.pdxfs tool,
// src/kernel/core/fs/pdxfs/mkfs.pdx) landed while this issue was in
// progress -- this witness drives the REAL `mkfs_layout_compute` +
// `mkfs_sb_populate` primitives (not a hand-rolled duplicate fixture)
// to build the superblock it then validates and fingerprints.
//
// -----------------------------------------------------------------------------
// Scope actually landed vs. the task brief's literal wording
// -----------------------------------------------------------------------------
//
// The task brief asks this witness to "drive sb_write + sb_read
// round-trip" (equivalently, `mkfs_run`, which itself calls
// `mkfs_layout_compute` -> `mkfs_zero_region` x3 -> `mkfs_sb_populate`
// -> `sb_write`). That full chain is NOT driven here, and the gap is
// deliberate -- flagged rather than silently skipped:
//
//   `mkfs_zero_region` and `sb_write`/`sb_read` (superblock_write.pdx
//   #1687, superblock_read.pdx #1686) all bottom out in
//   `cap_invoke(bdev_cap, BDEV_OP_WRITE_LBA/READ_LBA)`, which
//   `cap_handler_blkdev.pdx` (R51.M3-003, #1647) dispatches to
//   `nvme_io_submit_rw` / `ahci_io_submit_rw` -- both of which require
//   a LIVE NVMe or AHCI queue pair to do anything beyond return a
//   documented BDEV_ERR_* code. `tools/run-smoke.sh` never attaches an
//   NVMe or AHCI device (grepped: no `-device nvme`, no AHCI drive, no
//   `--nvme`/`--ahci` flag exists in the script at all) and PCI
//   enumeration itself is skipped under `-kernel` boot (no MCFG --
//   see r30_platform.pdx's own PCI-enum-skip commentary). This matches
//   `tests/kernel/nvme/kind_nvme_io_queues_synth.pdx`'s own documented
//   SUBSTRATE/WIRE MODE split: wire-mode round trips (the only place a
//   real BDEV_OP_READ_LBA/WRITE_LBA succeeds) are gated on
//   `_nvme_device_count > 0`, which stays 0 under every currently
//   existing smoke invocation.
//
//   Calling `sb_write`/`sb_read`/`mkfs_run` here against an
//   out-of-range or never-minted cap slot would not "round-trip"
//   anything -- an empty slot (kind == 0) makes `cap_invoke_dispatch`
//   fall through every kind check to its MVP default, which returns
//   `target_ptr` (0 for an empty descriptor) as if it were
//   `BDEV_ERR_OK`, and `sb_write`/`mkfs_zero_region` would misreport
//   that as success. Synthesizing a real `KIND_BLKDEV` cap (the
//   `kind_nvme_io_queues_synth.pdx` approach) would still fail
//   deterministically at the synthetic-bar0 gate (`nvme_io_create_pair`'s
//   own documented refusal) -- proving nothing beyond what `sb_write`'s
//   own header already documents (`PDXB_SB_WRITE_BDEV_ERR` on any
//   non-OK `cap_invoke` return), while adding a cap_table-slot
//   coordination risk against the ~20+ other *_synth.pdx witnesses
//   that already claim overlapping ranges across [100, 256).
//
//   What this witness DOES prove is the DATA CONTRACT the whole M2
//   chain shares, using mkfs.pdxfs's REAL in-memory halves (the two
//   `mkfs.pdx` functions that touch no BDEV cap at all):
//   `mkfs_layout_compute` computes a region layout for a fresh
//   1000-block/4096-byte-block/inode_ratio-100/journal-hint-10
//   volume, `mkfs_sb_populate` stamps that layout plus a fresh
//   `sb_generate_uuid`-derived UUID into `_mkfs_sb_scratch` --
//   exactly the same superblock bytes `mkfs_run` would hand to
//   `sb_write` -- and this witness then validates that buffer via
//   `sb_validate_all` (superblock.pdx, #1682, the exact superset of
//   the four checks `sb_read` itself runs) and fingerprints its UUID
//   via `sb_uuid_lo`/`sb_uuid_hi`, the same two accessors a real probe
//   would call on whatever buffer `sb_read` handed back. A genuine
//   on-disk `mkfs_run` -> BDEV -> `sb_read` round trip is deferred to
//   a wire-mode smoke variant once R51 grows `--nvme`/`--ahci` QEMU
//   flags (`kind_nvme_io_queues_synth.pdx`'s own WIRE MODE is already
//   written for that day and is itself dormant under every smoke that
//   exists today).
//
// -----------------------------------------------------------------------------
// What this witness proves
// -----------------------------------------------------------------------------
//
// (1) `mkfs_layout_compute(1000, 4096, 100, 10)` returns 0 (a valid
//     region layout for a fresh volume -- "mkfs writes valid PDXB").
// (2) `mkfs_sb_populate(&_mkfs_sb_scratch, &_mkfs_layout_row)` stamps
//     that layout, plus a fresh UUID, into the scratch superblock.
// (3) `sb_validate_all(&_mkfs_sb_scratch)` returns 0 ("the reader
//     validates and returns a valid superblock").
// (4) `sb_uuid_lo`/`sb_uuid_hi` (superblock.pdx, #1682) fingerprint
//     the UUID `mkfs_sb_populate` just wrote, emitted as two detail
//     lines (klog_s1_x1, one hex KV each) sharing the tag "PDXB
//     VOLUME PROBE OK" -- no round/milestone/issue prefix, per the
//     task brief's "no R prefix" rule and
//     design/policy/output-provenance-strip.md. The UUID itself is
//     `sb_generate_uuid`-derived (two rdtsc samples, pdxfs_lite/
//     uuid.pdx, #914) and therefore not a fixed value across boots --
//     only the bare tag text is golden-checked, matching every other
//     hardware/clock-derived-value fingerprint in this codebase (e.g.
//     hpet.pdx's "HPET INIT OK", whose period_fs/freq_hz KVs are
//     likewise never golden-matched verbatim).
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// Five-push callee-save prologue (rbx, r12, r13, r14, r15), matching
// every other witness in this contiguous PdxFS cluster (#1685's
// superblock_witness, refcount_synth.pdx, kind_nvme_controller_synth.pdx).
// rbx = &_mkfs_sb_scratch across every nested call once populated.
// r12 = uuid_lo, r13 = uuid_hi (both read back via sb_uuid_lo/
// sb_uuid_hi) -- callee-save, so they survive the two klog_s1_x1
// calls that follow (klog_s1_x1/klog_emit_core preserve SysV
// callee-save per their own justifications). r14/r15 unused, kept
// pushed for pattern uniformity. 5 pushes from a SysV-entry
// rsp%16==8 land rsp%16==0, so every nested `call` below
// (mkfs_layout_compute, mkfs_sb_populate, sb_validate_all, sb_uuid_lo,
// sb_uuid_hi, klog_s1_x1 x2, klog_s1_d1) needs no extra `sub rsp, 8`
// -- all are zero-stack-arg calls, so no per-call-site padding
// arithmetic is needed either (contrast klog_s1_x2's stack-passed 7th
// arg, deliberately avoided here for exactly that reason).
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere in this file (every value this
// witness reads is a full u64 return from an existing accessor, or a
// small literal geometry argument). No `test` instruction anywhere;
// every comparison uses `cmp` + `je`/`jne`. Every label is prefixed
// `pdxbvw_` (PDXB Volume Witness) per the reserved-label discipline
// and per this task's own naming instruction.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately
// after `superblock_witness_call`, keeping this fixture inside the
// contiguous PdxFS witness cluster that file's header documents.
//
// -----------------------------------------------------------------------------
// Golden-file design-doc gap (flagged to main/softarch)
// -----------------------------------------------------------------------------
//
// design/filesystem/r52-implementation-plan.md §7 names a dedicated
// `tests/r52/mkfs-probe.golden` for this fingerprint. No R23+ round
// has ever actually landed a per-round golden file that way -- every
// witness in this cluster (including #1685's own M1-005 landing, whose
// header explicitly says "Golden: tests/r17/shell-shutdown.golden")
// instead appends its fingerprint line(s) to the single master golden
// `tools/run-smoke.sh`'s `boot_r17_shell_shutdown` mode strictly
// checks in order. This witness follows that actually-established
// convention: its bare OK tag text is appended to
// `tests/r17/shell-shutdown.golden` immediately after "PDXB SB
// WITNESS OK", not to a new `tests/r52/` file.

module MkfsProbeWitnessSynth = structure {

  pub let mut _pdxbvw_stage : u64 = 0

  pub let pdxbvw_tag_ok   : [u8; 21] = "PDXB VOLUME PROBE OK\0"
  pub let pdxbvw_tag_fail : [u8; 23] = "PDXB VOLUME PROBE FAIL\0"

  pub let pdxbvw_k_uuid_lo : [u8; 8] = "uuid_lo\0"
  pub let pdxbvw_k_uuid_hi : [u8; 8] = "uuid_hi\0"

  // ============================================================================
  // wit_mkfs_probe() -> u64
  //
  // Body:
  //   (0) 5-push prologue.
  //   (1) mkfs_layout_compute(total_blocks=1000, block_size=4096,
  //       inode_ratio=100, journal_size_hint=10) -- expect 0. This
  //       geometry gives itable_lba=1/itable_bcount=1, alloc_lba=2/
  //       alloc_bcount=1, journal_lba=3/journal_bcount=10, data_lba=13/
  //       data_bcount=987 -- comfortably passes sb_validate_regions
  //       (mkfs_layout_compute's own header guarantees this by
  //       construction).
  //   (2) mkfs_sb_populate(&_mkfs_sb_scratch, &_mkfs_layout_row) --
  //       always returns 0 (mkfs.pdx's own documented contract), no
  //       check needed, matching mkfs_run's own precedent.
  //   (3) rbx = &_mkfs_sb_scratch. sb_validate_all(rbx) -- expect 0
  //       (the "reader validates" half of the task brief).
  //   (4) sb_uuid_lo(rbx) -> r12; sb_uuid_hi(rbx) -> r13 (the
  //       "fingerprint the UUID from the loaded superblock" half).
  //   (5) Emit two OK detail lines via klog_s1_x1 (uuid_lo, uuid_hi).
  //       Fail branch emits FAIL + stage number via klog_s1_d1.
  // ============================================================================

  pub let wit_mkfs_probe : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R52.M2-006 (#1691): boot witness for the PDXB volume probe + UUID fingerprint. Drives the real mkfs.pdx (#1688) in-memory halves -- mkfs_layout_compute(1000,4096,100,10) then mkfs_sb_populate(&_mkfs_sb_scratch,&_mkfs_layout_row) -- to build a superblock exactly as mkfs_run would hand to sb_write, then validates it via sb_validate_all (#1682) expecting 0, reads the UUID back via sb_uuid_lo/sb_uuid_hi (#1682), and emits two klog_s1_x1 detail lines sharing the tag 'PDXB VOLUME PROBE OK' (uuid_lo=<hex>, uuid_hi=<hex>). Does not call mkfs_run/sb_write/sb_read directly -- see this file's header note on why a real on-disk round trip needs live NVMe/AHCI hardware this smoke does not attach. Five-push callee-save discipline (rbx = &_mkfs_sb_scratch once populated; r12/r13 hold the two UUID halves read back, callee-save so they survive the two klog_s1_x1 calls; r14/r15 unused/pushed for uniformity), matching every other witness in this PdxFS cluster. Encoder: mov / cmp / je / jne / lea / call -- all pre-existing. Labels prefixed pdxbvw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- Stage 1: mkfs_layout_compute(1000, 4096, 100, 10). --
        mov rax, 1;
        lea rcx, [rip + _pdxbvw_stage];
        mov [rcx], rax;

        mov rdi, 1000;                    // total_blocks
        mov rsi, 4096;                    // block_size
        mov rdx, 100;                     // inode_ratio
        mov rcx, 10;                      // journal_size_hint
        call mkfs_layout_compute;
        cmp rax, 0;
        jne pdxbvw_fail_stage;

        // -- Stage 2: mkfs_sb_populate(&_mkfs_sb_scratch, &_mkfs_layout_row). --
        mov rax, 2;
        lea rcx, [rip + _pdxbvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _mkfs_sb_scratch];
        lea rsi, [rip + _mkfs_layout_row];
        call mkfs_sb_populate;

        // -- Stage 3: reader validates the just-mkfs'd superblock. --
        mov rax, 3;
        lea rcx, [rip + _pdxbvw_stage];
        mov [rcx], rax;

        lea rbx, [rip + _mkfs_sb_scratch];
        mov rdi, rbx;
        call sb_validate_all;
        cmp rax, 0;
        jne pdxbvw_fail_stage;

        // -- Stage 4: fingerprint the UUID from the loaded superblock. --
        mov rax, 4;
        lea rcx, [rip + _pdxbvw_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call sb_uuid_lo;
        mov r12, rax;

        mov rdi, rbx;
        call sb_uuid_hi;
        mov r13, rax;

        // -- Stage 5: emit the two OK detail lines. --
        mov rax, 5;
        lea rcx, [rip + _pdxbvw_stage];
        mov [rcx], rax;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxbvw_tag_ok];
        lea rcx, [rip + pdxbvw_k_uuid_lo];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxbvw_tag_ok];
        lea rcx, [rip + pdxbvw_k_uuid_hi];
        mov r8, r13;
        call klog_s1_x1;

        xor rax, rax;
        jmp pdxbvw_out;

      pdxbvw_fail_stage:
        lea rax, [rip + _pdxbvw_stage];
        mov r8, [rax];
        mov rdi, 1;                              // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxbvw_tag_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pdxbvw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
