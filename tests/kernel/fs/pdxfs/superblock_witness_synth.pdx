// tests/kernel/fs/pdxfs/superblock_witness_synth.pdx -- R52.M1-005 (#1685)
//
// Boot witness for the PDXFS-on-block v1 superblock format + accessor
// module: proves a hard-coded, well-formed 4096-byte PDXB superblock
// parses cleanly through `sb_validate_all` (superblock.pdx, #1682),
// and that each of the five most-common corruption shapes is caught
// with the exact M1 failure-taxonomy code `superblock_fmt.pdx`
// (#1681) froze for it.
//
// Fingerprint: PDXB SB WITNESS OK
// Failure fingerprint: PDXB SB WITNESS FAIL + stage number.
//
// -----------------------------------------------------------------------------
// What this witness proves
// -----------------------------------------------------------------------------
//
// (1) A hand-stamped valid superblock -- magic "PDXB", version 1,
//     block_size 4096, four disjoint in-order regions starting at
//     LBA 1, root_inode == 1, all-zero `_reserved` -- passes
//     `sb_validate_all` with rax == 0.
// (2) Corrupting `magic` alone yields exactly PDXB_SB_MAGIC_BAD
//     (0xFFFFED00).
// (3) Corrupting `version` alone yields exactly PDXB_SB_VERSION_BAD
//     (0xFFFFED01).
// (4) Corrupting `block_size` alone yields exactly
//     PDXB_SB_BLOCK_SIZE_BAD (0xFFFFED02).
// (5) Breaking region layout (itable_lba == 0, violating the "regions
//     start at/after LBA 1" invariant) yields exactly
//     PDXB_SB_REGION_OVERLAP (0xFFFFED05).
// (6) Corrupting `root_inode` alone yields exactly
//     PDXB_SB_ROOT_INODE_INVALID (0xFFFFED06).
// (7) After every corruption is individually restored, the superblock
//     re-validates clean (rax == 0) -- proving the fixture itself, not
//     just the validators, is sound.
//
// Each corruption is applied and restored in isolation (one field at
// a time) so `sb_validate_all`'s first-failure-wins ordering (magic,
// version, block_size, reserved, total_blocks, regions, root_inode,
// sig_scope -- superblock.pdx's documented band order) reports the
// code under test rather than an earlier one.
//
// -----------------------------------------------------------------------------
// Design-doc naming gap (flagged to main/softarch)
// -----------------------------------------------------------------------------
//
// The R52.M1 task text (design/filesystem/volume-fs-substrate.md
// §7.1 "R52.M1-005") names the expected sentinels informally as
// PDXB_SB_REGIONS_BAD and PDXB_SB_ROOT_INODE_BAD. The constants
// actually frozen by superblock_fmt.pdx (#1681) and wired by
// superblock.pdx (#1682) are PDXB_SB_REGION_OVERLAP (0xFFFFED05) and
// PDXB_SB_ROOT_INODE_INVALID (0xFFFFED06) respectively -- no
// REGIONS_BAD / ROOT_INODE_BAD symbols exist. This witness asserts
// against the real, landed constants; softarch should reconcile the
// design doc's prose to match at the next pass.
//
// -----------------------------------------------------------------------------
// Fixture storage
// -----------------------------------------------------------------------------
//
//   _pdxbw_sb : [u64; 512] = 4096 bytes @align(4096) -- matches the
//   `[u64; 512]` backing-storage idiom superblock_fmt.pdx documents
//   (also used by tests/kernel/fs/pdxfs_lite_corrupt_sb.pdx's
//   `_pdxl_csb_fake_sb`).
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// Five-push callee-save prologue (rbx, r12, r13, r14, r15), matching
// the uniform shape this kernel uses for a witness that holds one
// persistent base pointer across many nested calls (see
// tests/kernel/fs/pdxfs/refcount_synth.pdx, tests/kernel/nvme/
// kind_nvme_controller_synth.pdx). rbx = &_pdxbw_sb across every
// `sb_validate_all` call; r12-r15 unused but kept pushed for pattern
// uniformity. 5 pushes from SysV-entry rsp%16==8 land rsp%16==0,
// aligning every nested `call` with no extra `sub rsp, 8`.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// All field reads/writes in this fixture are u32 (`mov_d`) or u64
// (`mov`) at fixed literal offsets -- no byte-granularity access, so
// no `mov_b` is needed. No `test` instruction anywhere; every
// comparison uses `cmp` + `je`/`jne`. Every label is prefixed
// `pdxbw_` (PDXB Witness) per the reserved-label discipline.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately
// after `pdxfs_dir_iter_witness_call`, keeping this fixture inside
// the contiguous PdxFS witness cluster that file's own header
// documents ("keeps the PdxFS witness cluster contiguous on the wire
// so a boot log grep for 'PDXFS' hits every stage in order").
// Golden: tests/r17/shell-shutdown.golden.

module SuperblockWitnessSynth = structure {

  pub let mut _pdxbw_sb    : [u64; 512] = uninit @align(4096)
  pub let mut _pdxbw_stage : u64 = 0

  pub let pdxbw_ok   : [u8; 20] = "PDXB SB WITNESS OK\0"
  pub let pdxbw_fail : [u8; 22] = "PDXB SB WITNESS FAIL\0"

  // ============================================================================
  // superblock_witness() -> u64
  //
  // Body:
  //   (0) 5-push prologue; rbx = &_pdxbw_sb.
  //   (1) Zero all 512 qwords (4096 bytes).
  //   (2) Stamp a valid PDXB superblock:
  //         magic=0x42584450 version=1 block_size=4096 flags=1
  //         total_blocks=1000 itable_lba=1 itable_bcount=10
  //         alloc_lba=11 alloc_bcount=5 journal_lba=16
  //         journal_bcount=10 data_lba=26 data_bcount=970
  //         root_inode=1 mount_gen=1
  //       (uuid, sig_key_hash, _reserved, sig, snap_head stay zero
  //       from step 1 -- `_reserved` must be all-zero to validate.)
  //   (3) sb_validate_all(rbx) -- expect 0.
  //   (4) Corrupt+validate+restore magic -> PDXB_SB_MAGIC_BAD.
  //   (5) Corrupt+validate+restore version -> PDXB_SB_VERSION_BAD.
  //   (6) Corrupt+validate+restore block_size -> PDXB_SB_BLOCK_SIZE_BAD.
  //   (7) Corrupt+validate+restore itable_lba=0 -> PDXB_SB_REGION_OVERLAP.
  //   (8) Corrupt+validate+restore root_inode -> PDXB_SB_ROOT_INODE_INVALID.
  //   (9) Re-validate the fully-restored sb -- expect 0.
  //   (10) Emit OK; fail branch emits FAIL + stage number.
  // ============================================================================

  pub let superblock_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R52.M1-005 (#1685): boot witness for the PDXB superblock format freeze (superblock_fmt.pdx, #1681) and its accessor/validator module (superblock.pdx, #1682). Five-push callee-save discipline (rbx persistent, r12-r15 unused/pushed for uniformity), matching tests/kernel/fs/pdxfs/refcount_synth.pdx and tests/kernel/nvme/kind_nvme_controller_synth.pdx. Stamps one valid 4 KiB PDXB superblock into a zeroed [u64;512]@align(4096) fixture, validates it, then corrupts/validates/restores magic, version, block_size, itable_lba (region-layout break), and root_inode in isolation -- each expected to yield exactly the M1 failure-taxonomy code superblock_fmt.pdx froze for it (PDXB_SB_MAGIC_BAD/VERSION_BAD/BLOCK_SIZE_BAD/REGION_OVERLAP/ROOT_INODE_INVALID), then re-validates clean. Labels prefixed pdxbw_. Encoder: mov / mov_d / cmp / je / jne / lea / call -- all pre-existing.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        lea rbx, [rip + _pdxbw_sb];

        // -- Stage 1: zero the 4 KiB fixture (512 qwords). --
        mov rax, 1;
        lea rcx, [rip + _pdxbw_stage];
        mov [rcx], rax;

        xor rax, rax;
        xor rcx, rcx;
      pdxbw_zero_top:
        cmp rcx, 512;
        jae pdxbw_zero_done;
        mov [rbx + rcx * 8], rax;
        add rcx, 1;
        jmp pdxbw_zero_top;
      pdxbw_zero_done:

        // -- Stamp a valid PDXB superblock. --
        // magic (u32 @+0) = 0x42584450 ("PDXB")
        mov rax, 0x42584450;
        mov_d [rbx + 0], rax;

        // version (u32 @+4) = 1
        mov rax, 1;
        mov_d [rbx + 4], rax;

        // uuid (@+8, 16 bytes) left zero.

        // block_size (u32 @+24) = 4096
        mov rax, 4096;
        mov_d [rbx + 24], rax;

        // flags (u32 @+28) = 1 (clean-unmount bit)
        mov rax, 1;
        mov_d [rbx + 28], rax;

        // total_blocks (u64 @+32) = 1000
        mov rax, 1000;
        mov [rbx + 32], rax;

        // itable_lba (u64 @+40) = 1
        mov rax, 1;
        mov [rbx + 40], rax;

        // itable_bcount (u64 @+48) = 10
        mov rax, 10;
        mov [rbx + 48], rax;

        // alloc_lba (u64 @+56) = 11 (== itable_end)
        mov rax, 11;
        mov [rbx + 56], rax;

        // alloc_bcount (u64 @+64) = 5
        mov rax, 5;
        mov [rbx + 64], rax;

        // journal_lba (u64 @+72) = 16 (== alloc_end)
        mov rax, 16;
        mov [rbx + 72], rax;

        // journal_bcount (u64 @+80) = 10
        mov rax, 10;
        mov [rbx + 80], rax;

        // data_lba (u64 @+88) = 26 (== journal_end)
        mov rax, 26;
        mov [rbx + 88], rax;

        // data_bcount (u64 @+96) = 970 (data_end 996 <= total_blocks 1000)
        mov rax, 970;
        mov [rbx + 96], rax;

        // root_inode (u64 @+104) = 1
        mov rax, 1;
        mov [rbx + 104], rax;

        // mount_gen (u64 @+112) = 1
        mov rax, 1;
        mov [rbx + 112], rax;

        // snap_head (@+120), sig_key_hash (@+128, 32B), _reserved
        // (@+160, 536B), sig (@+696, 3400B) all left zero.

        // -- Stage 2: valid superblock validates clean. --
        mov rax, 2;
        lea rcx, [rip + _pdxbw_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call sb_validate_all;
        cmp rax, 0;
        jne pdxbw_fail_stage;

        // -- Stage 3: corrupt magic -> PDXB_SB_MAGIC_BAD (0xFFFFED00). --
        mov rax, 3;
        lea rcx, [rip + _pdxbw_stage];
        mov [rcx], rax;

        mov rax, 0xDEADBEEF;
        mov_d [rbx + 0], rax;
        mov rdi, rbx;
        call sb_validate_all;
        mov r10, 0xFFFFED00;
        cmp rax, r10;
        jne pdxbw_fail_stage;
        mov rax, 0x42584450;
        mov_d [rbx + 0], rax;

        // -- Stage 4: corrupt version -> PDXB_SB_VERSION_BAD (0xFFFFED01). --
        mov rax, 4;
        lea rcx, [rip + _pdxbw_stage];
        mov [rcx], rax;

        mov rax, 2;
        mov_d [rbx + 4], rax;
        mov rdi, rbx;
        call sb_validate_all;
        mov r10, 0xFFFFED01;
        cmp rax, r10;
        jne pdxbw_fail_stage;
        mov rax, 1;
        mov_d [rbx + 4], rax;

        // -- Stage 5: corrupt block_size -> PDXB_SB_BLOCK_SIZE_BAD (0xFFFFED02). --
        mov rax, 5;
        lea rcx, [rip + _pdxbw_stage];
        mov [rcx], rax;

        mov rax, 512;
        mov_d [rbx + 24], rax;
        mov rdi, rbx;
        call sb_validate_all;
        mov r10, 0xFFFFED02;
        cmp rax, r10;
        jne pdxbw_fail_stage;
        mov rax, 4096;
        mov_d [rbx + 24], rax;

        // -- Stage 6: break region layout (itable_lba=0) ->
        //    PDXB_SB_REGION_OVERLAP (0xFFFFED05). --
        mov rax, 6;
        lea rcx, [rip + _pdxbw_stage];
        mov [rcx], rax;

        xor rax, rax;
        mov [rbx + 40], rax;
        mov rdi, rbx;
        call sb_validate_all;
        mov r10, 0xFFFFED05;
        cmp rax, r10;
        jne pdxbw_fail_stage;
        mov rax, 1;
        mov [rbx + 40], rax;

        // -- Stage 7: corrupt root_inode -> PDXB_SB_ROOT_INODE_INVALID
        //    (0xFFFFED06). --
        mov rax, 7;
        lea rcx, [rip + _pdxbw_stage];
        mov [rcx], rax;

        mov rax, 2;
        mov [rbx + 104], rax;
        mov rdi, rbx;
        call sb_validate_all;
        mov r10, 0xFFFFED06;
        cmp rax, r10;
        jne pdxbw_fail_stage;
        mov rax, 1;
        mov [rbx + 104], rax;

        // -- Stage 8: fully-restored sb re-validates clean. --
        mov rax, 8;
        lea rcx, [rip + _pdxbw_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call sb_validate_all;
        cmp rax, 0;
        jne pdxbw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxbw_ok];
        call klog_s1;

        xor rax, rax;
        jmp pdxbw_out;

      pdxbw_fail_stage:
        lea rax, [rip + _pdxbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pdxbw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
