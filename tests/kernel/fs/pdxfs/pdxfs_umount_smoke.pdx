// tests/kernel/fs/pdxfs/pdxfs_umount_smoke.pdx -- R52.M8-004 (#1724)
//
// Boot witness for the PDXFS-on-block v1 CLEAN UMOUNT path
// (src/kernel/core/fs/pdxfs/umount_block.pdx, this issue). CLOSES the
// umount half of R52.M8.
//
// Design authority: design/filesystem/r52-implementation-plan.md §2.8
// step 4 (#1724: "Unmount cleanly: checkpoint advance + clean-unmount
// flag") and design/filesystem/volume-fs-substrate.md §5.3 + §4.3
// step 10.
//
// Fingerprint: "PDXFS UMOUNT SUBSTRATE OK" (no round/milestone/issue
// prefix, per this codebase's established witness-fingerprint
// convention -- see e.g. mount_replay_witness_synth.pdx / block_cache_
// synth.pdx headers). Emitted in substrate mode; the CLEAN arm
// ("PDXFS UMOUNT CLEAN OK") is reserved for once every umount step
// (block_cache_flush_all + journal_writer_set_checkpoint + sb_read +
// sb_write + jnl_bdev_flush) can run end to end against a live bdev
// without NVMEIO_PICK_NONE refusal, mirroring the SUBSTRATE / CACHE_
// LIVE split block_cache_synth.pdx's own file header documents at
// length.
//
// -----------------------------------------------------------------------------
// Why substrate mode is the only reachable arm today
// -----------------------------------------------------------------------------
//
// Every boot mode the smoke matrix drives runs against NVMEIO_PICK_
// NONE bdevs (see mount_replay_witness_synth.pdx's own header for
// the identical substrate posture and the reasoning). Two of the five
// steps umount_pdxfs_block calls -- `sb_read` (superblock_read.pdx
// #1686) and `sb_write` (superblock_write.pdx #1687) -- compare
// `cap_invoke`'s raw result directly against 0, so both fail with
// PDXB_SB_READ_BDEV_ERR (0xFFFFED08) / PDXB_SB_WRITE_BDEV_ERR
// (0xFFFFED09) under the NVMEIO_PICK_NONE trick every M5/M6/M7
// witness relies on. Calling `umount_pdxfs_block` with a synthetically
// primed `_mount_table` row would therefore always short-circuit at
// step (6) (sb_read) with 0xFFFFED08 -- proving nothing about steps
// (7)-(11) that come after.
//
// This witness therefore does NOT attempt the full end-to-end flow.
// It instead witnesses the umount function's own defensive discipline
// (steps 1-3, which are pure control flow independent of any bdev
// I/O) and each of the individual umount building blocks in
// isolation, exactly as mount_replay_witness_synth.pdx witnesses the
// mount building blocks in isolation for the same substrate reason.
// The CLEAN arm's extension point is where end-to-end coverage lands
// once R51.M8 removes the NVMEIO_PICK_NONE substrate posture -- same
// SUBSTRATE / CACHE_LIVE bifurcation block_cache_synth.pdx already
// established as the pattern for this milestone arc.
//
// -----------------------------------------------------------------------------
// What this witness proves
// -----------------------------------------------------------------------------
//
// (1) `umount_pdxfs_block(8)` returns 0xFFFF (MOUNT_IDX_NONE) --
//     the mount_slot >= MOUNT_MAX bound check fires as designed
//     (umount_block.pdx §Failure taxonomy).
// (2) A fresh `_mount_table[MOUNT_ROOT_SLOT]` (zero, since no boot
//     witness before this one has stamped it in the substrate) makes
//     `umount_pdxfs_block(MOUNT_ROOT_SLOT)` return 0xFFFFED27
//     (MOUNT_BACKEND_UNKNOWN, reused from mount_block.pdx) -- the
//     backend_type != 5 refusal fires, proving umount does NOT
//     misclassify a MOUNT_BACKEND_NONE slot as a valid PDXFS-block
//     mount.
// (3) A synthetically primed `_mount_table[MOUNT_ROOT_SLOT]` naming a
//     dead KIND_VOLUME row (vol_slot 15, which no prior witness has
//     minted a live row for) makes `umount_pdxfs_block(MOUNT_ROOT_
//     SLOT)` return 0xFFFFED27 -- the volume_row_device_slot ==
//     VOL_DECODE_BAD refusal fires, proving umount does NOT
//     dereference a dead volume row.
// (4) `block_cache_flush_all()` returns 0 -- no dirty slots to flush
//     in substrate (the cache is empty because no cow_write has been
//     wired through it yet, see block_cache_synth.pdx's own header).
// (5) `journal_writer_set_checkpoint(0, 4242)` + `journal_checkpoint_
//     lba(0)` round-trips exactly 4242, then a second setter call
//     with 4243 followed by a re-read returns exactly 4243 -- the
//     checkpoint-advance primitive umount step (5) relies on
//     genuinely advances (4243 > 4242, and both differ from the
//     unset-sentinel 0), matching mount_replay_witness_synth.pdx's
//     own stage-19/20 precedent for the identical primitive.
// (6) A synthetic 4-KiB superblock fixture (privately owned by this
//     witness, same posture as mount_replay_witness_synth.pdx's
//     `_mrw_sb`) with flags @+28 = 0x2 (ROOT_VOLUME set,
//     CLEAN_UNMOUNT clear) toggles to 0x3 after the exact
//     read-modify-write `umount_pdxfs_block` step (7) performs
//     (mov_d rax,[sb+28]; or rax,1; mov_d [sb+28],rax), and
//     `sb_flags` reads back 0x3 -- proving the CLEAN_UNMOUNT flag
//     stamp is well-formed byte-exact against the real superblock
//     accessor (matches mkfs.pdx's documented post-mkfs constant
//     PDXB_SB_FLAG_CLEAN_UNMOUNT|PDXB_SB_FLAG_ROOT_VOLUME = 0x3).
// (7) `_mount_table[MOUNT_ROOT_SLOT]` reads back exactly 0 after the
//     witness's own defensive clear -- proving step (10)'s row-clear
//     semantics (a single qword store of 0 at the row's offset)
//     matches the shape mount_pdxfs_block's own Phase-3 scan looks
//     for (backend_type == 0 means slot is free).
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// One callee-save push (rbx = &_pus_sb, set at stage 6 and reused for
// every superblock touch afterward) leaves rsp%16 == 0 (entry rsp%16
// == 8 + 8 == 16) for every nested call this function makes,
// mirroring mount_replay_witness_synth.pdx's own `mount_replay_
// witness` shape. The one call-target that stashes `_pus_stage`
// (memory, not a register) matches that file's `_mrw_stage` idiom.
// No comparison in this file targets a value with bit 31/63 set that
// is COMPARED against rax -- every expected value is a small positive
// literal (0, 2, 3, 4242, 4243) OR is a sentinel merely ASSIGNED to
// rax after a stage failure -- so no G4 register-staging is needed
// for any `cmp`. The two-stage sentinel comparisons that DO touch
// bit-31/63 sentinels (umount's own 0xFFFF slot-bad, 0xFFFFED27
// backend-bad returns) each stage the expected value through r10
// before the `cmp rax, r10` -- same idiom mount_replay_witness_synth.
// pdx uses at its own umb_ambiguous test.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// One byte-granularity access -- the SB flags field @+28, accessed
// via `mov_d` on both load and store (matching mount_replay_witness_
// synth.pdx's own precedent). No `test` instruction anywhere; every
// comparison uses `cmp` + `je`/`jne`/`jae`. Every label is prefixed
// `pus_` (Pdxfs Umount Smoke). Grep audit against src/kernel/ and
// tests/kernel/ at authoring time: no `pus_` hits anywhere else, no
// `_pus_` hits anywhere else -- both label prefix and BSS symbols
// are this file's alone.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately
// after `block_cache_witness_call` (the most recent PdxFS-block-
// cluster addition to that file at the time of this landing). Golden
// line "PDXFS UMOUNT SUBSTRATE OK" appended right after "BLOCK CACHE
// SUBSTRATE OK" in tests/r17/shell-shutdown.golden, matching every
// prior PdxFS witness's own golden-placement precedent.

module PdxfsUmountSmoke = structure {

  pub let mut _pus_sb    : [u64; 512] = uninit @align(4096)
  pub let mut _pus_stage : u64 = 0

  pub let pus_ok   : [u8; 26] = "PDXFS UMOUNT SUBSTRATE OK\0"
  pub let pus_fail : [u8; 28] = "PDXFS UMOUNT SUBSTRATE FAIL\0"

  // ==========================================================================
  // pdxfs_umount_smoke_witness() -> u64
  //
  // See module header for the full stage-by-step scope note and the
  // reasoning for the substrate-only arm.
  // ==========================================================================
  pub let pdxfs_umount_smoke_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R52.M8-004 (#1724): clean-umount boot witness (substrate arm). One callee-save push (rbx = &_pus_sb, set at stage 6 and reused for every superblock touch afterward) leaves rsp%16 == 0 (entry rsp%16 == 8 + 8 == 16) for every nested call, mirroring mount_replay_witness_synth.pdx's own mount_replay_witness shape. Body per the module header's numbered scope note: (1) defensive: pre-scrub _mount_table[0] to 0 (a prior witness in this file's sequential-execution position may not touch it, but a subsequent slot-based check depends on the known-empty precondition); umount_pdxfs_block(8) == 0xFFFF (mount_slot >= MOUNT_MAX bound). (2) umount_pdxfs_block(0) == 0xFFFFED27 (backend_type == 0 refusal on the pre-scrubbed row). (3) synthesize a dead-volume-row mount entry into _mount_table[0]: backend_type=5 at bits [32,40), vol_slot=15 at bits [48,64), mp_idx/root_idx=0xFFFF for consistency with mount_pdxfs_block's own packing; umount_pdxfs_block(0) == 0xFFFFED27 (volume_row_device_slot returns VOL_DECODE_BAD for the never-registered row 15); re-scrub _mount_table[0] to 0. (4) block_cache_flush_all() == 0 (empty cache in substrate). (5) journal_writer_set_checkpoint(0, 4242) then journal_checkpoint_lba(0) == 4242; journal_writer_set_checkpoint(0, 4243) then journal_checkpoint_lba(0) == 4243 (advance proven -- both differ from the 0 unset-sentinel and 4243 > 4242). (6) zero + stamp _pus_sb: flags @+28 = 0x2 (ROOT_VOLUME set, CLEAN_UNMOUNT clear) via mov_d; sb_flags(rbx) == 2 (dirty precondition). (7) read-modify-write the umount step-(7) sequence exactly: mov_d rax,[rbx+28]; or rax,1; mov_d [rbx+28],rax; sb_flags(rbx) == 3 (both flags set -- matches mkfs.pdx's documented post-mkfs constant). (8) verify _mount_table[MOUNT_ROOT_SLOT] == 0 after the stage-3 re-scrub -- the row-clear shape mount_pdxfs_block's Phase-3 scan looks for. All pass -> klog_s1(3, SUBSYS_BOOT, pus_ok); reset checkpoint state (journal_writer_set_checkpoint(0, 0) to leave a clean baseline for any downstream witness that might touch vol_slot 0); return 0. Any stage divergence -> pus_fail_stage which logs the stage number via klog_s1_d1(k_line), matching mount_replay_witness_synth.pdx's own itw_fail_stage-style failure path one-for-one, and returns 1. Labels prefixed pus_.",
      block: {
        push rbx;

        // -----------------------------------------------------------
        // (1) Slot-bound refusal.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _pus_stage];
        mov [rcx], rax;

        // Pre-scrub _mount_table[0] to a known-empty precondition.
        lea r10, [rip + _mount_table];
        xor rax, rax;
        mov [r10 + 0], rax;

        mov rdi, 8;                        // mount_slot beyond MOUNT_MAX
        call umount_pdxfs_block;
        mov r10, 0xFFFF;
        cmp rax, r10;
        jne pus_fail_stage;

        // -----------------------------------------------------------
        // (2) Backend-type refusal on empty slot.
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _pus_stage];
        mov [rcx], rax;

        mov rdi, 0;                        // MOUNT_ROOT_SLOT
        call umount_pdxfs_block;
        mov r10, 0xFFFFED27;
        cmp rax, r10;
        jne pus_fail_stage;

        // -----------------------------------------------------------
        // (3) Dead-volume-row refusal: prime _mount_table[0] with a
        // synthetic PDXFS_BLOCK entry pointing at vol_slot 15 (never
        // registered by any prior witness -- volume_row_device_slot
        // returns VOL_DECODE_BAD for it).
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _pus_stage];
        mov [rcx], rax;

        mov rax, 0xFFFF;                   // mp_idx = VNODE_IDX_NONE
        mov rcx, 0xFFFF;
        shl rcx, 16;                       // root_idx = VNODE_IDX_NONE
        or  rax, rcx;
        mov rcx, 5;                        // MOUNT_BACKEND_PDXFS_BLOCK
        shl rcx, 32;
        or  rax, rcx;
        mov rcx, 3;                        // VALID | ROOT
        shl rcx, 40;
        or  rax, rcx;
        mov rcx, 15;                       // vol_slot (dead row)
        shl rcx, 48;
        or  rax, rcx;
        lea r10, [rip + _mount_table];
        mov [r10 + 0], rax;

        mov rdi, 0;
        call umount_pdxfs_block;
        mov r10, 0xFFFFED27;
        cmp rax, r10;
        jne pus_fail_stage;

        // Re-scrub for stage (8).
        lea r10, [rip + _mount_table];
        xor rax, rax;
        mov [r10 + 0], rax;

        // -----------------------------------------------------------
        // (4) block_cache_flush_all() == 0 (empty cache in substrate).
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _pus_stage];
        mov [rcx], rax;

        call block_cache_flush_all;
        cmp rax, 0;
        jne pus_fail_stage;

        // -----------------------------------------------------------
        // (5) Checkpoint-advance round-trip: 4242, then 4243.
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _pus_stage];
        mov [rcx], rax;

        mov rdi, 0;                        // vol_slot
        mov rsi, 4242;
        call journal_writer_set_checkpoint;

        mov rdi, 0;
        call journal_checkpoint_lba;
        cmp rax, 4242;
        jne pus_fail_stage;

        mov rdi, 0;
        mov rsi, 4243;
        call journal_writer_set_checkpoint;

        mov rdi, 0;
        call journal_checkpoint_lba;
        cmp rax, 4243;
        jne pus_fail_stage;

        // -----------------------------------------------------------
        // (6) Zero + stamp _pus_sb; sb_flags(rbx) == 2.
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _pus_stage];
        mov [rcx], rax;

        lea rbx, [rip + _pus_sb];
        xor rax, rax;
        xor rcx, rcx;
      pus_sbzero_top:
        cmp rcx, 512;
        jae pus_sbzero_done;
        mov [rbx + rcx * 8], rax;
        add rcx, 1;
        jmp pus_sbzero_top;
      pus_sbzero_done:

        mov rax, 2;
        mov_d [rbx + 28], rax;             // flags: ROOT_VOLUME set, CLEAN clear

        mov rdi, rbx;
        call sb_flags;
        cmp rax, 2;
        jne pus_fail_stage;

        // -----------------------------------------------------------
        // (7) Umount step-(7) read-modify-write; sb_flags(rbx) == 3.
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _pus_stage];
        mov [rcx], rax;

        mov_d rax, [rbx + 28];
        or rax, 1;                         // PDXB_SB_FLAG_CLEAN_UNMOUNT
        mov_d [rbx + 28], rax;

        mov rdi, rbx;
        call sb_flags;
        cmp rax, 3;
        jne pus_fail_stage;

        // -----------------------------------------------------------
        // (8) _mount_table[MOUNT_ROOT_SLOT] == 0 after the stage-3
        // re-scrub -- the row-clear shape mount_pdxfs_block's Phase-3
        // scan looks for.
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _pus_stage];
        mov [rcx], rax;

        lea r10, [rip + _mount_table];
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne pus_fail_stage;

        // -----------------------------------------------------------
        // All checks passed.
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pus_ok];
        call klog_s1;

        // Reset checkpoint state for any downstream witness that may
        // touch vol_slot 0 (leave a clean baseline).
        mov rdi, 0;
        xor rsi, rsi;
        call journal_writer_set_checkpoint;

        xor rax, rax;
        jmp pus_out;

      pus_fail_stage:
        lea rax, [rip + _pus_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pus_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        mov rax, 1;

      pus_out:
        pop rbx;
        ret
      }
    }
}
