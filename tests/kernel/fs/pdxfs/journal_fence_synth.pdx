// tests/kernel/fs/pdxfs/journal_fence_synth.pdx -- R42.M2-002 (#1385)
//
// Boot witness for the PDXFS-v1 commit fence. Exercises reset
// (commit table empty), fence bookkeeping (fence_count bumps and
// snapshots wal_head), commit refusals (no-fence, bad-seq, already,
// table-full), commit happy path with fence + jfn_is_committed
// readback, bad-idx refusal on jfn_commit_seq_at, and idempotency
// under repeated jfn_is_committed after commit.
//
// Fingerprint: R42 PDXFS JOURNAL FENCE OK
// Failure fingerprint: R42 PDXFS JOURNAL FENCE FAIL + stage number.

module JournalFenceSynth = structure {

  pub let mut _jfnw_stage : u64 = 0

  pub let jfnw_ok   : [u8; 29] = "R42 PDXFS JOURNAL FENCE OK\n\0"
  pub let jfnw_fail : [u8; 31] = "R42 PDXFS JOURNAL FENCE FAIL\n\0"

  pub let journal_fence_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M2-002 (#1385): boot witness for pdxfs journal_fence. Resets wal + jfn. Labels prefixed jfnw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset both modules.
        mov rax, 1;
        lea rcx, [rip + _jfnw_stage];
        mov [rcx], rax;

        call wal_reset;
        call jfn_reset;
        call jfn_bound;
        cmp rax, 1;
        jne jfnw_fail_stage;
        call jfn_err;
        cmp rax, 0;
        jne jfnw_fail_stage;
        call jfn_fence_count;
        cmp rax, 0;
        jne jfnw_fail_stage;
        call jfn_commit_count;
        cmp rax, 0;
        jne jfnw_fail_stage;
        call jfn_commit_head;
        cmp rax, 0;
        jne jfnw_fail_stage;
        call jfn_last_commit_seq;
        cmp rax, 0;
        jne jfnw_fail_stage;
        call jfn_last_fence_head;
        cmp rax, 0;
        jne jfnw_fail_stage;

        // -- 2. Bad-seq refusal (commit for seq not in WAL).
        mov rax, 2;
        lea rcx, [rip + _jfnw_stage];
        mov [rcx], rax;

        mov rdi, 42;
        call jfn_commit;
        cmp rax, 0;
        jne jfnw_fail_stage;
        call jfn_err;
        mov r11, 0xFFFFEFBD;                    // JFN_ERR_BAD_SEQ
        cmp rax, r11;
        jne jfnw_fail_stage;

        call jfn_reset;
        call wal_reset;

        // -- 3. Append 3 WAL records; commit without fence refuses.
        mov rax, 3;
        lea rcx, [rip + _jfnw_stage];
        mov [rcx], rax;

        mov rdi, 100;
        mov rsi, 0;
        call wal_append;                        // seq=1
        mov rdi, 200;
        mov rsi, 1;
        call wal_append;                        // seq=2
        mov rdi, 300;
        mov rsi, 2;
        call wal_append;                        // seq=3

        mov rdi, 1;
        call jfn_commit;
        cmp rax, 0;
        jne jfnw_fail_stage;
        call jfn_err;
        mov r11, 0xFFFFEFBE;                    // JFN_ERR_NO_FENCE
        cmp rax, r11;
        jne jfnw_fail_stage;

        call jfn_reset;

        // -- 4. Fence then commit seq=1 succeeds. Fence should have
        //         snapshot head=3, and last_fence_head > seq's idx (0).
        mov rax, 4;
        lea rcx, [rip + _jfnw_stage];
        mov [rcx], rax;

        call jfn_fence;
        cmp rax, 3;                             // wal_head snapshot
        jne jfnw_fail_stage;
        call jfn_fence_count;
        cmp rax, 1;
        jne jfnw_fail_stage;
        call jfn_last_fence_head;
        cmp rax, 3;
        jne jfnw_fail_stage;

        mov rdi, 1;
        call jfn_commit;
        cmp rax, 1;
        jne jfnw_fail_stage;
        call jfn_commit_count;
        cmp rax, 1;
        jne jfnw_fail_stage;
        call jfn_commit_head;
        cmp rax, 1;
        jne jfnw_fail_stage;
        call jfn_last_commit_seq;
        cmp rax, 1;
        jne jfnw_fail_stage;

        // -- 5. jfn_is_committed(1) = 1; jfn_is_committed(2) = 0.
        mov rax, 5;
        lea rcx, [rip + _jfnw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call jfn_is_committed;
        cmp rax, 1;
        jne jfnw_fail_stage;
        mov rdi, 2;
        call jfn_is_committed;
        cmp rax, 0;
        jne jfnw_fail_stage;
        mov rdi, 3;
        call jfn_is_committed;
        cmp rax, 0;
        jne jfnw_fail_stage;

        // Idempotency: a second call still returns 1.
        mov rdi, 1;
        call jfn_is_committed;
        cmp rax, 1;
        jne jfnw_fail_stage;

        // -- 6. Already-committed refusal.
        mov rax, 6;
        lea rcx, [rip + _jfnw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call jfn_commit;
        cmp rax, 0;
        jne jfnw_fail_stage;
        call jfn_err;
        mov r11, 0xFFFFEFBC;                    // JFN_ERR_ALREADY
        cmp rax, r11;
        jne jfnw_fail_stage;

        call jfn_reset;

        // -- 7. Commit seq=2 and seq=3 in order, verify commit table.
        mov rax, 7;
        lea rcx, [rip + _jfnw_stage];
        mov [rcx], rax;

        call jfn_fence;
        cmp rax, 3;
        jne jfnw_fail_stage;

        mov rdi, 2;
        call jfn_commit;
        cmp rax, 1;
        jne jfnw_fail_stage;
        mov rdi, 3;
        call jfn_commit;
        cmp rax, 1;
        jne jfnw_fail_stage;

        call jfn_commit_head;
        cmp rax, 2;
        jne jfnw_fail_stage;
        call jfn_last_commit_seq;
        cmp rax, 3;
        jne jfnw_fail_stage;

        mov rdi, 0;
        call jfn_commit_seq_at;
        cmp rax, 2;
        jne jfnw_fail_stage;
        mov rdi, 1;
        call jfn_commit_seq_at;
        cmp rax, 3;
        jne jfnw_fail_stage;

        // -- 8. Bad-idx refusal on jfn_commit_seq_at.
        mov rax, 8;
        lea rcx, [rip + _jfnw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        call jfn_commit_seq_at;
        cmp rax, 0;
        jne jfnw_fail_stage;
        call jfn_err;
        mov r11, 0xFFFFEFBA;                    // JFN_ERR_BAD_IDX
        cmp rax, r11;
        jne jfnw_fail_stage;

        // Return modules to a clean state.
        call jfn_reset;
        call wal_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + jfnw_ok];
        call klog_s1;

        xor rax, rax;
        jmp jfnw_out;

      jfnw_fail_stage:
        lea rax, [rip + _jfnw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + jfnw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      jfnw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
