// tests/kernel/fs/pdxfs/lite_reader_synth.pdx -- R42.M4-003 (#1394)
//
// Boot witness for the PDXFS-lite read-only compat module. Exercises
// reset (blocks + sb + state cleared), mount before seed (magic 0 !=
// LITE): BAD_MAGIC, mount with V1 magic: BAD_MAGIC, read before mount:
// NOT_MOUNTED, write_refuse before mount: NOT_MOUNTED, seed_block
// bad-idx: BAD_IDX, happy mount + read of 4 blocks (payloads
// 0x11..0x44), read past capacity: BAD_IDX, write_refuse against a
// live mount: ROFS + counter bump, double-mount: ALREADY_MOUNTED,
// unmount + double-unmount: NOT_MOUNTED, then reset-latch clears.
//
// Fingerprint: R42 PDXFS LITE READER OK
// Failure fingerprint: R42 PDXFS LITE READER FAIL + stage number.

module LiteReaderSynth = structure {

  pub let mut _litw_stage : u64 = 0

  pub let litw_ok   : [u8; 27] = "R42 PDXFS LITE READER OK\n\0"
  pub let litw_fail : [u8; 29] = "R42 PDXFS LITE READER FAIL\n\0"

  pub let lite_reader_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M4-003 (#1394): boot witness for pdxfs lite_reader. Five-push callee-save discipline. Labels prefixed litw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _litw_stage];
        mov [rcx], rax;

        call lit_reset;
        call lit_bound;
        cmp rax, 1;
        jne litw_fail_stage;
        call lit_err;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_capacity;
        cmp rax, 16;
        jne litw_fail_stage;
        call lit_is_mounted;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_read_count;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_write_refuse_count;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_mount_count;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_unmount_count;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_sb_magic;
        cmp rax, 0;
        jne litw_fail_stage;

        // -- 2. Mount without seed (magic 0): BAD_MAGIC.
        mov rax, 2;
        lea rcx, [rip + _litw_stage];
        mov [rcx], rax;

        call lit_mount;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_err;
        mov r11, 0xFFFFEF2E;                    // LIT_ERR_BAD_MAGIC
        cmp rax, r11;
        jne litw_fail_stage;
        call lit_reset;

        // -- 3. Mount with V1 magic: BAD_MAGIC.
        mov rax, 3;
        lea rcx, [rip + _litw_stage];
        mov [rcx], rax;

        mov rdi, 0x50444653563200;              // LIT_MAGIC_V1
        call lit_seed_sb;
        cmp rax, 1;
        jne litw_fail_stage;
        call lit_mount;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_err;
        mov r11, 0xFFFFEF2E;
        cmp rax, r11;
        jne litw_fail_stage;
        call lit_reset;

        // -- 4. Read before mount: NOT_MOUNTED.
        mov rax, 4;
        lea rcx, [rip + _litw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call lit_read;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_err;
        mov r11, 0xFFFFEF2D;                    // LIT_ERR_NOT_MOUNTED
        cmp rax, r11;
        jne litw_fail_stage;
        call lit_reset;

        // -- 5. Write_refuse before mount: NOT_MOUNTED.
        mov rax, 5;
        lea rcx, [rip + _litw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0xABCD;
        call lit_write_refuse;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_err;
        mov r11, 0xFFFFEF2D;
        cmp rax, r11;
        jne litw_fail_stage;
        call lit_reset;

        // -- 6. seed_block bad-idx (16): BAD_IDX.
        mov rax, 6;
        lea rcx, [rip + _litw_stage];
        mov [rcx], rax;

        mov rdi, 16;
        mov rsi, 0xDEAD;
        call lit_seed_block;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_err;
        mov r11, 0xFFFFEF2C;                    // LIT_ERR_BAD_IDX
        cmp rax, r11;
        jne litw_fail_stage;
        call lit_reset;

        // -- 7. Happy mount + read of 4 seeded blocks.
        mov rax, 7;
        lea rcx, [rip + _litw_stage];
        mov [rcx], rax;

        mov rdi, 0x504446534C31;                // LIT_MAGIC_LITE
        call lit_seed_sb;
        cmp rax, 1;
        jne litw_fail_stage;
        mov rdi, 0; mov rsi, 0x11; call lit_seed_block;
        cmp rax, 1; jne litw_fail_stage;
        mov rdi, 1; mov rsi, 0x22; call lit_seed_block;
        cmp rax, 1; jne litw_fail_stage;
        mov rdi, 2; mov rsi, 0x33; call lit_seed_block;
        cmp rax, 1; jne litw_fail_stage;
        mov rdi, 3; mov rsi, 0x44; call lit_seed_block;
        cmp rax, 1; jne litw_fail_stage;

        call lit_mount;
        cmp rax, 1;
        jne litw_fail_stage;
        call lit_is_mounted;
        cmp rax, 1;
        jne litw_fail_stage;
        call lit_mount_count;
        cmp rax, 1;
        jne litw_fail_stage;

        mov rdi, 0; call lit_read;
        mov r11, 0x11; cmp rax, r11; jne litw_fail_stage;
        mov rdi, 1; call lit_read;
        mov r11, 0x22; cmp rax, r11; jne litw_fail_stage;
        mov rdi, 2; call lit_read;
        mov r11, 0x33; cmp rax, r11; jne litw_fail_stage;
        mov rdi, 3; call lit_read;
        mov r11, 0x44; cmp rax, r11; jne litw_fail_stage;

        call lit_read_count;
        cmp rax, 4;
        jne litw_fail_stage;

        // -- 8. Read past capacity: BAD_IDX.
        mov rax, 8;
        lea rcx, [rip + _litw_stage];
        mov [rcx], rax;

        mov rdi, 16;
        call lit_read;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_err;
        mov r11, 0xFFFFEF2C;
        cmp rax, r11;
        jne litw_fail_stage;
        // read_count NOT bumped by the refusal.
        call lit_read_count;
        cmp rax, 4;
        jne litw_fail_stage;

        // Clear latch by resetting and re-seeding + mounting again.
        call lit_reset;
        mov rdi, 0x504446534C31; call lit_seed_sb;
        mov rdi, 0; mov rsi, 0x11; call lit_seed_block;
        call lit_mount;
        cmp rax, 1;
        jne litw_fail_stage;

        // -- 9. write_refuse against a live mount: ROFS + counter.
        mov rax, 9;
        lea rcx, [rip + _litw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0xBEEF;
        call lit_write_refuse;
        mov r11, 0xFFFFEF2B;                    // LIT_ERR_ROFS
        cmp rax, r11;
        jne litw_fail_stage;
        call lit_write_refuse_count;
        cmp rax, 1;
        jne litw_fail_stage;
        // Second write also refused, counter bumps.
        mov rdi, 1;
        mov rsi, 0xF00D;
        call lit_write_refuse;
        mov r11, 0xFFFFEF2B;
        cmp rax, r11;
        jne litw_fail_stage;
        call lit_write_refuse_count;
        cmp rax, 2;
        jne litw_fail_stage;
        // Block payloads unchanged (still 0x11 at slot 0).
        mov rdi, 0; call lit_read;
        mov r11, 0x11; cmp rax, r11; jne litw_fail_stage;

        // -- 10. Double-mount: ALREADY_MOUNTED.
        mov rax, 10;
        lea rcx, [rip + _litw_stage];
        mov [rcx], rax;

        call lit_mount;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_err;
        mov r11, 0xFFFFEF2A;                    // LIT_ERR_ALREADY_MOUNTED
        cmp rax, r11;
        jne litw_fail_stage;

        // -- 11. Unmount + double-unmount refuse + read-refuse afterwards.
        mov rax, 11;
        lea rcx, [rip + _litw_stage];
        mov [rcx], rax;

        // Clear the latch before unmount so post-unmount checks see a
        // fresh error window.
        call lit_reset;
        mov rdi, 0x504446534C31; call lit_seed_sb;
        call lit_mount;
        cmp rax, 1; jne litw_fail_stage;

        call lit_unmount;
        cmp rax, 1;
        jne litw_fail_stage;
        call lit_is_mounted;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_unmount_count;
        cmp rax, 1;
        jne litw_fail_stage;

        // Double-unmount: NOT_MOUNTED.
        call lit_unmount;
        cmp rax, 0;
        jne litw_fail_stage;
        call lit_err;
        mov r11, 0xFFFFEF2D;
        cmp rax, r11;
        jne litw_fail_stage;
        call lit_reset;

        // Return module to a clean state.
        mov rdi, 0x504446534C31; call lit_seed_sb;
        call lit_mount;
        cmp rax, 1; jne litw_fail_stage;
        call lit_unmount;
        cmp rax, 1; jne litw_fail_stage;
        call lit_reset;
        call lit_bound;
        cmp rax, 1;
        jne litw_fail_stage;
        call lit_err;
        cmp rax, 0;
        jne litw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + litw_ok];
        call klog_s1;

        xor rax, rax;
        jmp litw_out;

      litw_fail_stage:
        lea rax, [rip + _litw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + litw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      litw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
