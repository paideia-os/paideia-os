// tests/kernel/fs/pdxfs/cow_write_synth.pdx -- R42.M1-003 (#1382)
//
// Boot witness for the PDXFS-v1 CoW write path. Exercises reset
// (blocks zeroed, next_free_block = 1), pxcw_alloc_block sequence,
// OOS refusal after alloc exhaustion (deferred; walked in a small
// prime), out-of-extent + bad-snapshot refusals on write, UNIQUE
// path (in-place overwrite, fast_paths bump), SHARED path (alloc +
// copy + refcount adjust + snapshot_map + payload write, cow_dupes
// bump), and the READ_MISS refusal when the target lba has no chain
// mapping.
//
// Fingerprint: PDXFS COW WRITE OK
// Failure fingerprint: PDXFS COW WRITE FAIL + stage number.

module CowWriteSynth = structure {

  pub let mut _pxcww_stage : u64 = 0

  pub let pxcww_ok : [u8; 21] = "PDXFS COW WRITE OK\n\0"
  pub let pxcww_fail : [u8; 23] = "PDXFS COW WRITE FAIL\n\0"

  pub let cow_write_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M1-003 (#1382): boot witness for pdxfs cow_write. Depends on pxrc + pxcr resets executed first inside this witness. Labels prefixed pxcww_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset all three modules the write path touches.
        mov rax, 1;
        lea rcx, [rip + _pxcww_stage];
        mov [rcx], rax;

        call pxrc_reset;
        call pxcr_reset;
        call pxcw_reset;
        call pxcw_bound;
        cmp rax, 1;
        jne pxcww_fail_stage;
        call pxcw_err;
        cmp rax, 0;
        jne pxcww_fail_stage;
        call pxcw_write_count;
        cmp rax, 0;
        jne pxcww_fail_stage;
        call pxcw_cow_dupes;
        cmp rax, 0;
        jne pxcww_fail_stage;
        call pxcw_fast_paths;
        cmp rax, 0;
        jne pxcww_fail_stage;
        call pxcw_alloc_count;
        cmp rax, 0;
        jne pxcww_fail_stage;
        call pxcw_next_free;
        cmp rax, 1;
        jne pxcww_fail_stage;

        // -- 2. pxcw_alloc_block sequence: 1, 2, 3.
        mov rax, 2;
        lea rcx, [rip + _pxcww_stage];
        mov [rcx], rax;

        call pxcw_alloc_block;
        cmp rax, 1;
        jne pxcww_fail_stage;
        call pxcw_alloc_block;
        cmp rax, 2;
        jne pxcww_fail_stage;
        call pxcw_alloc_block;
        cmp rax, 3;
        jne pxcww_fail_stage;

        call pxcw_alloc_count;
        cmp rax, 3;
        jne pxcww_fail_stage;
        call pxcw_next_free;
        cmp rax, 4;
        jne pxcww_fail_stage;

        // -- 3. Bad-snapshot refusal (snapshot_id == 0).
        mov rax, 3;
        lea rcx, [rip + _pxcww_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 10;
        mov rdx, 0xAA;
        call pxcw_write;
        mov r11, 0xFFFFEFEB;                    // PXCW_ERR_BAD_SNAPSHOT
        cmp rax, r11;
        jne pxcww_fail_stage;

        // -- 4. Out-of-extent refusal.
        mov rax, 4;
        lea rcx, [rip + _pxcww_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 4096;
        mov rdx, 0xAA;
        call pxcw_write;
        mov r11, 0xFFFFEFEE;                    // PXCW_ERR_OUT_OF_EXTENT
        cmp rax, r11;
        jne pxcww_fail_stage;

        // -- 5. READ_MISS refusal when the target lba has no chain mapping.
        mov rax, 5;
        lea rcx, [rip + _pxcww_stage];
        mov [rcx], rax;

        call pxrc_reset;
        call pxcr_reset;
        call pxcw_reset;
        // No pxcr_snapshot_push + no pxcr_snapshot_map -> pxcr_read
        // returns NOT_FOUND, which pxcw surfaces as READ_MISS.
        call pxcr_snapshot_push;
        cmp rax, 1;
        jne pxcww_fail_stage;

        mov rdi, 1;
        mov rsi, 42;
        mov rdx, 0x11;
        call pxcw_write;
        mov r11, 0xFFFFEFEC;                    // PXCW_ERR_READ_MISS
        cmp rax, r11;
        jne pxcww_fail_stage;

        // -- 6. UNIQUE path (in-place).
        //         Prime snapshot 1 with lba 50 -> phys 5.
        //         Refcount phys 5 = 1 -> pxcw_write overwrites in place.
        mov rax, 6;
        lea rcx, [rip + _pxcww_stage];
        mov [rcx], rax;

        call pxrc_reset;
        call pxcr_reset;
        call pxcw_reset;

        call pxcr_snapshot_push;
        cmp rax, 1;
        jne pxcww_fail_stage;
        mov rdi, 1;
        mov rsi, 50;
        mov rdx, 5;
        call pxcr_snapshot_map;
        cmp rax, 0;
        jne pxcww_fail_stage;
        mov rdi, 5;
        call pxrc_inc;
        cmp rax, 1;
        jne pxcww_fail_stage;

        mov rdi, 1;
        mov rsi, 50;
        mov rdx, 0xDEAD;
        call pxcw_write;
        cmp rax, 0;
        jne pxcww_fail_stage;

        call pxcw_fast_paths;
        cmp rax, 1;
        jne pxcww_fail_stage;
        call pxcw_cow_dupes;
        cmp rax, 0;
        jne pxcww_fail_stage;
        call pxcw_write_count;
        cmp rax, 1;
        jne pxcww_fail_stage;

        // Block 5 payload now holds 0xDEAD.
        mov rdi, 5;
        call pxcw_block_read;
        mov r11, 0xDEAD;
        cmp rax, r11;
        jne pxcww_fail_stage;

        // Refcount unchanged (still 1).
        mov rdi, 5;
        call pxrc_get;
        cmp rax, 1;
        jne pxcww_fail_stage;

        // -- 7. SHARED path.
        //         Snapshot 2 pushed; lba 50 already resolves to phys 5.
        //         Bump refcount of phys 5 to 2 (SHARED).
        //         pxcw_write for snapshot 2, lba 50, payload 0xBEEF:
        //           alloc new_blk, copy, dec 5, inc new, map, write.
        mov rax, 7;
        lea rcx, [rip + _pxcww_stage];
        mov [rcx], rax;

        call pxcr_snapshot_push;
        cmp rax, 2;
        jne pxcww_fail_stage;

        mov rdi, 5;
        call pxrc_inc;
        cmp rax, 2;
        jne pxcww_fail_stage;

        // Snapshot next_free_block before the SHARED write.
        call pxcw_next_free;
        mov r12, rax;                           // r12 = new_blk expected

        mov rdi, 2;
        mov rsi, 50;
        mov rdx, 0xBEEF;
        call pxcw_write;
        cmp rax, 0;
        jne pxcww_fail_stage;

        call pxcw_cow_dupes;
        cmp rax, 1;
        jne pxcww_fail_stage;
        call pxcw_fast_paths;
        cmp rax, 1;
        jne pxcww_fail_stage;
        call pxcw_write_count;
        cmp rax, 2;
        jne pxcww_fail_stage;

        // The new block holds 0xBEEF.
        mov rdi, r12;
        call pxcw_block_read;
        mov r11, 0xBEEF;
        cmp rax, r11;
        jne pxcww_fail_stage;

        // The old block still holds 0xDEAD (only remap changes owner).
        mov rdi, 5;
        call pxcw_block_read;
        mov r11, 0xDEAD;
        cmp rax, r11;
        jne pxcww_fail_stage;

        // Refcount phys 5 dropped from 2 to 1.
        mov rdi, 5;
        call pxrc_get;
        cmp rax, 1;
        jne pxcww_fail_stage;

        // Refcount new block incremented to 1.
        mov rdi, r12;
        call pxrc_get;
        cmp rax, 1;
        jne pxcww_fail_stage;

        // pxcr_read(50) now resolves to new_blk (newest wins).
        mov rdi, 50;
        call pxcr_read;
        cmp rax, r12;
        jne pxcww_fail_stage;

        // Return the modules to a clean state.
        call pxcw_reset;
        call pxcr_reset;
        call pxrc_reset;
        call pxcw_bound;
        cmp rax, 1;
        jne pxcww_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxcww_ok];
        call klog_s1;

        xor rax, rax;
        jmp pxcww_out;

      pxcww_fail_stage:
        lea rax, [rip + _pxcww_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxcww_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pxcww_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
