// tests/kernel/fs/pdxfs/durability_synth.pdx -- R42.M5-002 (#1397)
//
// Boot witness for the PDXFS v1 durability primitives module.
// Exercises reset (levels + state cleared, default level = SYNC),
// bad-fd refusals, bad-level refusal, level round-trip (set +
// get_level), fsync dispatch on default level (SYNC path),
// fsync dispatch after set to BARRIER, fsync dispatch after set
// to NONE, dur_barrier (independent of level), boundary fd
// (DUR_FD_MAX - 1), and reset-latch clears.
//
// Fingerprint: PDXFS DURABILITY OK
// Failure fingerprint: PDXFS DURABILITY FAIL + stage number.

module DurabilitySynth = structure {

  pub let mut _durw_stage : u64 = 0

  pub let durw_ok : [u8; 22] = "PDXFS DURABILITY OK\0"
  pub let durw_fail : [u8; 24] = "PDXFS DURABILITY FAIL\0"

  pub let durability_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M5-002 (#1397): boot witness for pdxfs durability primitives. Five-push callee-save discipline. Stages: reset defaults; bad-fd on get/set/fsync/barrier; bad-level on set; SYNC dispatch; BARRIER dispatch; NONE dispatch; independent barrier bump; boundary fd; reset-latch. Labels prefixed durw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- S1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _durw_stage];
        mov [rcx], rax;

        call dur_reset;
        call dur_bound;
        cmp rax, 1;
        jne durw_fail_stage;
        call dur_err;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_fd_max;
        cmp rax, 128;
        jne durw_fail_stage;
        call dur_fsync_count;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_barrier_count;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_noop_count;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_set_count;
        cmp rax, 0;
        jne durw_fail_stage;
        // Default level of an untouched fd is SYNC (0).
        mov rdi, 0;
        call dur_get_level;
        cmp rax, 0;
        jne durw_fail_stage;
        mov rdi, 42;
        call dur_get_level;
        cmp rax, 0;
        jne durw_fail_stage;

        // -- S2. Bad-fd refusals.
        mov rax, 2;
        lea rcx, [rip + _durw_stage];
        mov [rcx], rax;

        mov rdi, 128;                           // == DUR_FD_MAX
        call dur_get_level;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_err;
        mov r11, 0xFFFFEEFE;
        cmp rax, r11;
        jne durw_fail_stage;
        call dur_reset;

        mov rdi, 128;
        mov rsi, 1;
        call dur_set_level;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_err;
        mov r11, 0xFFFFEEFE;
        cmp rax, r11;
        jne durw_fail_stage;
        call dur_reset;

        mov rdi, 200;
        call dur_fsync;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_err;
        mov r11, 0xFFFFEEFE;
        cmp rax, r11;
        jne durw_fail_stage;
        call dur_reset;

        mov rdi, 200;
        call dur_barrier;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_err;
        mov r11, 0xFFFFEEFE;
        cmp rax, r11;
        jne durw_fail_stage;
        call dur_reset;

        // -- S3. Bad-level on set.
        mov rax, 3;
        lea rcx, [rip + _durw_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 3;                             // past DUR_LEVEL_MAX (2)
        call dur_set_level;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_err;
        mov r11, 0xFFFFEEFD;
        cmp rax, r11;
        jne durw_fail_stage;
        // The bad set MUST NOT have written the row.
        mov rdi, 5;
        call dur_get_level;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_reset;

        // -- S4. Level round-trip (set + get + set_count).
        mov rax, 4;
        lea rcx, [rip + _durw_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 1;                             // BARRIER
        call dur_set_level;
        cmp rax, 1;
        jne durw_fail_stage;
        mov rdi, 5;
        call dur_get_level;
        cmp rax, 1;
        jne durw_fail_stage;
        call dur_set_count;
        cmp rax, 1;
        jne durw_fail_stage;

        mov rdi, 6;
        mov rsi, 2;                             // NONE
        call dur_set_level;
        cmp rax, 1;
        jne durw_fail_stage;
        mov rdi, 6;
        call dur_get_level;
        cmp rax, 2;
        jne durw_fail_stage;
        call dur_set_count;
        cmp rax, 2;
        jne durw_fail_stage;

        // Downgrade fd 5 back to SYNC (0).
        mov rdi, 5;
        mov rsi, 0;
        call dur_set_level;
        cmp rax, 1;
        jne durw_fail_stage;
        mov rdi, 5;
        call dur_get_level;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_set_count;
        cmp rax, 3;
        jne durw_fail_stage;

        // -- S5. fsync dispatch on default SYNC (fd 10 untouched).
        mov rax, 5;
        lea rcx, [rip + _durw_stage];
        mov [rcx], rax;

        mov rdi, 10;
        call dur_fsync;
        cmp rax, 1;
        jne durw_fail_stage;
        call dur_fsync_count;
        cmp rax, 1;
        jne durw_fail_stage;
        call dur_barrier_count;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_noop_count;
        cmp rax, 0;
        jne durw_fail_stage;

        // -- S6. fsync dispatch after set to BARRIER.
        mov rax, 6;
        lea rcx, [rip + _durw_stage];
        mov [rcx], rax;

        mov rdi, 11;
        mov rsi, 1;                             // BARRIER
        call dur_set_level;
        cmp rax, 1;
        jne durw_fail_stage;
        mov rdi, 11;
        call dur_fsync;
        cmp rax, 1;
        jne durw_fail_stage;
        call dur_fsync_count;
        cmp rax, 1;
        jne durw_fail_stage;
        call dur_barrier_count;
        cmp rax, 1;
        jne durw_fail_stage;

        // -- S7. fsync dispatch after set to NONE.
        mov rax, 7;
        lea rcx, [rip + _durw_stage];
        mov [rcx], rax;

        mov rdi, 12;
        mov rsi, 2;                             // NONE
        call dur_set_level;
        cmp rax, 1;
        jne durw_fail_stage;
        mov rdi, 12;
        call dur_fsync;
        cmp rax, 1;
        jne durw_fail_stage;
        call dur_noop_count;
        cmp rax, 1;
        jne durw_fail_stage;

        // -- S8. dur_barrier independent of level.
        mov rax, 8;
        lea rcx, [rip + _durw_stage];
        mov [rcx], rax;

        mov rdi, 12;                            // still NONE
        call dur_barrier;
        cmp rax, 1;
        jne durw_fail_stage;
        call dur_barrier_count;
        cmp rax, 2;
        jne durw_fail_stage;

        mov rdi, 10;                            // still SYNC (default)
        call dur_barrier;
        cmp rax, 1;
        jne durw_fail_stage;
        call dur_barrier_count;
        cmp rax, 3;
        jne durw_fail_stage;

        // -- S9. Boundary fd DUR_FD_MAX - 1 admitted; DUR_FD_MAX refused.
        mov rax, 9;
        lea rcx, [rip + _durw_stage];
        mov [rcx], rax;

        mov rdi, 127;
        mov rsi, 1;                             // BARRIER
        call dur_set_level;
        cmp rax, 1;
        jne durw_fail_stage;
        mov rdi, 127;
        call dur_get_level;
        cmp rax, 1;
        jne durw_fail_stage;

        // Reset the module to a clean state.
        call dur_reset;
        call dur_bound;
        cmp rax, 1;
        jne durw_fail_stage;
        call dur_err;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_fsync_count;
        cmp rax, 0;
        jne durw_fail_stage;
        call dur_set_count;
        cmp rax, 0;
        jne durw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + durw_ok];
        call klog_s1;

        xor rax, rax;
        jmp durw_out;

      durw_fail_stage:
        lea rax, [rip + _durw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + durw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      durw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
