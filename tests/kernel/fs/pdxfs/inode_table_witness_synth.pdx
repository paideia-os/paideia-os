// tests/kernel/fs/pdxfs/inode_table_witness_synth.pdx -- R52.M4-006 (#1702)
//
// Boot witness for the PDXFS-on-block v1 inode table skeleton
// (src/kernel/core/fs/pdxfs/inode_table.pdx, #1698): fetch the root
// inode (1) cleanly through `inode_read`, then place a second inode at
// a middle slot (42) and prove it re-reads cleanly too. This CLOSES
// R52.M4.
//
// Design authority: design/filesystem/r52-implementation-plan.md §2.4
// step 6 (#1702: "Boot witness: mkfs-time root inode 1 fetches cleanly,
// then allocate inode 42 (via inode_alloc_fresh), verify both re-read
// cleanly with signatures").
//
// Fingerprint: "INODE TABLE WITNESS OK" (no round/milestone/issue
// prefix, per this issue's own instruction and design/policy/output-
// provenance-strip.md).
//
// -----------------------------------------------------------------------------
// SCOPE
// -----------------------------------------------------------------------------
//
// Same substrate-mode pattern tests/kernel/fs/pdxfs/
// alloc_free_hint_witness_synth.pdx (#1696) already establishes for
// driving inode_table.pdx's real `cap_invoke` BDEV path without live
// hardware: mint a real KIND_NVME_CONTROLLER + dual-kind
// KIND_NVME_NAMESPACE/KIND_BLKDEV row, but never advance it to a live
// SQ pair, so every READ_LBA/WRITE_LBA `itable_ensure_block_loaded`/
// `inode_write` issues forwards NVMEIO_PICK_NONE (0xFFFFEC58) verbatim,
// which `BdevBarrier.bbjw_check` treats as acceptable alongside
// BDEV_ERR_OK -- exactly the same tolerance inode_table.pdx's own
// header documents (reusing allocator.pdx's ALLOC_BITMAP_TORN posture).
//
// No mkfs-time on-disk root-inode-write step exists yet in this tree
// (mkfs.pdx's own scope never touches the inode table), so this witness
// synthesizes the "root inode" the plan text describes by calling the
// real `inode_alloc_fresh` once against a freshly-zeroed (.bss,
// substrate-mode -- no real DMA ever touches `_itable_blk_buf`)
// inode-table region: with inode 0 the permanent sentinel and every
// slot's in_use byte starting at 0, `inode_alloc_fresh`'s whole-region
// scan finds slot 1 first and durably (in this substrate's sense)
// writes it in_use=1 -- exactly `InodeTable.INODE_ROOT` (1). Inode 42
// is placed directly via `inode_write` with a hand-built minimal row
// (mirroring `inode_alloc_fresh`'s own row construction), which needs
// `itable_bcount >= 2` (block_idx = 42/32 = 1) -- set on the synthetic
// superblock fixture below.
//
// #1700 (inode_no -> (inode_lba, slot_in_block) resolver) and #1701
// (sig_verify.pdx / BLAKE3 tail-signature verification) are not called
// anywhere in inode_table.pdx as landed by #1698 (confirmed by reading
// inode_table.pdx at this witness's landing tip -- inode_read has no
// sig_verify call site), so "verify... with signatures" is out of
// scope for what inode_read itself can prove today regardless of
// whether #1700/#1701 have landed elsewhere in the tree by build time;
// this witness proves the concrete, currently-wired contract instead:
// inode_read returns neither INODE_INVALID_INDEX (0xFFFFED18) nor
// INODE_HEADER_INUSE_BAD (0xFFFFED19) nor the reused ALLOC_BITMAP_TORN
// (0xFFFFED11) I/O-failure sentinel, AND the returned row's own
// inode_no field and in_use byte round-trip exactly -- a strictly
// stronger check than "no error code", the same "assert exact values,
// not just non-error" discipline alloc_free_hint_witness_synth.pdx's
// own header note establishes for this milestone's witness family.
//
// -----------------------------------------------------------------------------
// What this witness proves
// -----------------------------------------------------------------------------
//
// (1) `itable_init(sb_ptr)` against a synthetic 2-block-region fixture
//     (itable_lba=20, itable_bcount=2) returns 0.
// (2) `inode_alloc_fresh(bdev_cap)` against the fresh all-clear region
//     returns EXACTLY 1 (INODE_ROOT) -- the permanent sentinel (0) is
//     skipped, slot 1 is the first free row.
// (3) `inode_read(bdev_cap, 1)` returns a value that is none of
//     INODE_INVALID_INDEX / INODE_HEADER_INUSE_BAD / the reused
//     ALLOC_BITMAP_TORN, and the returned row's inode_no field (@+8)
//     reads back exactly 1 and its header in_use byte reads back
//     exactly 1 -- "fetches cleanly" proven concretely, not just
//     "didn't error".
// (4) A minimal fresh row for inode 42 (in_use=1, inode_no=42,
//     refcount=1, mirroring `inode_alloc_fresh`'s own construction) is
//     placed via `inode_write(bdev_cap, 42, row_ptr)`, which returns 0.
// (5) `inode_read(bdev_cap, 42)` passes the identical three-sentinel
//     non-error check plus the inode_no==42 / in_use==1 round-trip
//     check step (3) already established for inode 1 -- proving the
//     middle slot (block_idx=1, slot_in_block=10) fetches cleanly too,
//     independent of inode 1's own block (block_idx=0).
//
// -----------------------------------------------------------------------------
// Synthetic superblock fixture
// -----------------------------------------------------------------------------
//
// `_itw_sb` is a private 4 KiB scratch buffer this file owns outright,
// zeroed then stamped with only the two fields `itable_init` actually
// reads (superblock.pdx, #1682): `itable_lba` (u64 @+40) = 20,
// `itable_bcount` (u64 @+48) = 2 (covers block_idx 0 AND 1, needed for
// inode 42's block_idx = 42/32 = 1). No other superblock field is read
// by `itable_init`, so the rest of the buffer is left zero, matching
// alloc_free_hint_witness_synth.pdx's own precedent.
//
// -----------------------------------------------------------------------------
// Cap slots 172..175 (same fixed range alloc_free_hint_witness_synth.
// pdx already claims -- tolerated per this tree's established practice:
// every witness clears its own range on entry AND on every exit path,
// and boot witnesses run strictly sequentially, so no two witnesses'
// cap rows are ever live at once)
// -----------------------------------------------------------------------------
//
//   172 = synthetic KIND_PCI_DEV parent for the NVMe controller
//   173 = KIND_NVME_CONTROLLER (row 0)
//   174 = KIND_NVME_NAMESPACE (row 0, dual-kind with slot 175)
//   175 = KIND_BLKDEV, family NVME (dual-kind with ns row 0) -- the
//         bdev_cap passed to every inode_table.pdx call in this witness
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// One callee-save push (rbx = &_itw_sb, the sb_ptr reused across the
// one `itable_init` call) leaves rsp%16 == 0 (entry rsp%16 == 8 + 8 =
// 16) for every nested call this function makes directly, matching
// alloc_free_hint_witness_synth.pdx's own `alloc_free_hint_witness`
// shape. `bdev_cap` (175) and every expected inode_no/field value are
// compile-time-constant immediates -- no register needs to carry them
// across calls. `inode_read`'s returned row pointer is consumed
// immediately (two plain loads, no intervening call) so it never needs
// a callee-save slot. The one `sub rsp, 32` / `add rsp, 32` bracket
// around `nvme_ns_dual_kind_mint`'s params_ptr staging is 16-byte-
// aligned, so rsp%16 stays 0 across it (identical bracket to
// alloc_free_hint_witness_synth.pdx). Stage number lives in
// `_itw_stage` (memory, not a register), matching that file's
// `_afhw_stage` idiom.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere in this file -- every field
// touched is a u64 (`mov`) or u32 (`mov_d`), and the in_use byte is
// extracted register-level via shr+and over an already-loaded qword,
// so no `mov_b` is needed. No `test` instruction anywhere; every
// comparison uses `cmp` + `je`/`jne`/`jae`. Every label is prefixed
// `itw_` (Inode Table Witness) per the reserved-label discipline.
//
// Every sentinel compare against a value with bit 31/63 set (the three
// M4/M3 failure codes 0xFFFFED18/19/11) is staged through `mov r10,
// <imm>; cmp reg, r10` rather than a bare `cmp reg, <imm>` -- a bare
// `cmp rax, 0xFFFFED18` would compare against 0xFFFFFFFFFFFFED18
// instead (imm32 cmp operands sign-extend; mov imm64 does not) --
// identical posture nvme_reliability.pdx's own header already
// documents (G4 encoder-gap posture) and inode_table.pdx's own
// mov-imm64 error-return idiom relies on from the producer side.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately after
// `alloc_free_hint_witness_call` (the most recent addition to that file
// at the time of this landing). Golden: tests/r17/shell-shutdown.golden
// ("INODE TABLE WITNESS OK" appended right after "ALLOC WITNESS OK").

module InodeTableWitnessSynth = structure {

  pub let mut _itw_sb          : [u64; 512] = uninit @align(4096)
  pub let mut _itw_row_scratch : [u64; 16]  = uninit @align(64)
  pub let mut _itw_stage       : u64 = 0

  pub let itw_ok   : [u8; 24] = "INODE TABLE WITNESS OK\0"
  pub let itw_fail : [u8; 26] = "INODE TABLE WITNESS FAIL\0"

  // ==========================================================================
  // itw_clear() -- scrub cap_table slots 172..175 inclusive.
  // ==========================================================================
  pub let itw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M4-006 (#1702): clear cap_table slots 172..175 (this witness's whole fixed slot claim, shared with alloc_free_hint_witness_synth.pdx's afhw_clear -- tolerated per established practice since witnesses run sequentially). Same shape as afhw_clear. Labels prefixed itw_cl_.",
      block: {
        push rbx;
        mov rbx, 172;
      itw_cl_loop:
        cmp rbx, 176;
        jae itw_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp itw_cl_loop;
      itw_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // inode_table_witness() -> u64
  //
  // See module header for the full stage-by-step scope note, the
  // substrate-mode NVMe-cap trick this witness relies on, and the
  // synthetic superblock fixture's field layout.
  // ==========================================================================
  pub let inode_table_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R52.M4-006 (#1702): inode table boot witness (root inode 1 + middle slot 42 both fetch cleanly through inode_read). One callee-save push (rbx = &_itw_sb) leaves rsp%16==0 for every nested call. Body per the module header's numbered scope note: (1) defensive reset (nvme_ctrl_table_reset, nvme_ns_table_reset, itw_clear). (2)-(4) mint a real KIND_NVME_CONTROLLER (slot 173, row 0) + dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots 174/175, row 0) under a synthetic KIND_PCI_DEV parent (slot 172), never advancing to a live SQ pair -- READ_LBA/WRITE_LBA against slot 175 therefore always forward NVMEIO_PICK_NONE (0xFFFFEC58), which BdevBarrier.bbjw_check treats as acceptable, matching alloc_free_hint_witness_synth.pdx's identical staging code verbatim. (5) zero + stamp _itw_sb's two inode_table-relevant fields (itable_lba@+40=20, itable_bcount@+48=2 -- covers block_idx 0 and 1, needed for inode 42). (6) itable_init(rbx) == 0. (7) inode_alloc_fresh(175) == 1 (INODE_ROOT -- first free slot after the permanent sentinel 0, against the fresh all-clear region). (8) inode_read(175, 1): rax must equal none of INODE_INVALID_INDEX (0xFFFFED18) / INODE_HEADER_INUSE_BAD (0xFFFFED19) / the reused ALLOC_BITMAP_TORN (0xFFFFED11); then [rax+8] (inode_no field) == 1 and ([rax+0] shr 56 and 0xFF) (in_use byte) == 1 -- both loads consume rax directly, no intervening call, so no callee-save needed. (9) build a minimal fresh row for inode 42 in _itw_row_scratch (zero all 16 qwords via a manual rcx=0..16 loop, then header=1 shl 56 at +0, inode_no=42 at +8, refcount=1 at +40 -- mirrors inode_table.pdx's own inode_alloc_fresh construction). (10) inode_write(175, 42, &_itw_row_scratch) == 0. (11) inode_read(175, 42): identical three-sentinel non-error check, then [rax+8]==42 and in_use byte==1. (12) all pass -> klog_s1(3, SUBSYS_BOOT, itw_ok); cleanup (itw_clear + nvme_ctrl_table_reset + nvme_ns_table_reset); return 0. Any stage divergence -> itw_fail_stage, which logs the stage number via klog_s1_d1(k_line) exactly as alloc_free_hint_witness_synth.pdx's own afhw_fail_stage does, then runs the same cleanup and returns 1. Labels prefixed itw_.",
      block: {
        push rbx;

        // -----------------------------------------------------------
        // (1) Defensive reset.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _itw_stage];
        mov [rcx], rax;

        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call itw_clear;

        // -----------------------------------------------------------
        // (2) Synthetic KIND_PCI_DEV parent (slot 172).
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _itw_stage];
        mov [rcx], rax;

        mov rdi, 172;
        mov rsi, 0x30;                    // KIND_PCI_DEV
        mov rdx, 0x21F;                   // R_DEV_ALL | RIGHT_MINT
        mov rcx, 0xFACEFEED;              // synthetic bdf
        call cap_mint_write;

        // -----------------------------------------------------------
        // (3) KIND_NVME_CONTROLLER (slot 173, row 0). Never advanced
        // to a live SQ pair -- substrate-mode posture.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _itw_stage];
        mov [rcx], rax;

        mov rdi, 172;                     // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                   // R_NVMEC_ALL
        xor rdx, rdx;                     // ctrl_idx = 0
        mov rcx, 0x400000;                // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                       // expect row 0
        jne itw_fail_stage;

        mov rdi, 173;
        mov rsi, 0x198;                   // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                     // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) Dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots
        // 174/175, row 0).
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _itw_stage];
        mov [rcx], rax;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;                // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;                // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;               // block_count
        xor rax, rax;
        mov [rsp + 24], rax;               // parent_ctrl_row = 0
        mov rdi, 174;                      // ns_slot
        mov rsi, 175;                      // blk_slot
        mov rdx, 173;                      // parent_slot (KIND_NVME_CONTROLLER)
        mov rcx, 0x41F;                    // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                     // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                      // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                        // expect row 0
        jne itw_fail_stage;

        // -----------------------------------------------------------
        // (5) Zero + stamp the synthetic superblock fixture.
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _itw_stage];
        mov [rcx], rax;

        lea rbx, [rip + _itw_sb];
        xor rax, rax;
        xor rcx, rcx;
      itw_sbzero_top:
        cmp rcx, 512;
        jae itw_sbzero_done;
        mov [rbx + rcx * 8], rax;
        add rcx, 1;
        jmp itw_sbzero_top;
      itw_sbzero_done:

        mov rax, 20;
        mov [rbx + 40], rax;               // itable_lba
        mov rax, 2;
        mov [rbx + 48], rax;               // itable_bcount (covers block_idx 0 and 1)

        // -----------------------------------------------------------
        // (6) itable_init(rbx) == 0.
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _itw_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call itable_init;
        cmp rax, 0;
        jne itw_fail_stage;

        // -----------------------------------------------------------
        // (7) inode_alloc_fresh(175) == 1 (INODE_ROOT).
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _itw_stage];
        mov [rcx], rax;

        mov rdi, 175;
        call inode_alloc_fresh;
        cmp rax, 1;
        jne itw_fail_stage;

        // -----------------------------------------------------------
        // (8) inode_read(175, 1) -- not an error sentinel, and the
        // returned row's inode_no/in_use round-trip exactly.
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _itw_stage];
        mov [rcx], rax;

        mov rdi, 175;
        mov rsi, 1;
        call inode_read;
        mov r10, 0xFFFFED18;               // bit 31/63 set: stage via reg, no bare imm cmp
        cmp rax, r10;
        je itw_fail_stage;
        mov r10, 0xFFFFED19;
        cmp rax, r10;
        je itw_fail_stage;
        mov r10, 0xFFFFED11;
        cmp rax, r10;
        je itw_fail_stage;

        mov rcx, [rax + 8];
        cmp rcx, 1;
        jne itw_fail_stage;

        mov rdx, [rax + 0];
        shr rdx, 56;
        and rdx, 0xFF;
        cmp rdx, 1;
        jne itw_fail_stage;

        // -----------------------------------------------------------
        // (9) Build a minimal fresh row for inode 42 in
        // _itw_row_scratch.
        // -----------------------------------------------------------
        mov rax, 9;
        lea rcx, [rip + _itw_stage];
        mov [rcx], rax;

        lea r10, [rip + _itw_row_scratch];
        xor rax, rax;
        xor rcx, rcx;
      itw_rowzero_top:
        cmp rcx, 16;
        jae itw_rowzero_done;
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp itw_rowzero_top;
      itw_rowzero_done:

        lea r10, [rip + _itw_row_scratch];
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0], rax;                // header: in_use = 1
        mov rax, 42;
        mov [r10 + 8], rax;                // inode_no = 42
        mov rax, 1;
        mov [r10 + 40], rax;               // refcount = 1

        // -----------------------------------------------------------
        // (10) inode_write(175, 42, &_itw_row_scratch) == 0.
        // -----------------------------------------------------------
        mov rax, 10;
        lea rcx, [rip + _itw_stage];
        mov [rcx], rax;

        mov rdi, 175;
        mov rsi, 42;
        lea rdx, [rip + _itw_row_scratch];
        call inode_write;
        cmp rax, 0;
        jne itw_fail_stage;

        // -----------------------------------------------------------
        // (11) inode_read(175, 42) -- identical non-error check, then
        // inode_no/in_use round-trip.
        // -----------------------------------------------------------
        mov rax, 11;
        lea rcx, [rip + _itw_stage];
        mov [rcx], rax;

        mov rdi, 175;
        mov rsi, 42;
        call inode_read;
        mov r10, 0xFFFFED18;               // bit 31/63 set: stage via reg, no bare imm cmp
        cmp rax, r10;
        je itw_fail_stage;
        mov r10, 0xFFFFED19;
        cmp rax, r10;
        je itw_fail_stage;
        mov r10, 0xFFFFED11;
        cmp rax, r10;
        je itw_fail_stage;

        mov rcx, [rax + 8];
        cmp rcx, 42;
        jne itw_fail_stage;

        mov rdx, [rax + 0];
        shr rdx, 56;
        and rdx, 0xFF;
        cmp rdx, 1;
        jne itw_fail_stage;

        // -----------------------------------------------------------
        // (12) All checks passed.
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + itw_ok];
        call klog_s1;

        call itw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp itw_out;

      itw_fail_stage:
        lea rax, [rip + _itw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + itw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call itw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        mov rax, 1;

      itw_out:
        pop rbx;
        ret
      }
    }
}
