// tests/kernel/fs/pdxfs/concurrent_stress_synth.pdx -- R42.M5-003 (#1398)
//
// STRESS WITNESS: 100 concurrent write handles, mixed sizes.
//
// =============================================================================
// §0  WHAT THIS WITNESS ASSERTS AND WHAT IT DOES NOT
// =============================================================================
//
// The witness simulates 100 concurrent write handles across the R42
// PdxFS stack (refcount + wal + nvme_write) and asserts three
// invariants the sibling primitives are supposed to preserve under
// load:
//
//   (I1) REFCOUNT-BOUNDED. The sum of pxrc_inc_count and
//        pxrc_dec_count stays within the announced ceilings; no
//        overflow / underflow latch fires under the mixed workload.
//
//   (I2) WAL-REPLAYABLE. Every wal_append that succeeded, and only
//        those, is present in the ring: iterating [0..wal_head) and
//        summing wal_size_at gives the total bytes appended, which
//        equals the sum of sizes the driver posted. A "committed
//        write missing from replay" would show up as a mismatch.
//
//   (I3) NVMe-COMPLETIONS-MATCH-SUBMITS. Every submit that flushed is
//        acknowledged exactly once; completion_count equals the sum of
//        flushed_total. A duplicate ack (ALREADY_DONE) or a missing
//        ack (submit_count - completion_count > 0 at the end of the
//        run) fails the witness at the corresponding stage number.
//
// The "concurrency" is simulated by INTERLEAVING the three primitives'
// atomics in the loop -- pxrc_inc + wal_append + nvw_submit each
// happen once per handle before any nvw_batch_flush runs, then
// nvw_batch_flush + nvw_completion drain them in the reverse order.
// Real preemptive concurrency awaits the R43 supervisor + SMP
// scheduler; the interleaved atomic sequence is what a threaded
// caller would exercise across a slice of quanta.
//
// This witness ASSERTS NOTHING ABOUT AN ACTUAL DISK. Every primitive
// is a scaffold whose widening lands on real hardware; the witness
// asserts the SCAFFOLD'S accounting is monotone and consistent under
// the mixed workload.
//
// Fingerprint: R42 PDXFS CONCURRENT STRESS OK
// Failure fingerprint: R42 PDXFS CONCURRENT STRESS FAIL + stage number.
//
// Failure band: 0xFFFFEEE0..EF (test-side, prefix `cws_`).
// Adjacent used band above: durability 0xFFFFEEF0..FF (R42.M5-002).

module ConcurrentStressSynth = structure {

  pub let mut _cwsw_stage : u64 = 0

  pub let cwsw_ok   : [u8; 33] = "R42 PDXFS CONCURRENT STRESS OK\n\0"
  pub let cwsw_fail : [u8; 35] = "R42 PDXFS CONCURRENT STRESS FAIL\n\0"

  // ==========================================================================
  // The workload uses 3 blocks (0, 1, 2) round-robin per handle, mixed
  // sizes { 0x100, 0x200, 0x400, 0x800 } cycled by (i & 3). All
  // three primitives have small scaffold capacities:
  //   PXRC_DEVICE_BLOCKS = 4096 (headroom)
  //   WAL_MAX_RECORDS    = 64  (drain-and-refill required for 100)
  //   NVW_SQ_DEPTH       = 64  (drain-and-refill required for 100)
  //
  // The witness therefore runs 100 handles as TWO batches of 50, each
  // batch drains WAL + NVMe before the next batch starts. This models
  // exactly what the R43 supervisor will do under back-pressure: fill
  // the queues, drain them, refill.
  // ==========================================================================

  pub let concurrent_stress_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M5-003 (#1398): concurrent-write stress witness. Runs two 50-handle batches through pxrc_inc / wal_append / nvw_submit; each batch drains via wal_fsync + wal_block_write and nvw_batch_flush + nvw_completion before the next batch starts. Invariants I1 (refcount bounded), I2 (wal replay reproduces every committed write), I3 (every submit acknowledged exactly once) are checked at stage boundaries; a mismatch at any stage jumps to fail with the stage number in the failure fingerprint. Five-push callee-save discipline. Labels prefixed cwsw_. Failure band 0xFFFFEEE0..EF is TEST-ONLY and not read by production code.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- S1. Reset all three modules.
        mov rax, 1;
        lea rcx, [rip + _cwsw_stage];
        mov [rcx], rax;

        call pxrc_reset;
        call wal_reset;
        call nvw_reset;

        call pxrc_bound;
        cmp rax, 1;
        jne cwsw_fail_stage;
        call wal_bound;
        cmp rax, 1;
        jne cwsw_fail_stage;
        call nvw_bound;
        cmp rax, 1;
        jne cwsw_fail_stage;

        // -- S2. First batch: 50 handles.
        mov rax, 2;
        lea rcx, [rip + _cwsw_stage];
        mov [rcx], rax;

        xor rbx, rbx;                           // i = 0
      cwsw_b1_top:
        cmp rbx, 50;
        jae cwsw_b1_done;

        // Refcount inc on block (i % 3).
        mov rax, rbx;
        xor rdx, rdx;
        mov r11, 3;
        div r11;                                // rdx = i % 3
        mov rdi, rdx;
        call pxrc_inc;
        cmp rax, 0;
        je  cwsw_fail_stage;                    // OK == new count > 0

        // WAL append (size = 0x100 << (i & 3), prev_seq = i).
        mov r12, rbx;
        and r12, 3;
        mov r13, 0x100;
        mov rcx, r12;
        shl r13, cl;                            // size = 0x100 << (i&3)
        mov rdi, r13;
        mov rsi, rbx;                           // prev_seq
        call wal_append;
        cmp rax, 0;
        je  cwsw_fail_stage;                    // 0 == refused (fail this stage)

        // NVMe submit (lba = 0x100000 + i, len = size).
        mov rdi, rbx;
        add rdi, 0x100000;
        mov rsi, r13;
        call nvw_submit;
        cmp rax, 0;
        je  cwsw_fail_stage;

        add rbx, 1;
        jmp cwsw_b1_top;

      cwsw_b1_done:
        // Post-conditions after 50 handles.
        call wal_head;
        cmp rax, 50;
        jne cwsw_fail_stage;
        call nvw_batch_head;
        cmp rax, 50;
        jne cwsw_fail_stage;
        // pxrc: 50 inc calls, no dec, no overflow, no underflow.
        call pxrc_inc_count;
        cmp rax, 50;
        jne cwsw_fail_stage;
        call pxrc_overflow_count;
        cmp rax, 0;
        jne cwsw_fail_stage;
        call pxrc_underflow_count;
        cmp rax, 0;
        jne cwsw_fail_stage;

        // -- S3. Drain the WAL (fsync + block_write each record).
        mov rax, 3;
        lea rcx, [rip + _cwsw_stage];
        mov [rcx], rax;

        call wal_fsync;
        cmp rax, 50;
        jne cwsw_fail_stage;

        // block_write each idx 0..49.
        xor rbx, rbx;
      cwsw_bw1_top:
        cmp rbx, 50;
        jae cwsw_bw1_done;
        mov rdi, rbx;
        call wal_block_write;
        cmp rax, 1;
        jne cwsw_fail_stage;
        add rbx, 1;
        jmp cwsw_bw1_top;
      cwsw_bw1_done:
        call wal_block_write_count;
        cmp rax, 50;
        jne cwsw_fail_stage;

        // I2 check: wal replay -- sum size across [0..head) equals the
        // sum posted. Sum(0x100 << (i&3), i=0..49) = 12 batches of 4
        // consecutive sizes + first two: (0x100+0x200+0x400+0x800)*12
        // = 0xF00 * 12 = 0xB400, plus 0x100 + 0x200 = 0x300, total
        // 0xB700.
        xor rbx, rbx;                           // i = 0
        xor r14, r14;                           // accum
      cwsw_wr_top:
        cmp rbx, 50;
        jae cwsw_wr_done;
        mov rdi, rbx;
        call wal_size_at;
        add r14, rax;
        add rbx, 1;
        jmp cwsw_wr_top;
      cwsw_wr_done:
        mov r11, 0xB700;
        cmp r14, r11;
        jne cwsw_fail_stage;

        // -- S4. Drain NVMe (flush + complete each cid 1..50).
        mov rax, 4;
        lea rcx, [rip + _cwsw_stage];
        mov [rcx], rax;

        call nvw_batch_flush;
        cmp rax, 50;
        jne cwsw_fail_stage;

        mov rbx, 1;
      cwsw_co1_top:
        cmp rbx, 51;                            // cids 1..50 inclusive
        jae cwsw_co1_done;
        mov rdi, rbx;
        call nvw_completion;
        cmp rax, 1;
        jne cwsw_fail_stage;
        add rbx, 1;
        jmp cwsw_co1_top;
      cwsw_co1_done:
        call nvw_completion_count;
        cmp rax, 50;
        jne cwsw_fail_stage;
        // I3 partial: submit_count == completion_count.
        call nvw_submit_count;
        cmp rax, 50;
        jne cwsw_fail_stage;

        // -- S5. Second batch: reset WAL + NVMe (both have finite
        // ring / SQ depth), keep refcount table cumulative (a real
        // supervisor would run pxrc against a live volume across
        // batches).
        mov rax, 5;
        lea rcx, [rip + _cwsw_stage];
        mov [rcx], rax;

        call wal_reset;
        call nvw_reset;

        xor rbx, rbx;                           // i = 0
      cwsw_b2_top:
        cmp rbx, 50;
        jae cwsw_b2_done;

        mov rax, rbx;
        xor rdx, rdx;
        mov r11, 3;
        div r11;                                // rdx = i % 3
        mov rdi, rdx;
        call pxrc_inc;
        cmp rax, 0;
        je  cwsw_fail_stage;

        // Size = 0x080 << (i & 3) (different mixed sizes this batch).
        mov r12, rbx;
        and r12, 3;
        mov r13, 0x080;
        mov rcx, r12;
        shl r13, cl;
        mov rdi, r13;
        mov rsi, rbx;
        call wal_append;
        cmp rax, 0;
        je  cwsw_fail_stage;

        mov rdi, rbx;
        add rdi, 0x200000;
        mov rsi, r13;
        call nvw_submit;
        cmp rax, 0;
        je  cwsw_fail_stage;

        add rbx, 1;
        jmp cwsw_b2_top;

      cwsw_b2_done:
        // After batch-2 the refcount cumulative should be 100 inc
        // total, still no overflow / underflow.
        call pxrc_inc_count;
        cmp rax, 100;
        jne cwsw_fail_stage;
        call pxrc_overflow_count;
        cmp rax, 0;
        jne cwsw_fail_stage;
        call pxrc_underflow_count;
        cmp rax, 0;
        jne cwsw_fail_stage;

        // Individual block totals: each batch of 50 restarts i at 0,
        // so (i % 3) over i in [0, 50) hits block 0 seventeen times
        // (i in {0, 3, ..., 48}), block 1 seventeen times (i in
        // {1, 4, ..., 49}), and block 2 sixteen times (i in
        // {2, 5, ..., 47}).  Two identical batches accumulate to
        // (34, 34, 32), not the (34, 33, 33) a single 100-iteration
        // loop would give.  pxrc_get is the readback.
        mov rdi, 0; call pxrc_get; cmp rax, 34; jne cwsw_fail_stage;
        mov rdi, 1; call pxrc_get; cmp rax, 34; jne cwsw_fail_stage;
        mov rdi, 2; call pxrc_get; cmp rax, 32; jne cwsw_fail_stage;

        // -- S6. Drain batch 2 (WAL then NVMe).
        mov rax, 6;
        lea rcx, [rip + _cwsw_stage];
        mov [rcx], rax;

        call wal_fsync;
        cmp rax, 50;
        jne cwsw_fail_stage;

        xor rbx, rbx;
      cwsw_bw2_top:
        cmp rbx, 50;
        jae cwsw_bw2_done;
        mov rdi, rbx;
        call wal_block_write;
        cmp rax, 1;
        jne cwsw_fail_stage;
        add rbx, 1;
        jmp cwsw_bw2_top;
      cwsw_bw2_done:

        // I2 again: sum(0x080 << (i&3), i=0..49) = (0x080+0x100+
        // 0x200+0x400)*12 + 0x080 + 0x100 = 0x780*12 + 0x180 =
        // 0x5A00 + 0x180 = 0x5B80.
        xor rbx, rbx;
        xor r14, r14;
      cwsw_wr2_top:
        cmp rbx, 50;
        jae cwsw_wr2_done;
        mov rdi, rbx;
        call wal_size_at;
        add r14, rax;
        add rbx, 1;
        jmp cwsw_wr2_top;
      cwsw_wr2_done:
        mov r11, 0x5B80;
        cmp r14, r11;
        jne cwsw_fail_stage;

        call nvw_batch_flush;
        cmp rax, 50;
        jne cwsw_fail_stage;

        mov rbx, 1;
      cwsw_co2_top:
        cmp rbx, 51;
        jae cwsw_co2_done;
        mov rdi, rbx;
        call nvw_completion;
        cmp rax, 1;
        jne cwsw_fail_stage;
        add rbx, 1;
        jmp cwsw_co2_top;
      cwsw_co2_done:
        call nvw_completion_count;
        cmp rax, 50;
        jne cwsw_fail_stage;
        call nvw_submit_count;
        cmp rax, 50;
        jne cwsw_fail_stage;

        // Final invariant sweep: no error latch on any module.
        call pxrc_err;
        cmp rax, 0;
        jne cwsw_fail_stage;
        call wal_err;
        cmp rax, 0;
        jne cwsw_fail_stage;
        call nvw_err;
        cmp rax, 0;
        jne cwsw_fail_stage;

        // Return the modules to a clean state so downstream witnesses
        // are not perturbed.
        call pxrc_reset;
        call wal_reset;
        call nvw_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cwsw_ok];
        call klog_s1;

        xor rax, rax;
        jmp cwsw_out;

      cwsw_fail_stage:
        lea rax, [rip + _cwsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cwsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      cwsw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
