// tests/kernel/fs/pdxfs/snap_diff_synth.pdx -- R42.M3-003 (#1390)
//
// Boot witness for the PDXFS-v1 snapshot diff module. Exercises
// reset (blocks + result cleared, counters 0), bad-snap refusal
// (seed / block_at with snap_id 4), bad-block refusal (seed with
// block_idx 32), bad-cursor refusal (diff with cursor 33), a small
// synthetic scenario with 4 distinct block changes (1 added, 1
// removed, 1 modified, 1 identical -> not emitted), result readback
// (block_idx + kind at each entry), diff_count + next_cursor
// bookkeeping, bad-idx refusal on result_block_at at entry >=
// result_count, and a two-batch cursor walk when result_max is
// forcibly exceeded by rewriting result_count to 1 boundary. Since
// SND_RESULT_MAX = 256 is larger than SND_BLOCKS_PER_SNAP = 32, the
// scaffold cannot naturally saturate the result table; the witness
// verifies the completion case (next_cursor == 32) instead of the
// overflow case, and pins the cursor-resume semantics by running a
// second diff at cursor == 32 that reports 0.
//
// Fingerprint: R42 PDXFS SNAP DIFF OK
// Failure fingerprint: R42 PDXFS SNAP DIFF FAIL + stage number.

module SnapDiffSynth = structure {

  pub let mut _sndw_stage : u64 = 0

  pub let sndw_ok   : [u8; 25] = "R42 PDXFS SNAP DIFF OK\n\0"
  pub let sndw_fail : [u8; 27] = "R42 PDXFS SNAP DIFF FAIL\n\0"

  pub let snap_diff_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M3-003 (#1390): boot witness for pdxfs snap_diff. Five-push callee-save discipline. Labels prefixed sndw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _sndw_stage];
        mov [rcx], rax;

        call snd_reset;
        call snd_bound;
        cmp rax, 1;
        jne sndw_fail_stage;
        call snd_err;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_capacity_snaps;
        cmp rax, 4;
        jne sndw_fail_stage;
        call snd_capacity_blocks;
        cmp rax, 32;
        jne sndw_fail_stage;
        call snd_result_max;
        cmp rax, 256;
        jne sndw_fail_stage;
        call snd_result_count;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_diff_count;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_next_cursor;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_seed_count;
        cmp rax, 0;
        jne sndw_fail_stage;

        mov rdi, 0;
        mov rsi, 0;
        call snd_block_at;
        cmp rax, 0;
        jne sndw_fail_stage;
        mov rdi, 3;
        mov rsi, 31;
        call snd_block_at;
        cmp rax, 0;
        jne sndw_fail_stage;

        // -- 2. Bad-snap refusal on block_at with snap_id 4.
        mov rax, 2;
        lea rcx, [rip + _sndw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 0;
        call snd_block_at;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_err;
        mov r11, 0xFFFFEF6E;                    // SND_ERR_BAD_SNAP
        cmp rax, r11;
        jne sndw_fail_stage;

        // Bad-snap refusal on seed as well.
        call snd_reset;
        mov rdi, 4;
        mov rsi, 0;
        mov rdx, 0xABCD;
        call snd_seed;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_err;
        mov r11, 0xFFFFEF6E;
        cmp rax, r11;
        jne sndw_fail_stage;

        call snd_reset;

        // -- 3. Bad-block refusal on seed with block_idx 32.
        mov rax, 3;
        lea rcx, [rip + _sndw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 32;
        mov rdx, 0xABCD;
        call snd_seed;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_err;
        mov r11, 0xFFFFEF6B;                    // SND_ERR_BAD_BLOCK
        cmp rax, r11;
        jne sndw_fail_stage;

        call snd_reset;

        // -- 4. Bad-cursor refusal on diff with cursor > 32.
        mov rax, 4;
        lea rcx, [rip + _sndw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 33;
        call snd_diff;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_err;
        mov r11, 0xFFFFEF6D;                    // SND_ERR_BAD_CURSOR
        cmp rax, r11;
        jne sndw_fail_stage;

        call snd_reset;

        // -- 5. Bad-snap refusal on diff with snap_a 4.
        mov rax, 5;
        lea rcx, [rip + _sndw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 0;
        mov rdx, 0;
        call snd_diff;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_err;
        mov r11, 0xFFFFEF6E;
        cmp rax, r11;
        jne sndw_fail_stage;

        call snd_reset;

        // -- 6. Bad-idx refusal on result_block_at with empty result.
        mov rax, 6;
        lea rcx, [rip + _sndw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call snd_result_block_at;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_err;
        mov r11, 0xFFFFEF6C;                    // SND_ERR_BAD_IDX
        cmp rax, r11;
        jne sndw_fail_stage;

        call snd_reset;

        // -- 7. Synthetic diff scenario. snap 0 vs snap 1.
        //         block 0: a=0xAA b=0xAA   identical, not emitted
        //         block 1: a=0    b=0xBB   ADDED
        //         block 2: a=0xCC b=0      REMOVED
        //         block 3: a=0xDD b=0xEE   MODIFIED
        // Expected result_count == 3, entries in block-index order:
        //   entry[0] = (1, ADDED)
        //   entry[1] = (2, REMOVED)
        //   entry[2] = (3, MODIFIED)
        mov rax, 7;
        lea rcx, [rip + _sndw_stage];
        mov [rcx], rax;

        // Seed snap 0.
        mov rdi, 0; mov rsi, 0; mov rdx, 0xAA; call snd_seed;
        cmp rax, 1; jne sndw_fail_stage;
        mov rdi, 0; mov rsi, 2; mov rdx, 0xCC; call snd_seed;
        cmp rax, 1; jne sndw_fail_stage;
        mov rdi, 0; mov rsi, 3; mov rdx, 0xDD; call snd_seed;
        cmp rax, 1; jne sndw_fail_stage;

        // Seed snap 1.
        mov rdi, 1; mov rsi, 0; mov rdx, 0xAA; call snd_seed;
        cmp rax, 1; jne sndw_fail_stage;
        mov rdi, 1; mov rsi, 1; mov rdx, 0xBB; call snd_seed;
        cmp rax, 1; jne sndw_fail_stage;
        mov rdi, 1; mov rsi, 3; mov rdx, 0xEE; call snd_seed;
        cmp rax, 1; jne sndw_fail_stage;

        call snd_seed_count;
        cmp rax, 6;
        jne sndw_fail_stage;

        // Diff.
        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 0;
        call snd_diff;
        cmp rax, 3;
        jne sndw_fail_stage;
        call snd_result_count;
        cmp rax, 3;
        jne sndw_fail_stage;
        call snd_next_cursor;
        cmp rax, 32;                            // scan finished
        jne sndw_fail_stage;
        call snd_diff_count;
        cmp rax, 1;
        jne sndw_fail_stage;

        // Entry[0] = (block=1, kind=ADDED)
        mov rdi, 0;
        call snd_result_block_at;
        cmp rax, 1;
        jne sndw_fail_stage;
        mov rdi, 0;
        call snd_result_kind_at;
        cmp rax, 1;                             // SND_KIND_ADDED
        jne sndw_fail_stage;

        // Entry[1] = (block=2, kind=REMOVED)
        mov rdi, 1;
        call snd_result_block_at;
        cmp rax, 2;
        jne sndw_fail_stage;
        mov rdi, 1;
        call snd_result_kind_at;
        cmp rax, 2;                             // SND_KIND_REMOVED
        jne sndw_fail_stage;

        // Entry[2] = (block=3, kind=MODIFIED)
        mov rdi, 2;
        call snd_result_block_at;
        cmp rax, 3;
        jne sndw_fail_stage;
        mov rdi, 2;
        call snd_result_kind_at;
        cmp rax, 3;                             // SND_KIND_MODIFIED
        jne sndw_fail_stage;

        // Bad-idx: entry 3 refuses.
        mov rdi, 3;
        call snd_result_block_at;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_err;
        mov r11, 0xFFFFEF6C;
        cmp rax, r11;
        jne sndw_fail_stage;

        // -- 8. Cursor-resume semantics. Diff with cursor == 32 reports 0.
        mov rax, 8;
        lea rcx, [rip + _sndw_stage];
        mov [rcx], rax;

        call snd_reset;
        // Re-seed snap 0 with 1 present block; snap 1 empty. Diff must
        // find 1 removed at block 0, then a resume at cursor 32
        // reports 0.
        mov rdi, 0; mov rsi, 0; mov rdx, 0x11; call snd_seed;
        cmp rax, 1; jne sndw_fail_stage;

        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 0;
        call snd_diff;
        cmp rax, 1;
        jne sndw_fail_stage;
        call snd_next_cursor;
        cmp rax, 32;
        jne sndw_fail_stage;

        // Resume at cursor 32 (== capacity): scans nothing, result_count 0.
        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 32;
        call snd_diff;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_result_count;
        cmp rax, 0;
        jne sndw_fail_stage;
        call snd_next_cursor;
        cmp rax, 32;
        jne sndw_fail_stage;
        call snd_diff_count;
        cmp rax, 2;
        jne sndw_fail_stage;

        // Return module to a clean state.
        call snd_reset;
        call snd_bound;
        cmp rax, 1;
        jne sndw_fail_stage;
        call snd_err;
        cmp rax, 0;
        jne sndw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sndw_ok];
        call klog_s1;

        xor rax, rax;
        jmp sndw_out;

      sndw_fail_stage:
        lea rax, [rip + _sndw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sndw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      sndw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
