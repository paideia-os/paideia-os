// tests/kernel/fs/pdxfs/snap_prune_synth.pdx -- R42.M3-004 (#1391)
//
// Boot witness for the PDXFS-v1 snapshot prune module. Exercises
// reset (ts + state cleared, policy NONE), bad-idx refusal (ts_at
// 16), bad-policy refusal (set_policy kind 4), bad-N refusal
// (set_policy n 17), policy-unset refusal (prune before set_policy),
// set_policy readback, LAST N (keep 2 newest of 4), DAILY N (keep 2
// newest of the 3 with ts&1==0), WEEKLY N (keep 1 of the 2 with
// ts&7==0), refdec accounting (per delete: SNP_EXCLUSIVE_BLOCKS == 4),
// live_count recompute, and last_prune_deleted vs deleted_total.
//
// Fingerprint: PDXFS SNAP PRUNE OK
// Failure fingerprint: PDXFS SNAP PRUNE FAIL + stage number.

module SnapPruneSynth = structure {

  pub let mut _snpw_stage : u64 = 0

  pub let snpw_ok : [u8; 22] = "PDXFS SNAP PRUNE OK\0"
  pub let snpw_fail : [u8; 24] = "PDXFS SNAP PRUNE FAIL\0"

  pub let snap_prune_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M3-004 (#1391): boot witness for pdxfs snap_prune. Five-push callee-save discipline. Labels prefixed snpw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _snpw_stage];
        mov [rcx], rax;

        call snp_reset;
        call snp_bound;
        cmp rax, 1;
        jne snpw_fail_stage;
        call snp_err;
        cmp rax, 0;
        jne snpw_fail_stage;
        call snp_capacity;
        cmp rax, 16;
        jne snpw_fail_stage;
        call snp_exclusive_blocks;
        cmp rax, 4;
        jne snpw_fail_stage;
        call snp_policy_kind;
        cmp rax, 0;
        jne snpw_fail_stage;
        call snp_policy_n;
        cmp rax, 0;
        jne snpw_fail_stage;
        call snp_deleted_total;
        cmp rax, 0;
        jne snpw_fail_stage;
        call snp_refdec_total;
        cmp rax, 0;
        jne snpw_fail_stage;
        call snp_live_count;
        cmp rax, 0;
        jne snpw_fail_stage;
        call snp_last_prune_deleted;
        cmp rax, 0;
        jne snpw_fail_stage;

        // Every ts slot reads back 0.
        mov rdi, 0;
        call snp_ts_at;
        cmp rax, 0;
        jne snpw_fail_stage;
        mov rdi, 15;
        call snp_ts_at;
        cmp rax, 0;
        jne snpw_fail_stage;

        // -- 2. Bad-idx refusal on ts_at (16).
        mov rax, 2;
        lea rcx, [rip + _snpw_stage];
        mov [rcx], rax;

        mov rdi, 16;
        call snp_ts_at;
        cmp rax, 0;
        jne snpw_fail_stage;
        call snp_err;
        mov r11, 0xFFFFEF5C;                    // SNP_ERR_BAD_IDX
        cmp rax, r11;
        jne snpw_fail_stage;

        call snp_reset;

        // -- 3. Bad-idx refusal on seed (16).
        mov rax, 3;
        lea rcx, [rip + _snpw_stage];
        mov [rcx], rax;

        mov rdi, 16;
        mov rsi, 100;
        call snp_seed;
        cmp rax, 0;
        jne snpw_fail_stage;
        call snp_err;
        mov r11, 0xFFFFEF5C;
        cmp rax, r11;
        jne snpw_fail_stage;

        call snp_reset;

        // -- 4. Bad-policy refusal (kind 4).
        mov rax, 4;
        lea rcx, [rip + _snpw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 1;
        call snp_set_policy;
        cmp rax, 0;
        jne snpw_fail_stage;
        call snp_err;
        mov r11, 0xFFFFEF5E;                    // SNP_ERR_BAD_POLICY
        cmp rax, r11;
        jne snpw_fail_stage;

        call snp_reset;

        // -- 5. Bad-N refusal (n 17).
        mov rax, 5;
        lea rcx, [rip + _snpw_stage];
        mov [rcx], rax;

        mov rdi, 1;                             // LAST
        mov rsi, 17;
        call snp_set_policy;
        cmp rax, 0;
        jne snpw_fail_stage;
        call snp_err;
        mov r11, 0xFFFFEF5D;                    // SNP_ERR_BAD_N
        cmp rax, r11;
        jne snpw_fail_stage;

        call snp_reset;

        // -- 6. Policy-unset refusal (prune before set_policy).
        mov rax, 6;
        lea rcx, [rip + _snpw_stage];
        mov [rcx], rax;

        call snp_prune;
        cmp rax, 0;
        jne snpw_fail_stage;
        call snp_err;
        mov r11, 0xFFFFEF5B;                    // SNP_ERR_POLICY_UNSET
        cmp rax, r11;
        jne snpw_fail_stage;

        call snp_reset;

        // -- 7. LAST 2 out of 4. Seed ts values 10, 20, 30, 40 in
        //         slots 0..3. Every ts is even (& 1 == 0) so the LAST
        //         policy sees all four as candidates. Prune keeps
        //         slots with ts >= threshold. Threshold is the 2nd
        //         largest ts, which is 30. Kept: slots 2 (30) and 3
        //         (40). Deleted: slots 0 (10) and 1 (20). Deleted 2,
        //         refdec 8, live_count 2.
        mov rax, 7;
        lea rcx, [rip + _snpw_stage];
        mov [rcx], rax;

        mov rdi, 0; mov rsi, 10; call snp_seed;
        cmp rax, 1; jne snpw_fail_stage;
        mov rdi, 1; mov rsi, 20; call snp_seed;
        cmp rax, 1; jne snpw_fail_stage;
        mov rdi, 2; mov rsi, 30; call snp_seed;
        cmp rax, 1; jne snpw_fail_stage;
        mov rdi, 3; mov rsi, 40; call snp_seed;
        cmp rax, 1; jne snpw_fail_stage;

        mov rdi, 1;                             // LAST
        mov rsi, 2;
        call snp_set_policy;
        cmp rax, 1;
        jne snpw_fail_stage;
        call snp_policy_kind;
        cmp rax, 1;
        jne snpw_fail_stage;
        call snp_policy_n;
        cmp rax, 2;
        jne snpw_fail_stage;

        call snp_prune;
        cmp rax, 2;
        jne snpw_fail_stage;
        call snp_last_prune_deleted;
        cmp rax, 2;
        jne snpw_fail_stage;
        call snp_deleted_total;
        cmp rax, 2;
        jne snpw_fail_stage;
        call snp_refdec_total;
        cmp rax, 8;                             // 2 * SNP_EXCLUSIVE_BLOCKS
        jne snpw_fail_stage;
        call snp_live_count;
        cmp rax, 2;
        jne snpw_fail_stage;

        // Kept slots have ts intact.
        mov rdi, 0; call snp_ts_at;
        cmp rax, 0; jne snpw_fail_stage;        // deleted
        mov rdi, 1; call snp_ts_at;
        cmp rax, 0; jne snpw_fail_stage;        // deleted
        mov rdi, 2; call snp_ts_at;
        cmp rax, 30; jne snpw_fail_stage;
        mov rdi, 3; call snp_ts_at;
        cmp rax, 40; jne snpw_fail_stage;

        call snp_reset;

        // -- 8. DAILY 2. Seed ts=10 (odd? 10 & 1 = 0, DAILY),
        //         ts=15 (odd, NOT DAILY), ts=20 (DAILY),
        //         ts=30 (DAILY). DAILY 2 keeps the 2 newest ts with
        //         ts & 1 == 0: 20, 30. Slot with ts=15 is deleted
        //         (ineligible under DAILY). Slot with ts=10 is
        //         deleted (eligible but below threshold 20). Total 2
        //         deletes, refdec += 8.
        mov rax, 8;
        lea rcx, [rip + _snpw_stage];
        mov [rcx], rax;

        mov rdi, 0; mov rsi, 10; call snp_seed;
        mov rdi, 1; mov rsi, 15; call snp_seed;
        mov rdi, 2; mov rsi, 20; call snp_seed;
        mov rdi, 3; mov rsi, 30; call snp_seed;

        mov rdi, 2;                             // DAILY
        mov rsi, 2;
        call snp_set_policy;
        cmp rax, 1;
        jne snpw_fail_stage;

        call snp_prune;
        cmp rax, 2;
        jne snpw_fail_stage;
        call snp_last_prune_deleted;
        cmp rax, 2;
        jne snpw_fail_stage;
        call snp_live_count;
        cmp rax, 2;
        jne snpw_fail_stage;

        // ts 15 (ineligible) and ts 10 (below threshold) deleted.
        mov rdi, 0; call snp_ts_at;
        cmp rax, 0; jne snpw_fail_stage;
        mov rdi, 1; call snp_ts_at;
        cmp rax, 0; jne snpw_fail_stage;
        mov rdi, 2; call snp_ts_at;
        cmp rax, 20; jne snpw_fail_stage;
        mov rdi, 3; call snp_ts_at;
        cmp rax, 30; jne snpw_fail_stage;

        call snp_reset;

        // -- 9. WEEKLY 1. Seed ts=8 (WEEKLY), ts=16 (WEEKLY),
        //         ts=17 (ineligible), ts=24 (WEEKLY). WEEKLY 1 keeps
        //         the single newest ts with ts & 7 == 0: 24. Deletes
        //         3.
        mov rax, 9;
        lea rcx, [rip + _snpw_stage];
        mov [rcx], rax;

        mov rdi, 0; mov rsi, 8;  call snp_seed;
        mov rdi, 1; mov rsi, 16; call snp_seed;
        mov rdi, 2; mov rsi, 17; call snp_seed;
        mov rdi, 3; mov rsi, 24; call snp_seed;

        mov rdi, 3;                             // WEEKLY
        mov rsi, 1;
        call snp_set_policy;
        cmp rax, 1;
        jne snpw_fail_stage;

        call snp_prune;
        cmp rax, 3;
        jne snpw_fail_stage;
        call snp_last_prune_deleted;
        cmp rax, 3;
        jne snpw_fail_stage;
        call snp_live_count;
        cmp rax, 1;
        jne snpw_fail_stage;

        mov rdi, 3; call snp_ts_at;
        cmp rax, 24; jne snpw_fail_stage;
        mov rdi, 0; call snp_ts_at;
        cmp rax, 0; jne snpw_fail_stage;
        mov rdi, 1; call snp_ts_at;
        cmp rax, 0; jne snpw_fail_stage;
        mov rdi, 2; call snp_ts_at;
        cmp rax, 0; jne snpw_fail_stage;

        // Return module to a clean state.
        call snp_reset;
        call snp_bound;
        cmp rax, 1;
        jne snpw_fail_stage;
        call snp_err;
        cmp rax, 0;
        jne snpw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + snpw_ok];
        call klog_s1;

        xor rax, rax;
        jmp snpw_out;

      snpw_fail_stage:
        lea rax, [rip + _snpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + snpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      snpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
