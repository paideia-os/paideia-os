// tests/kernel/fs/pdxfs/refcount_synth.pdx -- R42.M1-001 (#1380)
//
// Boot witness for the PDXFS-v1 per-block reference count table.
// Exercises reset (all cells 0, all counters 0), bad-blk refusal,
// underflow refusal, inc/dec bookkeeping, overflow saturation at
// PXRC_COUNT_MAX, and pxrc_zero_count / pxrc_release_zero_blocks
// tallies.
//
// Fingerprint: PDXFS REFCOUNT OK
// Failure fingerprint: PDXFS REFCOUNT FAIL + stage number.

module RefcountSynth = structure {

  pub let mut _pxrcw_stage : u64 = 0

  pub let pxrcw_ok : [u8; 20] = "PDXFS REFCOUNT OK\0"
  pub let pxrcw_fail : [u8; 22] = "PDXFS REFCOUNT FAIL\0"

  pub let refcount_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M1-001 (#1380): boot witness for pdxfs refcount table. Five-push callee-save discipline. Labels prefixed pxrcw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _pxrcw_stage];
        mov [rcx], rax;

        call pxrc_reset;
        call pxrc_bound;
        cmp rax, 1;
        jne pxrcw_fail_stage;
        call pxrc_err;
        cmp rax, 0;
        jne pxrcw_fail_stage;
        call pxrc_inc_count;
        cmp rax, 0;
        jne pxrcw_fail_stage;
        call pxrc_dec_count;
        cmp rax, 0;
        jne pxrcw_fail_stage;
        call pxrc_overflow_count;
        cmp rax, 0;
        jne pxrcw_fail_stage;
        call pxrc_underflow_count;
        cmp rax, 0;
        jne pxrcw_fail_stage;
        call pxrc_capacity;
        mov r11, 4096;
        cmp rax, r11;
        jne pxrcw_fail_stage;

        // Every cell reads back as 0.
        mov rdi, 0;
        call pxrc_get;
        cmp rax, 0;
        jne pxrcw_fail_stage;
        mov rdi, 4095;
        call pxrc_get;
        cmp rax, 0;
        jne pxrcw_fail_stage;

        // -- 2. Bad-blk refusal.
        mov rax, 2;
        lea rcx, [rip + _pxrcw_stage];
        mov [rcx], rax;

        mov rdi, 4096;
        call pxrc_get;
        cmp rax, 0;
        jne pxrcw_fail_stage;
        call pxrc_err;
        mov r11, 0xFFFFF00E;                    // PXRC_ERR_BAD_BLK
        cmp rax, r11;
        jne pxrcw_fail_stage;

        // -- 3. Underflow refusal (fresh reset).
        mov rax, 3;
        lea rcx, [rip + _pxrcw_stage];
        mov [rcx], rax;

        call pxrc_reset;
        mov rdi, 7;
        call pxrc_dec;
        cmp rax, 0;
        jne pxrcw_fail_stage;
        call pxrc_err;
        mov r11, 0xFFFFF00C;                    // PXRC_ERR_UNDERFLOW
        cmp rax, r11;
        jne pxrcw_fail_stage;
        call pxrc_underflow_count;
        cmp rax, 1;
        jne pxrcw_fail_stage;

        // -- 4. inc/dec bookkeeping.
        mov rax, 4;
        lea rcx, [rip + _pxrcw_stage];
        mov [rcx], rax;

        call pxrc_reset;

        mov rdi, 100;
        call pxrc_inc;
        cmp rax, 1;
        jne pxrcw_fail_stage;
        mov rdi, 100;
        call pxrc_inc;
        cmp rax, 2;
        jne pxrcw_fail_stage;
        mov rdi, 100;
        call pxrc_inc;
        cmp rax, 3;
        jne pxrcw_fail_stage;

        mov rdi, 100;
        call pxrc_get;
        cmp rax, 3;
        jne pxrcw_fail_stage;

        mov rdi, 100;
        call pxrc_dec;
        cmp rax, 2;
        jne pxrcw_fail_stage;
        mov rdi, 100;
        call pxrc_get;
        cmp rax, 2;
        jne pxrcw_fail_stage;

        call pxrc_inc_count;
        cmp rax, 3;
        jne pxrcw_fail_stage;
        call pxrc_dec_count;
        cmp rax, 1;
        jne pxrcw_fail_stage;

        // -- 5. Overflow saturation. Push cell 200 to PXRC_COUNT_MAX
        //        via 65535 inc calls, then one more inc: refused.
        mov rax, 5;
        lea rcx, [rip + _pxrcw_stage];
        mov [rcx], rax;

        call pxrc_reset;

        xor r12, r12;                           // iteration counter
      pxrcw_fill:
        mov rdi, 200;
        call pxrc_inc;
        cmp rax, 0;
        je  pxrcw_fail_stage;
        add r12, 1;
        mov r13, 0xFFFF;
        cmp r12, r13;
        jb  pxrcw_fill;

        // One more inc: overflow refusal.
        mov rdi, 200;
        call pxrc_inc;
        cmp rax, 0;
        jne pxrcw_fail_stage;
        call pxrc_err;
        mov r11, 0xFFFFF00D;                    // PXRC_ERR_OVERFLOW
        cmp rax, r11;
        jne pxrcw_fail_stage;
        call pxrc_overflow_count;
        cmp rax, 1;
        jne pxrcw_fail_stage;

        // Cell still reads PXRC_COUNT_MAX.
        mov rdi, 200;
        call pxrc_get;
        mov r11, 0xFFFF;
        cmp rax, r11;
        jne pxrcw_fail_stage;

        // -- 6. pxrc_zero_count on empty table = 4096.
        mov rax, 6;
        lea rcx, [rip + _pxrcw_stage];
        mov [rcx], rax;

        call pxrc_reset;
        call pxrc_zero_count;
        mov r11, 4096;
        cmp rax, r11;
        jne pxrcw_fail_stage;
        call pxrc_last_zero_scan;
        cmp rax, r11;
        jne pxrcw_fail_stage;

        // Bump three cells; zero_count = 4093.
        mov rdi, 10;
        call pxrc_inc;
        mov rdi, 20;
        call pxrc_inc;
        mov rdi, 30;
        call pxrc_inc;

        call pxrc_zero_count;
        mov r11, 4093;
        cmp rax, r11;
        jne pxrcw_fail_stage;

        // -- 7. release_zero_blocks delegates to zero_count.
        mov rax, 7;
        lea rcx, [rip + _pxrcw_stage];
        mov [rcx], rax;

        call pxrc_release_zero_blocks;
        mov r11, 4093;
        cmp rax, r11;
        jne pxrcw_fail_stage;

        // Return the module to a clean state.
        call pxrc_reset;
        call pxrc_bound;
        cmp rax, 1;
        jne pxrcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxrcw_ok];
        call klog_s1;

        xor rax, rax;
        jmp pxrcw_out;

      pxrcw_fail_stage:
        lea rax, [rip + _pxrcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxrcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pxrcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
