// tests/kernel/fs/pdxfs/mount_replay_witness_synth.pdx -- R52.M5-006 (#1708)
//
// Boot witness for the PDXFS-on-block v1 journal WAL + recovery-on-
// mount path: append 3 synthetic COMMITted transactions to a real
// on-disk journal ring (src/kernel/core/fs/pdxfs/journal_ondisk.pdx,
// #1704), replay them via the real `journal_replay` walker, advance
// the checkpoint past the replayed range, and toggle the superblock's
// clean-unmount flag. This CLOSES R52.M5.
//
// Design authority: design/filesystem/r52-implementation-plan.md §2.5
// step 6 (#1708: "Boot witness: mount root volume, replay 3 committed
// txns pre-planted in the QEMU image, verify checkpoint advances,
// verify clean-unmount flag toggles") and design/filesystem/
// volume-fs-substrate.md §4.3 ("Recovery on mount") steps 6-10.
//
// Fingerprint: "PDXFS BLOCK MOUNT WITNESS OK" (no round/milestone/
// issue prefix, per this codebase's established witness-fingerprint
// convention -- see e.g. tests/kernel/fs/pdxfs/inode_table_witness_
// synth.pdx / alloc_free_hint_witness_synth.pdx headers).
//
// -----------------------------------------------------------------------------
// Why this is a witness-local "mount", not a call into a real `mount`
// primitive
// -----------------------------------------------------------------------------
//
// #1707 (mount.pdx's MOUNT_BACKEND_PDXFS_BLOCK arm) is uncommitted /
// not landed in this tree as of this landing -- a concurrent, in-
// progress working-tree edit to mount.pdx/backend_registry.pdx was
// observed but deliberately left untouched and uncommitted by this
// change (not this issue's scope, and not safe to depend on mid-edit).
// #1705 (rewrite journal_replay.pdx to walk on-disk JBNL blocks) and
// #1706 (volume_registry.pdx + probe.pdx) landed CONCURRENTLY with
// this witness's own development (both are present as committed
// history by the time this file lands), but neither supplies a mount
// entry point: probe.pdx only registers volumes into volume_registry.
// pdx, it does not mount one, and #1705's own header confirms its new
// `jrp_ondisk_replay` is a pure thin wrapper forwarding verbatim to
// journal_ondisk.pdx's `journal_replay` ("both names resolve to the
// identical on-disk walk"). This witness therefore calls journal_
// ondisk.pdx's `journal_replay` directly (equally canonical per that
// same header note) and deliberately does not depend on probe.pdx,
// volume_registry.pdx, or mount.pdx at all -- there is still no `mount`
// primitive to call. This mirrors the exact gap tests/kernel/fs/pdxfs/
// mkfs_mount_refuse_witness_synth.pdx (#1690) already documented for
// its own milestone ("There is no R52 PdxFS `mount` primitive to call
// yet... This witness therefore implements the minimal... check
// itself"). What #1704 DID land is a REAL on-disk journal writer/
// walker pair living inside journal_ondisk.pdx itself (`journal_
// append` / `journal_replay`) -- see that module's own header: "adds a
// NEW on-disk walker named `journal_replay` inside THIS module, scoped
// to exactly what §4.3 describes: cold-boot head discovery, backward
// walk to checkpoint, forward CSUM-verified walk with per-record
// classification". This witness drives THAT real walker end to end
// against a real journal ring built by the real writer, and layers the
// two §4.3 steps no landed module yet performs (step 10: checkpoint
// advance + clean-unmount flag rewrite) directly, exactly as mkfs_
// mount_refuse_witness_synth.pdx's own precedent for "no primitive
// exists yet, implement the check here" already established for the
// mount-refusal half of this same milestone arc.
//
// -----------------------------------------------------------------------------
// Substrate-mode NVMe cap trick (same trick alloc_free_hint_witness_
// synth.pdx / inode_table_witness_synth.pdx already establish)
// -----------------------------------------------------------------------------
//
// Mints a real KIND_NVME_CONTROLLER + dual-kind KIND_NVME_NAMESPACE/
// KIND_BLKDEV row that never advances to a live SQ pair, so every
// READ_LBA/WRITE_LBA/FLUSH `journal_append`/`journal_replay` issues
// forwards NVMEIO_PICK_NONE (0xFFFFEC58) verbatim from `cap_invoke`.
// Unlike `inode_table.pdx`/`allocator.pdx`, `journal_ondisk.pdx`'s own
// `jnl_bdev_write_block`/`_read_block`/`_flush` originally compared
// `cap_invoke`'s raw result directly against 0 -- misclassifying
// NVMEIO_PICK_NONE as a hard failure and making `journal_append`/
// `journal_replay` unconditionally fail under this trick. Landing this
// witness required fixing that gap first (journal_ondisk.pdx, same
// file, three helpers routed through `BdevBarrier.bbjw_check` --
// see that file's header gap 9 for the full rationale); this witness
// depends on that fix.
//
// Because every WRITE_LBA/READ_LBA/FLUSH is now a `bbjw_check`-
// tolerated no-op (no real per-LBA persistence exists in this
// substrate -- see journal_ondisk.pdx's own gap 5 note on the single
// shared `_journal_stage_blk` staging buffer), this witness is
// deliberately built so every record it appends lands in exactly ONE
// journal block (9 records totalling 272 bytes, header included, well
// under the 4056-byte records-area ceiling -- `journal_append` never
// rolls to a second block). `journal_replay`'s cold-boot scan therefore
// finds `_journal_stage_blk` holding the byte-exact final state
// `journal_append`'s last call (txn 3's COMMIT) left it in -- the same
// buffer-continuity trick `inode_table.pdx`'s `itable_ensure_block_
// loaded` cache-hit path relies on for its own read-after-write proof,
// generalised here to "read-without-a-real-device returns whatever the
// last write left behind, and nothing else in this witness's run ever
// touches that buffer in between". `journal_bcount=4` (not 1) is
// chosen so `journal_advance_ring` can move the checkpoint to a
// genuinely different LBA (journal_lba+1) after replay -- a ring of
// capacity 1 would wrap the checkpoint straight back to journal_lba,
// which would prove nothing about "advance".
//
// -----------------------------------------------------------------------------
// What this witness proves
// -----------------------------------------------------------------------------
//
// (1) A synthetic superblock fixture's flags field reads back exactly
//     0x2 (PDXB_SB_FLAG_ROOT_VOLUME set, PDXB_SB_FLAG_CLEAN_UNMOUNT
//     CLEAR) via the real `sb_flags` accessor -- the "prior session did
//     not unmount cleanly" precondition that motivates a mount-time
//     replay in the first place.
// (2) Three transactions (txn_id 1/2/3), each BEGIN + one write-class
//     JOP_BITMAP_SET record + COMMIT, are built via the real
//     `journal_encode_begin` / `journal_encode_bitmap_set` /
//     `journal_encode_commit` encoders and durably appended via the
//     real `journal_append` writer -- 9 `journal_append` calls, each
//     returning exactly 0 (JNL_OK).
// (3) `journal_checkpoint_lba(vol_slot)` (new getter, #1708, added to
//     journal_ondisk.pdx as the read-back counterpart to the existing
//     `journal_writer_set_checkpoint` setter) reads back exactly
//     `journal_lba` (200) BEFORE replay -- the writer's own first-touch
//     seed, proven concretely rather than assumed.
// (4) `journal_replay(bdev_cap, vol_slot, journal_lba, journal_bcount,
//     checkpoint_lba=journal_lba)` -- the real §4.3 cold-boot walker --
//     returns EXACTLY 3 (`applied_total`, one write-class record per
//     committed txn), and `journal_replay_discarded_count()` /
//     `_orphan_count()` both read back exactly 0 -- all 3 txns
//     committed cleanly, nothing left dangling. `journal_replay_head_
//     lba()` reads back exactly `journal_lba` (the one block written).
// (5) `journal_advance_ring(head_lba, journal_lba, journal_bcount)`
//     computes `journal_lba+1` (201) -- the block after the last
//     replayed COMMIT, per §4.3 step 10 -- and `journal_writer_set_
//     checkpoint(vol_slot, 201)` followed by `journal_checkpoint_lba`
//     reads back exactly 201: the checkpoint pointer genuinely
//     ADVANCED (201 != the step-3 baseline of 200), not merely
//     "some value".
// (6) The synthetic superblock's flags field is rewritten with the
//     clean-unmount bit set (§4.3 step 10's "rewrite the superblock's
//     flags with the clean-unmount bit set", performed as a direct
//     field toggle since no mount.pdx exists yet to drive a real
//     sb_write round trip -- same "poke the fixture directly" posture
//     mkfs_probe_witness_synth.pdx's / inode_table_witness_synth.pdx's
//     own synthetic-superblock precedent already establishes), and
//     `sb_flags` reads back exactly 0x3 (both PDXB_SB_FLAG_ROOT_VOLUME
//     and PDXB_SB_FLAG_CLEAN_UNMOUNT now set) -- the flag genuinely
//     TOGGLED, matching the exact post-mkfs constant mkfs.pdx's own
//     `mkfs_sb_populate` header documents
//     (PDXB_SB_FLAG_CLEAN_UNMOUNT|PDXB_SB_FLAG_ROOT_VOLUME = 0x3).
//
// -----------------------------------------------------------------------------
// Cap slots 172..175 (same fixed range alloc_free_hint_witness_synth.
// pdx / inode_table_witness_synth.pdx already claim -- tolerated per
// this tree's established practice: every witness clears its own range
// on entry AND on every exit path, and boot witnesses run strictly
// sequentially, so no two witnesses' cap rows are ever live at once)
// -----------------------------------------------------------------------------
//
//   172 = synthetic KIND_PCI_DEV parent for the NVMe controller
//   173 = KIND_NVME_CONTROLLER (row 0)
//   174 = KIND_NVME_NAMESPACE (row 0, dual-kind with slot 175)
//   175 = KIND_BLKDEV, family NVME (dual-kind with ns row 0) -- the
//         bdev_cap passed to every journal_ondisk.pdx call here
//
// -----------------------------------------------------------------------------
// Synthetic superblock fixture
// -----------------------------------------------------------------------------
//
// `_mrw_sb` is a private 4 KiB scratch buffer this file owns outright,
// zeroed then stamped with only the fields this witness actually reads
// or writes: `flags` (u32 @+28) = 0x2 initially, `journal_lba` (u64
// @+72) = 200, `journal_bcount` (u64 @+80) = 4. No other superblock
// field is touched, matching alloc_free_hint_witness_synth.pdx's /
// inode_table_witness_synth.pdx's own minimal-fixture precedent.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// One callee-save push (rbx = &_mrw_sb, set at stage 5 and reused for
// every superblock touch afterward) leaves rsp%16 == 0 (entry rsp%16
// == 8 + 8 == 16) for every nested call this function makes directly,
// matching inode_table_witness_synth.pdx's own `inode_table_witness`
// shape. `bdev_cap` (175), `vol_slot` (0), `journal_lba` (200),
// `journal_bcount` (4), and every txn_id/bit_no/expected value are
// compile-time-constant immediates -- no register needs to carry them
// across calls. Each encoder's returned record length is moved
// straight into r9 (`journal_append`'s `record_len` arg register)
// immediately after the encode call, before any other register is
// touched, so no callee-save slot is needed for it either. The one
// `sub rsp, 32` / `add rsp, 32` bracket around `nvme_ns_dual_kind_
// mint`'s params_ptr staging is 16-byte-aligned, so rsp%16 stays 0
// across it (identical bracket to inode_table_witness_synth.pdx's own
// `inode_table_witness`). Stage number lives in `_mrw_stage` (memory,
// not a register), matching that file's `_itw_stage` idiom.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere in this file -- the one u32
// field touched (`flags` @+28) uses `mov_d` (matching mkfs.pdx's own
// idiom for that exact field), every other field touched is a u64
// (`mov`). No `test` instruction anywhere; every comparison uses `cmp`
// + `je`/`jne`/`jae`. Every label is prefixed `mrw_` (Mount Replay
// Witness) per the reserved-label discipline. No comparison in this
// file targets a value with bit 31/63 set (every expected value is a
// small positive literal -- 0, 1, 2, 3, 4, 32, 200, 201), so no G4
// register-staging is needed for any `cmp`.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately after
// `inode_table_witness_call` (the most recent PdxFS-cluster addition to
// that file at the time of this landing). Golden: tests/r17/shell-
// shutdown.golden ("PDXFS BLOCK MOUNT WITNESS OK" appended right after
// "INODE TABLE WITNESS OK", matching every prior PdxFS witness's own
// golden-placement precedent -- design/filesystem/r52-implementation-
// plan.md's own stated tests/r52/mount-replay.golden path was never
// actually created for any R52 milestone-close witness in this tree;
// every one of them, including this one, lands its fingerprint line in
// the single smoke golden run-smoke.sh already checks).

module MountReplayWitnessSynth = structure {

  pub let mut _mrw_sb      : [u64; 512] = uninit @align(4096)
  pub let mut _mrw_rec_buf : [u64; 8]   = uninit @align(64)
  pub let mut _mrw_stage   : u64 = 0

  pub let mrw_ok   : [u8; 30] = "PDXFS BLOCK MOUNT WITNESS OK\0"
  pub let mrw_fail : [u8; 32] = "PDXFS BLOCK MOUNT WITNESS FAIL\0"

  // ==========================================================================
  // mrw_clear() -- scrub cap_table slots 172..175 inclusive.
  // ==========================================================================
  pub let mrw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M5-006 (#1708): clear cap_table slots 172..175 (this witness's whole fixed slot claim, shared with alloc_free_hint_witness_synth.pdx's afhw_clear / inode_table_witness_synth.pdx's itw_clear -- tolerated per established practice since witnesses run sequentially). Same shape as those. Labels prefixed mrw_cl_.",
      block: {
        push rbx;
        mov rbx, 172;
      mrw_cl_loop:
        cmp rbx, 176;
        jae mrw_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp mrw_cl_loop;
      mrw_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // mount_replay_witness() -> u64
  //
  // See module header for the full stage-by-step scope note, the
  // substrate-mode NVMe-cap trick this witness relies on (and the
  // journal_ondisk.pdx bbjw_check fix it depends on), and the synthetic
  // superblock fixture's field layout.
  // ==========================================================================
  pub let mount_replay_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R52.M5-006 (#1708): mount+replay+checkpoint boot witness (CLOSES R52.M5). One callee-save push (rbx = &_mrw_sb) leaves rsp%16==0 for every nested call. Body per the module header's numbered scope note: (1) defensive reset (nvme_ctrl_table_reset, nvme_ns_table_reset, mrw_clear). (2)-(4) mint a real KIND_NVME_CONTROLLER (slot 173, row 0) + dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots 174/175, row 0) under a synthetic KIND_PCI_DEV parent (slot 172), never advancing to a live SQ pair -- identical staging code to inode_table_witness_synth.pdx's own inode_table_witness. (5) zero + stamp _mrw_sb's three relevant fields (flags@+28=0x2 via mov_d, journal_lba@+72=200, journal_bcount@+80=4). (6) sb_flags(rbx) == 2 (dirty/unclean precondition, exact value). (7)-(15) three committed transactions (txn_id 1/2/3, bit_no 1/2/3): for each, journal_encode_begin(txn_id,0,0,&_mrw_rec_buf) then journal_append(175,0,200,4,&_mrw_rec_buf,rax) == 0; journal_encode_bitmap_set(txn_id,bit_no,&_mrw_rec_buf) then journal_append(...) == 0; journal_encode_commit(txn_id,0,&_mrw_rec_buf) then journal_append(...) == 0 -- 9 append calls total, each record_len moved rax->r9 immediately post-encode before any other register touch. (16) journal_checkpoint_lba(0) == 200 (writer's first-touch seed, read back before replay). (17) journal_replay(175,0,200,4,200) == 3 (applied_total -- one write-class record per committed txn). (18) journal_replay_discarded_count() == 0, journal_replay_orphan_count() == 0, journal_replay_head_lba() == 200. (19) journal_advance_ring(200,200,4) == 201 (the block after the last replayed COMMIT, journal_bcount=4 chosen specifically so this differs from journal_lba -- a bcount=1 ring would wrap back to the same LBA and prove nothing); journal_writer_set_checkpoint(0,201). (20) journal_checkpoint_lba(0) == 201 -- checkpoint genuinely advanced past its stage-16 baseline of 200. (21) toggle the clean-unmount bit directly in _mrw_sb (mov_d load [rbx+28], or 1, mov_d store back -- no mount.pdx exists yet to drive a real sb_write round trip, so this mirrors this codebase's own synthetic-superblock precedent of poking the fixture's field directly per §4.3 step 10's literal text); sb_flags(rbx) == 3 (both PDXB_SB_FLAG_ROOT_VOLUME and PDXB_SB_FLAG_CLEAN_UNMOUNT now set -- exact round-trip of mkfs.pdx's own documented post-mkfs constant). (22) all pass -> klog_s1(3, SUBSYS_BOOT, mrw_ok); cleanup (mrw_clear + nvme_ctrl_table_reset + nvme_ns_table_reset); return 0. Any stage divergence -> mrw_fail_stage, which logs the stage number via klog_s1_d1(k_line) exactly as inode_table_witness_synth.pdx's own itw_fail_stage does, then runs the same cleanup and returns 1. No comparison in this file targets a bit-31/63-set sentinel, so no G4 register-staging is needed for any cmp. Labels prefixed mrw_.",
      block: {
        push rbx;

        // -----------------------------------------------------------
        // (1) Defensive reset.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call mrw_clear;

        // -----------------------------------------------------------
        // (2) Synthetic KIND_PCI_DEV parent (slot 172).
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 172;
        mov rsi, 0x30;                    // KIND_PCI_DEV
        mov rdx, 0x21F;                   // R_DEV_ALL | RIGHT_MINT
        mov rcx, 0xFACEFEED;              // synthetic bdf
        call cap_mint_write;

        // -----------------------------------------------------------
        // (3) KIND_NVME_CONTROLLER (slot 173, row 0). Never advanced
        // to a live SQ pair -- substrate-mode posture.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 172;                     // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                   // R_NVMEC_ALL
        xor rdx, rdx;                     // ctrl_idx = 0
        mov rcx, 0x400000;                // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                       // expect row 0
        jne mrw_fail_stage;

        mov rdi, 173;
        mov rsi, 0x198;                   // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                     // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) Dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots
        // 174/175, row 0).
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;                // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;                // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;               // block_count
        xor rax, rax;
        mov [rsp + 24], rax;               // parent_ctrl_row = 0
        mov rdi, 174;                      // ns_slot
        mov rsi, 175;                      // blk_slot
        mov rdx, 173;                      // parent_slot (KIND_NVME_CONTROLLER)
        mov rcx, 0x41F;                    // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                     // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                      // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                        // expect row 0
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (5) Zero + stamp the synthetic superblock fixture.
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        lea rbx, [rip + _mrw_sb];
        xor rax, rax;
        xor rcx, rcx;
      mrw_sbzero_top:
        cmp rcx, 512;
        jae mrw_sbzero_done;
        mov [rbx + rcx * 8], rax;
        add rcx, 1;
        jmp mrw_sbzero_top;
      mrw_sbzero_done:

        mov rax, 2;
        mov_d [rbx + 28], rax;             // flags: ROOT_VOLUME set, CLEAN_UNMOUNT clear

        mov rax, 200;
        mov [rbx + 72], rax;               // journal_lba

        mov rax, 4;
        mov [rbx + 80], rax;               // journal_bcount

        // -----------------------------------------------------------
        // (6) sb_flags(rbx) == 2 (dirty precondition).
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call sb_flags;
        cmp rax, 2;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (7) txn 1 BEGIN.
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 1;                        // txn_id
        xor rsi, rsi;                      // mode
        xor rdx, rdx;                      // snap_gen
        lea rcx, [rip + _mrw_rec_buf];
        call journal_encode_begin;
        mov r9, rax;                       // record_len

        mov rdi, 175;                      // bdev_cap
        mov rsi, 0;                        // vol_slot
        mov rdx, 200;                      // journal_lba
        mov rcx, 4;                        // journal_bcount
        lea r8, [rip + _mrw_rec_buf];
        call journal_append;
        cmp rax, 0;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (8) txn 1 JOP_BITMAP_SET.
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 1;                        // txn_id
        mov rsi, 1;                        // bit_no
        lea rdx, [rip + _mrw_rec_buf];
        call journal_encode_bitmap_set;
        mov r9, rax;

        mov rdi, 175;
        mov rsi, 0;
        mov rdx, 200;
        mov rcx, 4;
        lea r8, [rip + _mrw_rec_buf];
        call journal_append;
        cmp rax, 0;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (9) txn 1 COMMIT.
        // -----------------------------------------------------------
        mov rax, 9;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 1;                        // txn_id
        xor rsi, rsi;                      // final_content_hash
        lea rdx, [rip + _mrw_rec_buf];
        call journal_encode_commit;
        mov r9, rax;

        mov rdi, 175;
        mov rsi, 0;
        mov rdx, 200;
        mov rcx, 4;
        lea r8, [rip + _mrw_rec_buf];
        call journal_append;
        cmp rax, 0;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (10) txn 2 BEGIN.
        // -----------------------------------------------------------
        mov rax, 10;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        xor rsi, rsi;
        xor rdx, rdx;
        lea rcx, [rip + _mrw_rec_buf];
        call journal_encode_begin;
        mov r9, rax;

        mov rdi, 175;
        mov rsi, 0;
        mov rdx, 200;
        mov rcx, 4;
        lea r8, [rip + _mrw_rec_buf];
        call journal_append;
        cmp rax, 0;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (11) txn 2 JOP_BITMAP_SET.
        // -----------------------------------------------------------
        mov rax, 11;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 2;                        // bit_no
        lea rdx, [rip + _mrw_rec_buf];
        call journal_encode_bitmap_set;
        mov r9, rax;

        mov rdi, 175;
        mov rsi, 0;
        mov rdx, 200;
        mov rcx, 4;
        lea r8, [rip + _mrw_rec_buf];
        call journal_append;
        cmp rax, 0;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (12) txn 2 COMMIT.
        // -----------------------------------------------------------
        mov rax, 12;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        xor rsi, rsi;
        lea rdx, [rip + _mrw_rec_buf];
        call journal_encode_commit;
        mov r9, rax;

        mov rdi, 175;
        mov rsi, 0;
        mov rdx, 200;
        mov rcx, 4;
        lea r8, [rip + _mrw_rec_buf];
        call journal_append;
        cmp rax, 0;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (13) txn 3 BEGIN.
        // -----------------------------------------------------------
        mov rax, 13;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        xor rsi, rsi;
        xor rdx, rdx;
        lea rcx, [rip + _mrw_rec_buf];
        call journal_encode_begin;
        mov r9, rax;

        mov rdi, 175;
        mov rsi, 0;
        mov rdx, 200;
        mov rcx, 4;
        lea r8, [rip + _mrw_rec_buf];
        call journal_append;
        cmp rax, 0;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (14) txn 3 JOP_BITMAP_SET.
        // -----------------------------------------------------------
        mov rax, 14;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 3;                        // bit_no
        lea rdx, [rip + _mrw_rec_buf];
        call journal_encode_bitmap_set;
        mov r9, rax;

        mov rdi, 175;
        mov rsi, 0;
        mov rdx, 200;
        mov rcx, 4;
        lea r8, [rip + _mrw_rec_buf];
        call journal_append;
        cmp rax, 0;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (15) txn 3 COMMIT.
        // -----------------------------------------------------------
        mov rax, 15;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        xor rsi, rsi;
        lea rdx, [rip + _mrw_rec_buf];
        call journal_encode_commit;
        mov r9, rax;

        mov rdi, 175;
        mov rsi, 0;
        mov rdx, 200;
        mov rcx, 4;
        lea r8, [rip + _mrw_rec_buf];
        call journal_append;
        cmp rax, 0;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (16) journal_checkpoint_lba(0) == 200 (pre-replay baseline).
        // -----------------------------------------------------------
        mov rax, 16;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call journal_checkpoint_lba;
        cmp rax, 200;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (17) journal_replay(175, 0, 200, 4, 200) == 3.
        // -----------------------------------------------------------
        mov rax, 17;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 175;                      // bdev_cap
        mov rsi, 0;                        // vol_slot
        mov rdx, 200;                      // journal_lba
        mov rcx, 4;                        // journal_bcount
        mov r8, 200;                       // checkpoint_lba
        call journal_replay;
        cmp rax, 3;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (18) discarded == 0, orphan == 0, head_lba == 200.
        // -----------------------------------------------------------
        mov rax, 18;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        call journal_replay_discarded_count;
        cmp rax, 0;
        jne mrw_fail_stage;

        call journal_replay_orphan_count;
        cmp rax, 0;
        jne mrw_fail_stage;

        call journal_replay_head_lba;
        cmp rax, 200;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (19) advance checkpoint: journal_advance_ring(200,200,4)
        // == 201; journal_writer_set_checkpoint(0, 201).
        // -----------------------------------------------------------
        mov rax, 19;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 200;                      // cur_lba (== head_lba)
        mov rsi, 200;                      // journal_lba
        mov rdx, 4;                        // journal_bcount
        call journal_advance_ring;
        cmp rax, 201;
        jne mrw_fail_stage;

        mov rdi, 0;                        // vol_slot
        mov rsi, 201;                      // new checkpoint
        call journal_writer_set_checkpoint;

        // -----------------------------------------------------------
        // (20) journal_checkpoint_lba(0) == 201 (checkpoint advanced).
        // -----------------------------------------------------------
        mov rax, 20;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call journal_checkpoint_lba;
        cmp rax, 201;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (21) toggle clean-unmount bit; sb_flags(rbx) == 3.
        // -----------------------------------------------------------
        mov rax, 21;
        lea rcx, [rip + _mrw_stage];
        mov [rcx], rax;

        mov_d rax, [rbx + 28];
        or rax, 1;
        mov_d [rbx + 28], rax;

        mov rdi, rbx;
        call sb_flags;
        cmp rax, 3;
        jne mrw_fail_stage;

        // -----------------------------------------------------------
        // (22) All checks passed.
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mrw_ok];
        call klog_s1;

        call mrw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp mrw_out;

      mrw_fail_stage:
        lea rax, [rip + _mrw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mrw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call mrw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        mov rax, 1;

      mrw_out:
        pop rbx;
        ret
      }
    }
}
