// tests/kernel/fs/pdxfs/snap_mount_ro_synth.pdx -- R42.M3-002 (#1389)
//
// Boot witness for the PDXFS-v1 read-only snapshot mount module.
// Exercises reset (mounts cleared, counters 0), bad-idx refusal
// (snap_id_at 8), bad-name refusal (mount 0), not-found refusal
// (mount before snap_create registers the name), happy mount +
// last_mount_id + is_ro==1, write-refusal returns SNR_ERR_ROFS and
// bumps write_refuse_count, unmount happy path + mount_count
// decrements, not-mounted refusal on unmount of empty slot, and
// mounts-full refusal after 8 mounts.
//
// Depends on snap_create (calls snc_reset + snc_create to register
// the names the mount path resolves).
//
// Fingerprint: R42 PDXFS SNAP MOUNT RO OK
// Failure fingerprint: R42 PDXFS SNAP MOUNT RO FAIL + stage number.

module SnapMountRoSynth = structure {

  pub let mut _snrw_stage : u64 = 0

  pub let snrw_ok   : [u8; 29] = "R42 PDXFS SNAP MOUNT RO OK\n\0"
  pub let snrw_fail : [u8; 31] = "R42 PDXFS SNAP MOUNT RO FAIL\n\0"

  pub let snap_mount_ro_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M3-002 (#1389): boot witness for pdxfs snap_mount_ro. Five-push callee-save discipline. Labels prefixed snrw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset both modules + defaults.
        mov rax, 1;
        lea rcx, [rip + _snrw_stage];
        mov [rcx], rax;

        call snc_reset;
        call snr_reset;
        call snr_bound;
        cmp rax, 1;
        jne snrw_fail_stage;
        call snr_err;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_capacity;
        cmp rax, 8;
        jne snrw_fail_stage;
        call snr_mount_count;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_mount_total;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_unmount_total;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_write_refuse_count;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_last_mount_id;
        cmp rax, 0;
        jne snrw_fail_stage;

        // -- 2. Bad-idx refusal on snap_id_at with idx >= 8.
        mov rax, 2;
        lea rcx, [rip + _snrw_stage];
        mov [rcx], rax;

        mov rdi, 8;
        call snr_snap_id_at;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_err;
        mov r11, 0xFFFFEF7B;                    // SNR_ERR_BAD_IDX
        cmp rax, r11;
        jne snrw_fail_stage;

        call snr_reset;

        // -- 3. Bad-name refusal on mount(0).
        mov rax, 3;
        lea rcx, [rip + _snrw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call snr_mount;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_err;
        mov r11, 0xFFFFEF7A;                    // SNR_ERR_BAD_NAME
        cmp rax, r11;
        jne snrw_fail_stage;

        call snr_reset;

        // -- 4. Not-found refusal on mount(name not registered).
        mov rax, 4;
        lea rcx, [rip + _snrw_stage];
        mov [rcx], rax;

        mov rdi, 0xBEEF;
        call snr_mount;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_err;
        mov r11, 0xFFFFEF7E;                    // SNR_ERR_NOT_FOUND
        cmp rax, r11;
        jne snrw_fail_stage;

        call snr_reset;

        // -- 5. Register two snapshots then mount them.
        mov rax, 5;
        lea rcx, [rip + _snrw_stage];
        mov [rcx], rax;

        mov rdi, 0xA0A0;
        call snc_create;                        // snap_id 1
        cmp rax, 1;
        jne snrw_fail_stage;
        mov rdi, 0xB0B0;
        call snc_create;                        // snap_id 2
        cmp rax, 2;
        jne snrw_fail_stage;

        mov rdi, 0xA0A0;
        call snr_mount;                         // mount_id 1
        cmp rax, 1;
        jne snrw_fail_stage;
        mov rdi, 0xB0B0;
        call snr_mount;                         // mount_id 2
        cmp rax, 2;
        jne snrw_fail_stage;

        call snr_mount_count;
        cmp rax, 2;
        jne snrw_fail_stage;
        call snr_mount_total;
        cmp rax, 2;
        jne snrw_fail_stage;
        call snr_last_mount_id;
        cmp rax, 2;
        jne snrw_fail_stage;

        mov rdi, 0;
        call snr_snap_id_at;
        cmp rax, 1;
        jne snrw_fail_stage;
        mov rdi, 1;
        call snr_snap_id_at;
        cmp rax, 2;
        jne snrw_fail_stage;

        // is_ro checks
        mov rdi, 1;
        call snr_is_ro;
        cmp rax, 1;
        jne snrw_fail_stage;
        mov rdi, 2;
        call snr_is_ro;
        cmp rax, 1;
        jne snrw_fail_stage;
        mov rdi, 3;                             // empty slot 3
        call snr_is_ro;
        cmp rax, 0;
        jne snrw_fail_stage;

        // -- 6. write_refuse returns SNR_ERR_ROFS + bumps counter.
        mov rax, 6;
        lea rcx, [rip + _snrw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call snr_write_refuse;
        mov r11, 0xFFFFEF7D;                    // SNR_ERR_ROFS
        cmp rax, r11;
        jne snrw_fail_stage;
        call snr_write_refuse_count;
        cmp rax, 1;
        jne snrw_fail_stage;

        mov rdi, 2;
        call snr_write_refuse;
        mov r11, 0xFFFFEF7D;
        cmp rax, r11;
        jne snrw_fail_stage;
        call snr_write_refuse_count;
        cmp rax, 2;
        jne snrw_fail_stage;

        // write_refuse on empty slot -> SNR_ERR_NOT_MOUNTED, counter unchanged.
        mov rdi, 3;
        call snr_write_refuse;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_err;
        mov r11, 0xFFFFEF79;                    // SNR_ERR_NOT_MOUNTED
        cmp rax, r11;
        jne snrw_fail_stage;
        call snr_write_refuse_count;
        cmp rax, 2;
        jne snrw_fail_stage;                    // unchanged

        // Reset both to clear the sticky latch.
        call snc_reset;
        call snr_reset;

        // -- 7. Unmount happy path + not-mounted refusal.
        mov rax, 7;
        lea rcx, [rip + _snrw_stage];
        mov [rcx], rax;

        mov rdi, 0xA0A0;
        call snc_create;                        // snap_id 1
        mov rdi, 0xA0A0;
        call snr_mount;                         // mount_id 1
        cmp rax, 1;
        jne snrw_fail_stage;

        mov rdi, 1;
        call snr_unmount;
        cmp rax, 1;
        jne snrw_fail_stage;
        call snr_mount_count;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_unmount_total;
        cmp rax, 1;
        jne snrw_fail_stage;
        mov rdi, 0;
        call snr_snap_id_at;
        cmp rax, 0;
        jne snrw_fail_stage;

        // Unmount the same id again -> SNR_ERR_NOT_MOUNTED.
        mov rdi, 1;
        call snr_unmount;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_err;
        mov r11, 0xFFFFEF79;                    // SNR_ERR_NOT_MOUNTED
        cmp rax, r11;
        jne snrw_fail_stage;

        // Unmount 0 -> SNR_ERR_BAD_IDX.
        call snr_reset;
        mov rdi, 0;
        call snr_unmount;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_err;
        mov r11, 0xFFFFEF7B;
        cmp rax, r11;
        jne snrw_fail_stage;

        // Unmount 9 -> SNR_ERR_BAD_IDX.
        call snr_reset;
        mov rdi, 9;
        call snr_unmount;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_err;
        mov r11, 0xFFFFEF7B;
        cmp rax, r11;
        jne snrw_fail_stage;

        // -- 8. Mounts-full refusal after 8 mounts.
        mov rax, 8;
        lea rcx, [rip + _snrw_stage];
        mov [rcx], rax;

        call snc_reset;
        call snr_reset;

        xor r12, r12;
      snrw_fill_snaps:
        mov rdi, 0x3000;
        add rdi, r12;                           // distinct names
        call snc_create;
        cmp rax, 0;
        je  snrw_fail_stage;
        add r12, 1;
        cmp r12, 8;
        jb  snrw_fill_snaps;

        xor r12, r12;
      snrw_fill_mnts:
        mov rdi, 0x3000;
        add rdi, r12;
        call snr_mount;
        cmp rax, 0;
        je  snrw_fail_stage;
        add r12, 1;
        cmp r12, 8;
        jb  snrw_fill_mnts;

        call snr_mount_count;
        cmp rax, 8;
        jne snrw_fail_stage;

        // 9th snap + 9th mount refuses with MOUNTS_FULL.
        mov rdi, 0x9999;
        call snc_create;
        cmp rax, 0;
        je  snrw_fail_stage;
        mov rdi, 0x9999;
        call snr_mount;
        cmp rax, 0;
        jne snrw_fail_stage;
        call snr_err;
        mov r11, 0xFFFFEF7C;                    // SNR_ERR_MOUNTS_FULL
        cmp rax, r11;
        jne snrw_fail_stage;

        // Return modules to a clean state.
        call snc_reset;
        call snr_reset;
        call snr_bound;
        cmp rax, 1;
        jne snrw_fail_stage;
        call snc_bound;
        cmp rax, 1;
        jne snrw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + snrw_ok];
        call klog_s1;

        xor rax, rax;
        jmp snrw_out;

      snrw_fail_stage:
        lea rax, [rip + _snrw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + snrw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      snrw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
