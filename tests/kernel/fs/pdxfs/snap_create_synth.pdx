// tests/kernel/fs/pdxfs/snap_create_synth.pdx -- R42.M3-001 (#1388)
//
// Boot witness for the PDXFS-v1 snapshot create + name registry
// module. Exercises reset (names cleared, counters 0), bad-name
// refusal (create with hash 0), bad-idx refusal (name_at 16), three
// happy creates (snap_ids 1/2/3), refbump accounting (3 * 4 == 12),
// last_snap_id readback, snc_lookup happy path + not-found returns
// 0 with no latch, dup-name refusal, chain-full refusal after 16
// creates (walked in one loop), and the reset-latch clears.
//
// Fingerprint: R42 PDXFS SNAP CREATE OK
// Failure fingerprint: R42 PDXFS SNAP CREATE FAIL + stage number.

module SnapCreateSynth = structure {

  pub let mut _sncw_stage : u64 = 0

  pub let sncw_ok   : [u8; 27] = "R42 PDXFS SNAP CREATE OK\n\0"
  pub let sncw_fail : [u8; 29] = "R42 PDXFS SNAP CREATE FAIL\n\0"

  pub let snap_create_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M3-001 (#1388): boot witness for pdxfs snap_create. Five-push callee-save discipline. Labels prefixed sncw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _sncw_stage];
        mov [rcx], rax;

        call snc_reset;
        call snc_bound;
        cmp rax, 1;
        jne sncw_fail_stage;
        call snc_err;
        cmp rax, 0;
        jne sncw_fail_stage;
        call snc_capacity;
        cmp rax, 16;
        jne sncw_fail_stage;
        call snc_live_blocks;
        cmp rax, 4;
        jne sncw_fail_stage;
        call snc_head;
        cmp rax, 0;
        jne sncw_fail_stage;
        call snc_create_count;
        cmp rax, 0;
        jne sncw_fail_stage;
        call snc_refbump_total;
        cmp rax, 0;
        jne sncw_fail_stage;
        call snc_last_snap_id;
        cmp rax, 0;
        jne sncw_fail_stage;

        // Every name slot reads back 0.
        mov rdi, 0;
        call snc_name_at;
        cmp rax, 0;
        jne sncw_fail_stage;
        mov rdi, 15;
        call snc_name_at;
        cmp rax, 0;
        jne sncw_fail_stage;

        // -- 2. Bad-idx refusal on name_at with idx >= 16.
        mov rax, 2;
        lea rcx, [rip + _sncw_stage];
        mov [rcx], rax;

        mov rdi, 16;
        call snc_name_at;
        cmp rax, 0;
        jne sncw_fail_stage;
        call snc_err;
        mov r11, 0xFFFFEF8B;                    // SNC_ERR_BAD_IDX
        cmp rax, r11;
        jne sncw_fail_stage;

        call snc_reset;

        // -- 3. Bad-name refusal on create with hash 0.
        mov rax, 3;
        lea rcx, [rip + _sncw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call snc_create;
        cmp rax, 0;
        jne sncw_fail_stage;
        call snc_err;
        mov r11, 0xFFFFEF8C;                    // SNC_ERR_BAD_NAME
        cmp rax, r11;
        jne sncw_fail_stage;
        call snc_head;
        cmp rax, 0;
        jne sncw_fail_stage;

        call snc_reset;

        // -- 4. Three happy creates. snap_ids 1/2/3 in order.
        mov rax, 4;
        lea rcx, [rip + _sncw_stage];
        mov [rcx], rax;

        mov rdi, 0xAABB;
        call snc_create;
        cmp rax, 1;
        jne sncw_fail_stage;
        mov rdi, 0xCCDD;
        call snc_create;
        cmp rax, 2;
        jne sncw_fail_stage;
        mov rdi, 0xEEFF;
        call snc_create;
        cmp rax, 3;
        jne sncw_fail_stage;

        call snc_head;
        cmp rax, 3;
        jne sncw_fail_stage;
        call snc_create_count;
        cmp rax, 3;
        jne sncw_fail_stage;
        call snc_refbump_total;
        cmp rax, 12;
        jne sncw_fail_stage;
        call snc_last_snap_id;
        cmp rax, 3;
        jne sncw_fail_stage;

        mov rdi, 0;
        call snc_name_at;
        mov r11, 0xAABB;
        cmp rax, r11;
        jne sncw_fail_stage;
        mov rdi, 1;
        call snc_name_at;
        mov r11, 0xCCDD;
        cmp rax, r11;
        jne sncw_fail_stage;
        mov rdi, 2;
        call snc_name_at;
        mov r11, 0xEEFF;
        cmp rax, r11;
        jne sncw_fail_stage;
        mov rdi, 3;
        call snc_name_at;
        cmp rax, 0;
        jne sncw_fail_stage;

        // -- 5. Lookup happy path + not-found + zero-name.
        mov rax, 5;
        lea rcx, [rip + _sncw_stage];
        mov [rcx], rax;

        mov rdi, 0xAABB;
        call snc_lookup;
        cmp rax, 1;
        jne sncw_fail_stage;
        mov rdi, 0xCCDD;
        call snc_lookup;
        cmp rax, 2;
        jne sncw_fail_stage;
        mov rdi, 0xEEFF;
        call snc_lookup;
        cmp rax, 3;
        jne sncw_fail_stage;
        mov rdi, 0x9999;
        call snc_lookup;
        cmp rax, 0;
        jne sncw_fail_stage;
        call snc_err;
        cmp rax, 0;
        jne sncw_fail_stage;
        mov rdi, 0;
        call snc_lookup;
        cmp rax, 0;
        jne sncw_fail_stage;
        call snc_err;
        cmp rax, 0;
        jne sncw_fail_stage;

        // -- 6. Dup-name refusal.
        mov rax, 6;
        lea rcx, [rip + _sncw_stage];
        mov [rcx], rax;

        mov rdi, 0xAABB;
        call snc_create;
        cmp rax, 0;
        jne sncw_fail_stage;
        call snc_err;
        mov r11, 0xFFFFEF8D;                    // SNC_ERR_DUP_NAME
        cmp rax, r11;
        jne sncw_fail_stage;
        call snc_head;
        cmp rax, 3;
        jne sncw_fail_stage;                    // unchanged

        call snc_reset;

        // -- 7. Chain-full refusal after 16 creates.
        mov rax, 7;
        lea rcx, [rip + _sncw_stage];
        mov [rcx], rax;

        xor r12, r12;                           // loop counter
        mov r13, 0x1000;                        // base name_hash
      sncw_fill:
        mov rdi, r13;
        add rdi, r12;                           // distinct names
        call snc_create;
        cmp rax, 0;
        je  sncw_fail_stage;
        add r12, 1;
        cmp r12, 16;
        jb  sncw_fill;

        call snc_head;
        cmp rax, 16;
        jne sncw_fail_stage;
        call snc_refbump_total;
        cmp rax, 64;                            // 16 * 4
        jne sncw_fail_stage;

        // 17th create refuses with CHAIN_FULL.
        mov rdi, 0x2000;
        call snc_create;
        cmp rax, 0;
        jne sncw_fail_stage;
        call snc_err;
        mov r11, 0xFFFFEF8E;                    // SNC_ERR_CHAIN_FULL
        cmp rax, r11;
        jne sncw_fail_stage;
        call snc_head;
        cmp rax, 16;
        jne sncw_fail_stage;

        // Return module to a clean state.
        call snc_reset;
        call snc_bound;
        cmp rax, 1;
        jne sncw_fail_stage;
        call snc_err;
        cmp rax, 0;
        jne sncw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sncw_ok];
        call klog_s1;

        xor rax, rax;
        jmp sncw_out;

      sncw_fail_stage:
        lea rax, [rip + _sncw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sncw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      sncw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
