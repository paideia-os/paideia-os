// tests/kernel/fs/pdxfs/mkfs_mount_refuse_witness_synth.pdx -- R52.M2-005 (#1690)
//
// Smoke/boot witness: mkfs -> probe -> mount REFUSES because the itable
// region mkfs.pdxfs left behind is uninitialised (no inode has been
// stamped -- that is R52.M4's job, per #1698 `inode_table.pdx`).
//
// Design authority: design/filesystem/r52-implementation-plan.md
// §2.2 step 5 (#1690): "Smoke: mkfs -> probe -> mount refuses (because
// M4 has not yet initialised the inode table's sig-tail signing; the
// refusal is by design at this milestone)." Companion note in
// src/kernel/core/fs/pdxfs/mkfs.pdx's "Root-inode gap" header section
// (#1688's own documented descope): mkfs_run zeroes the itable region
// via `mkfs_zero_region` and does NOT stamp inode 0 (sentinel) / inode 1
// (root dir) content, because the 128-byte inode row FORMAT is not
// frozen until R52.M4. Every itable row therefore reads all-zero after
// a fresh mkfs -- this witness's whole premise is that "all-zero" is
// the correct, by-design signal a mount step must read as "no inodes
// here yet" and refuse on, rather than silently proceeding into a root
// directory that was never actually written.
//
// -----------------------------------------------------------------------------
// Why this is a witness-local check, not a call into a real `mount`
// primitive
// -----------------------------------------------------------------------------
//
// There is no R52 PdxFS `mount` primitive to call yet: mount lands at
// R52.M5 (design doc §2.2, M5's own R51-gate note references "Mount
// without FLUSH cannot uphold JOP_COMMIT durability" for the mount
// module that milestone introduces). `src/kernel/core/fs/pdxfs_lite/
// mount.pdx` exists but belongs to the older pdxfs_lite generation, not
// this R52 on-block format, and mounting it here would prove nothing
// about the PDXB itable contract. This witness therefore implements the
// minimal "would a mount step refuse here" check itself, scoped
// entirely to this file, exactly as #1691's `mkfs_probe_witness_synth.
// pdx` scoped its "probe" step to calling the real accessors directly
// rather than inventing a placeholder mount call.
//
// -----------------------------------------------------------------------------
// Why no BDEV round trip (same substrate gap #1691 already documented)
// -----------------------------------------------------------------------------
//
// As with #1691's witness, this file does not call `mkfs_run`/`sb_write`/
// `sb_read` against a real `KIND_BLKDEV` cap: `tools/run-smoke.sh` never
// attaches a live NVMe or AHCI device (no `-device nvme`, no AHCI drive,
// PCI enumeration itself skipped under `-kernel` boot), so any such call
// would either dispatch to nothing (an empty cap slot's MVP default,
// which misreports success) or fail deterministically at the synthetic
// cap-mint gate -- proving nothing beyond what `sb_write`/`mkfs_zero_
// region`'s own headers already document. Instead this witness drives
// the exact in-memory data contract `mkfs_run` would have produced:
// `mkfs_layout_compute` + `mkfs_sb_populate` build the same superblock
// bytes `mkfs_run` would hand to `sb_write`, and a fresh all-zero static
// buffer stands in for "the itable's root-inode row, as `mkfs_zero_
// region` actually left it on disk" -- `mkfs_zero_region` (mkfs.pdx)
// always zeroes every itable block from an all-zero source, so a fresh
// all-zero row IS byte-for-byte what a real on-disk read would return,
// not an approximation. (This file deliberately owns its own zero
// buffer rather than reaching into `mkfs.pdx`'s private `_mkfs_zero_buf`
// / `_mkfs_zero_desc` -- both are confined by `tools/build.sh`'s
// `ec_confine_one` audit to `core/fs/pdxfs/mkfs.o` alone, and reusing
// them here would either violate that confinement or require widening
// it for no real benefit, since the two buffers already share the exact
// same static-all-zero value this witness needs.)
//
// -----------------------------------------------------------------------------
// What this witness proves
// -----------------------------------------------------------------------------
//
// (1) `mkfs_layout_compute(1000, 4096, 100, 10)` returns 0 -- "mkfs
//     writes a valid PDXB volume" (same geometry #1691 uses, comfortably
//     passing `sb_validate_regions` by construction).
// (2) `mkfs_sb_populate(&_mkfs_sb_scratch, &_mkfs_layout_row)` stamps
//     that layout + a fresh UUID into the scratch superblock exactly as
//     `mkfs_run` would.
// (3) `sb_validate_all(&_mkfs_sb_scratch)` returns 0 -- "probe reads
//     back a structurally valid superblock" (the same probe half #1691
//     already exercises).
// (4) `sb_root_inode(&_mkfs_sb_scratch)` reads back the root-inode index
//     mkfs stamped (1, `PDXB_SB_ROOT_INODE_DEFAULT`) -- the inode a real
//     mount step would open next.
// (5) The would-be itable root-inode row (`_pdxbmr_itable_row`, 16
//     qwords = 128 bytes, matching the M4 row-width mkfs.pdx documents)
//     is scanned qword-by-qword and OR-accumulated; it reads all-zero,
//     matching mkfs_zero_region's actual on-disk output. A "mount"
//     reading an all-zero row has no `in_use`/valid marker to find under
//     ANY future M4 row convention (an all-zero row cannot encode "in
//     use" without also encoding every other field as zero, which no
//     sane row format treats as valid) -- so this witness's mount step
//     REFUSES with a local NO_INODES condition. This is the expected,
//     by-design M2 outcome documented in mkfs.pdx's "Root-inode gap"
//     section and the plan's §2.2 step 5 text.
// (6) The refusal is fingerprinted as "PDXB MOUNT REFUSED NO_INODES OK"
//     (no round/milestone prefix, per design/policy/output-provenance-
//     strip.md) -- "OK" here means the smoke correctly observed the
//     expected refusal, not that mount succeeded. One decimal detail
//     line (root_ino=1) shares the tag, matching #1691's KV-detail-line
//     convention.
//
// Forward note (flagged for M4, mirrors mkfs.pdx's own follow-up flag):
// once #1698 `inode_table.pdx` freezes the row format and a follow-up
// patches `mkfs_run` to stamp inode 1 as a valid root directory, this
// witness's row will stop reading all-zero and its "REFUSED" branch
// will stop firing -- at that point this file's expected outcome
// inverts (mount should SUCCEED) and needs a corresponding rewrite, not
// a silent bit-rot. The M2-scoped behavior it asserts today is
// time-bound by construction, exactly as mkfs.pdx's own header already
// documents.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// Five-push callee-save prologue (rbx, r12, r13, r14, r15), matching
// every other witness in this contiguous PdxFS witness cluster.
// rbx = &_mkfs_sb_scratch once populated (kept live across sb_validate_
// all and sb_root_inode). r12 = root_inode value read back (callee-save,
// survives the itable-scan loop and the two klog calls that follow).
// r13 = &_pdxbmr_itable_row (loop base, computed once). r14 = loop index
// (0..15). r15 = OR-accumulator across the 16 qwords. 5 pushes from a
// SysV-entry rsp%16==8 land rsp%16==0, so every nested `call` below
// (mkfs_layout_compute, mkfs_sb_populate, sb_validate_all, sb_root_inode,
// klog_s1_d1 x2) needs no extra `sub rsp, 8` -- all are zero-stack-arg
// calls.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere (every value read is a full-qword
// accessor return or a static qword-array element). No `test`
// instruction anywhere -- every comparison uses `cmp` + `je`/`jne`/`jae`.
// Every label is prefixed `pdxbmr_` (PDXB Mount Refuse) per the
// reserved-label discipline.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately after
// `mkfs_probe_witness_call` (#1691), keeping this fixture inside the
// contiguous PdxFS witness cluster that file's header documents. Its
// bare OK tag text is appended to tests/r17/shell-shutdown.golden
// immediately after "PDXB VOLUME PROBE OK", following the same
// established master-golden convention #1691 already documented (the
// plan's §7 names a dedicated `tests/r52/mkfs-probe.golden` that no
// R23+ round has ever actually stood up this way).

module MkfsMountRefuseWitnessSynth = structure {

  pub let mut _pdxbmr_stage : u64 = 0

  // The itable's root-inode row, as `mkfs_zero_region` (mkfs.pdx)
  // actually leaves it on disk: every block in the itable region is
  // written from an all-zero source buffer, so a fresh row reads
  // all-zero. Owned locally (not `mkfs.pdx`'s confined `_mkfs_zero_buf`)
  // -- see this file's header note. 16 qwords = 128 bytes, matching the
  // M4 inode-row width mkfs.pdx documents.
  pub let mut _pdxbmr_itable_row : [u64; 16] = [0; 16]

  pub let pdxbmr_tag_ok   : [u8; 32] = "PDXB MOUNT REFUSED NO_INODES OK\0"
  pub let pdxbmr_tag_fail : [u8; 34] = "PDXB MOUNT REFUSED NO_INODES FAIL\0"

  pub let pdxbmr_k_root_ino : [u8; 9] = "root_ino\0"

  // ============================================================================
  // wit_mkfs_mount_refuse() -> u64
  //
  // Body:
  //   (0) 5-push prologue.
  //   (1) mkfs_layout_compute(1000, 4096, 100, 10) -- expect 0.
  //   (2) mkfs_sb_populate(&_mkfs_sb_scratch, &_mkfs_layout_row) -- always 0.
  //   (3) rbx = &_mkfs_sb_scratch. sb_validate_all(rbx) -- expect 0.
  //   (4) sb_root_inode(rbx) -> r12 (the inode a mount step would open).
  //   (5) OR-scan the 16 qwords of _pdxbmr_itable_row -> r15. Expect 0
  //       (all-zero row -- "no inode has been stamped here").
  //   (6) rax==0 at (5): emit the OK detail line (root_ino=r12) sharing
  //       tag "PDXB MOUNT REFUSED NO_INODES OK" -- the expected M2
  //       refusal was correctly observed. rax!=0 at (5): unexpected
  //       (mount would NOT have refused) -- treated as a witness FAIL.
  // ============================================================================

  pub let wit_mkfs_mount_refuse : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R52.M2-005 (#1690): smoke/boot witness proving mkfs -> probe -> mount refuses because the itable region mkfs.pdxfs (#1688) left behind is uninitialised (all-zero, no inode 0/1 stamped -- that is R52.M4's job per #1698). Drives the same in-memory mkfs.pdx (#1688) halves #1691's witness uses -- mkfs_layout_compute(1000,4096,100,10) then mkfs_sb_populate(&_mkfs_sb_scratch,&_mkfs_layout_row) -- to build a superblock exactly as mkfs_run would hand to sb_write, validates it via sb_validate_all (#1682) expecting 0 (the 'probe' half), reads back the root-inode index via sb_root_inode (#1682), then OR-scans the 16 qwords of a locally-owned all-zero buffer standing in for the itable's root-inode row exactly as mkfs_zero_region (mkfs.pdx) actually leaves it on disk (every itable block is zeroed from an all-zero source -- not an approximation). An all-zero accumulator means the row carries no inode marker under any row convention, so the witness's 'mount' step refuses with a local NO_INODES condition and emits 'PDXB MOUNT REFUSED NO_INODES OK' plus a root_ino=<n> detail line -- the by-design M2 outcome documented in mkfs.pdx's Root-inode-gap section and design/filesystem/r52-implementation-plan.md §2.2 step 5. Does not call a real mount primitive (R52 PdxFS mount lands at M5) or a real BDEV round trip (no live NVMe/AHCI device is attached by any smoke invocation today -- see this file's header). Five-push callee-save discipline (rbx=&_mkfs_sb_scratch once populated; r12=root_inode, callee-save so it survives the scan loop and klog calls; r13=&_pdxbmr_itable_row; r14=loop index; r15=OR-accumulator), matching every other witness in this PdxFS cluster. Encoder: mov / cmp / je / jne / jae / lea / or / add / call -- all pre-existing. Labels prefixed pdxbmr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- Stage 1: mkfs_layout_compute(1000, 4096, 100, 10). --
        mov rax, 1;
        lea rcx, [rip + _pdxbmr_stage];
        mov [rcx], rax;

        mov rdi, 1000;                    // total_blocks
        mov rsi, 4096;                    // block_size
        mov rdx, 100;                     // inode_ratio
        mov rcx, 10;                      // journal_size_hint
        call mkfs_layout_compute;
        cmp rax, 0;
        jne pdxbmr_fail_stage;

        // -- Stage 2: mkfs_sb_populate(&_mkfs_sb_scratch, &_mkfs_layout_row). --
        mov rax, 2;
        lea rcx, [rip + _pdxbmr_stage];
        mov [rcx], rax;

        lea rdi, [rip + _mkfs_sb_scratch];
        lea rsi, [rip + _mkfs_layout_row];
        call mkfs_sb_populate;

        // -- Stage 3: probe validates the just-mkfs'd superblock. --
        mov rax, 3;
        lea rcx, [rip + _pdxbmr_stage];
        mov [rcx], rax;

        lea rbx, [rip + _mkfs_sb_scratch];
        mov rdi, rbx;
        call sb_validate_all;
        cmp rax, 0;
        jne pdxbmr_fail_stage;

        // -- Stage 4: read back the root-inode index a mount would open. --
        mov rax, 4;
        lea rcx, [rip + _pdxbmr_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call sb_root_inode;
        mov r12, rax;

        // -- Stage 5: OR-scan the itable root-inode row. --
        mov rax, 5;
        lea rcx, [rip + _pdxbmr_stage];
        mov [rcx], rax;

        lea r13, [rip + _pdxbmr_itable_row];
        xor r14, r14;                     // loop index
        xor r15, r15;                     // OR-accumulator

      pdxbmr_scan_top:
        cmp r14, 16;
        jae pdxbmr_scan_done;

        mov rax, [r13 + r14 * 8];
        or  r15, rax;
        add r14, 1;
        jmp pdxbmr_scan_top;

      pdxbmr_scan_done:
        cmp r15, 0;
        jne pdxbmr_fail_stage;             // row not all-zero: mount would NOT refuse (unexpected at M2)

        // -- Stage 6: refusal correctly observed -- emit the OK detail line. --
        mov rax, 6;
        lea rcx, [rip + _pdxbmr_stage];
        mov [rcx], rax;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxbmr_tag_ok];
        lea rcx, [rip + pdxbmr_k_root_ino];
        mov r8, r12;
        call klog_s1_d1;

        xor rax, rax;
        jmp pdxbmr_out;

      pdxbmr_fail_stage:
        lea rax, [rip + _pdxbmr_stage];
        mov r8, [rax];
        mov rdi, 1;                              // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxbmr_tag_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pdxbmr_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
