// tests/kernel/fs/pdxfs/cow_read_synth.pdx -- R42.M1-002 (#1381)
//
// Boot witness for the PDXFS-v1 CoW read path.
// Exercises reset (empty chain, empty cache), snapshot_push id sequence,
// out-of-extent refusal, unknown-snapshot refusal, read-not-found
// refusal, walk newest-wins ordering across two snapshots, cache
// hit/miss counter growth, cache invalidation on remap, and the
// SNAP_FULL / CHAIN_FULL refusals.
//
// Fingerprint: PDXFS COW READ OK
// Failure fingerprint: PDXFS COW READ FAIL + stage number.

module CowReadSynth = structure {

  pub let mut _pxcrw_stage : u64 = 0

  pub let pxcrw_ok : [u8; 20] = "PDXFS COW READ OK\n\0"
  pub let pxcrw_fail : [u8; 22] = "PDXFS COW READ FAIL\n\0"

  pub let cow_read_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M1-002 (#1381): boot witness for pdxfs cow_read. Five-push callee-save discipline. Labels prefixed pxcrw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _pxcrw_stage];
        mov [rcx], rax;

        call pxcr_reset;
        call pxcr_bound;
        cmp rax, 1;
        jne pxcrw_fail_stage;
        call pxcr_err;
        cmp rax, 0;
        jne pxcrw_fail_stage;
        call pxcr_snapshot_top;
        cmp rax, 0;
        jne pxcrw_fail_stage;
        call pxcr_snapshot_count;
        cmp rax, 0;
        jne pxcrw_fail_stage;
        call pxcr_chain_len;
        cmp rax, 0;
        jne pxcrw_fail_stage;
        call pxcr_walk_count;
        cmp rax, 0;
        jne pxcrw_fail_stage;
        call pxcr_cache_hits;
        cmp rax, 0;
        jne pxcrw_fail_stage;
        call pxcr_cache_misses;
        cmp rax, 0;
        jne pxcrw_fail_stage;
        call pxcr_dev_extent;
        mov r11, 4096;
        cmp rax, r11;
        jne pxcrw_fail_stage;

        // -- 2. snapshot_push yields id 1, 2, 3.
        mov rax, 2;
        lea rcx, [rip + _pxcrw_stage];
        mov [rcx], rax;

        call pxcr_snapshot_push;
        cmp rax, 1;
        jne pxcrw_fail_stage;
        call pxcr_snapshot_push;
        cmp rax, 2;
        jne pxcrw_fail_stage;
        call pxcr_snapshot_top;
        cmp rax, 2;
        jne pxcrw_fail_stage;
        call pxcr_snapshot_count;
        cmp rax, 2;
        jne pxcrw_fail_stage;

        // -- 3. Out-of-extent refusal on map + read.
        mov rax, 3;
        lea rcx, [rip + _pxcrw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 4096;
        mov rdx, 500;
        call pxcr_snapshot_map;
        mov r11, 0xFFFFEFFC;                    // PXCR_ERR_OUT_OF_EXTENT
        cmp rax, r11;
        jne pxcrw_fail_stage;

        mov rdi, 4096;
        call pxcr_read;
        mov r11, 0xFFFFEFFC;
        cmp rax, r11;
        jne pxcrw_fail_stage;

        // -- 4. Bad-snapshot refusal on map.
        mov rax, 4;
        lea rcx, [rip + _pxcrw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 10;
        mov rdx, 500;
        call pxcr_snapshot_map;
        mov r11, 0xFFFFEFFA;                    // PXCR_ERR_BAD_SNAPSHOT
        cmp rax, r11;
        jne pxcrw_fail_stage;

        mov rdi, 99;
        mov rsi, 10;
        mov rdx, 500;
        call pxcr_snapshot_map;
        mov r11, 0xFFFFEFFA;
        cmp rax, r11;
        jne pxcrw_fail_stage;

        // -- 5. read-not-found refusal.
        mov rax, 5;
        lea rcx, [rip + _pxcrw_stage];
        mov [rcx], rax;

        mov rdi, 42;
        call pxcr_read;
        mov r11, 0xFFFFEFFB;                    // PXCR_ERR_NOT_FOUND
        cmp rax, r11;
        jne pxcrw_fail_stage;

        // -- 6. Newest-wins ordering.
        //         snap 1: lba 100 -> phys 1000
        //         snap 2: lba 100 -> phys 2000
        //         pxcr_read(100) returns 2000.
        mov rax, 6;
        lea rcx, [rip + _pxcrw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 100;
        mov rdx, 1000;
        call pxcr_snapshot_map;
        cmp rax, 0;
        jne pxcrw_fail_stage;

        mov rdi, 2;
        mov rsi, 100;
        mov rdx, 2000;
        call pxcr_snapshot_map;
        cmp rax, 0;
        jne pxcrw_fail_stage;

        mov rdi, 100;
        call pxcr_read;
        cmp rax, 2000;
        jne pxcrw_fail_stage;
        call pxcr_cache_misses;
        cmp rax, 1;
        jne pxcrw_fail_stage;
        call pxcr_walk_count;
        cmp rax, 1;
        jne pxcrw_fail_stage;

        // Second read: cache hit.
        mov rdi, 100;
        call pxcr_read;
        cmp rax, 2000;
        jne pxcrw_fail_stage;
        call pxcr_cache_hits;
        cmp rax, 1;
        jne pxcrw_fail_stage;

        // pxcr_cache_get peek without walking.
        mov rdi, 100;
        call pxcr_cache_get;
        cmp rax, 2000;
        jne pxcrw_fail_stage;

        // -- 7. Cache invalidation on remap.
        //         snap 2 remaps lba 100 to phys 3000.
        //         pxcr_read returns 3000 (walk hit, not the stale cache).
        mov rax, 7;
        lea rcx, [rip + _pxcrw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 100;
        mov rdx, 3000;
        call pxcr_snapshot_map;
        cmp rax, 0;
        jne pxcrw_fail_stage;

        // Cache slot has been invalidated.
        mov rdi, 100;
        call pxcr_cache_get;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne pxcrw_fail_stage;

        mov rdi, 100;
        call pxcr_read;
        cmp rax, 3000;
        jne pxcrw_fail_stage;
        call pxcr_cache_misses;
        cmp rax, 2;
        jne pxcrw_fail_stage;

        // -- 8. SNAP_FULL after 8 total pushes (already pushed 2).
        mov rax, 8;
        lea rcx, [rip + _pxcrw_stage];
        mov [rcx], rax;

        xor r12, r12;
      pxcrw_pushfill:
        call pxcr_snapshot_push;
        cmp rax, 0;
        je  pxcrw_fail_stage;
        add r12, 1;
        cmp r12, 6;
        jb  pxcrw_pushfill;

        call pxcr_snapshot_top;
        cmp rax, 8;
        jne pxcrw_fail_stage;

        call pxcr_snapshot_push;
        mov r11, 0xFFFFEFFD;                    // PXCR_ERR_SNAP_FULL
        cmp rax, r11;
        jne pxcrw_fail_stage;

        // Return the module to a clean state.
        call pxcr_reset;
        call pxcr_bound;
        cmp rax, 1;
        jne pxcrw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxcrw_ok];
        call klog_s1;

        xor rax, rax;
        jmp pxcrw_out;

      pxcrw_fail_stage:
        lea rax, [rip + _pxcrw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxcrw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pxcrw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
