// tests/kernel/fs/pdxfs/cow_gc_synth.pdx -- R42.M1-004 (#1383)
//
// Boot witness for the PDXFS-v1 CoW garbage-collection pass.
// Exercises reset (empty free list, counters 0), scan on empty
// refcount (block 0 excluded so zero_count = 4095), release
// idempotency (a second release finds nothing new), scan/release
// interaction with pxrc_inc, bad-idx refusal on pxgc_free_at, and
// the OK path where release parks known blocks onto the free list
// in ascending order.
//
// Fingerprint: R42 PDXFS COW GC OK
// Failure fingerprint: R42 PDXFS COW GC FAIL + stage number.

module CowGcSynth = structure {

  pub let mut _pxgcw_stage : u64 = 0

  pub let pxgcw_ok   : [u8; 22] = "R42 PDXFS COW GC OK\n\0"
  pub let pxgcw_fail : [u8; 24] = "R42 PDXFS COW GC FAIL\n\0"

  pub let cow_gc_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M1-004 (#1383): boot witness for pdxfs cow_gc. Resets pxrc + pxgc; depends on pxrc for refcount lookups. Labels prefixed pxgcw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _pxgcw_stage];
        mov [rcx], rax;

        call pxrc_reset;
        call pxgc_reset;
        call pxgc_bound;
        cmp rax, 1;
        jne pxgcw_fail_stage;
        call pxgc_err;
        cmp rax, 0;
        jne pxgcw_fail_stage;
        call pxgc_scan_count;
        cmp rax, 0;
        jne pxgcw_fail_stage;
        call pxgc_release_count;
        cmp rax, 0;
        jne pxgcw_fail_stage;
        call pxgc_last_zero_seen;
        cmp rax, 0;
        jne pxgcw_fail_stage;
        call pxgc_last_released;
        cmp rax, 0;
        jne pxgcw_fail_stage;
        call pxgc_total_released;
        cmp rax, 0;
        jne pxgcw_fail_stage;
        call pxgc_free_head;
        cmp rax, 0;
        jne pxgcw_fail_stage;

        // -- 2. bad-idx on free_at (free list empty).
        mov rax, 2;
        lea rcx, [rip + _pxgcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call pxgc_free_at;
        cmp rax, 0;
        jne pxgcw_fail_stage;
        call pxgc_err;
        mov r11, 0xFFFFEFDD;                    // PXGC_ERR_BAD_IDX
        cmp rax, r11;
        jne pxgcw_fail_stage;

        // -- 3. Scan on empty refcount: block 0 excluded, so
        //         zero_count = 4095.
        mov rax, 3;
        lea rcx, [rip + _pxgcw_stage];
        mov [rcx], rax;

        call pxgc_scan;
        mov r11, 4095;
        cmp rax, r11;
        jne pxgcw_fail_stage;
        call pxgc_last_zero_seen;
        cmp rax, r11;
        jne pxgcw_fail_stage;
        call pxgc_scan_count;
        cmp rax, 1;
        jne pxgcw_fail_stage;

        // -- 4. Prime refcounts: blocks 1, 2, 3 held; blocks 4, 5
        //         released. Scan reports 4093 zeroes (4096 minus 3
        //         held, but block 0 is also excluded so subtract
        //         1 - 3 = -3 from 4095 -> 4092 remaining zeros).
        // Actual math: total blocks = 4096; scanned range = [1..4096) = 4095;
        // non-zero cells in that range = 3 (blocks 1, 2, 3);
        // zero cells in that range = 4092.
        mov rax, 4;
        lea rcx, [rip + _pxgcw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call pxrc_inc;
        mov rdi, 2;
        call pxrc_inc;
        mov rdi, 3;
        call pxrc_inc;

        call pxgc_scan;
        mov r11, 4092;
        cmp rax, r11;
        jne pxgcw_fail_stage;

        // -- 5. Reset both modules; then park a known small set:
        //        seed blocks 10 and 20 as "released" (refcount == 0
        //        by default), and hold blocks 1..9 so the scan
        //        yields a well-defined count.
        mov rax, 5;
        lea rcx, [rip + _pxgcw_stage];
        mov [rcx], rax;

        call pxrc_reset;
        call pxgc_reset;

        // Hold every block from 1 to 4095 EXCEPT 10 and 20.
        xor r12, r12;
        mov r13, 4096;
      pxgcw_hold:
        add r12, 1;
        cmp r12, r13;
        jae pxgcw_hold_done;
        // Skip block 10 and 20.
        cmp r12, 10;
        je  pxgcw_hold;
        cmp r12, 20;
        je  pxgcw_hold;
        mov rdi, r12;
        call pxrc_inc;
        cmp rax, 1;
        jne pxgcw_fail_stage;
        jmp pxgcw_hold;
      pxgcw_hold_done:

        call pxgc_scan;
        cmp rax, 2;
        jne pxgcw_fail_stage;

        // -- 6. Release parks blocks 10 and 20 in that order.
        mov rax, 6;
        lea rcx, [rip + _pxgcw_stage];
        mov [rcx], rax;

        call pxgc_release;
        cmp rax, 2;
        jne pxgcw_fail_stage;
        call pxgc_last_released;
        cmp rax, 2;
        jne pxgcw_fail_stage;
        call pxgc_total_released;
        cmp rax, 2;
        jne pxgcw_fail_stage;
        call pxgc_free_head;
        cmp rax, 2;
        jne pxgcw_fail_stage;

        mov rdi, 0;
        call pxgc_free_at;
        cmp rax, 10;
        jne pxgcw_fail_stage;
        mov rdi, 1;
        call pxgc_free_at;
        cmp rax, 20;
        jne pxgcw_fail_stage;

        // -- 7. Idempotency: a second release with the same
        //         refcount state finds nothing new (duplicates
        //         suppressed).
        mov rax, 7;
        lea rcx, [rip + _pxgcw_stage];
        mov [rcx], rax;

        call pxgc_release;
        cmp rax, 0;
        jne pxgcw_fail_stage;
        call pxgc_last_released;
        cmp rax, 0;
        jne pxgcw_fail_stage;
        call pxgc_total_released;
        cmp rax, 2;
        jne pxgcw_fail_stage;
        call pxgc_free_head;
        cmp rax, 2;
        jne pxgcw_fail_stage;
        call pxgc_release_count;
        cmp rax, 2;
        jne pxgcw_fail_stage;

        // -- 8. Release picks up a newly-dropped block.
        //         Drop block 30 to zero refcount.
        mov rax, 8;
        lea rcx, [rip + _pxgcw_stage];
        mov [rcx], rax;

        mov rdi, 30;
        call pxrc_dec;
        cmp rax, 0;
        jne pxgcw_fail_stage;

        call pxgc_release;
        cmp rax, 1;
        jne pxgcw_fail_stage;
        call pxgc_free_head;
        cmp rax, 3;
        jne pxgcw_fail_stage;
        mov rdi, 2;
        call pxgc_free_at;
        cmp rax, 30;
        jne pxgcw_fail_stage;

        // Return modules to a clean state.
        call pxgc_reset;
        call pxrc_reset;
        call pxgc_bound;
        cmp rax, 1;
        jne pxgcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxgcw_ok];
        call klog_s1;

        xor rax, rax;
        jmp pxgcw_out;

      pxgcw_fail_stage:
        lea rax, [rip + _pxgcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxgcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pxgcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
