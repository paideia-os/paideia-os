// tests/kernel/fs/pdxfs/upgrade_v1_synth.pdx -- R42.M4-001 (#1392)
//
// Boot witness for the PDXFS lite -> v1 in-place upgrade module.
// Exercises reset (sb + state cleared), bad-idx-style refusals via the
// precondition ladder:
//   - upgrade before init (state-external caller): NOT_INIT
//   - upgrade before seed: NO_SOURCE
//   - upgrade with bad magic: BAD_MAGIC
//   - upgrade with journal disabled: JOURNAL_DISABLED
//   - upgrade with source already v1: ALREADY_V1
// then happy upgrade path (magic swap + inode migration + cow_head
// derivation + counters), then re-run refusal (ALREADY_V1 because
// upgrade_done is now 1), then reset-latch clears.
//
// Fingerprint: R42 PDXFS UPGRADE V1 OK
// Failure fingerprint: R42 PDXFS UPGRADE V1 FAIL + stage number.

module UpgradeV1Synth = structure {

  pub let mut _upgw_stage : u64 = 0

  pub let upgw_ok   : [u8; 26] = "R42 PDXFS UPGRADE V1 OK\n\0"
  pub let upgw_fail : [u8; 28] = "R42 PDXFS UPGRADE V1 FAIL\n\0"

  pub let upgrade_v1_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M4-001 (#1392): boot witness for pdxfs upgrade_v1. Five-push callee-save discipline. Labels prefixed upgw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + defaults.
        mov rax, 1;
        lea rcx, [rip + _upgw_stage];
        mov [rcx], rax;

        call upg_reset;
        call upg_bound;
        cmp rax, 1;
        jne upgw_fail_stage;
        call upg_err;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_magic;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_version;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_legacy_inode;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_v1_inode;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_cow_head;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_journal_enabled;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_is_done;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_inodes_migrated;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_super_swaps;
        cmp rax, 0;
        jne upgw_fail_stage;

        // -- 2. Upgrade before seed: NO_SOURCE.
        mov rax, 2;
        lea rcx, [rip + _upgw_stage];
        mov [rcx], rax;

        call upg_upgrade;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_err;
        mov r11, 0xFFFFEF4B;                    // UPG_ERR_NO_SOURCE
        cmp rax, r11;
        jne upgw_fail_stage;

        call upg_reset;

        // -- 3. Upgrade with bad magic (seeded 0xDEADBEEF):
        //         BAD_MAGIC (not LITE, not V1).
        mov rax, 3;
        lea rcx, [rip + _upgw_stage];
        mov [rcx], rax;

        mov rdi, 0xDEADBEEF;
        mov rsi, 0x1000;
        call upg_seed_lite;
        cmp rax, 1;
        jne upgw_fail_stage;

        call upg_upgrade;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_err;
        mov r11, 0xFFFFEF4C;                    // UPG_ERR_BAD_MAGIC
        cmp rax, r11;
        jne upgw_fail_stage;

        call upg_reset;

        // -- 4. Upgrade with LITE magic but journal disabled:
        //         JOURNAL_DISABLED.
        mov rax, 4;
        lea rcx, [rip + _upgw_stage];
        mov [rcx], rax;

        mov rdi, 0x504446534C31;                // UPG_MAGIC_LITE
        mov rsi, 0x2000;
        call upg_seed_lite;
        cmp rax, 1;
        jne upgw_fail_stage;
        call upg_magic;
        mov r11, 0x504446534C31;
        cmp rax, r11;
        jne upgw_fail_stage;
        call upg_version;
        cmp rax, 1;
        jne upgw_fail_stage;

        call upg_upgrade;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_err;
        mov r11, 0xFFFFEF4E;                    // UPG_ERR_JOURNAL_DISABLED
        cmp rax, r11;
        jne upgw_fail_stage;

        call upg_reset;

        // -- 5. Upgrade with V1 magic (source already v1): ALREADY_V1.
        mov rax, 5;
        lea rcx, [rip + _upgw_stage];
        mov [rcx], rax;

        mov rdi, 0x50444653563200;              // UPG_MAGIC_V1
        mov rsi, 0x3000;
        call upg_seed_lite;
        cmp rax, 1;
        jne upgw_fail_stage;
        mov rdi, 1;
        call upg_set_journal;
        cmp rax, 1;
        jne upgw_fail_stage;

        call upg_upgrade;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_err;
        mov r11, 0xFFFFEF4D;                    // UPG_ERR_ALREADY_V1
        cmp rax, r11;
        jne upgw_fail_stage;

        call upg_reset;

        // -- 6. Happy upgrade: seed LITE + inode 0x4000, journal on,
        //         run upgrade. Verify swap.
        mov rax, 6;
        lea rcx, [rip + _upgw_stage];
        mov [rcx], rax;

        mov rdi, 0x504446534C31;
        mov rsi, 0x4000;
        call upg_seed_lite;
        cmp rax, 1;
        jne upgw_fail_stage;
        mov rdi, 1;
        call upg_set_journal;
        cmp rax, 1;
        jne upgw_fail_stage;

        call upg_upgrade;
        cmp rax, 1;
        jne upgw_fail_stage;

        // Post-conditions.
        call upg_magic;
        mov r11, 0x50444653563200;
        cmp rax, r11;
        jne upgw_fail_stage;
        call upg_version;
        cmp rax, 2;
        jne upgw_fail_stage;
        call upg_legacy_inode;
        mov r11, 0x4000;
        cmp rax, r11;
        jne upgw_fail_stage;
        call upg_v1_inode;
        mov r11, 0x4000;
        cmp rax, r11;
        jne upgw_fail_stage;
        call upg_cow_head;
        mov r11, 0x5000;                        // 0x4000 + 0x1000
        cmp rax, r11;
        jne upgw_fail_stage;
        call upg_is_done;
        cmp rax, 1;
        jne upgw_fail_stage;
        call upg_inodes_migrated;
        cmp rax, 1;
        jne upgw_fail_stage;
        call upg_super_swaps;
        cmp rax, 1;
        jne upgw_fail_stage;
        call upg_err;
        cmp rax, 0;
        jne upgw_fail_stage;

        // -- 7. Re-run upgrade after success: ALREADY_V1.
        mov rax, 7;
        lea rcx, [rip + _upgw_stage];
        mov [rcx], rax;

        call upg_upgrade;
        cmp rax, 0;
        jne upgw_fail_stage;
        call upg_err;
        mov r11, 0xFFFFEF4D;                    // UPG_ERR_ALREADY_V1
        cmp rax, r11;
        jne upgw_fail_stage;
        // Counters unchanged (still 1).
        call upg_inodes_migrated;
        cmp rax, 1;
        jne upgw_fail_stage;
        call upg_super_swaps;
        cmp rax, 1;
        jne upgw_fail_stage;

        // Return module to a clean state.
        call upg_reset;
        call upg_bound;
        cmp rax, 1;
        jne upgw_fail_stage;
        call upg_err;
        cmp rax, 0;
        jne upgw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + upgw_ok];
        call klog_s1;

        xor rax, rax;
        jmp upgw_out;

      upgw_fail_stage:
        lea rax, [rip + _upgw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + upgw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      upgw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
