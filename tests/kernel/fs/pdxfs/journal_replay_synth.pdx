// tests/kernel/fs/pdxfs/journal_replay_synth.pdx -- R42.M2-003 (#1386)
//
// Boot witness for the PDXFS-v1 mount-time replay walker. Exercises
// reset (state table all PENDING), scan_from pre-flight (head - cp),
// bad-checkpoint refusal (checkpoint > head), bad-idx refusal on
// state_at, replay classification (APPLIED for committed seqs,
// DISCARDED for uncommitted), idempotency of a second replay call,
// and partial replay from a nonzero checkpoint (records before the
// checkpoint remain PENDING regardless).
//
// Fingerprint: R42 PDXFS JOURNAL REPLAY OK
// Failure fingerprint: R42 PDXFS JOURNAL REPLAY FAIL + stage number.

module JournalReplaySynth = structure {

  pub let mut _jrpw_stage : u64 = 0

  pub let jrpw_ok   : [u8; 30] = "R42 PDXFS JOURNAL REPLAY OK\n\0"
  pub let jrpw_fail : [u8; 32] = "R42 PDXFS JOURNAL REPLAY FAIL\n\0"

  pub let journal_replay_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R42.M2-003 (#1386): boot witness for pdxfs journal_replay. Resets wal + jfn + jrp. Labels prefixed jrpw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset all three modules.
        mov rax, 1;
        lea rcx, [rip + _jrpw_stage];
        mov [rcx], rax;

        call wal_reset;
        call jfn_reset;
        call jrp_reset;
        call jrp_bound;
        cmp rax, 1;
        jne jrpw_fail_stage;
        call jrp_err;
        cmp rax, 0;
        jne jrpw_fail_stage;
        call jrp_scan_count;
        cmp rax, 0;
        jne jrpw_fail_stage;
        call jrp_replay_count;
        cmp rax, 0;
        jne jrpw_fail_stage;
        call jrp_last_applied;
        cmp rax, 0;
        jne jrpw_fail_stage;
        call jrp_last_discarded;
        cmp rax, 0;
        jne jrpw_fail_stage;

        // Every state slot reads PENDING.
        mov rdi, 0;
        call jrp_state_at;
        cmp rax, 0;
        jne jrpw_fail_stage;
        mov rdi, 63;
        call jrp_state_at;
        cmp rax, 0;
        jne jrpw_fail_stage;

        // -- 2. Bad-idx refusal on state_at (idx >= 64).
        mov rax, 2;
        lea rcx, [rip + _jrpw_stage];
        mov [rcx], rax;

        mov rdi, 64;
        call jrp_state_at;
        cmp rax, 0;
        jne jrpw_fail_stage;
        call jrp_err;
        mov r11, 0xFFFFEFAD;                    // JRP_ERR_BAD_IDX
        cmp rax, r11;
        jne jrpw_fail_stage;

        call jrp_reset;

        // -- 3. Scan_from on empty WAL: head=0, checkpoint=0 -> 0.
        //         checkpoint=1 (> head) -> BAD_CHECK refusal.
        mov rax, 3;
        lea rcx, [rip + _jrpw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call jrp_scan_from;
        cmp rax, 0;
        jne jrpw_fail_stage;
        call jrp_scan_count;
        cmp rax, 1;
        jne jrpw_fail_stage;

        mov rdi, 1;
        call jrp_scan_from;
        cmp rax, 0;
        jne jrpw_fail_stage;
        call jrp_err;
        mov r11, 0xFFFFEFAE;                    // JRP_ERR_BAD_CHECK
        cmp rax, r11;
        jne jrpw_fail_stage;

        call jrp_reset;

        // -- 4. Build a WAL of 4 records; commit seqs 1 and 3.
        //         Fence once, then jfn_commit(1) and jfn_commit(3).
        //         jrp_replay(0) then classifies:
        //           idx 0 (seq 1) APPLIED
        //           idx 1 (seq 2) DISCARDED
        //           idx 2 (seq 3) APPLIED
        //           idx 3 (seq 4) DISCARDED
        mov rax, 4;
        lea rcx, [rip + _jrpw_stage];
        mov [rcx], rax;

        mov rdi, 100;
        mov rsi, 0;
        call wal_append;                        // seq=1, idx=0
        mov rdi, 100;
        mov rsi, 1;
        call wal_append;                        // seq=2, idx=1
        mov rdi, 100;
        mov rsi, 2;
        call wal_append;                        // seq=3, idx=2
        mov rdi, 100;
        mov rsi, 3;
        call wal_append;                        // seq=4, idx=3

        call jfn_fence;
        cmp rax, 4;
        jne jrpw_fail_stage;
        mov rdi, 1;
        call jfn_commit;
        cmp rax, 1;
        jne jrpw_fail_stage;
        mov rdi, 3;
        call jfn_commit;
        cmp rax, 1;
        jne jrpw_fail_stage;

        mov rdi, 0;
        call jrp_replay;
        cmp rax, 2;                             // applied
        jne jrpw_fail_stage;
        call jrp_last_applied;
        cmp rax, 2;
        jne jrpw_fail_stage;
        call jrp_last_discarded;
        cmp rax, 2;
        jne jrpw_fail_stage;
        call jrp_last_replayed_seq;
        cmp rax, 3;
        jne jrpw_fail_stage;
        call jrp_last_checkpoint;
        cmp rax, 0;
        jne jrpw_fail_stage;
        call jrp_replay_count;
        cmp rax, 1;
        jne jrpw_fail_stage;

        // -- 5. Per-index classification readback.
        mov rax, 5;
        lea rcx, [rip + _jrpw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call jrp_state_at;
        cmp rax, 1;                             // APPLIED
        jne jrpw_fail_stage;
        mov rdi, 1;
        call jrp_state_at;
        cmp rax, 2;                             // DISCARDED
        jne jrpw_fail_stage;
        mov rdi, 2;
        call jrp_state_at;
        cmp rax, 1;                             // APPLIED
        jne jrpw_fail_stage;
        mov rdi, 3;
        call jrp_state_at;
        cmp rax, 2;                             // DISCARDED
        jne jrpw_fail_stage;

        // -- 6. Idempotency: a second replay yields the same table.
        mov rax, 6;
        lea rcx, [rip + _jrpw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call jrp_replay;
        cmp rax, 2;
        jne jrpw_fail_stage;
        call jrp_replay_count;
        cmp rax, 2;
        jne jrpw_fail_stage;
        mov rdi, 0;
        call jrp_state_at;
        cmp rax, 1;
        jne jrpw_fail_stage;
        mov rdi, 1;
        call jrp_state_at;
        cmp rax, 2;
        jne jrpw_fail_stage;
        mov rdi, 2;
        call jrp_state_at;
        cmp rax, 1;
        jne jrpw_fail_stage;
        mov rdi, 3;
        call jrp_state_at;
        cmp rax, 2;
        jne jrpw_fail_stage;

        // -- 7. Partial replay from checkpoint=2. Records [0..2)
        //         must retain their prior classification (APPLIED /
        //         DISCARDED); records [2..4) reclassified afresh.
        mov rax, 7;
        lea rcx, [rip + _jrpw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        call jrp_replay;
        cmp rax, 1;                             // seq 3 alone applied
        jne jrpw_fail_stage;
        call jrp_last_discarded;
        cmp rax, 1;
        jne jrpw_fail_stage;
        call jrp_last_checkpoint;
        cmp rax, 2;
        jne jrpw_fail_stage;

        // Records 0 and 1 preserved from earlier replay.
        mov rdi, 0;
        call jrp_state_at;
        cmp rax, 1;                             // APPLIED preserved
        jne jrpw_fail_stage;
        mov rdi, 1;
        call jrp_state_at;
        cmp rax, 2;                             // DISCARDED preserved
        jne jrpw_fail_stage;

        // Records 2 and 3 reclassified.
        mov rdi, 2;
        call jrp_state_at;
        cmp rax, 1;
        jne jrpw_fail_stage;
        mov rdi, 3;
        call jrp_state_at;
        cmp rax, 2;
        jne jrpw_fail_stage;

        // -- 8. scan_from(2) returns head - checkpoint = 2.
        mov rax, 8;
        lea rcx, [rip + _jrpw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        call jrp_scan_from;
        cmp rax, 2;
        jne jrpw_fail_stage;

        mov rdi, 4;
        call jrp_scan_from;
        cmp rax, 0;
        jne jrpw_fail_stage;

        // Return modules to a clean state.
        call jrp_reset;
        call jfn_reset;
        call wal_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + jrpw_ok];
        call klog_s1;

        xor rax, rax;
        jmp jrpw_out;

      jrpw_fail_stage:
        lea rax, [rip + _jrpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + jrpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      jrpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
