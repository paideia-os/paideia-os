// tests/kernel/fs/mount_replay_digest_synth.pdx -- R51.M8-003 (#1677)
// boot witness (SUBSTRATE STUB -- see cap/mount_replay_digest.pdx §0).
//
// Design authority: design/hardware/nvme-ahci-tail-milestones.md
// (commit 2d6ab82) §2.M8 #1677; §4.4 names `tests/r51/remount-
// replay.golden` for the REAL (mount + write 32 records + unmount +
// remount + on-disk WAL replay + digest-equality) witness. That
// golden is NOT created by this file -- landing it here would falsely
// claim the round trip works when R52.M5-003 (on-disk WAL walker)
// and R52.M5-005 (mount backend) have not landed (see cap/mount_
// replay_digest.pdx §0 for the full gating rationale). This file
// proves only the two pieces reachable without either dependency:
//
//   Stage 1 (comparator correctness -- mirrors bdev_barrier.pdx's own
//   Stage-A negative-probe precedent): mrd_assert_equal(5, 5) == 0;
//   mrd_assert_equal(5, 6) == MOUNTW_REMOUNT_DIGEST_MISMATCH;
//   mrd_assert_equal(0xFFFFFFFFFFFFFFFF, 0) == the same mismatch code
//   (high-bit-set edge case, since the design-named sentinel itself
//   has bit 31 set).
//
//   Stage 2 (digest idempotency): D1 = mrd_digest_compute(); D2 =
//   mrd_digest_compute() with no intervening state change; assert
//   mrd_assert_equal(D1, D2) == 0. This proves the fold is a
//   deterministic function of currently-reachable substrate state --
//   a real prerequisite for the eventual D_pre == D_post invariant --
//   and nothing more. It does NOT mount, write, unmount, remount, or
//   replay anything.
//
// Fingerprint: "R51.M8-003 REMOUNT_DIGEST STUB OK" / "... STUB FAIL"
// -- deliberately tagged STUB so this can never be mistaken for the
// design's real M8-003 golden.

module MountReplayDigestSynth = structure {

  pub let mut _mrdw_stage : u64 = 0

  pub let mrdw_ok   : [u8; 24] = "REMOUNT_DIGEST STUB OK\n\0"
  pub let mrdw_fail : [u8; 26] = "REMOUNT_DIGEST STUB FAIL\n\0"

  // ==========================================================================
  // mount_replay_digest_witness() -> u64
  //
  // Three callee-save pushes (rbx/r12/r13) leave rsp%16==0 (entry
  // rsp%16==8, 3*8=24 -> 32, %16==0 -- no pad needed). r12/r13 hold
  // D1/D2 across the calls in Stage 2 (both callee-save, so they
  // survive the nested mrd_digest_compute / mrd_assert_equal calls).
  // ==========================================================================
  pub let mount_replay_digest_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R51.M8-003 (#1677) substrate-stub boot witness: stage 1 (comparator positive/negative/high-bit probes against mrd_assert_equal), stage 2 (mrd_digest_compute called twice back-to-back, asserted equal via mrd_assert_equal). Three callee-save pushes leave rsp%16==0 per this function's own header note. Labels prefixed mrdw_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // -----------------------------------------------------------
        // Stage 1: comparator correctness.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _mrdw_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 5;
        call mrd_assert_equal;
        cmp rax, 0;
        jne mrdw_fail_stage;

        mov rdi, 5;
        mov rsi, 6;
        call mrd_assert_equal;
        mov r10, 0xFFFFECE4;             // MOUNTW_REMOUNT_DIGEST_MISMATCH
        cmp rax, r10;
        jne mrdw_fail_stage;

        mov rdi, 0xFFFFFFFFFFFFFFFF;
        xor rsi, rsi;
        call mrd_assert_equal;
        mov r10, 0xFFFFECE4;             // MOUNTW_REMOUNT_DIGEST_MISMATCH
        cmp rax, r10;
        jne mrdw_fail_stage;

        // -----------------------------------------------------------
        // Stage 2: digest idempotency (no intervening state change).
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _mrdw_stage];
        mov [rcx], rax;

        call mrd_digest_compute;
        mov r12, rax;                    // D1

        call mrd_digest_compute;
        mov r13, rax;                    // D2

        mov rdi, r12;
        mov rsi, r13;
        call mrd_assert_equal;
        cmp rax, 0;
        jne mrdw_fail_stage;

        // -----------------------------------------------------------
        // Stamp OK, return.
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mrdw_ok];
        call klog_s1;

        xor rax, rax;
        jmp mrdw_out;

      mrdw_fail_stage:
        lea rax, [rip + _mrdw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mrdw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      mrdw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
