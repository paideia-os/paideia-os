// tests/kernel/fs/pdxfs_lite_e2e_witness.pdx — R25-M7-001 (#937)
//
// End-to-end PdxFS-lite mount-check witness — the substrate probe
// promotion recipe lives at tools/pdxfs-lite-e2e-smoke.md.
//
// -----------------------------------------------------------------------------
// What this witness PROVES at R25.M7
// -----------------------------------------------------------------------------
//
// (A) The witness symbol links into build/kernel.elf and is reachable
//     as a `call pdxfs_lite_e2e_witness` target from GDB or from a
//     future kernel_main wire-up.
//
// (B) When invoked and the PdxFS-lite mount context has been populated
//     by a successful pdxfs_lite_mount call (mounted flag = 1 at
//     _pdxfs_lite_mount_ctx + 32), the witness emits an OK fingerprint
//     that a downstream harness (tools/pdxfs-lite-e2e-smoke.md §2.1)
//     grep-matches against the serial log.
//
// (C) When invoked and the mount context is not populated (mounted
//     flag = 0), the witness emits a SKIP fingerprint. This is the
//     current QEMU-TCG -kernel path where nvme_probe returns 0 (no
//     MCFG → PCI enumerator drains empty → no driver ever attaches
//     → pdxfs_lite_mount never runs).
//
// -----------------------------------------------------------------------------
// What this witness does NOT prove (deferred to R26+)
// -----------------------------------------------------------------------------
//
// - The actual mount pipeline (NVMe probe → identify → io_queues →
//   pdxfs_lite_mount) does not fire from kernel_main at R25 close.
//   Wire-up is R25.M6 debt "driver-attach ceremony not yet wired into
//   kernel_main_uefi", chained on the same #1015 userspace-server
//   substrate as #820 acpi_supervisor + #860 pci_enumerator +
//   #906 userspace half of nvme_read_blocking.
//
// - Persistence across reboot. The full recipe at
//   tools/pdxfs-lite-e2e-smoke.md §3 gates on kernel-side
//   nvme_write_blocking (R24 debt #906 sibling) plus a
//   commit_dirty_metadata pass — neither of which exists at R25 close.
//
// - Signature verification of the mounted superblock. The R25.M5
//   dev-bypass path (pdxfs_sb_verify_sig with Features.PDXFS_DEV_KEY_
//   ONLY=1) is proven separately by pdxfs_lite_corrupt_sb_witness at
//   tests/kernel/fs/pdxfs_lite_corrupt_sb.pdx.
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary
// -----------------------------------------------------------------------------
//
//   BEGIN:            "PDXFS E2E BEGIN\n"              (16 chars incl \n; 17 with \0)
//   SKIP not mounted: "PDXFS E2E SKIP not mounted\n"   (27 chars incl \n; 28 with \0)
//   OK:               "PDXFS E2E OK mounted=1\n"       (23 chars incl \n; 24 with \0)
//   END:              "PDXFS E2E END\n"                (14 chars incl \n; 15 with \0)
//
// The OK fingerprint at R25.M7 fires only on the real-HW UEFI GDB-
// call path per tools/pdxfs-lite-e2e-smoke.md §2.1; every current
// QEMU-TCG -kernel boot lands on SKIP.
//
// -----------------------------------------------------------------------------
// Wire posture at R25.M7
// -----------------------------------------------------------------------------
//
// NOT wired into kernel_main. Same posture as pdxfs_lite_corrupt_sb_
// witness at R25.M5 close: symbol existence + build-time link
// verification are the R25.M7 acceptance criterion; live invocation
// under -kernel takes the SKIP branch, and live invocation on real
// HW is the R26+ promotion moment.
//
// The opt-in smoke `boot_r25_pdxfs_e2e` (guarded by env
// PAIDEIA_R25_PDXFS_E2E=1) is a SKIP-echo at R25 close — same posture
// as boot_r22_msix_ir_round_robin, boot_r24_concurrent_io,
// boot_r25_pdxfs_corrupt_sb.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
//   rbx = mounted flag (loaded once, retained across the two puts calls)
//
//   1 push = 8 B; entry rsp%16==8 + 8 = 16, %16==0 — aligned for
//   nested uart_puts calls. No pad required.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_e2e_` throughout.

module PdxfsLiteE2eWitness = structure {

  pub let _pdxl_e2e_begin_msg    : [u8; 17] = "PDXFS E2E BEGIN\n\0"
  pub let _pdxl_e2e_skip_msg     : [u8; 28] = "PDXFS E2E SKIP not mounted\n\0"
  pub let _pdxl_e2e_ok_msg       : [u8; 24] = "PDXFS E2E OK mounted=1\n\0"
  pub let _pdxl_e2e_end_msg      : [u8; 15] = "PDXFS E2E END\n\0"

  // ==========================================================================
  // pdxfs_lite_e2e_witness() -> u64
  //
  //   Returns:
  //     0 — SKIP (mount ctx not populated) or OK (mount ctx populated).
  //         Both are structural successes at R25.M7 — the witness's job
  //         is to prove the linkage + emit a fingerprint the operator
  //         recipe can grep. Failure at this level would be a link-time
  //         error, not a runtime return.
  //
  //   Body:
  //     (1) 1-push prologue; align stack.
  //     (2) Emit BEGIN via uart_puts.
  //     (3) Load _pdxfs_lite_mount_ctx[+32] (mounted flag) into rbx via
  //         pdxfs_lite_is_mounted (leaf helper, mem-only, returns u64 in
  //         rax) so that this witness stays decoupled from the ctx
  //         offset constants that mount_op.pdx owns.
  //     (4) cmp rbx, 0.
  //          jne pdxl_e2e_have_mount → emit OK, jump to END.
  //          fallthrough → emit SKIP, END.
  //     (5) Epilogue: xor rax,rax; pop rbx; ret.
  // ==========================================================================

  pub let pdxfs_lite_e2e_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R25-M7-001 (#937). PdxFS-lite end-to-end mount-check witness. Body: (1) 1-push callee-save prologue (rbx = mounted flag). Entry rsp%16==8 + 8 pushed = 16, %16==0 — aligned for nested uart_puts / pdxfs_lite_is_mounted calls. No pad required. (2) Emit BEGIN via lea rdi + call uart_puts. (3) Call pdxfs_lite_is_mounted (leaf mem-only per mount_op.pdx L230-236) — returns _pdxfs_lite_mount_ctx[+32] in rax. Save into rbx. (4) cmp rbx, 0; jne pdxl_e2e_have_mount. Fall-through: SKIP branch — lea rdi + call uart_puts on skip_msg; jmp pdxl_e2e_end. pdxl_e2e_have_mount: OK branch — lea rdi + call uart_puts on ok_msg; fall through. pdxl_e2e_end: emit END via lea rdi + call uart_puts. (5) Epilogue: xor rax,rax; pop rbx; ret. Reserved labels: pdxl_e2e_. Encoder: mov / lea / call / cmp / jne / jmp / xor / push / pop — all pre-existing (used by concurrent_io_witness at tests/kernel/drivers/nvme/concurrent_io.pdx and pdxfs_lite_corrupt_sb_witness at tests/kernel/fs/pdxfs_lite_corrupt_sb.pdx).",
      block: {
        push rbx;

        // ---- (2) Emit BEGIN ----
        lea rdi, [rip + _pdxl_e2e_begin_msg];
        call uart_puts;

        // ---- (3) Query mount ctx via the pdxfs_lite_is_mounted helper ----
        call pdxfs_lite_is_mounted;
        mov rbx, rax;

        // ---- (4) Branch on mount state ----
        cmp rbx, 0;
        jne pdxl_e2e_have_mount;

        // SKIP branch: no mount ctx populated (QEMU-TCG -kernel path).
        lea rdi, [rip + _pdxl_e2e_skip_msg];
        call uart_puts;
        jmp pdxl_e2e_end;

      pdxl_e2e_have_mount:
        // OK branch: mount ctx populated (real-HW UEFI path after
        // driver-attach + pdxfs_lite_mount succeed).
        lea rdi, [rip + _pdxl_e2e_ok_msg];
        call uart_puts;

      pdxl_e2e_end:
        // ---- END ----
        lea rdi, [rip + _pdxl_e2e_end_msg];
        call uart_puts;

        xor rax, rax;
        pop rbx;
        ret
      }
    }
}
