// tests/kernel/fs/pdxfs_lite_corrupt_sb.pdx — R25-M5-003 (#931)
//
// Superblock corruption fixture — proves the pdxfs_sb_verify_sig
// pathway is wired end-to-end and that dev-mode-bypass semantics
// (Features.PDXFS_DEV_KEY_ONLY=1) match the design.
//
// -----------------------------------------------------------------------------
// What this witness PROVES at R25.M5
// -----------------------------------------------------------------------------
//
// (A) A structurally-valid superblock with an all-zero sig field
//     passes verify (dev-bypass ACCEPT branch).
//
// (B) A superblock whose signed region [0, 696) has been bit-flipped
//     BUT whose sig field remains all-zero STILL passes verify. This
//     confirms that dev-mode is bypass-only — it does NOT hash /
//     inspect the signed region. When Features.CRYPTO_ML_DSA_ENABLED
//     flips to 1 (R32), the same fixture with the same tampering
//     will FAIL verify — that's the R32 acceptance test.
//
// (C) A superblock whose sig field contains any non-zero byte is
//     REJECTED even under dev-mode. This proves the bypass is not
//     a "verify nothing" mode — a garbage-sig image with random
//     bytes in the sig field will not pass.
//
// -----------------------------------------------------------------------------
// What this witness does NOT prove (deferred to R32+)
// -----------------------------------------------------------------------------
//
// - Real ML-DSA-65 signature verification. The R32 flip lands the
//   real crypto primitive; this fixture's DEV-mode expectations are
//   documented as the MVP behavior — the R32 landing SIMULTANEOUSLY
//   revises this fixture to expect FAIL on case (B) (bit-flip in
//   signed region rejected by real verify).
//
// -----------------------------------------------------------------------------
// Fake superblock storage
// -----------------------------------------------------------------------------
//
//   _pdxl_csb_fake_sb : [u64; 512] = 4 KiB @align(4096)
//     Full-sized 4 KiB superblock in .bss. .bss zero-init satisfies
//     the "sig field is all zero" invariant for cases (A) and (B).
//     Case (C) writes a non-zero byte into the sig field then
//     restores it.
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary
// -----------------------------------------------------------------------------
//
//   OK:   "PDXFS CORRUPT SB OK\n"     (20 chars incl \n; 21 with \0)
//   FAIL: "PDXFS CORRUPT SB FAIL\n"   (22 chars incl \n; 23 with \0)
//
// -----------------------------------------------------------------------------
// Wire posture at R25.M5
// -----------------------------------------------------------------------------
//
// NOT wired into kernel_main. Same posture as msix_ir_round_robin_
// witness at R22.M6 close: the symbol existence + build-time link
// verification are the R25.M5 acceptance criterion; live invocation
// is deferred to an opt-in smoke gate driven by the pre-push env
// var PAIDEIA_R25_PDXFS_CORRUPT=1, which under `-kernel` boot returns
// a SKIP-echo (no live NVMe → no real mount path → witness is proof
// of link, not proof of runtime).
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
//   rbx = &_pdxl_csb_fake_sb (persistent base pointer across the
//         three verify calls + the corruption edits).
//
//   1 push = 8 B. entry rsp%16==8 + 8 = 16, %16==0 — aligned for
//   nested calls to pdxfs_lite_pubkey_ptr / pdxfs_sb_verify_sig /
//   uart_puts. No pad required.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_csb_` throughout.

module PdxfsLiteCorruptSb = structure {

  pub let mut _pdxl_csb_fake_sb    : [u64; 512] = uninit @align(4096)

  pub let _pdxl_csb_ok_msg   : [u8; 21] = "PDXFS CORRUPT SB OK\n\0"
  pub let _pdxl_csb_fail_msg : [u8; 23] = "PDXFS CORRUPT SB FAIL\n\0"

  // Constants — mirrored from superblock.pdx.
  pub let PDXL_CSB_SIG_OFFSET      : u64 = 696    // start of sig field
  pub let PDXL_CSB_SIG_LEN         : u64 = 3400   // sig byte length
  pub let PDXL_CSB_SIG_QWORDS      : u64 = 425    // 3400/8

  // ==========================================================================
  // pdxfs_lite_corrupt_sb_witness() -> ()
  //
  // Body:
  //   (0) 1-push prologue (rbx = _pdxl_csb_fake_sb base).
  //   (1) Zero _pdxl_csb_fake_sb (512 qwords).
  //   (2) Stamp a valid superblock skeleton:
  //         [+0]  magic       = 0x4C584450 (u32)
  //         [+4]  version     = 1 (u32)
  //         [+24] block_size  = 4096 (u32)
  //         [+32] itable_lba  = 1 (u64)
  //         [+64] root_ino    = 1 (u64)
  //       All other bytes stay zero — including the entire sig field
  //       [696, 4096).
  //   (3) Case (A): call pdxfs_sb_verify_sig(rbx, pdxfs_lite_pubkey_ptr()).
  //       Expect rax == 1 (dev-bypass ACCEPT). Else FAIL.
  //   (4) Case (B): tamper byte in signed region — byte [100] = 0xFF.
  //       Call verify. Expect rax == 1 (sig still all-zero → dev bypass
  //       still accepts). Else FAIL. Restore byte [100] = 0.
  //   (5) Case (C): tamper byte in sig field — byte [696] = 0x01.
  //       Call verify. Expect rax == 0 (non-zero sig byte → dev-bypass
  //       REJECTS). Else FAIL. Restore byte [696] = 0.
  //   (6) Emit OK.
  //   Fail branch emits FAIL and returns.
  // ==========================================================================

  pub let pdxfs_lite_corrupt_sb_witness : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R25-M5-003 (#931). Structural superblock corruption fixture. Body: (0) 1-push prologue (rbx = _pdxl_csb_fake_sb base). Entry rsp%16==8 + 8 pushed = 16, %16==0 — aligned for all nested calls. (1) Zero 4 KiB fake superblock via 512-qword tight loop (xor rax,rax; xor rcx,rcx; loop while cmp rcx,512; mov [rbx+rcx*8],rax; add rcx,1). (2) Stamp fixed fields: mov_d [rbx+0]=0x4C584450 (magic); mov_d [rbx+4]=1 (version); mov_d [rbx+24]=4096 (block_size); mov [rbx+32]=1 (itable_lba); mov [rbx+64]=1 (root_ino). (3) Case A: call pdxfs_lite_pubkey_ptr; mov rsi, rax; mov rdi, rbx; call pdxfs_sb_verify_sig; cmp rax,1; jne fail. (4) Case B: mov_b [rbx+100]=0xFF; call chain again; expect rax==1; jne fail. Restore mov_b [rbx+100]=0. (5) Case C: mov_b [rbx+696]=1; call chain again; expect rax==0; jne fail. Restore mov_b [rbx+696]=0. (6) Emit OK via lea rdi + call uart_puts. Fail branch: emit FAIL + fall to epilogue. (7) Epilogue: pop rbx; ret. Reserved labels: pdxl_csb_. Encoder: mov / mov_b / mov_d / cmp / jne / lea / call — all pre-existing.",
      block: {
        push rbx;

        // ---- (0) rbx = &_pdxl_csb_fake_sb ----
        lea rbx, [rip + _pdxl_csb_fake_sb];

        // ---- (1) Zero 4 KiB (512 qwords) ----
        xor rax, rax;
        xor rcx, rcx;
      pdxl_csb_zero:
        cmp rcx, 512;
        jae pdxl_csb_zero_done;
        mov [rbx + rcx * 8], rax;
        add rcx, 1;
        jmp pdxl_csb_zero;
      pdxl_csb_zero_done:

        // ---- (2) Stamp fixed fields ----
        // magic (u32 @ +0) = 0x4C584450 ("PDXL")
        mov rax, 0x4C584450;
        mov_d [rbx + 0], rax;

        // version (u32 @ +4) = 1
        mov rax, 1;
        mov_d [rbx + 4], rax;

        // block_size (u32 @ +24) = 4096
        mov rax, 4096;
        mov_d [rbx + 24], rax;

        // itable_lba (u64 @ +32) = 1
        mov rax, 1;
        mov [rbx + 32], rax;

        // root_ino (u64 @ +64) = 1
        mov rax, 1;
        mov [rbx + 64], rax;

        // ---- (3) Case (A): pristine valid sb with all-zero sig -> PASS ----
        call pdxfs_lite_pubkey_ptr;
        mov rsi, rax;
        mov rdi, rbx;
        call pdxfs_sb_verify_sig;
        cmp rax, 1;
        jne pdxl_csb_fail;

        // ---- (4) Case (B): bit-flip signed region [100] -> still PASS ----
        // Under dev-bypass the signed region is NOT inspected — only
        // the sig field is. So tampering at [100] leaves the verify
        // result unchanged.
        mov rax, 0xFF;
        mov_b [rbx + 100], rax;

        call pdxfs_lite_pubkey_ptr;
        mov rsi, rax;
        mov rdi, rbx;
        call pdxfs_sb_verify_sig;
        cmp rax, 1;
        jne pdxl_csb_fail;

        // Restore byte [100] = 0 so the state is pristine for case (C).
        xor rax, rax;
        mov_b [rbx + 100], rax;

        // ---- (5) Case (C): non-zero byte in sig field -> REJECT ----
        // Even under dev-bypass, a non-zero byte anywhere in the
        // 3400-byte sig field causes the OR-accumulator to be non-zero,
        // and pdxfs_sb_verify_sig returns 0.
        mov rax, 1;
        mov_b [rbx + 696], rax;

        call pdxfs_lite_pubkey_ptr;
        mov rsi, rax;
        mov rdi, rbx;
        call pdxfs_sb_verify_sig;
        cmp rax, 0;
        jne pdxl_csb_fail;

        // Restore sig[0] = 0.
        xor rax, rax;
        mov_b [rbx + 696], rax;

        // ---- (6) Emit OK ----
        lea rdi, [rip + _pdxl_csb_ok_msg];
        call uart_puts;
        jmp pdxl_csb_done;

      pdxl_csb_fail:
        lea rdi, [rip + _pdxl_csb_fail_msg];
        call uart_puts;

      pdxl_csb_done:
        pop rbx;
        ret
      }
    }
}
