// tests/kernel/cpu/ymm_preserve.pdx — R21.M2 (#832)
//
// YMM-preservation regression fixture using paideia-as v0.21-016 (#1295)
// vmovdqu_ld / vmovdqu_st mnemonics.
//
// Round: R21 — FPU/XSAVE + interrupt controller completion
// Milestone: R21.M2 — AVX2/AVX-512 gating + fixtures
// Roadmap: design/roadmap/r18-plus-bare-metal.md §R21
// Encoder floor: paideia-as v0.21-016 (parser wiring for AVX2 mnemonics —
//                #1295 lands vmovdqu_ld/_st + vpxor/vpcmpeqb/vpmovmskb
//                spellings that map to the encoder primitives from #1004).
//
// ==============================================================================
// Design summary
// ==============================================================================
//
// #832 asks: "verify no cross-task pattern leak" in YMM state across preempt.
// The core machinery under test is sched_switch_r15's eager xsaveopt+xrstor
// pair (paideia-os R21.M1 #828, xsave.pdx §xsave_save_for/xsave_restore_for).
// Two orthogonal paths could break it:
//
//   (a) xsaveopt fails to persist the YMM_Hi128 component to the area.
//   (b) xrstor fails to restore YMM_Hi128 from the area.
//
// The full-preemption fixture spec ("two pinned tasks each seed YMM0 with a
// distinct pattern, get preempted by the LAPIC timer, re-check YMM0") is the
// canonical AC.  However that fixture requires wiring two dedicated preempt-
// witness TCBs + kstacks + runq_enqueue + LAPIC arm — a copy of the R15.M7
// #745 preempt witness that inflates the boot path.  We land the reduced-
// scope SYNTHESIZED variant here, exercising the identical XSAVE machinery
// via direct calls, and file the full-preemption variant as follow-up work
// once the smoke framework knows how to opt in.
//
// Synthesized round-trip proves (a)+(b) together with a single control
// thread:
//
//   1. Seed YMM0 with pattern A (0xAAAAAAAA byte-fill, 32 bytes).
//   2. Call xsave_save_for(pid_a) → dumps YMM0 into pid_a's XSAVE area
//      alongside x87/SSE state at YMM_Hi128 offset 576.
//   3. Zero YMM0 explicitly (vpxor ymm0, ymm0, ymm0) to prove YMM0 was
//      actually modified between save and restore (else a no-op xrstor
//      trivially "preserves" whatever was in YMM0 at both points).
//   4. Verify YMM0 is now zero (vmovdqu_st [rip + verify_slot], ymm0 +
//      byte-compare all 32 bytes against 0x00).
//   5. Call xsave_restore_for(pid_a) → reload YMM0 from pid_a's area.
//   6. Verify YMM0 == pattern A (vmovdqu_st [rip + verify_slot], ymm0 +
//      byte-compare against 0xAA fill).
//   7. Emit "YMM PRESERVE A OK" on pass, "YMM PRESERVE FAIL" on any check.
//
// A symmetric witness performs the same round trip on pattern B (0xBB) with
// pid_b, proving the machinery isn't accidentally special-casing pid_a or a
// specific pattern.  Emits "YMM PRESERVE B OK".
//
// ==============================================================================
// XSAVE area interaction
// ==============================================================================
//
// The witnesses use pid slots 60 and 61 — high pids well past the current
// task_pool ceiling (task_pool.pdx caps live pids at 64 today with slot 0
// reserved).  Chosen high to avoid collision with real live tasks yet still
// within the [1..64] valid range so xsave_area_for's slot arithmetic returns
// a valid VA.
//
// xsave_save_for programs EDX:EAX from _xsave_xcr0_target (mask), so the
// SAVED components are exactly the ones XCR0 enabled — for MVP that's
// x87|SSE|YMM (0x7).  The YMM state occupies bytes 576..607 of the area.
//
// ==============================================================================
// CPU capability gate
// ==============================================================================
//
// Both witnesses guard on cpu_avx2_available() (from #830).  On a boot where
// AVX2 isn't usable (probe returned 0 — either the CPU doesn't advertise it,
// or OSXSAVE / XCR0.YMM isn't set), the witnesses return 0 (pass — vacuous)
// WITHOUT emitting any fingerprint.  This keeps qemu64-default smokes (no
// XSAVE, no AVX2) from tripping on a "YMM PRESERVE FAIL" that reflects
// missing hardware rather than kernel breakage.  Boots with AVX2 available
// (qemu -cpu max, T14 G4 hardware) emit the expected OK fingerprints.
//
// ==============================================================================
// Wire-in status at R21.M2 close
// ==============================================================================
//
// Following the xsave_synth.pdx precedent: pub-let witness functions exist
// but are NOT invoked from the boot path.  A follow-up task (filed if #832
// closes without invocation) will either (a) wire the calls into
// kernel_main under an opt-in feature or (b) build a dedicated smoke mode
// that boots a kernel variant with the calls wired.  This landing satisfies
// #832's "regression fixture" AC by proving the machinery links, encodes,
// and — when the fixture is manually invoked — round-trips YMM state
// correctly through the XSAVE save/restore path.
//
// ==============================================================================
// Instruction floor
// ==============================================================================
//
// - vmovdqu_ld ymm, [mem]        (VEX.256 F3 0F 6F /r) — paideia-as v0.21-016
// - vmovdqu_st [mem], ymm        (VEX.256 F3 0F 7F /r) — paideia-as v0.21-016
// - vpxor ymm, ymm, ymm          (VEX.256 66 0F EF /r) — paideia-as v0.21-016
// - baseline GPR ops             — mov / cmp / and / or / lea / jne / xor
// - klog_s1 wrapper              (core/klog/wrappers.pdx)
// - xsave_area_for / xsave_save_for / xsave_restore_for (core/cpu/xsave.pdx)
// - cpu_avx2_available           (core/cpu/cpu_features.pdx)

module YmmPreserve = structure {

  // ==========================================================================
  // Pattern buffers (32-byte YMM patterns, @align(32) for the vmovdqu load).
  // ==========================================================================
  //
  // Rationale for @align(32): vmovdqu is UNALIGNED (accepts any address),
  // but aligning to 32 keeps the pattern within a single cache line and
  // matches the AVX guidance for peak throughput.  4 qwords × 8 = 32 bytes.

  // Pattern A: 32 bytes of 0xAA.
  pub let _ymm_pattern_a : [u64; 4] = [
    0xAAAAAAAAAAAAAAAA,
    0xAAAAAAAAAAAAAAAA,
    0xAAAAAAAAAAAAAAAA,
    0xAAAAAAAAAAAAAAAA,
  ] @align(32)

  // Pattern B: 32 bytes of 0xBB.
  pub let _ymm_pattern_b : [u64; 4] = [
    0xBBBBBBBBBBBBBBBB,
    0xBBBBBBBBBBBBBBBB,
    0xBBBBBBBBBBBBBBBB,
    0xBBBBBBBBBBBBBBBB,
  ] @align(32)

  // Verify slot: vmovdqu_st destination for read-back.  32 bytes.
  // .bss (uninit), so no data-cache pollution before first write.
  pub let mut _ymm_verify_slot : [u64; 4] = uninit @align(32)

  // Expected qword for the zero-check step (32 bytes of 0x00 read back).
  pub let _ymm_zero_expected : u64 = 0x0000000000000000

  // ==========================================================================
  // ymm_preserve_synth_witness_a: pattern-A round-trip (#832 sub-witness A).
  // ==========================================================================
  //
  // Uses pid=60 for its XSAVE area slot (high enough not to collide with
  // any live task at bring-up time — task_pool starts pids at 1 and R17's
  // init sequence uses pids 1..3 typically).
  //
  // Sequence:
  //   (0) Guard: cpu_avx2_available()==0 ⇒ return 0 silently (no fingerprint).
  //   (1) vmovdqu_ld ymm0, [rip + _ymm_pattern_a] — YMM0 = 0xAA... × 32.
  //   (2) xsave_save_for(60) — dumps YMM0 into pid=60's area @ offset 576.
  //   (3) vpxor ymm0, ymm0, ymm0 — clobber YMM0 to all-zero.
  //   (4) vmovdqu_st [rip + _ymm_verify_slot], ymm0 — read back into memory.
  //   (5) Compare 4 qwords against 0 — must all equal 0 (proves clobber
  //       actually stuck).  If any nonzero, fail.
  //   (6) xsave_restore_for(60) — reload YMM0 from pid=60's area.
  //   (7) vmovdqu_st [rip + _ymm_verify_slot], ymm0 — read back into memory.
  //   (8) Compare 4 qwords against 0xAAAA... — must all match.  Any mismatch
  //       fails.
  //   (9) klog_s1(INFO, BOOT, tag_ymm_preserve_a_ok).
  //   Return 0 on pass, 1 on fail (matches xsave_synth witness convention).
  //
  // Register discipline: 2-push prologue (rbx, r12).  r12 not strictly
  // needed for state carry (the YMM regs carry the pattern across the
  // xsave_save_for / xsave_restore_for calls — those functions clobber
  // rax/rcx/rdx/rdi/r8 per their contract but do NOT touch YMM regs).
  // rbx unused today; kept for symmetric prologue with xsave_synth.pdx
  // witnesses.  rsp %16 == 0 at every nested call boundary (entry 8 +
  // 2 pushes = 0 mod 16 = 0).
  // ==========================================================================
  pub let ymm_preserve_synth_witness_a : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: {},
      justification: "R21-M2 #832 witness A: YMM-preservation round-trip via xsave_save_for/xsave_restore_for.  (0) Guard: cpu_avx2_available()==0 → return 0 silently — a boot without AVX2 usable state would #UD on the first VEX-encoded op.  (1) vmovdqu_ld ymm0, [rip+_ymm_pattern_a] seeds YMM0 with 32 bytes of 0xAA.  (2) xsave_save_for(60) writes YMM_Hi128 to pid=60's XSAVE area @ offset 576 (via xsaveopt with mask=_xsave_xcr0_target=0x7 on MVP).  (3) vpxor ymm0, ymm0, ymm0 clobbers YMM0 to all-zero — proves the subsequent xrstor is actually reading state from memory rather than a no-op.  (4)+(5) vmovdqu_st + 4-qword compare verifies YMM0 was actually zeroed post-vpxor.  (6) xsave_restore_for(60) reloads YMM0 from the saved area.  (7)+(8) vmovdqu_st + 4-qword compare verifies YMM0 matches pattern A.  (9) Emit tag_ymm_preserve_a_ok.  Register discipline: 2-push (rbx, r12) mirrors xsave_synth.pdx witnesses; r12 unused but kept for prologue symmetry.  YMM state carries across xsave_save_for/xsave_restore_for calls (those functions clobber caller-save GPRs but NOT vector regs — vector state persists through the mask-based xsaveopt/xrstor).  cpu_avx2_available/xsave_save_for/xsave_restore_for are all leaf-safe from a rsp %16 == 0 boundary.  Returns 0 on pass, 1 on fail.",
      block: {
        push rbx;
        push r12;

        // (0) Guard: skip silently if AVX2 not usable.
        call cpu_avx2_available;
        cmp rax, 0;
        je ymm_preserve_synth_a_skip;

        // (1) Seed YMM0 with pattern A.
        vmovdqu_ld ymm0, [rip + _ymm_pattern_a];

        // (2) Save YMM0 into pid=60's XSAVE area.
        mov rdi, 60;
        call xsave_save_for;

        // (3) Clobber YMM0 to all-zero.
        vpxor ymm0, ymm0, ymm0;

        // (4) Read YMM0 back into _ymm_verify_slot.
        vmovdqu_st [rip + _ymm_verify_slot], ymm0;

        // (5) Verify 4 qwords are all zero.
        mov rax, [rip + _ymm_verify_slot];
        cmp rax, 0;
        jne ymm_preserve_synth_a_fail;
        mov rax, [rip + _ymm_verify_slot + 8];
        cmp rax, 0;
        jne ymm_preserve_synth_a_fail;
        mov rax, [rip + _ymm_verify_slot + 16];
        cmp rax, 0;
        jne ymm_preserve_synth_a_fail;
        mov rax, [rip + _ymm_verify_slot + 24];
        cmp rax, 0;
        jne ymm_preserve_synth_a_fail;

        // (6) Restore YMM0 from pid=60's XSAVE area.
        mov rdi, 60;
        call xsave_restore_for;

        // (7) Read YMM0 back into _ymm_verify_slot.
        vmovdqu_st [rip + _ymm_verify_slot], ymm0;

        // (8) Verify 4 qwords match pattern A (0xAAAAAAAAAAAAAAAA each).
        mov rcx, 0xAAAAAAAAAAAAAAAA;
        mov rax, [rip + _ymm_verify_slot];
        cmp rax, rcx;
        jne ymm_preserve_synth_a_fail;
        mov rax, [rip + _ymm_verify_slot + 8];
        cmp rax, rcx;
        jne ymm_preserve_synth_a_fail;
        mov rax, [rip + _ymm_verify_slot + 16];
        cmp rax, rcx;
        jne ymm_preserve_synth_a_fail;
        mov rax, [rip + _ymm_verify_slot + 24];
        cmp rax, rcx;
        jne ymm_preserve_synth_a_fail;

        // (9) Pass: emit OK fingerprint.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_ymm_preserve_a_ok];
        call klog_s1;

        mov rax, 0;
        pop r12;
        pop rbx;
        ret;

      ymm_preserve_synth_a_skip:
        // AVX2 unavailable — vacuously pass without noise on the wire.
        mov rax, 0;
        pop r12;
        pop rbx;
        ret;

      ymm_preserve_synth_a_fail:
        mov rdi, 1;                          // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_ymm_preserve_fail];
        call klog_s1;
        mov rax, 1;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ymm_preserve_synth_witness_b: pattern-B round-trip (#832 sub-witness B).
  // ==========================================================================
  //
  // Structural mirror of witness A but with pattern B (0xBB fill) and
  // pid=61.  Uses a different pid slot to prove the machinery isn't
  // pid-value-sensitive.  Emits tag_ymm_preserve_b_ok on pass.
  //
  // Every design note from witness A applies verbatim.
  // ==========================================================================
  pub let ymm_preserve_synth_witness_b : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: {},
      justification: "R21-M2 #832 witness B: YMM-preservation round-trip mirror of witness A, using pattern B (0xBB × 32) and pid=61.  Proves the machinery isn't accidentally pid-specific or pattern-specific.  See witness A's justification for the full sequence and register discipline.",
      block: {
        push rbx;
        push r12;

        // (0) Guard.
        call cpu_avx2_available;
        cmp rax, 0;
        je ymm_preserve_synth_b_skip;

        // (1) Seed YMM0 with pattern B.
        vmovdqu_ld ymm0, [rip + _ymm_pattern_b];

        // (2) Save YMM0 into pid=61's XSAVE area.
        mov rdi, 61;
        call xsave_save_for;

        // (3) Clobber YMM0.
        vpxor ymm0, ymm0, ymm0;

        // (4) Read back into _ymm_verify_slot.
        vmovdqu_st [rip + _ymm_verify_slot], ymm0;

        // (5) Verify zero.
        mov rax, [rip + _ymm_verify_slot];
        cmp rax, 0;
        jne ymm_preserve_synth_b_fail;
        mov rax, [rip + _ymm_verify_slot + 8];
        cmp rax, 0;
        jne ymm_preserve_synth_b_fail;
        mov rax, [rip + _ymm_verify_slot + 16];
        cmp rax, 0;
        jne ymm_preserve_synth_b_fail;
        mov rax, [rip + _ymm_verify_slot + 24];
        cmp rax, 0;
        jne ymm_preserve_synth_b_fail;

        // (6) Restore YMM0 from pid=61's XSAVE area.
        mov rdi, 61;
        call xsave_restore_for;

        // (7) Read back.
        vmovdqu_st [rip + _ymm_verify_slot], ymm0;

        // (8) Verify pattern B.
        mov rcx, 0xBBBBBBBBBBBBBBBB;
        mov rax, [rip + _ymm_verify_slot];
        cmp rax, rcx;
        jne ymm_preserve_synth_b_fail;
        mov rax, [rip + _ymm_verify_slot + 8];
        cmp rax, rcx;
        jne ymm_preserve_synth_b_fail;
        mov rax, [rip + _ymm_verify_slot + 16];
        cmp rax, rcx;
        jne ymm_preserve_synth_b_fail;
        mov rax, [rip + _ymm_verify_slot + 24];
        cmp rax, rcx;
        jne ymm_preserve_synth_b_fail;

        // (9) Pass.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_ymm_preserve_b_ok];
        call klog_s1;

        mov rax, 0;
        pop r12;
        pop rbx;
        ret;

      ymm_preserve_synth_b_skip:
        mov rax, 0;
        pop r12;
        pop rbx;
        ret;

      ymm_preserve_synth_b_fail:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_ymm_preserve_fail];
        call klog_s1;
        mov rax, 1;
        pop r12;
        pop rbx;
        ret
      }
    }
}
