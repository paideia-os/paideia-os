// tests/kernel/cpu/xsave_synth.pdx — R21-M1 XSAVE synthesis witness
//
// Issues: #825 / #826 / #827 / #828 / #829
// Round: R21 milestone M1 — XSAVE area sizing + eager save/restore
//
// This is a synthetic fixture (pattern parallel to tests/kernel/acpi/xsdt_
// synth.pdx and tests/kernel/mm/tlb_shootdown_race.pdx): it defines a top-
// level pub witness function callable via GDB or a wire-in-then-remove
// debug call site.  At R21.M1 close it is NOT invoked from the boot path
// — the on-wire fingerprints emitted by xsave_probe_bsp / xsave_enable_
// this_cpu (klog lines "XSAVE PROBE OK ..." and "XSAVE ENABLED xcr0=...")
// carry the end-to-end acceptance signal for #825/#826.  The witness here
// covers the structural claims for #827/#828/#829 that don't lend themselves
// to a wire fingerprint alone.
//
// ==============================================================================
// What each sub-witness proves
// ==============================================================================
//
// (A) xsave_area_for_pid_is_aligned_and_stride_correct (#827):
//     - Loop pid ∈ [0..64]: verify xsave_area_for(pid) & 63 == 0 (alignment).
//     - Verify xsave_area_for(pid+1) - xsave_area_for(pid) == 4096 (stride).
//     Fails if the arithmetic ever drifts from the design.
//
// (B) xstate_bv_zero_after_init (#829):
//     - Call xsave_area_init_for_pid(42) on a synthetic pid.
//     - Read [xsave_area_for(42) + 512] (XSTATE_BV) and [+520] (XCOMP_BV).
//     - Both must be 0.
//     - Read one qword of the reserved region ([+528]) — must also be 0.
//     Fails if the init function forgets to zero any of the 64 header bytes.
//
// (C) xsave_area_survives_round_trip (#828, weak variant):
//     - Write a distinctive u64 (0xDEADBEEFCAFE1234) into the LEGACY REGION
//       at [xsave_area_for(43) + 0] (the FCW/FSW slot — an area xsaveopt
//       would rewrite on a real save).
//     - Read it back — must round-trip.  Proves the area is writable at all,
//       and that the alignment doesn't collide with a read-only page.
//     This is a substitute for the full YMM-preservation fixture that #828
//     requests but which requires SIMD emit support (vmovdqa) that
//     paideia-as v0.20.1 doesn't have yet.  When SIMD lands (paideia-as
//     #1004 / v0.21+ AVX2 mnemonics), a companion sub-witness (D) will
//     xsaveopt with mask=0x7 to write YMM state into the area, then xrstor
//     into a scratch YMM slot and compare — proving the wire-in
//     sched_switch_r15 save/restore preserves SIMD state across preemption.
//
// (D) xsave_probe_globals_are_populated_or_all_zero (#825/#826):
//     - Read Xsave._xsave_supported_mask, _xsave_xcr0_target, _xsave_area_size.
//     - Two valid outcomes:
//         (a) All zero (probe hit no_support branch — CPU doesn't advertise
//             XSAVE via CPUID.01H:ECX bit 26).
//         (b) supported_mask & 0x3 == 0x3 (must include x87+SSE), xcr0_target
//             & 0x3 == 0x3, area_size >= 576 (legacy region + header at
//             minimum).
//     Fails if we're in a "half-configured" state: supported mask populated
//     but target or size zero, or vice versa.
//
// ==============================================================================
// Register / call discipline
// ==============================================================================
//
// Every sub-witness is a leaf-ish function with 1-3 pushes for callee-save
// discipline into the nested xsave_area_for / xsave_area_init_for_pid calls.
// Emits an "XSAVE SYNTH OK" fingerprint on the wire when the whole suite
// passes; specific FAIL lines pinpoint which sub-witness tripped.

module XsaveSynth = structure {

  // ============================================================================
  // Fingerprint markers
  // ============================================================================

  pub let xsave_synth_ok_msg           : [u8; 15] = "XSAVE SYNTH OK\0"
  pub let xsave_synth_align_fail_msg   : [u8; 21] = "XSAVE SYNTH ALIGN\0   "
  pub let xsave_synth_stride_fail_msg  : [u8; 22] = "XSAVE SYNTH STRIDE\0  "
  pub let xsave_synth_init_fail_msg    : [u8; 20] = "XSAVE SYNTH INIT\0   "
  pub let xsave_synth_rt_fail_msg      : [u8; 18] = "XSAVE SYNTH RT\0   "
  pub let xsave_synth_globals_fail_msg : [u8; 23] = "XSAVE SYNTH GLOBALS\0  "

  // ============================================================================
  // Sub-witness (A): alignment + stride sweep.
  // Loops pid ∈ [0..65).  Verifies each returned VA is 64-aligned and the
  // stride between consecutive slots is exactly 4096.
  //
  // Uses xsave_area_for(pid) which is a leaf function returning &_task_xsave_
  // areas + pid*4096.  On return the caller's caller-save regs are clobbered
  // per SysV; we spill loop state to r12/r13.
  // ============================================================================
  pub let xsave_synth_check_align_and_stride : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R21-M1 #827 witness (A): alignment + stride sweep over Xsave._task_xsave_areas.  Loop pid ∈ [0..65).  For each pid, call xsave_area_for(pid) — its contract is `&_task_xsave_areas + pid<<12`.  Verify `rax & 63 == 0` (64-alignment, the SDM Vol 2 XSAVE minimum) and `rax - prev == 4096` for pid > 0 (stride).  r12 = pid loop var (0..65), r13 = previous slot VA (0 sentinel for pid==0 skip-stride path), r14 = current slot VA scratch across the compare-loop.  3-push prologue keeps rsp %16 == 8 at nested call boundary.  On first-iteration pid==0 the stride check is skipped (no previous VA); on subsequent iterations rax = current VA, subtract r13 = prev VA, cmp 4096 or jump to fail. Returns 0 on pass, 1 on fail. Fingerprint emitted at first failure via klog_s1 to pinpoint the tripped sub-witness.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        xor r12, r12;                        // pid = 0
        xor r13, r13;                        // prev_va = 0

      xsave_synth_align_loop:
        cmp r12, 65;                         // pid < 65 (XSAVE_AREA_SLOTS)
        jae xsave_synth_align_pass;

        mov rdi, r12;                        // arg: pid
        call xsave_area_for;                 // rax = &_task_xsave_areas + pid<<12
        mov r14, rax;                        // stash current VA

        // (A.1) Alignment: rax & 63 == 0
        mov rcx, rax;
        and rcx, 63;
        cmp rcx, 0;
        jne xsave_synth_align_fail;

        // (A.2) Stride: if pid > 0, rax - prev == 4096.
        cmp r12, 0;
        je xsave_synth_align_skip_stride;
        mov rcx, r14;
        sub rcx, r13;
        cmp rcx, 4096;
        jne xsave_synth_stride_fail;

      xsave_synth_align_skip_stride:
        mov r13, r14;                        // prev = current
        add r12, 1;                          // ++pid
        jmp xsave_synth_align_loop;

      xsave_synth_align_pass:
        mov rax, 0;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      xsave_synth_align_fail:
        mov rdi, 1;                          // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + xsave_synth_align_fail_msg];
        call klog_s1;
        mov rax, 1;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      xsave_synth_stride_fail:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + xsave_synth_stride_fail_msg];
        call klog_s1;
        mov rax, 1;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // Sub-witness (B): XSTATE_BV / XCOMP_BV / reserved header zeroed after init.
  //
  // Calls xsave_area_init_for_pid(42) on a synthetic pid slot (any pid in
  // [0..65) works — 42 chosen to be well within bounds without colliding
  // with the R21.M1 task_new smoke-test path).  Then reads XSTATE_BV
  // (+512), XCOMP_BV (+520), and the first qword of the reserved 48-byte
  // region (+528).  All three must be zero.
  //
  // The area is FIRST clobbered with 0xFF-fill (to prove init actually
  // writes zeros rather than just relying on .bss being zero already), then
  // init'd, then verified.
  // ============================================================================
  pub let xsave_synth_check_xstate_bv_zero : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R21-M1 #829 witness (B): XSTATE_BV/XCOMP_BV/reserved-region zero after xsave_area_init_for_pid.  Sequence: (1) get pid=42's area base via xsave_area_for(42) → rax.  (2) Stash into r12 (callee-save across nested calls).  (3) Clobber the header region with 0xFF fill: 8 qwords of 0xFFFFFFFFFFFFFFFF at [r12+512..r12+575] via a rep_stosq loop.  This proves init actively writes zero rather than passively relying on .bss being zero (which would false-pass in a fresh boot).  (4) Call xsave_area_init_for_pid(42) which zeros the 64-byte header.  (5) Verify [r12+512] == 0 (XSTATE_BV), [r12+520] == 0 (XCOMP_BV), [r12+528] == 0 (first reserved qword).  If any is non-zero, emit FAIL and return 1.  Register discipline: r12 = area base across all nested calls (callee-save).  4-push prologue lands rsp %16 == 8 at nested call boundary.  Returns 0 on pass.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        // (1) & (2): area base into r12.
        mov rdi, 42;
        call xsave_area_for;
        mov r12, rax;

        // (3) Clobber header with 0xFF.
        //     rep stosq needs: rdi=dst, rcx=count, rax=fill.
        lea rdi, [r12 + 512];                // XSAVE_HEADER_OFFSET
        mov rcx, 8;                          // 8 qwords = 64 bytes
        mov rax, 0xFFFFFFFFFFFFFFFF;
        rep_stosq;

        // (4) Init — must zero all 64 bytes.
        mov rdi, 42;
        call xsave_area_init_for_pid;

        // (5) Verify: [r12+512] == 0.
        mov rax, [r12 + 512];
        cmp rax, 0;
        jne xsave_synth_init_fail;

        // XCOMP_BV [r12+520] == 0.
        mov rax, [r12 + 520];
        cmp rax, 0;
        jne xsave_synth_init_fail;

        // Reserved region first qword [r12+528] == 0.
        mov rax, [r12 + 528];
        cmp rax, 0;
        jne xsave_synth_init_fail;

        mov rax, 0;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      xsave_synth_init_fail:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + xsave_synth_init_fail_msg];
        call klog_s1;
        mov rax, 1;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // Sub-witness (C): area is writable + round-trips a u64 through the legacy
  // region ([xsave_area_for(43) + 0]).  Proxy for the full SIMD round-trip
  // that awaits paideia-as SIMD encoder work.
  // ============================================================================
  pub let xsave_synth_check_area_writable : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R21-M1 #828 witness (C, weak variant): area is writable and round-trips a u64.  Get area base for pid=43 (chosen not to collide with (B)'s pid=42), write 0xDEADBEEFCAFE1234 at offset 0 (FCW/FSW slot of the legacy XSAVE region), read back, cmp.  Proves: (i) area is in RW memory (not accidentally in a read-only PT entry); (ii) area is at the aligned address (an unaligned qword store crossing a page boundary would #GP on a WP-fault); (iii) the address the accessor returned actually addresses THIS pid's area (a stride bug would round-trip into a different slot but still round-trip within its own — this is a weak guarantee that folds cleanly when combined with (A)'s stride check).  When paideia-as gains vmovdqa/vmovdqu encoding (#1004), extend to a full SIMD round-trip: seed YMM0 with a pattern, xsaveopt into this area (setting YMM state bits), zero YMM0, xrstor from area, verify YMM0 restored.  That's the full #828 acceptance.  Register: 2-push prologue keeps nested-call alignment; r12 = area base across the store-load-cmp block.  Returns 0 on pass, 1 on fail.",
      block: {
        push rbx;
        push r12;

        mov rdi, 43;
        call xsave_area_for;
        mov r12, rax;

        // Write 0xDEADBEEFCAFE1234 at [r12+0].
        mov rax, 0xDEADBEEFCAFE1234;
        mov [r12 + 0], rax;

        // Read back, compare.
        mov rax, [r12 + 0];
        mov rcx, 0xDEADBEEFCAFE1234;
        cmp rax, rcx;
        jne xsave_synth_rt_fail;

        // Also verify per-pid isolation: pid=42's area at [xsave_area_for(42)+0]
        // must NOT have been affected.  Read it — allowed value: 0 (fresh
        // .bss or (B)'s post-init state) OR the 0xFFFFFFFFFFFFFFFF fill (if
        // (B) ran first — but (B) initializes offset 512+, not 0, so 0 is
        // the correct expectation).
        mov rdi, 42;
        call xsave_area_for;
        mov rax, [rax + 0];
        cmp rax, 0;
        jne xsave_synth_rt_fail;

        mov rax, 0;
        pop r12;
        pop rbx;
        ret;

      xsave_synth_rt_fail:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + xsave_synth_rt_fail_msg];
        call klog_s1;
        mov rax, 1;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // Sub-witness (D): globals are populated coherently or all-zero.
  //
  // On CPUs without XSAVE feature bit (qemu64 default), the probe function
  // takes the no_support branch and all three globals stay 0.  On CPUs with
  // XSAVE (T14 G4, QEMU -cpu max), the probe populates all three.  Any
  // in-between state is a bug (probe partially completed then failed).
  // ============================================================================
  pub let xsave_synth_check_globals : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R21-M1 #825/#826 witness (D): globals populated coherently or all-zero.  Read _xsave_supported_mask, _xsave_xcr0_target, _xsave_area_size.  Two acceptable states: (a) all three are 0 (probe hit no_support branch); (b) supported_mask has bits 0+1 set (x87+SSE — SDM Vol 1 §13.3 mandate), xcr0_target has bits 0+1 set, area_size >= 576 (legacy 512 + header 64).  Any other combination — e.g. supported_mask==0x7 but xcr0_target==0 — indicates the enable step didn't run to completion, and future xsaveopt in sched_switch_r15 would fire #UD.  Register: 2-push prologue for callee-save discipline into klog_s1 on fail.  Returns 0 on pass, 1 on fail.",
      block: {
        push rbx;
        push r12;

        mov r12, [rip + _xsave_supported_mask];
        mov rax, [rip + _xsave_xcr0_target];
        mov rcx, [rip + _xsave_area_size];

        // Case (a): all-zero — accept.
        cmp r12, 0;
        jne xsave_synth_globals_check_populated;
        cmp rax, 0;
        jne xsave_synth_globals_fail;
        cmp rcx, 0;
        jne xsave_synth_globals_fail;
        jmp xsave_synth_globals_pass;

      xsave_synth_globals_check_populated:
        // Case (b): supported_mask & 0x3 == 0x3, xcr0_target & 0x3 == 0x3,
        //           area_size >= 576.
        mov rdx, r12;
        and rdx, 0x3;
        cmp rdx, 0x3;
        jne xsave_synth_globals_fail;

        mov rdx, rax;
        and rdx, 0x3;
        cmp rdx, 0x3;
        jne xsave_synth_globals_fail;

        cmp rcx, 576;
        jb xsave_synth_globals_fail;

      xsave_synth_globals_pass:
        mov rax, 0;
        pop r12;
        pop rbx;
        ret;

      xsave_synth_globals_fail:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + xsave_synth_globals_fail_msg];
        call klog_s1;
        mov rax, 1;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // xsave_synth_witness — top-level driver.  Calls all 4 sub-witnesses in
  // order; on all-pass emits "XSAVE SYNTH OK", returns 0.  On any fail the
  // sub-witness's own FAIL line already fingerprinted the specific miss.
  // Return value: OR-fold of all 4 sub-witness returns (0 = pass, non-zero
  // = at least one failed).
  // ============================================================================
  pub let xsave_synth_witness : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: {},
      justification: "R21-M1 XSAVE synthesis witness — top-level driver.  Calls xsave_synth_check_align_and_stride (A, #827), xsave_synth_check_xstate_bv_zero (B, #829), xsave_synth_check_area_writable (C, #828 weak), xsave_synth_check_globals (D, #825/#826).  OR-folds their return values in rbx; emits 'XSAVE SYNTH OK' on all-pass, otherwise leaves the sub-witness's own FAIL fingerprint on the wire.  Register discipline: rbx = accumulated fail-OR across the 4 calls; 2-push prologue keeps nested-call alignment.  Returns rbx.",
      block: {
        push rbx;
        push r12;

        xor rbx, rbx;                        // fail accumulator

        call xsave_synth_check_align_and_stride;
        or  rbx, rax;

        call xsave_synth_check_xstate_bv_zero;
        or  rbx, rax;

        call xsave_synth_check_area_writable;
        or  rbx, rax;

        call xsave_synth_check_globals;
        or  rbx, rax;

        cmp rbx, 0;
        jne xsave_synth_witness_fail;

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + xsave_synth_ok_msg];
        call klog_s1;

      xsave_synth_witness_fail:
        mov rax, rbx;
        pop r12;
        pop rbx;
        ret
      }
    }
}
