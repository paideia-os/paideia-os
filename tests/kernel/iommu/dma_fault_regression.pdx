// tests/kernel/iommu/dma_fault_regression.pdx — R22-M6-003 (#872)
//
// -----------------------------------------------------------------------------
// Status
// -----------------------------------------------------------------------------
//
// GATED ON VT-D ENABLE (R23 dependency). Under R22.M6 the VT-d unit
// is not brought online (no GCMD.TE write, no context-cache /
// IOTLB invalidation issuance, no IDT wire for vtd_fault_dispatch).
// The mechanical steps that "trigger a deliberate out-of-domain DMA"
// require the unit to actually be walking guest tables — otherwise
// nothing enforces the domain boundary and no fault fires.
//
// The witness therefore lands in one of two modes:
//
//   1. **SKIP mode (R22.M6 default, R22-current):** The witness
//      returns a SKIP marker after emitting `VTD DMA FAULT SKIP R23 dep\n`
//      on the UART. This preserves the fixture's link-side symbol
//      existence + smoke-mode addressability so R23 can flip the
//      witness to LIVE mode with a single-line delete of the guard.
//
//   2. **LIVE mode (R23+):** The guard is removed once R23 lands
//      the boot-time IOMMU_ENABLED = 1 gate + GCMD.TE ceremony. In
//      LIVE mode the witness fabricates a BDF 0:1:0 device, seeds
//      its context-entry with an SLPT root that maps IOVA 0x1000000
//      only, then triggers a DMA read at IOVA 0x9000000 (deliberately
//      out-of-domain). The VT-d unit produces a fault whose FRR_REG
//      reason byte is 0x22 ("SL page fault: no-write-permission or
//      not-present at leaf") per Intel VT-d 4.0 §7.2.1 Table 7-5.
//      The vtd_fault_dispatch handler decodes the reason to
//      "SL leaf" via vtd_fault_decode_reason and emits
//      `VTD DMA FAULT OK reason=0x22\n`.
//
// Opt-in via PAIDEIA_R22_DMA_FAULT=1 in the pre-push gate so the
// witness is not exercised by the default matrix (matches the
// vtd_slpt_synth / msix_ir_round_robin pattern of R22.M4/M5 —
// symbol-existence at M6, full drive at R23).
//
// -----------------------------------------------------------------------------
// What LIVE mode will prove (documented ahead of R23 for reviewer clarity)
// -----------------------------------------------------------------------------
//
// (a) A device whose context-entry points at an SLPT root produces
//     a SL-page-fault when it DMAs outside the mapped IOVA window.
//     The kernel does NOT crash; the fault is delivered as a real
//     interrupt through the IDT vector wired for vtd_fault_dispatch.
//
// (b) vtd_fault_decode_reason(0x22) returns the pointer to the ASCII
//     string "SL leaf" (or whichever exact literal the reason table
//     in vtd_fault.pdx settles on).
//
// (c) FRR_REG's F (bit 31 of high u32) is set on entry to the handler
//     and cleared on write-back — proving the ROC (Read-Only-to-Clear
//     via write-1) protocol is respected.
//
// (d) The kernel resumes normal execution after the fault (SMP_BRINGUP
//     DONE fingerprint still fires later in boot). This proves the
//     handler is non-fatal.
//
// -----------------------------------------------------------------------------
// What LIVE mode will NOT prove (deferred beyond R23)
// -----------------------------------------------------------------------------
//
// - Multi-device fault isolation (needs > 1 real device on the PCI
//   bus at boot; QEMU virtio + rtl8139 combo is a candidate but the
//   witness stays single-device-focused for legibility).
// - IOTLB invalidation-in-progress races (needs a driver actively
//   remapping while another device faults; R25+ concurrency scope).
// - Nested translation (SL over FL — VT-d 4.0 scalable mode; R30+).
//
// -----------------------------------------------------------------------------
// Fake device layout (LIVE mode reference — inert at M6)
// -----------------------------------------------------------------------------
//
//   BDF               = 0:1:0
//   context-entry PA  = root_table[0][1].hi (fabricated in .bss)
//   SLPT root         = vtd_slpt_root_alloc() — one 4KB PML4 page
//   Mapped IOVA       = 0x1000000 → host PA 0x2000000, RWX
//   Fault-trigger IOVA = 0x9000000 (unmapped)
//   Expected reason   = 0x22 (SL page fault at leaf)
//
// -----------------------------------------------------------------------------
// UART markers
// -----------------------------------------------------------------------------
//
//   SKIP (M6):    "VTD DMA FAULT SKIP R23 dep\n"   (27 chars + \n + \0 = 29 bytes)
//   OK (R23+):    "VTD DMA FAULT OK reason=0x22\n" (29 chars + \n + \0 = 31 bytes)
//   FAIL (R23+):  "VTD DMA FAULT FAIL\n"           (18 chars + \n + \0 = 20 bytes)
//
// -----------------------------------------------------------------------------
// Compilation contract for R22.M6 close
// -----------------------------------------------------------------------------
//
// This module MUST compile clean under tools/build.sh. Under R22.M6 the
// witness returns SKIP unconditionally — the fake-device fabrication
// and SLPT seeding are documented in the header but the runtime body
// is a fingerprint emit + return. This preserves the module's slot in
// the build graph and reserves the OK / FAIL marker byte patterns.

module DmaFaultRegression = structure {

  pub let vtd_dma_fault_skip_msg : [u8; 29] = "VTD DMA FAULT SKIP R23 dep\n\0"

  // OK / FAIL markers reserved for R23-live-mode flip. Byte-identical
  // to what the R23 handler will emit once vtd_fault_dispatch is wired
  // to a real IDT vector and a live GCMD.TE-enabled IOMMU walks the
  // fabricated context-entry.
  pub let vtd_dma_fault_ok_msg   : [u8; 31] = "VTD DMA FAULT OK reason=0x22\n\0"
  pub let vtd_dma_fault_fail_msg : [u8; 20] = "VTD DMA FAULT FAIL\n\0"

  // Slot for the eventual expected-values table (populated when the
  // witness flips to LIVE mode in R23). Sized for 8 u64 fields: fake
  // BDF, fabricated context-entry hi/lo, SLPT root VA, mapped-IOVA
  // sample, fault-trigger IOVA, expected reason byte, FRR_REG offset.
  // Byte-zero at M6.
  pub let mut _vtd_dma_fault_expected : [u64; 8] = uninit @align(8)
}
