// tests/kernel/iommu/msix_ir_round_robin.pdx — R22-M5-004 (#869)
//
// Structural round-robin witness for the R22.M5 IR primitives (#866,
// #867).  Same shape as R21.M4 tests/kernel/apic/msix_round_robin.pdx
// but routed through the VT-d IR unit — each MSI-X message address
// now encodes an IRT handle (not a LAPIC dest) and the IRT itself
// carries the (vector, dest_apic_id, source_id) target.
//
// -----------------------------------------------------------------------------
// What this witness PROVES
// -----------------------------------------------------------------------------
//
// (a) vtd_ir_program with 4 distinct handles + 4 distinct (vector,
//     dest, sid) tuples deposits each IRTE with the exact 2 × u64
//     bit pattern the module specifies (dest lives in high u64;
//     P|vector|sid|dest_hi live in low u64 with P=1 last).
//
// (b) msix_program_entry_via_ir stamps the MSI-X entry's msg_addr_lo
//     with the correct Remappable-format bit pattern (0xFEE00000 |
//     (ir_index << 5) | SHV=0x10 | ((ir_index>>15)<<3)), msg_addr_hi
//     = 0, msg_data = 0, vector_control = 0.
//
// (c) The read-back of both tables matches the intended values
//     byte-for-byte — no widening bugs (G1) or 128-bit-atomic
//     substitutions leaked in.
//
// -----------------------------------------------------------------------------
// What this witness does NOT prove (deferred to R23+)
// -----------------------------------------------------------------------------
//
// - Interrupt delivery through the IR path: QEMU-TCG default does
//   NOT emulate VT-d, so no real IR walker consumes the fabricated
//   tables.  The witness verifies structural byte-layout, not
//   dispatch semantics.
//
// - vtd_ir_init MMIO sequence (IRTA_REG write + SIRTP + IRE): the
//   witness bypasses vtd_ir_init entirely, seeding _vtd_irt_va to
//   the fabricated .bss IRT so vtd_ir_program can be exercised
//   without touching real MMIO.  The MMIO sequence is code-review-
//   verified via vtd_ir.pdx and lands on hardware only in R23+.
//
// - vtd_fault_decode_ir_reason: separately verified by its bare
//   symbol existence + code review.  Requires a real IR fault to
//   exercise dispatch, which needs a live IR-enabled unit (R23+).
//
// -----------------------------------------------------------------------------
// Fake table storage
// -----------------------------------------------------------------------------
//
//   _fake_irt        : [u64; 512] = 4 KiB = 256 IRTEs × 16 B, 4KB-aligned
//   _fake_msix_ir_tbl : [u64; 32] = 256 B = 16 MSI-X entries × 16 B
//   _fake_ir_va_save : u64 — saves prior _vtd_irt_va so the witness
//                            leaves module state clean on exit
//   _fake_ir_next_save : u64 — saves prior _vtd_ir_next_handle
//
// All zero at .bss init.  Restored at end of witness.
//
// -----------------------------------------------------------------------------
// UART markers
// -----------------------------------------------------------------------------
//
//   Success: "MSIX IR ROUND ROBIN OK\n"    (22 chars + \n + \0 = 24 bytes)
//   Failure: "MSIX IR ROUND ROBIN FAIL\n"  (24 chars + \n + \0 = 26 bytes)

module MsixIrRoundRobin = structure {

  pub let mut _fake_irt              : [u64; 512] = uninit @align(4096)
  pub let mut _fake_msix_ir_tbl      : [u64; 32]  = uninit @align(16)
  pub let mut _fake_ir_va_save       : u64        = 0
  pub let mut _fake_ir_next_save     : u64        = 0

  pub let _msix_ir_rr_ok_msg   : [u8; 24] = "MSIX IR ROUND ROBIN OK\n\0"
  pub let _msix_ir_rr_fail_msg : [u8; 26] = "MSIX IR ROUND ROBIN FAIL\n\0"

  // ==========================================================================
  // msix_ir_round_robin_witness() -> ()
  // ==========================================================================
  //
  // Body:
  //   (1) Zero _fake_irt (512 u64) and _fake_msix_ir_tbl (32 u64).
  //   (2) Save prior _vtd_irt_va + _vtd_ir_next_handle globals;
  //       reseat them at the fake table + cursor=0 for the duration
  //       of the witness.
  //   (3) For h = 0..3, call vtd_ir_program(handle=h, vector=0x60+h,
  //       dest=h, sid=0x0100+h).  If any returns nonzero → FAIL.
  //   (4) For h = 0..3, verify _fake_irt[2h + 0] == expected_low
  //       (P=1 | (sid<<40) | (vector<<8)) and _fake_irt[2h + 1] ==
  //       expected_high (dest_lo).  Any miss → FAIL.
  //   (5) For h = 0..3, call msix_program_entry_via_ir(&_fake_msix_ir_tbl,
  //       entry_idx=h, ir_index=h).
  //   (6) For h = 0..3, read back the 4 × u32 fields and verify:
  //         msg_addr_lo == 0xFEE00000 | (h << 5) | 0x10
  //         msg_addr_hi == 0
  //         msg_data    == 0
  //         vector_ctrl == 0
  //   (7) Restore _vtd_irt_va + _vtd_ir_next_handle.
  //   (8) Emit OK on pass or FAIL on any check miss.

  pub let msix_ir_round_robin_witness : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M5-004 (#869). Structural IR round-robin witness. 5-push callee-save (rbx=iteration counter, r12=fake IRT VA, r13=fake MSI-X table VA, r14=scratch for reconstructed value, r15=scratch for read-back). sub rsp,16 for two scratch slots. Body: (1) Zero both fake tables via tight loops. (2) Save _vtd_irt_va + _vtd_ir_next_handle globals to .bss save slots; overwrite globals to point at _fake_irt with cursor=0. (3) Programming loop: for h=0..3, call vtd_ir_program(handle=rbx, vector=0x60+rbx, dest=rbx, sid=0x100+rbx); check rax==0 else FAIL. (4) Verify each IRTE's 2×u64 layout via direct memory read from _fake_irt[2h..2h+1]. Compute expected_low = 1 | ((0x100+h)<<40) | ((0x60+h)<<8); expected_high = h (32-bit dest_lo, dest_hi=0 for identity mapping). (5) MSI-X entry loop: for h=0..3, call msix_program_entry_via_ir(_fake_msix_ir_tbl, h, h). (6) Verify each MSI-X entry's 4×u32 layout: addr_lo = 0xFEE00000 | (h<<5) | 0x10; addr_hi = 0; data = 0; vector_ctrl = 0. (7) Restore globals. (8) Emit OK or FAIL. Runs inside kernel_main's boot cli window (not currently wired — symbol existence is the M5 acceptance criterion, matching vtd_slpt_synth_witness pattern). Encoder: mov / lea / call / cmp / jne / je / add / shl / or / and / mov [reg + reg*8], reg — all pre-existing.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;                           // 5 pushes = 40, sub 16 = 56; entry %16=8 → 8+56=64, %16=0.

        // ---- (1) Zero the fake IRT (512 × 8 B) ----
        lea r12, [rip + _fake_irt];
        xor rax, rax;
        xor rcx, rcx;
      msix_ir_rr_z_irt:
        cmp rcx, 512;
        jae msix_ir_rr_z_irt_done;
        mov [r12 + rcx * 8], rax;
        add rcx, 1;
        jmp msix_ir_rr_z_irt;
      msix_ir_rr_z_irt_done:

        // ---- Zero the fake MSI-X table (32 × 8 B) ----
        lea r13, [rip + _fake_msix_ir_tbl];
        xor rax, rax;
        xor rcx, rcx;
      msix_ir_rr_z_msix:
        cmp rcx, 32;
        jae msix_ir_rr_z_msix_done;
        mov [r13 + rcx * 8], rax;
        add rcx, 1;
        jmp msix_ir_rr_z_msix;
      msix_ir_rr_z_msix_done:

        // ---- (2) Save + overwrite IR globals ----
        mov rax, [rip + _vtd_irt_va];
        mov [rip + _fake_ir_va_save], rax;
        mov rax, [rip + _vtd_ir_next_handle];
        mov [rip + _fake_ir_next_save], rax;

        mov [rip + _vtd_irt_va], r12;
        xor rax, rax;
        mov [rip + _vtd_ir_next_handle], rax;

        // ---- (3) Program 4 IRTEs ----
        xor rbx, rbx;                          // h = 0

      msix_ir_rr_prog:
        cmp rbx, 4;
        jae msix_ir_rr_prog_done;

        // vtd_ir_program(handle=rbx, vector=0x60+rbx, dest=rbx, sid=0x100+rbx)
        mov rdi, rbx;
        mov rsi, rbx;
        add rsi, 0x60;
        mov rdx, rbx;                          // dest = h (identity APIC)
        mov rcx, rbx;
        add rcx, 0x100;                        // sid
        call vtd_ir_program;

        cmp rax, 0;
        jne msix_ir_rr_fail;

        add rbx, 1;
        jmp msix_ir_rr_prog;
      msix_ir_rr_prog_done:

        // ---- (4) Verify each IRTE layout ----
        xor rbx, rbx;

      msix_ir_rr_vfy_irt:
        cmp rbx, 4;
        jae msix_ir_rr_vfy_irt_done;

        // Compute expected_low = 1 | ((0x100+h) << 40) | ((0x60+h) << 8)
        mov rax, rbx;
        add rax, 0x100;                        // sid
        shl rax, 40;
        mov r14, rax;                          // scratch = sid part

        mov rax, rbx;
        add rax, 0x60;                         // vector
        shl rax, 8;
        or  r14, rax;

        or  r14, 1;                            // P = 1

        // Read _fake_irt[2h + 0] and compare
        mov rax, rbx;
        shl rax, 4;                            // h * 16 = 2h * 8 bytes
        mov r15, [r12 + rax * 1];              // low u64
        cmp r15, r14;
        jne msix_ir_rr_fail;

        // expected_high = rbx (32-bit dest_lo)
        mov r15, [r12 + rax * 1 + 8];          // high u64
        cmp r15, rbx;
        jne msix_ir_rr_fail;

        add rbx, 1;
        jmp msix_ir_rr_vfy_irt;
      msix_ir_rr_vfy_irt_done:

        // ---- (5) Program 4 MSI-X entries via IR path ----
        xor rbx, rbx;

      msix_ir_rr_prog_msix:
        cmp rbx, 4;
        jae msix_ir_rr_prog_msix_done;

        // msix_program_entry_via_ir(table_pa=r13, entry_idx=rbx, ir_index=rbx)
        mov rdi, r13;
        mov rsi, rbx;
        mov rdx, rbx;
        call msix_program_entry_via_ir;

        add rbx, 1;
        jmp msix_ir_rr_prog_msix;
      msix_ir_rr_prog_msix_done:

        // ---- (6) Verify each MSI-X entry layout ----
        xor rbx, rbx;

      msix_ir_rr_vfy_msix:
        cmp rbx, 4;
        jae msix_ir_rr_vfy_msix_done;

        // entry_pa = r13 + h * 16
        mov rax, rbx;
        shl rax, 4;
        mov r14, r13;
        add r14, rax;                          // r14 = &entry[h]

        // Expected addr_lo = 0xFEE00000 | (h << 5) | 0x10 (SHV) | ((h>>15) << 3)
        // For h in 0..3, h>>15 == 0, so bit 3 stays 0.
        mov rax, rbx;
        shl rax, 5;
        or  rax, 0x10;                         // SHV
        mov r15, 0xFEE00000;
        or  rax, r15;
        mov r15, rax;                          // r15 = expected addr_lo

        // Read u32 at r14+0.
        mov ecx, [r14 + 0];                    // zero-extended into rcx
        cmp rcx, r15;
        jne msix_ir_rr_fail;

        // Expected addr_hi = 0.
        mov ecx, [r14 + 4];
        cmp rcx, 0;
        jne msix_ir_rr_fail;

        // Expected data = 0.
        mov ecx, [r14 + 8];
        cmp rcx, 0;
        jne msix_ir_rr_fail;

        // Expected vector_ctrl = 0.
        mov ecx, [r14 + 12];
        cmp rcx, 0;
        jne msix_ir_rr_fail;

        add rbx, 1;
        jmp msix_ir_rr_vfy_msix;
      msix_ir_rr_vfy_msix_done:

        // ---- (7) Restore globals ----
        mov rax, [rip + _fake_ir_va_save];
        mov [rip + _vtd_irt_va], rax;
        mov rax, [rip + _fake_ir_next_save];
        mov [rip + _vtd_ir_next_handle], rax;

        // ---- (8) Emit OK ----
        lea rdi, [rip + _msix_ir_rr_ok_msg];
        call uart_puts;
        jmp msix_ir_rr_done;

      msix_ir_rr_fail:
        // Restore globals even on fail so subsequent state stays clean.
        mov rax, [rip + _fake_ir_va_save];
        mov [rip + _vtd_irt_va], rax;
        mov rax, [rip + _fake_ir_next_save];
        mov [rip + _vtd_ir_next_handle], rax;

        lea rdi, [rip + _msix_ir_rr_fail_msg];
        call uart_puts;

      msix_ir_rr_done:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
