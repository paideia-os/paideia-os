# Build artifacts
build/
target/
result
result-*

# Nix
.direnv/

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store

# Logs
*.log

# Local test outputs
*.img
*.iso
qemu.log
replay.bin
swtpm-state/

# Hidden environment files
.envrc.local
.plans/

# paideia-as submodule build artifacts
tools/paideia-as/target/

# Kernel build outputs
*.elf
*.bin
*.o

# Exception: font/asset blobs embedded via paideia-as @include_bytes
# (R23.M1+; see src/kernel/core/drivers/fb_font.pdx).
!assets/fonts/*.bin

# paideia-as build artifacts
*.pdx.sarif.json
*.placeholder

# Agent worktrees: transient, created by tooling, never part of the source tree.
# They were previously committed as gitlinks with no .gitmodules mapping, which
# breaks `git submodule update --init` on a fresh clone and trips `git fsck`.
.claude/worktrees/

# R49.M1-002 (#1572): build-mode flag file, regenerated by tools/build.sh
# on every run based on $PAIDEIA_BUILD_MODE (defaults to `test`). Gitignored
# so the tree's committed default cannot drift with someone's last release
# build. See design/kernel/boot-presentation.md §3 and
# src/kernel/core/config/build_mode.pdx (header comment) for the mechanism.
src/kernel/core/config/build_mode.pdx
